```yaml
xcpgir_version: "1.0"
rule:
  id: "use-escapexml"
  kind: hybrid
  severity: WARNING
  message: "Detected an Expression Language segment that does not escape output. This is dangerous because if any data in this expression can be controlled externally, it is a cross-site scripting vulnerability. Instead, use the 'escapeXml' function from the JSTL taglib."
  tags:
    - "jsp"
    - "security"
  metadata:
    language: "regex"
    category: "security"
    paths:
      include: "*.jsp"
    owasp:
      - "A03:2021 - Injection"
    cwe:
      - "CWE-116: Improper Encoding or Escaping of Output"
    references:
      - "https://www.tutorialspoint.com/jsp/jstl_function_escapexml.htm"
      - "https://stackoverflow.com/a/4948856"
      - "https://stackoverflow.com/a/3180202"

sources:
  - id: "UNESCAPED_EXPRESSION"
    match:
      node: "CALL"
      where:
        - op: "regex"
          left: "value"
          right: "\\$\\{(?!.*escapeXml).*\\}"

sinks:
  - id: "XSS_SINK"
    match:
      node: "CALL"
      where:
        - op: "regex"
          left: "value"
          right: "\\$\\{(?!.*escapeXml).*\\}"

sanitizers:
  - id: "ESCAPE_XML"
    match:
      node: "CALL"
      api:
        package: "javax.servlet.jsp.jstl.core"
        type: "Functions"
        method: "escapeXml"
    effect: "neutralize"
    scope:
      sinks: ["XSS_SINK"]

propagations:
  - id: "EXPRESSION_TO_SINK"
    from: "UNESCAPED_EXPRESSION"
    to: "XSS_SINK"
    edge: "arg->param"
    kind: "taint"
```
