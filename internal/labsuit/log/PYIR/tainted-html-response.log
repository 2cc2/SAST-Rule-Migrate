```yaml
xcpgir_version: "1.0"
rule:
  id: "tainted-html-response"
  kind: taint
  severity: WARNING
  message: "Detected user input flowing into an HTML response. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability, which could let attackers steal sensitive user data."
  metadata:
    language: python
    category: security
    cwe: "CWE-79: Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')"
    owasp:
      - "A07:2017 - Cross-Site Scripting (XSS)"
      - "A03:2021 - Injection"
    technology:
      - "aws-lambda"

sources:
  - id: "EVENT_PARAM"
    match:
      node: METHOD_PARAMETER_IN
      where:
        - op: regex
          left: name
          right: "event"

sinks:
  - id: "HTML_RESPONSE"
    match:
      node: FIELD_IDENTIFIER
      where:
        - op: regex
          left: code
          right: "\"headers\": {.*\"Content-Type\": \"text/html\".*}, \"body\":"

propagations:
  - id: "PARAM_TO_RESPONSE"
    edge: arg->param
    kind: taint
```
