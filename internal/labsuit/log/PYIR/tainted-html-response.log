    category: string    # 规则分类（如 安全、性能）
  sources: [...]        # 定义规则的 Source 节点
  sinks: [...]          # 定义规则的 Sink 节点
  sanitizers: [...]     # 定义规则的 Sanitizer 节点
  propagations: [...]   # 定义规则的传播路径
</output>
