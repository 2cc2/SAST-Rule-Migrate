      - "A03:2021 - Injection"

sources:
  - id: NON_LITERAL_VAR
    match:
      node: ASSIGNMENT
      where:
        - op: or
          conditions:
            - op: regex
              left: right.value
              right: ".+\+.+"
            - op: regex
              left: right.value
              right: ".+\+=.+"
            - op: regex
              left: right.value
              right: ".format\(.+\)"
            - op: regex
              left: right.value
              right: ".%\(.+\)"
            - op: regex
              left: right.value
              right: "f'.+\{.+}.*'"
        - pattern-inside: |
            async with $POOL.acquire() as $CONN:
              ...
            | async with $CONN.cursor() as $CUR:
              ...

sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: 
        type: aiopg
        method: execute
      arg_index: 0
      where:
        - op: regex
          left: methodFullName
          right: ".*execute.*"
        - pattern-inside: |
            async with $POOL.acquire() as $CONN:
              ...
            | async with $CONN.cursor() as $CUR:
              ...

sanitizers:
  - id: PARAMETERIZED_QUERY
    match:
      node: CALL
      api:
        type: aiopg
        method: execute
      where:
        - op: and
          conditions:
            - op: regex
              left: arg[0].value
              right: "^SELECT %s|^INSERT %s|^UPDATE %s|^DELETE %s"
            - op: neq
              left: arg[1]
              right: null
    effect: neutralize

propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint
  - id: STRING_FORMAT
    edge: arg->param
    kind: taint
    where:
      - op: regex
        left: methodFullName
        right: ".*format.*|.*%s.*"
  - id: F_STRING
    edge: arg->param
    kind: taint
    where:
      - op: regex
        left: code
        right: "f'.+\{.+}.*'"
