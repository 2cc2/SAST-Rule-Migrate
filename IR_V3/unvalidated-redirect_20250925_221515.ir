    "category": "security",
    "technology": ["java"],
    "impact": "LOW",
    "likelihood": "MEDIUM",
    "confidence": "MEDIUM"
  },
  "patterns": [
    {
      "description": "Method with HttpServletResponse.sendRedirect using unvalidated String parameter",
      "pattern": "$X $METHOD(...,HttpServletResponse $RES,...,String $URL,...) { ... $RES.sendRedirect($URL); ... }"
    },
    {
      "description": "Method with HttpServletResponse.sendRedirect using unvalidated request parameter",
      "pattern": "$X $METHOD(...,HttpServletRequest $REQ,...,HttpServletResponse $RES,...) { ... String $URL = $REQ.getParameter(...); ... $RES.sendRedirect($URL); ... }"
    },
    {
      "description": "Method with direct HttpServletResponse.sendRedirect using request parameter",
      "pattern": "$X $METHOD(...,HttpServletRequest $REQ,...,HttpServletResponse $RES,...) { ... $RES.sendRedirect($REQ.getParameter(...)); ... }"
    },
    {
      "description": "Method with HttpServletResponse.addHeader('Location') using unvalidated String parameter",
      "pattern": "$X $METHOD(...,HttpServletResponse $RES,...,String $URL,...) { ... $RES.addHeader(\"Location\",$URL); ... }"
    },
    {
      "description": "Method with HttpServletResponse.addHeader('Location') using unvalidated request parameter",
      "pattern": "$X $METHOD(...,HttpServletRequest $REQ,...,HttpServletResponse $RES,...) { ... String $URL = $REQ.getParameter(...); ... $RES.addHeader(\"Location\",$URL); ... }"
    }
  ],
  "constraints": {
    "language": "java",
    "require_validation": false
  }
