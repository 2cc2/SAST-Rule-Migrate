```yaml
xcpgir_version: "1.0"
rule:
  id: jjwt-none-alg
  kind: pattern
  severity: ERROR
  message: "Detected use of the 'none' algorithm in a JWT token. The 'none' algorithm assumes the integrity of the token has already been verified. This would allow a malicious actor to forge a JWT token that will automatically be verified. Do not explicitly use the 'none' algorithm. Instead, use an algorithm such as 'HS256'."
scope:
  languages: [java]
  frameworks: ["jwt"]
sources:
  - id: JWTS_BUILDER
    match:
      node: CALL
      api: { type: io.jsonwebtoken.Jwts, method: builder }
sinks:
  - id: UNSECURE_JWT
    match:
      node: CALL
      api: { type: io.jsonwebtoken.Jwts, method: builder }
      where:
        - op: not
          condition:
            op: inside
            left: node
            right:
              node: METHOD
              where:
                - op: regex
                  left: code
                  right: ".*\.signWith\(.*\);.*"
barriers: []
sanitizers: []
propagations: []
flows:
  - source: JWTS_BUILDER
    sink: UNSECURE_JWT
    constraints:
      path:
        must_not: [ { pattern: "CALL(io.jsonwebtoken.Jwts.signWith)" } ]
report:
  message: "Detected use of the 'none' algorithm in a JWT token."
  locations: ["sink"]
tests:
  positive:
    - "io.jsonwebtoken.Jwts.builder();"
  negative:
    - """
      io.jsonwebtoken.Jwts.builder()
        .signWith(Keys.hmacShaKeyFor(keyBytes), SignatureAlgorithm.HS256);
      """
```