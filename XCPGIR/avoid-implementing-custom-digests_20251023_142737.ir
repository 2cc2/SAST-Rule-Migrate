```yaml
xcpgir_version: "1.0"
rule:
  id: "avoid-implementing-custom-digests"
  kind: pattern
  severity: WARNING
  message: "Cryptographic algorithms are notoriously difficult to get right. By implementing a custom message digest, you risk introducing security issues into your program. Use one of the many sound message digests already available to you."
  metadata:
    cwe: ["CWE-327"]
    owasp: ["A03:2017", "A02:2021"]
    references:
      - "https://cheatsheetseries.owasp.org/cheatsheets/Cryptographic_Storage_Cheat_Sheet.html#custom-algorithms"

scope:
  languages: [java]
  frameworks: ["*"]

sinks:
  - id: CUSTOM_DIGEST_IMPLEMENTATION
    match:
      node: TYPE_DECL
      type:
        name: "java.security.MessageDigest"
        match: subtype

flows:
  - sink: CUSTOM_DIGEST_IMPLEMENTATION
    constraints:
      path:
        must: [ { pattern: "TYPE_DECL(extends java.security.MessageDigest)" } ]

report:
  locations: ["sink"]
  message: "Custom MessageDigest implementation detected"
```