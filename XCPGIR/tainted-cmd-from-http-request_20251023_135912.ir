```yaml
xcpgir_version: "1.0"
rule:
  id: "tainted-cmd-from-http-request"
  kind: taint
  severity: ERROR
  message: "Detected input from a HTTPServletRequest going into a 'ProcessBuilder' or 'exec' command. This could lead to command injection if variables passed into the exec commands are not properly sanitized."
  metadata:
    category: security
    cwe: "CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"
    owasp: ["A01:2017 - Injection", "A03:2021 - Injection"]

scope:
  languages: [java]
  frameworks: ["javax.servlet.http"]
  
sources:
  - id: HTTP_REQUEST
    match:
      node: PARAM
      type: { name: "javax.servlet.http.HttpServletRequest" }
  - id: COOKIE_VALUE
    match:
      node: CALL
      api: { type: "javax.servlet.http.Cookie", method: "getValue" }

sinks:
  - id: PROCESS_BUILDER
    match:
      node: CALL
      api: { type: "java.lang.ProcessBuilder", method: "<init>" }
      arg_index: 0
  - id: RUNTIME_EXEC
    match:
      node: CALL
      api: { type: "java.lang.Runtime", method: "exec" }
      arg_index: 0

propagations:
  - id: METHOD_ARGUMENT
    edge: arg->param
    kind: taint
  - id: LIST_ADD
    edge: receiver
    kind: taint

flows:
  - source: HTTP_REQUEST
    sink: PROCESS_BUILDER
    through: [METHOD_ARGUMENT*]
  - source: HTTP_REQUEST
    sink: RUNTIME_EXEC
    through: [METHOD_ARGUMENT*]
  - source: COOKIE_VALUE
    sink: PROCESS_BUILDER
    through: [METHOD_ARGUMENT*, LIST_ADD*]
  - source: COOKIE_VALUE
    sink: RUNTIME_EXEC
    through: [METHOD_ARGUMENT*, LIST_ADD*]

report:
  message: "User input from HTTP request reaches OS command execution"
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: 0 }] }
```