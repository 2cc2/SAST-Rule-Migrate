```yaml
xcpgir_version: "1.0"
rule:
  id: weak-ssl-context
  kind: pattern
  severity: WARNING
  message: "An insecure SSL context was detected. TLS versions 1.0, 1.1, and all SSL versions are considered weak encryption and are deprecated. Use SSLContext.getInstance(\"TLSv1.2\") for the best security."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources: []
sinks:
  - id: INSECURE_SSL_CONTEXT
    match:
      node: CALL
      api: { package: javax.net.ssl, type: SSLContext, method: getInstance }
      where:
        - op: neq
          left: arg[0].value
          right: "TLSv1.2"
        - op: neq
          left: arg[0].value
          right: "TLSv1.3"
sanitizers: []
barriers: []
propagations: []
flows:
  - source: INSECURE_SSL_CONTEXT
    sink: INSECURE_SSL_CONTEXT
    constraints:
      path:
        must: [ { pattern: "CALL(javax.net.ssl.SSLContext.getInstance)" } ]
report:
  message: "Insecure SSL context detected with ${sink.arg0.preview}"
  locations: ["sink"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "SSLContext.getInstance(\"SSL\")"
    - "SSLContext.getInstance(\"TLSv1.1\")"
  negative:
    - "SSLContext.getInstance(\"TLSv1.2\")"
    - "SSLContext.getInstance(\"TLSv1.3\")"
```