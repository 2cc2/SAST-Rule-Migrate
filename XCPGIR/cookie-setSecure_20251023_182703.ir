```yaml
xcpgir_version: "1.0"
rule:
  id: "cookie-setSecure"
  kind: "pattern"
  severity: "WARNING"
  message: "Default session middleware settings: `setSecure` not set to true. This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks."
scope:
  languages: ["java"]
  frameworks: ["*"]
  env: { os: ["*"], shell: ["*"] }
sources:
  - id: "COOKIE_CREATION"
    match:
      node: "CALL"
      api: { type: "javax.servlet.http.Cookie", method: "<init>" }
sinks:
  - id: "INSECURE_SET_FLAG"
    match:
      node: "CALL"
      api: { type: "javax.servlet.http.Cookie", method: "setSecure" }
      where:
        - op: "eq"
          left: "arg[0].value"
          right: "false"
sanitizers:
  - id: "SECURE_SET_FLAG"
    match:
      node: "CALL"
      api: { type: "javax.servlet.http.Cookie", method: "setSecure" }
      where:
        - op: "eq"
          left: "arg[0].value"
          right: "true"
    effect: "neutralize"
flows:
  - source: "COOKIE_CREATION"
    sink: "INSECURE_SET_FLAG"
    constraints:
      path:
        must_not: ["SECURE_SET_FLAG"]
report:
  message: "Insecure Transport: Cookie.setSecure(false) detected without secure override"
  locations: ["sink"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "Cookie c = new Cookie(); c.setSecure(false);"
  negative:
    - "Cookie c = new Cookie(); c.setSecure(true);"
```