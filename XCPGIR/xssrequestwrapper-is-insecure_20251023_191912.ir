```yaml
xcpgir_version: "1.0"
rule:
  id: "xssrequestwrapper-is-insecure"
  kind: "pattern"
  severity: "WARNING"
  message: "It looks like you're using an implementation of XSSRequestWrapper from dzone. The XSS filtering in this code is not secure and can be bypassed by malicious actors. It is recommended to use a stack that automatically escapes in your view or templates instead of filtering yourself."
scope:
  languages: ["java"]
  frameworks: ["*"]
  env: { os: ["*"], shell: ["*"] }

sources: []

sinks:
  - id: "XSS_REQUEST_WRAPPER"
    match:
      node: "TYPE_DECL"
      where:
        - op: "regex"
          left: "typeFullName"
          right: "XSSRequestWrapper"

  - id: "INSECURE_SCRIPT_REPLACE"
    match:
      node: "CALL"
      api: { method: "replaceAll" }
      where:
        - op: "eq"
          left: "receiver.value"
          right: "</script>"

sanitizers: []

barriers: []

propagations: []

flows:
  - source: "XSS_REQUEST_WRAPPER"
    sink: "INSECURE_SCRIPT_REPLACE"
    constraints:
      path:
        must: []

report:
  message: "Insecure XSSRequestWrapper implementation detected"
  locations: ["sink"]
  evidence: {}

tests:
  positive: []
  negative: []
```