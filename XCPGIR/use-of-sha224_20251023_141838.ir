```yaml
xcpgir_version: "1.0"
rule:
  id: "use-of-sha224"
  kind: "pattern"
  severity: "WARNING"
  message: "This code uses a 224-bit hash function, which is deprecated or disallowed in some security policies. Consider updating to a stronger hash function such as SHA-384 or higher to ensure compliance and security."
scope:
  languages: ["java"]
  frameworks: ["*"]
  env: { os: ["*"], shell: ["*"] }
sources: []
sinks:
  - id: "WEAK_HASH_API"
    match:
      node: "CALL"
      api:
        package: "org.apache.commons.codec.digest"
        type: "DigestUtils"
        method: ["getSha3_224Digest", "getSha512_224Digest", "sha3_224", "sha3_224Hex", "sha512_224", "sha512_224Hex"]
      where: []
  - id: "WEAK_HASH_INSTANCE"
    match:
      node: "CALL"
      api:
        package: "java.security"
        type: "MessageDigest"
        method: "getInstance"
      where:
        - op: "regex"
          left: "arg0.value"
          right: ".*224"
sanitizers: []
barriers: []
propagations: []
flows:
  - source: ""
    sink: "WEAK_HASH_API"
    through: []
    constraints:
      path:
        must: []
        must_not: []
  - source: ""
    sink: "WEAK_HASH_INSTANCE"
    through: []
    constraints:
      path:
        must: []
        must_not: []
report:
  message: "Weak 224-bit hash function usage detected at ${sink.location}"
  locations: ["sink"]
  evidence: {}
tests:
  positive: []
  negative: []
```