```yaml
xcpgir_version: "1.0"
rule:
  id: "xmlinputfactory-possible-xxe"
  kind: "pattern"
  severity: "WARNING"
  message: "XML external entities are not explicitly disabled for this XMLInputFactory. This could be vulnerable to XML external entity vulnerabilities."
scope:
  languages: ["java"]
  frameworks: ["*"]
sources:
  - id: "XML_INPUT_FACTORY_CREATION"
    match:
      node: "CALL"
      api:
        type: "javax.xml.stream.XMLInputFactory"
        method: "newFactory"
    match:
      node: "CALL_ALLOCATION"
      type:
        name: "javax.xml.stream.XMLInputFactory"
sinks:
  - id: "XXE_SINK"
    match:
      node: "CALL"
      api:
        type: "javax.xml.stream.XMLInputFactory"
        method: "setProperty"
      where:
        - op: "neq"
          left: "arg[1].value"
          right: "false"
sanitizers:
  - id: "DISABLE_XXE"
    match:
      node: "CALL"
      api:
        type: "javax.xml.stream.XMLInputFactory"
        method: "setProperty"
      where:
        - op: "eq"
          left: "arg[1].value"
          right: "false"
flows:
  - source: "XML_INPUT_FACTORY_CREATION"
    sink: "XXE_SINK"
    constraints:
      path:
        must_not: ["DISABLE_XXE"]
report:
  message: "Missing XML external entity protection"
  locations: ["source", "sink"]
tests:
  positive:
    - "XMLInputFactory.newFactory()"
  negative:
    - |
      XMLInputFactory factory = XMLInputFactory.newFactory();
      factory.setProperty(XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES, false);
```