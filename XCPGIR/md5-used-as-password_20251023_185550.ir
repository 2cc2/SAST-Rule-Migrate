```yaml
xcpgir_version: "1.0"
rule:
  id: "md5-used-as-password"
  kind: taint
  severity: WARNING
  message: "It looks like MD5 is used as a password hash. MD5 is not considered a secure password hash because it can be cracked by an attacker in a short amount of time. Use a suitable password hashing function such as PBKDF2 or bcrypt."
scope:
  languages: [java]
  frameworks: ["*"]

sources:
  - id: MD5_HASH
    match:
      node: CALL
      api: { type: java.security.MessageDigest, method: getInstance }
      where:
        - op: eq
          left: arg[0].value
          right: "MD5"

sinks:
  - id: PASSWORD_STORAGE
    match:
      node: CALL
      where:
        - op: regex
          left: methodFullName
          right: "(?i)(.*password.*)"

propagations:
  - id: DIGEST_TO_STORAGE
    edge: arg->param
    kind: taint

flows:
  - source: MD5_HASH
    sink: PASSWORD_STORAGE
    through: [DIGEST_TO_STORAGE*]

report:
  message: "MD5 hash detected in password storage context"
  locations: ["source", "sink"]
```