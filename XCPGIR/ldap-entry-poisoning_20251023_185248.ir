```yaml
xcpgir_version: "1.0"
rule:
  id: ldap-entry-poisoning
  kind: pattern
  severity: WARNING
  message: "An object-returning LDAP search will allow attackers to control the LDAP response. This could lead to Remote Code Execution."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources: []
sinks:
  - id: LDAP_SEARCH_CONTROLS
    match:
      node: CALL
      api: { type: javax.naming.directory.SearchControls, method: "<init>" }
      where:
        - op: eq
          left: arg4
          right: true
    match:
      node: CALL
      api: { type: javax.naming.directory.SearchControls, method: setReturningObjFlag }
      where:
        - op: eq
          left: arg0
          right: true
sanitizers: []
barriers: []
propagations: []
flows:
  - source: null
    sink: LDAP_SEARCH_CONTROLS
    through: []
    constraints:
      path:
        must: []
        must_not: []
report:
  message: "An object-returning LDAP search will allow attackers to control the LDAP response. This could lead to Remote Code Execution."
  locations: ["sink"]
  evidence: {}
tests: []
```