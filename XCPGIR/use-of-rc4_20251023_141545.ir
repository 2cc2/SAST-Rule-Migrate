```yaml
xcpgir_version: "1.0"
rule:
  id: "use-of-rc4"
  kind: pattern
  severity: WARNING
  message: "Use of RC4 was detected. RC4 is vulnerable to several attacks, including stream cipher attacks and bit flipping attacks. Instead, use a strong, secure cipher: Cipher.getInstance(\"AES/CBC/PKCS7PADDING\"). See https://owasp.org/www-community/Using_the_Java_Cryptographic_Extensions for more information."
scope:
  languages: [java]
  frameworks: ["javax.crypto"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources:
  - id: RC4_CIPHER_INSTANCE
    match:
      node: CALL
      api:
        package: "javax.crypto"
        type: "Cipher"
        method: "getInstance"
        signature: ["(Ljava/lang/String;)"]
      where:
        - op: eq
          left: "arg[0].value"
          right: "RC4"
sinks:
  - id: RC4_USAGE
    match:
      node: CALL
      api:
        package: "javax.crypto"
        type: "Cipher"
        method: "*"
        signature: ["(...)"]
propagations: []
sanitizers: []
barriers: []
flows:
  - source: RC4_CIPHER_INSTANCE
    sink: RC4_USAGE
    constraints:
      path:
        must: [ { pattern: "CALL(javax.crypto.Cipher.*)" } ]
report:
  locations: ["sink"]
  evidence:
    capture:
      - argument: 0
tests:
  positive:
    - "Cipher.getInstance(\"RC4\")"
  negative:
    - "Cipher.getInstance(\"AES/CBC/PKCS7PADDING\")"
```