```yaml
xcpgir_version: "1.0"
rule:
  id: "tainted-env-from-http-request"
  kind: taint
  severity: ERROR
  message: "Detected input from a HTTPServletRequest going into the environment variables of an 'exec' command. Instead, call the command with user-supplied arguments by using the overloaded method with one String array as the argument."
  
scope:
  languages: [java]
  frameworks: ["javax.servlet"]
  
sources:
  - id: HTTP_REQUEST
    match:
      node: PARAM
      api: { type: "javax.servlet.http.HttpServletRequest" }
  - id: COOKIE_VALUE
    match:
      node: CALL
      api: { type: "javax.servlet.http.Cookie", method: "getValue" }

sinks:
  - id: RUNTIME_ENV_EXEC
    match:
      node: CALL
      api: { type: "java.lang.Runtime", method: "exec" }
      arg_index: 1

propagations:
  - id: PARAM_TO_VALUE
    edge: arg->param
    kind: taint
  - id: FIELD_ACCESS
    edge: field-load
    kind: taint

flows:
  - source: HTTP_REQUEST
    sink: RUNTIME_ENV_EXEC
    through: [PARAM_TO_VALUE*]
  - source: COOKIE_VALUE
    sink: RUNTIME_ENV_EXEC
    through: [PARAM_TO_VALUE*, FIELD_ACCESS*]

report:
  message: "User input from HTTP request reaches environment variables in Runtime.exec()"
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 1 }] }

tests:
  positive:
    - "Runtime.getRuntime().exec(command, new String[]{request.getParameter(\"env\")});"
  negative:
    - "Runtime.getRuntime().exec(new String[]{\"command\", \"arg1\"});"
```