```yaml
xcpgir_version: "1.0"
rule:
  id: insecure-smtp-connection
  kind: pattern
  severity: WARNING
  message: "Insecure SMTP connection detected. This connection will trust any SSL certificate. Enable certificate verification by setting 'email.setSSLCheckServerIdentity(true)'."
scope:
  languages: [java]
  frameworks: ["*"]
sources:
  - id: SIMPLE_EMAIL_CREATION
    match:
      node: CALL
      api: { type: org.apache.commons.mail.SimpleEmail, method: "<init>" }
sinks:
  - id: INSECURE_SEND
    match:
      node: CALL
      api: { type: org.apache.commons.mail.SimpleEmail, method: send }
sanitizers:
  - id: SSL_IDENTITY_CHECK
    match:
      node: CALL
      api: { type: org.apache.commons.mail.SimpleEmail, method: setSSLCheckServerIdentity }
      where:
        - op: eq
          left: value
          right: "true"
barriers: []
propagations:
  - id: METHOD_CHAIN
    edge: receiver
    kind: value
flows:
  - source: SIMPLE_EMAIL_CREATION
    sink: INSECURE_SEND
    through: [METHOD_CHAIN*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(org.apache.commons.mail.SimpleEmail.setSSLCheckServerIdentity(true))" } ]
report:
  locations: ["sink"]
  evidence: {}
tests: {}
```