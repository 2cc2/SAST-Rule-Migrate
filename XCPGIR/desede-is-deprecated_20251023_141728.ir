```yaml
xcpgir_version: "1.0"
rule:
  id: "desede-is-deprecated"
  kind: "pattern"
  severity: "WARNING"
  message: "Triple DES (3DES or DESede) is considered deprecated. AES is the recommended cipher. Upgrade to use AES."
scope:
  languages: ["java", "kt"]
  frameworks: ["*"]
  env: { os: ["*"], shell: ["*"] }
sources: []
sinks:
  - id: "DESEDE_CIPHER"
    match:
      node: "CALL"
      api:
        package: "javax.crypto"
        method: "getInstance"
      where:
        - op: "regex"
          left: "arg0.value"
          right: "DESede.*"
  - id: "DES_KEYGEN"
    match:
      node: "CALL"
      api:
        package: "javax.crypto"
        method: "getInstance"
      where:
        - op: "eq"
          left: "arg0.value"
          right: "DES"
sanitizers: []
barriers: []
propagations: []
flows:
  - sink: "DESEDE_CIPHER"
    constraints: {}
  - sink: "DES_KEYGEN"
    constraints: {}
report:
  message: "Triple DES (3DES or DESede) is considered deprecated. AES is the recommended cipher."
  locations: ["sink"]
  evidence: {}
tests: {}
```