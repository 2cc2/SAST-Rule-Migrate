```yaml
xcpgir_version: "1.0"
rule:
  id: java.unsafe-reflection
  kind: taint
  severity: WARNING
  message: "Use of externally-controlled input to select classes may allow bypassing authentication or access control checks"
scope:
  languages: [java]
  frameworks: ["*"]
sources:
  - id: EXTERNAL_CLASS_NAME
    match:
      node: CALL
      api: { type: java.lang.Class, method: forName }
      arg_index: 0
      where:
        - op: neq
          left: arg[0].value
          right: LITERAL
sinks:
  - id: CLASS_INSTANTIATION
    match:
      node: CALL
      api: { type: java.lang.Class, method: newInstance }
propagations:
  - id: CLASS_NAME_PROPAGATION
    edge: arg->param
    kind: taint
flows:
  - source: EXTERNAL_CLASS_NAME
    sink: CLASS_INSTANTIATION
    through: [CLASS_NAME_PROPAGATION*]
report:
  message: "If an attacker can supply values that the application then uses to determine which class to instantiate, the potential exists for the attacker to create unintended control flow paths"
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: 0 }] }
metadata:
  cwe: ["CWE-470: Use of Externally-Controlled Input to Select Classes or Code ('Unsafe Reflection')"]
  owasp: ["A03:2021 - Injection"]
```