```yaml
xcpgir_version: "1.0"
rule:
  id: "script-engine-injection"
  kind: taint
  severity: WARNING
  message: "Detected potential code injection using ScriptEngine. Ensure user-controlled data cannot enter '.eval()', otherwise, this is a code injection vulnerability."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources:
  - id: USER_INPUT
    match:
      node: METHOD_PARAMETER_IN
      where:
        - op: regex
          left: name
          right: ".*"
sinks:
  - id: SCRIPT_EVAL
    match:
      node: CALL
      api: { type: javax.script.ScriptEngine, method: eval }
      arg_index: 0
sanitizers:
  - id: CONSTANT_STRING
    match:
      node: LITERAL
      where:
        - op: eq
          left: nodeType
          right: "STRING_LITERAL"
    effect: neutralize
barriers: []
propagations:
  - id: PARAM_TO_ARG
    edge: arg->param
    kind: taint
flows:
  - source: USER_INPUT
    sink: SCRIPT_EVAL
    through: [PARAM_TO_ARG*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(STRING_LITERAL)" } ]
report:
  message: "User input reaches ScriptEngine.eval() without sanitization"
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "ScriptEngine engine = ...; engine.eval(userControlledInput);"
  negative:
    - "ScriptEngine engine = ...; engine.eval(\"constant string\");"
```