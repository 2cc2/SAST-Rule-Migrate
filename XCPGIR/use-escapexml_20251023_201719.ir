```yaml
xcpgir_version: "1.0"
rule:
  id: "use-escapexml"
  kind: pattern
  severity: WARNING
  message: "Detected an Expression Language segment that does not escape output. This is dangerous because if any data in this expression can be controlled externally, it is a cross-site scripting vulnerability."
scope:
  languages: ["jsp"]
  frameworks: ["*"]
sources:
  - id: EXPR_LANGUAGE_INPUT
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "\\$\\{(?!.*escapeXml).*\\}"
sinks:
  - id: XSS_SINK
    match:
      node: EXPR_LANGUAGE_OUTPUT
sanitizers:
  - id: ESCAPE_XML
    match:
      node: CALL
      where:
        - op: contains
          left: methodFullName
          right: "escapeXml"
    effect: neutralize
    scope:
      sinks: [XSS_SINK]
propagations:
  - id: EXPR_TO_OUTPUT
    edge: arg->param
    kind: taint
flows:
  - source: EXPR_LANGUAGE_INPUT
    sink: XSS_SINK
    through: [EXPR_TO_OUTPUT*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(escapeXml)" } ]
report:
  message: "Expression Language segment without output escaping detected. Use 'escapeXml' function to prevent XSS."
  locations: ["source", "sink"]
  evidence:
    capture:
      - { argument: 0 }
tests:
  positive:
    - "${userInput}"
  negative:
    - "${fn:escapeXml(userInput)}"
```