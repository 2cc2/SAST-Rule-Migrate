```yaml
xcpgir_version: "1.0"
rule:
  id: "server-dangerous-object-deserialization"
  kind: "pattern"
  severity: "ERROR"
  message: "Using an arbitrary object ('$PARAMTYPE $PARAM') with Java RMI is an insecure deserialization vulnerability. This object can be manipulated by a malicious actor allowing them to execute code on your system. Instead, use an integer ID to look up your object, or consider alternative serialization schemes such as JSON."
scope:
  languages: ["java"]
  frameworks: ["rmi"]
  env: { os: ["*"], shell: ["*"] }
sources:
  - id: "RMI_PARAMETER"
    match:
      node: "PARAM"
      type:
        name: "!java.lang.String & !boolean & !Boolean & !byte & !Byte & !char & !Character & !double & !Double & !float & !Float & !int & !Integer & !long & !Long & !short & !Short"
        match: "subtype"
sinks:
  - id: "RMI_METHOD"
    match:
      node: "METHOD"
      api:
        package: ""
        type: "$INTERFACE"
        method: "$METHOD"
        signature: ["(...)"]
      where:
        - op: "extends"
          left: "type"
          right: "java.rmi.Remote"
sanitizers: []
barriers: []
propagations: []
flows:
  - source: "RMI_PARAMETER"
    sink: "RMI_METHOD"
    through: []
    constraints:
      path:
        must: []
        must_not: []
report:
  message: "Using an arbitrary object with Java RMI is an insecure deserialization vulnerability."
  locations: ["sink"]
tests: []
```