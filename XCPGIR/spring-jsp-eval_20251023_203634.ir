```yaml
xcpgir_version: "1.0"
rule:
  id: spring-jsp-eval
  kind: pattern
  severity: WARNING
  message: "A Spring expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."
scope:
  languages: [generic]
  frameworks: [spring]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources:
  - id: DYNAMIC_EXPR
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "expression=.*"
sinks:
  - id: SPRING_EVAL
    match:
      node: CALL
      api: { type: org.springframework.web.servlet.tags.EvalTag, method: doStartTag }
sanitizers: []
barriers: []
propagations:
  - id: EXPR_FLOW
    edge: arg->param
    kind: value
flows:
  - source: DYNAMIC_EXPR
    sink: SPRING_EVAL
    through: [EXPR_FLOW*]
report:
  message: "Spring expression evaluation with dynamic input detected"
  locations: ["source","sink"]
  evidence: {}
tests: {}
```