```yaml
xcpgir_version: "1.0"
rule:
  id: "rsa-no-padding"
  kind: pattern
  severity: WARNING
  message: "Using RSA without OAEP mode weakens the encryption."
scope:
  languages: [java, kt]
  frameworks: ["*"]
sources: []
sinks:
  - id: RSA_NO_PADDING
    match:
      node: CALL
      api: { type: javax.crypto.Cipher, method: getInstance }
      where:
        - op: regex
          left: value
          right: "RSA/[Nn][Oo][Nn][Ee]/NoPadding/"
sanitizers: []
barriers: []
propagations: []
flows: []
report:
  message: "Using RSA without OAEP mode weakens the encryption."
  locations: ["sink"]
tests: {}
```