```yaml
xcpgir_version: "1.0"
rule:
  id: cookie-missing-secure-flag
  kind: pattern
  severity: WARNING
  message: "A cookie was detected without setting the 'secure' flag. The 'secure' flag for cookies prevents the client from transmitting the cookie over insecure channels such as HTTP. Set the 'secure' flag by calling $COOKIE.setSecure(true);"
scope:
  languages: [java]
  frameworks: ["*"]
sources:
  - id: INSECURE_COOKIE
    match:
      node: CALL
      api: { type: javax.servlet.http.Cookie, method: setSecure }
      where:
        - op: eq
          left: arg[0].value
          right: "false"
sinks:
  - id: ADD_COOKIE
    match:
      node: CALL
      api: { type: javax.servlet.http.HttpServletResponse, method: addCookie }
sanitizers:
  - id: SECURE_COOKIE
    match:
      node: CALL
      api: { type: javax.servlet.http.Cookie, method: setSecure }
      where:
        - op: eq
          left: arg[0].value
          right: "true"
barriers: []
propagations: []
flows:
  - source: INSECURE_COOKIE
    sink: ADD_COOKIE
    constraints:
      path:
        must_not: 
          - pattern: "CALL(javax.servlet.http.Cookie.setSecure(true))"
report:
  message: "A cookie was detected without setting the 'secure' flag."
  locations: ["sink"]
tests:
  positive:
    - "response.addCookie(new Cookie(\"name\", \"value\"));"
  negative:
    - "Cookie c = new Cookie(\"name\", \"value\"); c.setSecure(true); response.addCookie(c);"
```