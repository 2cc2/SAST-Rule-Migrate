```yaml
xcpgir_version: "1.0"
rule:
  id: "no-string-eqeq"
  kind: "pattern"
  severity: "WARNING"
  message: "Strings should not be compared with '=='. This is a reference comparison operator. Use '.equals()' instead."
scope:
  languages: ["java"]
  frameworks: ["*"]
sources:
  - id: "STRING_COMPARISON"
    match:
      node: "OPERATOR"
      where:
        - op: "eq"
          left: "operator"
          right: "=="
        - op: "eq"
          left: "type"
          right: "java.lang.String"
sinks:
  - id: "OBJECT_REFERENCE_COMPARE"
    match:
      node: "OPERATOR"
      where:
        - op: "eq"
          left: "operator"
          right: "=="
        - op: "eq"
          left: "type"
          right: "java.lang.String"
sanitizers: []
barriers: []
propagations: []
flows:
  - source: "STRING_COMPARISON"
    sink: "OBJECT_REFERENCE_COMPARE"
    constraints:
      path:
        must: []
        must_not: []
report:
  message: "Strings should not be compared with '=='. This is a reference comparison operator. Use '.equals()' instead."
  locations: ["sink"]
tests: []
```