```yaml
xcpgir_version: "1.0"
rule:
  id: spel-injection
  kind: taint
  severity: WARNING
  message: "A Spring expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."
scope:
  languages: [java]
  frameworks: [spring]
  
sources:
  - id: DYNAMIC_EXPRESSION
    match:
      node: CALL
      where:
        - op: regex
          left: methodFullName
          right: ".*\.parseExpression"

sinks:
  - id: SPEL_EVAL
    match:
      node: CALL
      api: { type: org.springframework.expression.ExpressionParser, method: parseExpression }
      arg_index: 0

sanitizers:
  - id: CONSTANT_EXPRESSION
    match:
      node: LITERAL
    effect: neutralize
      
barriers:
  - id: STRING_LITERAL_ASSIGNMENT
    match:
      node: ASSIGNMENT
      where:
        - op: eq
          left: right.value
          right: "..."
    effect: stop

propagations:
  - id: EXPR_PROPAGATION
    edge: arg->param
    kind: taint

flows:
  - source: DYNAMIC_EXPRESSION
    sink: SPEL_EVAL
    through: [EXPR_PROPAGATION*]
    constraints:
      path:
        must_not:
          - { pattern: "LITERAL(value=\"...\")" }
          - { pattern: "ASSIGNMENT(right=LITERAL(value=\"...\"))" }

report:
  message: "Potential SpEL injection vulnerability detected"
  locations: ["sink"]
tests:
  positive:
    - "parser.parseExpression(userInput)"
  negative:
    - "parser.parseExpression(\"safeExpression\")"
    - 'String expr = "safe"; parser.parseExpression(expr)'
```