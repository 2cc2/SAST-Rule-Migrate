```yaml
xcpgir_version: "1.0"
rule:
  id: ecb-cipher
  kind: pattern
  severity: WARNING
  message: "Cipher in ECB mode is detected. ECB mode produces the same output for the same input each time which allows an attacker to intercept and replay the data. Further, ECB mode does not provide any integrity checking."
scope:
  languages: [java]
  frameworks: ["*"]
sources: []
sinks:
  - id: ECB_CIPHER
    match:
      node: CALL
      api: { type: javax.crypto.Cipher, method: getInstance }
      where:
        - op: regex
          left: arg[0].value
          right: ".*ECB.*"
sanitizers: []
barriers: []
propagations: []
flows:
  - source: ECB_CIPHER
    sink: ECB_CIPHER
report:
  message: "Cipher in ECB mode is detected"
  locations: ["sink"]
tests: {}
```