```yaml
xcpgir_version: "1.0"
rule:
  id: weak-random
  kind: pattern
  severity: WARNING
  message: "Detected use of non-cryptographically strong random number generators (RNGs). Use `java.security.SecureRandom` instead for passwords or secret tokens."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources: []
sinks:
  - id: WEAK_RANDOM_API
    match:
      node: CALL
      api: { type: java.util.Random, method: "$FUNC" }
  - id: MATH_RANDOM_API
    match:
      node: CALL
      api: { type: java.lang.Math, method: random }
sanitizers: []
barriers: []
propagations: []
flows:
  - source: []
    sink: WEAK_RANDOM_API
    through: []
  - source: []
    sink: MATH_RANDOM_API
    through: []
report:
  message: "Non-cryptographic RNG usage detected: ${sink.methodFullName}"
  locations: ["sink"]
  evidence: {}
tests:
  positive:
    - "new java.util.Random().nextInt();"
    - "Math.random();"
  negative:
    - "new java.security.SecureRandom().nextInt();"
```