```yaml
xcpgir_version: "1.0"
rule:
  id: transformerfactory-dtds-not-disabled
  kind: taint
  severity: ERROR
  message: "DOCTYPE declarations are enabled for this TransformerFactory. This is vulnerable to XML external entity attacks. Disable this by setting the attributes 'accessExternalDTD' and 'accessExternalStylesheet' to ''."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: UNSAFE_FACTORY_CREATION
    match:
      node: CALL
      api: { type: javax.xml.transform.TransformerFactory, method: newInstance }
    where:
      - op: not
        conditions:
          - op: exists
            pattern: |
              $_.setAttribute(XMLConstants.ACCESS_EXTERNAL_DTD, "")
              $_.setAttribute(XMLConstants.ACCESS_EXTERNAL_STYLESHEET, "")

sinks:
  - id: XXE_TRANSFORMER_USAGE
    match:
      node: CALL
      api: { type: javax.xml.transform.TransformerFactory, method: newTransformer }

sanitizers:
  - id: ATTRIBUTE_DISABLED
    match:
      node: CALL
      api: { type: javax.xml.transform.TransformerFactory, method: setAttribute }
    where:
      - op: or
        conditions:
          - op: and
            conditions:
              - op: eq
                left: arg[0]
                right: "XMLConstants.ACCESS_EXTERNAL_DTD"
              - op: eq
                left: arg[1]
                right: '""'
          - op: and
            conditions:
              - op: eq
                left: arg[0]
                right: "XMLConstants.ACCESS_EXTERNAL_STYLESHEET"
              - op: eq
                left: arg[1]
                right: '""'
    effect: neutralize

flows:
  - source: UNSAFE_FACTORY_CREATION
    sink: XXE_TRANSFORMER_USAGE
    through: []
    constraints:
      path:
        must_not: [ { id: ATTRIBUTE_DISABLED } ]

report:
  locations: ["source", "sink"]
  evidence: { capture: [{ variable: "FACTORY" }] }
tests:
  positive:
    - "TransformerFactory factory = TransformerFactory.newInstance(); factory.newTransformer();"
  negative:
    - |
      TransformerFactory factory = TransformerFactory.newInstance();
      factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_DTD, "");
      factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_STYLESHEET, "");
      factory.newTransformer();
```