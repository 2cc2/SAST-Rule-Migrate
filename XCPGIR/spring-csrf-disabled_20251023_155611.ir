```yaml
xcpgir_version: "1.0"
rule:
  id: spring-csrf-disabled
  kind: pattern
  severity: WARNING
  message: "CSRF protection is disabled for this configuration. This is a security risk."
scope:
  languages: [java]
  frameworks: [spring]
sources: []
sinks:
  - id: CSRF_DISABLE
    match:
      node: CALL
      api:
        method: disable
      where:
        - op: regex
          left: receiver.methodFullName
          right: ".*\.csrf\..*"
sanitizers: []
barriers: []
propagations: []
flows: []
report:
  locations: ["sink"]
  evidence: {}
tests:
  positive:
    - "http.csrf().disable()"
  negative: []
```