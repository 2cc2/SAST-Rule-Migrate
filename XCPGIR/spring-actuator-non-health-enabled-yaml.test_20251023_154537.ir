```yaml
xcpgir_version: "1.0"
rule:
  id: "spring-actuator-dangerous-endpoints-enabled"
  kind: value
  severity: WARNING
  message: "Potentially dangerous actuator endpoints are exposed"
scope:
  languages: ["*"]
  frameworks: ["spring"]
sources: []
sinks:
  - id: DANGEROUS_ENDPOINT
    match:
      node: LITERAL
      where:
        - op: in
          left: value
          right: ["prometheus", "logfile"]
sanitizers: []
barriers: []
propagations: []
flows:
  - source: null
    sink: DANGEROUS_ENDPOINT
    constraints:
      path:
        must: [ { pattern: "LITERAL(prometheus|logfile)" } ]
report:
  locations: ["sink"]
  evidence: { capture: [] }
tests:
  positive:
    - "include: [\"prometheus\", \"logfile\"]"
  negative:
    - "include: [\"health\"]"
```