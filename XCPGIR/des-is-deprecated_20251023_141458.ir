```yaml
xcpgir_version: "1.0"
rule:
  id: "des-is-deprecated"
  kind: "pattern"
  severity: "WARNING"
  message: "DES is considered deprecated. AES is the recommended cipher. Upgrade to use AES."
  scope:
    languages: ["java", "kt"]
    frameworks: ["*"]
    env: { os: ["*"], shell: ["*"] }

sources:
  - id: "DES_CIPHER_INSTANCE"
    match:
      node: "CALL"
      api: { type: "javax.crypto.Cipher", method: "getInstance" }
      where:
        - op: "regex"
          left: "arg0.value"
          right: "^DES(/.*)?$"

sinks:
  - id: "DES_USAGE"
    match:
      node: "CALL"
      api: { type: "javax.crypto.Cipher", method: "getInstance" }
      where:
        - op: "regex"
          left: "arg0.value"
          right: "^DES(/.*)?$"

flows:
  - source: "DES_CIPHER_INSTANCE"
    sink: "DES_USAGE"

report:
  message: "DES is considered deprecated. AES is the recommended cipher."
  locations: ["sink"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "Cipher.getInstance(\"DES\")"
    - "Cipher.getInstance(\"DES/CBC/PKCS5Padding\")"
  negative:
    - "Cipher.getInstance(\"AES/GCM/NoPadding\")"
```