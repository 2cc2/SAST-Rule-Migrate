```yaml
xcpgir_version: "1.0"
rule:
  id: "use-of-rc2"
  kind: pattern
  severity: WARNING
  message: "Use of RC2 was detected. RC2 is vulnerable to related-key attacks, and is therefore considered non-compliant. Instead, use a strong, secure cipher: Cipher.getInstance(\"AES/CBC/PKCS7PADDING\")."
scope:
  languages: [java]
  frameworks: ["*"]

sinks:
  - id: RC2_CIPHER
    match:
      node: CALL
      api: 
        package: javax.crypto
        type: Cipher
        method: getInstance
      where:
        - op: eq
          left: arg[0].value
          right: "RC2"

report:
  message: "Use of RC2 was detected. RC2 is vulnerable to related-key attacks."
  locations: ["sink"]
  evidence: { capture: [{ argument: 0 }] }
```