```yaml
xcpgir_version: "1.0"
rule:
  id: url-rewriting
  kind: pattern
  severity: WARNING
  message: "URL rewriting has significant security risks. Since session ID appears in the URL, it may be easily seen by third parties."
scope:
  languages: [java]
  frameworks: ["*"]
sources:
  - id: HTTP_SERVLET_RESPONSE
    match:
      node: PARAM
      type: 
        name: HttpServletResponse
        match: exact
sinks:
  - id: ENCODE_URL
    match:
      node: CALL
      api: { type: javax.servlet.http.HttpServletResponse, method: encodeURL }
  - id: ENCODE_REDIRECT_URL
    match:
      node: CALL
      api: { type: javax.servlet.http.HttpServletResponse, method: encodeRedirectURL }
barriers: []
propagations: []
flows:
  - source: HTTP_SERVLET_RESPONSE
    sink: ENCODE_URL
  - source: HTTP_SERVLET_RESPONSE
    sink: ENCODE_REDIRECT_URL
report:
  message: "URL rewriting detected using HttpServletResponse.encodeURL or encodeRedirectURL methods"
  locations: ["sink"]
tests: {}
```