```yaml
xcpgir_version: "1.0"
rule:
  id: "use-of-sha1"
  kind: "pattern"
  severity: "WARNING"
  message: "Detected SHA1 hash algorithm which is considered insecure. SHA1 is not collision resistant and is therefore not suitable as a cryptographic signature. Instead, use PBKDF2 for password hashing or SHA256 or SHA512 for other hash function applications."
scope:
  languages: ["java"]
  frameworks: ["*"]
  env: { os: [], shell: [] }
sources: []
sinks:
  - id: "WEAK_HASH_USAGE"
    match:
      node: "CALL"
      api:
        package: "java.security"
        type: "MessageDigest"
        method: "getInstance"
      where:
        - op: "regex"
          left: "arg[0].value"
          right: "(SHA1|SHA-1)"
  - id: "SHA1_DIGEST"
    match:
      node: "CALL"
      method: "digest"
      where:
        - op: "eq"
          left: "receiver.methodFullName"
          right: "getSha1Digest"
sanitizers: []
barriers: []
propagations: []
flows:
  - sink: "WEAK_HASH_USAGE"
    constraints: {}
  - sink: "SHA1_DIGEST"
    constraints: {}
report:
  message: "Detected SHA1 hash algorithm usage"
  locations: ["sink"]
  evidence: {}
tests:
  positive:
    - 'MessageDigest.getInstance("SHA1")'
    - 'MessageDigest.getInstance("SHA-1")'
    - 'digestUtil.getSha1Digest().digest(data)'
  negative:
    - 'MessageDigest.getInstance("SHA-256")'
```