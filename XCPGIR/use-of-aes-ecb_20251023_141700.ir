```yaml
xcpgir_version: "1.0"
rule:
  id: "use-of-aes-ecb"
  kind: pattern
  severity: WARNING
  message: "Use of AES with ECB mode detected. ECB doesn't provide message confidentiality and is not semantically secure so should not be used. Instead, use a strong, secure cipher: Cipher.getInstance(\"AES/CBC/PKCS7PADDING\")."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sinks:
  - id: ECB_SINK
    match:
      node: CALL
      api: { package: "javax.crypto", type: "Cipher", method: "getInstance" }
      where:
        - op: regex
          left: arg[0].value
          right: "AES/ECB.*"

report:
  message: "Use of AES with ECB mode detected"
  locations: ["sink"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - 'Cipher.getInstance("AES/ECB/PKCS5Padding")'
  negative:
    - 'Cipher.getInstance("AES/CBC/PKCS7PADDING")'
```