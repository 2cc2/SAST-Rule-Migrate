```yaml
xcpgir_version: "1.0"
rule:
  id: documentbuilderfactory-external-parameter-entities-true
  kind: pattern
  severity: ERROR
  message: "External entities are allowed for $DBFACTORY. This is vulnerable to XML external entity attacks. Disable this by setting the feature 'http://xml.org/sax/features/external-parameter-entities' to false."
scope:
  languages: [java]
  frameworks: ["*"]
sources: []
sinks:
  - id: XXE_ENABLED
    match:
      node: CALL
      api: 
        package: javax.xml.parsers
        type: DocumentBuilderFactory
        method: setFeature
      where:
        - op: eq
          left: arg[1].value
          right: true
sinks: []
sanitizers:
  - id: XXE_DISABLED
    match:
      node: CALL  
      api:
        package: javax.xml.parsers
        type: DocumentBuilderFactory
        method: setFeature
      where:
        - op: eq
          left: arg[1].value
          right: false
    effect: neutralize
barriers: []
propagations: []
flows:
  - sink: XXE_ENABLED
    constraints:
      path:
        must_not: [{ pattern: "CALL(javax.xml.parsers.DocumentBuilderFactory.setFeature)" }]
report:
  message: "External entities are allowed for DocumentBuilderFactory. This is vulnerable to XML external entity attacks."
  locations: ["sink"]
tests:
  positive:
    - "factory.setFeature('http://xml.org/sax/features/external-parameter-entities', true);"
  negative:
    - "factory.setFeature('http://xml.org/sax/features/external-parameter-entities', false);"
```