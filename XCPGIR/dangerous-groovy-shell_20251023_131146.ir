```yaml
xcpgir_version: "1.0"
rule:
  id: dangerous-groovy-shell
  kind: taint
  severity: WARNING
  message: |
    A expression is built with a dynamic value. The source of the value(s) should
    be verified to avoid that unfiltered values fall into this risky code evaluation.
scope:
  languages: [java]
  frameworks: ["groovy"]

sources:
  - id: GROOVY_CODE_INPUT
    match:
      node: CALL
      api:
        type: groovy.lang.GroovyShell
        method: parse
      arg_index: 0
  - id: GROOVY_CODE_INPUT_2
    match:
      node: CALL
      api:
        type: groovy.lang.GroovyShell
        method: evaluate
      arg_index: 0
  - id: GROOVY_CODE_INPUT_3
    match:
      node: CALL
      api:
        type: groovy.lang.GroovyShell
        method: parseClass
      arg_index: 0

sinks:
  - id: CODE_EXECUTION_SINK
    match:
      node: CALL
      api:
        type: groovy.lang.GroovyShell
        methods: [parse, evaluate, parseClass]
      where:
        - op: neq
          left: arg[0].value
          right: string

sanitizers:
  - id: SAFE_STRING_LITERAL
    match:
      node: LITERAL
      type: string
    effect: neutralize

flows:
  - source: GROOVY_CODE_INPUT
    sink: CODE_EXECUTION_SINK
  - source: GROOVY_CODE_INPUT_2
    sink: CODE_EXECUTION_SINK
  - source: GROOVY_CODE_INPUT_3
    sink: CODE_EXECUTION_SINK

report:
  message: "Potential code injection through GroovyShell dynamic code evaluation"
  locations: ["sink"]
  evidence: { capture: [{ argument: 0 }] }
  cwe: ["CWE-94: Improper Control of Generation of Code ('Code Injection')"]

metadata:
  owasp: ["A03:2021 - Injection"]
  references: ["https://owasp.org/Top10/A03_2021-Injection"]
  technology: ["groovy"]
```