```yaml
xcpgir_version: "1.0"
rule:
  id: gcm-nonce-reuse
  kind: pattern
  severity: ERROR
  message: "GCM IV/nonce is reused: encryption can be totally useless"
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources:
  - id: NONCE_LITERAL
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "\"...\""
sinks:
  - id: GCM_PARAMETER
    match:
      node: CALL
      api: { type: javax.crypto.spec.GCMParameterSpec, method: "<init>" }
      arg_index: 1
propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: value
flows:
  - source: NONCE_LITERAL
    sink: GCM_PARAMETER
    through: [ARG_TO_PARAM]
report:
  message: "GCM IV/nonce is reused: encryption can be totally useless"
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: 1 }] }
tests:
  positive:
    - "new GCMParameterSpec(..., \"...\".getBytes(...), ...);"
    - "byte[] $NONCE = \"...\".getBytes(...); ... new GCMParameterSpec(..., $NONCE, ...);"
  negative: []
```