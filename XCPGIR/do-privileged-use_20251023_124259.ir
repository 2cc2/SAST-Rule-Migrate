```yaml
xcpgir_version: "1.0"
rule:
  id: "do-privileged-use"
  kind: pattern
  severity: WARNING
  message: |
    Marking code as privileged enables a piece of trusted code to temporarily
    enable access to more resources than are available directly to the code
    that called it. Be very careful in your use of the privileged construct,
    and always remember to make the privileged code section as small as possible.

scope:
  languages: [java]
  frameworks: ["*"]

sources:
  - id: PRIVILEGED_CALL
    match:
      node: CALL
      api:
        type: java.security.AccessController
        method: doPrivileged

  - id: PRIVILEGED_ACTION
    match:
      node: TYPE_DECL
      where:
        - op: regex
          left: code
          right: "implements PrivilegedAction.*"

sinks:
  - id: PRIVILEGED_CALL
    match:
      node: CALL
      api:
        type: java.security.AccessController
        method: doPrivileged

report:
  message: "Privilege escalation risk detected"
  locations: ["source"]
  evidence: {}

tests:
  positive:
    - "AccessController.doPrivileged(...);"
    - "class MyAction implements PrivilegedAction<Void> { ... }"
```