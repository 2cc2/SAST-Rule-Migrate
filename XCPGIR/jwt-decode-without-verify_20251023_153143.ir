```yaml
xcpgir_version: "1.0"
rule:
  id: "java-jwt-decode-without-verify"
  kind: "hybrid"
  severity: "WARNING"
  message: "Detected the decoding of a JWT token without a verify step. JWT tokens must be verified before use, otherwise the token's integrity is unknown. This means a malicious actor could forge a JWT token with any claims. Call '.verify()' before using the token."
scope:
  languages: ["java"]
  frameworks: ["jwt"]
sources:
  - id: "JWT_DECODE"
    match:
      node: "CALL"
      api:
        package: "com.auth0.jwt"
        type: "JWT"
        method: "decode"
sinks:
  - id: "JWT_USE"
    match:
      node: "CALL|IDENTIFIER"
      type:
        name: "com.auth0.jwt.JWT"
sanitizers:
  - id: "JWT_VERIFY"
    match:
      node: "CALL"
      api:
        method: "verify"
    effect: "neutralize"
    scope:
      sources: ["JWT_DECODE"]
barriers: []
propagations:
  - id: "ARG_TO_PARAM"
    edge: "arg->param"
    kind: "taint"
flows:
  - source: "JWT_DECODE"
    sink: "JWT_USE"
    constraints:
      path:
        must_not:
          - match:
              node: "CALL"
              api:
                method: "verify"
report:
  message: "JWT tokens must be verified before use, otherwise the token's integrity is unknown. Call '.verify()' before using the token."
  locations: ["source", "sink"]
tests:
  positive:
    - "com.auth0.jwt.JWT.decode(token);"
  negative:
    - "com.auth0.jwt.JWT.decode(token).verify(verifier);"
```