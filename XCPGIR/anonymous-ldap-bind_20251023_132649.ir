```yaml
xcpgir_version: "1.0"
rule:
  id: anonymous-ldap-bind
  kind: pattern
  severity: WARNING
  message: "Detected anonymous LDAP bind. This permits anonymous users to execute LDAP statements. Consider enforcing authentication for LDAP."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: ANONYMOUS_AUTH_SETTING
    match:
      node: CALL
      where:
        - op: eq
          left: methodFullName
          right: "put"
        - op: regex
          left: receiver.preview
          right: ".*SECURITY_AUTHENTICATION"
        - op: eq
          left: arg[1].value
          right: "none"

sinks:
  - id: INITIAL_DIR_CONTEXT
    match:
      node: CALL
      api:
        type: javax.naming.InitialDirContext
        method: "<init>"
      arg_index: 0

flows:
  - source: ANONYMOUS_AUTH_SETTING
    sink: INITIAL_DIR_CONTEXT
    constraints:
      path:
        must: [ { pattern: "CALL(javax.naming.InitialDirContext.<init>)" } ]

report:
  message: "Detected anonymous LDAP bind. This permits anonymous users to execute LDAP statements. Consider enforcing authentication for LDAP."
  locations: ["source", "sink"]
  evidence:
    capture:
      - { argument: 1 }
      - { methodFullName: "javax.naming.InitialDirContext.<init>" }
```