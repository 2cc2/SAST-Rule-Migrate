```yaml
xcpgir_version: "1.0"
rule:
  id: xmlinputfactory-external-entities-enabled
  kind: pattern
  severity: ERROR
  message: "XML external entities are enabled for this XMLInputFactory. This is vulnerable to XML external entity attacks. Disable external entities by setting 'javax.xml.stream.isSupportingExternalEntities' to false."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources: []
sinks:
  - id: XXE_ENABLED
    match:
      node: CALL
      api:
        type: javax.xml.stream.XMLInputFactory
        method: setProperty
      arg_index: 1
      where:
        - op: eq
          left: arg[1].value
          right: "true"
        - op: eq
          left: arg[0].value
          right: "javax.xml.stream.isSupportingExternalEntities"
sanitizers: []
barriers: []
propagations: []
flows:
  - source: XXE_ENABLED
    sink: XXE_ENABLED
    constraints:
      path:
        must:
          - pattern: "CALL(javax.xml.stream.XMLInputFactory.setProperty)"
report:
  message: "XML external entities are enabled for this XMLInputFactory."
  locations: ["sink"]
tests: {}
```