```yaml
xcpgir_version: "1.0"
rule:
  id: tainted-sql-from-http-request
  kind: taint
  severity: WARNING
  message: "Detected input from a HTTPServletRequest going into a SQL sink or statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized."
scope:
  languages: [java]
  frameworks: ["servlets", "spring"]
sources:
  - id: HTTP_REQUEST_INPUT
    match:
      node: CALL
      api:
        type: javax.servlet.http.HttpServletRequest
        method: getParameter|getParameterMap|getParameterValues|getInputStream|getReader|getCookies|getHeader|getHeaderNames|getHeaders|getPart|getParts|getQueryString
sinks:
  - id: SQL_EXECUTION
    match:
      node: CALL
      api:
        type: java.sql.Statement|java.sql.PreparedStatement|java.sql.CallableStatement
        method: execute|query|executeUpdate|batchUpdate
    - id: JDBC_TEMPLATE
      match:
        node: CALL
        api:
          type: org.springframework.jdbc.core.JdbcTemplate
          method: queryForObject|queryForMap|batchUpdate
sanitizers: []
barriers: []
propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
flows:
  - source: HTTP_REQUEST_INPUT
    sink: SQL_EXECUTION
    through: [ARG_TO_PARAM*]
  - source: HTTP_REQUEST_INPUT
    sink: JDBC_TEMPLATE
    through: [ARG_TO_PARAM*]
report:
  message: "User input reaches SQL execution without sanitization"
  locations: ["source","sink","path"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "stmt.executeQuery(request.getParameter(\"q\"));"
    - "jdbcTemplate.queryForObject(request.getParameter(\"q\"), args);"
  negative:
    - "stmt.executeQuery(\"SELECT * FROM safe_table\");"
    - "jdbcTemplate.queryForObject(sqlWithParam, args);"
```