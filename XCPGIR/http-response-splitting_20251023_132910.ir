```yaml
xcpgir_version: "1.0"
rule:
  id: http-response-splitting
  kind: taint
  severity: INFO
  message: "Older Java application servers are vulnerable to HTTP response splitting, which may occur if an HTTP request can be injected with CRLF characters."
scope:
  languages: [java]
  frameworks: ["*"]

sources:
  - id: USER_INPUT
    match:
      node: CALL
      api: { type: javax.servlet.ServletRequest, method: getParameter }
  - id: PATH_VARIABLE
    match:
      node: METHOD_PARAMETER_IN
      where:
        - op: eq
          left: annotationName
          right: "PathVariable"

sinks:
  - id: COOKIE_CONSTRUCTOR
    match:
      node: CALL
      api: { type: javax.servlet.http.Cookie, method: "<init>" }
      arg_index: 1
  - id: RESPONSE_ADD_COOKIE
    match:
      node: CALL
      api: { type: javax.servlet.http.HttpServletResponse, method: addCookie }

propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
  - id: VAR_TO_COOKIE
    edge: arg->param
    kind: taint

flows:
  - source: USER_INPUT
    sink: COOKIE_CONSTRUCTOR
    through: [ARG_TO_PARAM]
  - source: USER_INPUT
    sink: RESPONSE_ADD_COOKIE
    through: [ARG_TO_PARAM, VAR_TO_COOKIE]
  - source: PATH_VARIABLE
    sink: COOKIE_CONSTRUCTOR
    through: [ARG_TO_PARAM]
  - source: PATH_VARIABLE
    sink: RESPONSE_ADD_COOKIE
    through: [ARG_TO_PARAM, VAR_TO_COOKIE]

report:
  message: "Potential HTTP Response Splitting vulnerability via unvalidated user input in cookie"
  locations: ["source", "sink"]
  evidence: 
    capture: 
      - argument: 1
```