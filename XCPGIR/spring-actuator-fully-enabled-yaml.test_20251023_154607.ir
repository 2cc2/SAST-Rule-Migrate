```yaml
xcpgir_version: "1.0"
rule:
  id: "spring-actuator-fully-enabled"
  kind: pattern
  severity: WARNING
  message: "Spring Actuator endpoints are fully exposed via wildcard inclusion"
scope:
  languages: ["java"]
  frameworks: ["spring-boot"]
sources:
  - id: ACTUATOR_CONFIG
    match:
      node: LITERAL
      where:
        - op: eq
          left: value
          right: "*"
sinks:
  - id: ACTUATOR_EXPOSURE
    match:
      node: FIELD
      where:
        - op: eq
          left: name
          right: "include"
flows:
  - source: ACTUATOR_CONFIG
    sink: ACTUATOR_EXPOSURE
    constraints:
      path:
        must:
          - pattern: "ASSIGNMENT(include)"
report:
  message: "Actuator endpoints exposed with wildcard inclusion pattern"
  locations: ["source"]
tests:
  positive:
    - "management.endpoints.web.exposure.include=*"
  negative:
    - "management.endpoints.web.exposure.include=health,info"
```