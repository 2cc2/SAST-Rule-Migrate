```yaml
xcpgir_version: "1.0"
rule:
  id: "no-null-cipher"
  kind: "pattern"
  severity: "WARNING"
  message: "NullCipher was detected. This will not encrypt anything; the cipher text will be the same as the plain text. Use a valid, secure cipher: Cipher.getInstance(\"AES/CBC/PKCS7PADDING\"). See https://owasp.org/www-community/Using_the_Java_Cryptographic_Extensions for more information."
scope:
  languages: ["java"]
  frameworks: ["*"]
  env: { os: ["*"], shell: ["*"] }
sources: []
sinks:
  - id: "NULL_CIPHER"
    match:
      node: "CALL"
      api:
        type: "javax.crypto.NullCipher"
        method: "<init>"
      where:
        - op: "or"
          left: {op: "regex", left: "methodFullName", right: "^NullCipher"}
          right: {op: "regex", left: "methodFullName", right: "^javax\\.crypto\\.NullCipher"}
sanitizers: []
barriers: []
propagations: []
flows:
  - source: ""
    sink: "NULL_CIPHER"
    through: []
    constraints: {}
report:
  locations: ["sink"]
  evidence:
    capture:
      - { argument: 0 }
tests: {}
```