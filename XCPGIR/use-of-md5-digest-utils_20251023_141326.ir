```yaml
xcpgir_version: "1.0"
rule:
  id: "use-of-md5-digest-utils"
  kind: "pattern"
  severity: "WARNING"
  message: "Detected MD5 hash algorithm which is considered insecure. MD5 is not collision resistant and is therefore not suitable as a cryptographic signature. Use HMAC instead."
scope:
  languages: ["java"]
  frameworks: ["*"]
  env: { os: ["*"], shell: ["*"] }
sources: []
sinks:
  - id: "MD5_HASH"
    match:
      node: "CALL"
      api:
        package: "org.apache.commons.codec.digest"
        type: "DigestUtils"
        method: "digest"
      where:
        - op: "eq"
          left: "methodFullName"
          right: "DigestUtils.getMd5Digest"
sanitizers: []
barriers: []
propagations: []
flows:
  - source: ""
    sink: "MD5_HASH"
    through: []
    constraints: {}
report:
  message: "Detected MD5 hash algorithm which is considered insecure. MD5 is not collision resistant and is therefore not suitable as a cryptographic signature. Use HMAC instead."
  locations: ["sink"]
tests: {}
```