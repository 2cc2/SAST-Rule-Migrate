```yaml
xcpgir_version: "1.0"
rule:
  id: "servletresponse-writer-xss"
  kind: taint
  severity: ERROR
  message: "Cross-site scripting detected in HttpServletResponse writer with user input. Ensure data is properly encoded using org.owasp.encoder.Encode.forHtml."
scope:
  languages: [java]
  frameworks: ["servlet"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: USER_INPUT
    match:
      node: CALL
      api: { type: "javax.servlet.ServletRequest", method: "getParameter" }

sinks:
  - id: XSS_SINK
    match:
      node: CALL
      api: { type: "javax.servlet.ServletResponse", method: "getWriter" }
      chained:
        - method: "write"
          arg_index: 1

propagations:
  - id: ARG_PARAM
    edge: arg->param
    kind: taint
  - id: ASSIGN_PROPAGATE
    edge: alias
    kind: taint

flows:
  - source: USER_INPUT
    sink: XSS_SINK
    through: [ARG_PARAM*, ASSIGN_PROPAGATE*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(org.owasp.encoder.Encode.forHtml)" } ]

report:
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 1 }] }
```