```yaml
xcpgir_version: "1.0"
rule:
  id: "server-dangerous-class-deserialization"
  kind: "pattern"
  severity: "WARNING"
  message: "Using a non-primitive class with Java RMI may be an insecure deserialization vulnerability."
scope:
  languages: ["java"]
  frameworks: ["rmi"]
  env: { os: ["*"], shell: ["*"] }

sinks:
  - id: "RMI_INTERFACE_METHOD"
    match:
      node: "METHOD"
      where:
        - op: "regex"
          left: "typeFullName"
          right: ".*Remote$"
        - op: "neq"
          left: "parameterTypes[0]"
          right: "int|boolean|short|long|byte|char|float|double"

report:
  message: "This object could be manipulated by a malicious actor allowing them to execute code on your system. Instead, use an integer ID to look up your object, or consider alternative serialization schemes such as JSON."
  locations: ["sink"]
```