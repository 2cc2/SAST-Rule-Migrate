```yaml
xcpgir_version: "1.0"
rule:
  id: bad-hexa-conversion
  kind: pattern
  severity: WARNING
  message: "'Integer.toHexString()' strips leading zeroes from each byte if read byte-by-byte. This mistake weakens the hash value computed since it introduces more collisions. Use 'String.format("%02X", ...)' instead."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources: []
sinks:
  - id: HEX_CONVERSION
    match:
      node: CALL
      api: { type: java.lang.Integer, method: toHexString }
sanitizers: []
barriers: []
propagations: []
flows:
  - source: HEX_CONVERSION
    sink: HEX_CONVERSION
    constraints:
      path:
        must: [ { pattern: "CALL(java.security.MessageDigest.digest)" } ]
report:
  message: "Potential weak hash computation due to improper hex conversion"
  locations: ["sink"]
  evidence: {}
tests:
  positive:
    - "MessageDigest md = MessageDigest.getInstance(\"SHA-256\"); md.digest(data); Integer.toHexString(byte);"
  negative:
    - "MessageDigest md = MessageDigest.getInstance(\"SHA-256\"); md.digest(data); String.format(\"%02X\", byte);"
```