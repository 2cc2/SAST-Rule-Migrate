```yaml
xcpgir_version: "1.0"
rule:
  id: "cookie-issecure-false"
  kind: "pattern"
  severity: "WARNING"
  message: "Default session middleware settings: `setSecure` not set to true. This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks."
scope:
  languages: ["java"]
  frameworks: ["*"]
  env: { os: ["*"], shell: ["*"] }
sources:
  - id: "COOKIE_CONSTRUCTOR"
    match:
      node: "CALL"
      api: 
        type: "javax.servlet.http.Cookie"
        method: "<init>"
sinks:
  - id: "INSECURE_COOKIE"
    match:
      node: "CALL"
      api:
        type: "javax.servlet.http.Cookie"
        method: "setSecure"
      where:
        - op: "eq"
          left: "value"
          right: "false"
barriers:
  - id: "SECURE_COOKIE"
    match:
      node: "CALL"
      api:
        type: "javax.servlet.http.Cookie"
        method: "setSecure"
      where:
        - op: "eq"
          left: "value"
          right: "true"
    effect: "stop"
flows:
  - source: "COOKIE_CONSTRUCTOR"
    sink: "INSECURE_COOKIE"
    constraints:
      path:
        must_not: ["SECURE_COOKIE"]
report:
  message: "Default session middleware settings: `setSecure` not set to true. This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks."
  locations: ["sink"]
tests:
  positive:
    - "$COOKIE = new Cookie($...ARGS);"
  negative:
    - |
      $COOKIE = new Cookie($...ARGS);
      $COOKIE.setSecure(true);
```