```yaml
xcpgir_version: "1.0"
rule:
  id: "defaulthttpclient-is-deprecated"
  kind: pattern
  severity: WARNING
  message: "DefaultHttpClient is deprecated. Further, it does not support connections using TLS1.2, which makes using DefaultHttpClient a security hazard. Use HttpClientBuilder instead."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources:
  - id: DEFAULT_HTTP_CLIENT
    match:
      node: CALL
      api: { type: org.apache.http.impl.client.DefaultHttpClient, method: <init> }
sinks:
  - id: DEFAULT_HTTP_CLIENT_USAGE
    match:
      node: CALL
      api: { type: org.apache.http.impl.client.DefaultHttpClient, method: "*" }
sanitizers: []
barriers: []
propagations: []
flows:
  - source: DEFAULT_HTTP_CLIENT
    sink: DEFAULT_HTTP_CLIENT_USAGE
    constraints: {}
report:
  message: "DefaultHttpClient is deprecated and poses security risks due to lack of TLS1.2 support"
  locations: ["sink"]
  evidence: {}
tests:
  positive:
    - "new DefaultHttpClient();"
  negative:
    - "HttpClientBuilder.create().build();"
```