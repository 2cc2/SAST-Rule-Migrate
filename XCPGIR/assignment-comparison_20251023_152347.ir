```yaml
xcpgir_version: "1.0"
rule:
  id: "assignment-comparison"
  kind: "pattern"
  severity: "ERROR"
  message: "The value of `$X` is being ignored and will be used in the conditional test"
scope:
  languages: ["java"]
  frameworks: ["*"]
  env: { os: [], shell: [] }
sources: []
sinks:
  - id: "ASSIGNMENT_IN_CONDITIONAL"
    match:
      node: "ASSIGNMENT"
      where:
        - op: "in"
          left: "parent.parent.nodeType"
          right: ["IF"]
sanitizers: []
barriers: []
propagations: []
flows:
  - source: "ASSIGNMENT_IN_CONDITIONAL"
    constraints:
      path:
        must:
          - pattern: "IF(ASSIGNMENT)"
report:
  message: "Assignment operation used in conditional test"
  locations: ["sink"]
tests:
  positive:
    - "if (x=true) {}"
    - "if (x=false) {}"
  negative:
    - "if (x==true) {}"
    - "if (x) {}"
```