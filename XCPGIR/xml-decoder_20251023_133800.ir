```yaml
xcpgir_version: "1.0"
rule:
  id: "xml-decoder"
  kind: "pattern"
  severity: "WARNING"
  message: "XMLDecoder should not be used to parse untrusted data. Deserializing user input can lead to arbitrary code execution. Use an alternative and explicitly disable external entities."
  
scope:
  languages: ["java"]
  frameworks: ["*"]
  env: { os: ["*"], shell: ["*"] }

sources:
  - id: "UNTRUSTED_XML_INPUT"
    match:
      node: "CALL"
      api: 
        type: "java.beans.XMLDecoder"
        method: "<init>"
      where:
        - op: "neq"
          left: "arg[0].value"
          right: "\"...\"\""

sinks:
  - id: "XML_DECODER_CALL"
    match:
      node: "CALL"
      api: 
        type: "java.beans.XMLDecoder"
        method: "<init>"

sanitizers: []

barriers: []

propagations: []

flows:
  - source: "UNTRUSTED_XML_INPUT"
    sink: "XML_DECODER_CALL"
    constraints:
      path:
        must_not:
          - pattern: "LITERAL(value=\"...\")"

report:
  message: "XMLDecoder should not be used to parse untrusted data. Deserializing user input can lead to arbitrary code execution."
  locations: ["sink"]
  evidence: {}

tests:
  positive:
    - "new XMLDecoder(untrustedInputStream);"
  negative:
    - "new XMLDecoder(\"safe literal\");"
```