```yaml
xcpgir_version: "1.0"
rule:
  id: "use-of-default-aes"
  kind: pattern
  severity: WARNING
  message: >-
    Use of AES with no settings detected. By default, java.crypto.Cipher uses ECB mode. ECB doesn't 
    provide message confidentiality and is not semantically secure so should not be used.
    Instead, use a strong, secure cipher: java.crypto.Cipher.getInstance("AES/CBC/PKCS7PADDING").
scope:
  languages: [java]
  frameworks: ["*"]
sinks:
  - id: DEFAULT_AES_CALL
    match:
      node: CALL
      api:
        package: javax.crypto
        type: Cipher
        method: getInstance
      arg_index: 0
      where:
        - op: eq
          left: arg[0].value
          right: "AES"
flows:
  - sink: DEFAULT_AES_CALL
report:
  message: "Use of AES with no settings detected"
  locations: ["sink"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  # Should match simple case
  positive:
    - "Cipher.getInstance(\"AES\")"
  # Should match qualified calls
  positive: 
    - "javax.crypto.Cipher.getInstance(\"AES\")"
  # Should not match correct AES implementations  
  negative:
    - "Cipher.getInstance(\"AES/CBC/PKCS7PADDING\")"
```