```yaml
xcpgir_version: "1.0"
rule:
  id: "permissive-cors"
  kind: "pattern"
  severity: "WARNING"
  message: "Permissive CORS policy will allow a malicious application to communicate with the victim application in an inappropriate way, leading to spoofing, data theft, relay and other attacks."
scope:
  languages: ["java"]
  frameworks: ["*"]
sources:
  - id: "CORS_HEADER_SETTER"
    match:
      node: "CALL"
      api:
        type: |
          "javax.servlet.http.HttpServletResponse" |
          "org.springframework.http.ServerHttpResponse" |
          "org.springframework.http.HttpHeaders" |
          "org.springframework.web.server.ServerWebExchange" |
          "org.springframework.http.ResponseEntity" |
          "org.springframework.web.reactive.function.server.ServerResponse"
        method: |
          "addHeader" | "setHeader" | "getHeaders().add" | "header"
      arg_index: 1
      where:
        - op: "regex"
          left: "arg[1].value"
          right: "^\\*|null$"
sinks:
  - id: "CORS_HEADER_SET"
    match:
      node: "CALL"
      api:
        type: |
          "javax.servlet.http.HttpServletResponse" |
          "org.springframework.http.ServerHttpResponse" |
          "org.springframework.http.HttpHeaders" |
          "org.springframework.web.server.ServerWebExchange" |
          "org.springframework.http.ResponseEntity" |
          "org.springframework.web.reactive.function.server.ServerResponse"
        method: |
          "addHeader" | "setHeader" | "getHeaders().add" | "header"
      arg_index: 0
      where:
        - op: "regex"
          left: "arg[0].value"
          right: "access-control-allow-origin"
propagations:
  - id: "METHOD_PROPAGATION"
    edge: "arg->param"
flows:
  - source: "CORS_HEADER_SETTER"
    sink: "CORS_HEADER_SET"
    through: ["METHOD_PROPAGATION*"]
report:
  message: "Permissive CORS policy detected with wildcard or null origin"
  locations: ["sink"]
  evidence:
    capture:
      - argument: 0
      - argument: 1
```