/**
 * @name Spring SQL Injection
 * @description Detected a string argument from a public method contract in a raw SQL statement.
 *              This could lead to SQL injection if variables are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @id spring-sqli
 * @tags security
 * @security-severity 8.8
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class PublicStringParameter extends DataFlow::Node {
  PublicStringParameter() {
    exists(Method m, Parameter p |
      m.isPublic() and
      p = m.getAParameter() and
      p.getType().hasName("String")
    |
      this.asParameter() = p
    )
  }
}

class SpringSqlSink extends DataFlow::Node {
  SpringSqlSink() {
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "PreparedStatementCreatorFactory") and
      call.getCallee().hasName("<init>") and
      this.asExpr() = call.getArgument(0)
    )
    or
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      this.asExpr() = call.getArgument(0)
    )
    or
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "NamedParameterBatchUpdateUtils") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class StringSanitizer extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasName("String") and
      pred.asExpr() = cc.getArgument(0) and
      succ.asExpr() = cc
    )
  }
}

class SpringSqlConfig extends TaintTracking::Configuration {
  SpringSqlConfig() { this = "Spring SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof PublicStringParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SpringSqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    any(StringSanitizer s).step(_, sanitizer)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SpringSqlConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(),
  "Potential SQL injection from public string parameter to Spring SQL execution method",
  source.getNode(), sink.getNode(),
  "Untrusted input flows to SQL execution point without proper sanitization"