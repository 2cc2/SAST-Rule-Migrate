/**
 * @name Path traversal vulnerability in servlet file operations
 * @description Detected a potential path traversal. A malicious actor could control the location
 *              of this file via user-controllable input. Ensure user-controlled variables in
 *              file paths are sanitized.
 * @kind path-problem
 * @problem.severity error
 * @id java/path-traversal-servlet
 * @tags security
 *       external/cwe/cwe-022
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

predicate isServletRequestParam(MethodAccess ma) {
  ma.getMethod().hasName("getParameter") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")
}

predicate isCookieValue(MethodAccess ma) {
  ma.getMethod().hasName("getValue") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
}

predicate isFileOperation(Expr e) {
  exists(ConstructorCall cc |
    (
      cc.getConstructedType().hasQualifiedName("java.io", "File") or
      cc.getConstructedType().hasQualifiedName("java.io", "FileInputStream") or
      cc.getConstructedType().hasQualifiedName("java.io", "FileOutputStream")
    ) and
    e = cc.getArgument(0)
  )
}

predicate isFilenameUtilsSanitizer(DataFlow::Node node) {
  exists(MethodAccess ma |
    ma.getMethod().hasName("getName") and
    ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
    node.asExpr() = ma.getArgument(0)
  )
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      (isServletRequestParam(ma) or isCookieValue(ma)) and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    isFileOperation(sink.asExpr())
  }

  override predicate isSanitizer(DataFlow::Node node) {
    isFilenameUtilsSanitizer(node)
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Path traversal vulnerability detected in file operation. User-controlled input from $@ flows to file operation here.",
  source.getNode(), "user input"