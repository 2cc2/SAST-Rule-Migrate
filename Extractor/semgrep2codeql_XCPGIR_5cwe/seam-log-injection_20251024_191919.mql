/**
 * @name Seam Log Injection
 * @description Detects expression language injection in JBoss Seam logging API
 * @kind flow-problem
 * @problem.severity error
 * @id seam-log-injection
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class SeamLogSource extends DataFlow::Node {
  SeamLogSource() {
    exists(Method m, MethodAccess ma |
      m.hasName(["debug", "error", "fatal", "info", "trace", "warn"]) and
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SeamLogSink extends DataFlow::Node {
  SeamLogSink() {
    exists(Method m, MethodAccess ma |
      m.hasName(["debug", "error", "fatal", "info", "trace", "warn"]) and
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SeamLogFlowConfig extends TaintTracking::Configuration {
  SeamLogFlowConfig() {
    this = "SeamLogFlowConfig"
  }

  override predicate isSource(DataFlow::Node source) { source instanceof SeamLogSource }
  
  override predicate isSink(DataFlow::Node sink) { sink instanceof SeamLogSink }
}

from DataFlow::Node source, DataFlow::Node sink, SeamLogFlowConfig config
where config.hasFlow(source, sink)
select sink,
  "Potential expression language injection in Seam logging API from $@.", 
  source, "this user input"