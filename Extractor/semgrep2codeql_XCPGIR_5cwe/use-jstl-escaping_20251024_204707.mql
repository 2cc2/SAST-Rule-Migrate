/**
 * @name Use JSTL Escaping
 * @description Detected an Expression Language segment in a tag that does not escape output.
 * @kind problem
 * @problem.severity warning
 * @id java/unsafe-jsp-expression
 * @tags security
 *       external/cwe/cwe-079
 */
import java

// Match JSP expressions with ${...} pattern
predicate hasJspExpression(Expr e) {
  exists(string s |
    s = e.toString() and
    s.matches(".*\\$\\{.*\\}.*")
  )
}

// Match unsafe JSP expressions that don't use out tag
predicate isUnsafeJspExpression(Expr e) {
  exists(string s |
    s = e.toString() and
    s.matches("<(?![A-Za-z0-9]+:out).*\\$\\{.*\\}.*>") and
    not s.matches("<[A-Za-z0-9]+:out.*")
  )
}

// Match safe expressions using JSTL out tag
predicate isSafeJstlOutTag(Expr e) {
  exists(string s |
    s = e.toString() and
    s.matches("<[A-Za-z0-9]+:out.*\\$\\{.*\\}.*>")
  )
}

from Expr e
where 
  hasJspExpression(e) and
  isUnsafeJspExpression(e) and
  not isSafeJstlOutTag(e)
select e, "Unsafe JSP expression detected. Use JSTL out tag for proper escaping."