/**
 * @name Anonymous LDAP Bind
 * @description Detected anonymous LDAP bind. This permits anonymous users to execute LDAP statements. Consider enforcing authentication for LDAP.
 * @kind problem
 * @problem.severity warning
 * @id java/anonymous-ldap-bind
 * @tags security
 *       external/cwe/cwe-287
 *       external/owasp/a02:2017
 *       external/owasp/a07:2021
 *       cwe2021-top25
 *       cwe2022-top25
 */
import java
错的
from MethodAccess putMethod, ConstructorCall newContext, Expr env
where
  // Match put("java.naming.security.authentication", "none") call
  putMethod.getMethod().getName() = "put" and
  putMethod.getArgument(0).toString() = "\"java.naming.security.authentication\"" and
  putMethod.getArgument(1).toString() = "\"none\"" and
  env = putMethod.getQualifier() and
  // Match new InitialDirContext(env, ...) call
  newContext.getConstructedType().hasQualifiedName("javax.naming", "InitialDirContext") and
  newContext.getArgument(0) = env

select newContext, "Detected anonymous LDAP bind. This permits anonymous users to execute LDAP statements. Consider enforcing authentication for LDAP."