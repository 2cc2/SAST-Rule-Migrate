/**
 * @name Spring CSRF Protection Disabled
 * @description Detects when CSRF protection is disabled in Spring configuration.
 * @kind problem
 * @problem.severity warning
 * @id java/spring-csrf-disabled
 * @tags security
 *       external/cwe/cwe-352
 *       external/owasp/a01
 *       external/asvs/V4.2.2
 *       cwe2021-top25
 *       cwe2022-top25
 */
import java

from MethodAccess ma
where ma.getMethod().getName() = "csrf" and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.security.config.annotation.web.configurers", "CsrfConfigurer") and
      exists(MethodAccess disableCall |
        disableCall.getMethod().getName() = "disable" and
        disableCall.getQualifier() = ma
      )
select ma, "CSRF protection is disabled for this configuration. This is a security risk."