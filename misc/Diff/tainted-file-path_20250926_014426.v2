/**
 * @name Tainted file path
 * @description Detected user input controlling a file path. An attacker could control the location of this file, 
 * to include going backwards in the directory with '../'. To address this, ensure that user-controlled variables 
 * in file paths are sanitized. You may also consider using a utility method such as 
 * org.apache.commons.io.FilenameUtils.getName(...) to only retrieve the file name from the path.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-file-path
 * @tags security
 *       vulnerability
 *       cwe/23
 *       owasp/a01
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class TaintedFilePathConfig extends TaintTracking::Configuration {
  TaintedFilePathConfig() { this = "TaintedFilePathConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p |
      p = m.getAParameter() and
      (
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestBody") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestParam") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestHeader") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "CookieValue") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "ModelAttribute")
      ) and
      not p.getType() instanceof PrimitiveType and
      not p.getType() instanceof BoxedType and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      (
        cc.getConstructedType().hasQualifiedName("java.io", "File") or
        cc.getConstructedType().hasQualifiedName("java.io", "FileReader") or
        cc.getConstructedType().hasQualifiedName("java.io", "FileInputStream") or
        cc.getConstructedType().hasQualifiedName("org.springframework.core.io", "ClassPathResource") or
        cc.getConstructedType().hasQualifiedName("java.io", "FileOutputStream") or
        cc.getConstructedType().hasQualifiedName("javax.xml.transform", "StreamSource")
      ) and
      sink.asExpr() = cc.getAnArgument()
    )
    or
    exists(MethodAccess ma |
      (
        ma.getMethod().hasQualifiedName("java.nio.file", "Paths", "get") or
        ma.getMethod().hasQualifiedName("java.lang", "Class", "getResourceAsStream") or
        ma.getMethod().hasQualifiedName("java.lang", "Class", "getResource") or
        ma.getMethod().hasQualifiedName("org.springframework.util", "ResourceUtils", "getFile") or
        ma.getMethod().hasQualifiedName("org.apache.commons.io", "FileUtils", "openOutputStream")
      ) and
      sink.asExpr() = ma.getAnArgument()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.apache.commons.io", "FilenameUtils", "getName") and
      sanitizer.asExpr() = ma
    )
  }
}

from TaintedFilePathConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential path traversal vulnerability due to tainted file path from $@.", 
  source, "user input"