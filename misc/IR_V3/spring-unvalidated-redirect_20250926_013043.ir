```json
{
  "id": "spring-unvalidated-redirect",
  "kind": "pattern",
  "severity": "WARNING",
  "message": "Application redirects a user to a destination URL specified by a user supplied parameter that is not validated.",
  "metadata": {
    "cwe": ["CWE-601: URL Redirection to Untrusted Site ('Open Redirect')"],
    "owasp": ["A01:2021 - Broken Access Control"],
    "category": "security",
    "technology": ["spring"],
    "references": [
      "https://find-sec-bugs.github.io/bugs.htm#UNVALIDATED_REDIRECT",
      "https://owasp.org/Top10/A01_2021-Broken_Access_Control"
    ],
    "subcategory": "vuln",
    "likelihood": "MEDIUM",
    "impact": "MEDIUM",
    "confidence": "MEDIUM"
  },
  "languages": ["java"],
  "patterns": [
    {
      "description": "Direct return of unvalidated redirect URL",
      "pattern": "$X $METHOD(...,String $URL,...) {\n  return \"redirect:\" + $URL;\n}"
    },
    {
      "description": "Intermediate variable assignment before return",
      "pattern": "$X $METHOD(...,String $URL,...) {\n  ...\n  String $REDIR = \"redirect:\" + $URL;\n  ...\n  return $REDIR;\n  ...\n}"
    },
    {
      "description": "Direct ModelAndView construction with unvalidated URL",
      "pattern": "$X $METHOD(...,String $URL,...) {\n  ...\n  new ModelAndView(\"redirect:\" + $URL);\n  ...\n}"
    },
    {
      "description": "ModelAndView construction with intermediate variable",
      "pattern": "$X $METHOD(...,String $URL,...) {\n  ...\n  String $REDIR = \"redirect:\" + $URL;\n  ...\n  new ModelAndView($REDIR);\n  ...\n}"
    }
  ],
  "constraints": {
    "required_vars": ["$URL"],
    "forbidden_annotations": ["@Valid", "@Validated"]
  }
}
