```yaml
xcpgir_version: "1.0"
rule:
  id: "el-injection"
  kind: taint
  severity: WARNING
  message: "An expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."
scope:
  languages: [java]
  frameworks: ["*"]
sources:
  - id: DYNAMIC_INPUT
    match:
      node: PARAM | LOCAL
      where:
        - op: neq
          left: value
          right: ""
sinks:
  - id: VALUE_EXPRESSION
    match:
      node: CALL
      api: { type: "javax.el.ExpressionFactory", method: "createValueExpression" }
      arg_index: 1
  - id: METHOD_EXPRESSION
    match:
      node: CALL
      api: { type: "javax.el.ExpressionFactory", method: "createMethodExpression" }
      arg_index: 1
  - id: CONSTRAINT_VIOLATION
    match:
      node: CALL
      api: { method: "buildConstraintViolationWithTemplate" }
      arg_index: 0
sanitizers:
  - id: STRING_LITERAL
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "^\"[^\"]+\"$"
barriers: []
propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
flows:
  - source: DYNAMIC_INPUT
    sink: VALUE_EXPRESSION
    through: [ARG_TO_PARAM*]
  - source: DYNAMIC_INPUT  
    sink: METHOD_EXPRESSION
    through: [ARG_TO_PARAM*]
  - source: DYNAMIC_INPUT
    sink: CONSTRAINT_VIOLATION
    through: [ARG_TO_PARAM*]
report:
  message: "Potential EL injection detected"
  locations: ["source","sink"]
  evidence: { capture: [{ argument: 1 }, { argument: 0 }] }
tests:
  positive:
    - "ef.createValueExpression(context, userInput, Object.class);"
    - "obj.buildConstraintViolationWithTemplate(untrustedTemplate);"
  negative:
    - "ef.createValueExpression(context, \"safeLiteral\", Object.class);"
    - "String s = \"safe\"; ef.createMethodExpression(context, s, null, new Class[0]);"
```