```yaml
xcpgir_version: "1.0"
rule:
  id: autoescape-disabled
  kind: pattern
  severity: WARNING
  message: "Detected an element with disabled HTML escaping. If external data can reach this, this is a cross-site scripting (XSS) vulnerability. Ensure no external data can reach here, or remove 'escape=false' from this element."
scope:
  languages: [regex]
  frameworks: [jsf]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources:
  - id: DISABLED_ESCAPE
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: ".*escape.*?=.*?false.*"
sinks:
  - id: XSS_SINK
    match:
      node: CALL
      api: { type: "*", method: "*" }
      where:
        - op: eq
          left: target
          right: DISABLED_ESCAPE
sanitizers: []
barriers: []
propagations: []
flows:
  - source: DISABLED_ESCAPE
    sink: XSS_SINK
    constraints:
      path:
        must: [ { pattern: "LITERAL(escape=false)" } ]
report:
  message: "Detected an element with disabled HTML escaping. Potential XSS vulnerability."
  locations: ["source", "sink"]
tests:
  positive:
    - "<input escape=false>"
  negative:
    - "<input escape=true>"
```