```yaml
xcpgir_version: "1.0"
rule:
  id: eval-detected
  kind: pattern
  severity: WARNING
  message: "Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. If this content can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources."
scope:
  languages: [python]
  
sinks:
  - id: EVAL_CALL
    match:
      node: CALL
      api: { method: eval }
      
sanitizers:
  - id: LITERAL_ARG
    match:
      node: LITERAL
    effect: neutralize
    
barriers:
  - id: SAFE_LITERAL
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: '^\w+$'
    effect: stop

flows:
  - sink: EVAL_CALL
    constraints:
      path:
        must_not: [ { pattern: "LITERAL" } ]

report:
  locations: ["sink"]
  evidence: { capture: [{ node: "sink" }] }
```