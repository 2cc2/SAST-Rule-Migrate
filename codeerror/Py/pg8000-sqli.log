Rule Content:
/**
 * @name pg8000-sqli
 * @description Detected string concatenation with a non-literal variable in a pg8000
 * Python SQL statement. This could lead to SQL injection if the variable is user-controlled
 * and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pg8000-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.strings.Matching
import semmle.python.Concepts

class PG8000Connection extends DataFlow::Node {
  PG8000Connection() {
    exists(API::CallNode call |
      call.getFunc().(API::Node).getName() = "Connection" or
      call.getFunc().(API::Node).getName() = "Cursor" and
      call.getFunc().getDeclaringModule().getName() = "pg8000"
    )
  }
}

class PG8000Method extends DataFlow::Node {
  PG8000Method() {
    exists(API::CallNode call |
      call.getFunc().getName() = ["run", "execute", "executemany", "prepare"] and
      call.getFunc().getDeclaringModule().getName() = "pg8000"
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(DataFlow::SourceNode source |
      source.asExpr() = this.asExpr() and
      not this.getStringValue() = ""
    )
  }
}

class ParameterizedQuerySanitizer extends DataFlow::Node {
  ParameterizedQuerySanitizer() {
    exists(string s |
      this.getStringValue() = s and
      (
        regexpMatches(s, "^SELECT :") or
        regexpMatches(s, "^INSERT :") or
        regexpMatches(s, "^UPDATE :") or
        regexpMatches(s, "^DELETE :")
      )
    )
  }
}

class StringConcatPropagation extends DataFlow::Node {
  StringConcatPropagation() {
    exists(DataFlow::BinOpNode binop |
      (binop.getOp() = "CONCAT" or binop.getOp() = "FORMAT_STRING" or binop.getOp() = "*MODULO_FORMAT") and
      (binop.getLeftOperand() = this.asExpr() or binop.getRightOperand() = this.asExpr())
    )
  }
}

class PG8000SQLInjectionConfig extends TaintTracking::Configuration {
  PG8000SQLInjectionConfig() { this = "PG8000SQLInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(PG8000Method method |
      sink.asExpr() = method.getAnArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    node1 instanceof StringConcatPropagation and
    node1.asExpr().getAFlowNode() = node2.asExpr().getAFlowNode()
  }
}

from PG8000SQLInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection found in pg8000 query. Use parameterized queries or prepared statements instead."
