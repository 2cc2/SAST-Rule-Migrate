/**
 * @name pg8000-sqli
 * @description Detected string concatenation with a non-literal variable in a pg8000
 * Python SQL statement. This could lead to SQL injection if the variable is user-controlled
 * and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pg8000-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.ControlFlow
import DataFlow::PathGraph

class PG8000Connection extends TaintTracking::DataFlow::Node {
  PG8000Connection() {
    exists(MethodCall call |
      call.getMethodName() = "Connection" or
      call.getMethodName() = "Cursor" and
      call.getContainingModule().getName() = "pg8000" and
      this = call
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asExpr().getControlFlowNode() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = "PG8000Connection" }
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { result = this.asExpr().asVariable() }
}

class PG8000Method extends TaintTracking::DataFlow::Node {
  PG8000Method() {
    exists(MethodCall call |
      call.getMethodName() = ["run", "execute", "executemany", "prepare"] and
      call.getContainingModule().getName() = "pg8000" and
      this = call
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asExpr().getControlFlowNode() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = "PG8000Method" }
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { result = this.asExpr().asVariable() }
}

class UserInputSource extends TaintTracking::DataFlow::Node {
  UserInputSource() {
    exists(TaintTracking::DataFlow::Node source |
      this = source and
      not source.asExpr().getUnquotedString() = ""
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asExpr().getControlFlowNode() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = "UserInputSource" }
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { result = this.asExpr().asVariable() }
}

class ParameterizedQuerySanitizer extends TaintTracking::DataFlow::Node {
  ParameterizedQuerySanitizer() {
    exists(string s |
      this.asExpr().getUnquotedString() = s and
      (
        s.matches("^SELECT :") or
        s.matches("^INSERT :") or
        s.matches("^UPDATE :") or
        s.matches("^DELETE :")
      )
    )
  }

