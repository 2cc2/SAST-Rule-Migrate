Rule Content:
/**
 * @name pg8000-sqli
 * @description Detected string concatenation with a non-literal variable in a pg8000
 * Python SQL statement. This could lead to SQL injection if the variable is user-controlled
 * and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pg8000-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class PG8000Connection extends DataFlow::Node {
  PG8000Connection() {
    exists(MethodCall call |
      call.getMethodName() = "Connection" or
      call.getMethodName() = "Cursor" and
      call.getContainingModule().getName() = "pg8000" and
      this = call
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asControlFlowNode() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asBasicBlock() }
  override Scope getScope() { result = this.getScope() }
  override string toString() { result = "PG8000Connection" }
  override Variable asVariable() { result = this.asVariable() }
}

class PG8000Method extends DataFlow::Node {
  PG8000Method() {
    exists(MethodCall call |
      call.getMethodName() = ["run", "execute", "executemany", "prepare"] and
      call.getContainingModule().getName() = "pg8000" and
      this = call
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asControlFlowNode() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asBasicBlock() }
  override Scope getScope() { result = this.getScope() }
  override string toString() { result = "PG8000Method" }
  override Variable asVariable() { result = this.asVariable() }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(DataFlow::Node source |
      this = source and
      not source.asExpr().getUnquotedString() = ""
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asControlFlowNode() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asBasicBlock() }
  override Scope getScope() { result = this.getScope() }
  override string toString() { result = "UserInputSource" }
  override Variable asVariable() { result = this.asVariable() }
}

class ParameterizedQuerySanitizer extends DataFlow::Node {
  ParameterizedQuerySanitizer() {
    exists(string s |
      this.asExpr().getUnquotedString() = s and
      (
        s.regexpMatches("^SELECT :") or
        s.regexpMatches("^INSERT :") or
        s.regexpMatches("^UPDATE :") or
        s.regexpMatches("^DELETE :")
      )
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asControlFlowNode() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asBasicBlock() }
  override Scope getScope() { result = this.getScope() }
  override string toString() { result = "ParameterizedQuerySanitizer" }
  override Variable asVariable() { result = this.asVariable() }
}

class StringConcatPropagation extends DataFlow::Node {
  StringConcatPropagation() {
    exists(BinaryExpr binop |
      (binop.getOperator() = "+" or binop.getOperator() = "%") and
      (binop.getLeftOperand() = this or binop.getRightOperand() = this)
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asControlFlowNode() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asBasicBlock() }
  override Scope getScope() { result = this.getScope() }
  override string toString() { result = "StringConcatPropagation" }
  override Variable asVariable() { result = this.asVariable() }
}

class PG8000SQLInjectionConfig extends TaintTracking::Configuration {
  PG8000SQLInjectionConfig() { this = "PG8000SQLInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(PG8000Method method |
      sink = method.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    node1 instanceof StringConcatPropagation and
    node1.getASuccessorNode() = node2
  }
}

from PG8000SQLInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection found in pg8000 query. Use parameterized queries or prepared statements instead."
