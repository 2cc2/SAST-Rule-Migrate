import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking

class PG8000Connection extends TaintTracking::DataFlow::Node {
  PG8000Connection() {
    exists(Ast::Call call |
      call.getCalleeName() = "Connection" or
      call.getCalleeName() = "Cursor" and
      call.getContainingModule().getName() = "pg8000" and
      this = call
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asExpr().getControlFlowNode() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = "PG8000Connection" }
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { result = this.asExpr().asVariable() }
}

class PG8000Method extends TaintTracking::DataFlow::Node {
  PG8000Method() {
    exists(Ast::Call call |
      call.getCalleeName() = ["run", "execute", "executemany", "prepare"] and
      call.getContainingModule().getName() = "pg8000" and
      this = call
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asExpr().getControlFlowNode() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = "PG8000Method" }
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { result = this.asExpr().asVariable() }
}

class UserInputSource extends TaintTracking::DataFlow::Node {
  UserInputSource() {
    exists(TaintTracking::DataFlow::Node source |
      this = source and
      not source.toString() = ""
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asExpr().getControlFlowNode() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = "UserInputSource" }
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { result = this.asExpr().asVariable() }
}

class ParameterizedQuerySanitizer extends TaintTracking::DataFlow::Node {
  ParameterizedQuerySanitizer() {
    exists(string s |
      this.toString() = s and
      (
        s.regexpMatch("^SELECT :.*") or
        s.regexpMatch("^INSERT :.*") or
        s.regexpMatch("^UPDATE :.*") or
        s.regexpMatch("^DELETE :.*")
      )
    )
  }

  override ControlFlow::ControlFlowNode asCfgNode() { result = this.asExpr().getControlFlowNode() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = "ParameterizedQuerySanitizer" }
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { result = this.asExpr().asVariable() }
}

class PG8000SQLInjectionConfig extends TaintTracking::Configuration {
  PG8000SQLInjectionConfig() { this = "PG8000SQLInjection" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) {
    exists(PG8000Method method | sink = method.getArgument(0))
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node src, DataFlow::Node dst) {
    exists(StringConcatPropagation str | str = src and dst = str.getASuccessor())
  }
}

from PG8000SQLInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection found in pg8000 query. Use parameterized queries.", 
  source, "User input flows to query here."
================================================================================
