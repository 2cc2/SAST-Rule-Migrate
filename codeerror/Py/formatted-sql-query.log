/**
 * @id formatted-sql-query
 * @kind path-problem
 * @severity warning
 * @name Detected possible formatted SQL query
 * @description Using string formatting for SQL queries may lead to SQL injection vulnerabilities. Use parameterized queries instead.
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.functions.MethodCall
import DataFlow::PathGraph

class StringFormatCall extends DataFlow::Node {
  MethodCall call;

  StringFormatCall() {
    exists(string name |
      name = call.getTarget().getName() |
      name.matches("%") or
      name.matches("format") or
      name.matches("f-string")
    ) and
    this.asExpr() = call
  }

  override DataFlow::CfgNode asCfgNode() { result = call }

  override string toString() { result = call.toString() }

  override Location getLocation() { result = call.getLocation() }

  override DataFlow::BasicBlock getBasicBlock() { result = call.getBasicBlock() }

  override DataFlow::Scope getScope() { result = call.getScope() }

  override DataFlow::Variable asVariable() { none() }
}

class SqlExecuteCall extends DataFlow::Node {
  MethodCall call;

  SqlExecuteCall() {
    call.getTarget().getName() = "execute" and
    this.asExpr() = call.getArgument(0)
  }

  override DataFlow::CfgNode asCfgNode() { result = call }

  override string toString() { result = call.toString() }

  override Location getLocation() { result = call.getLocation() }

  override DataFlow::BasicBlock getBasicBlock() { result = call.getBasicBlock() }

  override DataFlow::Scope getScope() { result = call.getScope() }

  override DataFlow::Variable asVariable() { none() }
}

class FormattedSqlFlow extends DataFlow::Configuration {
  FormattedSqlFlow() { this = "Formatted SQL Flow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatCall
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteCall
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, FormattedSqlFlow flow
where flow.hasFlowPath(source, sink)
select sink.getNode(), "Detected possible formatted SQL query. Use parameterized queries instead.",
  source.getNode(), "String formatting operation here",
  sink.getNode(), "SQL execution found here"
