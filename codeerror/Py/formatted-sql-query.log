Rule Content:
/**
 * @id formatted-sql-query
 * @kind path-problem
 * @severity warning
 * @name Detected possible formatted SQL query
 * @description Using string formatting for SQL queries may lead to SQL injection vulnerabilities. Use parameterized queries instead.
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ControlFlow
import semmle.python.dataflow.PathGraph

class StringFormatCall extends TaintTracking::TaintSource {
  semmle.python.Concepts.MethodCall call;
  
  StringFormatCall() {
    exists(semmle.python.Concepts.MethodCall c |
      c.getTarget().getName().matches("%") or
      c.getTarget().getName().matches("format") or
      c.getTarget().getName().matches("f-string")
    ) and
    call = _ and
    this = TaintTracking::convertSource(call.asExpr())
  }
  
  override string toString() { result = call.toString() }
  
  override Location getLocation() { result = call.getLocation() }
}

class SqlExecuteCall extends TaintTracking::TaintSink {
  semmle.python.Concepts.MethodCall call;
  
  SqlExecuteCall() {
    exists(semmle.python.Concepts.MethodCall c |
      c.getTarget().getName() = "execute"
    ) and
    call = _ and
    this = TaintTracking::convertSink(call.getArgument(0))
  }
  
  override string toString() { result = call.toString() }
  
  override Location getLocation() { result = call.getLocation() }
}

class FormattedSqlFlow extends TaintTracking::Configuration {
  FormattedSqlFlow() { this = "Formatted SQL Flow" }
  
  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof StringFormatCall
  }
  
  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SqlExecuteCall
  }
}

from PathGraph::PathNode source, PathGraph::PathNode sink, FormattedSqlFlow flow
where flow.hasFlowPath(source, sink)
select sink.getNode(), "Detected possible formatted SQL query. Use parameterized queries instead.",
  source.getNode(), "String formatting operation here",
  sink.getNode(), "SQL execution found here"
