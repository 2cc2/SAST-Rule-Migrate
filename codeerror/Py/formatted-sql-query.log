/**
 * @id formatted-sql-query
 * @kind path-problem
 * @severity warning
 * @name Detected possible formatted SQL query
 * @description Using string formatting for SQL queries may lead to SQL injection vulnerabilities. Use parameterized queries instead.
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.dataflow.DataFlow

class StringFormatCall extends DataFlow::Node {
  MethodCall call;
  ControlFlowNode cfgNode;
  
  StringFormatCall() {
    exists(ControlFlowNode node, MethodCall c |
      node = c and
      c.getTarget().getName().matches("%") or
      c.getTarget().getName().matches("format") or
      c.getTarget().getName().matches("f-string")
    ) and
    this = call and
    cfgNode = call
  }
  
  override ControlFlowNode asCfgNode() { result = cfgNode }
  
  override string toString() { result = call.toString() }
  
  override Location getLocation() { result = call.getLocation() }
  
  override BasicBlock getBasicBlock() { result = call.getBasicBlock() }
  
  override Scope getScope() { result = call.getScope() }
  
  override EssaVariable asVariable() { none() }
}

class SqlExecuteCall extends DataFlow::Node {
  MethodCall call;
  ControlFlowNode cfgNode;
  
  SqlExecuteCall() {
    exists(ControlFlowNode node, MethodCall c |
      node = c and
      c.getTarget().getName() = "execute"
    ) and
    this = call.getArgument(0) and
    cfgNode = call
  }
  
  override ControlFlowNode asCfgNode() { result = cfgNode }
  
  override string toString() { result = call.toString() }
  
  override Location getLocation() { result = call.getLocation() }
  
  override BasicBlock getBasicBlock() { result = call.getBasicBlock() }
  
