/**
 * @name Paramiko exec_command unverified command execution
 * @description Detects unverified command execution through Paramiko's SSHClient.exec_command without proper input sanitization
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs::API

class SSHClientSource extends TaintTracking::Source {
  SSHClientSource() {
    exists(API::CallOrImport mc |
      mc.getCallee().getDeclaringType().hasQualifiedName("paramiko.client", "SSHClient") and
      mc.getCallee().getName() = "SSHClient" and
      this.asSource() = mc.getCallee()
    )
  }
}

class ExecCommandSink extends TaintTracking::Sink {
  ExecCommandSink() {
    exists(API::CallOrImport mc |
      mc.getCallee().getDeclaringType().hasQualifiedName("paramiko.client", "SSHClient") and
      mc.getCallee().getName() = "exec_command" and
      this.asSink() = mc.getArg(0) and
      not mc.getArg(0).getValue().toString().regexpMatch("\\.\\.")
    )
  }
}

class ParamikoCommandInjectionConfig extends TaintTracking::Configuration {
  ParamikoCommandInjectionConfig() {
    this = "ParamikoCommandInjectionConfig"
  }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof SSHClientSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof ExecCommandSink
  }
}

from ParamikoCommandInjectionConfig cfg, TaintTracking::PathNode source, TaintTracking::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "Unverified command execution detected. " +
  "This will permit execution of potentially malicious commands. " +
  "Always validate and sanitize command inputs."
