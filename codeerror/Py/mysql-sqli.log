/**
 * @name MySQL SQL Injection from Lambda Event
 * @description Detects SQL statements that are tainted by AWS Lambda `event` object.
 * @kind path-problem
 * @problem.severity warning
 * @id python/mysql-sqli
 */

import python
import DataFlow::TaintTracking
import DataFlow::PathGraph
import DataFlow::PathNode

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      f.getName() = "$HANDLER" and
      p = f.getAParameter(_) and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class MySQLExecuteSink extends DataFlow::Node {
  MySQLExecuteSink() {
    exists(Call call, Value method |
      method.getFile().getBaseName().matches("%mysql%") and
      call.getCallee() = method and
      (
        method.getName() = "execute" and call.getArgument(0).getExpr() = this or
        method.getName() = "executemany" and call.getArgument(0).getExpr() = this
      )
    )
  }
}

class MySQLSQLiConfig extends DataFlow::TaintTracking::Configuration {
  MySQLSQLiConfig() { this = "MySQLSQLiConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MySQLExecuteSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, MySQLSQLiConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection from unsanitized Lambda event object."
