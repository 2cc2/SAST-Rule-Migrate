Rule Content:
/**
 * @name Tainted URL Host Construction
 * @description User data flows into the host portion of this manually-constructed URL.
 *              This could allow an attacker to send data to their own server, potentially
 *              exposing sensitive data such as cookies or authorization information sent
 *              with this request. They could also probe internal servers or other resources
 *              that the server running this code can access (SSRF vulnerability).
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-url-host
 */

import python
import python.web.flask.Request
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(API::Call call |
      call.getMethodName().matches("request.*") and
      call.getReceiver().getType().getName() = "flask.request"
      or
      this instanceof RemoteUserInput
    )
  }
}

class RouteVarSource extends DataFlow::Node {
  RouteVarSource() {
    exists(Parameter p |
      p.getName().matches(".*route.*")
    )
  }
}

class UrlConstructionSink extends DataFlow::Node {
  UrlConstructionSink() {
    exists(API::Call call |
      call.getCode().matches(".*://.*")
    )
  }
}

class TaintedUrlHostConfig extends DataFlow::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteVarSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrlConstructionSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedUrlHostConfig config
where config.hasFlowPath(source, sink)
select sink, "User data flows into the host portion of this manually-constructed URL. " +
       "This could allow an attacker to send data to their own server, potentially " +
       "exposing sensitive data such as cookies or authorization information sent with " +
       "this request. They could also probe internal servers or other resources that " +
       "the server running this code can access. (This is called server-side request " +
       "forgery, or SSRF.) Do not allow arbitrary hosts. Instead, create an allowlist " +
       "for approved hosts, or hardcode the correct host.", 
       source, "User-provided data flows to URL host construction"
