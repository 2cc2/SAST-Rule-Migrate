import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.code.python.api.Api

class DynamicCodeInput extends DataFlow::Node {
  DynamicCodeInput() {
    exists(DataFlow::Call call |
      call.getMethodName().regexpMatch(".*\\.(push|runsource|runcode|compile_command)") and
