Rule Content:
/**
 * @name Dangerous interactive code run
 * @description Dynamic content inside InteractiveConsole/InteractiveInterpreter method detected.
 *              This is dangerous if external data can reach this function call because it allows
 *              a malicious actor to run arbitrary Python code.
 * @kind taint
 * @problem.severity warning
 * @id py/dangerous-interactive-code-run
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class DynamicCodeInput extends DataFlow::Python::Node {
  DynamicCodeInput() { this = result }

  override predicate isSource() { 
    exists(Python::Call call |
      call.getMethodName().regexpMatch(".*\\.(push|runsource|runcode|compile_command)") and
      not this.getExpr() instanceof Python::StringLiteral and
      this = call.getArgument(0).asSource()
    )
  }

  override Python::Expr getExpr() { result = this.getNode().asExpr() }

  override string toString() { result = "Dynamic code input" }
}

class CodeExecutionSink extends DataFlow::Python::Node {
  CodeExecutionSink() { this = result }

  override predicate isSink() {
    exists(Python::MethodAccess call |
      (call.getReceiver().getType().getName() = "InteractiveConsole" or
       call.getReceiver().getType().getName() = "InteractiveInterpreter") and
      call.getMethodName() in ["push", "runsource", "runcode"]
    )
  }

  override Python::Expr getExpr() { result = this.getNode().asExpr() }

  override string toString() { result = "Code execution sink" }
}

class DangerousInteractiveRunConfig extends TaintTracking::Configuration {
  DangerousInteractiveRunConfig() { this = "DangerousInteractiveRunConfig" }

  override predicate isSource(TaintTracking::TaintSource source) { 
    source.contains(any(DynamicCodeInput dci | dci = source.asSource())) 
  }

  override predicate isSink(TaintTracking::TaintSink sink) { 
    sink.contains(any(CodeExecutionSink ces | ces = sink.asSink()))
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer.asCandidate().getExpr() instanceof Python::StringLiteral
  }
}

from DangerousInteractiveRunConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
