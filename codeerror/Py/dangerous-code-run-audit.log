Rule Content:
/**
 * @name Dangerous interactive code run
 * @description Dynamic content inside InteractiveConsole/InteractiveInterpreter method detected.
 *              This is dangerous if external data can reach this function call because it allows
 *              a malicious actor to run arbitrary Python code.
 * @kind taint
 * @problem.severity warning
 * @id py/dangerous-interactive-code-run
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking

/**
 * @kind source
 * @description Source of potentially dangerous code input
 */
class DynamicCodeInput extends TaintTracking::TrackedSource {
  DynamicCodeInput() { 
    exists(Python::Call call |
      call.getMethod().getName().regexpMatch(".*\\.(push|runsource|runcode|compile_command)") and
      not call.getArgument(0).asExpr() instanceof Python::StringLiteral and
      this = call.getArgument(0).asSource()
    )
  }

  override predicate isSourceOf(TaintTracking::TaintFlow flow) {
    exists(Python::Call call |
      call.getMethod().getName().regexpMatch(".*\\.(push|runsource|runcode|compile_command)") and
      flow.getSourceNode() = this and
      this = call.getArgument(0).asSource()
    )
  }

  override Python::Expr asExpr() { result = this.asSource().asExpr() }
}

/**
 * @kind sink
 * @description Dangerous code execution sink
 */
class CodeExecutionSink extends TaintTracking::TrackedSink {
  CodeExecutionSink() {
    exists(Python::MethodAccess call |
      (call.getReceiver().getType().getName() = "InteractiveConsole" or
       call.getReceiver().getType().getName() = "InteractiveInterpreter") and
      call.getMethod().getName() in ["push", "runsource", "runcode"] and
      this = call.asSink()
    )
  }

  override predicate isSinkOf(TaintTracking::TaintFlow flow) {
    exists(Python::MethodAccess call |
      (call.getReceiver().getType().getName() = "InteractiveConsole" or
       call.getReceiver().getType().getName() = "InteractiveInterpreter") and
      call.getMethod().getName() in ["push", "runsource", "runcode"] and
      flow.getSinkNode() = this and
      this = call.asSink()
    )
  }

  override Python::Expr asExpr() { result = this.asSink().asExpr() }
}

class DangerousInteractiveRunConfig extends TaintTracking::Configuration {
  DangerousInteractiveRunConfig() { this = "DangerousInteractiveRunConfig" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof DynamicCodeInput
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof CodeExecutionSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer.asCandidate().asExpr() instanceof Python::StringLiteral
  }
}

from DangerousInteractiveRunConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
       "This is dangerous if external data can reach this function call because it allows " +
       "a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
