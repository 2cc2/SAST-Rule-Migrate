Rule Content:
/**
 * @name SQL Injection in SQLAlchemy Distinct/Having/Group_by/Order_by/Filter
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause
 *              SQL injections if the developer inputs raw SQL into the before-mentioned clauses.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class UserInputSource extends DataFlow::Source {
  UserInputSource() {
    exists(Parameter p | p = this.asParameter() | 
      not p.getName() = "bindparams"
    )
  }
}

class DangerousSqlAlchemyMethod extends DataFlow::Sink {
  DangerousSqlAlchemyMethod() {
    exists(MethodCall mc, string methodName |
      mc = this.asExpr() and
      methodName = mc.getCalleeName() and
      methodName.regexpMatch("(group_by|order_by|distinct|having|filter)") and
      mc.getReceiver().getType().getName() = "sqlalchemy.orm.query.Query" and
      not exists(MethodCall b | 
        b.getCalleeName() = "bindparams" and
        b.getReceiver() = mc.getReceiver()
      )
    )
  }
}

class BindParamsSanitizer extends DataFlow::Sanitizer {
  BindParamsSanitizer() {
    exists(MethodCall mc | 
      mc = this.asExpr() and
      mc.getCalleeName() = "bindparams" and
      mc.getReceiver().getType().getName() = "sqlalchemy.orm.query.Query"
    )
  }
}

module TaintConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }
  predicate isSink(DataFlow::Node sink) { sink instanceof DangerousSqlAlchemyMethod }
  predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof BindParamsSanitizer }
}

from TaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where DataFlow::flowPath(source, sink, cfg)
select sink.getNode(), source, sink, "Potential SQL injection via SQLAlchemy method with user input"
