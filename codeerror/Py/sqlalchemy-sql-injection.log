/**
 * @name SQL Injection in SQLAlchemy Distinct/Having/Group_by/Order_by/Filter
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause
 *              SQL injections if the developer inputs raw SQL into the before-mentioned clauses.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.CallNode

class UserInputSource extends TaintTracking::Source {
  UserInputSource() {
    exists(Parameter p | p = this.asParameter() |
      not p.getName() = "bindparams"
    )
  }

  override predicate isSource(TaintKind kind) {
    kind = "SQL"
  }
}

class DangerousSqlAlchemyMethod extends TaintTracking::Sink {
  DangerousSqlAlchemyMethod() {
    exists(CallNode mc, string methodName |
      mc = this.asExpr() and
      methodName = mc.getCalleeName() and
      methodName.regexpMatch("(group_by|order_by|distinct|having|filter)") and
      mc.getReceiver().getType().getName() = "sqlalchemy.orm.query.Query" and
      not exists(CallNode b |
        b.getCalleeName() = "bindparams" and
        b.getReceiver() = mc.getReceiver()
      )
    )
  }

  override predicate sinks(TaintKind kind) {
    kind = "SQL"
  }
}

class BindParamsSanitizer extends TaintTracking::Sanitizer {
  BindParamsSanitizer() {
    exists(CallNode mc |
      mc = this.asExpr() and
      mc.getCalleeName() = "bindparams" and
      mc.getReceiver().getType().getName() = "sqlalchemy.orm.query.Query"
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  override predicate isSource(TaintTracking::Source source) { source instanceof UserInputSource }
  override predicate isSink(TaintTracking::Sink sink) { sink instanceof DangerousSqlAlchemyMethod }
  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof BindParamsSanitizer
  }
}

