/**
 * @name SQL Injection in SQLAlchemy Distinct/Having/Group_by/Order_by/Filter
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause
 *              SQL injections if the developer inputs raw SQL into the before-mentioned clauses.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class UserInputSource extends TaintTracking::TaintSource {
  UserInputSource() {
    exists(Parameter p | p = this.asParameter() | 
      not p.getName() = "bindparams"
    )
  }

  override predicate isSourceOf(TaintKind kind) {
    kind = TaintKind::SQL
  }
}

class DangerousSqlAlchemyMethod extends TaintTracking::TaintSink {
  DangerousSqlAlchemyMethod() {
    exists(DataFlow::Node mc, string methodName |
      mc = this.asExpr() and
      methodName = mc.(CallNode).getCalleeName() and
      methodName.regexpMatch("(group_by|order_by|distinct|having|filter)") and
