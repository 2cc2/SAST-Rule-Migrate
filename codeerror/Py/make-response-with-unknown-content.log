/**
 * @name make-response-with-unknown-content
 * @description Be careful with `flask.make_response()`. If this response is rendered
 * onto a webpage, this could create a cross-site scripting (XSS) vulnerability.
 * `flask.make_response()` will not autoescape HTML. If you are rendering HTML, write
 * your HTML in a template file and use `flask.render_template()` which will take care
 * of escaping. If you are returning data from an API, consider using `flask.jsonify()`.
 * @kind path-problem
 * @problem.severity warning
 * @id python/xss/make-response-with-unknown-content
 */

import python
from Value call, Value arg, string packageName, string methodName
where
  call.getCallInfo().getCaller() = arg and
  call.getCallInfo().getName() = methodName and
  call.getCallInfo().getPackage() = packageName
select call, packageName, methodName

predicate isSafeArgument(Value arg) {
  exists(StrLiteral literal | arg = literal) or
  exists(Call call | 
    call.getCallInfo().getName() = ["redirect", "render_template", "jsonify"] and
    call.getCallInfo().getPackage() = "flask"
  ) or
  exists(Call call | 
    call.getCallInfo().getName() = "dumps" and
    call.getCallInfo().getPackage() = "json"
  )
}

from Call makeResponse, Value arg
where
  makeResponse.getCallInfo().getName() = "make_response" and
  makeResponse.getCallInfo().getPackage() = "flask" and
  arg = makeResponse.getCallInfo().getArgument(0) and
  not isSafeArgument(arg)
select makeResponse, 
  "Potential XSS vulnerability: flask.make_response() called with unknown input that isn't properly escaped.",
  makeResponse,
  "This response may contain unescaped user input."
