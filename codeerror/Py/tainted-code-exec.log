Rule Content:
/**
 * @name Tainted Code Execution
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic content.
 *              If this content can be input from outside the program, this may be a code injection vulnerability.
 *              Ensure evaluated content is not definable by external sources.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-code-exec
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class EvalExecCall extends DataFlow::Call {
  EvalExecCall() {
    getTarget().getName() in ["eval", "exec"] and
    getTarget().getModuleScope() = "builtins"
  }
}

class InputParameter extends DataFlow::ParameterNode {
  InputParameter() {
    getParentScope().getName().matches("^HANDLER") and
    getName() = "event"
  }
}

class TaintedCodeExecutionConfig extends TaintTracking::Configuration {
  TaintedCodeExecutionConfig() { this = "TaintedCodeExecutionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asParameterNode() instanceof InputParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(EvalExecCall call |
      sink.asExpr() = call.getArg(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedCodeExecutionConfig config
where config.hasFlowPath(source, sink)
select sink, "Potential code injection vulnerability from dynamic code execution ($@).", source,
  "This call executes dynamic code that may be influenced by an external input."
