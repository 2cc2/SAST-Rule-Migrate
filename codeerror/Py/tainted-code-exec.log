import python
import DataFlow
import DataFlow::PathGraph

class EvalExecCall extends Call {
  EvalExecCall() {
    getTarget().getName() = ["eval", "exec"] and
    getTarget().getModuleScope() = "builtins"
  }
}

class InputParameter extends Parameter {
  InputParameter() {
    getParentScope().getName().regexpMatch("^HANDLER") and
    getName() = "event"
