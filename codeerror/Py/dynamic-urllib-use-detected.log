Rule Content:
/**
 * @name Dynamic urllib use detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes,
 *              so a dynamic value controlled by a malicious actor may allow them to read arbitrary 
 *              files. Audit uses of urllib calls to ensure user data cannot control the URLs, or 
 *              consider using the 'requests' library instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/dynamic-urllib-use
 */

import python
import semmle.python.Security.JsRequestForgery
import semmle.python.Security.TaintTracking
import DataFlow::PathGraph

class DynamicUrlConfiguration extends TaintTracking::Configuration {
  DynamicUrlConfiguration() { this = "DynamicUrlConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    (
      exists(CallNode call |
        (call.getTarget().hasQualifiedName("urllib", "urlopen") or
         call.getTarget().hasQualifiedName("urllib", "urlretrieve")) and
        source.asExpr() = call.getArgument(0) and
        not call.getArgument(0).getStringValue().regexpMatch(".*hardcoded-url.*")
      )
      or
      exists(Class cls, CallNode call |
        cls.hasQualifiedName("urllib", "URLopener") and
        call.getTarget().getDeclaringType() = cls and
        not call.getTarget().getName().regexpMatch(".*hardcoded-opener.*")
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(CallNode call |
      (call.getTarget().hasQualifiedName("urllib", "urlopen") or
       call.getTarget().hasQualifiedName("urllib", "urlretrieve")) and
      sink.asExpr() = call.getArgument(0)
    )
    or
    exists(Class cls, CallNode call |
      cls.hasQualifiedName("urllib", "URLopener") and
      call.getTarget().getDeclaringType() = cls and
      (call.getTarget().getName() = "open" or call.getTarget().getName() = "retrieve") and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr().getStringValue().regexpMatch("^https?://")
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, DynamicUrlConfiguration config
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Dynamic value used with urllib may allow arbitrary file read.", source, 
  "This value comes from $@.", source.getNode(), "user-provided value"
