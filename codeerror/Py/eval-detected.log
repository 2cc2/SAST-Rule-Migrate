Rule Content:
/**
 * @name eval-detected
 * @description Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. 
 *              If this content can be input from outside the program, this may be a code injection 
 *              vulnerability. Ensure evaluated content is not definable by external sources.
 * @kind problem
 * @problem.severity warning
 * @id py/eval-detected
 */

import python

predicate isEvalCall(Expr call) {
  exists(Method evalMethod |
    evalMethod.hasName("eval") and
    call.getCallee() = evalMethod.getACallable()    
  )
}

from Call call, Expr arg
where
  isEvalCall(call) and
  arg = call.getArgument(0) and
  not arg instanceof StringLiteral
select call, "Detected use of eval() with non-constant argument. This may lead to code injection vulnerability."
