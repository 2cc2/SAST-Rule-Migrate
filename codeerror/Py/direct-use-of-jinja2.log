Rule Content:
/**
 * @name Direct use of jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping which opens up the application to cross-site scripting (XSS) vulnerabilities. Prefer using the Flask method 'render_template()' and templates with a '.html' extension in order to prevent XSS.
 * @kind path-problem
 * @problem.severity warning
 * @id python/direct-use-of-jinja2
 */

import python
import semmle.python.ApiGraphs
import semmle.python.DataFrame
import semmle.python.Concepts

class Jinja2EnvironmentCall extends Call {
  Jinja2EnvironmentCall() {
    this.getTarget().(QualifiedName).getPackage() = "jinja2" and
    this.getTarget().(QualifiedName).getName() = "Environment"
  }
}

class Jinja2TemplateRenderCall extends Call {
  Jinja2TemplateRenderCall() {
    this.getTarget().(QualifiedName).getPackage() = "jinja2" and
    this.getTarget().(QualifiedName).getTypeName() = "Template" and
    this.getTarget().(QualifiedName).getMethod() = "render"
  }
}

class TemplateGetRenderPattern extends Call {
  TemplateGetRenderPattern() {
    exists(DataFlow::Node template |
      exists(MethodCall getTemplateCall |
        getTemplateCall.getTarget().toString() = "get_template" and
        getTemplateCall.getResult() = template and
        this.getTarget().toString() = "render" and
        this.getReceiver() = template
      )
    )
  }
}

class DirectTemplateRenderPattern extends Call {
  DirectTemplateRenderPattern() {
    exists(DataFlow::Node template |
      exists(Call templateCreate |
        templateCreate.getTarget().(QualifiedName).getPackage() = "jinja2" and
        templateCreate.getTarget().(QualifiedName).getTypeName() = "Template" and
        templateCreate.getResult() = template and
        this.getTarget().toString() = "render" and
        this.getReceiver() = template
      )
    )
  }
}

class FlaskRenderTemplateSanitizer extends Call {
  FlaskRenderTemplateSanitizer() {
    this.getTarget().(QualifiedName).getPackage() = "flask" and
    this.getTarget().(QualifiedName).getMethod() = "render_template"
  }
}

query predicate isSource(Call c) {
  c instanceof Jinja2EnvironmentCall or
  c instanceof Jinja2TemplateRenderCall or
  c instanceof TemplateGetRenderPattern or
  c instanceof DirectTemplateRenderPattern
}

query predicate isSanitizer(Call c) {
  c instanceof FlaskRenderTemplateSanitizer
}

from Call source, DataFlow::Node sink
where
  isSource(source) and
  DataFlow::localFlow(DataFlow::exprNode(source), sink) and
  not exists(DataFlow::Node san |
    isSanitizer(san.getNode().(Call)) and
    DataFlow::flowsTo(san, sink)
  )
select sink, source, "Detected direct use of jinja2. Prefer using Flask's 'render_template()' to prevent XSS."
