Rule Content:
/**
 * @name Direct use of jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping which opens up the application to cross-site scripting (XSS) vulnerabilities. Prefer using the Flask method 'render_template()' and templates with a '.html' extension in order to prevent XSS.
 * @kind path-problem
 * @problem.severity warning
 * @id python/direct-use-of-jinja2
 */

import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph
import semmle.python.Web

class Jinja2EnvironmentCall extends API::Call {
  Jinja2EnvironmentCall() {
    this.getCallee().(QualifiedName).getPackage() = "jinja2" and
    this.getCallee().(QualifiedName).getName() = "Environment"
  }
}

class Jinja2TemplateRenderCall extends API::Call {
  Jinja2TemplateRenderCall() {
    this.getCallee().(QualifiedName).getPackage() = "jinja2" and
    this.getCallee().(QualifiedName).getTypeName() = "Template" and
    this.getCallee().(QualifiedName).getMethod() = "render"
  }
}

class TemplateGetRenderPattern extends API::Call {
  TemplateGetRenderPattern() {
    exists(DataFlow::PathNode template |
      exists(API::MethodCall getTemplateCall |
        getTemplateCall.getCallee().toString() = "get_template" and
        getTemplateCall.getResultExpr() = template and
        this.getCallee().toString() = "render" and
        this.getReceiverScope() = template
      )
    )
  }
}

class DirectTemplateRenderPattern extends API::Call {
  DirectTemplateRenderPattern() {
    exists(DataFlow::PathNode template |
      exists(API::Call templateCreate |
        templateCreate.getCallee().(QualifiedName).getPackage() = "jinja2" and
        templateCreate.getCallee().(QualifiedName).getTypeName() = "Template" and
        templateCreate.getResultExpr() = template and
        this.getCallee().toString() = "render" and
        this.getReceiverScope() = template
      )
    )
  }
}

class FlaskRenderTemplateSanitizer extends API::Call {
  FlaskRenderTemplateSanitizer() {
    this.getCallee().(QualifiedName).getPackage() = "flask" and
    this.getCallee().(QualifiedName).getMethod() = "render_template"
  }
}

query predicate isSource(API::Call c) {
  c instanceof Jinja2EnvironmentCall or
  c instanceof Jinja2TemplateRenderCall or
  c instanceof TemplateGetRenderPattern or
  c instanceof DirectTemplateRenderPattern
}

query predicate isSanitizer(API::Call c) {
  c instanceof FlaskRenderTemplateSanitizer
}

from API::Call source, DataFlow::PathNode sink
where
  isSource(source) and
  DataFlow::localFlow(DataFlow::PathNode::exprNode(source), sink) and
  not exists(DataFlow::PathNode san |
    isSanitizer(san.getNode().(API::Call)) and
    DataFlow::flowsTo(san, sink)
  )
select sink, source, "Detected direct use of jinja2. Prefer using Flask's 'render_template()' to prevent XSS."
