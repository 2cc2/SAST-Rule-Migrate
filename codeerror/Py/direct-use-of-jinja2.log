  id: direct-use-of-jinja2
  kind: pattern
  severity: WARNING
  message: "Detected direct use of jinja2. If not done properly, this may bypass HTML escaping which opens up the application to cross-site scripting (XSS) vulnerabilities. Prefer using the Flask method 'render_template()' and templates with a '.html' extension in order to prevent XSS."

sources:
  - id: JINJA2_ENV
    match:
      node: CALL
      api: { package: jinja2, type: Environment }
  - id: JINJA2_TEMPLATE_RENDER
    match:
      node: CALL
      api: { package: jinja2, type: Template, method: render }
  - id: TEMPLATE_GET_RENDER
    match:
      node: CALL
      patterns:
        - pattern-inside: |
            $TEMPLATE = $ENV.get_template(...)
            ...
        - pattern: $TEMPLATE.render(...)
  - id: JINJA2_TEMPLATE_RENDER_DIRECT
    match:
      node: CALL
      patterns:
        - pattern-inside: |
            $TEMPLATE = jinja2.Template(...)
            ...
        - pattern: $TEMPLATE.render(...)

sinks:
  - id: XSS_SINK
    match:
      node: CALL
      api: { package: jinja2, type: Template, method: render }

sanitizers:
  - id: FLASK_RENDER_TEMPLATE
    match: { node: CALL, api: { package: flask, method: render_template } }
    effect: neutralize
    scope: { sinks: [XSS_SINK] }

propagations: []
