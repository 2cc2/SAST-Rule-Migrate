Rule Content:
/**
 * @name psycopg-sqli
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled.
 * @id psycopg-sqli
 * @kind path-problem
 * @problem.severity warning
 */

import python
import DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class PsycopgSQLInjectionConfiguration extends TaintTracking::Configuration {
  PsycopgSQLInjectionConfiguration() {
    this = "psycopg-sqli"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(string name |
      source.asExpr().(Name).getId() = name and
      name.regexpMatch(".*USERINPUT.*")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DataFlow::CallNode call |
      call = sink.asExpr() and
      call.getTarget().getName() in ["execute", "executemany", "mogrify"] and
      call.getReceiver().getType().getUnderlyingType().hasQualifiedName("psycopg2", "Cursor") and
      sink = call.getArgument(1)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(DataFlow::CallNode call |
      call = sanitizer.asExpr() and
      call.getTarget().getName() in ["execute", "executemany", "mogrify"] and
      call.getReceiver().getType().getUnderlyingType().hasQualifiedName("psycopg2", "Cursor") and
      exists(string argValue |
        argValue = call.getArgument(1).getStringValue() and
        argValue.regexpMatch("^%s$")
      )
    )
  }
}

from PsycopgSQLInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection via unsafe string concatenation in psycopg2. Use parameterized queries instead.", source,
  "User input reaches this SQL execution point"
================================================================================
