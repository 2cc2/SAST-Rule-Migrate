Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. 
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs

class AsyncpgSqlSource extends DataFlow::Node {
  AsyncpgSqlSource() {
    exists(string regex |
      regex.matches(".*\\$USERINPUT.*|.*\\+.*|.*\\.format(.*)|.*%.*") and
      this.asExpr().toString() = regex
    )
  }
}

class AsyncpgSqlSink extends DataFlow::Node {
  AsyncpgSqlSink() {
    exists(MethodCall mc |
      mc.getMethod().getName().matches("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      mc.getReceiver().getType().getName() = "Connection" and
      mc.getReceiver().getType().getASourceDeclaration().getFile().getRelativePath().matches("asyncpg") and
      this.asExpr() = mc.getArgument(0)
    )
  }
}

class AsyncpgSanitizer extends DataFlow::Node {
  AsyncpgSanitizer() {
    exists(MethodCall mc |
      mc.getMethod().getName().matches("fetch|fetchrow|fetchval") and
      mc.getReceiver().getType().getName() = "Connection" and
      mc.getReceiver().getType().getASourceDeclaration().getFile().getRelativePath().matches("asyncpg") and
      mc.getArgument(0).toString().matches("^SELECT \\$1") and
      this.asExpr() = mc.getArgument(0)
    )
  }
}

class AsyncpgConfiguration extends TaintTracking::Configuration {
  AsyncpgConfiguration() { this = "AsyncpgSqlInjecttion" }

  override predicate isSource(DataFlow::Node source) { source instanceof AsyncpgSqlSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof AsyncpgSqlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof AsyncpgSanitizer
  }
}

from AsyncpgConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential SQL injection using string concatenation in asyncpg query", source, 
"User input flows into SQL query without proper sanitization"
