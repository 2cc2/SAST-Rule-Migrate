Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. 
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class AsyncpgSqlSource extends DataFlow::Node {
  AsyncpgSqlSource() {
    exists(string pattern |
      pattern = "$USERINPUT" or pattern = "+" or pattern = ".format" or pattern = "%" |
      this.asExpr().toString().matches(pattern)
    )
  }
  
  override string toString() { result = this.asExpr().toString() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }
}

class AsyncpgSqlSink extends DataFlow::Node {
  AsyncpgSqlSink() {
    exists(Method getName, MethodCall mc |
      mc.getMethod() = getName and
      getName.getName().matches("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      mc.getReceiver().getType().hasQualifiedName("asyncpg", "Connection") and
      this.asExpr() = mc.getArgument(0)
    )
  }
  
  override string toString() { result = this.asExpr().toString() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }
}

class AsyncpgSanitizer extends DataFlow::Node {
  AsyncpgSanitizer() {
    exists(Method getName, MethodCall mc |
      mc.getMethod() = getName and
      getName.getName().matches("fetch|fetchrow|fetchval") and
      mc.getReceiver().getType().hasQualifiedName("asyncpg", "Connection") and
      exists(string pattern |
        pattern = "^SELECT \\$1" |
        mc.getArgument(0).toString().matches(pattern)
      ) and
      this.asExpr() = mc.getArgument(0)
    )
  }
  
  override string toString() { result = this.asExpr().toString() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }
}

class AsyncpgConfiguration extends TaintTracking::Configuration {
  AsyncpgConfiguration() { this = "AsyncpgSqlInjection" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof AsyncpgSqlSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof AsyncpgSqlSink 
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof AsyncpgSanitizer
  }
}

from AsyncpgConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), "Potential SQL injection using string concatenation in asyncpg query", 
source.getNode(), "User input flows into SQL query without proper sanitization"
