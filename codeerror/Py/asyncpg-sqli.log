Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. 
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */

import python
import semmle.python.Concepts
import DataFlow
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking

class AsyncpgSqlSource extends DataFlow::Node {
  AsyncpgSqlSource() {
    this.asExpr().toString().matches(".*\\$USERINPUT.*") or
    this.asExpr().toString().matches(".*\\+.*") or
    this.asExpr().toString().matches(".*\\.format(.*)") or
    this.asExpr().toString().matches(".*%.*")
  }
}

class AsyncpgSqlSink extends DataFlow::Node {
  AsyncpgSqlSink() {
    exists(Call c | 
      c.getTarget().getName().matches("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      c.getReceiver().getType().hasQualifiedName("asyncpg", "Connection") and
      this.asExpr() = c.getArgument(0)
    )
  }
}

class AsyncpgSanitizer extends DataFlow::Node {
  AsyncpgSanitizer() {
    exists(Call c |
      c.getTarget().getName().matches("fetch|fetchrow|fetchval") and
      c.getReceiver().getType().hasQualifiedName("asyncpg", "Connection") and
      c.getArgument(0).toString().matches("^SELECT \\$1") and
      this.asExpr() = c.getArgument(0)
    )
  }
}

class AsyncpgConfiguration extends TaintTracking::Configuration {
  AsyncpgConfiguration() { this = "AsyncpgSqlInjection" }

  override predicate isSource(TaintTracking::TaintSource source) { 
    source.asTaintNode() instanceof AsyncpgSqlSource 
  }

  override predicate isSink(TaintTracking::TaintSink sink) { 
    sink.asTaintNode() instanceof AsyncpgSqlSink 
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer.asTaintNode() instanceof AsyncpgSanitizer
  }
}

from AsyncpgConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection using string concatenation in asyncpg query", source, 
"User input flows into SQL query without proper sanitization"
