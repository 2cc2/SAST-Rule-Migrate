/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. 
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class AsyncpgSqlSource extends DataFlow::Node {
  AsyncpgSqlSource() {
    exists(string regex |
      this.asExpr().toString().matches(".*\\$USERINPUT.*|.*\\+.*|.*\\.format(.*)|.*%.*")
    )
  }
}

class AsyncpgSqlSink extends DataFlow::Node {
  AsyncpgSqlSink() {
    exists(Call mc |
      mc.getFunc().getName().matches("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      mc.getReceiver().getType().hasQualifiedName("asyncpg", "Connection") and
      this.asExpr() = mc.getArg(0)
    )
  }
}

class AsyncpgSanitizer extends DataFlow::Node {
  AsyncpgSanitizer() {
    exists(Call mc |
      mc.getFunc().getName().matches("fetch|fetchrow|fetchval") and
      mc.getReceiver().getType().hasQualifiedName("asyncpg", "Connection") and
      mc.getArg(0).toString().matches("^SELECT \\$1") and
      this.asExpr() = mc.getArg(0)
    )
  }
}

class AsyncpgConfiguration extends TaintTracking::Configuration {
  AsyncpgConfiguration() { this = "AsyncpgSqlInjecttion" }

  override predicate isSource(DataFlow::Node source) { source instanceof AsyncpgSqlSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof AsyncpgSqlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof AsyncpgSanitizer
  }
}

