      sl.getStringValue().matches("%(sh|bash|ksh|csh|tcsh|zsh)%")
    )
  }
  
  predicate hasShellOption(Expr arg) {
    exists(StringLiteral sl |
      arg = sl and
      sl.getStringValue() = "-c"
