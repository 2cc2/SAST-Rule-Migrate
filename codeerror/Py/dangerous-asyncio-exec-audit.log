 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.CallGraph
import semmle.python.Strings

class DangerousSubprocessExec extends Call {
  DangerousSubprocessExec() {
    exists(Callable c | 
      c.hasName("subprocess_exec") and
      this.getCallee() = c
