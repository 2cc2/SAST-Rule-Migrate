  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(DangerousSubprocessExec dse |
      sink.asExpr() = dse.getArgument(0) and
      dse.isShellCommand(dse.getArgument(0)) and
      dse.hasShellOption(dse.getArgument(1))
    )
  }
  
  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(DangerousSubprocessExec dse |
      sanitizer.asExpr() = dse.getArgument(_) and
      dse.isStaticString(dse.getArgument(_))
    )
  }
}

