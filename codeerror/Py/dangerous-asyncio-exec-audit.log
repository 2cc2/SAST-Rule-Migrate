  DangerousSubprocessExecConfiguration() { this = "DangerousSubprocessExecConfiguration" }
  
  override predicate isSource(TaintTracking::TaintSource source) {
    exists(DangerousSubprocessExec dse |
      source.asExpr() = dse.getArgument(_) and
      not dse.isStaticString(dse.getArgument(_))
