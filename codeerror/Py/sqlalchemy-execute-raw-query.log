Rule Content:
/**
 * @name SQLAlchemy execute raw query
 * @description Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. Use prepared statements instead.
 * @kind path-problem
 * @problem.severity error
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow

class SQLStringConcat extends TaintTracking::Source {
  SQLStringConcat() {
    exists(Call fc, Name n, DataFlow::Node arg |
      n = fc.getFunc() and
      n.getId() = "__add__" and
      arg = DataFlow::exprNode(fc.getArg(0)) and
      exists(Class c | fc.getArg(0).getType() = c and c.getName() = "str") and
      this = arg
    )
  }

  override string toString() { none() }
  override ControlFlow::Node asCfgNode() { none() }
  override Location getLocation() { none() }
  override ControlFlow::BasicBlock getBasicBlock() { none() }
  override AstNode getScope() { none() }
  override Variable asVariable() { none() }
}

class SQLStringFormat extends TaintTracking::Source {
  SQLStringFormat() {
    exists(Call fc, Name n, DataFlow::Node arg |
      n = fc.getFunc() and
      n.getId() = "format" and
      arg = DataFlow::exprNode(fc.getArg(0)) and
      this = arg
    )
  }

  override string toString() { none() }
  override ControlFlow::Node asCfgNode() { none() }
  override Location getLocation() { none() }
  override ControlFlow::BasicBlock getBasicBlock() { none() }
  override AstNode getScope() { none() }
  override Variable asVariable() { none() }
}

class SQLFString extends TaintTracking::Source {
  SQLFString() {
    exists(StringLiteral sl, DataFlow::Node node |
      sl.getText().regexpMatches("f\".*\\{.*\\}.*\"") and
      node = DataFlow::exprNode(sl) and
      this = node
    )
  }

  override string toString() { none() }
  override ControlFlow::Node asCfgNode() { none() }
  override Location getLocation() { none() }
  override ControlFlow::BasicBlock getBasicBlock() { none() }
  override AstNode getScope() { none() }
  override Variable asVariable() { none() }
}

class SQLExecution extends TaintTracking::Sink {
  SQLExecution() {
    exists(Call fc, Name n, DataFlow::Node arg |
      n = fc.getFunc() and
      n.getId() = "execute" and
      arg = DataFlow::exprNode(fc.getArg(0)) and
      this = arg
    )
  }

  override string toString() { none() }
  override ControlFlow::Node asCfgNode() { none() }
  override Location getLocation() { none() }
  override ControlFlow::BasicBlock getBasicBlock() { none() }
  override AstNode getScope() { none() }
  override Variable asVariable() { none() }
}

class SQLTaintConfig extends TaintTracking::Configuration {
  SQLTaintConfig() { this = "SQLTaintConfig" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof SQLStringConcat or
    source instanceof SQLStringFormat or
    source instanceof SQLFString
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof SQLExecution
  }
}

from SQLTaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection vulnerability from string concatenation/formatting to execute()"
