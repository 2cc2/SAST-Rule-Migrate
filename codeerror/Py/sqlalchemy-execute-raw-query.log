Rule Content:
/**
 * @name SQLAlchemy execute raw query
 * @description Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. Use prepared statements instead.
 * @kind path-problem
 * @problem.severity error
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class SQLStringConcat extends TaintSource::Range {
  SQLStringConcat() {
    exists(FunctionCall fc |
      fc.getTarget().(Method).getName() = "__add__" and
      fc.getAnArgument().getType().(Class).getName() = "str" and
      this = fc.getArgument(0)
    )
  }
}

class SQLStringFormat extends TaintSource::Range {
  SQLStringFormat() {
    exists(FunctionCall fc |
      fc.getTarget().(Method).getName() = "format" and
      this = fc.getAnArgument()
    )
  }
}

class SQLFString extends TaintSource::Range {
  SQLFString() {
    exists(StringLiteral sl |
      sl.getStringValue().regexpMatch("f\".*\\{.*\\}.*\"") and
      this = sl
    )
  }
}

class SQLExecution extends TaintSink::Range {
  SQLExecution() {
    exists(FunctionCall fc |
      fc.getTarget().(Method).getName() = "execute" and
      this = fc.getArgument(0)
    )
  }
}

class SQLTaintConfig extends TaintTracking::Configuration {
  SQLTaintConfig() { this = "SQLTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SQLStringConcat or
    source instanceof SQLStringFormat or
    source instanceof SQLFString
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLExecution
  }
}

from SQLTaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection vulnerability from string concatenation/formatting to execute()"
