Rule Content:
/**
 * @name SQLAlchemy execute raw query
 * @description Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. Use prepared statements instead.
 * @kind path-problem
 * @problem.severity error
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow
import semmle.python.ApiGraphs
import semmle.python.dataflow.DataFlow

class SQLStringConcat extends DataFlow::Node, TaintTracking::Source {
  SQLStringConcat() {
    exists(Call fc, Name n |
      n = fc.getFunc() and
      n.getId() = "__add__" and
      exists(Class c | fc.getArg(0).getType() = c and c.getName() = "str") and
      this.asExpr() = fc.getArg(0)
    )
  }

  override predicate isSourceOf(TaintKind kind) { 
    kind instanceof TaintKind::SQL 
  }
}

class SQLStringFormat extends DataFlow::Node, TaintTracking::Source {
  SQLStringFormat() {
    exists(Call fc, Name n |
      n = fc.getFunc() and
      n.getId() = "format" and
      this.asExpr() = fc.getArg(0)
    )
  }

  override predicate isSourceOf(TaintKind kind) {
    kind instanceof TaintKind::SQL
  }
}

class SQLFString extends DataFlow::Node, TaintTracking::Source {
  SQLFString() {
    exists(StringLiteral sl |
      sl.getText().matches("f\".*\\{.*\\}.*\"") and
      this.asExpr() = sl
    )
  }

  override predicate isSourceOf(TaintKind kind) {
    kind instanceof TaintKind::SQL
  }
}

class SQLExecution extends DataFlow::Node, TaintTracking::Sink {
  SQLExecution() {
    exists(Cail fc, Name n |
      n = fc.getFunc() and
      n.getId() = "execute" and
      this.asExpr() = fc.getArg(0)
    )
  }

  override predicate sinks(TaintKind taint) {
    taint instanceof TaintKind::SQL
  }
}

class SQLTaintConfig extends TaintTracking::Configuration {
  SQLTaintConfig() { this = "SQLTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SQLStringConcat or
    source instanceof SQLStringFormat or
    source instanceof SQLFString
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLExecution
  }
}

from SQLTaintConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, source, sink, "Potential SQL injection vulnerability from string concatenation/formatting to execute()"
