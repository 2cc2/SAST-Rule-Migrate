import python.web.flask.Flask
import python.strings.Strings
import dataflow.TaintTracking
import dataflow.DataFlow

class SafeFilterUse extends DataFlow::Node {
  SafeFilterUse() {
    exists(DataFlow::Node node |
      this = node and
      node.asExpr().getValueText().regexpMatch("\\{\\{.*?\\|\\s*safe(\\s*\\}\\})?")
    )
  }
}

class SafeFilterConfig extends TaintTracking::Configuration {
  SafeFilterConfig() {
    this = "SafeFilterConfig" 
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SafeFilterUse
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Flask::RenderTemplateCall render |
      sink.asExpr() = render.getTemplateStringArgument()
    )
  }
}

from SafeFilterConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source,
  "Detected a segment of a Flask template where autoescaping is explicitly disabled with '|safe' filter. " +
  "This allows rendering of raw HTML in this segment. Ensure no user data is rendered here, " +
  "otherwise this is a cross-site scripting (XSS) vulnerability."
================================================================================
