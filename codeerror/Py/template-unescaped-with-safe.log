/**
 * @name Template Unescaped with Safe Filter
 * @description Detects Flask template segments where autoescaping is explicitly disabled with '|safe' filter,
 *              which could lead to XSS vulnerabilities if user-controlled data is rendered.
 * @kind path-problem
 * @problem.severity warning
 * @id python/flask/xss-template-unsafe
 */

import python
import semmle.python.web.flask.Flask
import semmle.python.strings.Strings
import semmle.code.java.dataflow.TaintTracking
import semmle.code.python.dataflow.internal.DataFlowImpl

class SafeFilterUse extends DataFlow::Node {
  SafeFilterUse() {
    exists(string_val |
      this.asExpr() = string_val and
      string_val.getValueText().regexpMatch("\\{\\{.*?\\|\\s*safe(\\s*\\}\\})?")
    )
  }
}

class SafeFilterConfig extends TaintTracking::Configuration {
  SafeFilterConfig() { 
    this = "SafeFilterConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SafeFilterUse
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Flask::RenderTemplateCall render |
      sink.asExpr() = render.getTemplateStringArgument()
    )
  }
}

from SafeFilterConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source,
  "Detected a segment of a Flask template where autoescaping is explicitly disabled with '|safe' filter. " +
  "This allows rendering of raw HTML in this segment. Ensure no user data is rendered here, " +
  "otherwise this is a cross-site scripting (XSS) vulnerability."
