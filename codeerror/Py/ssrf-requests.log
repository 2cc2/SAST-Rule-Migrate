/**
 * @name SSRF via requests library
 * @description Data from request object is passed to a new server-side request.
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.Flask
import semmle.python.Requests
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getAPackage() = "flask.request" and
      ma.getMethodName() in ["get", "[]", "()", "attribute"] and
      ma.getAValue().flowsTo(this)
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(MethodParameter p |
      p.getParent().getAPackage() = "$ROUTE_FUNC" and
      p.getValue().flowsTo(this)
    )
  }
}

class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(MethodAccess ma |
      ma.getMethod().getAPackage() = "requests" and
      ma.getAValue() = this
    )
  }
}

class SSRFConfig extends TaintTracking::Configuration {
  SSRFConfig() { this = "SSRF via requests library" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RequestsSink
  }
}

from SSRFConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF). To mitigate, ensure that schemes and hosts are validated against an allowlist, do not forward the response to the user, and ensure proper authentication and transport-layer security in the proxied request."
