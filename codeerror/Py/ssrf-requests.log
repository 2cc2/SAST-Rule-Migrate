/**
 * @name SSRF via requests library
 * @description Data from request object is passed to a new server-side request.
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 */

import python
import DataFlow::PathGraph
import DataFlow::TaintTracking
import Python::web::Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(DataFlow::CallNode ma |
      ma.getTarget().getPackage() = "flask.request" and
      ma.getTarget().getName() in ["get", "[]", "()", "attribute"] and
      ma.getNode().flowsTo(this)
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(DataFlow::ParameterNode p |
      p.getParent().getPackage() = "$ROUTE_FUNC" and
      p.getNode().flowsTo(this)
    )
  }
}

class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(DataFlow::CallNode ma |
      ma.getTarget().getPackage() = "requests" and
      ma.getNode() = this
    )
  }
}

class SSRFConfig extends TaintTracking::Configuration {
  SSRFConfig() { this = "SSRF via requests library" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RequestsSink
  }
}

