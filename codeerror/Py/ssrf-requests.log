/**
 * @name SSRF via requests library
 * @description Data from request object is passed to a new server-side request.
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask
import semmle.python.dataflow.pathgraph

class FlaskRequestSource extends TaintTracking::TaintSource {
  FlaskRequestSource() {
    exists(DataFlow::CallNode ma |
      ma.getTarget().getPackage().toString() = "flask.request" and
      ma.getTarget().getName().toString() in ["get", "[]", "()", "attribute"] and
      ma.getNode().flowsTo(this.asExpr())
    )
  }

  override predicate asCfgNode() { exists(this.asExpr()) }
  override string toString() { result = this.asExpr().toString() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  predicate supportsTaintTracking() { this instanceof DataFlow::Node }
}

class RouteParamSource extends TaintTracking::TaintSource {
  RouteParamSource() {
    exists(DataFlow::ParameterNode p |
      p.getParent().getPackage().toString() = "$ROUTE_FUNC" and
      p.getNode().flowsTo(this.asExpr())
    )
  }

  override predicate asCfgNode() { exists(this.asExpr()) }
  override string toString() { result = this.asExpr().toString() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  predicate supportsTaintTracking() { this instanceof DataFlow::Node }
}

class RequestsSink extends TaintTracking::TaintSink {
  RequestsSink() {
    exists(DataFlow::CallNode ma |
      ma.getTarget().getPackage().toString() = "requests" and
      ma.getNode() = this.asExpr()
    )
  }

  override predicate asCfgNode() { exists(this.asExpr()) }
  override string toString() { result = this.asExpr().toString() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  predicate supportsTaintTracking() { this instanceof DataFlow::Node }
}

class SSRFConfig extends TaintTracking::Configuration {
  SSRFConfig() { this = "SSRF via requests library" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof RequestsSink
  }
}

from SSRFConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF). To mitigate, ensure that schemes and hosts are validated against an allowlist, do not forward the response to the user, and ensure proper authentication and transport-layer security in the proxied request."
