Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the
 *              variable is user-controlled and not properly sanitized. In order to prevent SQL injection,
 *              use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity WARNING
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.security.SQL
import semmle.python.dataflow.DataFlow
import DataFlow::PathGraph

class EventParameter extends DataFlow::Node {
  EventParameter() {
    exists(Parameter p |
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class PyMSSQLExecutionSink extends DataFlow::Node {
  PyMSSQLExecutionSink() {
    exists(MethodCall call |
      call.getMethodName() = "execute" and
      call.getReceiverType().getName() = "Cursor" and
      call.getQualifier().getModule().getName() = "pymssql" and
      this.asExpr() = call.getArgument(0)
    )
  }
}

query predicate isSqlFlow(DataFlow::PathNode source, DataFlow::PathNode sink) {
  exists(EventParameter src, PyMSSQLExecutionSink snk |
    DataFlow::localFlowPathGraph(src, snk) and
    source = src and
    sink = snk
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where isSqlFlow(source, sink)
select sink.getNode(), source.getNode(), sink.getNode(),
  "Potential SQL injection from unsanitized event parameter in pymssql.execute() call"
