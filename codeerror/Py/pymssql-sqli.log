Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the
 *              variable is user-controlled and not properly sanitized. In order to prevent SQL injection,
 *              use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity WARNING
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class EventParameter extends DataFlow::Node {
  EventParameter() {
    exists(Parameter p |
      p.getName() = "event" and
      this = DataFlow::parameterNode(p)
    )
  }

  override ControlFlowNode asCfgNode() { none() }
  override Location getLocation() { result = this.getLocation() }
  override BasicBlock getBasicBlock() { none() }
  override string toString() { result = "Event parameter" }
  override Scope getScope() { none() }
  override Variable asVariable() { none() }
}

class PyMSSQLExecutionSink extends DataFlow::Node {
  PyMSSQLExecutionSink() {
    exists(Call call |
      call.getTarget().getName() = "execute" and
      call.getReceiver().getType().getName() = "Cursor" and
      call.getReceiver().getModule().getName() = "pymssql" and
      this = DataFlow::exprNode(call.getArg(0))
    )
  }

  override ControlFlowNode asCfgNode() { none() }
  override Location getLocation() { result = this.getLocation() }
  override BasicBlock getBasicBlock() { none() }
  override string toString() { result = "pymssql.execute() call" }
  override Scope getScope() { none() }
  override Variable asVariable() { none() }
}

from DataFlow::Node source, DataFlow::Node sink
where TaintTracking::localFlow(source, sink) and
  source instanceof EventParameter and
  sink instanceof PyMSSQLExecutionSink
select sink, "Potential SQL injection from unsanitized event parameter in pymssql.execute() call"
================================================================================
