Rule Content:
/**
 * @name subprocess-injection
 * @description Detected user input entering a `subprocess` call unsafely. This could result 
 * in a command injection vulnerability. An attacker could use this vulnerability 
 * to execute arbitrary commands on the host, which allows them to download malware, 
 * scan sensitive data, or run any command they wish on the server. Do not let users 
 * choose the command to run. In general, prefer to use Python API versions of system 
 * commands. If you must use subprocess, use a dictionary to allowlist a set of commands.
 * @kind taint
 * @severity Error
 * @problem.severity error
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class FlaskInputSource extends DataFlow::Node {
  FlaskInputSource() {
    exists(Call ma |
      ma.getTarget().getQualifiedName().getParentScope() = "flask.request" and
      ma.getTarget().getName() = "get" and
      (
        ma.getTarget().getQualifiedName() = "flask.request.form.get" or
        ma.getTarget().getQualifiedName() = "flask.request.args.get" or
        ma.getTarget().getQualifiedName() = "flask.request.values.get" or
        ma.getTarget().getQualifiedName() = "flask.request.cookies.get" or
        ma.getTarget().getQualifiedName() = "flask.request.headers.get"
      ) and
      this.asExpr() = ma
    )
  }
}

class FlaskRouteParamSource extends DataFlow::Node {
  FlaskRouteParamSource() {
    exists(Function m, Decorator d, Parameter p |
      d.getTarget().getName() = "route" and
      d.getExpr().toString().matches("@$APP.route(...)") and
      m.getADecorator() = d and
      m.getAParameter() = p and
      this.asParameter() = p
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(Call ma |
      ma.getTarget().getQualifiedName().getParentScope() = "subprocess" and
      (
        not ma.getArgument(0).isStringLiteral() and
        not ma.getArgument(0).isArrayLiteral()
      ) and
      this.asExpr() = ma.getArgument(0)
    ) or
    exists(Call ma |
      ma.getTarget().getQualifiedName().getParentScope() = "subprocess" and
      ma.getArgument(0).toString() in ["sh", "bash", "ksh", "csh", "tcsh", "zsh"] and
      ma.getArgument(1).toString() = "-c" and
      this.asExpr() = ma
    ) or
    exists(Call ma |
      ma.getTarget().getQualifiedName().getParentScope() = "subprocess" and
      ma.getArgument(0).toString().matches("^python|^python\\d") and
      this.asExpr() = ma
    )
  }
}

class DictKeySanitizer extends BarrierGuard {
  DictKeySanitizer() {
    exists(Field f |
      f.getName() = "$KEY" and
      f.getDeclaringType().getName() = "$DICT" and
      this.asExpr() = f.getAnAccess()
    )
  }
}

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskInputSource or source instanceof FlaskRouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof DictKeySanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SubprocessInjectionConfig config
where config.hasFlowPath(source, sink)
select sink, source, sink, "Detected user input entering a `subprocess` call unsafely"
