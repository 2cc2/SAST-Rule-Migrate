 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.DataFlow

class FlaskInputSource extends DataFlow::Node {
  FlaskInputSource() {
    exists(DataFlow::CallNode ma |
      ma.getCallee().getQualifiedName() = "flask.request.get" and
      ma.getCallee().getName() = "get" and
      (
        ma.getCallee().getQualifiedName() = "flask.request.form.get" or
        ma.getCallee().getQualifiedName() = "flask.request.args.get" or
        ma.getCallee().getQualifiedName() = "flask.request.values.get" or
        ma.getCallee().getQualifiedName() = "flask.request.cookies.get" or
        ma.getCallee().getQualifiedName() = "flask.request.headers.get"
      ) and
      this.asExpr() = ma
    )
  }
}

class FlaskRouteParamSource extends DataFlow::Node {
  FlaskRouteParamSource() {
    exists(Callable m, Annotation an, Parameter p |
      an.getCallable() = m and
      an.getName() = "route" and
      m.getAParameter() = p and
      this.asParameter() = p
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(DataFlow::CallNode ma |
      ma.getCallee().getQualifiedName().prefix("subprocess.") and
      (
        not ma.getArgument(0).isStringLiteral() and
        not ma.getArgument(0).isArrayLiteral()
      ) and
      this.asExpr() = ma.getArgument(0)
    ) or
    exists(DataFlow::CallNode ma |
      ma.getCallee().getQualifiedName().prefix("subprocess.") and
      ma.getArgument(0).getStringValue() in ["sh", "bash", "ksh", "csh", "tcsh", "zsh"] and
      ma.getArgument(1).getStringValue() = "-c" and
      this.asExpr() = ma
    ) or
    exists(DataFlow::CallNode ma |
      ma.getCallee().getQualifiedName().prefix("subprocess.") and
      ma.getArgument(0).getStringValue().matches("^python|^python\\d") and
      this.asExpr() = ma
    )
  }
}

class SubprocessInjectionConfig extends DataFlow::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskInputSource or source instanceof FlaskRouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Field f | 
      f.getName() = "$KEY" and
      f.getDeclaringType().getName() = "$DICT" and
      node.asExpr() = f.getAnAccess()
    )
  }
}

