Rule Content:
/**
 * @name subprocess-injection
 * @description Detected user input entering a `subprocess` call unsafely. This could result 
 * in a command injection vulnerability. An attacker could use this vulnerability 
 * to execute arbitrary commands on the host, which allows them to download malware, 
 * scan sensitive data, or run any command they wish on the server. Do not let users 
 * choose the command to run. In general, prefer to use Python API versions of system 
 * commands. If you must use subprocess, use a dictionary to allowlist a set of commands.
 * @kind taint
 * @severity Error
 * @problem.severity error
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import DataFlow::PathGraph

class FlaskInputSource extends DataFlow::Node {
  FlaskInputSource() {
    exists(MethodAccess ma |
      ma.getPackage().getName() = "flask" and
      ma.getType().getName() = "request" and
      ma.getMethod().getName() = "get" and
      (
        ma.getMethod().getFullyQualifiedName().matches("flask.request.form.get") or
        ma.getMethod().getFullyQualifiedName().matches("flask.request.args.get") or
        ma.getMethod().getFullyQualifiedName().matches("flask.request.values.get") or
        ma.getMethod().getFullyQualifiedName().matches("flask.request.cookies.get") or
        ma.getMethod().getFullyQualifiedName().matches("flask.request.headers.get")
      ) and
      this.asExpr() = ma
    )
  }
}

class FlaskRouteParamSource extends DataFlow::Node {
  FlaskRouteParamSource() {
    exists(Method m, Decorator d |
      d.getTarget().getName() = "route" and
      d.getExpr().toString().matches("@$APP.route(...)") and
      m.getADecorator() = d and
      this.asParameter() = m.getAParameter()
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(MethodAccess ma |
      ma.getPackage().getName() = "subprocess" and
      (
        not ma.getArgument(0).isStringLiteral() and
        not ma.getArgument(0).isArrayLiteral()
      ) and
      this.asExpr() = ma.getArgument(0)
    ) or
    exists(MethodAccess ma |
      ma.getPackage().getName() = "subprocess" and
      ma.getArgument(0).getValue().getALiteral().toString() = any("sh", "bash", "ksh", "csh", "tcsh", "zsh").getText() and
      ma.getArgument(1).getValue().getALiteral().toString() = "-c" and
      this.asExpr() = ma
    ) or
    exists(MethodAccess ma |
      ma.getPackage().getName() = "subprocess" and
      ma.getArgument(0).getValue().getALiteral().toString().matches("^python|^python\\d") and
      this.asExpr() = ma
    )
  }
}

class DictKeySanitizer extends DataFlow::BarrierNode {
  DictKeySanitizer() {
    exists(FieldAccess fa |
      fa.getField().getName() = "$KEY" and
      fa.getQualifier().toString() = "$DICT[$KEY]" and
      this.asExpr() = fa
    )
  }
}

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskInputSource or source instanceof FlaskRouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof DictKeySanitizer
  }
}

from SubprocessInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
