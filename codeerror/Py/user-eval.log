/**
 * @name Eval Injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind taint-problem
 * @problem.severity error
 * @id python/eval-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow

class FlaskRequestInput extends TaintTracking::Source {
  FlaskRequestInput() {
    exists(Call ma |
      ma.getCallee().toString().matches("flask.request.%") and
      this.asExpr() = ma
    )
  }

  override predicate isSourceOf(TaintKind kind) { kind = TaintKind::remote() }
}

class RouteParameterInput extends TaintTracking::Source {
  RouteParameterInput() {
    exists(Function f, Parameter p |
      f.getADecorator().toString().matches(".*route.*") and
      p = f.getAParameter() and
      this.asParameter() = p
    )
  }

  override predicate isSourceOf(TaintKind kind) { kind = TaintKind::remote() }
}

class EvalSink extends TaintTracking::Sink {
  EvalSink() {
    exists(Call call |
      call.getCalleeName() = "eval" and
      this.asExpr() = call.getArg(0)
    )
  }

  override predicate sinks(TaintKind taint) { taint = TaintKind::remote() }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjection" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof FlaskRequestInput or
    source instanceof RouteParameterInput
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof EvalSink
  }
}

from EvalInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected user data flowing into eval. This is code injection and should be avoided."
