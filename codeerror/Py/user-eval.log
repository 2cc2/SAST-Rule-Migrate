Rule Content:
/**
 * @name Eval Injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind taint-problem
 * @problem.severity error
 * @id python/eval-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class FlaskRequestInput extends TaintTracking::TaintSource {
  FlaskRequestInput() {
    exists(Call ma |
      ma.getTarget().getName().matches("flask.request.%") and
      DataFlow::localExpr(ma) = this.asSource()
    )
  }
  
  override predicate isSourceOf(TaintKind kind) {
    kind = TaintKind::fromString("remote")
  }
}

class RouteParameterInput extends TaintTracking::TaintSource {
  RouteParameterInput() {
    exists(Function f, Parameter p |
      f.getADecorator().toString().matches(".*route.*") and
      p = f.getParameter(_) and
      DataFlow::parameterNode(p) = this.asSource()
    )
  }
  
  override predicate isSourceOf(TaintKind kind) {
    kind = TaintKind::fromString("remote")
  }
}

class EvalSink extends TaintTracking::TaintSink {
  EvalSink() {
    exists(Call call |
      call.getTarget().getName() = "eval" and
      DataFlow::exprNode(call.getArg(0)) = this.asSink()
    )
  }
  
  override predicate sinks(TaintKind taint) {
    taint = TaintKind::fromString("remote")
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjection" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestInput or
    source instanceof RouteParameterInput
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof EvalSink
  }
}

from EvalInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected user data flowing into eval. This is code injection and should be avoided."
