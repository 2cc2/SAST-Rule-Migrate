```yaml
xcpgir_version: "1.0"
rule:
  id: tainted-html-string
  kind: taint
  severity: WARNING
  message: |-
    Detected user input flowing into a manually constructed HTML string. You may be accidentally bypassing
    secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability,
    which could let attackers steal sensitive user data. To be sure this is safe, check that the HTML is rendered
    safely. Otherwise, use templates which will safely render HTML instead.

sources:
  - id: EVENT_PARAM
    match:
      node: METHOD_PARAMETER_IN
      where:
        - op: eq
          left: name
          right: event

sinks:
  - id: HTML_CONCAT
    match:
      node: CALL
      where:
        - op: or
          conditions:
            - op: regex
              left: code
              right: '\".*?\" % .*'
            - op: regex
              left: code
              right: '\".*?\"\.format\(.*\)'
            - op: regex
              left: code
              right: '\".*?\" \+ .*'
            - op: regex
              left: code
              right: 'f\".*?\{.*\}.*\"'
  - id: HTML_VAR_CONCAT
    match:
      node: CALL
      where:
        - op: or
          conditions:
            - op: regex
              left: code
              right: '\$[A-Z]+ % .*'
            - op: regex
              left: code
              right: '\$[A-Z]+\.format\(.*\)'
            - op: regex
              left: code
              right: '\$[A-Z]+ \+ .*'
      pattern-inside: |
        $HTML = "$HTMLSTR"
        ...

propagations:
  - id: PARAM_TO_HTML
    edge: arg->param
    kind: taint

sanitizers:
  - id: SAFE_PRINT
    match:
      node: CALL
      where:
        - op: regex
          left: code
          right: 'print\(.*\)'
    effect: neutralize
```
