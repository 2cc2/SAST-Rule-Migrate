Rule Content:
/**
 * @name SQL Injection via SQLAlchemy.execute with AWS Lambda event parameter
 * @description Detects SQL statements that are tainted by AWS Lambda event object.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-event-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Method method, Parameter p |
      method.getName() = "$HANDLER" and
      p.(NamedParameter).getName() = "event" and
      p.getFunction() = method and
      this.asParameter() = p
    )
  }
}

class SQLAlchemySink extends DataFlow::Node {
  SQLAlchemySink() {
    exists(Call call |
      call.getFunc().(Value).getQualifiedName() = "sqlalchemy.execute" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class SQLAlchemyEventSqlInjectionConfiguration extends TaintTracking::Configuration {
  SQLAlchemyEventSqlInjectionConfiguration() {
    this = "SQLAlchemy event parameter to execute() SQL injection"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLAlchemySink
  }
}

from SQLAlchemyEventSqlInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "SQL statement that is tainted by AWS Lambda 'event' object. Potentially vulnerable to SQL injection. " +
  "Use parameterized queries or prepared statements instead."
