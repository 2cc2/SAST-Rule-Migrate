Rule Content:
/**
 * @name SQL Injection via SQLAlchemy.execute with AWS Lambda event parameter
 * @description Detects SQL statements that are tainted by AWS Lambda event object.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-event-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import DataFlow::PathGraph
import semmle.python.functions.Function
import semmle.python.Concepts

class LambdaEventSource extends TaintTracking::TaintSource {
  LambdaEventSource() {
    exists(Function method, Function::Parameter p |
      method.getName() = "$HANDLER" and
      p.getName() = "event" and
      p.getFunction() = method and
      this.asParameter() = p
    )
  }

  override predicate isSource(DataFlow::Node source) { this = source }

  // Implement required abstract predicates
  override predicate asCfgNode(ControlFlow::Node node) { none() }
  override Location getLocation() { result = this.asParameter().getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { none() }
  override string toString() { "Lambda event parameter" }
  override VariableScope getScope() { this.asParameter().getScope() }
  override Variable asVariable() { none() }
  override predicate hasUnderlyingType(string typeName, string typeValue) { none() }
}

class SQLAlchemySink extends TaintTracking::TaintSink {
  SQLAlchemySink() {
    exists(FunctionCall call |
      call.getCalleeName() = "execute" and
      call.getACallee().getQualifiedName().matches("sqlalchemy.%") and
      this.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) { this = sink }

  // Implement required abstract predicates
  override predicate asCfgNode(ControlFlow::Node node) { none() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { none() }
  override string toString() { "SQLAlchemy execute() call" }
  override VariableScope getScope() { this.asExpr().getScope() }
  override Variable asVariable() { none() }
  override predicate hasUnderlyingType(string typeName, string typeValue) { none() }
}

class SQLAlchemyEventSqlInjectionConfiguration extends TaintTracking::Configuration {
  SQLAlchemyEventSqlInjectionConfiguration() {
    this = "SQLAlchemy event parameter to execute() SQL injection"
  }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SQLAlchemySink
  }
}

from SQLAlchemyEventSqlInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "SQL statement that is tainted by AWS Lambda 'event' object. Potentially vulnerable to SQL injection. " +
  "Use parameterized queries or prepared statements instead."
