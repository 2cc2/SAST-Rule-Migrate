      node: CALL
      api: { package: sqlalchemy, method: execute }
      arg_index: 0
      where:
        - op: inside
          left: location
          right: "import sqlalchemy; ..."

propagations:
  - id: PARAM_TO_EXEC
    edge: arg->param
    kind: taint
