/**
 * @name SQL Injection via SQLAlchemy.execute with AWS Lambda event parameter
 * @description Detects SQL statements that are tainted by AWS Lambda event object.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-event-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.functions.Parameter
import DataFlow::PathGraph

class LambdaEventSource extends TaintTracking::TaintSource {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      f.getName() = "$HANDLER" and
      p.getName() = "event" and
      p.getFunction() = f and
      this.asParameter() = p
    )
  }

  override Location getLocation() { result = this.asParameter().getLocation() }
  override predicate asCfgNode(ControlFlow::Node node) { none() }
  override ControlFlow::BasicBlock getBasicBlock() { none() }
  override NodeScope getScope() { this.asParameter().getScope() }
  override Variable asVariable() { none() }
  override string toString() { result = "Lambda event parameter" }
}

class SQLAlchemySink extends TaintTracking::TaintSink {
  SQLAlchemySink() {
    exists(FunctionCall c |
      c.getTarget().getName() = "execute" and
      c.getTarget().getQualifiedName().matches("sqlalchemy.%") and
      this.asExpr() = c.getAnArgument()  
    )
  }

  override Location getLocation() { result = this.asExpr().getLocation() }
  override predicate asCfgNode(ControlFlow::Node node) { none() }
  override ControlFlow::BasicBlock getBasicBlock() { none() }
  override NodeScope getScope() { this.asExpr().getScope() }
  override Variable asVariable() { none() }
  override string toString() { result = "SQLAlchemy execute() call" }
}

class SQLAlchemyEventSqlInjectionConfiguration extends TaintTracking::Configuration {
  SQLAlchemyEventSqlInjectionConfiguration() {
    this = "SQLAlchemy event parameter to execute() SQL injection"
  }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SQLAlchemySink
  }
}

