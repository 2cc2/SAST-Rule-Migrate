import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class UserControlledInputConfig extends TaintTracking::Configuration {
  UserControlledInputConfig() { this = "UserControlledInputConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(string name |
      name.matches("%request|%input|%param") and
      (
        (source.asParameter() and source.asParameter().getName() = name) or
        (source.asLocal() and source.asLocal().getName() = name)
      )
    )
  }
}

class XssSinkConfig extends TaintTracking::Configuration {
  XssSinkConfig() { this = "XssSinkConfig" }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call, Value target |
      target = call.getCallee() and
      target.getDeclaringType().hasQualifiedName("markupsafe", "Markup") and
      (
        (target.getName() = "__init__" and sink.asExpr() = call.getArgument(0)) or
