Rule Content:
/**
 * @name Explicit unescape with markup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits
 *              the unescaped data to include unescaped HTML which could result in
 *              cross-site scripting. Ensure this data is not externally controlled,
 *              or consider rewriting to not use 'Markup()'.
 * @kind taint-problem
 * @problem.severity warning
 * @id python/explicit-unescape-with-markup
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking

class UserControlledInputConfig extends TaintTracking::Configuration {
  UserControlledInputConfig() { this = "UserControlledInputConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(string name |
      name.matches("%request|%input|%param") and
      (
        (source.asParameter() and source.asParameter().getName() = name) or
        (source.asLocal() and source.asLocal().getName() = name)
      )
    )
  }
}

class XssSinkConfig extends TaintTracking::Configuration {
  XssSinkConfig() { this = "XssSinkConfig" }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCalledValue().(Constructor).getDeclaringType().hasQualifiedName("markupsafe", "Markup") and
      (
        (call.getCalledValue().getName() = "__init__" and sink.asExpr() = call.getArgument(0)) or
        (call.getCalledValue().getName() = "unescape" and sink.asExpr() = call)
      )
    )
  }
}

class HtmlSanitizerConfig extends TaintTracking::Configuration {
  HtmlSanitizerConfig() { this = "HtmlSanitizerConfig" }

  predicate isSanitizer(DataFlow::Node node) {
    exists(Call call |
      call.getCalledValue().getDeclaringType().hasQualifiedName("markupsafe", "") and
      call.getCalledValue().getName() = "escape" and
      node.asExpr() = call
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink
where 
  exists(UserControlledInputConfig conf1, XssSinkConfig conf2, HtmlSanitizerConfig conf3 |
    conf1.hasFlowPath(source, sink) and
    conf2.isSink(sink) and
    not exists(DataFlow::Node mid |
      conf3.isSanitizer(mid) and
      conf1.hasFlowPath(source, mid) and
      conf1.hasFlowPath(mid, sink)
    )
  )
select sink, "Potential XSS vulnerability due to explicitly unescaped Markup content from $@",
  source, "user-controllable input"
================================================================================
