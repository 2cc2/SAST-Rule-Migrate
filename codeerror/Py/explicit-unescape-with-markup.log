  override predicate isSanitizer(DataFlow::Node node) {
    exists(Call call, Value target |
      target = call.getCallee() and
      target.getDeclaringType().hasQualifiedName("markupsafe", "") and
      target.getName() = "escape" and
      node.asExpr() = call
    )
  }
}

