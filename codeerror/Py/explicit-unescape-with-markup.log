Rule Content:
/**
 * @name Explicit unescape with markup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits
 *              the unescaped data to include unescaped HTML which could result in
 *              cross-site scripting. Ensure this data is not externally controlled,
 *              or consider rewriting to not use 'Markup()'.
 * @kind taint-problem
 * @problem.severity warning
 * @id python/explicit-unescape-with-markup
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class UserControlledInput extends DataFlow::Node {
  UserControlledInput() {
    exists(string name |
      name.matches("%request|%input|%param") and
      (
        (this.asParameter() and this.asParameter().getName() = name) or
        (this.asLocal() and this.asLocal().getName() = name)
      )
    )
  }
}

class XssSink extends DataFlow::Node {
  XssSink() {
    exists(Call call |
      call.getTarget().(Constructor).getDeclaringType().hasQualifiedName("markupsafe", "Markup") and
      (
        call.getTarget().getName() = "__init__" and call.getArgument(0) = this.asExpr() or
        call.getTarget().getName() = "unescape" and this.asExpr() = call
      )
    )
  }
}

class HtmlSanitizer extends DataFlow::Node {
  HtmlSanitizer() {
    exists(Call call |
      call.getTarget().getDeclaringType().hasQualifiedName("markupsafe", "") and
      call.getTarget().getName() = "escape" and
      this.asExpr() = call
    )
  }
}

class ArgToReturnTaint extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node src, DataFlow::Node sink) {
    exists(Function f, Parameter p, ReturnStmt ret |
      src.asParameter() = p and
      p.getFunction() = f and
      sink.asReturn(f) = ret and
      ret.getFunction() = f
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  TaintTracking::localPath(source, sink) and
  source.getNode() instanceof UserControlledInput and
  sink.getNode() instanceof XssSink and
  not exists(DataFlow::PathNode sanitizer |
    sanitizer.getNode() instanceof HtmlSanitizer and
    TaintTracking::localPath(source, sanitizer) and
    TaintTracking::localPath(sanitizer, sink)
  )
select sink, "Potential XSS vulnerability due to explicitly unescaped Markup content from $@",
  source, "user-controllable input"
