      literal.getStringValue().matches("\"\\{\\{.*\\}\}\"")
    )
  }

  override string toString() { result = "Quoted template attribute" }
}

class TemplateTaintKind extends TaintKind {
  TemplateTaintKind() { this = "TemplateTaintKind" }
}

class TemplateUnquotedTaintConfig extends TaintTracking::Configuration {
  TemplateUnquotedTaintConfig() { this = "TemplateUnquotedTaintConfig" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof FlaskRequestSource
