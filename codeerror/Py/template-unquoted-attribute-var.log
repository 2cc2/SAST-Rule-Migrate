Rule Content:
/**
 * @id template-unquoted-attribute-var
 * @kind path-problem
 * @severity warning
 * @name Unquoted template variable as attribute
 * @description Detected a unquoted template variable as an attribute. If unquoted,
 *   a malicious actor could inject custom JavaScript handlers.
 * @message Detected a unquoted template variable as an attribute. If unquoted, a malicious
 *   actor could inject custom JavaScript handlers. To fix this, add quotes around the template
 *   expression, like this: '{{ $...VAR }}'.
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.WebSecurity

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "get" and
      ma.getQualifier().getType().getName() = "request" and
      ma.getQualifier().getType().getSourceDeclaration().getFile().getName() = "flask.py"
    )
  }
}

class UnquotedTemplateSink extends DataFlow::Node {
  UnquotedTemplateSink() {
    exists(Assignment assign |
      assign.getRValue().toString().matches("\\=\\{\\{.*\\}\\}")
    )
  }
}

class QuotedTemplateSanitizer extends DataFlow::Node {
  QuotedTemplateSanitizer() {
    exists(Literal literal |
      literal.toString().matches("\"\\{\\{.*\\}\}\"")
    )
  }
}

class TemplateUnquotedTaintConfig extends TaintTracking::Configuration {
  TemplateUnquotedTaintConfig() { this = "TemplateUnquotedTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnquotedTemplateSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof QuotedTemplateSanitizer
  }
}

from TemplateUnquotedTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected a unquoted template variable as an attribute. " +
  "If unquoted, a malicious actor could inject custom JavaScript handlers.", 
  source, sink,
  "Ensure to quote template expressions like: '{{ $...VAR }}'"
