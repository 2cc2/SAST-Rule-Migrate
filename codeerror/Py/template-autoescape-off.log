Rule Content:
/**
 * @name Template Autoescape Off
 * @description Detects Flask templates with autoescape explicitly disabled ({% autoescape off %}),
 * allowing raw HTML rendering. This could lead to XSS vulnerabilities if user data is rendered.
 * @kind path-problem
 * @problem.severity warning
 * @id python/template-autoescape-off
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.web.flask.Flask

class AutoescapeOff extends DataFlow::Node {
  AutoescapeOff() {
    exists(string literal |
      literal.regexpMatch("\\{%\\s*autoescape\\s+false\\s*%\\}")
    )
  }
}

class HtmlOutput extends DataFlow::Node {
  HtmlOutput() {
    exists(Call call |
      call.getCalleeName() = "render_template" and
      call.getLocation().getFile().getExtension() = "py"
    )
  }
}

class AutoescapeOn extends DataFlow::Node {
  AutoescapeOn() {
    exists(string literal |
      literal.regexpMatch("\\{%\\s*autoescape\\s+true\\s*%\\}")
    )
  }
}

predicate isSanitizer(DataFlow::Node node) {
  exists(AutoescapeOn on | node = on)
}

from AutoescapeOff source, HtmlOutput sink
where DataFlow::localFlow(source, sink) and
      not exists(DataFlow::Node sanitizer |
        isSanitizer(sanitizer) and
        DataFlow::localFlow(source, sanitizer) and
        DataFlow::localFlow(sanitizer, sink)
      )
select sink, "Found Flask template with autoescaping disabled. Ensure no user data is rendered here" +
             " or enable autoescaping to prevent XSS vulnerabilities.", source, "Autoescape disabled here"
