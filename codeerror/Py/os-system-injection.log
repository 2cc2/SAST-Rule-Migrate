Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection 
 *              and should be avoided. If this must be done, use the 'subprocess' module instead 
 *              and pass the arguments as a list.
 * @kind path-problem
 * @problem.severity error
 * @id py/os-system-injection
 */

import python
import semmle.python.ApiGraphs
import semmle.python.security.TaintTracking
import semmle.python.dataflow.DataFlow

class FlaskRequestSource extends TaintSource {
  FlaskRequestSource() {
    exists(string methodName, DataFlow::Node node |
      node.getAMethodCall().getName() = methodName and
      methodName in ["get", "__getitem__", "__call__"] and
      node.getAMethodCall().getQualifier().getType().hasQualifiedName("flask", "request") and
      this.asSource() = node.getArgument(0)
    )
  }

  override predicate isSourceOf(DataFlow::Node node) {
    exists(string methodName |
      node.getAMethodCall().getName() = methodName and
      methodName in ["get", "__getitem__", "__call__"] and
      node.getAMethodCall().getQualifier().getType().hasQualifiedName("flask", "request")
    )
  }
}

class RouteParamSource extends TaintSource {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().matches("ROUTEVAR|INTERM") and
      this.asParameter() = p
    )
  }

  override predicate isSourceOf(DataFlow::Node node) {
    node.asParameter().getName().matches("ROUTEVAR|INTERM")
  }
}

class OsSystemSink extends TaintSink {
  OsSystemSink() {
    exists(DataFlow::Node node |
      node.getAMethodCall().getName() = "system" and
      node.getAMethodCall().getQualifier().getType().hasQualifiedName("os") and
      this.asSink() = node.getArgument(0)
    )
  }

  override predicate sinks(DataFlow::Node node) {
    node.getAMethodCall().getName() = "system" and
    node.getAMethodCall().getQualifier().getType().hasQualifiedName("os")
  }
}

class OsSystemInjectionConfig extends TaintTracking::Configuration {
  OsSystemInjectionConfig() { this = "OsSystemInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OsSystemSink
  }
}

from OsSystemInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User data detected in os.system. This could be vulnerable to a command injection."
