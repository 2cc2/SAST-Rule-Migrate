Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection 
 *              and should be avoided. If this must be done, use the 'subprocess' module instead 
 *              and pass the arguments as a list.
 * @kind path-problem
 * @problem.severity error
 * @id py/os-system-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().(BuiltinMethod).getName() in ["get", "__getitem__", "__call__"] and
      ma.getQualifier().(ClassObject).getASupertype*().hasQualifiedName("flask", "request") and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().matches("%ROUTEVAR%|%INTERM%") and
      this.asParameter() = p
    )
  }
}

class OsSystemSink extends DataFlow::Node {
  OsSystemSink() {
    exists(MethodAccess ma |
      ma.getMethod().(BuiltinMethod).getName() = "system" and
      ma.getQualifier().(ClassObject).getASupertype*().hasQualifiedName("os") and
      this.asExpr() = ma
    )
  }
}

class OsSystemInjectionConfig extends TaintTracking::Configuration {
  OsSystemInjectionConfig() { this = "OsSystemInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OsSystemSink
  }
}

from OsSystemInjectionConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "User data detected in os.system. This could be vulnerable to a command injection."
