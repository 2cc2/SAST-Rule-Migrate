Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection 
 *              and should be avoided. If this must be done, use the 'subprocess' module instead 
 *              and pass the arguments as a list.
 * @kind path-problem
 * @problem.severity error
 * @id py/os-system-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph
import semmle.python.Concepts

class FlaskRequestSource extends TaintSource {
  FlaskRequestSource() {
    exists(string methodName, AstNode ma |
      ma.(Method).getName() = methodName and
      methodName in ["get", "__getitem__", "__call__"] and
      ma.getQualifier().(ClassObject).getASupertype().hasQualifiedName("flask", "request") and
      this.asSource() = ma.getAnArgument()
    )
  }

  override predicate asCfgNode(ControlFlowNode node) { none() }
  override SourceLocation getLocation() { result = this.getLocation() }
  override ControlFlowNode getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override Scope getScope() { result = this.getScope() }
  override Variable asVariable() { none() }
}

class RouteParamSource extends TaintSource {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().matches("%ROUTEVAR%|%INTERM%") and
      this.asParameter() = p
    )
  }

  override predicate asCfgNode(ControlFlowNode node) { none() }
  override SourceLocation getLocation() { result = this.getLocation() }
  override ControlFlowNode getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override Scope getScope() { result = this.getScope() }
  override Variable asVariable() { none() }
}

class OsSystemSink extends TaintSink {
  OsSystemSink() {
    exists(AstNode ma |
      ma.(Method).getName() = "system" and
      ma.getQualifier().getType().hasQualifiedName("os") and
      this.asExpr() = ma.getAnArgument()
    )
  }

  override predicate asCfgNode(ControlFlowNode node) { none() }
  override SourceLocation getLocation() { result = this.getLocation() }
  override ControlFlowNode getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override Scope getScope() { result = this.getScope() }
  override Variable asVariable() { none() }
}

class OsSystemInjectionConfig extends TaintTracking::Configuration {
  OsSystemInjectionConfig() { this = "OsSystemInjectionConfig" }

  override predicate isSource(TaintSource source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(TaintSink sink) {
    sink instanceof OsSystemSink
  }
}

from OsSystemInjectionConfig cfg, PathNode source, PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User data detected in os.system. This could be vulnerable to a command injection."
