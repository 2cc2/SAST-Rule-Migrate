Rule Content:
/**
 * @name Path Traversal via open() with Unsanitized Request Data
 * @description Detects when Flask request data flows into open() call without sanitization,
 *              which could lead to path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import semmle.python.dataflow.new.DataFlow
import python.web.flask.Flask

class FlaskRequestSource extends DataFlow::SourceNode {
  FlaskRequestSource() {
    exists(Method ma |
      ma.getQualifiedName().regexpMatch("flask\\.request\\..*") and
      ma.getASelfReference() = result.asExpr()
    )
  }
}

class RouteVariableSource extends DataFlow::SourceNode {
  RouteVariableSource() {
    exists(Variable v |
      v.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      result.asExpr() = v.getAnAccess()
    )
  }
}

class FileOpenSink extends DataFlow::SinkNode {
  FileOpenSink() {
    exists(Call fc |
      fc.getTarget().getName() = "open" and
      result.asExpr() = fc.getAnArg()
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() {
    this = "PathTraversalConfig"
  }

  override predicate isSource(DataFlow::SourceNode source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteVariableSource
  }

  override predicate isSink(DataFlow::SinkNode sink) {
    sink instanceof FileOpenSink
  }
}

from PathTraversalConfig cfg, DataFlow::SourceNode source, DataFlow::SinkNode sink
where cfg.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is " +
  "validated or sanitized, otherwise it could result in path traversal attacks."
