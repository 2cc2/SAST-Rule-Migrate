import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() { 
    this = "FlaskRequestSource" and
    exists(Value::Field f |
      f.getQualifiedName().regexpMatch("flask\\.request\\..*") and
      result = f.getAnAccess()
    )
  }
}

class RouteVariableSource extends TaintTracking::Source {
  RouteVariableSource() {
    this = "RouteVariableSource" and
    exists(Variable v |
      v.getADeclaration().getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      result = v.getAnAccess()
    )
  }
}

class FileOpenSink extends TaintTracking::Sink {
  FileOpenSink() {
    this = "FileOpenSink" and
    exists(Call fc |
      fc.getTarget().getName() = "open" and
      result = fc.getAnArg()
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { 
    this = "PathTraversalConfig"
  }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteVariableSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof FileOpenSink
  }
}

from PathTraversalConfig cfg, TaintTracking::Source source, TaintTracking::Sink sink
where cfg.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is " +
  "validated or sanitized, otherwise it could result in path traversal attacks."
