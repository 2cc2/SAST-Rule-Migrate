Rule Content:
/**
 * @name NaN Injection
 * @description Found user input going directly into typecast for bool(), float(), or complex().
 *              This allows an attacker to inject Python's not-a-number (NaN) into the typecast.
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.dataflow.new.DataFlow

class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(Call mc |
      (mc.getCallee().getName() = "get" or
       mc.getCallee().getName() = "__getitem__") and
      mc.getReceiverType().getName() = "request" and
      mc.getReceiverType().getAPackage().getName() = "flask"
    |
      this = mc
    )
  }
}

class RouteParameter extends DataFlow::Node {
  RouteParameter() {
    exists(Function f | 
      f.getADecorator().getCallee().getName() = "route"
    |
      exists(f.getAParameter() | this = result)
    )
  }
}

class NumericTypeCast extends DataFlow::Node {
  NumericTypeCast() {
    exists(Call mc |
      (mc.getCallee().getName() = "float" or
       mc.getCallee().getName() = "bool" or
       mc.getCallee().getName() = "complex") and
      mc.getReceiverType().getName() = "builtins"
    |
      this = mc
    )
  }
}

class AnyFunctionCallSanitizer extends DataFlow::Node {
  AnyFunctionCallSanitizer() {
    exists(Call mc | this = mc)
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "NaN Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskUserInput or
    source instanceof RouteParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof NumericTypeCast
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof AnyFunctionCallSanitizer
  }
}

