/**
 * @name NaN Injection
 * @description Found user input going directly into typecast for bool(), float(), or complex().
 *              This allows an attacker to inject Python's not-a-number (NaN) into the typecast.
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(Call c |
      exists(FunctionValue f |
        f = c.getFunc() and
        (f.getName() = "get" or f.getName() = "__getitem__") and
        c.getReceiver().getType().getName() = "request" and
        c.getReceiver().getType().getAPackage().getName() = "flask" and
        this = c
      )
    )
  }
}

class RouteParameter extends DataFlow::Node {
  RouteParameter() {
    exists(Function f, Parameter p |
      exists(f.getADecorator().getFunc() |
        result.getName() = "route"
      ) and
      p = f.getAParameter() and
      this = p
    )
  }
}

class NumericTypeCast extends DataFlow::Node {
  NumericTypeCast() {
    exists(Call c |
      exists(FunctionValue f |
        f = c.getFunc() and
        (f.getName() = "float" or
         f.getName() = "bool" or 
         f.getName() = "complex") and
        c.getReceiver().getType().getName() = "builtins" and
