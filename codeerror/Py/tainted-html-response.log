Rule Content:
/**
 * @id tainted-html-response
 * @kind path-problem
 * @name Tainted HTML response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing 
 *              secure methods of rendering HTML by manually constructing HTML and this could create 
 *              a cross-site scripting vulnerability, which could let attackers steal sensitive user data.
 * @severity WARNING
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class UserInputSource extends TaintTracking::Source {
  UserInputSource() {
    exists(MethodParameter p |
      p.getName() = "event" and
      this.asSource(p)
    )
  }
}

class HtmlResponseSink extends TaintTracking::Sink {
  HtmlResponseSink() {
    exists(Method m |
      m.getReturnStmt() = this.asSink() and
      m.getDoc().regexpMatch(".*headers.*Content-Type.*text/html.*")
    )
  }
}

class TaintedHtmlResponseConfiguration extends TaintTracking::Configuration {
  TaintedHtmlResponseConfiguration() {
    this = "tainted-html-response"
  }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof UserInputSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof HtmlResponseSink
  }
}

from TaintedHtmlResponseConfiguration cfg, TaintTracking::Source src, TaintTracking::Sink sink
