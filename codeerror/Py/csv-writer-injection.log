          "headers.get", "headers.__getitem__", "data", 
          "full_path", "url", "json", "get_json"
        ]) |
        this.asExpr() = ma
      )
    )
  }
  
  override predicate isSourceOf(TaintKind kind) {
    kind instanceof TaintKind
  }
}

class RouteParameter extends TaintSource {
  RouteParameter() {
    exists(Function f, Expr decorator |
      f.getADecorator() = decorator and
      decorator.toString().matches("%route%") |
      exists(Parameter p | f.getAParameter() = p |
        this.asExpr() = p
      )
    )
  }
  
  override predicate isSourceOf(TaintKind kind) {
    kind instanceof TaintKind
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "CSVWriterInjection" }

  override predicate isSource(TaintSource source) {
    source instanceof FlaskUserInput or source instanceof RouteParameter
  }

  override predicate isSink(TaintSink sink) {
    sink instanceof CSVWriterSink
  }
}

from TaintSource source, TaintSink sink, TaintConfig config
where config.hasFlow(source, sink)
select sink, "Potential CSV injection from user input to CSV writer",
  source, "Source of user input"
================================================================================
