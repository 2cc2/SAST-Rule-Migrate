/**
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in `csv` module.
 * @kind path-problem
 * @problem.severity error
 * @id python/csv-writer-injection
 * @tags security
 *       external/cwe/cwe-1236
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class CSVWriterSink extends TaintSink {
  CSVWriterSink() {
    exists(DataFlow::MethodAccessNode ma |
      ma.getTarget().hasQualifiedName("csv._Writer", "writerow") or
      ma.getTarget().hasQualifiedName("csv._Writer", "writerows") or
      ma.getTarget().hasQualifiedName("csv._Writer", "writeheader") |
      ma = this.asDefiningNode()
    )
  }
}

class FlaskUserInput extends TaintSource {
  FlaskUserInput() {
    exists(DataFlow::ModuleImportNode mi | importsModule(mi, "flask") |
      exists(DataFlow::MethodAccessNode ma |
        ma.getTarget().hasQualifiedName("flask.request", [
          "form.get", "form.__getitem__", "args.get", 
          "args.__getitem__", "values.get", "values.__getitem__",
          "cookies.get", "cookies.__getitem__", "stream", 
          "headers.get", "headers.__getitem__", "data", 
          "full_path", "url", "json", "get_json"
        ]) |
        ma = this.asDefiningNode()
      )
    )
  }
}

class RouteParameter extends TaintSource {
  RouteParameter() {
    exists(Function f, string decorator |
      f.getADecorator().getValue() = decorator and
      decorator.matches("%route%") |
      exists(Parameter p | p = f.getAParameter() |
        p = this.asDefiningNode()
      )
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "CSVWriterInjection" }

  override predicate isSource(TaintSource source) {
    source instanceof FlaskUserInput or source instanceof RouteParameter
  }

  override predicate isSink(TaintSink sink) {
    sink instanceof CSVWriterSink
  }
}

