Rule Content:
/**
 * @name aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 *              Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id py/aiopg-sqli
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.ApiGraphs

class AiopgCursorExecute extends DataFlow::Invoke {
  AiopgCursorExecute() {
    exists(Function f |
      f = this.getFunc() and
      f.getQualifiedName() = "aiopg.Cursor.execute" and
      f.hasName("execute")
    )
  }
}

class UserInputSource extends DataFlow::Value {
  UserInputSource() {
    not exists(DataFlow::Literal _ | _ = this) and
    exists(DataFlow::Identifier _ | _ = this)
  }
  
  override DataFlow::CfgNode asCfgNode() { result = this.asDefiningNode() }
  override Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class SafeStringLiteral extends DataFlow::Value {
  SafeStringLiteral() {
    exists(DataFlow::StringLiteral str | 
      str = this and
      not regexMatch(str.getValue(), "%") and
      not regexMatch(str.getValue(), "\\+") and
      not str.getValue().charAt(str.getValue().length()-1) = '%' and
      not str.getValue().charAt(str.getValue().length()-1) = '+'
    )
  }
  
  override DataFlow::CfgNode asCfgNode() { result = this.asDefiningNode() }
  override Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class StringConcatenation extends DataFlow::Value {
  StringConcatenation() {
    exists(DataFlow::BinaryOperation bin |
      bin = this.getParent() and
      bin.getOperator() in ["+", "+="] and
      (bin.getLeftOperand() = this or bin.getRightOperand() = this)
    )
    or
    exists(DataFlow::Invoke call |
      call = this.getParent() and
      call.getFunc().getName() in ["format", "__mod__"] and
      this = call.getArg(0)
    )
  }
  
  override DataFlow::CfgNode asCfgNode() { result = this.asDefiningNode() }
  override Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class AiopgSqliConfig extends TaintTracking::Configuration {
  AiopgSqliConfig() { this = "AiopgSqliConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(AiopgCursorExecute call |
      sink = call.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeStringLiteral
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(StringConcatenation concat |
      node1 = concat.getALocalSource() and
      node2 = concat.getALocalSource()
    )
  }
}

