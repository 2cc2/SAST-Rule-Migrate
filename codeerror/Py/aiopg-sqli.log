Rule Content:
/**
 * @name aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 *              Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id py/aiopg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class AiopgCursorExecute extends DataFlow::CallNode {
  AiopgCursorExecute() {
    exists(Method m |
      m = this.getTarget() and
      m.getQualifiedName() = "aiopg.Cursor.execute" and
      m.hasName("execute")
    )
  }
}

class UserInputSource extends TaintTracking::SourceNode {
  UserInputSource() {
    not exists(DataFlow::LiteralNode l | l = this) and
    exists(DataFlow::IdentifierNode id | id = this)
  }

  override predicate isSource(DataFlow::Node source) { this = source }

  override DataFlow::Content getAContent() { result = this }

  override string getAPreconceptDescription() { result = "user input" }

  override string getAConceptDescription() { result = "user input" }

  override DataFlow::CfgNode asCfgNode() { result = this.asDefiningNode() }

  override Location getLocation() { result = this.getLocation() }

  override DataFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }

  override string toString() { result = this.toString() }

  override DataFlow::Scope getScope() { result = this.getScope() }

  override Variable asVariable() { result = this.asVariable() }
}

class SafeStringLiteral extends DataFlow::Node {
  SafeStringLiteral() {
    exists(DataFlow::StringLiteral str | 
      str = this and
      not str.getValue().matches("%") and
      not str.getValue().matches("\\+") and
      not str.getValue().charAt(str.getValue().length()-1) = '%' and
      not str.getValue().charAt(str.getValue().length()-1) = '+'
    )
  }
}

class StringConcatenation extends DataFlow::Node {
  StringConcatenation() {
    exists(DataFlow::BinaryExpr bin |
      bin = this.getEnclosingExpr() and
      bin.getOperator() in ["+", "+="] and
      (bin.getLeftOperand() = this or bin.getRightOperand() = this)
    )
    or
    exists(DataFlow::CallNode call |
      call = this.getEnclosingExpr() and
      call.getTarget().getName() in ["format", "__mod__"] and
      this = call.getAnArgument()
    )
  }
}

class AiopgSqliConfig extends TaintTracking::Configuration {
  AiopgSqliConfig() { this = "AiopgSqliConfig" }

  override predicate isSource(TaintTracking::SourceNode source) {
    source instanceof UserInputSource
  }

  override predicate isSink(TaintTracking::SinkNode sink) {
    exists(AiopgCursorExecute call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(SafeStringLiteral safe |
      safe = sanitizer.asNode()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(StringConcatenation concat |
      node1.getEnclosingExpr() = concat and
      node2.getEnclosingExpr() = concat
    )
  }
}

from AiopgSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "SQL注入风险: 检测到在aiopg SQL语句中使用非字面量变量拼接。" +
       "如果变量是用户控制且未正确清理，可能导致SQL注入。" +
       "建议使用参数化查询代替拼接.", source, sink
