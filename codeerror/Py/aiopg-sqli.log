}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    not exists(DataFlow::Literal _ | _ = this) and
    exists(DataFlow::Identifier _ | _ = this)
  }
  
  override predicate isSource() { this instanceof UserInputSource }
  
  override DataFlow::Node getALocalSource() { result = this }
}

class SafeStringLiteral extends DataFlow::Node {
  SafeStringLiteral() {
    exists(DataFlow::StringLiteral str | 
      str = this and
      not regexMatch(str.getValue(), "%|\\+") and
      not str.getValue().charAt(str.getValue().length()-1) = '%' and
      not str.getValue().charAt(str.getValue().length()-1) = '+'
    )
  }
  
  override predicate isSanitizer() { this instanceof SafeStringLiteral }
}

class StringConcatenation extends DataFlow::Node {
  StringConcatenation() {
    exists(DataFlow::BinaryOperation bin |
      bin = this.getBasicBlock().getARelevantBlock() and
      bin.getOperator() in ["+", "+="] and
      (bin.getLeftOperand() = this or bin.getRightOperand() = this)
    )
    or
    exists(DataFlow::Call call |
      call = this.getBasicBlock().getARelevantBlock() and
      call.getTarget().getName() in ["format", "__mod__"] and
      this = call.getAnArgument()
    )
  }
}

class AiopgSqliConfig extends TaintTracking::Configuration {
  AiopgSqliConfig() { this = "AiopgSqliConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(AiopgCursorExecute call |
      sink = call.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeStringLiteral
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(StringConcatenation concat |
      node1.getEnclosingCallable() = concat.getEnclosingCallable() and
      node2.getEnclosingCallable() = concat.getEnclosingCallable()
    )
  }
}

