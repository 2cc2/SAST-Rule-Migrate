import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts

class AiopgCursorExecute extends DataFlow::Call {
  AiopgCursorExecute() {
    exists(Method m |
      m = this.getTarget() and
      m.getQualifiedName() = "aiopg.Cursor.execute" and
      m.hasName("execute")
