      node: LITERAL
      where:
        - op: regex
          left: value
          right: "^\"[^%+]+\"$|^'[^%+]+'$"

propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint
    where:
      - op: in
        left: operator
        right: ["+", "+=", "format", "%", "f"]
