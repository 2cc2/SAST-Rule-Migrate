```yaml
xcpgir_version: "1.0"
rule:
  id: aiopg-sqli
  kind: taint
  severity: WARNING
  message: "Detected string concatenation with a non-literal variable in an aiopg Python SQL statement. This could lead to SQL injection if the variable is user-controlled and not properly sanitized. Use parameterized queries instead."

sources:
  - id: USER_INPUT
    match:
      node: IDENTIFIER
      where:
        - op: neq
          left: isLiteral
          right: true

sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: { type: aiopg.Cursor, method: execute }
      arg_index: 0

sanitizers:
  - id: SAFE_FORMAT
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "^\"[^%+]+\"$|^'[^%+]+'$"

propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint
    where:
      - op: in
        left: operator
        right: ["+", "+=", "format", "%", "f"]
```
