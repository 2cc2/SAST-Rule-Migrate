Rule Content:
/**
 * @name Dangerous subprocess usage
 * @description Detects subprocess functions without static string arguments that could lead to command injection
 * @kind taint
 * @severity Error
 * @id py/dangerous-subprocess-use-audit
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import DataFlow
import DataFlow::PathGraph
import DataFlow::TaintTracking

class SubprocessCalls extends python::Call {
  SubprocessCalls() {
    exists(string func | func = ["Popen", "run", "call", "check_output"] |
      getFuncDecl().hasQualifiedName("subprocess", func)
    ) and
    API::moduleImport("subprocess").getACall() = this
  }
}

class CommandSource extends DataFlow::Node {
  CommandSource() {
    exists(SubprocessCalls call |
      call.getArg(0) = this and
      not this.asExpr() instanceof python::StringLiteral and
      not this.asExpr() instanceof python::List
    )
  }
}

class ShellExecution extends DataFlow::Node {
  ShellExecution() {
    exists(SubprocessCalls call |
      call.getArg(0) = this and
      (
        (this.asExpr() instanceof python::StringLiteral and this.asExpr().getText().matches("%(sh|bash|ksh|csh|tcsh|zsh)%")) or
        call.getArg(1).toString() = "-c"
      )
    )
  }
}

class ShlexSanitizer extends DataFlow::Node {
  ShlexSanitizer() {
    exists(python::Call call |
      call.getFuncDecl().hasQualifiedName("shlex", "escape") and
      call.getResult() = this
    )
  }
}

module TaintConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { source instanceof CommandSource }
  predicate isSink(DataFlow::Node sink) { sink instanceof ShellExecution }
  predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof ShlexSanitizer }
  predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    none()
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where TaintTracking::localTaint(TaintConfig, source, sink)
select sink.getNode(), "Detected subprocess function without a static string. If this data can " +
  "be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'.", source, sink
