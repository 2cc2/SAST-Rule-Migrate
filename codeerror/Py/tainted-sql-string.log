Rule Content:
/**
 * @name Tainted SQL string construction
 * @description Detects user input used to manually construct a SQL string.
 * @kind path-problem
 * @problem.severity error
 * @id py/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Security.TaintTracking
import DataFlow

class FlaskRequestSource extends RemoteFlowSource::Range {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getMethodName().regexpMatch("flask\\.request\\..*") and
      this.asDefiner() = call.getReturn()
    )
  }
}

class RouteParamSource extends ParamRange {
  RouteParamSource() {
    exists(Function f, Decorator d |
      f.getADecorator() = d and
      d.getNthArg(0).(Str).getText().regexpMatch("@.*\\.route\\(.*\\).*") and
      this.asDefiner() = f.getAParameter()
    )
  }
}

class SqlStringConcatSink extends TaintSink::Range {
  SqlStringConcatSink() {
    exists(MethodCall call |
      call.getTarget().toString().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b.*") and
      call.getParent().(Add).getAnOperand() = call or
      call.getParent().(StrFormat).getChild(0) = call or
      call.getParent().(FString).getChild(0) = call
    |
      this.asExpr() = call
    )
  }
}

class ParameterizedQuerySanitizer extends Sanitizer::Range {
  ParameterizedQuerySanitizer() {
    exists(MethodCall call |
      call.getMethod().getName() = "text" and
      call.getMethod().getDeclaringType().getName() = "sqlalchemy"
    |
      this.asExpr() = call
    )
  }
}

predicate isSource(DataFlow::Node source) {
  source instanceof FlaskRequestSource or
  source instanceof RouteParamSource
}

predicate isSink(DataFlow::Node sink) {
  sink instanceof SqlStringConcatSink
}

predicate isSanitizer(DataFlow::Node sanitizer) {
  sanitizer instanceof ParameterizedQuerySanitizer
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
    "Detected user input used to manually construct a SQL string. This is unsafe and may lead to SQL injection."
