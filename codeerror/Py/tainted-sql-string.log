/**
 * @name Tainted SQL string construction
 * @description Detects user input used to manually construct a SQL string.
 * @kind path-problem
 * @problem.severity error
 * @id py/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.ApiGraphs
import DataFlow
import semmle.python.dataflow.TaintTracking

class TaintedSQLConfig extends TaintTracking::Configuration {
  TaintedSQLConfig() { this = "TaintedSQLConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      call.getCallee().toString().regexpMatch("flask\\.request\\..*") and
      source.asExpr() = call
    )
    or
    exists(Function f, Decorator d, string decoration |
      f.getADecorator() = d and
      decoration = d.getExpr().toString() and
      decoration.regexpMatch("@.*\\.route\\(.*\\).*") and
      source.asParameterNode() = f.getParameter(_)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCallee().toString().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b.*") and
      (
        exists(Addition add | add.getAnOperand() = call) or
        exists(FormatString format | format.getChild(0) = call) or
        exists(FStringLiteral fstring | fstring.getChild(0) = call)
      ) and
      sink.asExpr() = call
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getCallee().getName() = "text" and
      call.getCallee().getDeclaringType().getName() = "sqlalchemy" and
      sanitizer.asExpr() = call
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSQLConfig cfg
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
    "Detected user input used to manually construct a SQL string. This is unsafe and may lead to SQL injection."
