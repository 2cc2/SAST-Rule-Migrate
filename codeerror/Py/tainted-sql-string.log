 * @description Detects user input used to manually construct a SQL string.
 * @kind path-problem
 * @problem.severity error
 * @id py/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking

class TaintedSQLConfig extends TaintTracking::Configuration {
  TaintedSQLConfig() { this = "TaintedSQLConfig" }

  override predicate isSource(TaintTracking::Source source) {
    exists(Call call |
      call.getTarget().toString().regexpMatch("flask\\.request\\..*") and
      source.asExpr() = call
    )
    or
    exists(Function f, Expr d, string decoration |
      f.getADecorator() = d and
      decoration = d.toString() and
      decoration.regexpMatch("@.*\\.route\\(.*\\).*") and
      source.asParameter() = f.getParameter(_)
    )
  }

  override predicate isSink(TaintTracking::Sink sink) {
    exists(Call call |
      call.getTarget().toString().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b.*") and
      (
        exists(BinaryOperation op | op.getAnOperand() = call and op.getOperator() = "+") or
        exists(StringFormatting format | format.getChild(0) = call) or
        exists(FString fstring | fstring.getChild(0) = call)
      ) and
      sink.asExpr() = call
    )
  }

  override predicate isBarrier(TaintTracking::Barrier barrier) {
    exists(Call call |
      call.getTarget().getName() = "text" and
      call.getTarget().getDeclaringType().getName() = "sqlalchemy" and
      barrier.asExpr() = call
