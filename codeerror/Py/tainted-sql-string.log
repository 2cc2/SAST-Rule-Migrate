Rule Content:
/**
 * @name Tainted SQL string construction
 * @description Detects user input used to manually construct a SQL string.
 * @kind path-problem
 * @problem.severity error
 * @id py/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph
import TaintTracking

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() {
    exists(Call call | call.getTarget().toString().regexpMatch("flask\\.request\\..*") and
    this.asSource() = call)
  }
}

override predicate isSource(DataFlow::Node source) {
  exists(Call call |
    call.getTarget().toString().regexpMatch("flask\\.request\\..*") and
    source.asExpr() = call
  )
  or
  exists(Function f, DecoratorNode d, string decoration |
    f.getADecorator() = d and
    decoration = d.getExpr().toString() and
    decoration.regexpMatch("@.*\\.route\\(.*\\).*") and
    source.asParameter() = f.getAParameter()
  )
}

override predicate isSink(DataFlow::Node sink) {
  exists(Call call |
    call.getTarget().toString().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b.*") and
    (
      exists(Add add | add.getAnOperand() = call) or
      exists(StrFormat format | format.getChild(0) = call) or
      exists(FString fstring | fstring.getChild(0) = call)
    ) and
    sink.asExpr() = call
  )
}

override predicate isSanitizer(DataFlow::Node sanitizer) {
  exists(Call call |
    call.getTarget().getName() = "text" and
    call.getTarget().getDeclaringType().getName() = "sqlalchemy" and
    sanitizer.asExpr() = call
  )
}

from TaintTracking::Configuration cfg, TaintTracking::PathNode source, TaintTracking::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
    "Detected user input used to manually construct a SQL string. This is unsafe and may lead to SQL injection."
