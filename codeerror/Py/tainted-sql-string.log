/**
 * @name Tainted SQL string construction
 * @description Detects user input used to manually construct a SQL string.
 * @kind path-problem
 * @problem.severity error
 * @id py/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking

class TaintedSQLConfig extends TaintTracking::Configuration {
  TaintedSQLConfig() { this = "TaintedSQLConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    exists(Call call |
      call.getFunc().toString().regexpMatch("flask\\.request\\..*") and
      source.asExpr() = call
    )
    or
    exists(Function f, Expr d, string decoration |
      f.getADecorator() = d and
      decoration = d.toString() and
      decoration.regexpMatch("@.*\\.route\\(.*\\).*") and
      source.asParameter() = f.getAParameter()
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(Call call |
      call.getFunc().toString().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b.*") and
      (
        exists(BinaryExpr add | add.getAnOperand() = call and add.getOperator() = "+") or
        exists(StrFormatExpr format | format.getChild(0) = call) or
        exists(FStringExpr fstring | fstring.getChild(0) = call)
      ) and
      sink.asExpr() = call
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(Call call |
      call.getFunc().getName() = "text" and
      call.getFunc().getDeclaringType().getName() = "sqlalchemy" and
      sanitizer.asExpr() = call
    )
  }
}

