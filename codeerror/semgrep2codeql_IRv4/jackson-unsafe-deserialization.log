Rule Content:
/**
 * @name Jackson Unsafe Deserialization
 * @description When using Jackson to marshall/unmarshall JSON to Java objects, enabling default typing is dangerous and can lead to RCE.
 *              If an attacker can control the JSON input it might be possible to provide a malicious JSON which can be used to exploit
 *              insecure deserialization.
 * @kind problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision medium
 * @id java/jackson-unsafe-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a8:2017
 *       external/owasp/a8:2021
 *       audit
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.Jackson

// Case 1: Global ObjectMapper configuration with enableDefaultTyping()
class GlobalJacksonUnsafeDeserialization extends DataFlow::Configuration {
  GlobalJacksonUnsafeDeserialization() { this = "GlobalJacksonUnsafeDeserialization" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess readValue |
      readValue.getMethod().hasName("readValue") and
      readValue.getMethod().getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      source.asExpr() = readValue.getArgument(0) and
      exists(MethodAccess enableTyping |
        enableTyping.getMethod().hasName("enableDefaultTyping") and
        enableTyping.getMethod().getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
        enableTyping.getQualifier().getType() = readValue.getQualifier().getType()
      )
    )
  }
}

// Case 2: Per-class annotation with dangerous types
class PerClassJacksonUnsafeDeserialization extends DataFlow::Configuration {
  PerClassJacksonUnsafeDeserialization() { this = "PerClassJacksonUnsafeDeserialization" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess readValue, Class jsonClass, Annotation jsonTypeInfo, Field fld |
      readValue.getMethod().hasName("readValue") and
      readValue.getMethod().getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      source.asExpr() = readValue.getArgument(0) and
      readValue.getArgument(1).getType() = jsonClass and
      jsonTypeInfo = jsonClass.getAnAnnotation() and
      jsonTypeInfo.getType().hasQualifiedName("com.fasterxml.jackson.annotation", "JsonTypeInfo") and
      jsonTypeInfo.getArgument("use").(MemberAccess).getMember().getName() = "CLASS" and
      fld.getDeclaringType() = jsonClass and
      fld.getType().toString().matches("Object|Serializable|Comparable")
    )
  }
}

// Case 3: ObjectMapper initialized in method with enableDefaultTyping()
class InitJacksonUnsafeDeserialization extends DataFlow::Configuration {
  InitJacksonUnsafeDeserialization() { this = "InitJacksonUnsafeDeserialization" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess readValue, Field omField, Method initMethod |
      readValue.getMethod().hasName("readValue") and
      readValue.getMethod().getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      source.asExpr() = readValue.getArgument(0) and
      readValue.getQualifier() = omField.getAnAccess() and
      exists(MethodAccess enableTyping |
        enableTyping.getMethod().hasName("enableDefaultTyping") and
        enableTyping.getMethod().getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
        enableTyping.getQualifier() = omField.getAnAccess() and
        enableTyping.getEnclosingCallable() = initMethod
      )
    )
  }
}

from DataFlow::Node source
where
  any(GlobalJacksonUnsafeDeserialization c).hasFlow(source) or
  any(PerClassJacksonUnsafeDeserialization c).hasFlow(source) or
  any(InitJacksonUnsafeDeserialization c).hasFlow(source)
select source, "Unsafe Jackson deserialization with default typing enabled may lead to remote code execution"
