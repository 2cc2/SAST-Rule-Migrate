import java
import semmle.code.java.dataflow.TaintTracking

class XMLInputFactoryExternalEntitiesEnabled extends TaintTracking::Configuration {
  XMLInputFactoryExternalEntitiesEnabled() { this = "XMLInputFactoryExternalEntitiesEnabled" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("setProperty") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      (
        (ma.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" and 
         ma.getArgument(1).(BooleanLiteral).getValue() = true) or
        (ma.getArgument(0).(FieldAccess).getField().hasQualifiedName("javax.xml.stream", 
          "XMLInputFactory", "IS_SUPPORTING_EXTERNAL_ENTITIES") and 
         ma.getArgument(1).(BooleanLiteral).getValue() = true) or
        (ma.getArgument(0).(FieldAccess).getField().hasQualifiedName("javax.xml.stream", 
          "XMLInputFactory", "SUPPORT_DTD") and 
         ma.getArgument(1).(BooleanLiteral).getValue() = true) or
        (ma.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" and 
         ma.getArgument(1).(FieldAccess).getField().hasQualifiedName("java.lang", "Boolean", "TRUE")) or
        (ma.getArgument(0).(FieldAccess).getField().hasQualifiedName("javax.xml.stream", 
          "XMLInputFactory", "IS_SUPPORTING_EXTERNAL_ENTITIES") and 
         ma.getArgument(1).(FieldAccess).getField().hasQualifiedName("java.lang", "Boolean", "TRUE")) or
