Rule Content:
/**
 * @name XMLInputFactory External Entities Enabled
 * @description XML external entities are enabled for this XMLInputFactory. This is vulnerable 
 * to XML external entity attacks. Disable external entities by setting 
 * 'javax.xml.stream.isSupportingExternalEntities' to false.
 * @kind path-problem
 * @problem.severity error
 * @precision medium
 * @id java/xxe/xmlinputfactory-external-entities-enabled
 * @tags security
 *       cwe/611
 *       external/cwe/cwe-611
 *       owasp-a04:2017
 *       owasp-a05:2021
 *       java
 */

import java
import semmle.code.java.dataflow.TaintTracking

class XMLInputFactoryExternalEntitiesEnabled extends TaintTracking::Configuration {
  XMLInputFactoryExternalEntitiesEnabled() { this = "XMLInputFactoryExternalEntitiesEnabled"() }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m |
      m.hasName("setProperty") and
      m.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      exists(m.getACall() as ma |
        (
          (ma.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" 
            and ma.getArgument(1) = BooleanTrue()) or
          (ma.getArgument(0).(FieldAccess).getField().hasQualifiedName("javax.xml.stream", 
            "XMLInputFactory", "IS_SUPPORTING_EXTERNAL_ENTITIES") 
            and ma.getArgument(1) = BooleanTrue()) or
          (ma.getArgument(0).(FieldAccess).getField().hasQualifiedName("javax.xml.stream", 
            "XMLInputFactory", "SUPPORT_DTD") and ma.getArgument(1) = BooleanTrue()) or
          (ma.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" 
            and ma.getArgument(1).(FieldAccess).getField().hasQualifiedName("java.lang", "Boolean", "TRUE")) or
          (ma.getArgument(0).(FieldAccess).getField().hasQualifiedName("javax.xml.stream", 
            "XMLInputFactory", "IS_SUPPORTING_EXTERNAL_ENTITIES") 
            and ma.getArgument(1).(FieldAccess).getField().hasQualifiedName("java.lang", "Boolean", "TRUE")) or
          (ma.getArgument(0).(FieldAccess).getField().hasQualifiedName("javax.xml.stream", 
            "XMLInputFactory", "SUPPORT_DTD") 
            and ma.getArgument(1).(FieldAccess).getField().hasQualifiedName("java.lang", "Boolean", "TRUE"))
        ) and
        source.asExpr() = ma
      )
    )
  }
}

from XMLInputFactoryExternalEntitiesEnabled config, DataFlow::Node src
where config.hasFlow(src, _)
select src, "XML external entities are enabled for this XMLInputFactory. This is vulnerable to XML " +
  "external entity attacks. Disable external entities by setting " +
  "'javax.xml.stream.isSupportingExternalEntities' to false."
