/**
 * @name Use SnakeYAML Constructor
 * @description Detects usage of vulnerable SnakeYAML org.yaml.snakeyaml.Yaml() constructor with no arguments,
 *              which is vulnerable to deserialization attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/use-snakeyaml-constructor
 * @tags security
 *       external/cwe/cwe-502
 *       owasp-a08:2017
 *       owasp-a08:2021
 *       cwe2021-top25
 *       cwe2022-top25
 */
import java

from ConstructorCall constructorCall, Method method
where
  constructorCall.getConstructor().hasQualifiedName("org.yaml.snakeyaml", "Yaml") and
  not exists(constructorCall.getArgument(0)) and
  method.getName() = "load" and
  method.getDeclaringType() = constructorCall.getConstructor().getDeclaringType()
select constructorCall,
  "Used SnakeYAML org.yaml.snakeyaml.Yaml() constructor with no arguments, which is vulnerable to deserialization attacks. " +
  "Use the one-argument Yaml(...) constructor instead, with SafeConstructor or a custom Constructor as the argument."
