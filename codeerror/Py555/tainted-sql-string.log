/**
 * @name Tainted SQL String Construction
 * @description Detected user input used to manually construct a SQL string.
 * @kind path-problem
 * @problem.severity error
 * @id python/sql-injection
 */

import python
import python.web.flask.Flask
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(Call call |
      call.getFunc().getName().matches("request%") and
      call.getFunc().getQualifiedName().matches("flask.request.%")
    )
    or
    exists(Parameter p |
      p.getFunction().getADecorator().toString().matches("@%.route") and
      p.getAnAccess() = _ and
      p.getName() != ""
    )
  }

  override string getSourceType() { "Flask request parameter or attribute" }
}

class SqlStringConstructionSink extends DataFlow::Sink {
  SqlStringConstructionSink() {
    exists(Call call, string concatType |
      (
        concatType = "+" and
        call.getFunc().getName() = "__add__" or
        concatType = "%" and
        call.getFunc().getName() = "__mod__" or
        concatType = "format" and
        call.getFunc().getName() = "format" or
        concatType = "fstring" and
        call instanceof FormattedValue
      ) and
      exists(string sqlPattern |
        sqlPattern.matches("%(?i)(select|delete|insert|create|update|alter|drop)%") and
        call.getChild(0).toString().matches(sqlPattern)
      )
    )
  }

  override string getSinkType() { "SQL string concatenation operation" }
}

class TaintedSqlConfiguration extends TaintTracking::Configuration {
  TaintedSqlConfiguration() { this = "TaintedSqlConfiguration" }

  override predicate isSource(DataFlow::Source source) { source instanceof FlaskRequestSource }

  override predicate isSink(DataFlow::Sink sink) { sink instanceof SqlStringConstructionSink }
}

from TaintedSqlConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source.getNode() + source.getNode().getLocation(),
  "User input used to manually construct SQL string, potential SQL injection vulnerability"
