Rule Content:
/**
 * @name Tainted SQL string construction
 * @description Detects user input used to manually construct SQL strings, which may lead to SQL injection
 * @kind path-problem
 * @problem.severity error
 * @id python/sql-injection/tainted-sql-string
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Flask
import semmle.python.Strings.FString
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    // Source: Flask request methods
    exists(MethodAccess ma |
      ma.getMethodName().regexpMatch("request\\.(args|form|values|cookies|headers|data|json|get_json|files).*") and
      ma = this.asDefiningSource()
    )
    or
    // Source: Route parameters
    exists(Function f, Parameter p |
      f.getADecorator().getName() = "route" and
      p = f.getAParameter() and
      p = this.asParameter()
    )
  }
}

class SqlStringConstruction extends DataFlow::Node {
  SqlStringConstruction() {
    exists(string s |
      // Detect SQL string concatenation
      (
        (s.regexpMatch(".*\\+.+") or s.regexpMatch(".*\\%.+") or s.regexpMatch(".*\\.format\\(.+") or
        exists(FString fs | fs = s))
        and
        s.regexpMatch("(?i)(select|delete|insert|create|update|alter|drop).*")
      )
      and
      this.asExpr() = s
    )
  }
}

class TaintedSqlConfig extends TaintTracking::Configuration {
  TaintedSqlConfig() { this = "TaintedSqlConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlStringConstruction
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSqlConfig conf
where conf.hasFlowPath(source, sink)
select sink,
  "Detected user input used to manually construct a SQL string. This could lead to SQL injection." +
  "Instead, use parameterized queries or an ORM like SQLAlchemy.",
  source, "User input flows here"
