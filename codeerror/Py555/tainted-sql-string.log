Rule Content:
/**
 * @name Tainted SQL string construction
 * @description Detected user input used to manually construct a SQL string. This is usually bad 
 *   bad practice because manual construction could accidentally result in a SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @id python/manual-sql-construction
 */

import python
import semmle.python.security.strings.Formatted
import semmle.python.Concepts
import semmle.python.web.flask.Flask
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getAPIName().matches("request.%") and
      ma.getMethod().getDeclaringType().hasQualifiedName("flask", "Request") and
      this.asExpr() = ma
    )
    or
    exists(Parameter p |
      exists(FunctionValue route |
        route.getDecorator().toString().matches("@%APP.route%") and
        route.getAParameter() = p and
        this.asParameter() = p
      )
    )
  }
}

class SqlConstructionSink extends DataFlow::Node {
  SqlConstructionSink() {
    exists(MethodAccess ma |
      (
        // String concatenation case
        ma.getMethod().getName() = "+" and
        ma.getQualifier().toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%") 
      )
      or
      (
        // String formatting cases
        ma.getMethod().getName().matches("format|%__mod__") and
        ma.getQualifier().toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%")
      )
      or
      (
        // f-string case
        exists(FString fs | fs = ma.getQualifier() |
          fs.toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%")
        )
      )
    )
  }
}

class TaintedSqlConfg extends TaintConfiguration {
  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlConstructionSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from TaintedSqlConfg config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink, "Detected user input used to manually construct a SQL string. " +
  "This could lead to SQL injection. Use parameterized queries instead."
