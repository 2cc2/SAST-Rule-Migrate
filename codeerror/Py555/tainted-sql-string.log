Rule Content:
/**
 * @name Tainted SQL String Construction
 * @description Detects user input used to manually construct SQL strings,
 *              which could lead to SQL injection vulnerabilities.
 * @id tainted-sql-string
 * @kind path-problem
 * @severity error
 * @tags security
 *     external/cwe/cwe-089
 */
import python
import semmle.python.Concepts
import semmle.python.web.flask.Requests
import DataFlow::PathGraph
import DataFlow::PartialPathGraph

class FlaskRequestSource extends RemoteFlowSource {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethodDecl().hasQualifiedName("flask", "request", _) and
      this.asSource() = ma.getAnArgument()
    ) or
    exists(Function f, Parameter p |
      f.hasDecoratorName("route") and
      p = f.getAParameter() and
      this.asSource() = p
    )
  }

  override string getSourceType() { result = "Flask request source" }
}

class SqlStringConstruction extends DataFlow::ExprNode {
  SqlStringConstruction() {
    exists(string s |
      // String concatenation
      (this.getNode() instanceof Add and
       this.getNode().getAnOperand().getStringValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b.*")) or
      // String formatting
      (this.getNode() instanceof StrFormat or
       this.getNode() instanceof FString or
       this.getNode() instanceof Mod)
    )
  }

  override string getSinkType() { result = "SQL string construction" }
}

class TaintedSqlConfig extends TaintTracking::Configuration {
  TaintedSqlConfig() { this = "TaintedSqlConfig" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof SqlStringConstruction
  }

  override int explorationLimit() { result = 100 }
}

from TaintedSqlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user input used to manually construct a SQL string. This is usually bad practice because manual " +
  "construction could accidentally result in a SQL injection. An attacker could use a SQL injection to " +
  "steal or modify contents of the database. Instead, use a parameterized query which is available by " +
  "default in most database engines. Alternatively, consider using an object-relational mapper (ORM) " +
  "such as SQLAlchemy which will protect your queries."
