Rule Content:
/**
 * @name Tainted SQL string construction
 * @description Detected user input used to manually construct a SQL string.
 * @kind path-problem
 * @problem.severity error
 * @id python/tainted-sql-string
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.Flask
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("request.%") and
      ma.getMethod().getDeclaringType().hasName("Flask")
    |
      this.asParameter() = API::getTopLevelArgument(ma, _)
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Decorator d, string routeVar |
      d.getExpr().toString().matches("@$APP.route(...)") and
      f.getADecorator() = d and
      f.getAParameter().getName() = routeVar
    |
      this.asParameter() = f.getAParameter().getAnAccess()
    )
  }
}

class SqlConcatSink extends DataFlow::Node {
  SqlConcatSink() {
    exists(DataFlow::MethodAccessNode ma |
      (
        ma.getCode().regexpMatch("\"\\$SQLSTR\" \\+ .*|" +
                               "\"\\$SQLSTR\" % .*|"                                +
                               "\"\\$SQLSTR\"\\.format\\(.*\\)|" +
                               "f\"\\$SQLSTR\\{.*\\}.*\"") and
        ma.getCode().regexpMatch("\\s*(?i)(select|delete|insert|create|update|alter|drop)\\b.*")
      )
    |
      this = ma
    )
  }
}

class TaintedSqlConfig extends TaintTracking::Configuration {
  TaintedSqlConfig() { this = "TaintedSqlConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlConcatSink
  }
}

from TaintedSqlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected user input used to manually construct a SQL string. " +
"This is usually bad practice because manual construction could accidentally result in a SQL injection. " +
"An attacker could use a SQL injection to steal or modify contents of the database. " +
"Instead, use a parameterized query which is available by default in most database engines. " +
"Alternatively, consider using an object-relational mapper (ORM) such as SQLAlchemy which will protect your queries."
