Rule Content:
/**
 * @name Tainted SQL string construction
 * @description Detected user input used to manually construct a SQL string.
 * @kind problem
 * @problem.severity error
 * @id py/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */
import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.RemoteFlowSources
import semmle.python.Concepts

class FlaskReqSource extends DataFlow::Node {
  FlaskReqSource() {
    exists(MethodAccess ma |
      ma.getMethod().getAPIName() = "request" and
      ma.getQualifier().getType().getName() = "Flask" and
      this = ma.getReturn()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      exists(Call c |
        c.getTarget().getAPIName() = "route" and
        c.getQualifier().getType().getName() = "Flask" and
        f = c.getEnclosingFunction()
      ) and
      p = f.getAParameter() and
      this.asParameter() = p
    )
  }
}

class SQLConcatSink extends DataFlow::Node {
  SQLConcatSink() {
    exists(BinaryOperation binop |
      (binop.getOperator() = "+" or binop.getOperator() = "%") and
      binop.getLeftOperand().toString().matches("%\\s*(?i)(select|delete|insert|create|update|alter|drop)\\b.*%") and
      this = binop
    )
    or
    exists(MethodCall mc |
      mc.getMethod().getName() = "format" and
      mc.getQualifier().toString().matches("%\\s*(?i)(select|delete|insert|create|update|alter|drop)\\b.*%") and
      this = mc
    )
    or
    exists(InterpolatedString is |
      is.getStringPart().matches("%\\s*(?i)(select|delete|insert|create|update|alter|drop)\\b.*%") and
      this = is
    )
  }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskReqSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLConcatSink
  }

  override predicate isExtension(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2) or
    TaintTracking::fieldFlowStep(node1, node2)
  }
}

from TaintedSqlStringConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected user input used to manually construct a SQL string. " +
  "This is usually bad practice because manual construction could accidentally " +
  "result in a SQL injection. An attacker could use a SQL injection to steal or " +
  "modify contents of the database. Instead, use a parameterized query which " +
  "is available by default in most database engines. Alternatively, consider " +
  "using an object-relational mapper (ORM) such as SQLAlchemy which will " +
  "protect your queries."
