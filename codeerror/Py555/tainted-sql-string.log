Rule Content:
/**
 * @id tainted-sql-string
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.Flask
import semmle.python.Concepts
import semmle.python.StringOperations
import semmle.python.ApiGraphs

class SqlStringConstruction extends DataFlow::Node {
  SqlStringConstruction() {
    exists(string operation |
      operation.regexpMatch("\"\\$SQLSTR\" \\+ .*|\"\\$SQLSTR\" % .*|\"\\$SQLSTR\"\\.format\\(.*\\)|f\"\\$SQLSTR\\{.*\\}.*\"" ) and
      operation.getAString().regexpMatch("\\s*(?i)(select|delete|insert|create|update|alter|drop)\\b.*") and
      this = operation
    )
  }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getAPackageName() = "flask" and
      ma.getMethod().getName().matches("request.%") and
      this = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      exists(Decorator d |
        d.getTarget() = f and
        d.getExpr().toString().matches("@$APP.route(%)")
      ) and
      p = f.getAParameter() and
      this = p
    )
  }
}

class TaintedSQLInjectionConfig extends TaintTracking::Configuration {
  TaintedSQLInjectionConfig() { this = "Tainted SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlStringConstruction
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }

  override predicate isAdditionalTaintStep(DataFlow::Node from, DataFlow::Node to) {
    // Propagation through function arguments, returns, and field access
    TaintTracking::localTaintStep(from, to) or
    TaintTracking::fieldFlowStep(from, to)
  }
}

from TaintedSQLInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected user input used to manually construct a SQL string. This is usually bad practice because manual construction could accidentally result in a SQL injection. An attacker could use a SQL injection to steal or modify contents of the database. Instead, use a parameterized query which is available by default in most database engines. Alternatively, consider using an object-relational mapper (ORM) such as SQLAlchemy which will protect your queries."
