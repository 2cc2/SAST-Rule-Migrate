Rule Content:
/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string.
 * @kind path-problem
 * @problem.severity error
 * @id python/sql-injection
 */

import python
import semmle.python.Concepts
import DataFlow::PathGraph
import semmle.python.dataflow.new.TaintTracking

private class FlaskReqSource extends DataFlow::Node {
  FlaskReqSource() {
    exists(MethodAccess ma |
      ma.getTarget().toString().matches("flask.request.%") and
      this.asExpr() = ma
    )
  }

  override predicate isSource() {
    this instanceof TaintSource
  }

  override DataFlow::CfgNode asCfgNode() { result = this.asExpr() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { result = this.asExpr().asVariable() }
}

private class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getDecoratorName() = "route" and
      p.getFunction() = f and
      this.asExpr() = p
    )
  }

  override predicate isSource() {
    this instanceof TaintSource
  }

  override DataFlow::CfgNode asCfgNode() { result = this.asExpr() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { result = this.asExpr().asVariable() }
}

private class SQLConcatSink extends DataFlow::Node {
  SQLConcatSink() {
    exists(Expr::BinOp binOp |
      (binOp.getOperator() = "+" or binOp.getOperator() = "%") and
      isSQLString(binOp.getLeftOperand()) and
      this.asExpr() = binOp
    )
    or
    exists(API::CallNode call |
      call.getTarget().toString().matches("%.format") and
      isSQLString(call.getQualifier()) and
      this.asExpr() = call
    )
    or
    exists(StringLiteral fString |
      isSQLString(fString) and
      this.asExpr() = fString
    )
  }

  private predicate isSQLString(Expr e) {
    e.toString().toLowerCase().matches("%select%") or
    e.toString().toLowerCase().matches("%delete%") or
    e.toString().toLowerCase().matches("%insert%") or
    e.toString().toLowerCase().matches("%update%") or
    e.toString().toLowerCase().matches("%alter%") or
    e.toString().toLowerCase().matches("%drop%")
  }

  override predicate isSink() {
    this instanceof TaintSink
  }

  override DataFlow::CfgNode asCfgNode() { result = this.asExpr() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { result = this.asExpr().asVariable() }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskReqSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLConcatSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSqlStringConfig conf
where conf.hasFlowPath(source, sink)
select sink, source, sink, "Detected user input used to manually construct a SQL string."
