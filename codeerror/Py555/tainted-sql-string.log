Rule Content:
/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string.
 * @kind problem
 * @severity error
 * @id python/sql-injection
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("request.%") and
      ma.getMethod().getDeclaringType().getName() = "Flask" and
      this.asExpr() = ma
    )
  }

  override string toString() { result = "Flask request source" }
  override predicate isSource() { this = any(FlaskRequestSource f) }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getADecorator().getExpr().toString().matches("@%.route(%)") and
      p = f.getParameter(_) and
      this.asParameter() = p
    )
  }

  override string toString() { result = "Route parameter source" }
  override predicate isSource() { this = any(RouteParamSource r) }
}

class SqlConcatSink extends DataFlow::Node {
  SqlConcatSink() {
    exists(Call call, string sqlstr |
      (
        call.getCalleeName() = "+" or
        call.getCalleeName() = "format" or
        call.getCalleeName() = "%"
      ) and
      sqlstr = call.getArgument(0).toString() and
      sqlstr.matches("(?i)(select|delete|insert|create|update|alter|drop)\\b.*") and
      this.asExpr() = call
    )
  }

  override string toString() { result = "SQL string concatenation sink" }
  override predicate isSink(DataFlow::Node node) { node = any(SqlConcatSink s) }
}

class TaintedSqlConfig extends TaintTracking::Configuration {
  TaintedSqlConfig() { this = "Tainted SQL String Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlConcatSink
  }

  override predicate isSanitizer(DataFlow::Node node) { none() }
}

from TaintedSqlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected user input used to manually construct a SQL string. $@",
  source, "User input flows here"
