/**
 * @name Tainted SQL String Construction
 * @description Detected user input used to manually construct a SQL string.
 * @kind problem
 * @problem.severity error
 * @precision high
 * @id py/tainted-sql-string
 */

import python
import python.StringOps
import python.web.Flask
import DataFlow::PathGraph
import TaintTracking

/** Sources from Flask request objects */
class FlaskRequestSource extends TaintTracking::TaintSource {
  FlaskRequestSource() { 
    exists(Call call | call.getMethod().(Method).getName() = "request" |
      call.getMethod().(Method).getQualifiedName().matches("flask.request.%")
    )
  }

  override predicate isSource(TaintTracking::TaintSource source) { 
    source instanceof FlaskRequestSource 
  }

  /** Implement required predicates */
  predicate asCfgNode() { this = result }
  predicate getLocation() { result = this.getLocation() }
  override string toString() { result = "Flask request source" }
}

/** Sources from route parameters */
class RouteParamSource extends TaintTracking::TaintSource {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getADecorator().toString().matches("@%APP.route%") and
      p = f.getParameter(_)
    )
  }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof RouteParamSource
  }

  /** Implement required predicates */
  predicate asCfgNode() { this = result }
  predicate getLocation() { result = this.getLocation() }
  override string toString() { result = "Route parameter source" }
}

/** SQL string concatenation operations */
class SqlStringConstruction extends TaintTracking::TaintSink {
  Expr sqlExpr;

  SqlStringConstruction() {
    exists(AddExpr add | 
      add.getLeftOperand().toString().matches("%select%|%delete%|%insert%|%update%") |
      sqlExpr = add
    ) or
    exists(MethodCall mc |
      mc.getMethod().getName() = "format" and
      mc.getQualifier().toString().matches("%select%|%delete%|%insert%|%update%") |
      sqlExpr = mc
    ) or
    exists(FormatString fs |
      fs.getStringValue().matches("%select%|%delete%|%insert%|%update%") |
      sqlExpr = fs
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SqlStringConstruction
  }

  /** Implement required predicates */
  predicate asCfgNode() { this = result }
  predicate getLocation() { result = this.getLocation() }
  override string toString() { result = "SQL string construction sink" }
}

/** Configure taint tracking */
class TaintedSqlConfig extends TaintTracking::Configuration {
  TaintedSqlConfig() { this = "TaintedSqlConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SqlStringConstruction
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    node1.asExpr().(AddExpr).getRightOperand() = node2.asExpr() or
    node1.asExpr().(MethodCall).getAnArgument() = node2.asExpr()
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSqlConfig cfg
where cfg.hasFlowPath(source, sink)
select sink, source, sink, 
  "Detected user input used to manually construct a SQL string. Use parameterized queries instead."
