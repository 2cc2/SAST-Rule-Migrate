Rule Content:
/**
 * @name MySQL SQL Injection via Lambda Event
 * @description Detected SQL statement that is tainted by `event` object. This could lead 
 * to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 * @precision high
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import DataFlow::PathGraph
import TaintTracking

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() { 
    exists(Function f, Parameter p |
      f.getName() = "$HANDLER" and
      p = f.getParameter(0) and
      p.getName() = "event" and
      this = p
    )
  }
}

class MySQLExecuteSink extends DataFlow::Node {
  MySQLExecuteSink() {
    exists(CallNode call |
      call.getCallee().getQualifiedName().matches("mysql%.execute%") and
      this = call.getArgument(0)
    )
  }
}

class MyConfig extends TaintTracking::Configuration {
  MyConfig() { this = "MySQL_SQLi_via_Lambda_Event" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaEventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof MySQLExecuteSink }
}

from MyConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
