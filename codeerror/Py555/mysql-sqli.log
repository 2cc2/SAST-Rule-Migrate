Rule Content:
/**
 * @name MySQL SQL Injection from Lambda Event
 * @description Detects SQL statements tainted by AWS Lambda event object that could lead to SQL injection
 * @kind path-problem
 * @problem.severity warning
 * @id python/mysql-sqli
 */

import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph
import DataFlow::TaintTracking

class LambdaEventHandler extends DataFlow::ParameterNode {
  LambdaEventHandler() {
    exists(Function f |
      f.getName() matches "\\$HANDLER" and
      this.asParameter() = f.getAParameter(0) and
      this.asParameter().getName() = "event"
    )
  }

  override predicate hasLocationInfo(Location loc) { loc = this.getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asCfgNode() }
  override string toString() { result = "Lambda event parameter" }
  override VariableScope getScope() { result = this.asParameter().getScope() }
  override Variable asVariable() { result = this.asParameter().getVariable() }
  override ControlFlow::Node asCfgNode() { result = this.asParameter().getCfgNode() }
  override Location getLocation() { result = this.asParameter().getLocation() }
}

class MySqlExecuteCall extends DataFlow::ExprNode {
  MySqlExecuteCall() {
    exists(Call call |
      call = this.asExpr() and
      call.getFunc().getName() = ["execute", "executemany"] and
      call.getFunc().getQualifierName() = "mysql"
    )
  }

  override predicate hasLocationInfo(Location loc) { loc = this.getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asCfgNode() }
  override string toString() { result = "MySQL execute call" }
  override VariableScope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { result = none() }
  override ControlFlow::Node asCfgNode() { result = this.asExpr().getCfgNode() }
  override Location getLocation() { result = this.asExpr().getLocation() }
}

class MySqlTaintTrackingConfig extends TaintTracking::Configuration {
  MySqlTaintTrackingConfig() { this = "MySQLTaintTrackingConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof LambdaEventHandler
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof MySqlExecuteCall
  }
}

from MySqlTaintTrackingConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL " +
  "injection if the variable is user-controlled and not properly sanitized. Use " +
  "parameterized queries or prepared statements.",
  source, sink,
  "Potential SQL injection from user input"
