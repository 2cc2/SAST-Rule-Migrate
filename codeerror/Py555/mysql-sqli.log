Rule Content:
/**
 * @kind path-problem
 * @problem.severity warning
 * @id python/mysql-sqli
 * @name MySQL SQL injection from Lambda event
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection
 *              if the variable is user-controlled and not properly sanitized. Use parameterized queries
 *              or prepared statements.
 */

import python
import DataFlow::PathGraph

class LambdaEventHandler extends DataFlow::Node {
  LambdaEventHandler() {
    exists(FunctionValue f |
      f.getName() = "$HANDLER" and
      this.asParameter() = f.getParameter(0) and
      this.asParameter().getName() = "event"
    )
  }
}

class MySqlExecuteCall extends DataFlow::Node {
  MySqlExecuteCall() {
    exists(Call call |
      call.getTarget().getName() = ["execute", "executemany"] and
      call.getTarget().getQualifiedName().matches("mysql%.%") and
      this.asExpr() = call.getArg(0)
    ) or
    exists(Import imp |
      imp.getName() = "mysql" or
      imp.getName() = "mysql.cursors"
    )
  }
}

query predicate isSource(Node node) { node instanceof LambdaEventHandler }
query predicate isSink(Node node) { node instanceof MySqlExecuteCall }

from DataFlow::PathNode source, DataFlow::PathNode sink
where DataFlow::flowPath(source, sink)
select sink.getNode(), source.getNode(), sink.getNode(),
  "Potential SQL injection from Lambda event to MySQL execute call"
