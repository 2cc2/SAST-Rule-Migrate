Rule Content:
/**
 * @name MySQL SQL Injection from Lambda Event
 * @description Detected SQL statement that is tainted by `event` object. This could lead 
 *              to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/mysql-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Method lambda |
      lambda.getName() = "$HANDLER" and
      this.asParameter().getFunction() = lambda and
      this.asParameter().getName() = "event"
    )
  }
}

class MySQLExecuteSink extends DataFlow::Node {
  MySQLExecuteSink() {
    exists(CallNode call |
      call = this.asExpr() and
      call.getTarget().hasQualifiedName("mysql", "execute") or
      call.getTarget().hasQualifiedName("mysql", "executemany") and
      this = call.getArg(0)
    )
  }
}

class MySQLSQLiConfig extends TaintTracking::Configuration {
  MySQLSQLiConfig() { this = "MySQL SQL Injection from Lambda Event" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MySQLExecuteSink
  }
}

from MySQLSQLiConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  source, 
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized. Use parameterized queries or prepared statements."
