Rule Content:
/**
 * @name MySQL SQL Injection from Lambda Event
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL 
 *              injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/mysql-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class LambdaEventHandler extends DataFlow::Node {
  LambdaEventHandler() { 
    exists(Function f | 
      f.getName() = "$HANDLER" and 
      this.asParameter() = f.getParameter(0) and
      f.getParameter(0).getName() = "event"
    )
  }
}

class MySqlExecuteCall extends DataFlow::Node {
  MySqlExecuteCall() {
    exists(Call call |
      call = this.asExpr() and
      (
        call.getFunc().(Name).getId() = "execute" or
        call.getFunc().(Name).getId() = "executemany"
      ) and
      call.getFunc().getQualifier().(Name).getId() = "mysql" and
      exists(Import imp | imp.getName() = "mysql" or imp.getName() = "mysql.cursors")
    )
  }
}

class MySqlSqliConfig extends TaintTracking::Configuration {
  MySqlSqliConfig() { this = "MySQL SQL Injection from Lambda Event" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventHandler
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MySqlExecuteCall
  }
}

from MySqlSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized. Use parameterized queries or prepared statements."
