Rule Content:
/**
 * @name MySQL SQli via Lambda Event
 * @description Detected SQL statement that is tainted by `event` object in AWS Lambda handler.
 * @kind path-problem
 * @problem.severity warning
 * @id python/mysql-sqli-via-lambda-event
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

private class LambdaEventSource extends TaintTracking::TaintSource {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      f.getName() = "$HANDLER" and
      p = f.getParameter(0) and
      p.getName() = "event"
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p and this.getASource() = p)
  }

  override predicate asCfgNode(ControlFlow::CFGNode node) { node = this.getASource() }
  override string getLocation() { result = this.getASource().getLocation() }
  override ControlFlow::Block getBasicBlock() { result = this.getASource().getBasicBlock() }
  override string toString() { result = "Lambda event parameter" }
  override DataFlow::Scope getScope() { result = this.getASource().getScope() }
  override DataFlow::Variable asVariable() { result = this.getASource().asVariable() }
}

private class MySQLExecuteSink extends TaintTracking::TaintSink {
  MySQLExecuteSink() {
    exists(Call call |
      call.getCallee().getName().matches("%execute%") and
      call.getCallee().getModule().getName() = "mysql"
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call | sink.asExpr() = call.getArg(0) and this.getASink() = call)
  }

  override predicate asCfgNode(ControlFlow::CFGNode node) { node = this.getASink() }
  override string getLocation() { result = this.getASink().getLocation() }
  override ControlFlow::Block getBasicBlock() { result = this.getASink().getBasicBlock() }
  override string toString() { result = "MySQL execute call" }
  override DataFlow::Scope getScope() { result = this.getASink().getScope() }
  override DataFlow::Variable asVariable() { result = this.getASink().asVariable() }
}

class MySQLSQLiConfiguration extends TaintTracking::Configuration {
  MySQLSQLiConfiguration() { this = "MySQL SQLi via Lambda Event" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof MySQLExecuteSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, MySQLSQLiConfiguration cfg
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection from Lambda event to MySQL execute", source,
  "User-controlled input flows into SQL statement here"
