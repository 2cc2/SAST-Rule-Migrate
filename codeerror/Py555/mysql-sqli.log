/**
 * @name MySQL SQL Injection from Lambda Event
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/mysql-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.new.DataFlow

class LambdaEventHandler extends DataFlow::FunctionValue {
  LambdaEventHandler() {
    exists(string handlerPrefix | 
      this.getName().matches("%sHandler" % handlerPrefix) or this.getName().matches("%s_handler" % handlerPrefix)) and
    exists(Function f |
      f = this.getFunction() and
      exists(Parameter param |
        param = f.getAParameter(0) and param.getName() = "event"))
  }
}

class EventSource extends DataFlow::Source {
  EventSource() {
    exists(LambdaEventHandler lh | 
      this.asParameter() = lh.getFunction().getAParameter(0))
  }
}

class MySqlExecutionSink extends DataFlow::Sink {
  MySqlExecutionSink() {
    exists(Call call |
      call.getTarget().hasQualifiedName("mysql", ["execute", "executemany"]) and
      this = call.getArgument(0))
  }
}

class MySQLSQLIConfig extends TaintTracking::Configuration {
  MySQLSQLIConfig() { this = "MySQL SQL Injection from Lambda Event" }
  
  override predicate isSource(DataFlow::Source source) { source instanceof EventSource }
  
  override predicate isSink(DataFlow::Sink sink) { sink instanceof MySqlExecutionSink }

  override predicate isSanitizer(DataFlow::Sanitizer sanitizer) { none() }
}

from MySQLSQLIConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection."
