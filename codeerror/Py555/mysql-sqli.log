Rule Content:
/**
 * @name MySQL SQL Injection via Lambda Event
 * @description Detected SQL statement that is tainted by `event` object in AWS Lambda.
 * @kind path-problem
 * @problem.severity warning
 * @id py/mysql-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow

class LambdaEventSource extends DataFlow::ParameterNode {
  LambdaEventSource() {
    exists(Function f | 
      f.getAParameter() = this and 
      this.getPosition() = 0 and 
      f.getName().matches("%HANDLER%") and
      this.getName() = "event"
    )
  }
}

class MySQLExecuteCall extends DataFlow::Node {
  MySQLExecuteCall() {
    exists(Call call | 
      call.getTarget().getName().matches("execute%") and
      call.getTarget().getParentScope() instanceof Module and
      call.getTarget().getParentScope().getName() = "mysql" and
      this = call.getArg(0)
    )
  }
}

class MySQLTaintTrackingConfig extends TaintTracking::Configuration {
  MySQLTaintTrackingConfig() { this = "MySQLTaintTrackingConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MySQLExecuteCall
  }
}

from MySQLTaintTrackingConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "SQL statement is tainted by AWS Lambda event object " +
  "which could lead to SQL injection if not properly sanitized."
