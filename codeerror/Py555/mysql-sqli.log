Rule Content:
/**
 * @name MySQL SQL Injection from Lambda Event
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection
 *              if the variable is user-controlled and not properly sanitized. Use parameterized queries
 *              or prepared statements.
 * @kind path-problem
 * @problem.severity warning
 * @id python/mysql-sqli
 */
import python
import semmle.python.dataflow.new.DataFlow

class LambdaEventHandler extends DataFlow::Node {
  LambdaEventHandler() {
    exists(Function f, Parameter p |
      f.getName() = "$HANDLER" and
      p = f.getAParameter() and
      p.getName() = "event" and
      this.asExpr() = p.getAnAccess()
    )
  }
}

class MySqlExecuteCall extends DataFlow::Node {
  MySqlExecuteCall() {
    exists(Call call, Name name |
      call.getCalled() = name and
      (name.getId() = "execute" or name.getId() = "executemany") and
      name.getImportedName() = "mysql" and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class MySqlPathConfig extends DataFlow::Configuration {
  MySqlPathConfig() { this = "MySqlPathConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventHandler
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MySqlExecuteCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from MySqlPathConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential SQL injection from AWS Lambda event parameter", source, sink,
  "This SQL query is constructed from user-controlled input that may lead to SQL injection."
