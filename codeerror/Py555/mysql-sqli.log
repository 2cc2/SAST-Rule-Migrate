Rule Content:
/**
 * @name MySQL SQL Injection from Lambda Event
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection
 *              if the variable is user-controlled and not properly sanitized. Use parameterized queries
 *              or prepared statements.
 * @kind path-problem
 * @problem.severity warning
 * @id python/mysql-sqli
 */

import python
import semmle.python.security.SqlInjection
import DataFlow::PathGraph

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Method m, Parameter p |
      m.getName() = "$HANDLER" and
      p = m.getParameter(0) and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class MySQLExecuteSink extends DataFlow::Node {
  MySQLExecuteSink() {
    exists(Call call |
      call.getTarget().hasQualifiedName("mysql", "execute") or
      call.getTarget().hasQualifiedName("mysql", "executemany") and
      this.asExpr() = call.getArg(0)
    )
  }
}

class MySQLSQLIConfig extends TaintTracking::Configuration {
  MySQLSQLIConfig() { this = "MySQLSQLIFromLambdaEvent" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MySQLExecuteSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from MySQLSQLIConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection."
