Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. 
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/asyncpg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class AsyncPgSqlInjectionConfig extends TaintTracking::Configuration {
  AsyncPgSqlInjectionConfig() { this = "AsyncPgSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asLocalSourceVariable().getName().matches("%USERINPUT%")
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall call |
      call.getMethod().getName() in ["fetch", "fetchrow", "fetchval", "execute", "executemany", "prepare", "cursor", "copy_from_query"] and
      call.getQualifier().getType().hasName("asyncpg.connection.Connection") and
      sink.asExpr() = call.getArgument(0) and
      not call.getArgument(0).getType().isLiteralType()
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodCall call |
      call.getMethod().getName() in ["fetch", "fetchrow", "fetchval", "execute", "executemany", "prepare"] and
      call.getQualifier().getType().hasName("asyncpg.connection.Connection") and
      node.asExpr() = call
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Handle variable concatenation propagation
    exists(DataFlow::ReadNode read, DataFlow::WriteNode write |
      write.getRhs() = node1.asDefiningDefinition() and
      read.getVariable() = write.getVariable() and
      node2.asDefiningDefinition() = read
    )
  }
}

from AsyncPgSqlInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection vulnerability due to string concatenation with user input", 
  source, "User input flows here"
