Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 * @id python/asyncpg-sqli
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-089
 */

import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow
import semmle.python.Concepts

class AsyncPgSqlExec extends DataFlow::Node {
  AsyncPgSqlExec() {
    exists(Method m, string methodName |
      m.getName() = methodName and
      methodName.matches("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      m.getACall() = this.asExpr() and
      m.getDeclaringType().hasQualifiedName("asyncpg", "Connection")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(string arg |
      sink = this.getArgument(0) and
      not sink.getType().toString() = "LITERAL"
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Variable v |
      v.getName().matches(".*USERINPUT.*") and
      this.asVariable() = v
    )
  }
}

class AsyncPgSanitizer extends DataFlow::Node {
  AsyncPgSanitizer() {
    exists(Method m, string methodName |
      m.getName() = methodName and
      methodName.matches("fetch|fetchrow|fetchval|execute|executemany|prepare") and
      m.getACall() = this.asExpr() and
      m.getDeclaringType().hasQualifiedName("asyncpg", "Connection")
    )
  }
}

class AsyncPgSqliConfiguration extends TaintTracking::Configuration {
  AsyncPgSqliConfiguration() { this = "AsyncPgSqliConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof AsyncPgSqlExec }

  override predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof AsyncPgSanitizer }
}

from AsyncPgSqliConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected string concatenation with a non-literal variable in asyncpg SQL statement. $@",
  source.getNode(), "User input"
