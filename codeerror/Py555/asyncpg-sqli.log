Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. 
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class AsyncPgSqlSource extends DataFlow::Node {
  AsyncPgSqlSource() {
    exists(string name | getName(name) | name.matches("%USERINPUT%"))
  }
}

class AsyncPgSqlSink extends DataFlow::Node {
  AsyncPgSqlSink() {
    exists(CallNode call, string methodName | 
      methodName.matches("%fetch%") or
      methodName.matches("%fetchrow%") or
      methodName.matches("%fetchval%") or
      methodName.matches("%execute%") or
      methodName.matches("%executemany%") or
      methodName.matches("%prepare%") or
      methodName.matches("%cursor%") or
      methodName.matches("%copyfromquery%") |
      call = API::methodCall("asyncpg", "Connection", methodName, _) and
      call.getArgument(0) = this and
      not this instanceof Literal
    )
  }
}

class AsyncPgSqlSanitizer extends DataFlow::Node {
  AsyncPgSqlSanitizer() {
    exists(CallNode call, string methodName |
      methodName.matches("%fetch%") or
      methodName.matches("%fetchrow%") or
      methodName.matches("%fetchval%") or
      methodName.matches("%execute%") or
      methodName.matches("%executemany%") or
      methodName.matches("%prepare%") |
      call = API::methodCall("asyncpg", "Connection", methodName, _) and
      this = call.getArgument(0)
    )
  }
}

class AsyncPgSqlConfig extends TaintTracking::Configuration {
  AsyncPgSqlConfig() { this = "AsyncPgSqlConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof AsyncPgSqlSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof AsyncPgSqlSink 
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof AsyncPgSqlSanitizer
  }
}

from AsyncPgSqlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection via string concatenation in asyncpg query", source,
  "The SQL query is constructed with user input $@ which could lead to injection.",
  source.getNode(), "user input here"
