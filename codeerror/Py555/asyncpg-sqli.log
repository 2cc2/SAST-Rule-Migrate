Rule Content:
/**
 * @name Asyncpg SQL injection
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */

import python
import DataFlow::PathGraph
import DataFlow::TaintTracking

private class AsyncpgConfig extends TaintTracking::Configuration {
  AsyncpgConfig() { this = "AsyncpgTaintTracking" }

  override predicate isSource(DataFlow::Node source) {
    exists(DataFlow::LocalSourceNode localSource |
      localSource = source.asLocalSource() and
      localSource.getNode().getName().matches("%USERINPUT%")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DataFlow::MethodCallNode call |
      call = sink.asExpr() and
      call.getMethod().getPackage().getName() = "asyncpg" and
      call.getMethod().getType().getName() = "Connection" and
      call.getMethod().getName().matches("fetch%|execute%|prepare%|copy%") and
      not call.getArgument(0).getValue() instanceof StringLiteral
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(DataFlow::MethodCallNode call |
      call = sanitizer.asExpr() and
      call.getMethod().getPackage().getName() = "asyncpg" and
      call.getMethod().getType().getName() = "Connection" and
      call.getMethod().getName().matches("fetch%|execute%|prepare%")
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, AsyncpgConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected string concatenation with a non-literal variable in a asyncpg SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
