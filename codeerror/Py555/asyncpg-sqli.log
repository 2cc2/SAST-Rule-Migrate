/**
 * @name asyncpg-sqli
 * @kind problem
 * @id python/asyncpg-sqli
 * @severity warning
 */
     
import python
import semmle.python.security.dataflow.TaintTracking
import DataFlow::PathGraph

class AsyncPgSqlExec extends DataFlow::CallCfgNode {
  AsyncPgSqlExec() {
    exists(Method m |
      m.getName().matches("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      this.getACall().getMethod() = m and
      m.getDeclaringType().getQualifiedName() = "asyncpg.Connection"
    )
  }

  override string getTarget() { result = this.getACall().getMethod().getName() }
}

class UserInputSource extends DataFlow::Configuration::TaintSource {
  UserInputSource() {
    exists(Variable v |
      v.getName().matches(".*USERINPUT.*") and
      this.asVariable() = v
    )
  }

  override predicate isCfgNode() { this instanceof DataFlow::AstNode }
  override Location getLocation() { result = this.getLocation() }
}

class AsyncPgSanitizer extends DataFlow::CallCfgNode {
  AsyncPgSanitizer() {
    exists(Method m |
      m.getName().matches("fetch|fetchrow|fetchval|execute|executemany|prepare") and
      this.getACall().getMethod() = m and
      m.getDeclaringType().getQualifiedName() = "asyncpg.Connection"
    )
  }
}

class AsyncPgSqliConfiguration extends TaintTracking::Configuration {
  AsyncPgSqliConfiguration() { this = "AsyncPgSqliConfiguration" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof UserInputSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof AsyncPgSqlExec and
    not sink.getACall().getArg(0).getTypeAnnotation().toString() = "LITERAL"
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof AsyncPgSanitizer
  }
}

