Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class AsyncPGSqlQuery extends TaintTracking::Configuration {
  AsyncPGSqlQuery() { this = "AsyncPGSqlQuery" }

  override predicate isSource(TaintTracking::TaintSource source) {
    exists(LocalVariable var |
      source.asVariable().getScope().getAPrimaryQlClass() = var and
      regexpMatches(var.getName(), ".*USERINPUT.*")
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(MethodCall call |
      sink.asExpr() = call.getExpr() and
      call.getMethod().getName().matches("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      call.getCaller().getType().getName() = "Connection" and
      call.getCaller().getPackage().getName() = "asyncpg" and
      not call.getArgument(0).getType() instanceof LiteralType
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(MethodCall call |
      sanitizer.asExpr() = call.getExpr() and
      call.getMethod().getName().matches("fetch|fetchrow|fetchval|execute|executemany|prepare") and
      call.getCaller().getType().getName() = "Connection" and
      call.getCaller().getPackage().getName() = "asyncpg"
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::MethodCallNode call |
      call = node1.asExpr() and
      node2.asParameter() = call.getArgument(0).asParameter()
    )
  }
}

from AsyncPGSqlQuery cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
================================================================================
