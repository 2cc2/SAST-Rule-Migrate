Rule Content:
/**
 * @name Asyncpg SQL Injection
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.TaintTracking
import semmle.python.dataflow.new.RemoteFlowSources

class AsyncpgSqlInjectionConfig extends TaintTracking::Configuration {
  AsyncpgSqlInjectionConfig() { this = "Asyncpg SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    exists(string name |
      source.asLocalSource().getName().matches("%USERINPUT%") and
      name = source.asLocalSource().getName()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCallNode call, Method method |
      call = sink.asExpr().(MethodCallNode) and
      method = call.getMethod() and
      method.getDeclaringType().getName() = "Connection" and
      method.getPackage().getName() = "asyncpg" and
      method.getName().matches("fetch%") or
      method.getName().matches("execute%") or
      method.getName() = "prepare" or
      method.getName() = "cursor" or
      method.getName() = "copyfromquery" and
      call.getArgument(0) = sink.asExpr() and
      not sink.asExpr().(StringLiteral).exists()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodCallNode call, Method method |
      call = sanitizer.asExpr().(MethodCallNode) and
      method = call.getMethod() and
      method.getDeclaringType().getName() = "Connection" and
      method.getPackage().getName() = "asyncpg" and
      (method.getName().matches("fetch%") or
       method.getName().matches("execute%") or
       method.getName() = "prepare")
    )
  }
}

from AsyncpgSqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential SQL injection vulnerability in asyncpg due to string concatenation with non-literal variable", source,
  "User input reaches this SQL query execution point without proper sanitization."
