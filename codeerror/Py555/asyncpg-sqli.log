Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. 
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/asyncpg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class AsyncPgSqlExec extends DataFlow::CallNode {
  AsyncPgSqlExec() {
    exists(string methodName, string packageName, string typeName |
      this.getTarget().hasQualifiedName(packageName, typeName, methodName) and
      packageName = "asyncpg" and
      typeName = "Connection" and
      methodName.matches("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery")
    )
  }

  int getSinkArgNum() { result = 0 }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(string varName | this.asVar().getName().matches("%USERINPUT%") and this.asLocal())
  }
}

class AsyncPgSanitizer extends DataFlow::CallNode {
  AsyncPgSanitizer() {
    exists(string methodName, string packageName, string typeName |
      this.getTarget().hasQualifiedName(packageName, typeName, methodName) and
      packageName = "asyncpg" and
      typeName = "Connection" and
      methodName.matches("fetch|fetchrow|fetchval|execute|executemany|prepare")
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "asyncpg_sqli_config" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(AsyncPgSqlExec call |
      call.getArgument(sink.getCall().getArgumentNumber()) = sink and
      not sink.getType().hasName("LITERAL")
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.getEnclosingCallable() instanceof AsyncPgSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    pred.asArg() = succ.asParameter()
  }
}

