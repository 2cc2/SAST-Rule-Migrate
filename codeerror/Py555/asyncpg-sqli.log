Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */

import semmle.python.DataFlow
import semmle.python.security.TaintTracking

class AsyncpgConfig extends TaintTracking::Configuration {
  AsyncpgConfig() { this = "AsyncpgSqlInjection" }
  
  override predicate isSource(DataFlow::Node source) {
    // Match variables containing "USERINPUT" in their name
    exists(Variable v | 
      source.asExpr() = v.getAnAccess() and
      v.getName().regexpMatch(".*USERINPUT.*")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // Match asyncpg database operations with non-literal arguments
    exists(MethodCall call |
      call.getMethod().getQualifiedName().regexpMatch("asyncpg\\.Connection\\.(fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery)") and
      sink.asExpr() = call.getArgument(0) and
      not call.getArgument(0).getStringValue().isLiteral()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Parameterized queries are safe
    exists(MethodCall call |
      call.getMethod().getQualifiedName().regexpMatch("asyncpg\\.Connection\\.(fetch|fetchrow|fetchval|execute|executemany|prepare)") and
      sanitizer.asExpr() = call
    )
  }
}

