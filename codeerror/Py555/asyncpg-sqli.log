Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */

import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking as TaintTracking

private class AsyncPgSqlSource extends TaintTracking::Source {
  AsyncPgSqlSource() {
    exists(Python::Variable v |
      v.getName().matches("%USERINPUT%") and
      result = v
    )
  }

  override predicate isSource(TaintTracking::SourceNode node) {
    node instanceof AsyncPgSqlSource
  }

  override string getSourceType() { "User input" }

  override Node asCfgNode() { none() }
  override Location getLocation() { none() }
  override BasicBlock getBasicBlock() { none() }
  override string toString() { "AsyncPgSqlSource" }
  override Scope getScope() { none() }
  override Variable asVariable() { result.asVariable() }
}

private class AsyncPgSqlSink extends TaintTracking::Sink {
  AsyncPgSqlSink() {
    exists(API::CallNode call |
      call.getAMethodCall("asyncpg", "Connection", ["fetch", "fetchrow", "fetchval", "execute", "executemany", "prepare", "cursor", "copyfromquery"]) and
      not call.getAnArgument(0) instanceof Python::StringLiteral and
      result = call.getAnArgument(0)
    )
  }

  override predicate isSink(TaintTracking::SinkNode node) {
    node instanceof AsyncPgSqlSink
  }

  override string getSinkType() { "asyncpg SQL execution" }

  override Node asCfgNode() { none() }
  override Location getLocation() { none() }
  override BasicBlock getBasicBlock() { none() }
  override string toString() { "AsyncPgSqlSink" }
  override Scope getScope() { none() }
  override Variable asVariable() { none() }
}

private class AsyncPgSqlSanitizer extends TaintTracking::Sanitizer {
  AsyncPgSqlSanitizer() {
    exists(API::CallNode call |
      call.getAMethodCall("asyncpg", "Connection", ["fetch", "fetchrow", "fetchval", "execute", "executemany", "prepare"]) and
      result = call.getAnArgument(0)
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof AsyncPgSqlSanitizer
  }

  override Node asCfgNode() { none() }
  override Location getLocation() { none() }
  override BasicBlock getBasicBlock() { none() }
  override string toString() { "AsyncPgSqlSanitizer" }
  override Scope getScope() { none() }
  override Variable asVariable() { none() }
}

from AsyncPgSqlSource source, AsyncPgSqlSink sink, TaintTracking::PathNode sourceNode, 
  TaintTracking::PathNode sinkNode
where
  TaintTracking::localTaint(sourceNode, sinkNode)
select sinkNode, "Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
