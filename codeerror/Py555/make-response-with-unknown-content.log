xcpgir_version: "1.0"
rule:
  id: make-response-with-unknown-content
  kind: pattern
  severity: WARNING
  message: >-
    Be careful with `flask.make_response()`. If this response is rendered onto a webpage,
    this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()`
    will not autoescape HTML. If you are rendering HTML, write your HTML in a template
    file and use `flask.render_template()` which will take care of escaping.
    If you are returning data from an API, consider using `flask.jsonify()`.

sinks:
  - id: UNSAFE_RESPONSE
    match:
      node: CALL
      api:
        package: flask
        type: flask
        method: make_response
      where:
        - op: not
          conditions:
            - op: eq
              left: arg[0].value
              right: "..."
            - op: regex
              left: arg[0].value
              right: '\{"\."*"\."*"\}'
            - op: eq
              left: arg[0].methodFullName
              right: flask.redirect
            - op: eq
              left: arg[0].methodFullName
              right: flask.render_template
            - op: eq
              left: arg[0].methodFullName
              right: flask.jsonify
            - op: eq
              left: arg[0].methodFullName
              right: json.dumps
            - op: eq
              left: arg[0].methodFullName
              right: flask.render_template@previous
            - op: eq
              left: arg[0].methodFullName
              right: flask.jsonify@previous
            - op: eq
              left: arg[0].methodFullName
              right: json.dumps@previous

sanitizers:
  - id: SAFE_RENDER
    match:
      node: CALL
      api:
        package: flask
        type: flask
        method: render_template
    effect: neutralize
    scope: { sinks: [UNSAFE_RESPONSE] }

  - id: SAFE_JSONIFY
    match:
      node: CALL
      api:
        package: flask
        type: flask
        method: jsonify
    effect: neutralize
    scope: { sinks: [UNSAFE_RESPONSE] }

  - id: SAFE_JSON_DUMPS
    match:
      node: CALL
      api:
        package: json
        type: json
        method: dumps
    effect: neutralize
    scope: { sinks: [UNSAFE_RESPONSE] }

propagations:
  - id: RESPONSE_ARG_TO_PARAM
    edge: arg->param
    kind: taint
