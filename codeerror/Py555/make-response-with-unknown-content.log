Rule Content:
/**
 * @name Unsafe Flask Response Construction
 * @description Detects unsafe usage of flask.make_response(), warns about missing autoescaping
 * @kind problem
 * @problem.severity warning
 * @id python/flask/unsafe-response
 * @tags security
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class FlaskMakeResponseCall extends Call {
  FlaskMakeResponseCall() {
    exists(Module flask |
      flask.getName() = "flask" and
      this.getQualifier().(Name).getId() = flask.getQualifiedName() and
      this.getMember() = "make_response"
    )
  }
}

class UnsafeResponseSink extends DataFlow::Node {
  UnsafeResponseSink() {
    exists(FlaskMakeResponseCall call |
      this.asExpr() = call.getArg(0).getExpr() and
      not (
        exists(StringLiteral s | s = this.getExpr()) or
        exists(DictExpr d | d = this.getExpr()) or
        exists(Call c |
          c = this.getExpr() and (
            c.getMember() = "redirect" or
            c.getMember() = "render_template" or
            c.getMember() = "jsonify" or
            (c.getQualifier().(Name).getId() = "json" and c.getMember() = "dumps")
          )
        )
      )
    )
  }
}

class SafeRenderSanitizer extends DataFlow::Node {
  SafeRenderSanitizer() {
    exists(Call c |
      c.getQualifier().(Name).getId() = "flask" and
      c.getMember() = "render_template" and
      this.asExpr() = c
    )
  }
}

class SafeJsonifySanitizer extends DataFlow::Node {
  SafeJsonifySanitizer() {
    exists(Call c |
      c.getQualifier().(Name).getId() = "flask" and
      c.getMember() = "jsonify" and
      this.asExpr() = c
    )
  }
}

class SafeJsonDumpsSanitizer extends DataFlow::Node {
  SafeJsonDumpsSanitizer() {
    exists(Call c |
      c.getQualifier().(Name).getId() = "json" and
      c.getMember() = "dumps" and
      this.asExpr() = c
    )
  }
}

class ResponseArgumentToParameter extends TaintTracking::Configuration {
  ResponseArgumentToParameter() { this = "ResponseArgumentToParameter" }

  override predicate isSource(DataFlow::Node source) { none() }

  override predicate isSink(DataFlow::Node sink) { sink instanceof UnsafeResponseSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeRenderSanitizer or
    sanitizer instanceof SafeJsonifySanitizer or
    sanitizer instanceof SafeJsonDumpsSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Parameter p | DataFlow::parameterNode(p) = node2 and node1.asExpr() = p.getDefaultValue())
  }
}

from FlaskMakeResponseCall call, UnsafeResponseSink sink
where TaintTracking::localTaint(DataFlow::exprNode(call.getArg(0)), sink, ResponseArgumentToParameter())
select call,
  "Be careful with `flask.make_response()`. If this response is rendered onto a webpage, " +
  "this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` " +
  "will not autoescape HTML. Consider using `flask.render_template()` or `flask.jsonify()`.",
  call.getLocation()
