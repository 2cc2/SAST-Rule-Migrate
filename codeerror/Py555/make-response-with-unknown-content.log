Rule Content:
/**
 * @name make-response-with-unknown-content
 * @description Be careful with `flask.make_response()`. If this response is rendered onto a webpage,
 * this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()`
 * will not autoescape HTML. If you are rendering HTML, write your HTML in a template
 * file and use `flask.render_template()` which will take care of escaping.
 * If you are returning data from an API, consider using `flask.jsonify()`.
 * @kind problem
 * @problem.severity warning
 * @id python/xss/make-response-with-unknown-content
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class FlaskMakeResponseCall extends DataFlow::CallNode {
  FlaskMakeResponseCall() {
    this.getTarget().hasGlobalName("make_response") and
    this.getTarget().getModule().getName() = "flask"
  }
}

class SafeFunctions extends DataFlow::CallNode {
  SafeFunctions() {
    (this.getTarget().hasGlobalName("render_template") and this.getTarget().getModule().getName() = "flask") or
    (this.getTarget().hasGlobalName("jsonify") and this.getTarget().getModule().getName() = "flask") or
    (this.getTarget().hasGlobalName("dumps") and this.getTarget().getModule().getName() = "json") or
    (this.getTarget().hasGlobalName("redirect") and this.getTarget().getModule().getName() = "flask")
  }
}

class MakeResponseWithUnknownContent extends DataFlow::Configuration {
  MakeResponseWithUnknownContent() { this = "MakeResponseWithUnknownContent" }

  override predicate isSource(DataFlow::Node source) {
    exists(FlaskMakeResponseCall call |
      source.asExpr() = call.getArg(0) and
      not exists(SafeFunctions safe | safe = call.getArg(0))
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asExpr() instanceof FlaskMakeResponseCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof SafeFunctions
  }
}

from MakeResponseWithUnknownContent cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential XSS vulnerability from unescaped flask.make_response() call"
