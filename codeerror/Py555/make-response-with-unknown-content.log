Rule Content:
import python

class FlaskMakeResponseCall extends Call {
  FlaskMakeResponseCall() {
    this.getTarget().hasGlobalName("flask") and
    this.getTarget().getName() = "make_response"
  }
}

class UnsafeResponseSink extends TaintSink {
  UnsafeResponseSink() {
    exists(FlaskMakeResponseCall call |
      this.asExpr() = call.getArg(0).getExpr() and
      not (
        call.getArg(0).getExpr() instanceof StringLiteral or
        call.getArg(0).getExpr() instanceof DictDisplay or
        call.getArg(0).getExpr().(Call).getTarget().hasQualifiedName("flask", "redirect") or
        call.getArg(0).getExpr().(Call).getTarget().hasQualifiedName("flask", "render_template") or
        call.getArg(0).getExpr().(Call).getTarget().hasQualifiedName("flask", "jsonify") or
        call.getArg(0).getExpr().(Call).getTarget().hasQualifiedName("json", "dumps")
      )
    )
  }
}

class SafeRenderSanitizer extends TaintSanitizer {
  SafeRenderSanitizer() {
    exists(Call call |
      call.getTarget().hasQualifiedName("flask", "render_template") and
      this.asExpr() = call
    )
  }
}

class SafeJsonifySanitizer extends TaintSanitizer {
  SafeJsonifySanitizer() {
    exists(Call call |
      call.getTarget().hasQualifiedName("flask", "jsonify") and
      this.asExpr() = call
    )
  }
}

class SafeJsonDumpsSanitizer extends TaintSanitizer {
  SafeJsonDumpsSanitizer() {
    exists(Call call |
      call.getTarget().hasQualifiedName("json", "dumps") and
      this.asExpr() = call
    )
  }
}

class ResponseArgumentToParameter extends TaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::ArgumentNode arg, ParameterNode param |
      pred.asExpr() = arg.getExpr() and
      pred.asDef() = arg and
      succ.asDef() = param
    )
  }
}

from UnsafeResponseSink sink, DataFlow::Node source
where TaintFlow::localTaint(source, sink, ResponseArgumentToParameter) and
      not SafeRenderSanitizer().blocksSanitizer(source, sink) and
      not SafeJsonifySanitizer().blocksSanitizer(source, sink) and
      not SafeJsonDumpsSanitizer().blocksSanitizer(source, sink)
select sink, "Be careful with flask.make_response(). If this response is rendered onto a webpage, " +
  "this could create a cross-site scripting (XSS) vulnerability. flask.make_response() will not " +
  "autoescape HTML. If you are rendering HTML, write your HTML in a template file and use " +
  "flask.render_template() which will take care of escaping. If you are returning data from an " +
  "API, consider using flask.jsonify()."
