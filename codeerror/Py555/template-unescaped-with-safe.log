Rule Content:
/**
 * @name Flask XSS in template with unsafe filter
 * @description Detects Flask templates where autoescaping is disabled with '| safe' filter,
 *              potentially leading to XSS vulnerabilities if user-controlled data is rendered.
 * @kind path-problem
 * @problem.severity warning
 * @id python/flask/xss-template-unescaped-with-safe
 */

import python
import semmle.python.security.XSS
import semmle.python.web.flask.Templating
import semmle.python.Concepts
import DataFlow::PathGraph

class SafeFilterConfig extends DataFlow::Configuration {
  SafeFilterConfig() { this = "SafeFilterConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(string templateContent |
      source.asExpr() instanceof StringLiteral and
      templateContent = source.asExpr().(StringLiteral).getText() and
      regexpMatch("\\{\\{.*?\\|\\s*safe(\\s*\\}\\})?", templateContent)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall renderCall |
      renderCall = sink.asExpr() and
      renderCall.getMethodName() = "render_template" and
      renderCall.getQualifier().getType().hasName("flask.templating") and
      (sink = renderCall.getArgument(0) or sink = renderCall.getArgument(1))
    )
  }
}

from SafeFilterConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected Flask template with autoescaping disabled via '| safe' filter. " +
  "This allows raw HTML rendering and may lead to XSS if user data is included.",
  source, "Unsafe template content here"
