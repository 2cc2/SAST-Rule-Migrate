/**
 * @name Flask XSS Template Unescaped With Safe Filter
 * @description Detected a segment of a Flask template where autoescaping is explicitly disabled with '| safe' filter.
 *              This allows rendering of raw HTML in this segment. Ensure no user data is rendered here,
 *              otherwise this is a cross-site scripting (XSS) vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id python/flask/xss-template-unescaped-with-safe
 */

import python
import semmle.python.web.flask.TemplateFiles
import DataFlow::PathGraph

class SafeFilterInTemplate extends TemplateExpr::Range {
  SafeFilterInTemplate() {
    exists(string content |
      this.getValueText() = content and
      content.regexpMatch("\\{\\{.*?\\|\\s*safe(\\s*\\}\\})?")
    )
  }
}

from SafeFilterInTemplate expr
select expr, "Detected use of '| safe' filter in Flask template which disables autoescaping. " +
    "This could lead to XSS if user-controlled data is rendered here.", expr,
    "Flask template with disabled autoescaping"
