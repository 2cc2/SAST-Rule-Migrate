Rule Content:
/**
 * @name Flask XSS in template with safe filter
 * @kind problem
 * @id flask.xss-template-unescaped-with-safe
 * @severity warning
 * @description Detected a segment of a Flask template where autoescaping is explicitly
 *              disabled with '| safe' filter. This allows rendering of raw HTML in this
 *              segment. Ensure no user data is rendered here, otherwise this is a
 *              cross-site scripting (XSS) vulnerability.
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.web.flask

class SafeFilter extends DataFlow::Node {
  SafeFilter() {
    exists(string template |
      this = template.asExpr() and
      matches(template.getValue(), /\{\{.*?\|\s*safe(\s*}})?/)
    )
  }
}

class FlaskRenderTemplate extends DataFlow::Node {
  FlaskRenderTemplate() {
    exists(Call renderCall |
      renderCall = global("flask").getMember("templating").getMember("render_template").getACall() and
      (this = renderCall.getArg(0) or this = renderCall.getArg(1))
    )
  }
}

class SafeFilterToRenderTemplateConfig extends DataFlow::Configuration {
  SafeFilterToRenderTemplateConfig() { this = "SafeFilterToRenderTemplateConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SafeFilter }

  override predicate isSink(DataFlow::Node sink) { sink instanceof FlaskRenderTemplate }
}

from DataFlow::Node source, DataFlow::Node sink
where
  any(SafeFilterToRenderTemplateConfig config).hasFlow(source, sink)
select sink, "Potential XSS vulnerability from unescaped template content with safe filter"
