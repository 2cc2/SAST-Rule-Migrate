/**
 * @name eval-injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id py/eval-injection
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class FlaskRequestSource extends DataFlow::ExprNode {
  FlaskRequestSource() {
    exists(MethodCall ma |
      ma.getTarget().(Method).getName() matches "^get|__getitem__|__call__$" and
      ma.getTarget().(Method).getDeclaringType().getName() = "request" and
      ma.getTarget().(Method).getDeclaringType().getAPackageName() = "flask" and
      this.asExpr() = ma
    )
  }
}

class RouteParameterSource extends DataFlow::ParameterNode {
  RouteParameterSource() {
    this.getName().matches(".*ROUTEVAR.*") and
    this.asParameter().getType().getName() = "str"
  }
}

class EvalSink extends DataFlow::ExprNode {
  EvalSink() {
    exists(MethodCall call |
      call.getCallee().getName() = "eval" and
      call.getCallee().getDeclaringType().getName() = "builtins" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2) or
    exists(DataFlow::CallNode call |
      call.getAnArg() = node1.asExpr() and
      call.getResult() = node2.asExpr()
    )
  }
}

from EvalInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected user data flowing into eval. This is code injection and should be avoided."
