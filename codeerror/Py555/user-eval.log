/**
 * @name Eval Injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/eval-injection
 */

import python
import DataFlow::PathGraph
import semmle.python.web.flask.RequestArguments

class FlaskRequestSource extends DataFlow::SourceNode {
  FlaskRequestSource() {
    exists(MethodAccess ma, Callable c |
      ma.getQualifier().(Class).getName() = "Flask" and
      c = ma.getCallee() and
      c.getName().matches("get|__getitem__|__call__") and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

class RouteParamSource extends DataFlow::SourceNode {
  RouteParamSource() {
    exists(FunctionParameter p |
      p.getName().matches(".*ROUTEVAR.*") and
      this.asExpr() = p.getAnAccess()
    )
  }
}

class EvalSink extends DataFlow::SinkNode {
  EvalSink() {
    exists(Call call |
      call.getFunc().(Name).getId() = "eval" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::SourceNode source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::SinkNode sink) {
    sink instanceof EvalSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, EvalInjectionConfig config
where config.hasFlowPath(source, sink)
select sink, "Potential eval injection from user input", source, "User input originates here"
