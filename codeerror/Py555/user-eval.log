Rule Content:
/**
 * @name eval-injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id py/eval-injection
 */

import python
import python.dataflow.ExternalFlow
import python.web.Flask
import DataFlow
import python.MethodAccess


class FlaskRequestInput extends DataFlow::Node {
  FlaskRequestInput() {
    exists(MethodAccess ma |
      ma.getMethod().getType().hasQualifiedName("flask", "request") and
      (
        ma.getMethod().getName() = "get" or
        ma.getMethod().getName() = "__getitem__" or
        ma.getMethod().getName() = "__call__"
      ) and
      this.asExpr() = ma
    )
  }
}


class RouteParameterInput extends DataFlow::Node {
  RouteParameterInput() {
    exists(Parameter p |
      regexMatches('\\$ROUTEVAR', p.getName()) and
      this.asExpr() = p.getAnArg()
    )
  }
}


class EvalCall extends DataFlow::Node {
  EvalCall() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("builtins", "eval") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}


query predicate isSource(DataFlow::Node source) {
  source instanceof FlaskRequestInput or
  source instanceof RouteParameterInput
}


query predicate isSink(DataFlow::Node sink) {
  sink instanceof EvalCall
}


from DataFlow::PathNode source, DataFlow::PathNode sink
where DataFlow::flowPath(source, sink) and
  isSource(source.getNode()) and
  isSink(sink.getNode())
select sink, "Detected user data flowing into eval. This is code injection and should be avoided.", 
  source, "User input originates from here"
