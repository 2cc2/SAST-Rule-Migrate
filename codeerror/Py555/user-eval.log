/**
 * @id eval-injection
 * @kind path-problem
 * @severity ERROR
 * @name Dangerous eval() usage with user input
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.WebFlask

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(CallNode call |
      call.getFunc().(NameNode).getId() = "eval" and
      call.getAPrimaryQlClass() = "builtins.eval" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class FlaskSource extends DataFlow::Node {
  FlaskSource() {
    exists(MethodCallNode call |
      call.getDispatchKind() = "standard" and
      call.getReceiver().getType().(RefType).getQualifiedName() = "flask.request" and
      call.getMethodName().matches("%get%") and
      this.asExpr() = call
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(FunctionDef f, Parameter p |
      p = f.getAParameter() and
      p.getName().matches("%ROUTEVAR%") and
      this.asExpr() = p.getAnAccess()
    )
  }
}

class TaintTrackingConfig extends TaintTracking::Configuration {
  TaintTrackingConfig() { this = "EvalInjectionTaintTracking" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }
}

from TaintTrackingConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "User input flows into eval(), making code injection possible", source,
  "This user input comes from $@", source, source.toString()
