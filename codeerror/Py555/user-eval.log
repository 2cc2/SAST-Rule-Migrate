/**
 * @name Eval Injection Vulnerability
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind taint
 * @problem.severity error
 * @id py/eval-injection
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Flask

class FlaskRequestSource extends TaintSource::Range {
  FlaskRequestSource() {
    exists(DataFlow::CallNode call |
      call.getTarget().(Function).getQualifiedName().matches("flask.request.%") and
      (call.getTarget().getName() = "get" or
       call.getTarget().getName() = "__getitem__" or
       call.getTarget().getName() = "__call__")
    )
  }
}

class RouteParamSource extends TaintSource::Range {
  RouteParamSource() {
    exists(MethodParameter p |
      p.getType().toString().matches("%ROUTEVAR%")
    )
  }
}

class EvalSink extends TaintSink::Range {
  EvalSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().(Function).getQualifiedName() = "builtins.eval" and
      call.getArg(0) = this.asExpr()
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "EvalInjectionConfig" }

  override predicate isSource(TaintSource::Range source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(TaintSink::Range sink) {
    sink instanceof EvalSink
  }
}
