/**
 * @name Eval Injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/eval-injection
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.ApiGraphs
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(API::ModuleImport flask | flask.getName() = "flask" |
      this.asExpr() = any(flask.getAMemberCall("request")).getAMethodCall(["get", "__getitem__", "__call__"])
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Function::Parameter p |
      p.getParentScope() instanceof Function and
      p.getName().matches("\\$ROUTEVAR") and
      this = DataFlow::parameterNode(p)
    )
  }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().(BuiltinFunction).getName() = "eval" and
      this = call.getArgument(0)
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }
}

from EvalInjectionConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Detected user data flowing into eval. This is code injection and should be avoided."
