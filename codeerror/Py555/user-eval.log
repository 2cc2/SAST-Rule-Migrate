Rule Content:
/**
 * @name eval-injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind taint
 * @id python/eval-injection
 * @problem.severity error
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.web.Flask

class FlaskRequestSource extends TaintSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getTarget().(Method).getDeclaringType() instanceof FlaskRequestType and
      (ma.getTarget().getName() = "get" or ma.getTarget().getName() = "__getitem__" or ma.getTarget().getName() = "__call__") and
      result = ma.getAnArgument()
    )
  }
}

class RouteParamSource extends TaintSource::Range {
  RouteParamSource() {
    exists(MethodParameter mp | 
      mp.getName().matches("%ROUTEVAR%") and
      result = mp.getAParameterUse()
    )
  }
}

class EvalSink extends TaintSink::Range {
  EvalSink() {
    exists(Call call |
      call.getTarget().(FunctionValue).getName() = "eval" and
      call.getTarget().(FunctionValue).getType().getName() = "builtins" and
      result = call.getArgument(0)
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "EvalInjectionConfig" }

  override predicate isSource(TaintSource::Range source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(TaintSink::Range sink) {
    sink instanceof EvalSink
  }

  override predicate isExtension(Extension extension) {
    extension instanceof ArgumentToParameter or
    extension instanceof ChainPropagation
  }
}

class ArgumentToParameter extends TaintTracking::Extension {
  override predicate propagates(TaintFlow flow, TaintPropagationNode pred, TaintPropagationNode succ) {
    exists(Parameter p, Argument a |
      flow.getInput() = a.getAUse() and
      flow.getOutput() = p.getUse(this.getContext(), succ) and
      succ = p.getUse(this.getContext(), succ)
    )
  }
}

class ChainPropagation extends TaintTracking::Extension {
  override predicate propagates(TaintFlow flow, TaintPropagationNode pred, TaintPropagationNode succ) {
    exists(Parameter p, Argument a |
      flow.getInput() = a.getAUse() and
      flow.getOutput() = p.getUse(this.getContext(), succ) and
      succ = p.getUse(this.getContext(), succ)
    )
  }
}

from Config config, TaintSource::Range source, TaintSink::Range sink
where config.hasFlow(source, sink)
select sink, source, "Detected user data flowing into eval. This is code injection and should be avoided."
