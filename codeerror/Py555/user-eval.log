Rule Content:
/**
 * @name Eval Injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind taint
 * @problem.severity error
 * @id py/eval-injection
 */

import python
import semmle.python.dataflow.ExternalFlow
import semmle.python.web.Flask
import DataFlow::PathGraph

class FlaskRequestInput extends DataFlow::Node {
  FlaskRequestInput() {
    exists(MethodAccess ma |
      ma.getTarget().hasQualifiedName("flask", "request") and
      (
        ma.getMethodName() = "get" or
        ma.getMethodName() = "__getitem__" or
        ma.getMethodName() = "__call__"
      ) and
      this.asExpr() = ma
    )
  }
}

class RouteParameterInput extends DataFlow::Node {
  RouteParameterInput() {
    exists(Parameter p |
      regexMatches("\$ROUTEVAR", p.getName()) and
      this.asParameter() = p
    )
  }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(MethodAccess ma |
      ma.getTarget().hasQualifiedName("builtins", "eval") and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

predicate isSource(DataFlow::Node source) {
  source instanceof FlaskRequestInput or
  source instanceof RouteParameterInput
}

predicate isSink(DataFlow::Node sink) {
  sink instanceof EvalSink
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where isSource(source.getNode()) and
  isSink(sink.getNode()) and
  DataFlow::flowPath(source, sink)
select sink.getNode(), source, sink, "User data flows into eval. This is code injection and should be avoided."
