/**
 * @id eval-injection
 * @severity error
 * @kind path-problem
 * @name Detected eval injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 */

import python
import semmle.python.dataflow.new.RemoteFlowSources
import DataFlow
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().(RemoteFlowSource).getACall() = this and
      exists(Function f |
        f.getName().regexpMatch("get|__getitem__|__call__") and
        ma.getMethod() = f
      )
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(FunctionParameter p |
      p = this and
      p.getName().regexpMatch("\\$ROUTEVAR")
    )
  }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(CallNode call |
      call = this and
      call.getFunc().getName() = "eval"
    )
  }
}

class EvalTaintConfig extends TaintTracking::Configuration {
  EvalTaintConfig() { this = "EvalTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    succ instanceof ParameterNode and
    pred = succ.asParameter().getAnArgument()
  }
}

from EvalTaintConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected user data flowing into eval. This is code injection and should be avoided.",
  source, "User input comes from here."
