/**
 * @name Eval Injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/eval-injection
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph


class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["get", "__getitem__", "__call__"] and
      ma.getMethod().getDeclaringType().hasQualifiedName("flask", "request") and
      this.asExpr() = ma
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(MethodParameter mp |
      mp.getAParameterName().matches("%ROUTEVAR%") and
      this.asParameter() = mp
    )
  }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(Call call |
      call.getTarget().hasName("eval") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }
}

from EvalInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Detected user data flowing into eval. This is code injection and should be avoided.",
  source, sink, "Eval injection vulnerability"
