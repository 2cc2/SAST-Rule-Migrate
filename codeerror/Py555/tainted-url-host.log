Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 * This could allow attacker to send data to their own server, potentially exposing sensitive data such 
 * as cookies or authorization information sent with this request. They could also probe internal servers
 * or other resources that the server running this code can access. (This is called server-side request 
 * forgery, or SSRF.) Do not allow arbitrary hosts. Instead, create an allowlist for approved hosts, or 
 * hardcode the correct host.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-url-host
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.Flask
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().(PythonFunction).getName() = "request" and
      ma.getMethod().getDeclaringType().getName() = "flask" and
      this.asExpr() = ma
    )
  }
}

class RouteVarSource extends DataFlow::Node {
  RouteVarSource() {
    exists(FunctionDef routeFunc, Parameter p |
      flaskRouteStmt(routeFunc) and
      p = routeFunc.getAParameter() and
      this.asParameter() = p
    )
  }
}

class UrlSink extends DataFlow::Node {
  UrlSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().getCode().regexpMatch(".*://.*") and
      (
        exists(call.getArgument(_)) or // string formatting
        exists(Str s, OpExpr oe | oe.getRightOperand() = s and oe.getOperator() = "+") or // string concat
        exists(Str s, AugAssign aa | aa.getTarget() = s and aa.getOperator() = "+=") // += concatenation
      ) and
      this.asExpr() = call
    )
  }
}

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteVarSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrlSink
  }
}

from TaintedUrlHostConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User-controlled data flows into URL host: $@", source.getNode(),
  "This could lead to SSRF (Server-Side Request Forgery)"
