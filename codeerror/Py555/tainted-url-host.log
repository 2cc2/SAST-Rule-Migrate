/**
 * @name Tainted URL Host
 * @id tainted-url-host
 * @kind path-problem
 * @problem.severity warning
 * @description User data flows into the host portion of this manually-constructed URL.
 *              This could allow SSRF attacks by sending data to attacker-controlled servers,
 *              potentially exposing sensitive data or probing internal resources.
 */

import python
import semmle.python.security.dataflow.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() {
    exists(API::MethodCall call |
      call.getMethod().getQualifiedName().matches("flask.request.%")
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(API::MethodCall call |
      call.getMethod().getQualifiedName().matches("flask.request.%") and
      source.asDefiningNode() = call.getAValue()
    )
  }
}

class RouteParameterSource extends TaintTracking::Source {
  RouteParameterSource() {
    exists(Function f, Decorator d, string routeAttr |
      f.getADecorator() = d and
      d.getExpr().(Call).getFunc().getQualifiedName() = "flask.Flask.route" and
      exists(f.getAParameter())
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Function f, Parameter p |
      f.getADecorator().getExpr().(Call).getFunc().getQualifiedName() = "flask.Flask.route" and
      f.getAParameter() = p and
      source.asDefiningNode() = p
    )
  }
}

class UrlConstructionSink extends TaintTracking::Sink {
  UrlConstructionSink() {
    exists(DataFlow::BasicBlock block |
      block.regexpMatch(".*://.*") or
      exists(StringFormat fmt | fmt.getAnOperand() = block) or
      exists(BinOp op | op.getAnOperand() = block) or
      exists(FString fmt | fmt.getAnInsertion() = block)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DataFlow::BasicBlock block |
      block.regexpMatch(".*://.*") and
      (
        block = sink.asNode() or
        exists(StringFormat fmt | fmt.getAnOperand() = block and sink.asNode() = block) or
        exists(BinOp op | op.getAnOperand() = block and sink.asNode() = block) or
        exists(FString fmt | fmt.getAnInsertion() = block and sink.asNode() = block)
      )
    )
  }
}

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    any(FlaskRequestSource fss | fss.isSource(source)) or
    any(RouteParameterSource rps | rps.isSource(source))
  }

  override predicate isSink(DataFlow::Node sink) {
    any(UrlConstructionSink ucs | ucs.isSink(sink))
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedUrlHostConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User data flows into the host portion of this manually-constructed URL. " +
  "This could allow SSRF attacks by sending data to attacker-controlled servers."
