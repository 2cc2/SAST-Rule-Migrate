Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of a manually-constructed URL. This could allow SSRF attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%") and
      ma.getMethod().getDeclaringType().hasQualifiedName("flask", "request")
    |
      this.asSource(ma)
    )
  }
}

class RouteParameterSource extends DataFlow::Source {
  RouteParameterSource() {
    exists(FunctionValue fn, Parameter p |
      exists(string attrName |
        fn.getAnAttributeAccessedByName(attrName).getName() = "route"
      ) and
      p = fn.getAParameter()
    |
      this.asSource(p)
    )
  }
}

class UrlConstructionSink extends DataFlow::Sink {
  UrlConstructionSink() {
    exists(DataFlow::CallNode call |
      call.getCode().regexpMatch(".*://.*") and
      (
        exists(StrFormat format | format = call.getAnOperand() | format instanceof StrFormat) or
        exists(BinOp op |
          op = call.getAnOperand() and
          (op.getOperator() = "+" or op.getOperator() = "%") and
          op.getLeftOperand() instanceof StrLiteral
        ) or
        exists(StrInterpolation interp | interp = call.getAnOperand())
      )
    |
      this.asSink(call)
    )
  }
}

class TaintedUrlHostConfiguration extends TaintTracking::Configuration {
  TaintedUrlHostConfiguration() {
    this = "TaintedUrlHostConfiguration"
  }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof UrlConstructionSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedUrlHostConfiguration config
where config.hasFlowPath(source, sink)
select sink, "User data flows into the host portion of this manually-constructed URL. " +
  "This could allow SSRF attacks exposing sensitive data or probing internal resources. " +
  "Instead, create an allowlist for approved hosts or hardcode the correct host."
