Rule Content:
/**
 * @name Tainted URL Host SSRF
 * @description User data flows into the host portion of this manually-constructed URL
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-url-host
 */

import python
import DataFlow::TaintTracking
import python.frameworks.flask
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::SourceNode {
  FlaskRequestSource() {
    exists(API::getAMethodCall("flask.request") ma |
      this.asExprNode() = ma.getAMethodCall()
    )
  }
}

class RouteVarSource extends DataFlow::SourceNode {
  RouteVarSource() {
    exists(Function f, string route |
      flaskRouteStmt(f, route) and
      this.asParameterNode() = f.getParameter(_)
    )
  }
}

predicate flaskRouteStmt(Function f, string route) {
  exists(API::getAMethodCall("flask.Flask.route") routeCall |
    f = routeCall.getEnclosingFunction() and
    route = routeCall.getArgument(0).(string)
  )
}

class UrlSink extends DataFlow::SinkNode {
  UrlSink() {
    // URL string construction variants
    exists(BinaryExpr be | 
      be.getOperand1().(string).regexpMatch(".*://.*") and
      (be.getOp() = "+" or be.getOp() = "%") and
      this.asExprNode() = be
    )
    or
    exists(API::getAMethodCall("str.format") formatCall |
      formatCall.getReceiver().(string).regexpMatch(".*://.*") and
      this.asExprNode() = formatCall
    )
    or
    exists(AugAssign aa |
      aa.getTarget().(string).regexpMatch(".*://.*") and
      this.asExprNode() = aa
    )
  }
}

class TaintedUrlConfig extends TaintTracking::Configuration {
  TaintedUrlConfig() { this = "TaintedUrlConfig" }

  override predicate isSource(DataFlow::SourceNode source) {
    source instanceof FlaskRequestSource or source instanceof RouteVarSource
  }

  override predicate isSink(DataFlow::SinkNode sink) {
    sink instanceof UrlSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedUrlConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "User data flows into the host portion of this manually-constructed URL. $@",
  source.getNode(), "Potential SSRF vulnerability source"
