Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 * This could allow an attacker to send data to their own server, potentially exposing
 * sensitive data such as cookies or authorization information sent with this request.
 * They could also probe internal servers or other resources that the server running
 * this code can access. (This is called server-side request forgery, or SSRF.)
 * Do not allow arbitrary hosts. Instead, create an allowlist for approved hosts,
 * or hardcode the correct host.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-url-host
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.FlaskRequest

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getTarget().hasQualifiedName("flask.request", _) and
      this.asExpr() = ma
    ) or
    exists(Parameter p |
      p.getAnnotatedValue().toString().matches("@%APP.route(%)") and
      this.asParameter() = p
    )
  }
}

class UrlConstructionSink extends DataFlow::Node::Object {
  UrlConstructionSink() {
    exists(MethodAccess ma |
      ma.getTarget().toString().matches(".*://.*") and
      this.asExpr() = ma
    ) or
    exists(BinaryOperation binop |
      (binop.getOperator() = "%" or binop.getOperator() = "+") and
      binop.getLeftOperand().toString().matches(".*://.*") and
      this.asExpr() = binop
    ) or
    exists(MethodAccess formatCall |
      formatCall.getTarget().getName() = "format" and
      formatCall.getQualifier().toString().matches(".*://.*") and
      this.asExpr() = formatCall
    ) or
    exists(InterpolatedString interpol |
      interpol.getStringPart().matches(".*://.*") and
      this.asExpr() = interpol
    ) or
    exists(Assignment assign |
      assign.getLeftOperand().toString().matches(".*URL.*") and
      assign.getOperator() = "+=" and
      this.asExpr() = assign
    )
  }
}

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHost" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrlConstructionSink
  }
}

