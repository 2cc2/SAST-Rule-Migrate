Rule Content:
/**
 * @name Tainted URL host
 * @description User data flows into the host portion of manually-constructed URLs,
 *              potentially leading to SSRF vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import python
import DataFlow::PathGraph
import python.frameworks.flask.request
import python.Strings
import DataFlow::TaintTracking

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(DataFlow::CallNode call |
      source.asExpr() = call.getExpr() and
      Flask::requestCall(call)
    )
    or
    exists(Function::Parameter p |
      source.asParameter() = p and
      exists(Decorator d |
        d.getName() = "route" and
        p.getAnAnnotation() = d
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DataFlow::ValueNode vn |
      sink.asExpr() = vn.getExpr() and
      exists(string format |
        DataFlow::getStringValue(vn, format) and
        regexMatches(".*://.*", format)
       )
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where any(TaintedUrlHostConfig cfg).hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User data flows into the host portion of this manually-constructed URL (" +
  sink.getNode().toString() + "). This could allow SSRF attacks."
