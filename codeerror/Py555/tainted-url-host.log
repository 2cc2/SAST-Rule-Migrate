/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of manually-constructed URLs.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-url-host
 */

import python
import semmle.python.web.flask.Decorators
import DataFlow::PathGraph
import semmle.python.Strings
import semmle.python.ApiGraphs
import DataFlow::TaintTracking2

class FlaskRequestSource extends TaintTracking::DataSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("flask", "request") and
      this.asSourceNode() = ma.getAnArgument()
    ) or
    exists(Function f, Parameter p |
      f.getADecorator().isRouteDecorator() and
      p = f.getAParameter() and
      this.asSourceNode() = p.getAnnotatedValue()
    )
  }
}

class UrlConstructionSink extends DataFlow::Node {
  UrlConstructionSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().toString().matches("%://%") and
      this.asSinkNode() = call
    ) or
    exists(DataFlow::BinaryExprNode bin |
      bin.getOp() = "%" and
      bin.getLeftOperand().toString().matches("%://%") and
      this.asSinkNode() = bin
    ) or
    exists(DataFlow::CallNode formatCall |
      formatCall.getTarget().getName() = "format" and
      formatCall.getReceiver().toString().matches("%://%") and
      this.asSinkNode() = formatCall
    ) or
    exists(DataFlow::BinaryExprNode concat |
      concat.getOp() = "+" and
      concat.getLeftOperand().toString().matches("%://%") and
      this.asSinkNode() = concat
    ) or
    exists(DataFlow::StringLiteral interpolated |
      interpolated.getString().matches("%://%{...}%") and
      this.asSinkNode() = interpolated
    ) or
    exists(DataFlow::AssignmentNode assign |
      assign.getDest().toString().matches("%URL%") and
      assign.getOp() = "+=" and
      this.asSinkNode() = assign
    )
  }
}

class TaintedUrlConfiguration extends TaintTracking::Configuration {
  TaintedUrlConfiguration() { this = "TaintedUrlConfiguration" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof UrlConstructionSink
  }

  override string getDisplayName(DataFlow::PathNode source, DataFlow::PathNode sink) {
    "User data flows into manually-constructed URL host, possible SSRF vulnerability"
  }
}

from TaintedUrlConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "User data flows into the host portion of this manually-constructed URL. This could allow SSRF."
