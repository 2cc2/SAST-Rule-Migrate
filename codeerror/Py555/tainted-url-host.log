Rule Content:
/**
 * @kind path-problem
 * @problem.severity warning
 * @id tainted-url-host
 * @name Tainted URL Host Construction
 * @description User data flows into the host portion of manually-constructed URLs,
 *              potentially leading to SSRF vulnerabilities. Use allowlists or 
 *              hardcoded hosts instead.
 */

import semmle.python.dataflow.DataFlow
import semmle.python.frameworks.flask.Request
import semmle.python.Strings
import semmle.python.dataflow.TaintTracking

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Flask request sources
    exists(Request::requestCall call |
      source.asExpr() = call.getAMethodCall()
    )
    or
    // Route parameter sources
    exists(DataFlow::ParameterNode param |
      exists(DataFlow::DecoratorNode decorator |
        decorator.getAddCall().getTarget().toString() = "route" and
        param.getFunction() = decorator.getDecoratedFunction()
      ) and
      source = param
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(string exprStr |
      sink.asExpr().toString() = exprStr and
      matches(exprStr, ".*://.*") and
      (
        exprStr.matches("%.*") or
        exprStr.matches(".format(.*)") or
        exprStr.matches("\\+") or
        exprStr.matches("f\".*\\{.*\\}.*\"") or
        exprStr.matches("\\+=")
      )
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where 
  exists(TaintedUrlHostConfig cfg |
    cfg.hasFlowPath(source, sink)
  )
select sink.getNode(), source, sink, 
  "User data flows into host portion of URL construction. May lead to SSRF."
