Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL. This could allow SSRF attacks.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id python/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.web.flask.Flask
import semmle.python.StringOperations
import DataFlow::PathGraph

class Config extends TaintTracking::Configuration {
  Config() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Flask request sources
    exists(API::BuiltinCall call |
      call.getPackage() = "flask" and
      call.getType() = "request" and
      source.asExpr() = call.getAnInput()
    )
    or
    // Route parameter sources
    exists(Parameter p |
      p.getAnAnnotation().getValue().regexpMatch(".*route.*") and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DataFlow::StringExpr str |
      str.getStringConstruction().regexpMatch(".*://.*") and
      sink.asExpr() = str
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "User data flows into the host portion of this manually-constructed URL. This could allow " +
  "an attacker to send data to their own server (SSRF attack). Do not allow arbitrary hosts. " +
  "Instead, create an allowlist for approved hosts, or hardcode the correct host.", source,
  "User input flows into URL host from $@", source, "here"
