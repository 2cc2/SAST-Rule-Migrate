Rule Content:
/**
 * @name Subprocess Injection
 * @description Detected user input entering a `subprocess` call unsafely.
 * @id subprocess-injection
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.8
 * @precision high
 */

import python
import semmle.python.web.Frameworks.Flask
import semmle.python.security.DataFlow
import semmle.python.security.TaintTracking
private import semmle.python.ApiGraphs
private import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Node, TaintTracking::TaintSource {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getCallee().(Function).getName() = "get" and
      ma.getCallee().(Function).getDeclaringType().hasQualifiedName("flask", "request")
    )
    or
    exists(MethodAccess ma |
      ma.getCallee().(Function).getName() = "__getitem__" and
      ma.getCallee().(Function).getDeclaringType().hasQualifiedName("flask", "request")
    )
    or
    exists(Attribute attr |
      attr.getObject().getType().hasQualifiedName("flask", "request") and
      attr.getAttributeName() in ["form", "args", "values", "cookies", "stream", 
                                "headers", "data", "full_path", "url", "json", "view_args"]
    )
  }
}

class RouteParamSource extends DataFlow::Node, TaintTracking::TaintSource {
  RouteParamSource() {
    exists(Function f, Parameter p |
      exists(f.getADecorator() | 
        this = p and
        f.getADecorator().getExpr().toString().matches("@route")
      )
    )
  }
}

class SubprocessSink extends DataFlow::Node, TaintTracking::TaintSink {
  SubprocessSink() {
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("subprocess") and
      (
        not call.getArgument(0).getStringValue() instanceof string or
        not call.getArgument(0).getType() instanceof list
      )
    )
  }
}

class ShellExecSink extends DataFlow::Node, TaintTracking::TaintSink {
  ShellExecSink() {
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("subprocess") and
      call.getArgument(0).getStringValue().matches("^(sh|bash|ksh|csh|tcsh|zsh)$")
    )
  }
}

class InterpreterExecSink extends DataFlow::Node, TaintTracking::TaintSink {
  InterpreterExecSink() {
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("subprocess") and
      call.getArgument(0).getStringValue().matches("^(python|python\\d)$")
    )
  }
}

class DictSanitizer extends DataFlow::Node, TaintTracking::Sanitizer {
  DictSanitizer() {
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("dict") and
      call.getCallee().getName() = "__getitem__"
    )
  }
}

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "Subprocess Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink or
    sink instanceof ShellExecSink or
    sink instanceof InterpreterExecSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof DictSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SubprocessInjectionConfig conf
where conf.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected user input entering a subprocess call unsafely. This could result in a command injection vulnerability."
