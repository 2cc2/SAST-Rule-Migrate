Rule Content:
/**
 * @name Subprocess Command Injection
 * @kind problem
 * @problem.severity error
 * @precision high
 * @id python/subprocess-injection
 * @tags security
 *       external/cwe/cwe-78
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.FunctionArguments
import semmle.python.web.Flask

predicate isFlaskSource(DataFlow::Node source) {
  exists(MethodAccess ma |
    ma.getMethod().getName().matches("get") and
    ma.getReceiver().getType().getName() = "flask.request" and
    source.asExpr() = ma
  )
  or
  exists(MethodAccess ma |
    ma.getMethod().getName() = "__getitem__" and
    ma.getReceiver().getType().getName() = "flask.request" and
    source.asExpr() = ma
  )
  or
  exists(FieldAccess fa |
    fa.getTarget().getName() in ["form", "args", "values", "cookies", "stream", "headers", 
                                "data", "full_path", "url", "json", "view_args"] and
    fa.getReceiver().getType().getName() = "flask.request" and
    source.asExpr() = fa
  )
}

predicate isRouteParamSource(DataFlow::Node source) {
  exists(Method m | 
    m.hasAnnotation("route") and
    source.asParameter() = m.getAParameter()
  )
}

predicate isSubprocessSink(DataFlow::Node sink) {
  exists(Call c |
    c.getTarget().getType().getName() = "subprocess" and
    sink.getExpr() = c.getArgument(0) and
    not c.getArgument(0).getValue().isStringLiteral() and
    not c.getArgument(0).getType().getName() = "list"
  )
}

predicate isShellExecSink(DataFlow::Node sink) {
  exists(Call c |
    c.getTarget().getType().getName() = "subprocess" and
    sink.getExpr() = c.getArgument(0) and
    exists(ArrayLiteral arr | 
      arr = c.getArgument(0) and
      arr.getElement(0).getValue().toString().matches("^(sh|bash|ksh|csh|tcsh|zsh)$")
    )
  )
}

predicate isInterpreterExecSink(DataFlow::Node sink) {
  exists(Call c |
    c.getTarget().getType().getName() = "subprocess" and
    sink.getExpr() = c.getArgument(0) and
    exists(ArrayLiteral arr | 
      arr = c.getArgument(0) and
      arr.getElement(0).getValue().toString().matches("^(python|python\\d)$")
    )
  )
}

class DictAccessSanitizer extends DataFlow::BarrierGuard {
  DictAccessSanitizer() {
    exists(Call c |
      c.getTarget().getName() = "__getitem__" and
      c.getReceiver().getType().getName() = "dict" and
      this.getNode().getExpr() = c.getArgument(0)
    )
  }  
}

class SubprocessConfig extends TaintTracking::Configuration {
  SubprocessConfig() { this = "SubprocessCommandInjection" }

  override predicate isSource(DataFlow::Node source) {
    isFlaskSource(source) or isRouteParamSource(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    isSubprocessSink(sink) or isShellExecSink(sink) or isInterpreterExecSink(sink)
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node.getBarrierGuard() instanceof DictAccessSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::argumentToParameter(node1, node2) or
    TaintTracking::fieldFlow(node1, node2)
  }
}

from SubprocessConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability.", 
  source, sink,
  "An attacker could use this vulnerability to execute arbitrary commands on the host, which allows them to download malware, scan sensitive data, or run any command they wish on the server."
