Rule Content:
/**
 * @name Subprocess Command Injection
 * @kind problem
 * @id python/subprocess-injection
 * @security-severity error
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(TaintTracking::SourceNode source) {
    exists(MethodParameter param |
      param.getAPythonFunction().getADecorator().toString() = "@route" and
      source.asParameter() = param
    )
    or
    exists(API::Node requestCall |
      requestCall.getImportedName("flask", "request") and
      (
        requestCall.(Member).getName() in ["get", "values", "args", "form", "cookies", "stream"] or
        source.asExpr() = requestCall
      )
    )
  }

  override predicate isSink(TaintTracking::SinkNode sink) {
    exists(API::Node subprocessCall |
      subprocessCall.getImportedName("subprocess", "") and
      subprocessCall.(Call).getArg(0) = sink.asExpr() and
      not exists(subprocessCall.(Call).getArg(0).getStringValue()) and
      not subprocessCall.(Call).getArg(0).getType().(ListLiteral)
    )
    or
    exists(string shell |
      sink.asExpr().getStringValue() = shell and
      matches(shell, "^(sh|bash|ksh|csh|tcsh|zsh)$")
    )
    or
    exists(string interpreter |
      sink.asExpr().getStringValue() = interpreter and
      matches(interpreter, "^(python|python\\d)$")
    )
  }

  override predicate isSanitizer(TaintTracking::SanitizerNode sanitizer) {
    exists(API::Node dictAccess |
      dictAccess.getImportedName("dict", "") and
      dictAccess.(Member).getName() = "__getitem__" and
      sanitizer.asExpr() = dictAccess.(Call).getArg(0)
    )
  }
}

