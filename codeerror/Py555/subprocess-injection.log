Rule Content:
/**
 * @name Subprocess Injection
 * @description Detected user input entering a `subprocess` call unsafely. This could result 
 * in a command injection vulnerability. An attacker could use this vulnerability to 
 * execute arbitrary commands on the host.
 * @kind path-problem
 * @problem.severity error
 * @id py/subprocess-injection
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getTarget().hasQualifiedName("flask.request", "get") or
      call.getTarget().hasQualifiedName("flask.request", "__getitem__")
    ) or
    exists(FieldAccess fa |
      fa.getTarget().hasQualifiedName("flask.request") and
      fa.getFieldName() in [
        "form", "args", "values", "cookies", "stream", "headers", 
        "data", "full_path", "url", "json", "view_args"
      ]
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Method m | 
      m.hasAnnotation("route") and
      this = m.getParameter(_)
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(MethodCall call |
      call.getTarget().hasQualifiedName("subprocess", _) and
      (
        not call.getArg(0).(StringLiteral).getValue() instanceof string or
        not call.getArg(0).getType() instanceof list
      ) or
      (
        call.getArg(0).getValue().toString().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$") or
        call.getArg(0).getValue().toString().regexpMatch("^(python|python\\d)$")
      )
    )
  }
}

class DictKeySanitizer extends DataFlow::BarrierNode {
  DictKeySanitizer() {
    exists(MethodCall call |
      call.getTarget().hasQualifiedName("dict", "__getitem__") and
      this = call.getArg(1)
    )
  }
}

module TaintConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }

  predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof DictKeySanitizer
  }
}

module DangerousSubprocessCall = TaintFlow::PathGraph<TaintConfig>;

from DangerousSubprocessCall::PathNode source, DangerousSubprocessCall::PathNode sink
where sink.getNode() instanceof SubprocessSink and
  sink.hasFlowPath(source)
select sink.getNode(), source, sink, 
  "Detected user input entering a subprocess call unsafely. This could result in command injection."
