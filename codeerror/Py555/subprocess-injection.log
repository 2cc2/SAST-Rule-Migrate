Rule Content:
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.web.Flask
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(MethodAccess ma | ma.getMethod().getName() = "get" and ma.getQualifier().getType().getName() = "request" and
      ma.getQualifier().getType().getASource().getName() = "flask") or
    exists(MethodAccess ma | ma.getMethod().getName() = "__getitem__" and ma.getQualifier().getType().getName() = "request" and
      ma.getQualifier().getType().getASource().getName() = "flask") or
    exists(FieldAccess fa | fa.getField().getName() in ["form", "args", "values", "cookies", "stream", "headers", "data",
      "full_path", "url", "json", "view_args"] and fa.getQualifier().getType().getName() = "request" and
      fa.getQualifier().getType().getASource().getName() = "flask")
  }
}

class RouteParamSource extends DataFlow::Source {
  RouteParamSource() {
    exists(Function f | f.getDecorator().getName() = "route" and this.asParameter() = f.getAParameter())
  }
}

class SubprocessSink extends DataFlow::Sink {
  SubprocessSink() {
    exists(MethodAccess ma | ma.getMethod().getDeclaringType().getName() = "subprocess" and
      ma.getArgument(0).getType() != "str" and ma.getArgument(0).getType() != "list")
  }
}

class ShellExecSink extends DataFlow::Sink {
  ShellExecSink() {
    exists(MethodAccess ma | ma.getMethod().getDeclaringType().getName() = "subprocess" and
      ma.getArgument(0).getStringValue().matches("^(sh|bash|ksh|csh|tcsh|zsh)$"))
  }
}

class InterpreterSink extends DataFlow::Sink {
  InterpreterSink() {
    exists(MethodAccess ma | ma.getMethod().getDeclaringType().getName() = "subprocess" and
      ma.getArgument(0).getStringValue().matches("^(python|python\\d)$"))
  }
}

class DictSanitizer extends TaintTracking::Sanitizer {
  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma | ma.getMethod().getDeclaringType().getName() = "dict" and
      ma.getMethod().getName() = "__getitem__" and node = ma.getArgument(0))
  }
}

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() {
    this = "Subprocess injection"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink or
    sink instanceof ShellExecSink or
    sink instanceof InterpreterSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof DictSanitizer
  }
}

from SubprocessInjectionConfig conf, DataFlow::PathNode source, DataFlow::PathNode sink
where conf.hasFlowPath(source, sink)
select sink.getNode(), "Detected user input entering a subprocess call unsafely. " +
  "This could result in a command injection vulnerability. An attacker could use " +
  "this vulnerability to execute arbitrary commands on the host."
