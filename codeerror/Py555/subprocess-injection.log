Rule Content:
/**
 * @name Subprocess Injection
 * @description Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability.
 * @id python/command-injection
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @tags security
 *     external/cwe/cwe-078
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    // Flask.request attribute accesses
    exists(FieldRead f | 
      f.getField().getDeclaringType().hasQualifiedName("flask", "Request") or
      f.getField().getDeclaringType().hasQualifiedName("flask", "request") |
      f.getField().getName() in ["form", "args", "values", "cookies", "stream", 
                                "headers", "data", "full_path", "url", "json", "view_args"] |
      result = f
    ) or
    // Flask.request.get() calls
    exists(Call c | 
      c.getCallee().(Method).getDeclaringType().hasQualifiedName("flask", "Request") and
      c.getCallee().(Method).getName() = "get" |
      result = c
    ) or
    // Flask.request.__getitem__ calls
    exists(Call c | 
      c.getCallee().(Method).getDeclaringType().hasQualifiedName("flask", "Request") and
      c.getCallee().(Method).getName() = "__getitem__" |
      result = c
    )
  }
}

class RouteParamSource extends DataFlow::Source {
  RouteParamSource() {
    exists(Method m, Parameter p |
      m.hasAnnotation("flask.route") and
      p = m.getAParameter() |
      result = p
    )
  }
}

class SubprocessSink extends DataFlow::Sink {
  SubprocessSink() {
    exists(Call c |
      c.getCallee().getParentScope().getFile().getRelativePath().matches("%subprocess.py") and
      c.getArgument(0).getType() != string and
      c.getArgument(0).getType() != list | // Raw command input
      result = c
    )
  }
}

class ShellExecSink extends DataFlow::Sink {
  ShellExecSink() {
    exists(Call c, StringLiteral s |
      c.getCallee().getParentScope().getFile().getRelativePath().matches("%subprocess.py") and
      s = c.getArgument(0).(ListExpr).getElement(0).getAChild*() and
      s.getValue().matches("^(sh|bash|ksh|csh|tcsh|zsh)$") | // Shell execution
      result = c
    )
  }
}

class InterpreterExecSink extends DataFlow::Sink {
  InterpreterExecSink() {
    exists(Call c, StringLiteral s |
      c.getCallee().getParentScope().getFile().getRelativePath().matches("%subprocess.py") and
      s = c.getArgument(0).(ListExpr).getElement(0).getAChild*() and
      s.getValue().matches("^(python|python\\d)$") | // Interpreter execution
      result = c
    )
  }
}

class DictSanitizer extends DataFlow::Sanitizer {
  DictSanitizer() {
    exists(Call c |
      c.getCallee().(Method).getDeclaringType().hasQualifiedName("builtins", "dict") and
      c.getCallee().(Method).getName() = "__getitem__" |
      result = c.getArgument(1) // Key argument is considered sanitized
    )
  }
}

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof SubprocessSink or
    sink instanceof ShellExecSink or
    sink instanceof InterpreterExecSink
  }

  override predicate isSanitizer(DataFlow::Sanitizer sanitizer) {
    sanitizer instanceof DictSanitizer
  }

  // Propagate through argument to parameter and field accesses
  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // Argument to parameter flow
    exists(Call c, int i | c.getArgument(i) = pred.asExpr() | succ.asParameter() = c.getCallee().getParameter(i)) or
    // Field load propagation
    exists(FieldRead f | f.getReceiver() = pred.asExpr() | succ.asExpr() = f.getValue())
  }
}

from SubprocessInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected user input entering a `subprocess` call unsafely. " +
  "This could result in a command injection vulnerability. An attacker could use this vulnerability " +
  "to execute arbitrary commands on the host, which allows them to download malware, scan sensitive " +
  "data, or run any command they wish on the server."
