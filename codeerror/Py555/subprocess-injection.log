/**
 * @name Subprocess Injection
 * @description Detects user input entering a `subprocess` call unsafely
 * @kind path-problem
 * @problem.severity error
 * @id python/command-injection
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.ApiGraphs
import semmle.python.web.flask.Flask
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getMethodName() = ["get", "__getitem__"] and
      call.getReceiverType().getQualifiedName() = "flask.request"
    ) or
    exists(FieldAccess field |
      field.getFieldType().getQualifiedName() = "flask.request" and
      field.getFieldName() in [
        "form", "args", "values", "cookies", "stream", "headers", 
        "data", "full_path", "url", "json", "view_args"
      ]
    )
  }

  override predicate isSource(DataFlow::Node source) { this = source }

  override predicate asCfgNode(ControlFlow::Node node) { node = this.getNode() }
  override Location getLocation() { result = this.getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Function f, Parameter p |
      f.getADecorator().getName() = "route" and
      p = f.getAParameter()
    )
  }

  override predicate isSource(DataFlow::Node source) { this = source }

  override predicate asCfgNode(ControlFlow::Node node) { node = this.getNode() }
  override Location getLocation() { result = this.getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(Call call |
      call.getTarget().getSourceDeclaration().getQualifiedName().matches("subprocess.%") and
      not call.getArgument(0).getValue().isString() and
      not call.getArgument(0).getType().isList()
    )
  }

  override predicate isSink(DataFlow::Node sink) { this = sink }

  override predicate asCfgNode(ControlFlow::Node node) { node = this.getNode() }
  override Location getLocation() { result = this.getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class ShellExecSink extends DataFlow::Node {
  ShellExecSink() {
    exists(Call call |
      call.getTarget().getSourceDeclaration().getQualifiedName().matches("subprocess.%") and
      call.getArgument(0).getStringValue().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$")
    )
  }

  override predicate isSink(DataFlow::Node sink) { this = sink }

  override predicate asCfgNode(ControlFlow::Node node) { node = this.getNode() }
  override Location getLocation() { result = this.getLocation() }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class DictKeySanitizer extends TaintTracking::Sanitizer {
  override predicate sanitizes(DataFlow::Node node) {
    exists(Call call |
      call.getTarget().getSourceDeclaration().getName() = "__getitem__" and
      call.getReceiverType().getQualifiedName() = "dict" and
      node = call.getArgument(1)
    )
  }
}

query predicate isSafeSubprocessCall(DataFlow::Node node) {
  none()
}

from FlaskRequestSource source, SubprocessSink sink, DictKeySanitizer sanitizer
where TaintTracking::localTaint(source, sink) and
      not TaintTracking::hasSanitizer(source, sink, sanitizer)
select sink, "Detected user input entering a `subprocess` call unsafely"
