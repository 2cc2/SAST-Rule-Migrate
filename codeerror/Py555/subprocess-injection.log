Rule Content:
/**
 * @name Subprocess Injection
 * @description Detects user input entering a subprocess call unsafely
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.8
 * @precision high
 * @id python/subprocess-injection
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 */

import python
import semmle.python.ApiGraphs
import DataFlow
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    // Flask request sources
    exists(MethodCall call |
      call.getMethod().getName() = "get" and
      call.getReceiver().getType().getName() = "request" and
      call.getReceiver().getType().getModule().getName() = "flask"
    ) or
    exists(MethodCall call |
      call.getMethod().getName() = "__getitem__" and
      call.getReceiver().getType().getName() = "request" and
      call.getReceiver().getType().getModule().getName() = "flask"
    ) or
    exists(FieldAccess field |
      field.getField().getDeclaringType().getName() = "request" and
      field.getField().getDeclaringType().getModule().getName() = "flask" and
      field.getField().getName() in ["form", "args", "values", "cookies", "stream",
                                   "headers", "data", "full_path", "url", "json", "view_args"]
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(FunctionDef method |
      method.hasAnnotation("route") and
      this = method.getAParameter()
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(Call call |
      call.getCallee().getModule().getName() = "subprocess" and
      this = call.getArg(0) and
      not call.getArg(0) instanceof StringLiteral and
      not call.getArg(0).getType() instanceof ListType
    )
  }
}

class ShellExecSink extends DataFlow::Node {
  ShellExecSink() {
    exists(Call call |
      call.getCallee().getModule().getName() = "subprocess" and
      this = call.getArg(0) and
      call.getArg(0).(StringLiteral).getValue().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$")
    )
  }
}

class InterpreterExecSink extends DataFlow::Node {
  InterpreterExecSink() {
    exists(Call call |
      call.getCallee().getModule().getName() = "subprocess" and
      this = call.getArg(0) and
      call.getArg(0).(StringLiteral).getValue().regexpMatch("^(python|python\\d)$")
    )
  }
}

class DictSanitizer extends DataFlow::BarrierGuard {
  DictSanitizer() {
    exists(Call call |
      call.getCallee().getModule().getName() = "dict" and
      call.getCallee().getName() = "__getitem__" and
      this = call.getArg(0)
    )
  }
}

class TaintConfig extends DataFlow::Configuration {
  TaintConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink or
    sink instanceof ShellExecSink or
    sink instanceof InterpreterExecSink
  }

  override predicate isBarrier(DataFlow::Node node) {
    node instanceof DictSanitizer
  }
}

