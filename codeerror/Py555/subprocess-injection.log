Rule Content:
/**
 * @id subprocess-injection
 * @name Command injection via subprocess call
 * @description Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability.
 * @kind taint
 * @problem.severity error
 * @security-severity 9.1
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(DataFlow::CallNode call |
      call.getTarget().(FunctionValue).getSourceDeclaration().getName() = "request" and
      call.getTarget().(FunctionValue).getSourceDeclaration().getFile().getBaseName() = "flask.py" and
      (
        call.getCallName() = "get" or
        call.getCallName() = "__getitem__"
      ) and
      this = call.getResult()
    )
    or
    exists(MemberExpr member |
      member.getObject().getType().getUndecoratedString() = "flask.request" and
      member.getMemberName() in ["form", "args", "values", "cookies", "stream", 
                                "headers", "data", "full_path", "url", "json", "view_args"] and
      this = member
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(FunctionDef f, Parameter p |
      f.getDecoratorName() = "route" and
      p = f.getAParameter() and
      this = p.getValue()
    )
  }      
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().(FunctionValue).getSourceDeclaration().getFile().getBaseName() = "subprocess.py" and
      call.getAnArg() = this and
      (
        not this.getStringValue() and
        not this.getType().getName() = "list"
      )
    )
  }
}

class ShellExecSink extends DataFlow::Node {
  ShellExecSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().(FunctionValue).getSourceDeclaration().getFile().getBaseName() = "subprocess.py" and
      call.getAnArg() = this and
      exists(this.getStringValue() as string |
        string.regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$")
      )
    )
  }
}

class InterpreterExecSink extends DataFlow::Node {
  InterpreterExecSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().(FunctionValue).getSourceDeclaration().getFile().getBaseName() = "subprocess.py" and
      call.getAnArg() = this and
      exists(this.getStringValue() as string |
        string.regexpMatch("^(python|python\\d)$")
      )
    )
  }
}

class DictKeySanitizer extends DataFlow::Node::Range {
  override predicate isSanitizer(DataFlow::Node node) {
    exists(DataFlow::CallNode call |
      call.getTarget().(FunctionValue).getSourceDeclaration().getName() = "__getitem__" and
      call.getTarget().(FunctionValue).getSourceDeclaration().getFile().getBaseName() = "dict.py" and
      node = call.getAnArg()
    )
  }
}

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink or
    sink instanceof ShellExecSink or
    sink instanceof InterpreterExecSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof DictKeySanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2) or
    TaintTracking::fieldReadTaintStep(node1, node2)
  }
