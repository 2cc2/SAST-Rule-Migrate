/**
 * @name Subprocess Injection
 * @description Detected user input entering a `subprocess` call unsafely.
 * @kind path-problem
 * @problem.severity error
 * @id python/subprocess-injection
 */
import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Flask request sources
    exists(Call call |
      call.getCallee().(Value::Named).getName() = "request" and
      (
        call.getCallee().getExpr().(ModuleImport).getName() = "flask" or
        call.getCallee().getExpr().(ModuleImport).getName() = "flask_restful"
      ) and
      (
        call.getCaller().getName() = "get" or
        call.getCaller().getName() = "__getitem__"
      ) and
      source.asExpr() = call
    ) or
    // Route parameters
    exists(Function f, Parameter p |
      f.getAStmt().(Decorator).getExpr().(Call).getCallee().getName() = "route" and
      p = f.getAParameter(_) and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // Subprocess calls
    exists(Call call |
      call.getCallee().(Value::Named).getName().matches("subprocess%") and
      sink.asExpr() = call.getArg(0)
    ) or
    // Shell execution
    exists(Call call, ListLiteral lst |
      call.getCallee().(Value::Named).getName().matches("subprocess%") and
      lst = call.getArg(0) and
      exists(lst.getAnElement().(StringLiteral).getValue() |
        regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$", _)
      ) and
      sink.asExpr() = call.getArg(0)
    ) or
    // Interpreter execution
    exists(Call call, ListLiteral lst |
      call.getCallee().(Value::Named).getName().matches("subprocess%") and
      lst = call.getArg(0) and
      exists(lst.getAnElement().(StringLiteral).getValue() |
        regexpMatch("^(python|python\d)$", _)
      ) and
      sink.asExpr() = call.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getCallee().(Value::Named).getName() = "__getitem__" and
