Rule Content:
/**
 * @name pg8000 SQL Injection
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 * @kind problem
 * @problem.severity warning
 * @id py/pg8000-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import DataFlow::PathGraph
import TaintTracking::Config

class Pg8000Call extends Call, DataFlow::Node {
  Pg8000Call() {
    exists(string moduleName, string className, string methodName |
      this.getTarget().isMethodOfClass(pkg(moduleName, className)) and
      methodName in ["run", "execute", "executemany", "prepare"] and
      className.matches("Connection|Cursor") and
      moduleName = "pg8000"
    )
  }

  /* Required implementations for DataFlow::Node */
  override predicate asCfgNode() { this = super.asCfgNode() }
  override predicate getLocation() { this = super.getLocation() }
  override predicate getBasicBlock() { this = super.getBasicBlock() }
  override predicate toString() { this = super.toString() }
  override predicate getScope() { this = super.getScope() }
  override predicate asVariable() { this = super.asVariable() }
}

class StringSource extends DataFlow::Node, TaintTracking::TaintSource {
  StringSource() {
    exists(Literal l | this.asExpr() = l) or
    exists(Identifier i | this.asExpr() = i)
  }

  /* Required implementations */
  override predicate asCfgNode() { this = super.asCfgNode() }
  override predicate getLocation() { this = super.getLocation() }
  override predicate getBasicBlock() { this = super.getBasicBlock() }
  override predicate toString() { this = super.toString() }
  override predicate getScope() { this = super.getScope() }
  override predicate asVariable() { this = super.asVariable() }
}

class SafeStringFormat extends DataFlow::Node, TaintTracking::Sanitizer {
  SafeStringFormat() {
    exists(Addition a | this.asExpr() = a and a.getLeft().isStringLiteral() and a.getRight().isStringLiteral()) or
    exists(StringFormat sf | this.asExpr() = sf and sf.getFormatString().isStringLiteral())
  }

  /* Required implementations */
  override predicate asCfgNode() { this = super.asCfgNode() }
  override predicate getLocation() { this = super.getLocation() }
  override predicate getBasicBlock() { this = super.getBasicBlock() }
  override predicate toString() { this = super.toString() }
  override predicate getScope() { this = super.getScope() }
  override predicate asVariable() { this = super.asVariable() }
}

class Pg8000SqliConfig extends TaintTracking::Configuration {
  Pg8000SqliConfig() { this = "pg8000-sqli-config" }

  override predicate isSource(TaintTracking::TaintSource source) { 
    source instanceof StringSource 
  }

  override predicate isSink(TaintTracking::TaintSink sink) { 
    sink instanceof Pg8000Call 
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) { 
    sanitizer instanceof SafeStringFormat 
  }

  override predicate isAdditionalTaintStep(TaintTracking::DataFlow::Node node1, TaintTracking::DataFlow::Node node2) {
    exists(Addition a | node1.asExpr() = a.getAnOperand() and node2.asExpr() = a) or
    exists(StringFormat sf | node1.asExpr() = sf.getAnInput() and node2.asExpr() = sf) or
    exists(Assignment a | 
      a.getTarget().getBaseName().matches("%QUERY%") and 
      node1.asExpr() = a.getAnInput() and 
      node2.asExpr() = a.getTarget()
    )
  }
}

