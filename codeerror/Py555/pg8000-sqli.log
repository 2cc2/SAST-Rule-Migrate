/**
 * @name pg8000 SQL injection
 * @description Detects string concatenation with non-literal variables in pg8000 SQL statements
 * @kind problem
 * @id python/pg8000-sqli
 * @security-severity 8.8
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class Pg8000Call extends DataFlow::CallNode {
  Pg8000Call() {
    exists(Method m | 
      this.getCallee() = m and
      m.getDeclaringType().getNamespace().matches("pg8000") and
      m.getDeclaringType().getName() matches "Connection|Cursor" and
      m.getName() matches "run|execute|executemany|prepare"
    )
  }

  override predicate isSink(DataFlow::Node sink) { this.getArgument(0) = sink }
}

class StringConcat extends DataFlow::BinaryExpr {
  StringConcat() {
    this.getOperator() = "+" and
    (
      this.getLeftOperand().getType() = stringType() or
      this.getRightOperand().getType() = stringType()
    )
  }
}

class FormatString extends DataFlow::CallNode {
  FormatString() {
    exists(Method m |
      this.getCallee() = m and
      (
        m.getName() = "format" or
        m.getName() matches "%"
      )
    )
  }
}

class FString extends DataFlow::ExprNode { 
  FString() { this instanceof InterpolatedString } 
}

class UserInput extends DataFlow::Configuration {
  UserInput() { this = "RemoteFlowSource" }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "pg8000-sqli" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }

  override predicate isSink(DataFlow::Node sink) { sink = any(Pg8000Call pg8000).getSink() }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringConcat sc |
      sanitizer = sc and
      sc.getLeftOperand() instanceof Str and
      sc.getRightOperand() instanceof Str
    )
    or
    exists(FormatString fs | sanitizer = fs)
    or
    exists(FString fs | sanitizer = fs)
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringConcat sc |
      (sc.getLeftOperand() = pred and sc = succ) or
      (sc.getRightOperand() = pred and sc = succ)
    )
    or
    exists(FormatString fs | succ = fs and fs.getAnArgument() = pred)
    or
    exists(FString fs | succ = fs and fs.getAnInterpolant() = pred)
  }
}

