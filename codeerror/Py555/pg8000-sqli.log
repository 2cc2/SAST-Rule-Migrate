import python
import semmle.python.security.StringConcat
import semmle.python.security.SqlInjection
import semmle.python.security.Pg8000Query
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class Pg8000SqlInjectionConfiguration extends TaintTracking::Configuration {
  Pg8000SqlInjectionConfiguration() { this = "Pg8000SqlInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(string value |
      source.asExpr().(Literal).getStringValue() = value and
      regexpMatches(value, ".*")
    )
    or
    exists(string name |
      source.asExpr().(Name).getId() = name and
      regexpMatches(name, ".*")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall call |
      call.getMethod().(Member).getPackageName() = "pg8000" and
      (call.getMethod().(Member).getTypeName() = "Connection" or 
       call.getMethod().(Member).getTypeName() = "Cursor") and
      (call.getMethod().(Member).getName() = "run" or
       call.getMethod().(Member).getName() = "execute" or
       call.getMethod().(Member).getName() = "executemany" or
       call.getMethod().(Member).getName() = "prepare") and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(string concatExpr |
      (concatExpr = "\"\" + \"" or
       concatExpr = "\'\'.format()" or
       concatExpr = "\'%()") and
      sanitizer.asExpr().toString() = concatExpr
    )
  }
  
  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(string concatPattern |
      (concatPattern = "$VAR + $VAR" or
       concatPattern = "$VAR += $VAR" or
       concatPattern = "format()" or
       concatPattern = "%()" or
       concatPattern = "f-string") and
      exists(StringConcat concat | 
        concat.toString() = concatPattern and
        concat.getAnOperand() = node1.asExpr() and
        concat.getResult() = node2.asExpr()
      )
    )
  }
}

from Pg8000SqlInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection vulnerability due to string concatenation in pg8000 SQL statement", 
  source, "User input flows here"
