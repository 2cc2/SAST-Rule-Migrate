Rule Content:
/**
 * @name pg8000-sqli
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 *              Use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id py/pg8000-sqli
 */

import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts

class Pg8000Call extends DataFlow::CallNode {
  Pg8000Call() {
    exists(Method m | m = getTarget() |
      m.getPackage().getName() = "pg8000" and
      (m.getType().getName() = "Connection" or m.getType().getName() = "Cursor") and
      m.getName().matches("run|execute|executemany|prepare")
    )
  }
}

class SqlInjectionSink extends DataFlow::Node {
  SqlInjectionSink() {
    exists(Pg8000Call call | this = call.getArgument(0))
  }
}

class StringConcat extends DataFlow::ExprNode {
  StringConcat() {
    exists(string op |
      op = getOp() and
      (op = "+" or
       op.getValue().regexpMatch(".*format.*") or
       op.getValue().regexpMatch(".*%.*"))
    )
  }
}

class IsSanitized extends DataFlow::Node {
  IsSanitized() {
    exists(StringConcat concat | this = concat)
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "pg8000-sqli" }

  override predicate isSource(DataFlow::Node source) { source instanceof RemoteFlowSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlInjectionSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof IsSanitized }
}

