Rule Content:
/**
 * @id pg8000-sqli
 * @severity WARNING
 * @kind path-problem
 * @name SQL injection in pg8000 via string concatenation
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 *              Use parameterized queries or prepared statements instead.
 */

import python
import semmle.python.security.StringConcat
import semmle.python.security.SqlInjection
import semmle.python.Concepts
import semmle.python.ApiGraphs

class Pg8000SqlSource extends RemoteFlowSource::Range {
  Pg8000SqlSource() {
    this.asExpr().(VarRef).getVariable().getName().matches("%") or
    this.asExpr() = any(Literal literal | literal.getStringValue() != "")
  }
}

class Pg8000SqlSink extends SqlInjection::Sink {
  Pg8000SqlSink() {
    exists(MethodCall mc |
      mc.getMethodName() = ["run", "execute", "executemany", "prepare"] and
      exists(ClassObject cls |
        cls.getQualifiedName() = ["pg8000.Connection", "pg8000.Cursor"] and
        mc.getQualifier().getType() = cls.getType()
      ) and
      this = mc.getArgument(0)
    )
  }
}

class Pg8000SafeConcat extends StringConcat::Sanitizer {
  Pg8000SafeConcat() {
    exists(StringLiteral lit1, StringLiteral lit2 |
      (this.asExpr() = lit1.plus(lit2)) or
      (this.asExpr().(MethodCall).getMethodName() = "format" and
       this.asExpr().getQualifier().getType() = stringType()) or
      (this.asExpr().(BinaryOperation).getOperator() = "%" and
       this.asExpr().getLeftOperand().getType() = stringType())
    )
  }
}

class Pg8000StringExpr extends DataFlow::Node::Variable,
                         DataFlow::BinaryOperationExpr,
                         DataFlow::MethodCallExpr {
  Pg8000StringExpr() {
    exists(BinaryOperation binop |
      binop.getOperator() = "+" and
      this.asExpr() = binop
    ) or
    exists(MethodCall mc |
      mc.getMethodName() = "format" and
      this.asExpr() = mc
    ) or
    exists(BinaryOperation binop |
      binop.getOperator() = "%" and
      this.asExpr() = binop
    ) or
    exists(InterpolatedString itpl |
      this.asExpr() = itpl
    )
  }
}

query predicate edges(Pg8000StringExpr node1, Pg8000StringExpr node2) {
  DataFlow::localFlow(node1, node2)
}

from Pg8000SqlSource source, Pg8000SqlSink sink, Pg8000SafeConcat sanitizer
where TaintTracking::localTaint(source, sink) and
      not TaintTracking::localTaint(source, sanitizer)
select sink, "Potential SQL injection vulnerability due to unsafe string " +
       "concatenation in pg8000 database operation. Use parameterized queries " +
       "instead.", source, "User input flows into SQL query here"
