Rule Content:
/**
 * @name pg8000 SQL Injection
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 * @id pg8000-sqli
 * @kind path-problem
 * @severity Warning
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.WebAPIs

class Pg8000SqlExecution extends RemoteFlowSource::Range {
  Pg8000SqlExecution() {
    exists(Call call |
      call.getTarget().(Method).getAPIName() = ["run", "execute", "executemany", "prepare"] and
      call.getTarget().getDeclaringType().getName() = ["Connection", "Cursor"] and
      call.getTarget().getDeclaringType().getASource().getName() = "pg8000"
    )
  }
}

class UserInput extends TaintSource::Range {
  UserInput() {
    exists(Expr expr | expr = any(PrimitiveLiteral l | true) or expr = any(Identifier id | true))
  }
}

class StringConcatPropagator extends TaintPropagator::Range {
  override predicate propagates(DataFlow::Node from, DataFlow::Node to) {
    exists(BinaryExpr bin |
      bin.getOperator() = "+" and
      (bin.getLeftOperand().getAValue().getExpr() = from.asExpr() or bin.getRightOperand().getAValue().getExpr() = from.asExpr()) and
      to.asExpr() = bin
    )
    or
    exists(FormattedValue fmt |
      fmt.getAValue().getExpr() = from.asExpr() and
      to.asExpr().isParentOf(fmt)
    )
    or
    exists(BinaryOperation op |
      op.getOperator() = "+=" and
      op.getLeftOperand().getAValue().getExpr() = from.asExpr() and
      to.asExpr() = op
    )
  }
}

class SafeStringConcat extends Sanitizer::Range {
  SafeStringConcat() {
    exists(Call call |
      call.getTarget().getAPIName().matches("%%format") or
      call.getTarget().getAPIName().matches("%%mod") or
      exists(BinaryExpr bin |
        bin.getLeftOperand() instanceof PrimitiveLiteral and
        bin.getRightOperand() instanceof PrimitiveLiteral and
        bin.getOperator() = "+"
      )
    )
  }
}

from UserInput input, Pg8000SqlExecution sink, DataFlow::PathNode source, DataFlow::PathNode destination
where TaintTracking::localPath(source, destination) and
  input = source.getNode() and
  sink = destination.getNode() and
  not SafeStringConcat().protects(source.getNode(), _)
select sink, "Detected string concatenation with a non-literal variable in a pg8000 SQL statement. This could lead to SQL injection if the variable is user-controlled and not properly sanitized. Use parameterized queries or prepared statements instead."
