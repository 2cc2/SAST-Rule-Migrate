Rule Content:
/**
 * @name pg8000 SQL Injection
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pg8000-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.Strings

class Pg8000Call extends DataFlow::Node {
  Pg8000Call() {
    exists(MethodCall call |
      call.getTarget().hasQualifiedName("pg8000", "Connection", "run") or
      call.getTarget().hasQualifiedName("pg8000", "Cursor", "run") or
      call.getTarget().hasQualifiedName("pg8000", "Connection", "execute") or
      call.getTarget().hasQualifiedName("pg8000", "Cursor", "execute") or
      call.getTarget().hasQualifiedName("pg8000", "Connection", "executemany") or
      call.getTarget().hasQualifiedName("pg8000", "Cursor", "executemany") or
      call.getTarget().hasQualifiedName("pg8000", "Connection", "prepare") or
      call.getTarget().hasQualifiedName("pg8000", "Cursor", "prepare") |
      this.asExpr() = call.getArgument(0)
    )
  }
}

class StringSource extends DataFlow::Node {
  StringSource() {
    exists(DataFlow::Node node |
      node.asExpr().(StringLiteral).getText() != "" or
      node.asExpr() instanceof Name
    |
      this = node
    )
  }
}

class SafeStringFormat extends DataFlow::Node {
  SafeStringFormat() {
    exists(StringConcat concatenation |
      concatenation.getAnOperand() instanceof StringLiteral or
      exists(StringFormatting formatting |
        formatting.isConstant()
      )
    |
      this.asExpr() = concatenation or
      this.asExpr() = formatting
    )
  }
}

class Pg8000TaintConfig extends TaintTracking::Configuration {
  Pg8000TaintConfig() { this = "Pg8000TaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof Pg8000Call
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeStringFormat
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(StringConcat concatenation |
      concatenation.getAnOperand() = node1.asExpr() and
      concatenation = node2.asExpr()
    )
  }
}

from Pg8000TaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected string concatenation with a non-literal variable in a pg8000 SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized. " +
  "Use parameterized queries or prepared statements instead."
