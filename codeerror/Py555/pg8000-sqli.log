Rule Content:
/**
 * @name pg8000-sqli
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement. 
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 *              Use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id py/pg8000-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class Pg8000SQLiConfig extends TaintTracking::Configuration {
  Pg8000SQLiConfig() { this = "Pg8000SQLiConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(string pattern | regexMatches(pattern, source.asExpr().toString()) and pattern = ".*")    
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().matches("pg8000.%") and
      (
        call.getMethod().getName() = "run" or
        call.getMethod().getName() = "execute" or
        call.getMethod().getName() = "executemany" or
        call.getMethod().getName() = "prepare"
      ) and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(string code | code = sanitizer.asExpr().toString() |
      code = "\"..." + "...\"" or
      code.matches("'.*'.format%(%)") or
      code.matches("'.*'%(%)")
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(string code | code = node1.getNode().getExpr().toString() |
      code.matches("$X + $Y") or
      code.matches("$QUERY += $X") or
      code.matches("'.*'.format%(%.*%)") or
      code.matches("'.*'%(%.*%)") or
      code.matches("f'.*{%.*}.*'")
    )
  }
}

from Pg8000SQLiConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection vulnerability in pg8000 query"
