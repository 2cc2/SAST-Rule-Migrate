Rule Content:
/**
 * @name pg8000-sqli
 * @kind problem
 * @problem.severity warning
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 *              Use parameterized queries or prepared statements instead.
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Calls
import semmle.python.expressions.Operations
import semmle.python.expressions.String
import semmle.python.TypeConstraints
import DataFlow::PathGraph
import python.security.injection.SqlInjection

class Pg8000SqlSource extends RemoteFlowSource {
  Pg8000SqlSource() {
    exists(UserInput::Remote source | this = source.asSource())
  }
}

class Pg8000SqlSink extends DataFlow::Node {
  Pg8000SqlSink() {
    exists(Call call, string methodName |
      methodName = ["run", "execute", "executemany", "prepare"] and
      call.getCalleeName() = methodName and
      (
        call.getReceiverType().getQualifiedName() = "pg8000.Connection" or
        call.getReceiverType().getQualifiedName() = "pg8000.Cursor"
      ) and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class Pg8000SafeConcat extends DataFlow::Node {
  Pg8000SafeConcat() {
    exists(StringLiteral lit | this.asExpr() = lit) or
    exists(Call call | call.getCalleeName() = "format" and this.asExpr() = call) or
    exists(BinaryOperation binop |
      binop.getOp() = "+" and
      binop.getLeftOperand() instanceof StringLiteral and
      binop.getRightOperand() instanceof StringLiteral and
      this.asExpr() = binop
    ) or
    (this.asExpr().getType() = stringType() and
     exists(BinaryOperation binop | binop.getOp() = "%" and this.asExpr() = binop))
  }
}

class Pg8000StringExpr extends DataFlow::Node {
  Pg8000StringExpr() {
    exists(BinaryOperation binop |
      binop.getOp() = "+" and this.asExpr() = binop.getRightOperand()
    ) or
    exists(Call call |
      call.getCalleeName() = "format" and this.asExpr() = call
    ) or
    exists(BinaryOperation binop |
      binop.getOp() = "%" and this.asExpr() = binop
    ) or
    exists(StringLiteral lit |
      this.asExpr() = lit
    )
  }
}

from Pg8000SqlSource source, Pg8000SqlSink sink
where TaintTracking::localTaint(
  DataFlow::parameterNode(source),
  DataFlow::exprNode(sink),
  "pg8000 SQL injection"
)
and not exists(Pg8000SafeConcat safe | safe = source)
select sink, "Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement."
