Rule Content:
/**
 * @name pg8000 SQL Injection
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pg8000-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.StringOps
import semmle.python.Regex
import DataFlow::PathGraph

class Pg8000Connection extends API::Definition {
  Pg8000Connection() {
    exists(string module | module.regexMatch("pg8000") |
      this.getEnclosingModule().getAbsoluteName().matches(module + ".%")
    )
  }
}

class Pg8000SQLExecution extends API::Callable {
  Pg8000SQLExecution() {
    exists(string method | method =
      ["run", "execute", "executemany", "prepare"] |
      this.getName() = method and
      this.getACallableScope() instanceof Pg8000Connection
    )
  }
}

class UserInput extends TaintTracking::Source {
  UserInput() {
    exists(DataFlow::Node source | exists(source.asExpr()) |
      source.asExpr() instanceof Identifier or
      source.asExpr() instanceof Literal
    )
  }
}

class SqlExecutionSink extends TaintTracking::Sink {
  SqlExecutionSink() {
    exists(DataFlow::Node sink | exists(sink.asExpr()) |
      exists(MethodCall mc | mc = sink.asExpr() |
        mc.getTarget() instanceof Pg8000SQLExecution and
        mc.getAPositionalArgument(0) = sink.getExpr()
      )
    )
  }
}

class SafeStringConcatSanitizer extends TaintTracking::Sanitizer {
  SafeStringConcatSanitizer() {
    exists(DataFlow::Node sanitizer | exists(sanitizer.asExpr()) |
      exists(StringFormatOperation fmt | fmt = sanitizer.asExpr() |
        fmt instanceof StringLiteralFormat or
        fmt instanceof PercentFormat or
        fmt instanceof AddOperation
      )
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "pg8000 SQL Injection" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof UserInput
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof SafeStringConcatSanitizer
  }

  override predicate isAdditionalTaintStep(TaintTracking::TaintStep step) {
    exists(DataFlow::Node node1, node2 |
      step.getFromNode() = node1 and
      step.getToNode() = node2 and
      exists(StringFormatOperation fmt | fmt = node1.getExpr() | fmt.getAnOperand() = node2.getExpr())
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized. " +
  "Use parameterized queries or prepared statements instead."
