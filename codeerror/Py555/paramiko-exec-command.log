Rule Content:
/**
 * @name Paramiko exec_command Command Injection
 * @kind problem
 * @id python/paramiko-exec-command
 * @security-severity ERROR
 * @problem.severity error
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class ParamikoSSHClient extends DataFlow::ConfidenceNode {
  ParamikoSSHClient() {
    exists(Method m, Class c |
      m.hasName("exec_command") and
      c.hasName("SSHClient") and
      m.getAPackage().hasName("paramiko.client") and
      this = API::moduleImport("paramiko").getMember(c.getName()).getMember(m.getName())
    )
  }
}

class CommandSource extends DataFlow::ConfidenceNode {
  CommandSource() {
    exists(CallNode call |
      call.getTarget() = any(ParamikoSSHClient p | p) and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "ParamikoCommandInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof CommandSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ParamikoSSHClient and
    sink.asExpr() instanceof CallNode and
    exists(ParamikoSSHClient p | sink.asExpr().(CallNode).getTarget() = p)
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig config
where config.hasFlowPath(source, sink)
select sink, "Unverified SSL context detected. This will permit insecure connections without verifying SSL certificates. Use 'ssl.create_default_context()' instead.",
  source, "User-provided value flows to command execution"
