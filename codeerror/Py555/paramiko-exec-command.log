/**
 * @name Paramiko Command Injection
 * @description Detects potentially unsafe command execution via paramiko SSHClient.exec_command()
 * @id paramiko-exec-command
 * @kind path-problem
 * @severity error
 */

import python
import semmle.python.Concepts
import DataFlow::PathGraph

class ParamikoExecCommand extends DataFlow::Configuration {
  ParamikoExecCommand() { this = "ParamikoExecCommandConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodCall mc |
      mc.getTarget().getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
      mc.getArgument(0).getValue().regexpMatch("[^*]+") and
      source.asExpr() = mc.getArgument(0).getValueSource()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall mc |
      mc.getTarget().getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
      sink.asExpr() = mc.getArgument(0).getValueSource()
    )
  }
}

