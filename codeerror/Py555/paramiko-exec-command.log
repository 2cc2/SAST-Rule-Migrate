Rule Content:
/**
 * @name Paramiko unsafe exec_command usage
 * @description Detects potentially unsafe use of paramiko's exec_command without proper input validation
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.Concepts

class SSHSource extends DataFlow::Node {
  SSHSource() {
    exists(MethodCall call |
      call.getMethod().getName() = "exec_command" and
      call.getMethod().getDeclaringType().hasQualifiedName("paramiko.client", "SSHClient") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class CommandInjectionSink extends DataFlow::Node {
  CommandInjectionSink() {
    exists(MethodCall call |
      call.getMethod().getName() = "exec_command" and
      call.getMethod().getDeclaringType().hasQualifiedName("paramiko.client", "SSHClient") and
      this.asExpr() = call.getArgument(0) and
      not call.getArgument(0).getStringValue().regexpMatch("\\.\\.\\.")
    )
  }
}

class ParamikoExecCommandConfig extends TaintTracking::Configuration {
  ParamikoExecCommandConfig() { this = "ParamikoExecCommandConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SSHSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CommandInjectionSink }
}

from ParamikoExecCommandConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "Unsanitized input to paramiko exec_command may lead to command injection",
  source.getNode(), "This input flows to the command"
