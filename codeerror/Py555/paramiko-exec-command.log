Rule Content:
/**
 * @id paramiko-exec-command
 * @name Unverified SSL context in paramiko exec_command
 * @description Detects unverified SSL context in paramiko exec_command calls.
 * @kind path-problem
 * @problem.severity ERROR
 * @message Unverified SSL context detected. This will permit insecure connections without verifying SSL certificates. Use 'ssl.create_default_context()' instead.
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.ApiGraphs

class ParamikoExecCommandCall extends API::Call {
  ParamikoExecCommandCall() {
    this.getTarget().hasGlobalValue("paramiko.client.SSHClient") and
    this.getTarget().hasName("exec_command")
  }
}

class TaintedCommandSource extends DataFlow::Node {
  TaintedCommandSource() {
    exists(ParamikoExecCommandCall call |
      this.asParameter() = call.getArgument(0)
    )
    and
    not this.getStringValue().regexpMatch("\"\.\.\.\"")
  }
}

class CommandInjectionSink extends DataFlow::Node {
  CommandInjectionSink() {
    exists(ParamikoExecCommandCall call |
      this = call.getArgument(0)
    )
  }
}

class ParamikoTaintConfig extends TaintTracking::Configuration {
  ParamikoTaintConfig() { this = "ParamikoExecCommandTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof TaintedCommandSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CommandInjectionSink
  }
}

from ParamikoTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Unverified SSL context detected. This will permit insecure connections " +
  "without verifying SSL certificates. Use 'ssl.create_default_context()' instead."
