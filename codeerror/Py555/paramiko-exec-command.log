/**
 * @name Paramiko SSH command injection
 * @description Dangerous SSH command execution where argument is user-controlled
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 */

import python
import semmle.python.security.Paramiko
import semmle.python.dataflow.TaintTracking

class ParamikoSSHClientSource extends DataFlow::SourceNode {
  ParamikoSSHClientSource() {
    exists(Method m, Call call |
      m.getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
      call = m.getACall().getExpr() and
      this.asSourceNode() = call.getArgument(0).getExpr()
    )
  }
}

class CommandInjectionSink extends DataFlow::SinkNode {
  CommandInjectionSink() {
    exists(Method m, Call call |
      m.getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
      call = m.getACall().getExpr() and
      this.asSinkNode() = call.getArgument(0).getExpr()
    )
  }
}

class ParamikoTaintConfig extends DataFlow::Configuration {
  ParamikoTaintConfig() { this = "ParamikoSSHCommandTaintConfig" }

  override predicate isSource(DataFlow::SourceNode source) {
    source instanceof ParamikoSSHClientSource
  }

  override predicate isSink(DataFlow::SinkNode sink) {
    sink instanceof CommandInjectionSink
  }
}

from ParamikoTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential command injection via unverified SSHClient.exec_command argument from $@.",
  source, "user-provided value"
