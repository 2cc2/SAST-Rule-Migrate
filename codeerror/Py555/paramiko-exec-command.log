/**
 * @name Unverified SSL context in paramiko
 * @description Detects use of unverified SSL context in paramiko client
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.ApiGraphs

class ParamikoSSHClientSource extends TaintTracking::TaintSource {
  ParamikoSSHClientSource() {
    exists(Method m |
      m.getDeclaringType().hasName("SSHClient") and
      m.getDeclaringType().getAPackage().hasName("paramiko.client") and
      m.hasName("exec_command") and
      this.asExpr() = m.getACall()
    )
  }
}

class CommandInjectionSink extends TaintTracking::TaintSink {
  CommandInjectionSink() {
    exists(Method m, Call call |
      m.getDeclaringType().hasName("SSHClient") and
      m.getDeclaringType().getAPackage().hasName("paramiko.client") and
      m.hasName("exec_command") and
      call.getTarget() = m and
      call.getArgument(0).getStringValue() != "\"..." and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class ParamikoTaintConfig extends TaintTracking::Configuration {
  ParamikoTaintConfig() { this = "ParamikoTaintConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof ParamikoSSHClientSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof CommandInjectionSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    none()
  }
}

from ParamikoTaintConfig cfg, TaintTracking::PathNode source, TaintTracking::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink,
  "Unverified SSL context detected. This will permit insecure connections without verifying SSL certificates. " +
  "Use 'ssl.create_default_context()' instead."
