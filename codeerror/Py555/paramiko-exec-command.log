Rule Content:
/**
 * @name Paramiko exec_command unverified SSL context
 * @description Detects unverified SSL context in Paramiko SSHClient.exec_command calls
 * @id paramiko-exec-command
 * @kind path-problem
 * @problem.severity error
 * @precision high
 */

import python
import semmle.python.security.Paramiko
import semmle.python.security.injection.CommandInjection
import DataFlow::PathGraph

class ParamikoCommandSource extends DataFlow::Node {
  ParamikoCommandSource() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
      call.getArgument(0).getStringValue() != "\"..." and
      this.asExpr() = call.getArgument(0)
    )
  }

  override string toString() { result = "Parameter to paramiko.client.SSHClient.exec_command" }
}

predicate isSanitizer(DataFlow::Node node) {
  none()
}

query predicate edges(DataFlow::Node node1, DataFlow::Node node2) {
  exists(MethodCall call |
    call.getMethod().getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
    node1.asExpr() = call.getArgument(0) and
    node2.asExpr() = call
  )
}

from ParamikoCommandSource source, CommandInvocationSink sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where
  exists(CommandInjectionConfig conf |
    conf.hasFlowPath(source, sink) and
    conf.hasSanitizer(isSanitizer) and
    conf.hasFlowStep(edges) and
    sourceNode = conf.getSource() and
    sinkNode = conf.getSink()
  )
select sinkNode, "Unverified SSL context detected. This will permit insecure connections without " +
  "verifying SSL certificates. Use 'ssl.create_default_context()' instead.", sourceNode, sinkNode,
  "Potential command injection vulnerability"
