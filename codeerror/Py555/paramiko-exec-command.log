Rule Content:
/**
 * @name Unsafe paramiko exec_command usage
 * @description Detects potentially unsafe exec_command calls in paramiko without proper sanitization
 * @kind path-problem
 * @problem.severity error
 * @id py/paramiko-exec-command
 */
import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class ParamikoSSHClinetExecCommand extends DataFlow::Node {
  ParamikoSSHClinetExecCommand() {
    exists(Call call |
      call.getCallee().(Method).getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class ParamikoTaintConfig extends TaintTracking::Configuration {
  ParamikoTaintConfig() { this = "ParamikoTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      call.getCallee().(Method).getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
      source.asExpr() = call.getArg(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCallee().(Method).getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
      sink.asExpr() = call.getArg(0)
    )
  }
}

from ParamikoTaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Unverified command execution detected in paramiko exec_command. " +
  "This could lead to command injection vulnerabilities.", source,
  "User-controlled input flows to exec_command call here"
