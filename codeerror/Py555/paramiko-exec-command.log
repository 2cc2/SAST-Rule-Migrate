import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.TaintTracking

private class ParamikoExecCommandCall extends API::Node::Call {
  ParamikoExecCommandCall() {
    this.getCallable() instanceof FunctionValue and
    this.getCallable().getAPINode() = 
      apiNode("paramiko.client", "SSHClient", "exec_command")
  }
}

private class TaintedCommandSource extends TaintTracking::TaintSource {
  TaintedCommandSource() { this instanceof ParamikoExecCommandCall }

  override predicate isSource(TaintTracking::TaintSource source) {
    exists(TaintedCommandSource cmd |
      source = cmd and
      not cmd.getArgument(0).getStringValue().regexpMatch("\\.\\.\\.")
    )
  }

  override Configuration getConfiguration() { result = "SSH command source" }

  string getLocation() { result = this.getLocation().toString() }
  BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  string toString() { result = "Command source: " + this.toString() }
  DataFlow::Scope getScope() { result = this.getScope() }
  Variable getVariable() { result = this.asVariable() }
  CfgNode asCfgNode() { result = this.asCfgNode() }
}

private class CommandInjectionSink extends TaintTracking::TaintSink {
  CommandInjectionSink() { this instanceof ParamikoExecCommandCall }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(CommandInjectionSink cmd | sink = cmd)
  }

  override Configuration getConfiguration() { result = "Command injection sink" }

  string getLocation() { result = this.getLocation().toString() }
  BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  string toString() { result = "Command sink: " + this.toString() }
  DataFlow::Scope getScope() { result = this.getScope() }
  Variable getVariable() { result = this.asVariable() }
  CfgNode asCfgNode() { result = this.asCfgNode() }
}

class ParamikoExecCommandFlow extends TaintTracking::TaintTrackingConfiguration {
  ParamikoExecCommandFlow() { this = "Paramiko exec command injection" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof TaintedCommandSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof CommandInjectionSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    none()
  }

  override predicate propagates(TaintTracking::TaintSource source, 
                              TaintTracking::TaintSink sink, 
                              TaintTracking::PathNode from, 
                              TaintTracking::PathNode to) {
    exists(ParamikoExecCommandCall call |
      from.getNode() = call and
      to.getNode() = call.getArgument(0)
    )
  }
}

from TaintedCommandSource source, CommandInjectionSink sink
where any(ParamikoExecCommandFlow conf).flow(source, sink)
select sink, "Unsafe command execution using user input via Paramiko SSHClient.exec_command"
