/**
 * @name Paramiko Exec Command Injection
 * @description Unverified SSL context detected. This will permit insecure connections
 *              without verifying SSL certificates. Use 'ssl.create_default_context()' instead.
 * @kind path-problem
 * @problem.severity error
 * @id py/paramiko-exec-command
 */

import python
import semmle.python.security.CommandInjection
import semmle.python.Concepts
import semmle.python.ApiGraphs

class ParamikoExecCommand extends CommandInjection::Range {
  ParamikoExecCommand() {
    exists(MethodCall call |
      call.getMethod().getAPIName() = "exec_command" and
      call.getMethod().getDeclaringType().getAPIName() = "SSHClient" and
      call.getMethod().getDeclaringType().getPackage().getAPIName() = "paramiko.client" and
      call.getAnArg() != "\"..." and
      this = call.getAnArg().getValue()
    )
  }
}

from ParamikoExecCommand source, DataFlow::Node sink
where CommandInjection::commandInjection(source, sink)
select sink, "Potential command injection vulnerability due to unverified paramiko SSHClient exec_command"
