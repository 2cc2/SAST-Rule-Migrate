Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally 
 *              bypassing secure methods of rendering HTML by manually constructing HTML 
 *              and this could create a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-response
 */

import python
import semmle.python.dataflow.new.TaintTracking
import python.web.HttpResponse

class EventParamSource extends TaintTracking::TaintSource {
  EventParamSource() {
    exists(Parameter p | 
      p.getName() = "event" and
      this.asParameter() = p
    )
  }

  override predicate isSourceOfTaint(DataFlow::Node src) {
    exists(Parameter p |
      p.getName() = "event" and
      DataFlow::parameterNode(p, src)
    )
  }
}

class HtmlResponseSink extends TaintTracking::TaintSink {
  HtmlResponseSink() {
    exists(HttpResponse resp |
      resp.getContentType() = "text/html" and
      DataFlow::sourceNode(this.asTaintNode(), resp.getValue())
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(HttpResponse resp |
      resp.getContentType() = "text/html" and
      DataFlow::sourceNode(sink, resp.getValue())
    )
  }
}

class HtmlResponseFlowConfig extends TaintTracking::Configuration {
  HtmlResponseFlowConfig() { this = "HtmlResponseFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlResponseSink
  }
}

from HtmlResponseFlowConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected user input flowing into an HTML response. This might cause XSS vulnerability."
