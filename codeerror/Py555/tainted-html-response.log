Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability, which could let attackers steal sensitive user data.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-response
 */

import python
import DataFlow::PathGraph

class HtmlResponseConfig extends DataFlow::Configuration {
  HtmlResponseConfig() { this = "HtmlResponseConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter param | 
      param.getName() = "event" and
      source.asParameter() = param
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(string contentType |
      contentType = "text/html" and
      sink.getNode().asExpr().getType().hasName(contentType)
    )
  }

  override predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    node1.asExpr() = node2.asExpr() and
    node1.getBasicBlock() = node2.getBasicBlock()
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, HtmlResponseConfig config
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential XSS vulnerability: user input flows into HTML response."
