Rule Content:
/**
 * @name Tainted HTML response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing secure 
 * methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting 
 * vulnerability, which could let attackers steal sensitive user data.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-response
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class EventParam extends Parameter, TaintTracking::TaintSource {
  EventParam() {
    this.getName() = "event"
  }

  override predicate isSource(TaintTracking::TaintSource src) { src = this }

  // Required interface implementations
  CfgNode asCfgNode() { result = this }
  Location getLocation() { result = this.getLocation() }
  BasicBlock getBasicBlock() { none() }
  string toString() { result = this.toString() }
  Scope getScope() { result = this.getScope() }
  Variable asVariable() { none() }
}

class HtmlResponseSink extends DataFlow::Node, TaintTracking::TaintSink {
  HtmlResponseSink() {
    exists(ReturnStmt ret |
      ret = this.getBasicBlock().getStmt() and
      ret.getResult().toString().matches("%text/html%")
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) { sink = this }

  // Required interface implementations
  CfgNode asCfgNode() { result = this.getBasicBlock() }
  Location getLocation() { result = this.getLocation() }
  BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  string toString() { result = this.toString() }
  Scope getScope() { result = this.getScope() }
  Variable asVariable() { none() }
}

class TaintedHtmlResponseConfig extends TaintTracking::Configuration {
  TaintedHtmlResponseConfig() { this = "TaintedHtmlResponseConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof EventParam
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof HtmlResponseSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where any(TaintedHtmlResponseConfig cfg).hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user input flowing into an HTML response. Potential XSS vulnerability."
