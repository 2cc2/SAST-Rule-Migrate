Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing secure methods 
 * of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability.
 * @id tainted-html-response
 * @kind path-problem
 * @security-severity 8.0
 * @tags security
 *       external/cwe/cwe-079
 */
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class EventParam extends DataFlow::ParameterNode {
  EventParam() { 
    this.getName() = "event" 
  }

  override predicate isSource() { this = any(DataFlow::ParameterNode p | p.getName() = "event") }

  /* Implement abstract methods */
  override DataFlow::CfgNode asCfgNode() { result = this }
  override Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override DataFlow::ScopeNode getScope() { result = this.getScope() }
  override DataFlow::Variable asVariable() { result = this.asVariable() }
}

class HtmlResponseSink extends DataFlow::Node {
  HtmlResponseSink() {
    exists(Return r |
      result.asExpr() = r.getResult().getExpr() and
      r.getFunction().getAnAnnotation().toString() = "text/html"
    )
  }

  override predicate isSink() {
    exists(Return r |
      this.asExpr() = r.getResult().getExpr() and
      r.getFunction().getAnAnnotation().toString() = "text/html"
    )
  }

  /* Implement abstract methods */
  override DataFlow::CfgNode asCfgNode() { result = this }
  override Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override DataFlow::ScopeNode getScope() { result = this.getScope() }
  override DataFlow::Variable asVariable() { result = this.asVariable() }
}

class TaintedHtmlResponseConfig extends TaintTracking::Configuration {
  TaintedHtmlResponseConfig() { this = "TaintedHtmlResponseConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlResponseSink
  }

  override predicate isExtension(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2) or
    exists(DataFlow::CallEdge edge | edge.getSource() = node1 and edge.getTarget() = node2)
  }
}

from TaintedHtmlResponseConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected user input flowing into an HTML response. This may create XSS vulnerabilities."
