Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing 
 *              secure methods of rendering HTML by manually constructing HTML and this could create 
 *              a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-html-response
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.HttpRequest

class TaintedHtmlResponseConfig extends TaintTracking::Configuration {
  TaintedHtmlResponseConfig() { this = "TaintedHtmlResponseConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter param |
      param.getName() = "event" and
      source.asParameter() = param
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Return ret, string contentType |
      ret.getValue() = sink.asExpr() and
      contentType = ret.getAValue().(HttpResponse).getHeader("Content-Type") and
      contentType.indexOf("text/html") >= 0
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedHtmlResponseConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected user input flowing into an HTML response. This could lead to XSS vulnerabilities."
