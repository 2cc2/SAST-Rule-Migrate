Rule Content:
/** 
    @id tainted-html-response
    @kind problem
    @severity warning
    @description Detected user input flowing into an HTML response. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability, which could let attackers steal sensitive user data.
*/

import python
import semmle.python.TaintTracking
import semmle.python.functions.Parameter
import semmle.python.web.HttpHeaders

/** The source where user input is received via event parameter. */
class EventParam extends TaintTracking::TaintSource {
  Parameter param;

  EventParam() {
    exists(string name |
      param = Parameter::getAParameter() and
      name = param.getName() and
      name = "event"
    )
  }

  override predicate isSourceOfTaint(TaintTracking::TaintSource source) {
    source = this
  }

  override string getLocation() { result = param.getLocation() }
  override string toString() { result = param.toString() }
}

/** The sink where HTML is returned in the response. */
class HtmlResponseSink extends TaintTracking::TaintSink {
  FunctionReturn ret;

  HtmlResponseSink() {
    exists(ContentType contentType |
      ret = FunctionReturn::getAReturn() and
      contentType = ContentType::getContentType(ret) and
      contentType.getType() = "text/html"
    )
  }

  override predicate isSinkOfTaint(TaintTracking::TaintSink sink) {
    sink = this
  }

  override string getLocation() { result = ret.getLocation() }
  override string toString() { result = ret.toString() }
}

/** Taint tracking configuration detecting flow from event parameter to HTML response. */
class TaintedHtmlResponseConfig extends TaintTracking::Configuration {
  TaintedHtmlResponseConfig() { this = "TaintedHtmlResponseConfig" }

  override predicate isSource(TaintTracking::Source source) { source instanceof EventParam }
  override predicate isSink(TaintTracking::Sink sink) { sink instanceof HtmlResponseSink }
}

from TaintedHtmlResponseConfig config, EventParam source, HtmlResponseSink sink
where config.hasFlow(source, sink)
select sink, "Detected user input flowing into an HTML response, potential XSS vulnerability"
