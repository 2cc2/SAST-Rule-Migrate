Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing 
 *              secure methods of rendering HTML by manually constructing HTML and this could create 
 *              a cross-site scripting vulnerability, which could let attackers steal sensitive user data.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-html-response
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.HttpResponse

class HtmlResponseSink extends DataFlow::Node {
  HtmlResponseSink() {
    exists(FunctionReturn ret |
      ret.getValue().getContentType() = "text/html" and
      this.asExpr() = ret.getValue()
    )
  }
}

class EventParamSource extends DataFlow::Node {
  EventParamSource() {
    exists(Parameter param |
      param.getName() = "event" and
      this.asParameter() = param
    )
  }
}

class HtmlResponseFlowConfig extends TaintTracking::Configuration {
  HtmlResponseFlowConfig() { this = "HtmlResponseFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlResponseSink
  }
}

from HtmlResponseFlowConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected user input flowing into an HTML response. You may be accidentally " +
  "bypassing secure methods of rendering HTML by manually constructing HTML " +
  "and this could create a cross-site scripting vulnerability.", source, 
  "User input originates from here"
