Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing 
 * secure methods of rendering HTML by manually constructing HTML and this could create a 
 * cross-site scripting vulnerability, which could let attackers steal sensitive user data.
 * @kind taint
 * @problem.severity warning
 * @id python/tainted-html-response
 */

import python
import semmle.python.security.TaintTracking
import DataFlow

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(Parameter p |
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class HtmlResponseSink extends DataFlow::Node {
  HtmlResponseSink() {
    exists(FunctionReturn ret |
      ret.getContentType() = "text/html" and
      this.asExpr() = ret
    )
  }
}

class TaintedHtmlResponseConfig extends TaintTracking::Configuration {
  TaintedHtmlResponseConfig() { this = "TaintedHtmlResponse" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlResponseSink
  }
}

from TaintedHtmlResponseConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
