/**
 * @name SQLAlchemy SQL Injection via Lambda event
 * @description Detected SQL statement that is tainted by `event` object.
 *              This could lead to SQL injection if the variable is user-controlled
 *              and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/sqlalchemy-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Method method, Parameter p |
      method.getName() = "$HANDLER" and
      p = method.getAParameter() and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() {
    exists(Call call, Name n |
      call.getFunc() = n and
      n.getTarget().(Method).getName() = "execute" and
      n.getTarget().(Method).getDeclaringType().getQualifiedName() = "sqlalchemy.Cursor" and
      this = call.getArg(0)
    )
  }
}

class SqlalchemySQLIRouting extends TaintTracking::Configuration {
  SqlalchemySQLIRouting() { this = "SqlalchemySQLIRouting" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaEventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecuteSink }
}

from SqlalchemySQLIRouting cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
