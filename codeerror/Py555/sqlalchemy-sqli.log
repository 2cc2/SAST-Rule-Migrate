import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      f.getName() = "$HANDLER" and
      p = f.getAParameter() and
      p.getName() = "event" and
      p = this.asParameter()
    )
  }
}

class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() {
    exists(Call call |
      call.getFunc().(Attribute).getAttr() = "execute" and
      call.getFunc().(Attribute).getReceiver().getType().getName() = "Cursor" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class SqlAlchemyConfig extends TaintTracking::Configuration {
  SqlAlchemyConfig() { this = "SqlAlchemyConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteSink
  }
}

