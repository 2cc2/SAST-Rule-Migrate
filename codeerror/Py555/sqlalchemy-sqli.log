Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Method m, Parameter p |
      m.getName() = "$HANDLER" and
      p.getName() = "event" and
      p.getScope() = m and
      this.asParameter() = p
    )
  }
}

class SQLExecuteSink extends DataFlow::Node {
  SQLExecuteSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getQualifier().getType().getName() = "Cursor" and
      ma.getQualifier().getType().getModule().getName() = "sqlalchemy" and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SQLAlchemySQLInjectionConfiguration extends TaintTracking::Configuration {
  SQLAlchemySQLInjectionConfiguration() { this = "SQLAlchemySQLInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaEventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SQLExecuteSink }
}

from SQLAlchemySQLInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "SQL statement is tainted by un sanitized event parameter"
