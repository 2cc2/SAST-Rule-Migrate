/**
 * @name SQLAlchemy SQL Injection
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Function f |
      f.getName() = "$HANDLER" and
      this = f.getParameter(0) and
      this.getName() = "event"
    )
  }
}

class SQLExecuteSink extends DataFlow::Node {
  SQLExecuteSink() {
    exists(Call call |
      call = this.getCall() and
      call.getFunc().(Attribute).getBase().getType().toString() = "sqlalchemy.Cursor" and
      call.getFunc().getName() = "execute" and
      this = call.getArgument(0)
    )
  }
}

class SqlAlchemyConfig extends TaintTracking::Configuration {
  SqlAlchemyConfig() { this = "SqlAlchemyConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLExecuteSink
  }
}

