Rule Content:
/**
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 * @name SQL Injection in SQLAlchemy
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class LambdaEventSource extends TaintTracking::TaintSource {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      f.getName() = "$HANDLER" and
      p = f.getParameter(0) and
      p.getName() = "event" and
      this.asSource(p)
    )
  }

  override string getSourceType() { result = "Lambda event handler parameter" }
}

class SQLAlchemySink extends TaintTracking::TaintSink {
  SQLAlchemySink() {
    exists(Call call, Module m |
      m.isImported("sqlalchemy") and
      call = m.getMember("Cursor").getMember("execute").getACall() and
      call.getArgument(0) = this.asSink()
    )
  }

  override string getSinkType() { result = "SQLAlchemy execute call" }
}

class SQLAlchemyTaintConfig extends TaintTracking::Configuration {
  SQLAlchemyTaintConfig() { this = "SQLAlchemy SQL injection" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SQLAlchemySink
  }
}

from SQLAlchemyTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "SQL statement is tainted by event object, possible SQL injection"
