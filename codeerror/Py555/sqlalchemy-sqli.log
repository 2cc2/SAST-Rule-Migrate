/**
 * @name SQLAlchemy SQL Injection
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection.
 * @kind problem
 * @id python/sqlalchemy-sqli
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import DataFlow::TaintTracking

class LambdaEventSource extends TaintTracking::TaintSource, DataFlow::Node {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      f.getName() = "$HANDLER" and
      p = f.getParameter(0) and
      p.getName() = "event" and
      this = DataFlow::parameterNode(p)
    )
  }

  override Predicate asCfgNode() { this.(DataFlow::Node).asCfgNode() }
  override Location getLocation() { this.(DataFlow::Node).getLocation() }
  override BasicBlock getBasicBlock() { this.(DataFlow::Node).getBasicBlock() }
  override string toString() { this.(DataFlow::Node).toString() }
  override Element getScope() { this.(DataFlow::Node).getScope() }
  override Variable asVariable() { this.(DataFlow::Node).asVariable() }
}

class SQLExecuteSink extends TaintTracking::TaintSink, DataFlow::Node {
  SQLExecuteSink() {
    exists(Call ma |
      ma.getTarget().hasQualifiedName("sqlalchemy.Cursor", "execute") and
      this = DataFlow::exprNode(ma.getArgument(0))
    )
  }

  override Predicate asCfgNode() { this.(DataFlow::Node).asCfgNode() }
  override Location getLocation() { this.(DataFlow::Node).getLocation() }
  override BasicBlock getBasicBlock() { this.(DataFlow::Node).getBasicBlock() }
  override string toString() { this.(DataFlow::Node).toString() }
  override Element getScope() { this.(DataFlow::Node).getScope() }
  override Variable asVariable() { this.(DataFlow::Node).asVariable() }
}

from LambdaEventSource source, SQLExecuteSink sink
where TaintTracking::localTaint(source, sink)
select sink, "SQL statement is tainted by event object, potential SQL injection."
