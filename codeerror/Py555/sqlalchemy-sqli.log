/**
 * @name SQL Injection in SQLAlchemy execute
 * @description Detected SQL statement that is tainted by `event` object.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 */

import python
import semmle.python.dataflow.new.DataFlow
import python.sqlalchemy.SqlInjection

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Function myFunction |
      myFunction.getParameter("event") = this.asParameter()
    )
  }
}

class SqlAlchemyExecutionSink extends DataFlow::Node {
  SqlAlchemyExecutionSink() {
    exists(CallNode call |
      call = this.asExpr() and
      call.getFunc().(Member).getName() = "execute" and
      call.getFunc().getQualifier().getType().hasQualifiedName("sqlalchemy", "Cursor") 
    )
  }
}

