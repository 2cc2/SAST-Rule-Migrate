Rule Content:
/**
 * @name SQLAlchemy SQL Injection via Lambda Event
 * @description Detects SQL statements that are tainted by AWS Lambda `event` objects,
 *              which could lead to SQL injection if user-controlled input is not sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id python/sqlalchemy-lambda-event-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.security.dataflow.SqlAlchemy
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Function myFunction, Parameter myParam |
      myParam = myFunction.getAParameter() and
      myParam.getName() = "event" and
      myFunction.getName().matches("%HANDLER%") and
      exists(myFunction.getADecorator() dec | dec.getName() = "LambdaJSONResponse") and
      myParam.asSource() = this
    )
  }
}

class SqlAlchemyExecutionSink extends DataFlow::Node {
  SqlAlchemyExecutionSink() {
    exists(MethodCall mc |
      mc.getMethodName() = "execute" and
      mc.getQualifier().getType().hasQualifiedName("sqlalchemy", "Cursor") and
      mc.getAnArgument() = this
    )
  }
}

from LambdaEventSource source, SqlAlchemyExecutionSink sink
where DataFlow::localFlow(source, sink)
select sink, "Potential SQL injection from Lambda event object in SQLAlchemy execute call", 
  source, "User input comes from here"
