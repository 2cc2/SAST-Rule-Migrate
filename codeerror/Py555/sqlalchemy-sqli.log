Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class LambdaEventSource extends TaintTracking::Source {
  LambdaEventSource() {
    exists(Function handler | 
      handler.getName() = "$HANDLER" and
      exists(Parameter p | 
        p = handler.getPositionalParameter(0) and
        p.getName() = "event" and
        this = p.asParameter()
      )
    )
  }

  override string getSourceType() {
    result = "Lambda event parameter"
  }
}

class SQLAlchemySink extends TaintTracking::Sink {
  SQLAlchemySink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getQualifier().getType().getName() = "Cursor" and
      exists(Module m | 
        m.isImported("sqlalchemy") and
        this = ma.getArg(0).asExpr()
      )
    )
  }

  override string getSinkType() {
    result = "SQLAlchemy cursor execute call"
  }
}

class SQLAlchemyTaintConfig extends TaintTracking::Configuration {
  SQLAlchemyTaintConfig() { this = "SQLAlchemy SQL Injection" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof SQLAlchemySink
  }
}

from SQLAlchemyTaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection."
