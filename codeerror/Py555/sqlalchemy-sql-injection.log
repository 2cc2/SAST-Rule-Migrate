Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy 
 *              can cause SQL injections if raw SQL is passed with unsafe user input.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.frameworks.sqlalchemy.Query

class UserInput extends DataFlow::Node, TaintSource {
  UserInput() {
    exists(FunctionValue f, Parameter p |
      p = API::parameterWithName(f, "%VAR%") and
      this.asExpr() = p.getAnAccess().getAnArg()
    )
  }

  override predicate isSrc() { this = any(UserInput i | i = this) }
}

class SqlFunctionCall extends DataFlow::Node, TaintSink {
  SqlFunctionCall() {
    exists(MethodCall mc |
      (
        mc.getMethod().hasName(["group_by", "order_by", "distinct", "having", "filter"]) and
        mc.getReceiver().toString().matches("%.query%") and
        this.asExpr() = mc.getArgument(0)
      )
    )
  }

  override predicate isSink() { this = any(SqlFunctionCall s | s = this) }
}

class BindParamsSanitizer extends DataFlow::Node, Sanitizer {
  BindParamsSanitizer() {
    exists(MethodCall mc |
      mc.getMethod().hasName("bindparams") and
      this.asExpr() = mc
    )
  }

  override predicate isSanitizer() { this = any(BindParamsSanitizer s | s = this) }
}

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SQLAlchemy SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlFunctionCall }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof BindParamsSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::CallEdge edge |
      edge.getCall().getMethod().hasName("bindparams") or
      edge.getSource() = node1 and edge.getDestination() = node2
    )
  }
}

from SqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential SQL injection in SQLAlchemy query method due to unsafe ${source}.", 
  source, "User input flows here"
