Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause SQL injections
 *              if the developer inputs raw SQL into these clauses and injects user-input without sanitization.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class SqlFunctionCall extends DataFlow::Node {
  SqlFunctionCall() {
    exists(Call call |
      call = any(Call c | 
        c.getMethodName() = "group_by" or
        c.getMethodName() = "order_by" or
        c.getMethodName() = "distinct" or
        c.getMethodName() = "having" or
        c.getMethodName() = "filter"
      ).getACall() |
      this.asExpr() = call.getArgument(0)
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p | this.asExpr() = p)
  }
}

class BindParamsSanitizer extends DataFlow::Node {
  BindParamsSanitizer() {
    exists(Call call |
      call.getMethodName() = "bindparams" and
      this.asExpr() = call
    )
  }
}

predicate isSource(DataFlow::Node source) {
  source instanceof UserInputSource
}

predicate isSink(DataFlow::Node sink) {
  sink instanceof SqlFunctionCall
}

additional predicate isSanitizer(DataFlow::Node sanitizer) {
  sanitizer instanceof BindParamsSanitizer
}

additional predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
  exists(Call call |
    call.getMethodName() != "bindparams" and
    node1.asExpr().(Parameter).getCall() = call and
    node2.asExpr() = call.getArgument(0)
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  TaintTracking::localPath(source, sink) and
  isSource(source.getNode()) and
  isSink(sink.getNode())
select sink.getNode(), source, sink, "Potential SQL injection in SQLAlchemy query method"
