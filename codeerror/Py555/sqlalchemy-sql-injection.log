Rule Content:
/**
 * @id sqlalchemy-sql-injection
 * @severity Warning
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy 
 *              can cause sql injections if the developer inputs raw SQL into 
 *              these clauses with unsafe user input formatting.
 */
import python
import DataFlow::PathGraph

class SqlAlchemyQuery extends DataFlow::Node {
  SqlAlchemyQuery() {
    exists(string methodName | 
      methodName.regexpMatch("(group_by|order_by|distinct|having|filter)") |
      this.asExpr() = 
        API::getNamedArgForCall(API::getCallForNamedArg(_, methodName)).getExpr()
    ) or
    this.asExpr().(Call).getTarget().getName().regexpMatch("(group_by|order_by|distinct|having|filter)")
  }
}

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(Function::Parameter p |
      p.getName().regexpMatch("^\\$.*\\$$") and
      this.asParameter() = p
    )
  }
}

class SafeSqlBinding extends DataFlow::Node {
  SafeSqlBinding() {
    exists(Call c |
      c.getTarget().getName() = "bindparams" and
      this.asExpr() = c
    )
  }
}

class SqlInjectionConfig extends DataFlow::Configuration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlAlchemyQuery and
    not exists(SafeSqlBinding safe | DataFlow::localFlow(source, safe))
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeSqlBinding
  }
}

from SqlInjectionConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Potential SQL injection in SQLAlchemy query", source, 
  "This user input flows into a SQLAlchemy query clause without proper sanitization"
================================================================================
