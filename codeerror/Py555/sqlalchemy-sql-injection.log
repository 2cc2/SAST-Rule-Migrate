Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Detects SQL injection vulnerabilities in SQLAlchemy's GROUP_BY, ORDER_BY, 
 * DISTINCT, HAVING and FILTER clauses when user input is directly incorporated.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sql-injection-sqlalchemy
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class SQLAlchemyInjectionSink extends DataFlow::Node {
  SQLAlchemyInjectionSink() {
    exists(Call call |
      call.getTarget().hasQualifiedName("sqlalchemy.orm.query", "group_by") or
      call.getTarget().hasQualifiedName("sqlalchemy.orm.query", "order_by") or
      call.getTarget().hasQualifiedName("sqlalchemy.orm.query", "distinct") or
      call.getTarget().hasQualifiedName("sqlalchemy.orm.query", "having") or
      call.getTarget().hasQualifiedName("sqlalchemy.orm.query", "filter") |
      this.asParameter() = call.getArgument(0)
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p |
      p.getCallable().getName().matches("%VAR%") and
      this.asParameter() = p
    )
  }
}

class SqlBindSanitizer extends DataFlow::BarrierNode {
  SqlBindSanitizer() {
    exists(Call call |
      call.getTarget().getName() = "bindparams" and
      this.asParameter() = call.getAnArgument()
    )
  }
}

class SQLAlchemyTaintConfig extends TaintTracking::Configuration {
  SQLAlchemyTaintConfig() { this = "SQLAlchemyTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SQLAlchemyInjectionSink }

  override predicate isBarrier(DataFlow::Node barrier) { barrier instanceof SqlBindSanitizer }
}

from SQLAlchemyTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Potential SQL injection in SQLAlchemy query when using GROUP_BY/ORDER_BY/DISTINCT/HAVING/FILTER with raw user input"
