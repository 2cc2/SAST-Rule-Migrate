Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause 
 *              sql injections if the developer inputs raw SQL into these clauses 
 *              with unsafe user input formatting.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.security.strings.SQLInjection
import semmle.python.web.SQLAlchemy

class SQLAlchemyInjectionSink extends DataFlow::Node {
  SQLAlchemyInjectionSink() {
    exists(MethodCall call |
      call.getMethod().hasName(["group_by", "order_by", "distinct", "having", "filter"]) and
      call.getReceiver().(Name).getId().matches("%.query%") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p | p.getAnArg().asExpr() = this.asExpr())
  }
}

class SqlBindSanitizer extends DataFlow::BarrierGuard {
  SqlBindSanitizer() {
    exists(MethodCall mc | mc.getMethod().hasName("bindparams") and this.asExpr() = mc)
  }
}

query predicate edges(DataFlow::Node node1, DataFlow::Node node2) {
  not exists(MethodCall mc | 
    mc.getMethod().hasName("bindparams") and 
    node2.asExpr() = mc.getReceiver()
  ) and
  DataFlow::localFlowStep(node1, node2)
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where 
  source.getNode() instanceof UserInputSource and
  sink.getNode() instanceof SQLAlchemyInjectionSink and
  DataFlow::flowPath(source, sink)
select sink, source, sink,
  "Potential SQL injection in SQLAlchemy query method with user input."
