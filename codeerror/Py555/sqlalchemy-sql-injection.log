Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Detects when raw SQL with user input is passed to distinct(), having(), 
 *              group_by(), order_by(), or filter() without using bindparams().
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.new.TaintTracking
import semmle.python.dataflow.new.RemoteFlowSources

class SqlAlchemySink extends DataFlow::Node {
  SqlAlchemySink() {
    exists(MethodCall mc |
      mc.getMethodName() in ["group_by", "order_by", "distinct", "having", "filter"] and
      mc.getReceiver().(MethodCall).getMethodName() = "query" and
      this.asExpr() = mc.getArg(0)
    )
  }

  override string getAPathDescription() {
    result = "SQLAlchemy query method that accepts raw SQL"
  }
}

class BindParamsSanitizer extends DataFlow::Node {
  BindParamsSanitizer() {
    exists(MethodCall mc | mc.getMethodName() = "bindparams" |
      this.asExpr() = mc.getArg(0)
    )
  }
}

/** The configuration to detect SQL injection in SQLAlchemy ORM */
module SqlAlchemyConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p or
      RemoteFlowSource::isRemoteUserInput(source))
  }

  predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlAlchemySink
  }

  predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof BindParamsSanitizer
  }

  predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodCall mc |
      mc.getMethodName() != "bindparams" and
      node1.asExpr() = mc.getAnArg() and
      node2.asExpr() = mc
    )
  }
}

module SqlAlchemyFlow = DataFlow::Global<SqlAlchemyConfig>;

from SqlAlchemyFlow::PathNode source, SqlAlchemyFlow::PathNode sink
where SqlAlchemyFlow::flowPath(source, sink)
select sink, source, sink, "潜在的SQL注入漏洞，用户输入直接传递到SQLAlchemy查询方法而没有使用bindparams()"
