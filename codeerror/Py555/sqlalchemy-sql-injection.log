Rule Content:
/**
 * @name SQL Injection in SQLAlchemy Query Methods
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause sql injections
 *              if the developer inputs raw SQL into these clauses with unsafe user input formatting.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sql-injection-sqlalchemy-query
 */

import python
import DataFlow
import DataFlow::PathGraph
import semmle.python.security.TaintTracking
import semmle.python.web.Http

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(Parameter p |
      p.getAnArgument() = this.asExpr() and
      p.getName().regexpMatch(".*")
    )
  }

  override predicate isSource() { none() }

  override predicate asCfgNode() { result = this.asExpr() }

  override string getLocation() { result = this.asExpr().getLocation().toString() }

  override BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }

  override string toString() { result = this.asExpr().toString() }

  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }

  override Variable asVariable() { result = this.asExpr().getPrimaryQlClass() }
}

class SqlFunctionCall extends DataFlow::Node {
  MethodAccess ma;

  SqlFunctionCall() {
    exists(MethodAccess ma |
      this.asExpr() = ma and
      (
        ma.getMethod().getName() = "group_by" or
        ma.getMethod().getName() = "order_by" or
        ma.getMethod().getName() = "distinct" or
        ma.getMethod().getName() = "having" or
        ma.getMethod().getName() = "filter"
      ) and
      ma.getQualifier().toString().matches(".*\\.query(\\.join)?")
    ) and
    this = ma.getArgument(0)
  }

  override predicate isSink() { none() }

  override predicate asCfgNode() { result = this.asExpr() }

  override string getLocation() { result = this.asExpr().getLocation().toString() }

  override BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }

  override string toString() { result = this.asExpr().toString() }

  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }

  override Variable asVariable() { result = this.asExpr().getPrimaryQlClass() }
}

class BindParamsSanitizer extends DataFlow::Node {
  BindParamsSanitizer() {
    exists(MethodAccess ma |
      this.asExpr() = ma and
      ma.getMethod().getName() = "bindparams"
    )
  }

  override predicate isSanitizer() { none() }

  override predicate asCfgNode() { result = this.asExpr() }

  override string getLocation() { result = this.asExpr().getLocation().toString() }

  override BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }

  override string toString() { result = this.asExpr().toString() }

  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }

  override Variable asVariable() { result = this.asExpr().getPrimaryQlClass() }
}

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SQLAlchemy Injection" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlFunctionCall }

  override predicate isSanitizer(DataFlow::Node sanitizes) {
    sanitizes instanceof BindParamsSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node a, DataFlow::Node b) {
    exists(MethodAccess ma |
      ma.getArgument(0).getAnArgument() = a.asExpr() and
      b.asExpr() = ma.getQualifier() and
      not ma.getMethod().getName() = "bindparams"
    )
  }
}

from SqlInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential SQL injection in SQLAlchemy query method using user-provided input."
