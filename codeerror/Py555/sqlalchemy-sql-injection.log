Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by clauses in SQLAlchemy can cause SQL injections
 *              if raw SQL with unsafe user input is passed to these methods
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.security.injection.Taint
import semmle.python.web.sqlalchemy.SqlAlchemy

class SqlAlchemyRawSqlMethod extends FunctionCall {
  SqlAlchemyRawSqlMethod() {
    (
      this.getMethod().hasName(["group_by", "order_by", "distinct", "having", "filter"]) and
      this.getReceiver().getType().toString() = "sqlalchemy.orm.query.Query"
    ) or
    exists(
      Method m |
      this.getMethod() = m and
      m.hasQualifiedName("sqlalchemy.orm.query", "Query", ["group_by", "order_by", "distinct", "having", "filter"])
    )
  }
}

class UserInput extends DataFlow::SourceNode {
  UserInput() {
    exists(Parameter p |
      this.asParameter() = p and
      p.getType().toString().matches("%VAR%")
    )
  }
}

class SafeSqlBinding extends DataFlow::BarrierNode {
  SafeSqlBinding() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("bindparams") and
      this.asExpr() = ma
    )
  }
}

from
  DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(SqlAlchemyRawSqlMethod riskyMethod |
    sink.asExpr() = riskyMethod and
    // Avoid false positives where bindparams is used
    not exists(SafeSqlBinding safe |
      DataFlow::localFlow(source, safe) and
      DataFlow::localFlow(safe, sink)
    )
  ) and
  TaintTracking::localTaint(source, sink) and
  source instanceof UserInput
select sink, "Potential SQL injection in SQLAlchemy due to unsafe raw SQL usage with user input",
source, "User input comes from here"
