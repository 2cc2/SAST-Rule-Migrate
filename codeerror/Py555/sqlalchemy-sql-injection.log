Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can 
 *              cause SQL injections if the developer inputs raw SQL into these clauses 
 *              with unsafe user input formatting
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.Concepts
import DataFlow::PathGraph
import python.security.strings.SQLInjection

class SQLAlchemyInjectionSink extends SQLInjection::Range {
  SQLAlchemyInjectionSink() {
    exists(MethodCall call |
      call.getMethodName() in ["group_by", "order_by", "distinct", "having", "filter"] and
      call.getReceiver().toString().matches("%.query%") and
      this.asSink() = call.getArgument(0).asExpr()
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p |
      p.getName().regexpMatch("^.*VAR.*$") and
      this.asSource() = p.getAnAssignedArgument().asExpr()
    )
  }
}

class SqlBindSanitizer extends DataFlow::Node {
  SqlBindSanitizer() {
    exists(MethodCall call |
      call.getMethodName() = "bindparams" and
      this.asSanitizer() = call.asExpr()
    )
  }
}

class SQLAlchemySqlInjectionConfig extends DataFlow::Configuration {
  SQLAlchemySqlInjectionConfig() { this = "SQLAlchemySqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SQLAlchemyInjectionSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SqlBindSanitizer
  }

  override predicate isAdditionalFlowStep(DataFlow::Node src, DataFlow::Node sink) {
    exists(MethodCall call |
      DataFlow::localFlow(src, call.getAnArgument()) and
      DataFlow::localFlow(call.getAnArgument(), sink) and
      not call.getMethodName() = "bindparams"
    )
  }
}

