Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause sql 
 *   injections if the developer inputs raw SQL into these clauses with unsafe user input formatting.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(string varName |
      this = DataFlow::parameterNode(_) and
      varName = this.getVariable().getName() and
      regexpMatches(varName, "^$VAR$")
    )
  }
}

class SqlFunctionCall extends DataFlow::Node {
  SqlFunctionCall() {
    exists(MethodCall mc, string methodName |
      mc = this.getNode() and
      methodName = mc.getMethodName() and
      (
        methodName = "group_by" or
        methodName = "order_by" or
        methodName = "distinct" or
        methodName = "having" or
        methodName = "filter"
      ) and
      mc.getReceiver().getQualifiedName().matches("%.query%") or
      mc.getReceiver().getQualifiedName().matches("%.query.join%")
    )
  }
}

class BindParamsSanitizer extends DataFlow::Node {
  BindParamsSanitizer() {
    exists(MethodCall mc |
      this.asExpr() = mc and
      mc.getMethodName() = "bindparams"
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "SQLAlchemySqlInjection" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlFunctionCall }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof BindParamsSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodCall mc |
      node1.asExpr() = mc.getAnArgument() and
      node2.asExpr() = mc and
      not mc.getMethodName() = "bindparams"
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential SQL injection in SQLAlchemy query method via unsanitized user input"
