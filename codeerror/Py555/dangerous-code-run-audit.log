/**
 * @name Dangerous Interactive Code Execution
 * @description Detects dynamic content inside InteractiveConsole/InteractiveInterpreter methods
 * @kind path-problem
 * @problem.severity warning
 * @id python/dangerous-interactive-code-run-audit
 */

import python
import semmle.python.dataflow.internal.DataFlowImpl
import semmle.python.Concepts
import semmle.python.ApiGraphs

class InteractiveConsoleSink extends DataFlow::Node {
  Call call;

  InteractiveConsoleSink() {
    exists(MethodCall mc |
      mc = this.asExpr() and
      (
        (mc.getMethodName() = "push" or mc.getMethodName() = "runsource" or mc.getMethodName() = "runcode") and
        mc.getQualifier().getType().getName() matches "InteractiveConsole|InteractiveInterpreter"
        or
        mc.getMethodName() = "compile_command" and
        mc.getQualifier().getType().getName() = "code"
      ) and
      this.asExpr() = mc.getArgument(0)
    )
  }

  override predicate asCfgNode() { none() }
  override predicate getLocation() { this = call.getLocation() }
  override predicate getBasicBlock() { none() }
  override string toString() { result = call.toString() }
  override predicate getScope() { call.getScope() = result }
  override predicate asVariable() { none() }
}

class DynamicCodeSource extends DataFlow::Node {
  DynamicCodeSource() {
    exists(Expression expr |
      this.asExpr() = expr and
      (
        exists(Literal lit | expr = lit and lit.getStringValue() != "\"\"\"") or
        exists(Identifier id | expr = id) or
        exists(Call c | expr = c)
      )
    )
  }

  override predicate asCfgNode() { none() }
  override predicate getLocation() { this = result }
  override predicate getBasicBlock() { none() }
  override string toString() { result = this.asExpr().toString() }
  override predicate getScope() { this.asExpr().getScope() = result }
  override predicate asVariable() { none() }
}

class StaticCodeSanitizer extends DataFlow::Node {
  StaticCodeSanitizer() {
    exists(Literal lit |
      this.asExpr() = lit and
      lit.getStringValue() = "\"\"\""
    )
  }

  override predicate asCfgNode() { none() }
  override predicate getLocation() { this = result }
  override predicate getBasicBlock() { none() }
  override string toString() { result = this.asExpr().toString() }
  override predicate getScope() { this.asExpr().getScope() = result }
  override predicate asVariable() { none() }
}

class DangerousInteractiveCodeExecutionConfig extends TaintTracking::Configuration {
  DangerousInteractiveCodeExecutionConfig() { this = "DangerousInteractiveCodeExecutionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicCodeSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InteractiveConsoleSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticCodeSanitizer
  }
}

from DangerousInteractiveCodeExecutionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it allows " +
  "a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
