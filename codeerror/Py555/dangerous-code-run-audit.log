Rule Content:
/**
 * @name Dangerous interactive code execution
 * @description Detects dynamic content inside InteractiveConsole/InteractiveInterpreter method calls
 * @kind problem
 * @problem.severity warning
 * @id py/dangerous-interactive-code-run
 */
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class DangerousInteractiveCodeConfig extends TaintTracking::Configuration {
  DangerousInteractiveCodeConfig() { this = "DangerousInteractiveCodeConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(StringLiteral lit | source.asExpr() = lit and lit.getValue() != "\"\"\"") or
    exists(Name name | source.asExpr() = name)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call = sink.asExpr() and
      (
        (
          call.getReceiver().getType().(Class).getQualifiedName() = "code.InteractiveConsole" or
          call.getReceiver().getType().(Class).getQualifiedName() = "code.InteractiveInterpreter"
        ) and
        call.getMethodName() in ["push", "runsource", "runcode"] and
        sink.asParameter() = call.getArgument(0)
      )
      or
      (
        call.getFuncBinding().getQualifiedName() = "code.compile_command" and
        sink.asParameter() = call.getArgument(0)
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral lit |
      sanitizer.asExpr() = lit and
      lit.getValue() = "\"\"\""
    )
  }
}

