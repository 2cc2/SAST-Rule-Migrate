Rule Content:
/**
 * @name Dangerous Interactive Code Run Audit
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.
 * @kind taint
 * @problem.severity warning
 * @id py/dangerous-interactive-code-run-audit
 */

import python
import semmle.python.security.dataflow.TaintTracking
import DataFlow::PathGraph

class InteractiveCodeExecution extends TaintTracking::Configuration {
  InteractiveCodeExecution() {
    this = "InteractiveCodeExecution"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(string literal, string content |
      source.asExpr().(StringLiteral).getText() = literal and
      literal != "\"\"\"" and
      content = literal and
      // Ensure it's from external source or dynamic content
      not exists(LiteralExpr le | le = source.asExpr() and le.getStringValue() = "\"\"\"")
    )
    or
    exists(Identifier id |
      source.asExpr() = id and
      not exists(LiteralExpr le | le = source.asExpr() and le.getStringValue() = "\"\"\"")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall call |
      (
        call.getMethodName() = ["push", "runsource", "runcode"] and
        call.getReceiver().getType().(ClassType).getASupertype*().hasQualifiedName("code", ["InteractiveConsole", "InteractiveInterpreter"])
        or
        call.getMethodName() = "compile_command" and
        call.getReceiver().getType().(ClassType).getASupertype*().hasQualifiedName("code", "code")
      ) and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(string literal |
      sanitizer.asExpr().(StringLiteral).getText() = literal and
      literal = "\"\"\""
    )
  }
}

from InteractiveCodeExecution config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. This is dangerous if external data can reach this function call because it allows a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
