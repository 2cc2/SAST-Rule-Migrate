Rule Content:
/**
 * @name Dangerous interactive code execution
 * @description Dynamic content passed to interactive console methods could lead to arbitrary code execution
 * @kind path-problem
 * @problem.severity warning
 * @id py/dangerous-interactive-code-run
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

private class InteractiveConsoleMethod extends Method {
  InteractiveConsoleMethod() {
    this.hasQualifiedName("code", "InteractiveConsole", "push") or
    this.hasQualifiedName("code", "InteractiveConsole", "runsource") or
    this.hasQualifiedName("code", "InteractiveConsole", "runcode") or
    this.hasQualifiedName("code", "InteractiveInterpreter", "runsource") or
    this.hasQualifiedName("code", "InteractiveInterpreter", "runcode") or
    this.hasQualifiedName("code", "compile_command")
  }
}

private class InteractiveCodeArg extends DataFlow::NodeImpl {
  InteractiveCodeArg() {
    exists(Call call, InteractiveConsoleMethod method |
      call.getCallee() = method and
      this.asExpr() = call.getArg(0)
    )
  }
}

private class DynamicContentSource extends DataFlow::NodeImpl {
  DynamicContentSource() {
    // Match any expression that's not an empty string literal
    exists(Expr e |
      this.asExpr() = e and
      not (e instanceof StrLiteral and e.getStringValue() = "\"\"\"")
    )
  }
}

private class StaticCodeSanitizer extends DataFlow::NodeImpl {
  StaticCodeSanitizer() {
    exists(StrLiteral lit |
      this.asExpr() = lit and
      lit.getStringValue() = "\"\"\""
    )
  }
}

class DangerousInteractiveCodeConfig extends TaintTracking::Configuration {
  DangerousInteractiveCodeConfig() { this = "DangerousInteractiveCodeConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicContentSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InteractiveCodeArg
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticCodeSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagate taint through argument passing
    exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
      node1.asExpr() = arg and node2.asExpr() = param and
      param = arg.getParameter()
    )
  }
}

from DangerousInteractiveCodeConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it " +
  "allows a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
