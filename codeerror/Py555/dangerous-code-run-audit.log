/**
 * @name Dangerous interactive code execution
 * @description Detects dynamic content passed to interactive execution methods,
 *              which could allow arbitrary code execution if attacker controls the input.
 * @kind path-problem
 * @problem.severity warning
 * @id python/dangerous-interactive-code-run
 */

import python
import semmle.python.dataflow.PathGraph
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph



private class InteractiveConsoleMethod extends Callable {
  InteractiveConsoleMethod() {
    // Match InteractiveConsole/InteractiveInterpreter methods
    this.hasQualifiedName("code", "InteractiveConsole", "push") or
    this.hasQualifiedName("code", "InteractiveConsole", "runsource") or
    this.hasQualifiedName("code", "InteractiveConsole", "runcode") or
    this.hasQualifiedName("code", "InteractiveInterpreter", "push") or
    this.hasQualifiedName("code", "InteractiveInterpreter", "runsource") or
    this.hasQualifiedName("code", "compile_command")
  }
}

private class InteractiveCodeArg extends DataFlow::Node {
  InteractiveCodeArg() {
    exists(Call call |
      call.getTarget() instanceof InteractiveConsoleMethod and
      this.asExpr() = call.getArg(0)
    )
  }
}

private class DynamicContentSource extends DataFlow::Node {
  DynamicContentSource() {
    not exists(StringLiteral lit |
      this.asExpr() = lit and
      lit.getValue() = "\"\"\""
    )
  }
}

private class StaticCodeSanitizer extends DataFlow::Node {
  StaticCodeSanitizer() {
    exists(StringLiteral lit |
      this.asExpr() = lit and
      lit.getValue() = "\"\"\""
    )
  }
}

class DangerousInteractiveCodeConfig extends TaintTracking::Configuration {
  DangerousInteractiveCodeConfig() { this = "DangerousInteractiveCodeConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicContentSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InteractiveCodeArg
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticCodeSanitizer
  }
}

