Rule Content:
/**
 * @name Dangerous Interactive Code Execution
 * @description Detects dynamic content inside InteractiveConsole/InteractiveInterpreter methods which could allow
 *              arbitrary Python code execution if controlled by an attacker.
 * @kind path-problem
 * @problem.severity warning
 * @id py/dangerous-interactive-code-execution
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class InteractiveConsoleCall extends API::FunctionCall {
  InteractiveConsoleCall() {
    exists(API::Function fn |
      fn.hasName(["push", "runsource", "runcode"]) and
      this.getTarget() = fn and
      fn.getScope() instanceof API::Class and
      (
        fn.getScope().getType().hasQualifiedName("code", "InteractiveConsole") or
        fn.getScope().getType().hasQualifiedName("code", "InteractiveInterpreter")
      )
    )
  }
}

class CompileCommandCall extends API::FunctionCall {
  CompileCommandCall() {
    exists(API::Function fn |
      fn.hasName("compile_command") and
      this.getTarget() = fn and
      fn.getScope().getType().hasQualifiedName("code")
    )
  }
}

class DangerousInteractiveCodeExecutionConfig extends TaintTracking::Configuration {
  DangerousInteractiveCodeExecutionConfig() { this = "DangerousInteractiveCodeExecutionConfig" }

  override predicate isSource(DataFlow::Node source) {
    not source.asExpr().(StringLiteral).getText() = "\"\""
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(InteractiveConsoleCall call |
      sink.asExpr() = call.getArgument(0)
    )
    or
    exists(CompileCommandCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral and
    sanitizer.asExpr().(StringLiteral).getText() = "\"...\""
  }
}

from DangerousInteractiveCodeExecutionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it allows " +
  "a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
