Rule Content:
/**
 * @name Dangerous Interactive Code Execution
 * @description Detects dynamic content passed to Python interactive console methods,
 *              which could allow arbitrary code execution if external data reaches this point.
 * @kind taint
 * @problem.severity warning
 * @id python/dangerous-interactive-code-run-audit
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class InteractiveConsoleSink extends DataFlow::Node {
  InteractiveConsoleSink() {
    exists(MethodCall mc |
      (mc.getMethod().getName() = "push" or
       mc.getMethod().getName() = "runsource" or
       mc.getMethod().getName() = "runcode") and
      (mc.getReceiver().getType().getName() = "InteractiveConsole" or
       mc.getReceiver().getType().getName() = "InteractiveInterpreter") and
      this.asExpr() = mc.getArgument(0)
    ) or
    exists(MethodCall mc |
      mc.getMethod().getName() = "compile_command" and
      mc.getReceiver().getType().getName() = "code" and
      this.asExpr() = mc.getArgument(0)
    )
  }
}

class DynamicCodeSource extends DataFlow::Node {
  DynamicCodeSource() {
    exists(Literal l | this.asExpr() = l and not l.getStringValue() = "\"\"\"") or
    exists(Identifier id | this.asExpr() = id) or
    exists(Call call | this.asExpr() = call)
  }
}

class StaticCodeSanitizer extends DataFlow::Node {
  StaticCodeSanitizer() {
    exists(Literal l | this.asExpr() = l and l.getStringValue() = "\"\"\"")
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "DangerousInteractiveCodeExecution" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicCodeSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InteractiveConsoleSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticCodeSanitizer
  }
}

