Rule Content:
/**
 * @name Dangerous Interactive Code Execution
 * @description Detects dynamic content inside InteractiveConsole/InteractiveInterpreter methods
 * @kind path-problem
 * @problem.severity warning
 * @id py/dangerous-interactive-code-run-audit
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class InteractiveCodeSink extends DataFlow::Node {
  InteractiveCodeSink() {
    exists(Call call |
      (
        call.getTarget().(Constructor).getConstructedType().getName() = "InteractiveConsole" or
        call.getTarget().(Constructor).getConstructedType().getName() = "InteractiveInterpreter"
      ) and
      (
        call.getTarget().getName() = "push" or
        call.getTarget().getName() = "runsource" or
        call.getTarget().getName() = "runcode"
      ) and
      this.asExpr() = call.getArg(0)
    ) or
    exists(Call call |
      call.getTarget().getName() = "compile_command" and
      call.getTarget().getModule().getName() = "code" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class DynamicContentSource extends DataFlow::Node {
  DynamicContentSource() {
    exists(Literal lit |
      lit.getStringValue() != "\"\"\"" and
      this.asExpr() = lit
    ) or
    exists(Identifier id |
      this.asExpr() = id
    ) or
    exists(Call call |
      this.asExpr() = call
    )
  }
}

class StaticCodeSanitizer extends DataFlow::Node {
  StaticCodeSanitizer() {
    exists(Literal lit |
      lit.getStringValue() = "\"\"\"" and
      this.asExpr() = lit
    )
  }
}

class InteractiveCodeConfig extends TaintTracking::Configuration {
  InteractiveCodeConfig() { this = "InteractiveCodeConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicContentSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InteractiveCodeSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticCodeSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // Propagate taint through arguments to parameters
    DataFlow::parameterNode(_, pred, succ) or
    // Handle special case of compile to runcode flow
    exists(Call call1, Call call2 |
      call1.getTarget().getName() = "compile_command" and
      call2.getTarget().getName() = "runcode" and
      pred.asExpr() = call1.getArg(0) and
      succ.asExpr() = call2.getArg(0)
    )
  }
}

from InteractiveCodeConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it allows " +
  "a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
