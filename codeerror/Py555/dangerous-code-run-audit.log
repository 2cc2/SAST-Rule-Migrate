Rule Content:
/**
 * @name Dangerous interactive code execution
 * @description Detects dynamic content passed to InteractiveConsole/InteractiveInterpreter methods,
 *              which could lead to arbitrary Python code execution if untrusted input reaches these calls.
 * @kind taint
 * @problem.severity warning
 * @id python/security/dangerous-interactive-code-run-audit
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

predicate isSource(DataFlow::Node source) {
  exists(string value |
    source.asExpr() = value and
    value != ""\"..."\""  
  )
}

predicate isSink(DataFlow::Node sink) {
  exists(MethodCall call, Method method, Class clazz |
    (
      call.getCallee() = method and
      method.getDeclaringType() = clazz and
      (
        clazz.getName() = "InteractiveConsole" or
        clazz.getName() = "InteractiveInterpreter"
      ) and
      method.getName() in ["push", "runsource", "runcode"] and
      sink.asExpr() = call.getArgument(0)
    )
    or
    (
      call.getCallee() = method and
      method.getName() = "compile_command" and
      method.getDeclaringType().getName() = "code" and
      sink.asExpr() = call.getArgument(0)
    )
  )
}

predicate isSanitizer(DataFlow::Node sanitizer) {
  exists(string value |
    sanitizer.asExpr() = value and
    value = ""\"..."\""  
  )
}

predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
  nodeFrom instanceof ParameterNode and nodeTo instanceof ArgumentNode
}

class DangerousInteractiveCodeExecution extends TaintTracking::Configuration {
  DangerousInteractiveCodeExecution() { this = "DangerousInteractiveCodeExecution" }

  override predicate isSource(TaintTracking::TaintSource source) { isSource(source) }
  override predicate isSink(TaintTracking::TaintSink sink) { isSink(sink) }
  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) { ::isSanitizer(sanitizer) }
  override predicate isAdditionalTaintStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    ::isAdditionalTaintStep(nodeFrom, nodeTo)
  }
}

from DangerousInteractiveCodeExecution cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.", source,
  "This is dangerous if external data can reach this function call because it allows a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
