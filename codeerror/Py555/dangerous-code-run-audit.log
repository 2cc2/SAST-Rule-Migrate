/**
 * @name Dangerous interactive code execution
 * @description Detects dynamic content inside InteractiveConsole/InteractiveInterpreter method calls
 * @kind problem
 * @problem.severity warning
 * @id py/dangerous-interactive-code-run
 */
import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow
import semmle.python.Concepts

class DangerousInteractiveCodeConfig extends TaintTracking::Configuration {
  DangerousInteractiveCodeConfig() { this = "DangerousInteractiveCodeConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(StringLiteral lit | source.asExpr() = lit and lit.getText() != "\"\"\"") or
    exists(Name name | source.asExpr() = name)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call, Method meth |
      call = sink.asExpr() and
      (
        (
          meth = call.getCallee() and
          meth.getQualifiedName() in ["code.InteractiveConsole.push", 
                                     "code.InteractiveConsole.runsource",
                                     "code.InteractiveConsole.runcode",
                                     "code.InteractiveInterpreter.push",
                                     "code.InteractiveInterpreter.runsource",
                                     "code.InteractiveInterpreter.runcode"] and
          sink.asParameter() = call.getArgument(0)
        )
        or
        (
          meth.getQualifiedName() = "code.compile_command" and
          sink.asParameter() = call.getArgument(0)
        )
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral lit |
      node.asExpr() = lit and
      lit.getText() = "\"\"\""
    )
  }
}

from DangerousInteractiveCodeConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Dynamic content in InteractiveConsole method may allow code injection. " +
  "Ensure no untrusted data reaches this call."
