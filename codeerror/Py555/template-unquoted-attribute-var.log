import python
import semmle.python.security.TaintTracking
import DataFlow
import TaintTracking

private class RequestGetCall extends DataFlow::Call {
  RequestGetCall() {
    this.getTarget().getName().matches("request\\.\\w+\\.get")
  }

  string getMethodName() {
    result = this.getTarget().getName()
  }
}

private class UnquotedTemplateLiteral extends DataFlow::StringLiteral {
  UnquotedTemplateLiteral() {
    this.getValue().matches("=\\{\\{\\w+\\}\\}")
  }
}

private class QuotedTemplateLiteral extends DataFlow::StringLiteral {
  QuotedTemplateLiteral() {
    this.getValue().matches("=\\\\\"\\{\\{\\w+\\}\\\"\\}")
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TemplateUnquotedAttributeConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    exists(RequestGetCall call |
      source.asParameter() = call.getAnArgument()
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(UnquotedTemplateLiteral lit |
      sink.asArgument() = lit.getLocation()
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(QuotedTemplateLiteral lit |
      sanitizer.asArgument() = lit.getLocation()
    )
  }
}

