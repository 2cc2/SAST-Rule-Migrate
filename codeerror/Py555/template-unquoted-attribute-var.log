Rule Content:
/**
 * @name Template Unquoted Attribute Variable
 * @description Detected a unquoted template variable as an attribute. 
 *              If unquoted, a malicious actor could inject custom JavaScript handlers.
 * @kind path-problem
 * @problem.severity warning
 * @id python/security/template-unquoted-attribute-var
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.dataflow.new.DataFlow

class UnquotedRequest extends DataFlow::Node {
  UnquotedRequest() {
    exists(Call call |
      call.getTarget().toString().matches("request\.\w+\.get") and
      this.asSource() = call
    )
  }
}

class TemplateAttrSink extends DataFlow::Node {
  TemplateAttrSink() {
    exists(StrLiteral lit |
      lit.getStringValue().matches("={{\\w+}}") and
      this.asSink() = lit
    )
  }
}

class QuotedTemplateSanitizer extends DataFlow::Node {
  QuotedTemplateSanitizer() {
    exists(StrLiteral lit |
      lit.getStringValue().matches("=\\\"{{\\w+}\\\"}") and
      this.asSanitizer() = lit
    )
  }
}

class TemplateTaintConfig extends TaintTracking::Configuration {
  TemplateTaintConfig() { this = "TemplateTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnquotedRequest
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TemplateAttrSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof QuotedTemplateSanitizer
  }
}

from TemplateTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
       "Detected a unquoted template variable as an attribute. If unquoted, a malicious actor could inject custom JavaScript handlers."
