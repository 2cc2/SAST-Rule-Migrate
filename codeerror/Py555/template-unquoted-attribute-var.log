/**
 * @name Template Unquoted Attribute Variable
 * @description Detected a unquoted template variable as an attribute. If unquoted, 
 *              a malicious actor could inject custom JavaScript handlers.
 * @kind taint-problem
 * @problem.severity warning
 * @id javascript/template-unquoted-attribute-var
 */

import javascript
import semmle.javascript.security.dataflow.TaintTracking
import DataFlow::PathGraph

class UnquotedRequest extends DataFlow::Node {
  UnquotedRequest() {
    exists(MethodCall call |
      call.getTarget().getName().regexpMatch("request\\.\\w+\\.get") and
      this.asExpr() = call
    )
  }
}

class TemplateAttrSink extends DataFlow::Node {
  TemplateAttrSink() {
    exists(Literal literal |
      literal.getValue().regexpMatch("={{\\w+}}") and
      this.asExpr() = literal
    )
  }
}

class QuotedTemplateSanitizer extends DataFlow::BarrierGuard {
  QuotedTemplateSanitizer() {
    exists(Literal literal |
      literal.getValue().regexpMatch("=\\\"{{\\w+}\\\"}") and
      this.asExpr() = literal
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TemplateUnquotedAttributeVar" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnquotedRequest
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TemplateAttrSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof QuotedTemplateSanitizer
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), "Detected a unquoted template variable as an attribute. " +
  "If unquoted, a malicious actor could inject custom JavaScript handlers."
