/**
 * @name Template unquoted attribute variable
 * @description Detected a unquoted template variable as an attribute. If unquoted, a malicious actor could inject custom JavaScript handlers.
 * @kind taint
 * @problem.severity warning
 * @id template-unquoted-attribute-var
 */

import python
import semmle.python.security.TaintTracking

class RequestGetCall extends DataFlow::CallNode {
  RequestGetCall() {
    exists(string methodName | methodName.matches("request\\.\\w+\\.get") |
      this.getMethod().getName() = methodName
    )
  }
}

class UnquotedTemplateLiteral extends DataFlow::LiteralNode {
  UnquotedTemplateLiteral() {
    this.getStringValue().matches("=\\{\\{\\w+\\}\\}")
  }
}

class QuotedTemplateLiteral extends DataFlow::LiteralNode {
  QuotedTemplateLiteral() {
    this.getStringValue().matches("=\\\\\"\\{\\{\\w+\\}\\\"\\}")
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TemplateUnquotedAttributeVar" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() = any(RequestGetCall c).getACall()
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(UnquotedTemplateLiteral literal |
      sink.asExpr() = literal.asExpr()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(QuotedTemplateLiteral literal |
      sanitizer.asExpr() = literal.asExpr()
    )
  }
}

from Config cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential XSS vulnerability from unquoted template attribute"
