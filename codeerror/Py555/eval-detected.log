/**
 * @name eval-detected
 * @kind problem
 * @id python/code-injection/eval-detected
 * @severity warning
 * @message Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. If this content can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources.
 */

import python

from Call call, Name name, Value value
where
  name.getId() = "eval" and
  call.getFunc() = name and
  value = call.getArg(0) and
  not(value.getStringValue() = "") and
  not(value.getStringValue() = "...")
select call, "Potentially dangerous eval() call with dynamic content"
