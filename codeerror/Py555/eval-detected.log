/**
 * @name Eval Detected
 * @description Detected the use of eval(). eval() can be dangerous if used to evaluate
 *    dynamic content. If this content can be input from outside the program, this
 *    may be a code injection vulnerability.
 * @kind problem
 * @problem.severity warning
 * @id python/eval-detected
 */

import python

predicate isEvalCall(Call call) {
  exists(value, fn | call.getFunc().getValue() = value and value = fn and 
    fn.(Name).getId() = "eval")
}

from Call call
where 
  isEvalCall(call) and
  // Ensure argument is not empty
  not call.getArg(0).(StringLiteral).getValue() = "" and
  // Ensure argument is not "..." 
  not call.getArg(0).(StringLiteral).getValue() = "..." 
select call, "Detected the use of eval(). Ensure evaluated content is not definable by external sources.", 
  call.getFunc(), "eval() call"
