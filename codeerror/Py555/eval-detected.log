Rule Content:
/**
 * @name eval-detected
 * @description Detected the use of eval(). eval() can be dangerous if used to evaluate
 * dynamic content. If this content can be input from outside the program, this
 * may be a code injection vulnerability. Ensure evaluated content is not definable
 * by external sources.
 * @kind problem
 * @problem.severity warning
 * @id py/dangerous-eval
 */

import python
import semmle.python.dataflow.new.RemoteFlowSources
import DataFlow::PathGraph

class DangerousEvalConfiguration extends DataFlow::Configuration {
  DangerousEvalConfiguration() { this = "DangerousEvalConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    // No specific source requirements for this rule
    true
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getMethodName() = "eval" and
      sink.asExpr() = call and
      not call.getArg(0).getStringValue() = "" and
      not call.getArg(0).getStringValue() = "..."
    )
  }
}

from Call call, DangerousEvalConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where
  call.getMethodName() = "eval" and
  config.hasFlowPath(source, sink) and
  sink.getNode().asExpr() = call
select call, "Use of eval() with dynamic content can be dangerous if content is controllable by external sources."
