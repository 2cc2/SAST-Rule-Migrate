/**
 * @name Eval Detected
 * @description Detected the use of eval(). eval() can be dangerous if used to evaluate
 * dynamic content. If this content can be input from outside the program, this
 * may be a code injection vulnerability. Ensure evaluated content is not definable
 * by external sources.
 * @kind problem
 * @problem.severity warning
 * @id py/eval-detected
 */

import python

predicate isProblematicEval(Call call) {
  exists(Method evalMethod |
    call.getMethod() = evalMethod and
    evalMethod.getName() = "eval" and
    not call.getArg(0).getConstantValue().toString() = "" and
    not call.getArg(0).getConstantValue().toString() = "..."
  )
}

from Call call
where isProblematicEval(call)
select call, "Use of dangerous eval() function detected. Ensure evaluated content is not controllable by external sources."
