/**
 * @name Eval function detected
 * @description Detected the use of eval(). eval() can be dangerous if used to evaluate
 *    dynamic content. If this content can be input from outside the program, this
 *    may be a code injection vulnerability.
 * @kind problem
 * @problem.severity warning
 * @id python/security/eval-detected
 */

import python
import semmle.python.ApiGraphs

class DangerousEval extends Call {
  DangerousEval() {
    this.getCalleeName() = "eval" and
    not (this.getArg(0).(StringLiteral).getValue() = "") and
    not (this.getArg(0).(StringLiteral).getValue() = "...")
  }
}

select call, "Detected the use of eval() with dynamic content. Potential code injection vulnerability."
from DangerousEval call
