Rule Content:
/**
 * @name Aiopg SQL Injection
 * @description Detected string concatenation with a non-literal variable in an aiopg Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/aiopg-sqli
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts

class AiopgCall extends API::CallNode {
  AiopgCall() {
    exists(Method method | 
      method.getQualifiedName() = "aiopg.Cursor.execute" and
      this = method.getACall()
    )
  }
}

class UserInputSource extends TaintTracking::TaintSource {
  UserInputSource() {
    exists(VariableAccess va |
      va.getVariable().isUserInput() and
      exists(DataFlow::Node::exprNode(va) asNode |
        this = asNode
      )
    )
  }

  override predicate isSource(DataFlow::Node node) { this.asSource() = node }

  override DataFlow::Node asSource() { result = this } 

  override string getAPlusPlusName() { result = "User input" }
}

class SqlExecutionSink extends TaintTracking::TaintSink {
  SqlExecutionSink() {
    exists(AiopgCall call |
      call.getArgument(0).getStringValue() != "?" and
      not call.getArgument(0).getStringValue().regexpMatches("^\\\"(?:[^\\\"]|\\\"\\\")*\\\"\\$") and
      exists(DataFlow::Node::exprNode(call.getArgument(0)) asNode |
        this = asNode
      )
    )
  }

  override predicate isSink(DataFlow::Node node) { this.asSink() = node }

  override DataFlow::Node asSink() { result = this }

  override string getAPlusPlusName() { result = "SQL execution" }
}

class ParameterizedQuerySanitizer extends TaintTracking::Sanitizer {
  ParameterizedQuerySanitizer() {
    exists(AiopgCall call |
      call.getNumberOfArguments() > 1 and
      exists(DataFlow::Node::exprNode(call.getArgument(0)) asNode |
        this = asNode
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node node) { this.asSanitizer() = node }

  override DataFlow::Node asSanitizer() { result = this }
}

query predicate edges(TaintTracking::PathNode source, TaintTracking::PathNode sink) {
  TaintTracking::localTaint(source, sink) and
  exists(SqlExecutionSink sink_node | sink_node.asSink() = sink.getSink())
}

from UserInputSource source, SqlExecutionSink sink, TaintTracking::PathNode sourceNode, 
     TaintTracking::PathNode sinkNode
where
  edges(sourceNode, sinkNode) and
  sourceNode.getSource() = source.asSource() and
  sinkNode.getSink() = sink.asSink() and
  not exists(ParameterizedQuerySanitizer sanitizer | sanitizer.asSanitizer() = sinkNode.getSink())
select sinkNode, "Detected string concatenation with a non-literal variable in aiopg SQL statement.", 
  sourceNode, "Potential user input source"
