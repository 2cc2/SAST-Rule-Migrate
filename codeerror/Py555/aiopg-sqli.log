Rule Content:
/**
 * @name aiopg SQL Injection
 * @kind problem
 * @id python/aiopg-sqli
 * @problem.severity warning
 * @description Detected string concatenation with a non-literal variable in an aiopg Python
 *              SQL statement. This could lead to SQL injection if the variable is
 *              user-controlled and not properly sanitized. Use parameterized queries instead.
 */

import python
import semmle.python.dataflow.TaintTracking

class AiopgCursorExecute extends Method {
  AiopgCursorExecute() {
    this.getDeclaringType().hasQualifiedName("aiopg", "Cursor") and
    this.getName() = "execute"
  }
}

class UnsafeExecuteArg extends DataFlow::Node {
  UnsafeExecuteArg() {
    exists(Call call |
      call.getTarget() instanceof AiopgCursorExecute and
      this.asExpr() = call.getArgument(0).asExpr() and
      not call.getArgument(0).getStringValue().regexpMatch("^\"(?:[^\"]|\"\")*\"$")
    )
  }
}

class RemoteFlowSource extends DataFlow::Node {
  RemoteFlowSource() {
    exists(DataFlow::RemoteFlowSourceNode node | this.asExpr() = node.asExpr())
  }
}

class ParameterizedQuery extends DataFlow::Node {
  ParameterizedQuery() {
    exists(Call call |
      call.getTarget() instanceof AiopgCursorExecute and
      call.getNumArgument() > 1 and
      this.asExpr() = call.getArgument(0).asExpr()
    )
  }
}

class AiopgSQLiConfig extends TaintTracking::Configuration {
  AiopgSQLiConfig() { this = "AiopgSQLiConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeExecuteArg
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuery
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  any(AiopgSQLiConfig conf).hasFlow(source, sink)
select sink, "Detected string concatenation with a non-literal variable in SQL statement. " +
             "This could lead to SQL injection. Use parameterized queries instead."
