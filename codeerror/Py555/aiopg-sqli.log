Rule Content:
/**
 * @name aiopg-sqli
 * @kind path-problem
 * @problem.severity warning
 * @id python/aiopg-sqli
 * @message Detected string concatenation with a non-literal variable in an aiopg Python SQL statement. This could lead to SQL injection if the variable is user-controlled and not properly sanitized. Use parameterized queries instead.
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class AiopgCursorExecute extends DataFlow::CallNode {
  AiopgCursorExecute() {
    exists(MethodValue meth | 
      meth = this.getTarget() and
      meth.getDeclaringType().hasQualifiedName("aiopg", "Cursor") and
      meth.getName() = "execute"
    )
  }
}

// Source: user input
class UserInput extends DataFlow::Node {
  UserInput() {
    exists(SourceNode src | src.isUserInput() and src.getNode() = this.asExpr())
  }
}

// Sink: unfiltered argument to aiopg.Cursor.execute
class UnsafeExecuteArg extends DataFlow::Node {
  UnsafeExecuteArg() {
    exists(AiopgCursorExecute call |
      call.getArgument(0) = this.asExpr() and
      not this.getValueText().matches(/^"(?:[^"]|"")*"$/)
    )
  }
}

// Sanitizer: if more than 1 argument passed (parameterized query)
class ParameterizedQuery extends DataFlow::BarrierNode {
  ParameterizedQuery() {
    exists(AiopgCursorExecute call |
      call.getNumArgument() > 1 and
      this.asExpr() = call.getArgument(0)
    )
  }
}

module TaintTrackingConfiguration implements TaintTracking::Configuration {
  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeExecuteArg
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuery
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintTrackingConfiguration cfg
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected string concatenation with a non-literal variable in an aiopg Python SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized. " +
  "Use parameterized queries instead.", 
  source, sink
