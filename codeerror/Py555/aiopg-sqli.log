Rule Content:
/**
 * @name Aiopg SQL Injection
 * @description Detected string concatenation with a non-literal variable in an aiopg Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly
 *              sanitized. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/aiopg-sqli
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class UserInputSource extends TaintTracking::TaintSource {
  UserInputSource() {
    exists(Function f, Parameter p |
      f = p.getFunction() and
      exists(string annotation | 
        p.getAnnotationText() = annotation and
        annotation.matches("request|form|query|cookie|headers|session")
      )
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p and this.(UserInputSource) = p)
  }

  override predicate hasFlowTo(DataFlow::Node node) {
    // Default implementation uses standard library predicates
    TaintTracking::localTaintStep(node.getBasicBlock().getANode(), node)
  }
  
  // Required abstract methods
  override predicate hasLocationInfo() { none() }
  override Location getLocation() { none() }
  override string toString() { result = "User input source" }
}

class AiopgExecuteSink extends TaintTracking::TaintSink {
  AiopgExecuteSink() { none() }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall mc |
      mc.getMethodName() = "execute" and
      mc.getReceiver().getType().hasQualifiedName("aiopg", "Cursor") and
      sink.(AiopgExecuteSink) = mc.getArgument(0)
    )
  }

  // Check if the SQL query is a literal string
  override predicate matchesSink(DataFlow::Node sink) {
    not exists(MethodCall mc |
      mc.getArgument(0).getValue().regexpMatch("^\"(?:[^\"]|\"\")*\"$")
    )
  }
  
  // Required abstract methods
  override predicate hasLocationInfo() { none() }
  override Location getLocation() { none() }
  override string toString() { result = "Aiopg execute sink" }
}

class ParameterizedQuerySanitizer extends TaintTracking::Sanitizer {
  ParameterizedQuerySanitizer() { none() }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodCall mc |
      mc.getMethodName() = "execute" and
      mc.getReceiver().getType().hasQualifiedName("aiopg", "Cursor") and
      mc.getNumberOfArguments() > 1
    )
  }
  
  // Required abstract methods
  override predicate hasLocationInfo() { none() }
  override Location getLocation() { none() }
  override string toString() { result = "Parameterized query sanitizer" }
}

class AiopgSqliConfig extends TaintTracking::Configuration {
  AiopgSqliConfig() { this = "Aiopg SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof AiopgExecuteSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }
}

from AiopgSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection via string concatenation in aiopg execute() call", source,
  "User input flows into SQL query here. Consider using parameterized queries instead."
