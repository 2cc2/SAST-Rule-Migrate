import semmle.python.security.dataflow.TaintTracking
import semmle.python.Python
import semmle.python.Concepts
import semmle.python.dataflow.new.DataFlow

class AiopgCursorExecute extends DataFlow::Node, DataFlow::MethodAccessNode {
  AiopgCursorExecute() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getQualifier().getType().hasName("Cursor") and
      ma.getQualifier().getType().getName().matches("aiopg%") and
      this.asCfgNode() = ma.asCfgNode()
    )
  }

  override predicate asCfgNode(CfgNode cfgNode) {
    cfgNode = any(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getQualifier().getType().hasName("Cursor") and
      ma.getQualifier().getType().getName().matches("aiopg%")
    )
  }

  override string toString() { "aiopg.Cursor.execute() call" }

  override string getLocation() { result = toString() }

  override BasicBlock getBasicBlock() { result = asCfgNode() }

  override Variable asVariable() { none() }

  override ControlFlowNode getScope() { result = enclosingFunction() }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p | this.asParameter() = p) or
    exists(Attribute attr | this.asAttribute() = attr and attr.fromSource())
  }

  override predicate asCfgNode(CfgNode cfgNode) {
    cfgNode = any(MethodAccess ma | ma = this)
  }

  override string toString() { "User input source" }

  override string getLocation() { result = toString() }

  override BasicBlock getBasicBlock() { result = asCfgNode() }

  override Variable asVariable() { result = asParameter() or result = asAttribute() }

  override ControlFlowNode getScope() { result = enclosingFunction() }
}

class AiopgSqlInjectionConfiguration extends TaintTracking::Configuration {
  AiopgSqlInjectionConfiguration() { this = "Aiopg SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof AiopgCursorExecute and
    not sink.getArgument(0).getStringValue().regexpMatch("^\"(?:[^\"]|\"\")*\"$")
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    not barrier instanceof AiopgCursorExecute and
    barrier.getArgumentCount() > 1
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, AiopgSqlInjectionConfiguration config
where config.hasFlowPath(source, sink)
select sink, "Potential SQL injection vulnerability in aiopg.execute() call from $@.", source,
  source.toString()
