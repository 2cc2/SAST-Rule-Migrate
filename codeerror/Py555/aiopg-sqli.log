import python
import semmle.python.dataflow.internal.DataFlowUtil
import semmle.python.security.ExternalAPI
import DataFlow::PathGraph
import semmle.python.dataflow.DataFlow::PathNode

class AiopgCursorExecute extends DataFlow::PathNode {
  AiopgCursorExecute() {
    exists(MethodValue m |
      m.getMethod().getName() = "execute" and
      m.getDeclaringClass().getMethod().getQualifiedName() = "aiopg.Cursor.execute"
    )
  }
}

class UnsafeExecuteArg extends DataFlow::PathNode {
  UnsafeExecuteArg() {
    exists(AiopgCursorExecute call |
      this = call.getArgument(0) and
      not this.asExpr().getStringValue().regexpMatch("^\"(?:[^\"]|\"\")*\"$")
    )
  }
}

class RemoteFlowSource extends DataFlow::PathNode {    
  RemoteFlowSource() {
    exists(SourceNode srcNode | this = srcNode)
  }
}

class ParameterizedQuery extends DataFlow::PathNode {
  ParameterizedQuery() {
    exists(AiopgCursorExecute call |
      call.getNumberOfArguments() > 1 and
      this = call
    )
  }
}

class AiopgSQLiConfig extends TaintTracking::Configuration {
  AiopgSQLiConfig() { this = "AiopgSQLiConfig" }

  override predicate isSource(DataFlow::PathNode source) {
    source instanceof RemoteFlowSource
  }

  override predicate isSink(DataFlow::PathNode sink) {
    sink instanceof UnsafeExecuteArg
  }

  override predicate isSanitizer(DataFlow::PathNode barrier) {
    barrier instanceof ParameterizedQuery
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, AiopgSQLiConfig conf
where conf.hasFlowPath(source, sink)
select sink, "Detected string concatenation with a non-literal variable in an aiopg Python SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized. " +
  "Use parameterized queries instead."
