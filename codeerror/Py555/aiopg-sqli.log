Rule Content:
/**
 * @name aiopg-sqli
 * @kind path-problem
 * @problem.severity warning
 * @id python/aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg Python SQL
 *              statement. This could lead to SQL injection if the variable is user-controlled
 *              and not properly sanitized. Use parameterized queries instead.
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    isUserInput()
  }
}

class AiopgExecuteSink extends DataFlow::Node {
  AiopgExecuteSink() {
    exists(MethodCall mc |
      mc.getTarget().hasQualifiedName("aiopg.Cursor", "execute") and
      mc.getArg(0) = this
    ) and
    not this.getValue().regexpMatch('^"(?:[^"]|"")*"$')
  }
}

class ParameterizedQuerySanitizer extends DataFlow::Node {
  ParameterizedQuerySanitizer() {
    exists(MethodCall mc |
      mc.getTarget().hasQualifiedName("aiopg.Cursor", "execute") and
      mc.getArg(0) = this and
      mc.getNumArg() > 1
    )
  }
}

class AiopgSqlInjectionConfig extends TaintTracking::Configuration {
  AiopgSqlInjectionConfig() { this = "AiopgSqlInjectionConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof AiopgExecuteSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }
}

from AiopgSqlInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection due to string concatenation with user input in aiopg.execute()"
