Rule Content:
/**
 * @name aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 *              Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/aiopg-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class AiopgCursorExecute extends DataFlow::CallNode {
  AiopgCursorExecute() {
    exists(Method m, Class c |
      m.hasName("execute") and
      c.hasName("Cursor") and
      m.getDeclaringType() = c and
      c.getAPlusPlusName() = "aiopg" and
      this = m.getACall()
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() { isUserInput(this) }
}

predicate isTaintedString(DataFlow::Node node) {
  exists(string content |
    node.asExpr() = content and
    not content.regexpMatches("^\"(?:[^\"]|\"\")*\"\$")
  )
}

class AiopgSqliConfig extends TaintTracking::Configuration {
  AiopgSqliConfig() { this = "Aiopg SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(AiopgCursorExecute call |
      call.getArgument(0) = sink.asExpr() and
      isTaintedString(sink)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AiopgCursorExecute call |
      call.getAnArgument() = sanitizer.asExpr() and
      call.getNumArgument() > 1
    )
  }
}

from AiopgSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection in aiopg due to string concatenation with user input. Use parameterized queries.", source,
  "User input flows to SQL query here."
