Rule Content:
/**
 * @name aiopg SQL injection
 * @description Detected string concatenation with a non-literal variable in an aiopg Python SQL statement. 
 * @kind path-problem
 * @problem.severity warning
 * @id python/aiopg-sqli
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class AiopgCall extends DataFlow::CallCfgNode {
  AiopgCall() {
    exists(Method m, string methodName |
      m.getName() = "execute" and
      m.getAPackage() = "aiopg" and
      this = m.getACall()
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(MethodAccess ma |
      (ma.isBuiltin("input") or ma.isBuiltin("getattr") or 
       ma.getMethod().getName().matches("%request.%")) and
      this = ma.getArgument(0)
    )
  }
}

class SQLInjectionTaint extends TaintTracking::Configuration {
  SQLInjectionTaint() { this = "SQL Injection in aiopg" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(AiopgCall call |
      sink = call.getArgument(0) and
      not call.getArgument(0).getStringValue().regexpMatch("^\"(?:[^\"]|\"\")*\"$")
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(AiopgCall call |
      call.getNumArgument() > 1 and
      node = call.getArgument(0)
    )
  }
}

from SQLInjectionTaint cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected string concatenation with a non-literal variable in an aiopg Python SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled.", 
  source, sink,
  "Use parameterized queries instead"
