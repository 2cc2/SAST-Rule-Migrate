Rule Content:
/**
 * @name aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 *              Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id py/aiopg-sqli
 */

import python
import semmle.python.security.strings.TaintedStrings
import semmle.python.dataflow.DataFlow
import semmle.python.api.objects.aio.Cursor

class AiopgCursorExecute extends DataFlow::Node {
  AiopgCursorExecute() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getQualifier().getType().getName() = "Cursor" and
      ma.getQualifier().getType().getSourceDeclaration().getFile().getAbsolutePath().matches("%aiopg%") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(SourceNode src | src.(RemoteFlowSource).isUserInput() and this.asExpr() = src.asExpr())
  }
}

class AiopgParameterizedQuerySanitizer extends DataFlow::BarrierGuard {
  override predicate checks(DataFlow::Node node, DataFlow::FlowState state) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getQualifier().getType().getName() = "Cursor" and
      ma.getQualifier().getType().getSourceDeclaration().getFile().getAbsolutePath().matches("%aiopg%") and
      ma.getNumberOfArguments() > 1 and
      node.asExpr() = ma.getArgument(0)
    )
  }
}

query predicate isTaintedAiopgSqlQuery(DataFlow::PathNode source, DataFlow::PathNode sink) {
  exists(DataFlow::PathConfiguration cfg |
    DataFlow::globalPathGraph(cfg, source, sink) and
    source.getNode() instanceof UserInputSource and
    sink.getNode() instanceof AiopgCursorExecute and
    not exists(DataFlow::BarrierGuard b |
      b instanceof AiopgParameterizedQuerySanitizer and
      cfg.hasBarrier(sink, b, _)
    )
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where isTaintedAiopgSqlQuery(source, sink)
select sink, "Potential SQL injection vulnerability due to unparameterized query in aiopg", source,
  "This SQL query uses user input directly. Consider using parameterized queries instead."
