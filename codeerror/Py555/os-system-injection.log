Rule Content:
/**
 * @name OS Command Injection
 * @description Detects use of user-controlled data in os.system calls
 * @kind path-problem
 * @problem.severity error
 * @id python/security/code-injection/os-system-injection
 */

import python
import DataFlow::TaintTracking
import DataFlow::RemoteFlowSources

class FlaskRequestSource extends DataFlow::RemoteFlowSources::RemoteFlowSource {
  FlaskRequestSource() {
    exists(DataFlow::CallSignature route |
      route.getPackage().getName() = "flask" and
      route.getName().matches("%request%")
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(string paramName |
      paramName = this.asParameter().getName() and
      paramName.matches("ROUTEVAR|INTERM")
    )
  }
}

class OsSystemSink extends DataFlow::Node {
  OsSystemSink() {
    exists(DataFlow::MethodAccess ma |
      ma.getMethod().getName() = "system" and
      ma.getQualifier().getType().getName() = "os" and
      this = ma.getAnArgument(0)
    )
  }
}

class OsSystemInjectionConfiguration extends TaintTracking::Configuration {
  OsSystemInjectionConfiguration() { this = "OsSystemInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OsSystemSink
  }
}

from OsSystemInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "User data detected in os.system. This could be vulnerable to a command injection and should be avoided. If this must be done, use the 'subprocess' module instead and pass the arguments as a list."
