Rule Content:
/**
 * @name OS Command Injection via os.system
 * @description Detects user-controlled data flowing into os.system call,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/os-command-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.WebFlask

/** Sources from Flask request objects */
private class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getAPackageName() = "flask" and
      ma.getMethod().getDeclaringType().getName() = "request" and
      ma.getCaller() = this.asExpr()
    )
  }
}

/** Sources from route parameters */
private class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Parameter p |
      p.getFunction().getAPackageName().matches("%flask%") and
      (
        p.getName().matches("%ROUTEVAR%") or
        p.getName().matches("%INTERM%")
      ) and
      p = this.asParameter()
    )
  }
}

/** Combined source definition */
private class Source extends DataFlow::Node {
  Source() {
    this instanceof FlaskRequestSource or
    this instanceof RouteParameterSource
  }
}

/** Sink definition for os.system calls */
private class SystemSink extends DataFlow::Node {
  SystemSink() {
    exists(MethodAccess ma |
      ma.getMethod().getAPackageName() = "os" and
      ma.getMethod().getName() = "system" and
      ma.getAnArg() = this.asExpr()
    )
  }
}

/** Taint propagation through function arguments etc. */
module TaintConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { source instanceof Source }
  predicate isSink(DataFlow::Node sink) { sink instanceof SystemSink }

  predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagation from arguments to parameters
    exists(Function f, Parameter p, int argPos |
      f.getParameter(argPos) = p and
      node1.asExpr() = f.getAnArg(argPos) and
      node2.asParameter() = p
    )

    or

    // Propagation through field assignment
    exists(Field f, DataFlow::FieldRead fr |
      fr.getField() = f and
      node1.asExpr() = fr.getReceiver() and
      node2.asExpr() = DataFlow::fieldWrite(f).getReceiver()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig config
where config.hasFlowPath(source, sink)
select sink, "User data detected in os.system. This could be vulnerable to a command injection $@.",
  source, "originating from here", sink, "reaching here"
