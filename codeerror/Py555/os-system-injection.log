Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection and should be avoided. 
 *              If this must be done, use the 'subprocess' module instead and pass the arguments as a list.
 * @kind taint
 * @severity ERROR
 * @id py/command-injection
 */

import python
import semmle.python.dataflow.TaintTracking

class FlaskRequestSource extends DataFlow::SourceNode {
  FlaskRequestSource() {
    exists(Call call | 
      call.getTarget().matches("flask.request.*") and call = this.asExpr()
    )
  }

  override predicate isSource(DataFlow::Node src) {
    exists(Call call | 
      call.getTarget().matches("flask.request.*") and call = src.asExpr()
    )
  }
  
  override DataFlow::Node asCfgNode() { asExpr() }
  override string getLocation() { toString() }
  override string toString() { "Flask request source" }
}

class RouteParamSource extends DataFlow::SourceNode {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().regexpMatches(".*RouteVar") and // 修改成正则模式
      p = this.asParameter()
    )
  }

  override predicate isSource(DataFlow::Node src) {
    exists(Parameter p |
      p.getName().regexpMatches(".*RouteVar") and
      p = src.asParameter()
    )
  }
  
  override DataFlow::Node asCfgNode() { asParameter() }
  override string getLocation() { toString() }
  override string toString() { "Route parameter source" }
}

class OsSystemSink extends DataFlow::SinkNode {
  OsSystemSink() {
    exists(Call call |
      call.getTarget().matches("os.system") and
      call.getAnArgument() = this.asExpr()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getTarget().matches("os.system") and
      call.getAnArgument() = sink.asExpr()
    )
  }
  
  override DataFlow::Node asCfgNode() { asExpr() }
  override string getLocation() { toString() }
  override string toString() { "os.system() sink" }
}

class CommandInjectionConfiguration extends TaintTracking::Configuration {
  CommandInjectionConfiguration() { this = "CommandInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OsSystemSink
  }
}

from CommandInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User data reaches os.system(). This could be vulnerable to command injection."
