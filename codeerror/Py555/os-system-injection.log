Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/os-system-injection
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.Flask
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(API::CallNode call |
      call.getPackage() = "flask" and
      call.getType() = "flask.request" and
      call.getMethod() instanceof Wildcard and
      call = this.asExpr()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(FunctionDef::Parameter param |
      regexMatches(/(ROUTEVAR|INTERM)/, param.getName()) and
      param = this.asParameter()
    )
  }
}

class OsSystemSink extends DataFlow::Node {
  OsSystemSink() {
    exists(API::CallNode call |
      call.getPackage() = "os" and
      call.getMethod() = "system" and
      call.getArgument(0) = this.asExpr()
    )
  }
}

class OsSystemInjectionConfig extends TaintTracking::Configuration {
  OsSystemInjectionConfig() {
    this = "OsSystemInjectionConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OsSystemSink
  }
}

from OsSystemInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User data detected in os.system. This could be vulnerable to a command injection and should be avoided. If this must be done, use the 'subprocess' module instead and pass the arguments as a list."
