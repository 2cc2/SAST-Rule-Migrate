Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection 
 * and should be avoided. If this must be done, use the 'subprocess' module instead and pass 
 * the arguments as a list.
 * @kind path-problem
 * @problem.severity ERROR
 * @id py/os-system-injection
 */

import python
import semmle.python.dataflow.ExternalFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.web.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma | 
      ma.getMethod().getDeclaringType().hasQualifiedName("flask", "request") and
      ma.getMethod().hasName(getUnderscoreWildcardPattern()) and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p | 
      (p.getName().regexpMatch(".*ROUTEVAR.*|.*INTERM.*")) and
      this.asParameter() = p
    )
  }
}

class OsSystemSink extends DataFlow::Node {
  OsSystemSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("os") and
      ma.getMethod().hasName("system") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class OsSystemInjectionConfig extends TaintTracking::Configuration {
  OsSystemInjectionConfig() { this = "OsSystemInjectionConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OsSystemSink
  }
  
  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Argument to parameter flow
    (
      exists(Parameter p, ArgumentToParameter atp |
        node1.asExpr() = atp.getSourceArgument() and
        node2.asParameter() = p and
        atp.transfers(node1, node2)
      )
    ) or
    // Field assignment flow
    (
      exists(DataFlow::FieldWrite fw |
        fw.getBase().getAFieldWrite() = node2.asDef() and
        fw.getSource() = node1.asDef()
      )
    )
  }
}

from OsSystemInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "User data detected in os.system. This could be vulnerable to a command injection."
