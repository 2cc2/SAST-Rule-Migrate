Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection and should be avoided. If this must be done, use the 'subprocess' module instead and pass the arguments as a list.
 * @kind problem
 * @problem.severity error
 * @id py/command-injection
 */

import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts
import Regexp

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask", "request", _) and
      this = ma
    )
  }

  override string getSourceType() { result = "Flask request" }

  override string toString() { result = "Flask request parameter" }
}

class RouteParamSource extends TaintTracking::Source {
  RouteParamSource() {
    exists(Parameter p |
      (p.getName().matches("ROUTEVAR") or p.getName().matches("INTERM")) and
      this = p
    )
  }

  override string getSourceType() { result = "URL route parameter" }

  override string toString() { result = "URL route parameter" }
}

class OsSystemSink extends TaintTracking::Sink {
  OsSystemSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("os", "system") and
      this = ma.getAnArgument(0)
    )
  }

  override string getSinkType() { result = "os.system call" }

  override string toString() { result = "os.system call with unsanitized input" }
}

class OsSystemConfiguration extends TaintTracking::Configuration {
  OsSystemConfiguration() { this = "OsSystemConfiguration" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof OsSystemSink
  }
}

from OsSystemConfiguration cfg, TaintTracking::PathNode source, TaintTracking::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential command injection vulnerability from $@ to $@.",
  source, source.toString(), sink, sink.toString()
