Rule Content:
/**
 * @name os.system command injection
 * @description User data detected in os.system. This could be vulnerable to a command injection.
 * @kind problem
 * @problem.severity error
 * @id python/os-command-injection
 */

import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("request") and
      ma.getMethod().getDeclaringType().hasQualifiedName("flask", "request") and
      this.asExpr() = ma
    )
  }

  override predicate isSource() { this = any(FlaskRequestSource f) }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Parameter p |
      p.getName().regexpMatch("ROUTEVAR|INTERM") and
      this.asParameter() = p
    )
  }

  override predicate isSource() { this = any(RouteParameterSource r) }
}

class SystemSink extends DataFlow::Node {
  SystemSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "system" and
      ma.getMethod().getDeclaringType().hasQualifiedName("os", "os") and
      this.asExpr() = ma.getAnArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) { sink = any(SystemSink s) }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SystemSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Argument to parameter flow
    exists(Expr arg, Parameter param |
      node1.asExpr() = arg and
      node2.asParameter() = param and
      exists(Function f | f.getAParameter() = param | arg = f.getAnArgument(param.getIndex()))
    ) or
    // Field store flow
    exists(FieldWrite fw | node1.asExpr() = fw.getRhs() and node2.asExpr() = fw.getLhs())
  }
}

from CommandInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User data in os.system call. $@.", 
  source.getNode(), "This could lead to command injection"
