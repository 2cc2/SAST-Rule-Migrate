/**
 * @name os-system-injection
 * @kind problem
 * @id python/os-system-injection
 * @problem.severity error
 */

import semmle.python.security.dataflow.TaintTracking::Configuration
import semmle.python.web.Flask::Request
import semmle.code.cpp.ir.dataflow.DataFlow
import semmle.python.ApiGraphs

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() {
    exists(API::Method m | 
      m.getName().regexpMatch(".*") and
      m.getAPIPackageName() = "flask" and
      m.getAPIClassName() = "flask.request" and
      this.asExpr() = m.getACall()
    )
  }
}

class RouteParamSource extends TaintTracking::Source {
  RouteParamSource() {
    exists(FunctionDef::Parameter param |
      param.getName().matches(/(ROUTEVAR|INTERM)/) and
      this.asExpr() = param.getAnAccess()
    )
  }
}

class OsSystemSink extends TaintTracking::Sink {
  OsSystemSink() {
    exists(API::Method m |
      m.getAPIPackageName() = "os" and
      m.getAPIClassName() = "os" and
      m.getName() = "system" and
      this.asExpr() = m.getACall().getArg(0)
    )
  }
}

class CommandInjectionConfiguration extends TaintTracking::Configuration {
  CommandInjectionConfiguration() { this = "Command Injection Configuration" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof OsSystemSink
  }
}

from CommandInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "User data detected in os.system. This could be vulnerable to a command injection and should be avoided. If this must be done, use the 'subprocess' module instead and pass the arguments as a list."
