Rule Content:
/**
 * @name OS System Command Injection
 * @description User data detected in os.system. This could be vulnerable to a command injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/command-injection
 */

import python
import python.ApiGraphs
import python.web.Flask
import python.security.dataflow.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() {
    exists(Method m | m.getAPackageName() = "flask" and m.getACallableName() = "request" |
      this.asExpr() = m.getACall()
    )
  }

  override predicate isSourceOf(DataFlow::Node source) { this.asExpr() = source.asExpr() }
}

class RouteParamSource extends TaintTracking::Source {
  RouteParamSource() {
    exists(Parameter param | param.getName().regexpMatch("(ROUTEVAR|INTERM)") |
      this.asExpr() = param.getAnAccess()
    )
  }

  override predicate isSourceOf(DataFlow::Node source) { this.asExpr() = source.asExpr() }
}

class OSCommandSink extends TaintTracking::Sink {
  OSCommandSink() {
    exists(Method m | m.getAPackageName() = "os" and m.getAMethodName() = "system" |
      this.asExpr() = m.getACall()
    )
  }

  override predicate isSink(DataFlow::Node sink) { this.asExpr() = sink.asExpr() }
}

class CommandInjectionConfiguration extends TaintTracking::Configuration {
  CommandInjectionConfiguration() { this = "CommandInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    any(FlaskRequestSource s).isSourceOf(source) or
    any(RouteParamSource s).isSourceOf(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    any(OSCommandSink s).isSink(sink)
  }
}

from CommandInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode().asExpr(), "User data detected in os.system. This could be vulnerable to a command injection and should be avoided.",
  source.getNode().asExpr(), "User input source"
