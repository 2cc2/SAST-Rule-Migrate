Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection and should be avoided. 
 * If this must be done, use the 'subprocess' module instead and pass the arguments as a list.
 * @kind path-problem
 * @id python/os-system-injection
 * @problem.severity error
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.Request

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(FunctionValue f | 
      f.getPackage().getName() = "flask" and 
      f.getName().matches("%request%") and
      this.asParameter() = f.getACall().getAnArgument()
    )
    or
    exists(Parameter p |
      p.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this.asParameter() = p
    )
  }
}

class OsSystemSink extends DataFlow::Sink {
  OsSystemSink() {
    exists(FunctionValue f |
      f.getPackage().getName() = "os" and
      f.getName() = "system" and
      this.asParameter() = f.getACall().getAnArgument(0)
    )
  }
}

class OsSystemConfiguration extends TaintTracking::Configuration {
  OsSystemConfiguration() {
    this = "os-system-injection"
  }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof OsSystemSink
  }
}

from OsSystemConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential command injection vulnerability from user input to os.system().", source,
  "User input reaches this os.system() call."
