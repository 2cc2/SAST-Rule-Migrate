Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in `csv` module.
 * @kind problem
 * @problem.severity error
 * @id py/csv-writer-injection
 */

import python
import DataFlow::TaintTracking
import python.web.flask.Flask
import python.Concepts

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask.request", "form.get") or
      ma.getMethod().hasQualifiedName("flask.request", "form.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "args.get") or
      ma.getMethod().hasQualifiedName("flask.request", "args.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "values.get") or
      ma.getMethod().hasQualifiedName("flask.request", "values.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "cookies.get") or
      ma.getMethod().hasQualifiedName("flask.request", "cookies.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "headers.get") or
      ma.getMethod().hasQualifiedName("flask.request", "headers.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "view_args.get") or
      ma.getMethod().hasQualifiedName("flask.request", "view_args.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "get_json") or
      exists(Parameter p |
        p.getAnnotatedValue().getValue().toString() = "@$APP.route($ROUTE)" and
        this = p.asParameter()
      )
    ) and
    this = ma.asExpr()
  }
}

class CsvWriterSink extends DataFlow::Node {
  CsvWriterSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("csv.writer", "writerow") or
      ma.getMethod().hasQualifiedName("csv.writer", "writerows") or
      ma.getMethod().hasQualifiedName("csv.writer", "writeheader") and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class TaintConfig extends DataFlow::Configuration {
  TaintConfig() { this = "CSV Writer Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CsvWriterSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where any(TaintConfig tc).hasFlow(source, sink)
select sink, "Detected user input into a generated CSV file using the built-in `csv` module. " +
  "If user data is used to generate the data in this file, it is possible that an attacker " +
  "could inject a formula when the CSV is imported into a spreadsheet application."
