Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detects user input flowing into CSV writer methods without sanitization
 * @kind path-problem
 * @problem.severity error
 * @id python/csv-writer-injection
 */

import python
import python.web.flask.Functions
import DataFlow::PathGraph
import TaintTracking::Config

class CSVWriterCall extends DataFlow::MethodCallNode {
  CSVWriterCall() {
    this.getTarget().hasQualifiedName("csv.writer", "writerow") or
    this.getTarget().hasQualifiedName("csv.writer", "writerows") or
    this.getTarget().hasQualifiedName("csv.writer", "writeheader")
  }

  override predicate hasLocation(DataFlow::Node node) { node = this.asExpr() }
}

class CSVInjectionSink extends TaintTracking::TaintSink {
  CSVInjectionSink() {
    exists(CSVWriterCall call | this.asExpr() = call.asExpr())
  }

  override predicate sinks(TaintTracking::TaintSink sink) { sink = this }
}

class FlaskParamsSource extends TaintTracking::TaintSource {
  FlaskParamsSource() {
    exists(DataFlow::MethodCallNode call |
      call.getTarget().matches(["flask.request.%", "%get", "%__getitem__"]) and
      this.asExpr() = call.getAnArgument(0).asExpr()
    )
    or
    exists(Function f, Parameter p |
      f.getAChild() instanceof Annotation and
      f.getAChild().toString().matches("@%APP.route%") and
      p = f.getAParameter() and
      this.asParameter() = p
    )
  }

  override predicate sources(TaintTracking::TaintSource source) { source = this }

  override DataFlow::Node asExpr() { result[X] = xs ->
    exists(DataFlow::MethodCallNode call |
      call.getTarget().matches(["flask.request.%", "%get", "%__getitem__"]) and
      X = call.getAnArgument(0)
    )
    or
    exists(Function f, Parameter p |
      f.getAChild() instanceof Annotation and
      f.getAChild().toString().matches("@%APP.route%") and
      p = f.getAParameter() and
      result[X] = p.asExpr()
    )
  }

  override Parameter asParameter() { result = p |
    exists(Function f |
      f.getAChild() instanceof Annotation and
      f.getAChild().toString().matches("@%APP.route%") and
      p = f.getAParameter()
    )
  }
}

class CSVInjectionConfig extends TaintTracking::Configuration {
  CSVInjectionConfig() { this = "CSVWriterInjectionConfiguration" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskParamsSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof CSVInjectionSink
  }
}

from CSVInjectionConfig config, TaintTracking::PathNode source, TaintTracking::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink, "User input flows into CSV writer without sanitization, risking formula injection"
