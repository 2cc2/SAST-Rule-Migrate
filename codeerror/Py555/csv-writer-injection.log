import python
import semmle.python.security.DataFlow

class FlaskRequest extends DataFlow::Node {
  FlaskRequest() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName() = "flask.request.form.get" or
      call.getMethod().getQualifiedName() = "flask.request.form.__getitem__" or
      call.getMethod().getQualifiedName() = "flask.request.args.get" or
      call.getMethod().getQualifiedName() = "flask.request.args.__getitem__" or
      call.getMethod().getQualifiedName() = "flask.request.values.get" or
      call.getMethod().getQualifiedName() = "flask.request.values.__getitem__" or
      call.getMethod().getQualifiedName() = "flask.request.cookies.get" or
      call.getMethod().getQualifiedName() = "flask.request.cookies.__getitem__" or
      call.getMethod().getQualifiedName() = "flask.request.headers.get" or
      call.getMethod().getQualifiedName() = "flask.request.headers.__getitem__" or
      call.getMethod().getQualifiedName() = "flask.request.view_args.get" or
      call.getMethod().getQualifiedName() = "flask.request.view_args.__getitem__" or
      call.getMethod().getQualifiedName() = "flask.request.get_json"
    )
  }
}

class CsvWriteCall extends DataFlow::Node {
  CsvWriteCall() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName() = "csv.writer.writerow" or
      call.getMethod().getQualifiedName() = "csv.writer.writerows" or
      call.getMethod().getQualifiedName() = "csv.writer.writeheader"
    )
  }
}

class Config extends DataFlow::Configuration {
  Config() { this = "CSV Writer Injection" }

  override predicate isSource(DataFlow::Node source) {
    exists(FlaskRequest req |
      source.asExpr() = req.asExpr()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(CsvWriteCall call |
      sink.asExpr() = call.getReceiver().getAnAccess()
    )
  }
}

from Config config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
