Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in `csv` module.
 * @kind taint
 * @problem.severity ERROR
 * @id python/csv-writer-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.web.flask.Flask

class CSVInjectionSink extends DataFlow::Node {
  CSVInjectionSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("csv.writer", "writerow") or
      ma.getMethod().hasQualifiedName("csv.writer", "writerows") or
      ma.getMethod().hasQualifiedName("csv.writer", "writeheader") |
      this.asExpr() = ma.getAnArgument()
    )
  }
}

class FlaskParamsSource extends DataFlow::Node {
  FlaskParamsSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask.request", "form.get") or
      ma.getMethod().hasQualifiedName("flask.request", "form.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "args.get") or
      ma.getMethod().hasQualifiedName("flask.request", "args.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "values.get") or
      ma.getMethod().hasQualifiedName("flask.request", "values.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "cookies.get") or
      ma.getMethod().hasQualifiedName("flask.request", "cookies.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "headers.get") or
      ma.getMethod().hasQualifiedName("flask.request", "headers.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "view_args.get") or
      ma.getMethod().hasQualifiedName("flask.request", "view_args.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "get_json") 
      |
      this.asExpr() = ma
    ) or
    exists(Function f, Parameter p |
      f.getAnAnnotation().getValue().regexpMatch("@[^\\.]+\\.route\\(.*\\)") and
      p = f.getAParameter() and
      this.asParameter() = p
    )
  }
}

class CSVInjectionConfig extends TaintTracking::Configuration {
  CSVInjectionConfig() { this = "CSVInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskParamsSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CSVInjectionSink
  }
}

from CSVInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential CSV injection via user input from $@.", source, source.toString()
