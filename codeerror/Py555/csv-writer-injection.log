Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in `csv` module.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/csv-writer-injection
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.FlaskRequest
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getMethod().(Method).getAPIName() in [
        "form.get", "form.__getitem__", "args.get", "args.__getitem__",
        "values.get", "values.__getitem__", "cookies.get", "cookies.__getitem__",
        "headers.get", "headers.__getitem__", "view_args.get", "view_args.__getitem__", "get_json"
      ] and
      call.getReceiverType().(RefType).getQualifiedName() = "flask.request"
    ) or
    exists(Method m, string routeAnnotation |
      m.getAnAnnotation().getValue().regexpMatch("@.*\\.route\\(.*\\)") and
      m.getAParameter() = this
    )
  }
}

class CsvWriteSink extends DataFlow::Sink {
  CsvWriteSink() {
    exists(MethodCall call |
      call.getMethod().(Method).getAPIName() in ["writerow", "writerows", "writeheader"] and
      call.getReceiverType().(RefType).getQualifiedName() = "csv.writer" and
      call.getArgument(0) = this
    )
  }
}

class CsvWriterInjectionConfig extends TaintTracking::Configuration {
  CsvWriterInjectionConfig() { this = "CSV Writer Injection" }

  override predicate isSource(DataFlow::Source source) { source instanceof FlaskRequestSource }

  override predicate isSink(DataFlow::Sink sink) { sink instanceof CsvWriteSink }
}

from CsvWriterInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected user input into a generated CSV file using the built-in `csv` module $" +
  "If user data is used to generate the data in this file, it is possible that an attacker $" +
  "could inject a formula when the CSV is imported into a spreadsheet application that runs $" +
  "an attacker script, which could steal data from the importing user or install malware.", 
  source, "User input source"
