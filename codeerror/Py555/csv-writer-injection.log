Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in `csv` module.
 *              If user data is used to generate the data in this file, it is possible that
 *              an attacker could inject a formula when the CSV is imported into a spreadsheet
 *              application.
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-1236
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.Flask
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Method m, string prop |
      m.getName() in [
        "form.get", "form.__getitem__",
        "args.get", "args.__getitem__",
        "values.get", "values.__getitem__",
        "cookies.get", "cookies.__getitem__",
        "headers.get", "headers.__getitem__",
        "view_args.get", "view_args.__getitem__",
        "get_json"
      ] and
      m.getACallable().getReceiver().getType().getName() = "flask.request" and
      this.asParameter() = m.getAParameter() or
      this.asExpr() = m.getACall().getArgument(0)
    ) or
    exists(MethodParameter p |
      p.getAnAnnotation().getExpr().toString().regexpMatch("@\\$APP\\.route\\(\\$ROUTE\\)")
    )
  }
}

class CsvWriterSink extends DataFlow::Node {
  CsvWriterSink() {
    exists(Method method |
      method.getName() in ["writerow", "writerows", "writeheader"] and
      method.getACallable().getReceiver().getType().getName() = "csv.writer" and
      this.asExpr() = method.getACall().getArgument(0)
    )
  }
}

class CsvWriterInjectionConfig extends TaintTracking::Configuration {
  CsvWriterInjectionConfig() { this = "CsvWriterInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CsvWriterSink
  }
}

from CsvWriterInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential CSV injection vulnerability from user input to CSV writer", 
  source, "User input source"
