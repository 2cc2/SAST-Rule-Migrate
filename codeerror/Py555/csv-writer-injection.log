Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in `csv` module. If user data is used to 
 *  generate the data in this file, it is possible that an attacker could inject a formula when the CSV is imported 
 *  into a spreadsheet application that runs an attacker script.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/csv-writer-injection
 */

import semmle.python.Python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Query

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Method m, string argName |
      m.getDeclaringType().getName() = "Flask" and
      (m.getName() = "request" or m.getName() = "get_json") and
      this.asParameter() = m.getAParameter(argName).getAnAnnotation()
    )
    or
    exists(Parameter p |
      p.getAnAnnotation().getType().getName() = "route" and
      this.asParameter() = p
    )
  }
}

class CsvWriterSink extends DataFlow::Node {
  CsvWriterSink() {
    exists(Call c |
      c.getTarget().hasQualifiedName("csv", "writer") and
      (c.getTarget().getName() = "writerow" or
       c.getTarget().getName() = "writerows" or
       c.getTarget().getName() = "writeheader") and
      this = c.getArgument(0)
    )
  }
}

class CsvWriterInjectionConfig extends TaintTracking::Configuration {
  CsvWriterInjectionConfig() { this = "CsvWriterInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CsvWriterSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, CsvWriterInjectionConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Potential CSV injection vulnerability from user input to CSV writer operation."
