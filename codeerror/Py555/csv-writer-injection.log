Rule Content:
/** 
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in `csv` module. If user data is used to generate 
 *     the data in this file, it is possible that an attacker could inject a formula when the CSV is imported into a 
 *     spreadsheet application that runs an attacker script, which could steal data from the importing user or, 
 *     at worst, install malware on the user's computer.
 * @kind path-problem
 * @problem.severity error
 * @id python/csv-writer-injection
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.Flask
import semmle.python.Concepts

class FlaskRequestSource extends TaintSource::Range {
  FlaskRequestSource() {
    exists(RequestParamAccess param |
      param.asExpr() = this.asExpr()
    )
    or
    exists(Method method, string route, string app |
      method.getAnnotation("route").getValue(app + ".route(" + route + ")") and
      this.asParameter() = method.getAParameter()
    )
  }
}

class CsvWriteSink extends TaintSink::Range {
  CsvWriteSink() {
    exists(MethodAccess writeCall |
      writeCall.getMethod().getName().matches("writerow|writerows|writeheader") and
      writeCall.getQualifier().getType().getName() = "csv.writer" and
      writeCall.getArgument(0) = this.asExpr()
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "CSVWriterInjection" }
  
  override predicate isSource(TaintSource::Range source) {
    source instanceof FlaskRequestSource
  }
  
  override predicate isSink(TaintSink::Range sink) {
    sink instanceof CsvWriteSink
  }
}

from Config cfg, TaintSource::Range source, TaintSink::Range sink
where cfg.hasFlow(source, sink)
select sink, source, sink, "Potential CSV injection vulnerability from user input to CSV writer"
