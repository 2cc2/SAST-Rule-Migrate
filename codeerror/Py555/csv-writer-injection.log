Rule Content:
/**
 * @name CSV Writer Injection
 * @kind problem
 * @id python/csv-writer-injection
 * @severity error
 * @message Detected user input into a generated CSV file using the built-in `csv` module. 
 *          If user data is used to generate the data in this file, it is possible that an 
 *          attacker could inject a formula when the CSV is imported into a spreadsheet application
 */

import python
import DataFlow
import DataFlow::TaintTracking
import DataFlow::FlaskRequest

class FlaskSource extends DataFlow::Node {
  FlaskSource() {
    exists(DataFlow::Call call |
      call = DataFlow::FlaskRequest::asInputSource(_) and
      this.asParameter() = call.getArgument(0)
    )
  }
}

class CsvSink extends DataFlow::Node {
  CsvSink() {
    exists(DataFlow::Call call |
      call.getTarget().hasName(["writerow", "writerows", "writeheader"]) and
      call.getTarget().getEnclosingModule().getName() = "csv" and
      this.asParameter() = call.getArgument(0)
    )
  }
}

class Config extends DataFlow::TaintTracking::Configuration {
  Config() { this = "csv-writer-injection" }

  override predicate isSource(DataFlow::Node source) { source instanceof FlaskSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CsvSink }
}

from Config config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Potentially unsafe user input written to CSV file"
