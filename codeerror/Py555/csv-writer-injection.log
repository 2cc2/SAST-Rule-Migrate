Rule Content:
/**
 * @name CSV Formula Injection
 * @description Detects user input into generated CSV files that could lead to formula injection
 * @id csv-writer-injection
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-1236
 */

import python
import DataFlow::PathGraph
import python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    // Track Flask request parameters
    exists(MethodAccess ma |
      ma.getMethod().hasName(["form", "args", "values", "cookies", "headers", "view_args"]) and
      (ma.getMethod().hasQualifiedName("flask.request", _) or
       ma.getReceiver().getType().hasQualifiedName("flask.request", _))
    )
    or
    exists(Parameter p |
      p.getAnnotatedElement().getAnAnnotation().getType().hasQualifiedName("flask.route", "route")
    )
  }
}

class CsvWriteSink extends DataFlow::Node {
  CsvWriteSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("csv.writer", "writerow") or
      ma.getMethod().hasQualifiedName("csv.writer", "writerows") or
      ma.getMethod().hasQualifiedName("csv.writer", "writeheader")
    )
  }
}

class CsvFormulaInjectionConfig extends DataFlow::Configuration {
  CsvFormulaInjectionConfig() { this = "CsvFormulaInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CsvWriteSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, CsvFormulaInjectionConfig cfg
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(),
  "Detected user input into a generated CSV file using the built-in `csv` module. " +
  "If user data is used to generate the data in this file, it is possible that an " +
  "attacker could inject a formula when the CSV is imported into a spreadsheet " +
  "application that runs an attacker script, which could steal data from the " +
  "importing user or, at worst, install malware on the user's computer."
