import semmle.python.dataflow.DataFlow
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.web.Http
import semmle.python.dataflow.TaintTracking

class StringFormatCall extends Call {
  StringFormatCall() {
    this.getFunc().getName().matches("%|format|f-string") or
    this.getFunc().getName() = "format"
  }
}

class SqlExecuteCall extends Call {
  SqlExecuteCall() {
    this.getFunc().getName() = "execute"
  }
}

class FormattedSqlQueryConfig extends TaintTracking::Configuration {
  FormattedSqlQueryConfig() { this = "FormattedSqlQueryConfig" }

  override predicate isSource(TaintSource source) {
    exists(StringFormatCall call |
      source.asExpr() = call.getReceiver()
    )
  }

  override predicate isSink(TaintSink sink) {
    exists(SqlExecuteCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }
}

from FormattedSqlQueryConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected possible formatted SQL query. Use parameterized queries instead."
