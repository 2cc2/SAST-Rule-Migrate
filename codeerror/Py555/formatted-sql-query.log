Rule Content:
/**
 * @name Formatted SQL Query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind problem
 * @problem.severity warning
 * @id python/security/audit/formatted-sql-query
 */

import python
import semmle.python.dataflow.ExternalFlow
import semmle.python.DataFlow
import semmle.python.Concepts

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getQualifiedName().matches("%.format") or
        ma.getMethod().getQualifiedName().matches("%.%") or
        ma.getMethod().getQualifiedName().matches("%.f-string")
      ) and
      ma.getAnArg() = this.asExpr()
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

predicate isTaintedFlow(DataFlow::Node source, DataFlow::Node sink) {
  exists(DataFlow::PathNode src, DataFlow::PathNode snk |
    DataFlow::localFlow(src, snk) and
    src.getNode() = source and
    snk.getNode() = sink
  )
}

from StringFormatSource source, SqlSink sink
where isTaintedFlow(source, sink)
select source, sink, "Detected possible formatted SQL query. Use parameterized queries instead."
