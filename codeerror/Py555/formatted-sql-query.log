/**
 * @name Formatted SQL Query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sql-injection-formatted
 */

import semmle.python.ApiGraphs
import semmle.python.dataflow.DataFlow
import semmle.python.security.dataflow.TaintTracking

class StringFormatCall extends DataFlow::Node {
  StringFormatCall() {
    exists(Call c |
      c.getTarget().getName().matches("%format") or
      c.getTarget().getName().matches("%") or
      c.getTarget().getName().matches("f-string") |
      this.asExpr() = c
    )
  }
}

class SqlExecutionCall extends API::Node {
  SqlExecutionCall() {
    exists(MethodCall mc |
      mc.getMethodName() = "execute" and
      this.asExpr() = mc and
      mc.getNumArgument() > 0
    )
  }
}

class FormattedSqlConfig extends TaintTracking::Configuration {
  FormattedSqlConfig() { this = "FormattedSqlConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatCall
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionCall and
    exists(MethodCall mc |
      mc = sink.asExpr() and
      DataFlow::exprNode(mc.getArgument(0)) = sink
    )
  }
}

from FormattedSqlConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected possible formatted SQL query. Use parameterized queries instead."
