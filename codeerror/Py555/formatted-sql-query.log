Rule Content:
/**
 * @name Formatted SQL query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind problem
 * @id python/formatted-sql-query
 * @security-severity 8.0
 * @tags security
 */

import python
import semmle.python.security.StringFormats
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class StringFormatSource extends TaintSource {
  StringFormatSource() {
    exists(MethodCall mc |
      exists(Str.strformat format |
        format.getACall().getMethod().getQualifiedName().matches(".*\\.(format|%|f-string)") and
        this.asExpr() = format
      ) or
      mc.getCalleeName() = "format" and
      this.asExpr() = mc
    )
  }

  override string getSourceType() { result = "String formatting" }
}

class SqlExecuteSink extends TaintSink {
  SqlExecuteSink() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "execute" and
      this.asExpr() = mc.getArgument(0)
    )
  }

  override string getSinkType() { result = "SQL execute call" }
}

query predicate isSource(TaintSource source) { source instanceof StringFormatSource }
query predicate isSink(TaintSink sink) { sink instanceof SqlExecuteSink }

from TaintSource source, TaintSink sink
where
  source.flowsTo(sink)
select sink, "Detected possible formatted SQL query. Use parameterized queries instead."
