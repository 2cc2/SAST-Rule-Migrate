/**
 * @name Formatted SQL query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sql-injection/formatted-query
 */

import python
import semmle.python.dataflow.DataFlow
import DataFlow::PathGraph

class StringFormatCall extends DataFlow::Node {
  StringFormatCall() {
    exists(Call call |
      call.getCallee().toString().matches("%\\.(format|%|f-string)%") and
      this.asExpr() = call
    )
  }
}

class SqlExecuteCall extends DataFlow::Node {
  SqlExecuteCall() {
    exists(Call call |
      call.getCallee().toString() = "execute" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class FormattedSqlQueryConfig extends DataFlow::Configuration {
  FormattedSqlQueryConfig() { this = "FormattedSqlQueryConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatCall
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteCall
  }

  override predicate isAdditionalFlowStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Expr arg, Parameter param |
      pred.asExpr() = arg and
      succ.asExpr() = param.getAnAccess() and
      DataFlow::localFlow(arg, param.getAnAccess())
    )
  }
}

from FormattedSqlQueryConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Detected possible formatted SQL query. Use parameterized queries instead."
