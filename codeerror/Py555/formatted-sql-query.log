import python
import SanitizedDataFlow
import DataFlow::PathGraph

class StringFormatCall extends API::Call {
  StringFormatCall() {
    exists(string.FormatMethod m |
      this.getTarget() = m or
      this.getTarget().getName() = "format" or
      this.getTarget().getName().matches("%") or
      this.getTarget().getName().matches("f-string")
    )
  }
}

class SqlExecutionCall extends API::Call {
  SqlExecutionCall() {
    this.getTarget().getName() = "execute" and
    this.getNumArg() > 0
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "FormattedSqlQueryConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof StringFormatCall
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SqlExecutionCall sqlExec |
      sink.asExpr() = sqlExec.getArg(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, Config config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected possible formatted SQL query. Use parameterized queries instead."
