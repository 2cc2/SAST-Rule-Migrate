/**
 * @name Formatted SQL Query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/security/formatted-sql-query
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.ApiGraphs

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(Call call |
      call.getTarget().isStringFormatMethod() and
      this.asExpr() = call
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(Call call |
      call.getTarget().getName() = "execute" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class FormattedSqlQueryConfig extends DataFlow::Configuration {
  FormattedSqlQueryConfig() { this = "FormattedSqlQueryConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, FormattedSqlQueryConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), "Detected possible formatted SQL query. Use parameterized queries instead.",
  source.getNode(), "This string formatting operation could lead to SQL injection."
