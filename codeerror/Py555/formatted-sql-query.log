/**
 * @name Formatted SQL query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id python/sql-injection-formatted-query
 */

import python
import semmle.python.TaintTracking
import semmle.python.Concepts

class StringFormatCall extends Call {
  StringFormatCall() {
    exists(stringMethod | 
      stringMethod = ["format", "__mod__", "format_map"] |
      getTarget().getName() = stringMethod and
      getTarget().getSourceDeclaration().getFile().getExtension() = "py"
    )
  }
}

class SqlExecuteCall extends Call {
  SqlExecuteCall() {
    getTarget().getName() = "execute" and
    exists(DataFlow::exprToVarName(arg(0)) |
      DataFlow::exprToVarName(arg(0)).matches("%sql%")
    )
  }
}

class TaintedStringFormatSource extends TaintTracking::Source {
  TaintedStringFormatSource() {
    this = StringFormatCall()
  }
  
  override DataFlow::Node getSourceNode() { result = StringFormatCall().getValue() }
}

class SqlExecuteSink extends TaintTracking::Sink {
  SqlExecuteSink() {
    this = SqlExecuteCall()
  }
  
  override DataFlow::Node getSinkNode() { result = SqlExecuteCall().getArgument(0) }
}

module TaintConfig implements TaintTracking::Configuration {
  override predicate isSource(DataFlow::Node source) {
    source instanceof TaintedStringFormatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteSink
  }
}

from TaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Formatted string flows into SQL query. Use parameterized queries instead."
