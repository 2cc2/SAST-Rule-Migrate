/**
 * @name Formatted SQL Query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id py/formatted-sql-query
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class StringFormatMethod extends DataFlow::CallNode {
  StringFormatMethod() {
    exists(string methodName | 
      this.getMethod().getName() = methodName and
      methodName.regexpMatch(".*\\.(format|%|f-string)")
    )
  }
}

class SqlExecuteCall extends DataFlow::CallNode {
  SqlExecuteCall() {
    this.getMethod().getName() = "execute" 
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "FormattedSqlQueryTaint" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() = any(StringFormatMethod sfm).getACall()
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SqlExecuteCall sec | 
      sink.asExpr() = sec.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    false
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected possible formatted SQL query. Use parameterized queries instead."
