Rule Content:
/**
 * @name FormattedSQLQuery
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/formatted-sql-query
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class StringFormatCall extends Call {
  StringFormatCall() {
    exists(Method m | this.getMethod() = m |
      m.getName().matches("%|format") or
      m.getName() = "printf" or
      exists(Expr str | this.getTarget().(StringLiteral).getValue().matches(".*f.*") and str = this.getTarget())
    )
  }
}

class SqlExecuteCall extends Call {
  SqlExecuteCall() {
    this.getMethod().getName() = "execute" and
    exists(MethodAccess ma | ma = this.getMethodAccess() |
      ma.getQualifier().getType().getName().matches(".*cursor.*|.*dbapi.*")
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "FormattedSQLQuery" }

  override predicate isSource(DataFlow::Node source) {
    exists(StringFormatCall sfc | source.asExpr() = sfc)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SqlExecuteCall sec | sink.asExpr() = sec.getArgument(0))
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected possible formatted SQL query. Use parameterized queries instead.",
  source, "This string formatting operation may introduce SQL injection vulnerabilities."
