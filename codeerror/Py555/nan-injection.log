Rule Content:
/**
 * @name NaN Injection Vulnerability
 * @description Detects user input going directly into typecast for bool(), float(),
 *              or complex() which could allow injection of Python's NaN values.
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.web.flask.Requests
import DataFlow::PathGraph

class NanInjectionConfig extends DataFlow::Configuration {
  NanInjectionConfig() { this = "NanInjectionConfig" }

  override predicate isSourceNode(DataFlow::Node source) {
    // Source from Flask request parameters
    exists(MethodCall mc |
      mc.getTarget().(Function).getName() = "get" and
      mc.getTarget().(Function).getParentScope() = flaskModule.getAMember() and
      source.asExpr() = mc.getAnArg()
    )
    or
    // Source from route variables
    exists(Function f, string paramName |
      f.getADecorator().getName() = "route" and
      f.getAParameter().getName() = paramName and
      source.asParameter() = f.getAParameter()
    )
  }

  override predicate isSinkNode(DataFlow::Node sink) {
    // Sink in type conversion functions
    exists(MethodCall mc |
      (mc.getTarget().getName() = "float" or
       mc.getTarget().getName() = "bool" or
       mc.getTarget().getName() = "complex") and
      mc.getTarget().(Function).getParentScope() instanceof BuiltinModule and
      sink.asExpr() = mc.getAnArg()
    )
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    // Allow any function call to act as sanitizer
    barrier.asExpr() instanceof Call
  }

  override predicate isAdditionalFlowStep(DataFlow::Node src, DataFlow::Node sink) {
    // Propagate taint through argument passing
    exists(DataFlow::ParameterNode pn, DataFlow::ArgumentNode an |
      an.getParameter() = pn and
      DataFlow::localFlowStep(src, an) and
      DataFlow::localFlowStep(pn, sink)
    )
  }
}

from NanInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(),
  "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
