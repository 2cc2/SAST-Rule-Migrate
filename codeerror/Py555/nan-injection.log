Rule Content:
/**
 * @name Nan Injection in Python Type Cast
 * @description Detects user input going directly into typecast for bool(), float(), or complex()
 * @kind problem
 * @id python/nan-injection
 * @severity error
 */
import python
import semmle.python.web.WebFramework
import semmle.python.Concepts
import DataFlow::PathGraph

class Source extends DataFlow::Node {
  Source() {
    // Flask request sources
    exists(DataFlow::CallNode call |
      call.getCallee().getName() = "get" and
      call.getCallee().getQualifiedName() = "flask.request.get"
    ) or
    // Route variable sources
    exists(Function func, Expr route |
      func.getADecorator().getName() = "route" and
      route = func.getADecorator().getExpr().getAnArg() and
      this.asExpr() = func.getAParameter().getAnnotatedValue()
    )
  }
}

class Sink extends DataFlow::Node {
  Sink() {
    exists(DataFlow::CallNode call |
      call.getCallee().getName() = "float" and
      call.getCallee().getQualifiedName() = "builtins.float" or
      call.getCallee().getName() = "bool" and
      call.getCallee().getQualifiedName() = "builtins.bool" or
      call.getCallee().getName() = "complex" and
      call.getCallee().getQualifiedName() = "builtins.complex"
    )
  }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof Source }

  override predicate isSink(DataFlow::Node sink) { sink instanceof Sink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(DataFlow::CallNode call | sanitizer.asExpr() = call.getAnArg())
  }
}

from NanInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast.",
  source, sink, "Potential NaN injection vulnerability"
