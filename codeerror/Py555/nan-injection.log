Rule Content:
/**
 * @name Nan Injection Vulnerability
 * @description Detects user input going directly into typecast for bool(), float(),
 *              or complex(), which could allow injection of Python's not-a-number (NaN).
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/nan-injection
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.ApiGraphs
import semmle.python.WebFlask

class Source extends DataFlow::Node {
  Source() { 
    exists(DataFlow::MethodCallNode flaskReq |
      flaskReq.getTarget().hasName("get") and
      flaskReq.getTarget().getDeclaringModule().getName() = _"flask.request" and
      this.asExpr() = flaskReq.getArg(_)
    )
    or
    exists(Method method, Parameter param |
      method.getADecorator().getCall().getTarget().getName() = @"route" and
      method.getADecorator().getCall().getTarget().getDeclaringModule().getName() = _"flask.app" and
      param = method.getAParameter() and
      this.asExpr() = param.getAnAccess()
    )
  }
}

class Sink extends DataFlow::Node {
  Sink() {
    (
      exists(DataFlow::MethodCallNode call |
        call.getTarget().hasName(["float", "bool", "complex"]) and
        call.getTarget().getDeclaringModule().getName() = "builtins" and
        this.asExpr() = call.getArg(0)
      )
    )
  }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof Source
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof Sink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(DataFlow::CallNode call | node.getANode() = call.asNode())
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Function fn, Parameter param |
      fn.getAParameter() = param and
      pred.asExpr() = fn.getACall().getAnArg() and
      succ.asExpr() = param.getAnAccess()
    )
  }
}

from NanInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found user input going directly into typecast for " + 
    sink.getNode().(DataFlow::MethodCallNode).getTarget().getName() + 
    "(), which could allow NaN injection."
