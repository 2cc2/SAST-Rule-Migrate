Rule Content:
/**
 * @name NaN Injection
 * @description Found user input going directly into typecast for bool(), float(), or complex().
 *              This allows an attacker to inject Python's not-a-number (NaN) into the typecast.
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */ 

import python
import semmle.python.security.TaintTracking 
import semmle.python.web.flask.Request

class FlaskRequestSource extends TaintSource::Range {
  FlaskRequestSource() {
    /* Source from flask.request.get() */
    exists(MethodCall getCall |
      getCall.getMethod().getName() = "get" and
      getCall.getReceiver().getType().hasQualifiedName("flask", "request")
    |
      this = getCall.getReturn()
    )
    or
    /* Source from route parameters */
    exists(Method routeMethod |
      routeMethod.getADecorator().getFunc().getName() = "route" and
      routeMethod.getADecorator().getFunc().getReceiver().getType().hasQualifiedName("flask", "app")
    |
      exists(Parameter p | p = routeMethod.getAParameter() | this = p)
    )
  }

  override string getSourceType() { result = "User-provided value" }
}

class TypeCastSink extends TaintSink::Range {
  TypeCastSink() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName() = ["builtins.float", "builtins.bool", "builtins.complex"]
    |
      this = call.getArgument(0)
    )
  }

  override string getSinkType() { result = "Type cast operation" }
}

class AnyFunctionCallSanitizer extends TaintSanitizer::Range {
  AnyFunctionCallSanitizer() {
    exists(MethodCall call | this = call)
  }

  override Predicate holdsWhenSanitized() { result = true }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NaN Injection" }

  override predicate isSource(TaintSource::Range source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(TaintSink::Range sink) {
    sink instanceof TypeCastSink
  }

  override predicate isSanitizer(TaintSanitizer::Range sanitizer) {
    sanitizer instanceof AnyFunctionCallSanitizer
  }

  override predicate isAdditionalTaintStep(TaintStep step) {
    step.getEdgeType() = "arg->param"
  }
}

from NanInjectionConfig cfg, TaintSource::Range source, TaintSink::Range sink
where cfg.hasFlow(source, sink)
select sink, "Found user input going directly into typecast for $@.", sink.getType(), "potential NaN injection"
