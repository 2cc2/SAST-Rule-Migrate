Rule Content:
/**
 * @name NaN Injection in type casting
 * @description Detects user input going directly into typecast for bool(), float(), or complex(), 
 *              which could allow injection of Python's not-a-number (NaN).
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Flask

class FlaskParamGetter extends DataFlow::Node {
  FlaskParamGetter() {
    exists(FluentAPI::Call get | 
      get.getMethodBase().getName() = "get" and
      get.getQualifier().getType().getName() = "request" and
      get.getQualifier().getType().getPackage().getName() = "flask" |
      this.asExpr() = get
    )
    or
    exists(Method m, string path | 
      m.getDecorator("route") and
      m.getParameter(_) = this.asParameter()
    )
  }
}

class TypeCastSink extends DataFlow::Node {
  TypeCastSink() {
    exists(FluentAPI::Call c |
      (c.getMethodBase().getName() = "float" or
       c.getMethodBase().getName() = "bool" or
       c.getMethodBase().getName() = "complex") and
      c.getQualifier().getType().getPackage().getName() = "builtins" |
      this.asExpr() = c
    )
  }
}

class AnyFunctionCall extends DataFlow::Node::Barrier {
  AnyFunctionCall() {
    exists(FluentAPI::Call _ | this = _.getAMethodCall())
  }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskParamGetter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TypeCastSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof AnyFunctionCall
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

