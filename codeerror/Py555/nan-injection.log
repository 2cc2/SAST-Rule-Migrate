Rule Content:
/**
 * @name NaN Injection
 * @description Detects user input going directly into typecast for bool(), float(), or complex(),
 *              allowing an attacker to inject Python's NaN values.
 * @kind path-problem
 * @problem.severity error
 * @id py/nan-injection
 */

import python
import semmle.python.web.Flask
import DataFlow
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call call |
      call = API::moduleImport("flask").getMember("request").getMember("get").getACall() and
      this.asExpr() = call
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Method m, string decoratorName |
      m.getADecorator().getFunc().getName() = "route" and
      decoratorName = m.getADecorator().getFunc().getFile().getRelativePath() and
      this.asParameter() = m.getAParameter()
    )
  }
}

class TypeCastSink extends DataFlow::Node {
  TypeCastSink() {
    exists(Call call |
      call = API::builtins().getACall() and
      call.getTarget().getName() in ["float", "bool", "complex"] and
      this.asExpr() = call
    )
  }
}

class AnyFunctionSanitizer extends DataFlow::BarrierNode {
  AnyFunctionSanitizer() {
    exists(Call _ | this.asExpr() = _)
  }
}

query predicate isSource(DataFlow::Node source) {
  source instanceof FlaskRequestSource or
  source instanceof RouteParamSource
}

query predicate isSink(DataFlow::Node sink) {
  sink instanceof TypeCastSink
}

query predicate isSanitizer(DataFlow::Node sanitizer) {
  sanitizer instanceof AnyFunctionSanitizer
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where DataFlow::flowPath(source, sink) and
  isSource(source.getNode()) and
  isSink(sink.getNode()) and
  not exists(DataFlow::PathNode sanitizer |
    DataFlow::flowPath(source, sanitizer) and
    DataFlow::flowPath(sanitizer, sink) and
    isSanitizer(sanitizer.getNode())
  )
select sink, source, sink, "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
================================================================================
