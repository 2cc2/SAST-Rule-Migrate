Rule Content:
import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import python.flask.Flask

class FlaskRequestSource extends DataFlow::Source::Range {
  FlaskRequestSource() {
    exists(Call call |
      call.getCallee().(Name).getId() = "get" and
      call.getCallee().getQualifier().(Name).getId() = "request" and
      call.getCallee().getQualifier().getQualifier().(Name).getId() = "flask" and
      this.asExpr() = call.getAnArg()
    )
  }
}

class RouteVariableSource extends DataFlow::Source::Range {
  RouteVariableSource() {
    exists(Function func, Parameter param |
      func.getADecorator().getAChild().getName() = "route" and
      param = func.getAParameter() and
      this.asExpr() = param.getAnnotatedType().getASourceLocation()
    )
  }
}

class TypeCastSink extends DataFlow::Sink::Range {
  TypeCastSink() {
    exists(Call call |
      call.getCallee().(Name).getId() = "float" or
      call.getCallee().(Name).getId() = "bool" or
      call.getCallee().(Name).getId() = "complex" and
      call.getCallee().getQualifier().(Name).getId() = "builtins" and
      this.asExpr() = call
    )
  }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjectionConfig" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteVariableSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof TypeCastSink
  }

  override predicate isSanitizer(DataFlow::Sanitizer sanitizer) {
    exists(Call call | sanitizer.asExpr() = call)
  }
}

from NanInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
