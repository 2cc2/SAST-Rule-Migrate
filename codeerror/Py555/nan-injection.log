Rule Content:
/**
 * @name NaN injection in type casting
 * @description Detects when user input goes directly into typecast for bool(), float(), or complex()
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.security.request_handling.Flask

class FlaskSource extends RemoteFlowSource::Range {
  FlaskSource() {
    (
      this = flaskRequestCall("get").getParameter(_) or
      this = flaskRouteParameter()
    )
  }
}

private predicate isTypeCastCall(FunctionCall fc) {
  fc.getTarget().getName() = ["float", "bool", "complex"] and
  fc.getTarget().getNamespace() = "builtins"
}

class TypeCastSink extends FunctionCall::Range {
  TypeCastSink() {
    isTypeCastCall(this)
  }
}

class FlaskToTypeCastTaintConfig extends TaintTracking::Configuration {
  FlaskToTypeCastTaintConfig() {
    this = "Flask to type cast taint tracking"
  }

  override predicate isSource(RemoteFlowSource source) {
    source instanceof FlaskSource
  }

  override predicate isSink(FunctionCall sink) {
    sink instanceof TypeCastSink
  }
}

from FlaskToTypeCastTaintConfig cfg, RemoteFlowSource source, FunctionCall sink
where cfg.hasFlow(source, sink)
select sink, 
  "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
