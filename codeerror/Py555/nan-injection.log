Rule Content:
/**
 * @name NaN Injection via Type Cast
 * @description Detects when user input flows directly into bool(), float() or complex() typecasts,
 *              potentially allowing NaN injection.
 * @kind path-problem
 * @problem.severity error
 * @id py/nan-injection
 */

import python
import DataFlow::PathGraph
import Python::RequestHandling::Flask

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(Method m | m.getAPackageName() = "flask" and 
      m.getAMethodName() = "get" and 
      this.asParameter() = m.getAParameter()) or
    exists(Parameter p | 
      p.getName() = "request" and
      p.getType().(Class).getSourceDeclaration().getFile().getBaseName() = "flask" and
      this.asParameter() = p)
  }

  override string getSourceType() { "Flask request parameter" }
}

class FlaskRouteParameter extends DataFlow::Source {
  FlaskRouteParameter() {
    exists(Function f, Decorator d | 
      d.getTarget().(Class).getSourceDeclaration().getFile().getBaseName() = "flask" and
      d.getName() = "route" and
      this.asParameter() = f.getAParameter())
  }

  override string getSourceType() { "Flask route parameter" }
}

class TypeCastSink extends DataFlow::Node {
  TypeCastSink() {
    exists(FunctionCall fc | 
      (fc.getTarget().(Function).getName() = "float" or
       fc.getTarget().(Function).getName() = "bool" or
       fc.getTarget().(Function).getName() = "complex") and
      fc.getTarget().(Function).getAPackageName() = "builtins" and
      this.asExpr() = fc)
  }
}

class NanInjectionConfiguration extends TaintTracking::Configuration {
  NanInjectionConfiguration() { this = "NanInjectionConfiguration" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or
    source instanceof FlaskRouteParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TypeCastSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(FunctionCall fc | sanitizer.asExpr() = fc)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, NanInjectionConfiguration config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found user input going directly into typecast for " +
  sink.getNode().(FunctionCall).getTarget().(Function).getName() + 
  "(). This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
