/**
 * @name Nan Injection in Python Type Cast
 * @description Detects user input going directly into bool(), float() or complex() casts
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.ApiGraphs
import semmle.python.functions.FunctionCall
import DataFlow
import DataFlow::PathGraph
import python.frameworks.flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Method m |
      m.getPackage().getName() = "flask" and
      m.getType().getName() = "request" and
      m.getName() = "get" and
      this.asExpr() = m.call().getAnArgument()
    )
  }

  override string getSourceType() {
    result = "Flask request parameter"
  }
}

class FlaskRouteParameter extends DataFlow::Node {
  FlaskRouteParameter() {
    exists(Function f, Decorator d |
      d.getTarget() = f and
      exists(Method m |
        m.getPackage().getName() = "flask" and
        m.getType().getName() = "app" and
        m.getName() = "route" and
        d.getExpr().(Call).getCallee() = m
      ) and
      this.asParameter() = f.getAParameter()
    )
  }

  override string getSourceType() {
    result = "Flask route parameter"
  }
}

class TypeCastSink extends DataFlow::Node {
  TypeCastSink() {
    exists(FunctionCall fc |
      fc.getTarget().getName() in ["bool", "float", "complex"] and
      fc.getTarget().getPackage().getQualifiedName() = "__builtin__" and
      this.asExpr() = fc.getAnArgument()
    )
  }
}

class NanInjectionConfiguration extends TaintTracking::Configuration {
  NanInjectionConfiguration() { this = "NanInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof FlaskRouteParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TypeCastSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(FunctionCall san | sanitizer.asExpr() = san.getAnArgument())
  }
}

