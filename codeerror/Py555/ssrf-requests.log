/** 
 * @name SSRF via requests call
 * @description Data from request object is passed to a new server-side request. 
 *              This could lead to a server-side request forgery (SSRF).
 * @kind path-problem
 * @problem.severity error
 * @id py/ssrf-requests
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.web.flask.Flask
import semmle.python.web.flask.Request
import semmle.python.web.flask.Route
import semmle.python.requests.Requests
import semmle.python.dataflow.new.TaintTracking

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("get|\\[\\]|__call__") and
      ma.getReceiver().getType().getName() = "request" and
      ma.getReceiver().getType().getASourceFile().getRelativePath().matches("%flask/request%") and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(FunctionParam p |
      p.getFunction().getAnAnnotation().getName().matches("@.*\\.(get|post|put|delete|patch)") and
      this.asExpr() = p
    )
  }
}

class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(Call c |
      c.getCallee().(Function).getName().matches("get|post|put|delete|patch") and
      c.getCallee().getASourceFile().getRelativePath().matches("%requests%") and
      this.asExpr() = c
    )
  }
}

class SSRFConfig extends TaintTracking::Configuration {
  SSRFConfig() { this = "SSRF via requests call" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RequestsSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // Argument to parameter flow
    exists(Call c, int i |
      succ.asExpr() = c.getArgument(i) and
      pred.asExpr() = c.getCallee().getParameter(i)
    )
    or
    // Field store/load flow
    exists(Attribute attr |
      pred.asExpr() = attr.getObject() and
      succ.asExpr() = attr
    )
  }
}

from SSRFConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, 
  "Data from request object is passed to a new server-side request. This could lead to SSRF.",
  source, "Untrusted source here"
