Rule Content:
/**
 * @name SSRF via Flask requests to external services
 * @description Data from request object is passed to a new server-side request.
 *              This could lead to a server-side request forgery (SSRF).
 * @id ssrf-requests
 * @kind path-problem
 * @problem.severity error
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.Flask
import semmle.python.requests.Requests

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getAPackage() = "flask" and
      ma.getMethod().getDeclaringType() = "flask.request" and
      ma.getMethod().getName().regexpMatch("(get|\\[\\]|__call__)") and
      this = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      p.getFunction().getFile().getAbsolutePath().matches("%@$APP.$ROUTE_METHOD%") and
      this = p
    )
  }
}

class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(MethodAccess ma |
      ma.getMethod().getAPackage() = "requests" and
      this = ma
    )
  }
}

class RequestToRequestsFlowConfiguration extends TaintTracking::Configuration {
  RequestToRequestsFlowConfiguration() { this = "RequestToRequestsFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RequestsSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Field access taint propagation
    exists(FieldRead fr | fr.getObject() = node1 and fr.getField() = node2) or
    exists(FieldWrite fw | fw.getObject() = node1 and fw.getField() = node2) or
    // Parameter to argument taint propagation
    exists(Parameter p, DataFlow::Argument arg |
      p = node1 and arg = node2 and
      arg.getCall().getArgumentPosition() = p.getFunction().getParameterPosition()
    )
  }
}

