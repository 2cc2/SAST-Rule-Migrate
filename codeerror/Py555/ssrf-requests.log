Rule Content:
/**
 * @name SSRF via Flask Request
 * @kind problem
 * @severity error
 * @id py/ssrf-requests
 * @message Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF).
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.WebFramework

/* Source definitions */
class FlaskRequestSource extends RemoteFlowSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getTarget().(Method).getAPIType() = "flask.request" and
      ma.getTarget().(Method).getName().regexpMatch("(get|\\[\\]|__call__)")
    )
  }
}

class RouteParamSource extends RemoteFlowSource::Range {
  RouteParamSource() {
    exists(Parameter p |
      exists(Method m | 
        m.getAPIType().matches("@$APP.$ROUTE_METHOD") and
        p = m.getAParameter()
      )
    )
  }
}

/* Sink definitions */
class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(CallNode cn |
      cn.getTarget().(Method).getAPIType() = "requests" and
      this.asExpr() = cn
    )
  }
}

/* Taint tracking configurations */
class SSRFConfiguration extends TaintTracking::Configuration {
  SSRFConfiguration() { this = "SSRFConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RequestsSink
  }
}

from SSRFConfiguration cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF)."
