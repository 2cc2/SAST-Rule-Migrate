/**
 * @name ssrf-requests
 * @description Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF).
 * @kind path-problem
 * @problem.severity error
 * @id py/ssrf-requests
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Flask
import semmle.python.web.requests

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(CallNode call |
      call = API::moduleImport("flask").getMember("request").getACall()
      and call.getMethodName().regexpMatch("(get|\\[\\]|__call__)")
    )
  }
}

class RouteParamSource extends DataFlow::Source {
  RouteParamSource() {
    exists(ParameterNode param |
      param.getAnAnnotation().getValue().toString().matches("@$APP.$ROUTE_METHOD%")
    )
  }
}

class RequestsSink extends DataFlow::Sink {
  RequestsSink() {
    exists(CallNode call |
      call = API::moduleImport("requests").getACall()
    )
  }
}

class SSRFConfiguration extends TaintTracking::Configuration {
  SSRFConfiguration() { this = "SSRF" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RequestsSink
  }
}

