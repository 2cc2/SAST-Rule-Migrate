/**
 * @name SSRF via requests
 * @description Data from request object is passed to a new server-side request.
 *              This could lead to a server-side request forgery (SSRF).
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 */

import python
import semmle.python.security.SSRF
import semmle.python.web.flask.FlaskRequest
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() matches("get|\\[\\]|__call__") and
      ma.getQualifier().getType().hasQualifiedName("flask", "request") and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function fn, Parameter p |
      p = fn.getAParameter() and
      fn.getFile().getName() matches("@$APP.py") and
      this.asExpr() = p.getAnnotatedValue()
    )
  }
}

class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(MethodAccess ma |
      ma.getQualifier().getType().hasQualifiedName("requests") and
      this.asExpr() = ma
    )
  }
}

