/**
 * @name SSRF via Flask requests
 * @description Data from request object is passed to a new server-side request.
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 */

import python
import semmle.python.web.flask
import semmle.python.web.Requests
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall mc |
      mc.getTarget().hasQualifiedName("flask", "request") and
      (mc.getMethodName().regexMatch("(get|\\[\\]|__call__)")) and
      this.asExpr() = mc
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.hasQualifiedName(pyAny(), "$APP", "$ROUTE_METHOD") and
      p = f.getAParameter() and
      this.asExpr() = p.getAnAccess()
    )
  }
}

class RequestSink extends DataFlow::Node {
  RequestSink() {
    exists(MethodCall mc |
      mc.getTarget().hasQualifiedName("requests", "$FUNC") and
      this.asExpr() = mc
    )
  }
}

configuration instanceof TaintTracking::Configuration {
  path = TaintTracking::GlobalPathFlow(
    source instanceof FlaskRequestSource or source instanceof RouteParamSource,
    sink instanceof RequestSink,
    "Possible SSRF vulnerability"
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where configuration.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF)."
================================================================================
