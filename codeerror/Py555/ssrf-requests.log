Rule Content:
/**
 * @name Server-Side Request Forgery (SSRF)
 * @description Data from request object is passed to a new server-side request.
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask", "request", _) and
      ma.getMethod().getName().regexpMatch("(get|\\[\\]|__call__)") and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.hasDecorator("route") and
      f.getAParameter() = p and
      this.asParameter() = p
    )
  }
}

class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(MethodAccess ma |
      ma.getMethod().getPackage().hasQualifiedName("requests", _, _) and
      this.asExpr() = ma
    )
  }
}

class SSRFConfig extends TaintTracking::Configuration {
  SSRFConfig() { this = "SSRFConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RequestsSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::ParameterNode param, DataFlow::ExprNode expr |
      expr = node1.asExpr() and
      param = node2.asParameter() and
      param.getFunction().getAParameter() = param and
      expr.flowsTo(param)
    )
    or
    exists(DataFlow::FieldRead read, DataFlow::FieldWrite write |
      read.getField() = write.getField() and
      node1.asExpr() = write.getRhs() and
      node2.asExpr() = read.getLhs()
    )
  }
}

