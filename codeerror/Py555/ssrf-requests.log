/**
 * @name Server-Side Request Forgery (SSRF)
 * @description Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF).
 * @kind path-problem
 * @problem.severity error
 * @id py/ssrf
 */

import python
import semmle.python.web.Flask
import semmle.python.web.Requests
import TaintTracking

class SSRFConf extends TaintTracking::Configuration {
  SSRFConf() { this = "SSRF" }

  override predicate isSource(TaintTracking::Source source) {
    exists(string method |
      source.asExpr() = any(Functions::Call call |
        call.getTarget().getName() = method and
        call.getAPackageName() = "flask" and
        call.getATypeName() = "flask.request" and
        method.regexpMatch("(get|\\[\\]|__call__)")
      )
    )
    or
    exists(string routeParam |
      source.asExpr() = any(Parameter p |
        p.getAnAnnotation().toString() = routeParam
      )
    )
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink.asExpr() = any(Functions::Call call |
      call.getAPackageName() = "requests"
    )
  }

  override predicate isAdditionalTaintStep(TaintTracking::TaintStep step) {
    step.(FieldFlowFlowStep).getFld() = TaintTracking::FieldFlowFlowStep::ArgumentToParameterFlow
    or
    step.(FieldFlowFlowStep).getFld() = TaintTracking::FieldFlowFlowStep::FieldStoreOrLoadFlow
  }
}

