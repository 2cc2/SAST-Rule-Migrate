import python
import semmle.python.web.WebFramework
import semmle.python.security.Frameworks.RemoteFlowSource
import semmle.python.dataflow.TaintTracking

private class FlaskRequestSource extends TaintTracking::RemoteFlowSource {
  FlaskRequestSource() {
    exists(Call call |
      call.getCallee().getAPIType() = "flask.request" and
      call.getCallee().getName().regexpMatch("(get|\\[\\]|__call__)")
    )
  }
}

private class RouteParamSource extends TaintTracking::RemoteFlowSource {
  RouteParamSource() {
    exists(Parameter param |
      param.getAnnotatedValue().getAPIType().matches("@$APP.$ROUTE_METHOD")
    )
  }
}

private class RequestsSink extends TaintTracking::TaintSink {
  RequestsSink() {
    exists(Call call |
      call.getCallee().getAPIType() = "requests"
    )
  }

  override predicate isSink(TaintTracking::Node node) {
    exists(RequestsSink sink | node.asSource() = sink)
  }

  override predicate asCfgNode(TaintTracking::Node node) { none() }
  override predicate getLocation(TaintTracking::Node node) { none() }
  override predicate getBasicBlock(TaintTracking::Node node) { none() }
  override predicate toString(TaintTracking::Node node) { none() }
  override predicate getScope(TaintTracking::Node node) { none() }
  override predicate asVariable(TaintTracking::Node node) { none() }
}

private class SSRFConfiguration extends TaintTracking::Configuration {
  SSRFConfiguration() { this = "SSRFConfiguration" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof RequestsSink
  }

  override predicate isAdditionalTaintStep(TaintTracking::Node node1, TaintTracking::Node node2) {
    exists(FieldAccess fa | fa.getField() = node1 and fa = node2) or
    exists(Argument arg, Parameter param | arg = node1 and param = node2)
  }
}

