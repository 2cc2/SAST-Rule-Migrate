Rule Content:
/**
 * @name SSRF via requests
 * @description Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF).
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 */

import python
import DataFlow::PathGraph
import semmle.python.web.flask.FlaskRequest
import semmle.python.web.flask.Route
import semmle.python.requests.Requests

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getPackage().getName() = "flask" and
      ma.getMethod().getDeclaringType().getName() = "request" and
      ma.getMethod().getName().regexMatches("(get|\\[\\]|__call__)") and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getAnnotatedElement().getName().matches("%@$APP.$ROUTE_METHOD%") and
      p.getFunction() = f and
      this.asExpr() = p.getAnnotatedElement()
    )
  }
}

class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(MethodAccess ma |
      ma.getMethod().getPackage().getName() = "requests" and
      this.asExpr() = ma
    )
  }
}

class SSRFConfig extends TaintTracking::Configuration {
  SSRFConfig() { this = "SSRFConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RequestsSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // Argument to parameter propagation
    exists(MethodAccess ma, Function f, Parameter p, int i |
      ma.getMethod() = f and
      p = f.getParameter(i) and
      pred.asExpr() = ma.getAnArgument(i) and
      succ.asExpr() = p.getAnnotatedElement()
    )
    or
    // Field store/load propagation
    exists(FieldAccess fa |
      (fa instanceof ReadExpr and pred.asExpr() = fa.getObject()) or
      (fa instanceof WriteExpr and succ.asExpr() = fa.getObject())
    )
  }
}

from SSRFConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF)."
