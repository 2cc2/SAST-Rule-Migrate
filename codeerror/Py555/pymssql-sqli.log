Rule Content:
/**
 * @name pymssql-sqli
 * @kind path-problem
 * @problem.severity warning
 * @description Detected SQL statement that is tainted by `event` object. This could 
 *              lead to SQL injection if the variable is user-controlled and not properly 
 *              sanitized. In order to prevent SQL injection, use parameterized queries 
 *              or prepared statements instead.
 */

import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow
import semmle.python.ApiGraphs
import semmle.python.Concepts

class EventObject extends DataFlow::ParameterNode {
  EventObject() {
    exists(Parameter param |
      this = DataFlow::parameterNode(param) and
      param.getName() = "event"
    )
  }
}

class PyMssqlExecuteCall extends DataFlow::ExprNode {
  PyMssqlExecuteCall() {
    exists(FunctionValue func, Call call |
      this = DataFlow::exprNode(call.getArg(0)) and
      call.getFunc() = func and
      func.getModuleImport().getName() = "pymssql" and
      func.getName() = "execute"
    )
  }
}

class TaintTrackingConfig extends TaintTracking::Configuration {
  TaintTrackingConfig() { this = "pymssql_sqli_taint_tracking" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventObject
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PyMssqlExecuteCall
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from TaintTrackingConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection from event parameter"
