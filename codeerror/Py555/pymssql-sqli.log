Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection 
 * if the variable is user-controlled and not properly sanitized. In order to prevent SQL injection, 
 * use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pymssql-sqli
 */

import python
import semmle.python.security.dataflow.TaintTracking
import DataFlow::PathGraph

class EventObject extends DataFlow::Node {
  EventObject() {
    exists(FunctionValue func, Parameter param |
      param = func.getParameter(0) and
      param.getName() = "event" and
      this.asParameter() = param
    )
  }
}

class PyMssqlExecuteCall extends DataFlow::Node {
  PyMssqlExecuteCall() {
    exists(CallNode call |
      call.getTarget().(FunctionValue).getPackage().getName() = "pymssql" and
      call.getTarget().(FunctionValue).getName() = "execute" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PyMssqlSqliConfig extends TaintTracking::Configuration {
  PyMssqlSqliConfig() { this = "pymssql-sqli" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventObject }

  override predicate isSink(DataFlow::Node sink) { sink instanceof PyMssqlExecuteCall }
}

from PyMssqlSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "Potential SQL injection from event object to pymssql.execute() call"
