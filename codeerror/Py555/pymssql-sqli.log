Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. This could lead to 
 * SQL injection if the variable is user-controlled and not properly sanitized. 
 * In order to prevent SQL injection, use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pymssql-sqli
 */

import python
import semmle.python.dataflow.DataFlow
import DataFlow::PathGraph

class EventSource extends DataFlow::Node {
  EventSource() {
    exists(Parameter p |
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class PyMssqlExecuteCall extends DataFlow::Node {
  PyMssqlExecuteCall() {
    exists(FunctionCall call |
      call.getTarget().getQualifiedName() = "pymssql.execute" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class TaintConfig extends DataFlow::Configuration {
  TaintConfig() { this = "TaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PyMssqlExecuteCall
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where any(TaintConfig tc).hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "SQL statement is tainted by event object. Potential SQL injection vulnerability."
