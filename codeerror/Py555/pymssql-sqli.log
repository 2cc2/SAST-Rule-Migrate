import python
import semmle.python.DataFlow
import DataFlow::PathGraph

class EventSource extends DataFlow::Node {
  EventSource() { 
    exists(Function::Parameter p |
      p.getFunctionDeclaration().getName() = "event" and
      this = p
    )
  }
}

class PyMssqlExecuteCall extends DataFlow::Node {
  PyMssqlExecuteCall() {
    exists(Call call |
      call.getCallee().(FunctionValue).getTopLevelName() = "execute" and
      call.getCallee().(FunctionValue).getSource().getTopLevelName() = "pymssql" and
      this = call.getArg(0)
    )
  }
}

module TaintConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { source instanceof EventSource }
  predicate isSink(DataFlow::Node sink) { sink instanceof PyMssqlExecuteCall }
  predicate isBarrier(DataFlow::Node barrier) { none() }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), "SQL statement is tainted from event object. Use parameterized queries to prevent SQL injection.",
  source.getNode(), "Potential user input flows here"
