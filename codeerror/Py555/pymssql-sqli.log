  override DataFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override Location getLocation() { result = this.getLocation() }
  override string toString() { result = this.toString() }
  override DataFlow::ScopeNode getScope() { result = this.getScope() }
  override DataFlow::Variable asVariable() { result = none() }
}

class PymssqlSqlInjectionConfig extends TaintTracking::Configuration {
  PymssqlSqlInjectionConfig() { this = "PymssqlSqlInjectionConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof EventParameter
