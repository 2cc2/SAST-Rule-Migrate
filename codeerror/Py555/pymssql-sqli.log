Rule Content:
/**
 * @name pymssql-sqli
 * @kind path-problem
 * @problem.severity Warning
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection
 *              if the variable is user-controlled and not properly sanitized. In order to prevent SQL 
 *              injection, use parameterized queries or prepared statements instead.
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class EventParameter extends DataFlow::Node {
  EventParameter() {
    exists(FunctionValue f |
      f.getParameter(0).getName() = "event" and
      this.asParameter() = f.getParameter(0)
    )
  }
}

class PymssqlExecuteCall extends DataFlow::Node {
  PymssqlExecuteCall() {
    exists(CallNode call |
      call.getFunc().(Attribute).getAttr() = "execute" and
      call.getFunc().(Attribute).getBase().getType().getName() = "Cursor" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PymssqlSQLInjectionConfig extends TaintTracking::Configuration {
  PymssqlSQLInjectionConfig() { this = "PymssqlSQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PymssqlExecuteCall
  }
}

from PymssqlSQLInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection from event parameter to pymssql.execute() call", source,
  "$@ flows to here and may be used in SQL injection.", source.getNode(),
  "user-provided value"
