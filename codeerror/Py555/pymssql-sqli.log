Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. Could lead to SQL injection.
 * @kind path-problem
 * @problem.severity warning
 * @id py/pymssql-sqli
 */

import python
import semmle.python.DataFlow
import semmle.python.Concepts

class EventSource extends DataFlow::Node {
  EventSource() {
    exists(FunctionValue f |
      this.asParameter() = f.getAParameter() and
      f.getName() = "event" and
      exists(FunctionDefinition fd |
        fd = f.getScope() and
        fd.getName() matches "%HANDLER%" and
        fd.getAParameter().getName() = "event" and
        fd.getAParameter().getAParent*() = this.asParameter()
      )
    )
  }
}

class PymssqlExecuteSink extends DataFlow::Node {
  PymssqlExecuteSink() {
    exists(CallNode call |
      call.getFunc().(NameNode).getId() = "execute" and
      call.getFunc().getAParentScope() instanceof Module and
      call.getFunc().getAParentScope().getName() = "pymssql" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PymssqlSqlInjectionConfig extends TaintTracking::Configuration {
  PymssqlSqlInjectionConfig() { this = "pymssql-sqli" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof EventSource 
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PymssqlExecuteSink
  }
}

from PymssqlSqlInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized. In order to prevent SQL injection, use parameterized queries or prepared statements instead.",
  source, sink,
  "SQL injection vulnerability"
