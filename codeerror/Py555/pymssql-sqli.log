import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class EventParameter extends DataFlow::ParameterNode {
  EventParameter() {
    exists(FunctionValue fd, string name |
      fd.getAParameter() = this and
      name = this.getName() and
      name = "event" and
      exists(Function f |
        f.getName() = "$HANDLER" and
        fd = f.getADefinition()
      )
    )
  }

  override predicate isSource(TaintTracking::TaintSource source) {
    source = this
  }

