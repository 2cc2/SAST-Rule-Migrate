import python
import DataFlow
import DataFlow::PathGraph
import semmle.python.ApiGraphs

class EventSource extends DataFlow::Node {
  EventSource() {
    exists(Function f, Parameter p |
      f.getName() = "event_handler" and
      p = f.getParameter(0) and
      this.asParameterNode() = p
    )
  }
}

class PyMssqlSink extends DataFlow::Node {
  PyMssqlSink() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "execute" and
      mc.getMethod().getDeclaringType().getName() = "Cursor" and
      mc.getQualifier().getType().getName() =%~ "pymssql.Cursor" and
      this = mc.getArgument(0)
    )
  }
}

class PyMssqlSQLiConfig extends TaintTracking::Configuration {
  PyMssqlSQLiConfig() { this = "PyMssqlSQLiConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof PyMssqlSink }
}

from PyMssqlSQLiConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection " +
  "if the variable is user-controlled and not properly sanitized. Use parameterized queries " +
  "or prepared statements instead."
