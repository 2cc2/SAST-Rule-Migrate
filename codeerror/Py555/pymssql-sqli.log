/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. This could lead 
 *              to SQL injection if the variable is user-controlled and not properly 
 *              sanitized. In order to prevent SQL injection, use parameterized queries 
 *              or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pymssql-sqli
 */

import python
import semmle.python.security.TaintedPathAnalysis
import semmle.python.ApiGraphs

class EventSource extends DataFlow::Node {
  EventSource() {
    exists(FunctionValue f, Parameter p |
      p.getFunction() = f and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class PyMssqlSink extends DataFlow::Node {
  PyMssqlSink() {
    exists(CallNode call |
      call.getTarget().(ExternalFunctionValue).getPackageName() = "pymssql" and
      call.getTarget().(ExternalFunctionValue).getName() = "execute" and
      call.getArg(0) = this.asExpr()
    )
  }
}

from EventSource source, PyMssqlSink sink
where TaintedPath::hasTaintedPath(source, sink)
select sink, 
  "Potential SQL injection from untrusted 'event' parameter to pymssql.execute() call",
  source, "Untrusted 'event' parameter"
