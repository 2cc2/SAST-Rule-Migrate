import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.dataflow.new.DataFlow
import semmle.python.Concepts

class EventParam extends DataFlow::Parameter {
  EventParam() {
    exists(Function f, int idx |
      f.getAParameterAt(idx) = this and
      this.getParameterName() = "event" and
      f.getName() matches(".*HANDLER.*") and
      f.getNumParameter() >= 2 and
      f.getAParameterAt(1).getParameterName() = "context"
    )
  }
}

class PymssqlExecuteCall extends DataFlow::Call {
  PymssqlExecuteCall() {
    exists(MethodAccess ma |
      ma = this.getCall() and
      ma.getMethod().getName() = "execute" and
      ma.getQualifier().getType().hasName("Cursor") and
      this.getImportedModule("pymssql")
    )
  }
}

class PymssqlSqlInjectionConfig extends TaintTracking::Configuration {
  PymssqlSqlInjectionConfig() { this = "PymssqlSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(PymssqlExecuteCall call |
      call.getArgument(0) = sink.asExpr()
    )
  }
}

