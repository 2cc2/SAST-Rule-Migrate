Rule Content:
/**
 * @name Direct use of Jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping 
 * which opens up the application to cross-site scripting (XSS) vulnerabilities. 
 * Prefer using the Flask method 'render_template()' and templates with a '.html' extension to prevent XSS.
 * @kind problem
 * @problem.severity warning
 * @id python/direct-use-of-jinja2
 */

import python

from CallNode call, Value jinja2Env, Value jinja2Template, Value templateRender
where 
  // Jinja2 Environment() calls
  (exists(import("jinja2"), "Environment" as envClass | 
   call = envClass.getACall()) and 
   jinja2Env = call)
  or
  // Jinja2 Template.render() calls
  (exists(import("jinja2"), "Template" as templateClass | 
   call = templateClass.getAMethodCall("render")) and 
   jinja2Template = call)
  or
  // Any .Template.render() calls via regex
  (regexpMatch(call.getTarget().getQualifiedName(), ".*\\.Template\\.render") and
   templateRender = call)
  // Exclude Flask's render_template() calls which are safe
  and not exists(Call flaskRender | 
   flaskRender.getTarget().hasQualifiedName("flask", "render_template"))
select call, "Direct use of Jinja2 templates may bypass HTML escaping, risking XSS vulnerabilities. Use Flask's render_template() instead."
