Rule Content:
/**
 * @name Direct use of Jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass
 *              HTML escaping which opens up the application to cross-site scripting 
 *              (XSS) vulnerabilities. Prefer using the Flask method 'render_template()'
 *              and templates with a '.html' extension in order to prevent XSS.
 * @severity Warning
 * @kind problem
 * @id python/security/direct-use-jinja2
 */

import python
import python.Concepts

predicate isJinja2Environment(ValueEntity env) {
  exists(Import imp | 
    imp.getImportedName() = "jinja2" and
    env.(VariableEntity).getAnAccess().getEnclosingScope().getAModule().getAnImport() = imp
  ) and
  env.getType().getAPrimaryQlClass() = "Environment"
}

predicate isJinja2Render(ValueEntity render) {
  exists(Method renderMethod |
    renderMethod.getDeclaringType().getName() = "Template" and
    renderMethod.getName() = "render" and
    render = renderMethod
  )
}

predicate isTemplateRender(ValueEntity render) {
  exists(Method renderMethod |
    renderMethod.getName() = "render" and
    renderMethod.getDeclaringType().getName().matches("%\.Template") and
    render = renderMethod
  )
}

predicate isFlaskRenderTemplate(ValueEntity render) {
  exists(Method renderMethod |
    renderMethod.getName() = "render_template" and
    renderMethod.getDeclaringType().getName() = "flask" and
    render = renderMethod
  )
}

from Call call, ValueEntity jinja2Env, ValueEntity jinja2Template, ValueEntity templateRender
where
  (
    isJinja2Environment(jinja2Env) and
    call.getTarget() = jinja2Env
  )
  or
  (
    isJinja2Render(jinja2Template) and
    call.getTarget() = jinja2Template
  )
  or
  (
    isTemplateRender(templateRender) and
    call.getTarget() = templateRender
  )
  and
  not exists(ValueEntity flaskRender |
    isFlaskRenderTemplate(flaskRender) and
    call.getTarget() = flaskRender
  )
select call, "Detected direct use of jinja2. If not done properly, this may bypass " +
  "HTML escaping which opens up the application to cross-site scripting (XSS) " +
  "vulnerabilities. Prefer using the Flask method 'render_template()' and " +
  "templates with a '.html' extension in order to prevent XSS."
