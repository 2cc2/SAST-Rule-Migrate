Rule Content:
/**
 * @name Exec Injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id py/exec-injection
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 */
import python
import DataFlow::TaintTracking
import semmle.python.dataflow.DataFlow

class FlaskRequestSource extends TaintTracking::TaintSource {
  FlaskRequestSource() {
    exists(MethodCallExpr call |
      call.getMethod().getName().matches("get|__getitem__|__call__") and
      call.getReceiver().getType().hasName("flask.request")
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodCallExpr call |
      source.asExpr() = call and
      call.getMethod().getName().matches("get|__getitem__|__call__") and
      call.getReceiver().getType().hasName("flask.request")
    )
  }
}

class RequestParam extends TaintTracking::TaintSource {
  RequestParam() {
    exists(Parameter p | 
      p.getAnnotatedName().matches("\\$ROUTEVAR|\\$INTERM")
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      source.asParameter() = p and
      p.getAnnotatedName().matches("\\$ROUTEVAR|\\$INTERM")
    )
  }
}

class ExecSink extends TaintTracking::TaintSink {
  ExecSink() {
    exists(MethodCallExpr call |
      call.getMethod().getName() = "exec" and
      call.getReceiver().getType().hasName("builtins")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCallExpr call |
      sink.asExpr() = call and
      call.getMethod().getName() = "exec" and
      call.getReceiver().getType().hasName("builtins")
    )
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestSource or source instanceof RequestParam
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof ExecSink
  }
}

from ExecInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Detected user data flowing into exec. This is code injection and should be avoided."
