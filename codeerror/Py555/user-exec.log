Rule Content:
/**
 * @name Exec Injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/exec-injection
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 */
import python
import DataFlow
import TaintTracking
import semmle.python.web.flask.Request

class FlaskRequestSource extends TaintTracking::TaintSource {
  FlaskRequestSource() { 
    exists(MethodAccess ma | 
      ma.getMethod().getName() in ["get", "__getitem__", "__call__"] and
      ma.getMethod().getDeclaringType().getName() = "request"
    )
  }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof FlaskRequestSource
  }
}

class RouteParamSource extends TaintTracking::TaintSource {
  RouteParamSource() {
    exists(Parameter p | 
      p.getType().getUnderlyingType().getName().matches("%ROUTEVAR%|%INTERM%")
    )
  }

  override predicate isSource(DataFlow::Node source) {
    source.asParameter() instanceof RouteParamSource
  }
}

class ExecSink extends TaintTracking::TaintSink {
  ExecSink() {
    exists(CallExpr ce | 
      ce.getFunc().(NameExpr).getName() = "exec" and
      ce.getFunc().getType().getUnderlyingType().getName() = "builtins"
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(CallExpr ce |
      ce.getFunc().(NameExpr).getName() = "exec" and
      sink.asExpr() = ce.getArgument(0)
    )
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjection" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof ExecSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ExecInjectionConfig conf
where conf.hasFlowPath(source, sink)
select sink, "Detected user data flowing into exec. This is code injection and should be avoided.",
  source, sink, "Potential exec injection vulnerability"
