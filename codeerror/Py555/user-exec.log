Rule Content:
/**
 * @name Exec Injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/exec-injection
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 */
import python
import DataFlow::PathGraph
import semmle.python.dataflow.TaintTracking

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(API::Call call |
      call = API::getACall("flask.request", _, _, _) and
      call.getMethodName() in ["get", "__getitem__", "__call__"] and
      this.asExpr() = call
    )
  }
}

class RequestParam extends DataFlow::Node {
  RequestParam() {
    exists(Parameter p |
      p.getAnnotatedName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this.asParameter() = p
    )
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(API::Call call |
      call = API::getACall("builtins.exec", _, _, _) and
      this.asExpr() = call.getArg(0)
    )
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RequestParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecSink
  }
}

from ExecInjectionConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected user data flowing into exec. This is code injection and should be avoided."
