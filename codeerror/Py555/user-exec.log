Rule Content:
/**
 * @name Exec Injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @id exec-injection
 * @kind path-problem
 * @problem.severity error
 * @precision medium
 * @security-severity 8.0
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 */

import semmle.code.python.dataflow.DataFlow
import semmle.code.python.dataflow.TaintTracking
import semmle.code.python.web.flask.Request

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["get", "__getitem__", "__call__"]) and
      ma.getQualifier() = any(Request r).getExpr() and
      this.asExpr() = ma
    )
  }

  override predicate isSource(DataFlow::Node source) { this = source }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function::Parameter p |
      p.getAPrimaryQlClass().matches("%ROUTEVAR%|%INTERM%") and
      this.asParameter() = p
    )
  }

  override predicate isSource(DataFlow::Node source) { this = source }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(Call call |
      call.getCalleeName() = "exec" and
      call.getImportedFrom() = "builtins" and
      this.asExpr() = call.getArg(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) { this = sink }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "Exec Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecSink
  }

  override predicate isSanitizer(DataFlow::Node node) { none() }
}

from ExecInjectionConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Detected user data flowing into exec. This is code injection and should be avoided.",
  source, "User input originates here"
