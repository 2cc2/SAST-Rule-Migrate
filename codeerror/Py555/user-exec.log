/**
 * @name Exec Injection
 * @kind problem
 * @id python/exec-injection
 * @severity error
 * @message Detected user data flowing into exec. This is code injection and should be avoided.
 */
import python
import semmle.python.dataflow.new.TaintTracking
import python.frameworks.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask.request", ["get", "__getitem__", "__call__"]) and
      ma = this.asExpr()
    )
  }

  override predicate isSource() { this = any(FlaskRequestSource f) }

  // Implement required abstract predicates
  override predicate asCfgNode() { none() }
  override DataFlow::Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { none() }
  override string toString() { result = "Flask request source" }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override DataFlow::Variable asVariable() { none() }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().regexpMatch("ROUTEVAR|INTERM") and
      this.asParameter() = p
    )
  }

  override predicate isSource() { this = any(RouteParamSource r) }

  // Implement required abstract predicates
  override predicate asCfgNode() { none() }
  override DataFlow::Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { none() }
  override string toString() { result = "Route parameter source" }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override DataFlow::Variable asVariable() { none() }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(CallNode call |
      call.getTarget().hasQualifiedName("builtins", "exec") and
      call.getArgument(0) = this.asExpr()
    )
  }

  override predicate isSink() { this = any(ExecSink e) }

  // Implement required abstract predicates
  override predicate asCfgNode() { none() }
  override DataFlow::Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { none() }
  override string toString() { result = "exec() call sink" }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override DataFlow::Variable asVariable() { none() }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "Exec Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from DataFlow::Node source, DataFlow::Node sink, ExecInjectionConfig config
where config.hasFlow(source, sink)
select sink, "$@ flows to exec() call and may cause code injection", source, source.toString()
