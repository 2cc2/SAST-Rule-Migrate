Rule Content:
/**
 * @name Exec Injection via Flask Request
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind taint
 * @id python/exec-injection
 * @severity Error
 * @precision medium
 * @problem.severity error
 * @security-severity 8.5
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 *       framework/flask
 */

import python
import semmle.python.web.flask.App
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethodName() in ["get", "__getitem__", "__call__"] and
      ma.getQualifier().(Value).getType().getName() = "flask.request" and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this.asParameter() = p
    )
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(MethodAccess ma |
      ma.getMethodName() = "exec" and
      ma.getQualifier().(Value).getType().getName() = "builtins" and
      this.asExpr() = ma.getAnArgument(0)
    )
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ExecInjectionConfig conf
where conf.hasFlowPath(source, sink)
select sink, source, sink, "User data flows into exec call. This is code injection and should be avoided."
