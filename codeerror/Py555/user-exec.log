Rule Content:
/**
 * @name exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @precision medium
 * @id python/exec-injection
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(MethodCallExpr mc |
      mc.getAPI() = "flask.request" and
      mc.getMethodName().regexpMatch("get|__getitem__|__call__") and
      this.asExpr() = mc
    )
  }
}

class RouteParamSource extends DataFlow::Source {
  RouteParamSource() {
    exists(FunctionParameter p |
      p.getName().regexpMatch("ROUTEVAR|INTERM") and
      this.asExpr() = p
    )
  }
}

class PythonExecSink extends DataFlow::Sink {
  PythonExecSink() {
    exists(MethodCallExpr mc |
      mc.getAPI() = "builtins" and
      mc.getMethodName() = "exec" and
      this.asExpr() = mc.getArg(0)
    )
  }
}

class ExecInjectionConfiguration extends TaintTracking::Configuration {
  ExecInjectionConfiguration() { this = "ExecInjection" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Sink sink) { sink instanceof PythonExecSink }
}

from ExecInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected user data flowing into exec. This is code injection and should be avoided.",
  source, sink, "Potential code injection vulnerability"
