Rule Content:
/**
 * @name exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind taint
 * @problem.severity error
 * @id py/exec-injection
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 * @precision medium
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.WebFlask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getAPackage() = "flask.request" and
      ma.getMethod().getName().matches("get|__getitem__|__call__") and
      ma.getACallable() = this.asExpr()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().matches("\\$ROUTEVAR|\\$INTERM") and
      this.asParameter() = p
    )
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(MethodAccess ma |
      ma.getMethod().getAPackage() = "builtins" and
      ma.getMethod().getName() = "exec" and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

predicate isTainted(DataFlow::Node source, DataFlow::Node sink) {
  TaintTracking::localTaint(source, sink) or
  TaintTracking::globalTaint(source, sink)
}

from FlaskRequestSource source, ExecSink sink
where isTainted(source, sink)
select sink, "Detected user data flowing into exec. This is code injection and should be avoided."

from RouteParamSource source, ExecSink sink
where isTainted(source, sink)
select sink, "Detected user data flowing into exec. This is code injection and should be avoided."
