Rule Content:
/**
 * @name Exec Injection Vulnerability
 * @description Detects user data flowing into exec, which can lead to code injection
 * @kind path-problem
 * @problem.severity error
 * @id python/exec-injection
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 */

import python
import semmle.python.dataflow.new.DataFlow
import python.security.FlaskHelpers

class FlaskRequestSource extends DataFlow::SourceNode {
  FlaskRequestSource() {
    exists(MethodCallExpr call |
      call.getReceiver() = globalValue("flask", "request") and
      call.getMethod() in ["get", "__getitem__", "__call__"]
    ) and
    result = this.asDefiningNode()
  }

  override string getSourceType() { "FLASK_REQUEST" }
}

class RouteParamSource extends DataFlow::SourceNode {
  RouteParamSource() {
    exists(ParameterNode param |
      param.getName().matches("\$ROUTEVAR|\$INTERM")
    ) and
    result = this.asDefiningNode()
  }

  override string getSourceType() { "ROUTE_PARAM" }
}

class PythonExecSink extends DataFlow::SinkNode {
  PythonExecSink() {
    exists(Call call |
      call.getReceiver() = globalValue("builtins", "") and
      call.getMethod() = "exec" and
      result = call.getArgument(0)
    )
  }

  override string getSinkType() { "PYTHON_EXEC" }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(DataFlow::SourceNode source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::SinkNode sink) {
    sink instanceof PythonExecSink
  }
}

from ExecInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user data flowing into exec. This is code injection and should be avoided."
