/**
 * @name exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind problem
 * @problem.severity error
 * @id python/exec-injection
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 * @precision medium
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.web.flask.FlaskRequest

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    apiCall("flask.request", _, _, _, _).getAMethodCall(["get", "__getitem__", "__call__"]) or
    exists(RequestParam p | p = this.asSource())
  }
}

class RequestParam extends DataFlow::Source {
  RequestParam() {
    exists(string name | name = this.asParameter().getName() |
      name.regexpMatch("\\$ROUTEVAR|\\$INTERM"))
  }
}

class ExecSink extends DataFlow::Sink {
  ExecSink() {
    apiCall("builtins", "exec", _, _, _).getAnArg(0) 
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or source instanceof RequestParam
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof ExecSink
  }
}

from ExecInjectionConfig cfg, DataFlow::Source source, DataFlow::Sink sink
where cfg.hasFlow(source, sink)
select sink, "Detected user data flowing into exec. This is code injection and should be avoided."
