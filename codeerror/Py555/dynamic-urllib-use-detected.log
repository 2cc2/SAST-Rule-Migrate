Rule Content:
/**
 * @name Dynamic urllib Usage Detected
 * @id dynamic-urllib-use-detected
 * @kind path-problem
 * @problem.severity warning
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://'
 *              schemes, so a dynamic value controlled by a malicious actor may allow them
 *              to read arbitrary files. Audit uses of urllib calls to ensure user data
 *              cannot control the URLs, or consider using the 'requests' library instead.
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.Concepts

class UrllibTaintConfig extends TaintTracking::Configuration {
  UrllibTaintConfig() { this = "DynamicUrllibTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodCall call |
      call.getMethod() instanceof UrllibMethod and
      not call.getMethod().getName().matches("% urllib.%") and
      not call.getMethod().getName().matches("% urllib.request.%") and
      not call.getMethod().getName().matches("%Opener.%") and
      source.asExpr() = call.getAnArgument()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall call, string scheme |
      call.getMethod() instanceof UrllibMethod and
      scheme = call.getArgument(0).getStringValue() and
      scheme.matches("file://%") and
      sink.asExpr() = call.getAnArgument()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(string val |
      sanitizer.asExpr() instanceof StrLiteral and
      val = sanitizer.asExpr().getStringValue() and
      val.matches("https?://%")
    )
  }

  private class UrllibMethod extends Method {
    UrllibMethod() {
      getName().matches("urlopen|urlretrieve|open|retrieve") and
      (
        getQualifiedName().matches("urllib.%") or
        getQualifiedName().matches("urllib.request.%")
      )
    }
  }
}

from UrllibTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential insecure urllib usage with dynamic file scheme"
