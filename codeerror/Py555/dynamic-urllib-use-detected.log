Rule Content:
/**
 * @name Dynamic urllib use detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes,
 *              so a dynamic value controlled by a malicious actor may allow them to read arbitrary files.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id python/dynamic-urllib-use-detected
 */

import python
import semmle.python.Security
import semmle.python.Concepts
import semmle.python.dataflow.new.TaintTracking

private class UrllibCall extends DataFlow::Node {
  UrllibCall() {
    exists(CallNode cn |
      cn = this.asNode() and
      (
        cn.getCallable().(Value).matches("urllib%.%.get%") or
        cn.getCallable().(Value).matches("urllib.request%.opener%.%") or
        cn.getCallable().(Value).matches("urllib%.url%") or
        cn.getCallable().(Value).matches("urllib.request%.url%")
      )
    )
  }
}

private class UrllibSource extends TaintTracking::Source {
  UrllibSource() { this instanceof UrllibCall }

  override predicate isSource(DataFlow::Node source) { this = source }

  override string getSourceType() {
    result = "Dynamic urllib call source"
  }
}

private class FileSchemeSink extends TaintTracking::Sink {
  FileSchemeSink() {
    exists(DataFlow::Node node |
      node.asExpr().(StringLiteral).getValue().regexpMatch("file://.*") and
      this.asNode() = node
    )
  }

  override predicate isSink(DataFlow::Node sink) { this = sink }

  override string getSinkType() {
    result = "File scheme access"
  }
}

private class StaticUrlSanitizer extends TaintTracking::Sanitizer {
  StaticUrlSanitizer() {
    exists(DataFlow::Node node |
      node.asExpr().(StringLiteral).getValue().regexpMatch("^https?://") and
      this.asNode() = node
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { this = sanitizer }
}

class DynamicUrllibConfig extends TaintTracking::Configuration {
  DynamicUrllibConfig() { this = "DynamicUrllibConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UrllibSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileSchemeSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticUrlSanitizer
  }
}

