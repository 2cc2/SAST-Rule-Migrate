Rule Content:
/**
 * @name Dynamic urllib use detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes, so 
 *              a dynamic value controlled by a malicious actor may allow them to read arbitrary files.
 * @kind path-problem
 * @problem.severity warning
 * @id python/urllib-dynamic-use
 * @tags security
 *       external/cwe/cwe 099
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class UrlLibSource extends DataFlow::Node {
  UrlLibSource() {
    exists(LibCall call |
      call.getTarget().hasGlobalName(["urlopen", "urlretrieve", "open", "retrieve"]) and
      call.getTarget().getContainer().matches("%urllib%") and
      // Exclude specific urllib variations
      not call.getTarget().getQualifiedName().matches("urllib.$W(...)") and
      not call.getTarget().getQualifiedName().matches("urllib.request.$W(...)") and
      not call.getTarget().getQualifiedName().matches("$OPENER.$W(...)") and
      this.asExpr() = call.getAnArgument()
    )
  }
}

class FileSchemeAccess extends DataFlow::Node {
  FileSchemeAccess() {
    exists(LibCall call |
      call.getTarget().hasGlobalName(["urlopen", "urlretrieve", "open", "retrieve"]) and
      call.getTarget().getContainer().matches("%urllib%") and
      call.getAnArgument().getStringValue().regexpMatch("file://.*") and
      this.asExpr() = call
    )
  }
}

class SafeUrl extends DataFlow::Node {
  SafeUrl() {
    exists(stringlit | stringlit.getStringValue().regexpMatch("^https?://") and this.asExpr() = stringlit)
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "DynamicUrllibUseConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UrlLibSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof FileSchemeAccess }

  override predicate isSanitizer(DataFlow::Node node) { node instanceof SafeUrl }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected a dynamic value being used with urllib. Audit uses " +
"of urllib calls to ensure user data cannot control the URLs, or consider using the 'requests' library instead."
