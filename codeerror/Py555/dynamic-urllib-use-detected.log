Rule Content:
/**
 * @name Dynamic urllib Use Detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes,
 *              so a dynamic value controlled by a malicious actor may allow them to read arbitrary files.
 *              Audit uses of urllib calls to ensure user data cannot control the URLs, or consider
 *              using the 'requests' library instead.
 * @kind taint
 * @problem.severity warning
 * @id python/dynamic-urllib-use-detected
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class UrllibConfiguration extends TaintTracking::Configuration {
  UrllibConfiguration() { this = "DynamicUrllibUse" }

  override predicate isSource(DataFlow::Node source) {
    exists(CallNode call, string methodName |
      call.getTarget().(FunctionValue).getQualifiedName().matches("urllib.%") and
      not call.getTarget().(FunctionValue).getQualifiedName().matches("urllib.$W(...)") and
      not call.getTarget().(FunctionValue).getQualifiedName().matches("urllib.request.$W(...)") and
      not call.getTarget().(FunctionValue).getQualifiedName().matches("$OPENER.$W(...)") and
      methodName = ["urlopen", "urlretrieve", "open", "retrieve"].getAny() and
      call.getTarget().getName() = methodName and
      source.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(CallNode call, string methodName |
      call.getTarget().(FunctionValue).getQualifiedName().matches("urllib.%") and
      methodName = ["urlopen", "urlretrieve", "open", "retrieve"].getAny() and
      call.getTarget().getName() = methodName and
      sink.asExpr() = call.getArgument(0) and
      exists(DataFlow::Node arg |
        arg.asExpr() = sink.asExpr() and
        arg.getStringValue().regexpMatch("file://.*")
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(string url |
      url = sanitizer.getStringValue() and
      url.regexpMatch("^https?://")
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, UrllibConfiguration config
where config.hasFlowPath(source, sink)
select sink, "Dynamic value used with urllib may enable file scheme access", source,
  "This dynamic value may be controlled by a malicious actor to read arbitrary files"
