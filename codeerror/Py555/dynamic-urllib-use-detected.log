Rule Content:
/**
 * @name Dynamic urllib Use Detected
 * @description Detects dynamic values being used with urllib which may allow file scheme access
 * @kind path-problem
 * @problem.severity warning
 * @id python/dynamic-urllib-use
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class UrllibSource extends TaintTracking::TaintSource {
  UrllibSource() {
    exists(CallExpr call |
      call.getFunc().(QualifiedAccess).getTarget().getName() = "urlopen" and
      call.getFunc().(QualifiedAccess).getQualifiedName().matches("urllib%urlopen") and
      not call.getFunc().(QualifiedAccess).getQualifiedName().matches("urllib.request.%") and
      not call.getFunc().(QualifiedAccess).getQualifiedName().matches("urllib.$W%")
    )
    or
    exists(CallExpr call |
      call.getFunc().(QualifiedAccess).getTarget().getName() = "urlretrieve" and
      call.getFunc().(QualifiedAccess).getQualifiedName().matches("urllib%urlretrieve") and
      not call.getFunc().(QualifiedAccess).getQualifiedName().matches("urllib.request.%") and
      not call.getFunc().(QualifiedAccess).getQualifiedName().matches("urllib.$W%")
    )
  }

  override ASTNode getSrcNode() { result = this }
}

class FileSchemeSink extends TaintTracking::TaintSink {
  FileSchemeSink() {
    exists(CallExpr call, Expr arg |
      (call.getFunc().(QualifiedAccess).getTarget().getName() = "urlopen" or
       call.getFunc().(QualifiedAccess).getTarget().getName() = "urlretrieve") and
      arg = call.getArg(0) and
      arg.getStringValue().matches("file://%")
    )
  }

  override ASTNode getSinkNode() { result = this }
}

class HttpSanitizer extends TaintTracking::Sanitizer {
  HttpSanitizer() {
    exists(StringLiteral str |
      str.getStringValue().matches("^https?://%")
    )
  }
}

class DynamicUrllibTaintConfiguration extends TaintTracking::TaintTrackingConfiguration {
  DynamicUrllibTaintConfiguration() { this = "DynamicUrllibTaintConfiguration" }

  override predicate isSource(TaintTracking::TaintSource source) { source instanceof UrllibSource }

  override predicate isSink(TaintTracking::TaintSink sink) { sink instanceof FileSchemeSink }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) { sanitizer instanceof HttpSanitizer }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, DynamicUrllibTaintConfiguration config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected a dynamic value being used with urllib. " +
  "urllib supports 'file://' schemes, so a dynamic value controlled by a malicious actor " +
  "may allow them to read arbitrary files. Audit uses of urllib calls to ensure user data " +
  "cannot control the URLs, or consider using the 'requests' library instead."
