Rule Content:
/**
 * @name Dynamic urllib use detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://'
 *              schemes, so a dynamic value controlled by a malicious actor may allow them
 *              to read arbitrary files.
 * @kind path-problem
 * @problem.severity warning
 * @id py/dynamic-urllib-use-detected
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class UrllibCall extends DataFlow::CallNode {
  UrllibCall() {
    exists(string methodName | methodName = ["urlopen", "urlretrieve", "open", "retrieve"] |
      this.getTarget().hasQualifiedName("urllib", methodName) or
      this.getTarget().hasQualifiedName("urllib.request", methodName)
    )
  }

  string getUrlArgument() {
    result = this.getArgument(0).asExpr().getStringValue()
  }
}

class UrllibSource extends TaintTracking::TaintSource {
  UrllibSource() {
    exists(UrllibCall call |
      not call.getTarget().hasQualifiedName("urllib", _) and
      not call.getTarget().hasQualifiedName("urllib.request", _) and
      not call.getTarget().hasQualifiedName(_, "$OPENER") and
      this.asNode() = call.getArgument(0)
    )
  }

  override string getSourceType() { "URL_URLLIB_ENDPOINTS" }
}

class FileSchemeSink extends TaintTracking::TaintSink {
  FileSchemeSink() {
    exists(UrllibCall call |
      call.getUrlArgument().regexpMatch("file://.*") and
      this.asNode() = call.getArgument(0)
    )
  }

  override string getSinkType() { "FILE_SCHEME_ACCESS" }
}

class StaticUrlSanitizer extends TaintTracking::Sanitizer {
  StaticUrlSanitizer() {
    exists(DataFlow::Node node |
      node.asExpr().getStringValue().regexpMatch("^https?://") and
      this.asNode() = node
    )
  }
}

class DynamicUrllibUseConfig extends TaintTracking::Configuration {
  DynamicUrllibUseConfig() { this = "DynamicUrllibUseConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof UrllibSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof FileSchemeSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof StaticUrlSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, DynamicUrllibUseConfig config
where config.hasFlowPath(source, sink)
select sink, source, "Detected a dynamic value being used with urllib. urllib supports " +
  "'file://' schemes, so a dynamic value controlled by a malicious actor may allow them " +
  "to read arbitrary files.", source, "Dynamic URL source"
