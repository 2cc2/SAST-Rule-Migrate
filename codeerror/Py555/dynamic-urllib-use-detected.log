Rule Content:
/**
 * @name Dynamic urllib use detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes,
 *              so a dynamic value controlled by a malicious actor may allow them to read arbitrary files.
 * @kind path-problem
 * @problem.severity warning
 * @id python/dynamic-urllib-use
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow

class UrllibSource extends TaintTracking::Source {
  UrllibSource() {
    exists(Call call |
      call.getFunc().(Name).getId() = ["urlopen", "urlretrieve", "open", "retrieve"] and
      call.getFunc().getQualifier().getName() = "urllib"
    )
  }

  override predicate isSourceOf(TaintKind kind) { this = kind }
}

class FileSchemeSink extends TaintTracking::Sink {
  FileSchemeSink() {
    exists(Call call, string urlValue |
      call.getFunc().(Name).getId() = ["urlopen", "urlretrieve", "open", "retrieve"] and
      call.getArg(0).getStringValue() = urlValue and
      urlValue.matches("file://.*")
    )
  }

  override predicate isSinkOf(TaintKind kind) { this = kind }
}

class HttpSanitizer extends TaintTracking::Sanitizer {
  HttpSanitizer() {
    exists(string urlValue |
      urlValue.matches("^https?://") and
      // Ensure the URL is not concatenated with user input
      not exists(DataFlow::Node node |
        node.getStringValue() = urlValue and
        DataFlow::localFlow(node.getTopParent(), any(DataFlow::Node))
      )
    )
  }
}

class DynamicUrllibUseConfig extends TaintTracking::Configuration {
  DynamicUrllibUseConfig() { this = "Dynamic urllib use configuration" }

  override predicate isSource(TaintTracking::Source source) { source instanceof UrllibSource }

  override predicate isSink(TaintTracking::Sink sink) { sink instanceof FileSchemeSink }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof HttpSanitizer
  }
}

from DynamicUrllibUseConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), "Potential file scheme access through dynamic urllib call. " +
  "Consider using the 'requests' library or validating URLs.", source.getNode(),
  "Untrusted URL source here"
