/**
 * @name Dynamic urllib use detected
 * @kind problem
 * @id python/security/dynamic-urllib-use
 * @problem.severity warning
 * @security-severity 7.5
 */
import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class UrllibSource extends TaintTracking::Source, DataFlow::CallNode {
  UrllibSource() {
    exists(Call mc |
      mc.getTarget().getName() in ["urlopen", "urlretrieve", "open", "retrieve"] and
      mc.getTarget().getQualifiedName().matches("urllib%") and
      not mc.getTarget().getQualifiedName().matches("urllib\\$W%") and
      not mc.getTarget().getQualifiedName().matches("urllib.request\\$W%") and
      not mc.getTarget().getQualifiedName().matches("%\\$OPENER\\$W%") and
      this = mc
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    exists(Call mc | mc = source.asExpr() | 
      mc.getTarget().getName() in ["urlopen", "urlretrieve", "open", "retrieve"] and
      some(callIndex) |
      source = mc.getArgument(callIndex)
    )
  }

  override DataFlow::Node getACfgNode() { result = this.asDefiningLocation() }
  override Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = "Dynamic urllib source" }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override DataFlow::VariableNode asVariable() { result = this.asVariable() }
}

class FileSchemeSink extends TaintTracking::Sink, DataFlow::CallNode {
  FileSchemeSink() {
    exists(Call mc |
      mc.getTarget().getName() in ["urlopen", "urlretrieve", "open", "retrieve"] and
      exists(mc.getArgument(0).asExpr().getStringValue() as url |
        url.matches("file://.*")
      ) and
      this = mc
    )
  }

  override predicate isSinkOf(DataFlow::Node sink) { sink = this }

  override DataFlow::Node getACfgNode() { result = this.asDefiningLocation() }
  override Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = "File scheme sink" }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override DataFlow::VariableNode asVariable() { result = this.asVariable() }
}

class StaticUrlSanitizer extends TaintTracking::Sanitizer {
  StaticUrlSanitizer() {
    exists(StringLiteral sl | sl.getStringValue().matches("^https?://") | this = sl)
  }
}

class DynamicUrllibConfig extends TaintTracking::Configuration {
  DynamicUrllibConfig() { this = "Dynamic urllib configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UrllibSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileSchemeSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticUrlSanitizer
  }

  override predicate isSanitizerGuard(DataFlow::Node node) { none() }

  override predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, DynamicUrllibConfig config
where config.hasFlowPath(source, sink)
select sink, "Detected a dynamic value being used with urllib. urllib supports 'file://'" +
  " schemes, so a dynamic value controlled by a malicious actor may allow them to " +
  "read arbitrary files. Audit uses of urllib calls to ensure user data cannot " +
  "control the URLs, or consider using the 'requests' library instead."
