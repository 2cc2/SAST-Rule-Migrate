Rule Content:
/**
 * @name Dynamic urllib use detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes, 
 *              so a dynamic value controlled by a malicious actor may allow them to read arbitrary files.
 *              Audit uses of urllib calls to ensure user data cannot control the URLs, or consider using
 *              the 'requests' library instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/dynamic-urllib-use-detected
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class UrllibSource extends DataFlow::Node {
  UrllibSource() {
    exists(MethodCall mc |
      mc.getMethod().getName() = ["urlopen", "urlretrieve", "open", "retrieve"] and
      mc.getMethod().getDeclaringType().hasQualifiedName("urllib") and
      this.asExpr() = mc.getAnArgument()
    )
  }
}

class FileSchemeSink extends DataFlow::Node {
  FileSchemeSink() {
    exists(MethodCall mc |
      mc.getMethod().getName() = ["urlopen", "urlretrieve", "open", "retrieve"] and
      mc.getMethod().getDeclaringType().hasQualifiedName("urllib") and
      exists(mc.getAnArgument() as arg |
        arg.getStringValue().regexpMatch("file://.*") and
        this.asExpr() = mc
      )
    )
  }
}

class StaticUrlSanitizer extends DataFlow::Node {
  StaticUrlSanitizer() {
    exists(string str |
      str.regexpMatch("^https?://") and
      this.asExpr().(StringLiteral).getStringValue() = str
    )
  }
}

/** Taint tracking configuration */
class DynamicUrllibConfig extends TaintTracking::Configuration {
  DynamicUrllibConfig() { this = "DynamicUrllibConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UrllibSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof FileSchemeSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticUrlSanitizer
  }
}

from DynamicUrllibConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential arbitrary file access through dynamic urllib call with file scheme", source,
  "This call uses a dynamic value $@ that may allow arbitrary file access.",
  source.getNode(), "controlled by user input"
