Rule Content:
/**
 * @name Dynamic urllib use detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes, 
 *              so a dynamic value controlled by a malicious actor may allow them to read arbitrary files.
 * @kind path-problem
 * @problem.severity warning
 * @id python/dynamic-urllib-use-detected
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class UrlLibSource extends DataFlow::Node {
  UrlLibSource() {
    exists(Call call |
      call.getTarget().hasQualifiedName("urllib", "urlopen") or
      call.getTarget().hasQualifiedName("urllib", "urlretrieve") or
      call.getTarget().hasQualifiedName("urllib", "open") or
      call.getTarget().hasQualifiedName("urllib", "retrieve")
    |
      this.asExpr() = call.getArg(0)
    )
    and
    not (
      this.asExpr() instanceof StringLiteral
    )
  }
}

class FileSchemeAccess extends DataFlow::Node {
  FileSchemeAccess() {
    exists(Call call |
      call.getTarget().hasQualifiedName("urllib", "urlopen") or
      call.getTarget().hasQualifiedName("urllib", "urlretrieve") or
      call.getTarget().hasQualifiedName("urllib", "open") or
      call.getTarget().hasQualifiedName("urllib", "retrieve")
    |
      this.asExpr() = call.getArg(0) and
      this.asExpr().toString().regexpMatch("file://.*")
    )
  }
}

class SafeUrl extends DataFlow::Node {
  SafeUrl() {
    exists(StringLiteral lit |
      lit.getValue().regexpMatch("^https?://") and
      this.asExpr() = lit
    )
  }
}

class DynamicUrllibUseConfig extends TaintTracking::Configuration {
  DynamicUrllibUseConfig() { this = "DynamicUrllibUseConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UrlLibSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof FileSchemeAccess }

  override predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof SafeUrl }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, DynamicUrllibUseConfig config
where 
  config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected a dynamic value being used with urllib. urllib supports 'file://' schemes, so a dynamic value controlled by a malicious actor may allow them to read arbitrary files. Audit uses of urllib calls to ensure user data cannot control the URLs, or consider using the 'requests' library instead."
