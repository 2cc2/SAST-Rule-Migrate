Rule Content:
/**
 * @name Dangerous subprocess use audit
 * @description Detects subprocess function calls without static strings that could lead to command injection.
 * @kind path-problem
 * @problem.severity error
 * @id py/dangerous-subprocess-use-audit
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class SubprocessCall extends DataFlow::Node {
  SubprocessCall() {
    exists(FunctionValue func |
      this.asExpr() = func.getACall() and
      func.getPackage() = "subprocess" and
      func.getName().regexpMatch(".*")
    )
  }

  predicate isShellInvocation() {
    exists(string shell |
      shell.regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$") and
      this.asExpr().getArg(0).getValue().getStringValue() = shell
    )
  }

  predicate isPythonInvocation() {
    this.asExpr().getArg(0).getValue().getStringValue() = "python"
  }

  predicate hasStaticArgument() {
    this.asExpr().getArg(0).getValue().isConstant()
  }
}

class SubprocessConfig extends TaintTracking::Configuration {
  SubprocessConfig() { this = "SubprocessCommandInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SubprocessCall and
    ([subprocessCall.getACall(), subprocessCall.isShellInvocation()] or
     [subprocessCall.getACall(), subprocessCall.isPythonInvocation()])
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SubprocessCall and
    sanitizer.hasStaticArgument()
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::ArgumentNode arg1, DataFlow::ArgumentNode arg2 |
      pred = arg1 and succ = arg2
    )
  }
}

from SubprocessConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Detected subprocess function '" + sink.getNode().asExpr().(FunctionCall).getCalleeName() +
  "' without a static string. If this data can be controlled by a malicious actor, " +
  "it may be an instance of command injection.", source.getNode(),
  "User controlled input"
