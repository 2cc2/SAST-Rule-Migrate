/**
 * @name Dangerous Subprocess Use
 * @description Detects subprocess calls with non-static arguments that could lead to command injection
 * @kind path-problem
 * @problem.severity error
 * @id python/command-injection
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class SubprocessCall extends DataFlow::CfgNode {
  SubprocessCall() {
    exists(DataFlow::BasicBlock bb |
      bb.getACall() = this and
      this.getTarget().hasQualifiedName("subprocess", ["Popen", "call", "run", "check_call", "check_output"])
    )
  }
}

class ShellInvocationSource extends TaintTracking::TaintSource {
  ShellInvocationSource() {
    exists(SubprocessCall call |
      call.getArg(0).getValue().toString().matches("(sh|bash|ksh|csh|tcsh|zsh)") and
      this.asCfgNode() = call
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(ShellInvocationSource s | source = s.asCfgNode())
  }

  override DataFlow::CfgNode asCfgNode() { this = result }

  override DataFlow::BasicBlock getBasicBlock() { result = this }

  override string toString() { result = "Shell invocation source" }

  override DataFlow::Scope getScope() { result = any(DataFlow::Scope) }

  override DataFlow::Variable asVariable() { none() }
}

class PythonInvocationSource extends TaintTracking::TaintSource {
  PythonInvocationSource() {
    exists(SubprocessCall call |
      call.getArg(0).getValue().toString().matches("python") and
      this.asCfgNode() = call
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(PythonInvocationSource s | source = s.asCfgNode())
  }

  override DataFlow::CfgNode asCfgNode() { this = result }

  override DataFlow::BasicBlock getBasicBlock() { result = this }

  override string toString() { result = "Python invocation source" }

  override DataFlow::Scope getScope() { result = any(DataFlow::Scope) }

  override DataFlow::Variable asVariable() { none() }
}

class StaticArgSanitizer extends TaintTracking::Sanitizer {
  StaticArgSanitizer() {
    exists(SubprocessCall call |
      call.getArg(0).isConstant() and
      this.asCfgNode() = call
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StaticArgSanitizer s | node = s.asCfgNode())
  }

  override DataFlow::CfgNode asCfgNode() { this = result }

  override DataFlow::BasicBlock getBasicBlock() { result = this }

  override string toString() { result = "Static argument sanitizer" }

  override DataFlow::Scope getScope() { result = any(DataFlow::Scope) }

  override DataFlow::Variable asVariable() { none() }
}

class DangerousSubprocessFlowConfiguration extends TaintTracking::Configuration {
  DangerousSubprocessFlowConfiguration() { this = "DangerousSubprocessFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ShellInvocationSource or
    source instanceof PythonInvocationSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessCall
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof StaticArgSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::MemberAccess ma |
      ma.getBase() = node1.asExpr() and
      node2.asExpr() = ma
    )
  }
}

from DangerousSubprocessFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential command injection vulnerability in subprocess call", source,
  "This subprocess call uses input that may be controlled by an attacker"
================================================================================
