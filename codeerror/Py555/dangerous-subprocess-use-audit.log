Rule Content:
/**
 * @name Dangerous subprocess use
 * @description Detects subprocess function calls without static strings that may lead to command injection
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-subprocess-use-audit
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class SubprocessCall extends DataFlow::CallNode {
  SubprocessCall() {
    exists(Function f |
      exists(f.getACall(), this) and
      f.getQualifiedName().matches("subprocess.%")
    )
  }

  string getFunctionName() {
    result = this.getTarget().getQualifiedName()
  }
}

class ShellInvocation extends DataFlow::Node {
  ShellInvocation() {
    exists(SubprocessCall call |
      this.asExpr() = call.getArg(0).getExpr() and
      exists(this.getStringValue().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)"))
    )
  }
}

class PythonInvocation extends DataFlow::Node {
  PythonInvocation() {
    exists(SubprocessCall call |
      this.asExpr() = call.getArg(0).getExpr() and
      this.getStringValue().regexpMatch("(python)")
    )
  }
}

class StaticArgSanitizer extends DataFlow::Node {
  StaticArgSanitizer() {
    exists(SubprocessCall call |
      this.asExpr() = call.getArg(0).getExpr() and
      this.getConstantValue()
    )
  }
}

class DangerousSubprocessConfig extends TaintTracking::Configuration {
  DangerousSubprocessConfig() { this = "DangerousSubprocessConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ShellInvocation or source instanceof PythonInvocation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticArgSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    DataFlow::localFlowStep(pred, succ)
  }
}

from DangerousSubprocessConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Detected subprocess function call without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
