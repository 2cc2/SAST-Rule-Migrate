xcpgir_version: "1.0"
rule:
  id: dangerous-subprocess-use-audit
  kind: taint
  severity: ERROR
  message: >-
    Detected subprocess function '$FUNC' without a static string. If this data can
    be controlled by a malicious actor, it may be an instance of command injection.
    Audit the use of this call to ensure it is not controllable by an external resource.
    You may consider using 'shlex.escape()'.

sources:
  - id: SHELL_INVOCATION
    match:
      node: CALL
      api:
        package: subprocess
        method: $FUNC
      where:
        - op: regex
          left: arg[0].value
          right: "=~/(sh|bash|ksh|csh|tcsh|zsh)/"
  - id: PYTHON_INVOCATION
    match:
      node: CALL
      api:
        package: subprocess
        method: $FUNC
      where:
        - op: regex
          left: arg[0].value
          right: "=~/(python)/"

sinks:
  - id: SUBPROCESS_CALL
    match:
      node: CALL
      api:
        package: subprocess
        method: $FUNC

sanitizers:
  - id: STATIC_ARGS
    match:
      node: CALL
      api:
        package: subprocess
        method: $FUNC
    effect: neutralize
    scope:
      sinks: [SUBPROCESS_CALL]
    where:
      - op: eq
        left: arg[0].value.const
        right: true

propagations:
  - id: ARG_TO_ARG
    edge: arg->arg
    kind: taint
