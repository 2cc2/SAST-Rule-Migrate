      node: CALL
      api:
        package: subprocess
        method: $FUNC

sanitizers:
  - id: STATIC_ARGS
    match:
      node: CALL
      api:
        package: subprocess
        method: $FUNC
    effect: neutralize
    scope:
      sinks: [SUBPROCESS_CALL]
    where:
      - op: eq
        left: arg[0].value.const
        right: true

propagations:
  - id: ARG_TO_ARG
    edge: arg->arg
    kind: taint
