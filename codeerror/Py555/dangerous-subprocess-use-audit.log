Rule Content:
/**
 * @name Dangerous subprocess use
 * @description Detects subprocess function calls without static strings that may be controllable by attackers
 * @id dangerous-subprocess-use-audit
 * @kind path-problem
 * @problem.severity error
 */
import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class ShellInvocation extends API::CallNode {
  ShellInvocation() {
    this.getTarget().(FunctionValue).getEnclosingModule().getName() = "subprocess" and
    this.getTarget().(FunctionValue).getName().matches("(sh|bash|ksh|csh|tcsh|zsh)%")
  }

  override Node getACfgNode() { result = this }
  override Location getLocation() { result = this.getLocation() }
  override string toString() { result = this.toString() }
  override BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override Variable getAScope() { result = this.getAScope() }
  override DataFlow::Node asVariable() { result = this }
}

class PythonInvocation extends API::CallNode {
  PythonInvocation() {
    this.getTarget().(FunctionValue).getEnclosingModule().getName() = "subprocess" and
    this.getTarget().(FunctionValue).getName().matches("python%")
  }

  override Node getACfgNode() { result = this }
  override Location getLocation() { result = this.getLocation() }
  override string toString() { result = this.toString() }
  override BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override Variable getAScope() { result = this.getAScope() }
  override DataFlow::Node asVariable() { result = this }
}

class SubprocessCall extends API::CallNode {
  SubprocessCall() {
    this.getTarget().(FunctionValue).getEnclosingModule().getName() = "subprocess"
  }

  override Node getACfgNode() { result = this }
  override Location getLocation() { result = this.getLocation() }
  override string toString() { result = this.toString() }
  override BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override Variable getAScope() { result = this.getAScope() }
  override DataFlow::Node asVariable() { result = this }
}

class StaticArgsSanitizer extends TaintTracking::Sanitizer {
  StaticArgsSanitizer() {
    // Check if first argument is a string literal
    exists(API::CallNode call |
      call.getTarget().(FunctionValue).getEnclosingModule().getName() = "subprocess" and
      call.getArgument(0).asExpr() instanceof ConstantExpr
    )
  }

  override predicate isSanitizer(TaintTracking::TaintNode node) {
    exists(API::CallNode call |
      node.asExpr() = call and
      call.getTarget().(FunctionValue).getEnclosingModule().getName() = "subprocess" and
      call.getArgument(0).asExpr() instanceof ConstantExpr
    )
  }

  override Node getACfgNode() { result = this }
  override Location getLocation() { result = this.getLocation() }
  override string toString() { result = this.toString() }
  override BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override Variable getAScope() { result = this.getAScope() }
  override DataFlow::Node asVariable() { result = this }
}

class SubprocessConfig extends TaintTracking::Configuration {
  SubprocessConfig() { this = "SubprocessCommandInjection" }

  override predicate isSource(TaintTracking::TaintSource source) {
    exists(ShellInvocation shell | source = shell) or
    exists(PythonInvocation python | source = python)
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(SubprocessCall call | sink = call)
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(StaticArgsSanitizer s | sanitizer = s)
  }
}

from SubprocessConfig cfg, PathGraph::PathNode source, PathGraph::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected subprocess function call without a static string. If this data can be controlled " +
  "by a malicious actor, it may be an instance of command injection. Audit the use of this " +
  "call to ensure it is not controllable by an external resource. Consider using 'shlex.escape()'."
