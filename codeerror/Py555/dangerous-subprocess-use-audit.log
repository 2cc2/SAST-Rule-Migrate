Rule Content:
/**
 * @name Dangerous Subprocess Use
 * @description Detects subprocess function calls without static strings that may be vulnerable to command injection
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/dangerous-subprocess-use-audit
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class SubprocessCall extends DataFlow::CallNode {
  SubprocessCall() {
    exists(string funcName | 
      this.getTarget().hasQualifiedName("subprocess", funcName) and
      funcName.matches("%") and
      result = funcName
    )
  }

  string getFunctionName() {
    this.getTarget().getName()
  }
}

class ShellInvocation extends DataFlow::Node {
  ShellInvocation() {
    exists(SubprocessCall call |
      this = call.getArg(0).getExpr() and
      this.getStringValue().matches("%sh%") or
      this.getStringValue().matches("%bash%") or
      this.getStringValue().matches("%ksh%") or
      this.getStringValue().matches("%csh%") or
      this.getStringValue().matches("%tcsh%") or
      this.getStringValue().matches("%zsh%")
    )
  }
}

class PythonInvocation extends DataFlow::Node {
  PythonInvocation() {
    exists(SubprocessCall call |
      this = call.getArg(0).getExpr() and
      this.getStringValue().matches("%python%")
    )
  }
}

class StaticArgSanitizer extends DataFlow::Node {
  StaticArgSanitizer() {
    exists(SubprocessCall call |
      this = call.getArg(0).getExpr() and
      this.getConstantValue()
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "DangerousSubprocessUse" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ShellInvocation or
    source instanceof PythonInvocation
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SubprocessCall call | sink = call.getArg(0).getExpr())
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticArgSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from Config config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Detected subprocess function '" + sink.getNode().getCall().getFunctionName() + 
  "' without a static string. If this data can be controlled by a malicious actor, " +
  "it may be an instance of command injection. Audit the use of this call to ensure " +
  "it is not controllable by an external resource. You may consider using 'shlex.escape()'.",
  source.getNode(), "Potentially dangerous command source"
