  SubprocessCall() {
    exists(FunctionCall fc |
      fc.getTarget().getQualifiedName().matches("subprocess.%") and
      this = fc.getArgument(0)
    )
  }

  override predicate isSource() { 
    exists(FunctionCall fc |
      fc.getTarget().getQualifiedName().matches("subprocess.%") and
      (
        fc.getArgument(0).asStr().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)") or
        fc.getArgument(0).asStr().regexpMatch("(python)")
      ) and
      this = fc.getArgument(0)
    )
  }
}

class SubprocessSink extends TaintTracking::Sink {
  SubprocessSink() {
    exists(FunctionCall fc |
      fc.getTarget().getQualifiedName().matches("subprocess.%") and
      this = fc.getArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node node) { node = any(SubprocessSink ss) }
}

class StaticArgumentSanitizer extends TaintTracking::Sanitizer {
  StaticArgumentSanitizer() {
    exists(FunctionCall fc |
      fc.getTarget().getQualifiedName().matches("subprocess.%") and
      fc.getArgument(0).isConstant().getStringValue() instanceof string and
      this = fc.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) { node = any(StaticArgumentSanitizer ss) }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "Dangerous-subprocess-use" }

  override predicate isSource(DataFlow::Node source) { source instanceof SubprocessCall }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SubprocessSink }

  override predicate isSanitizer(DataFlow::Node node) { node instanceof StaticArgumentSanitizer }

  override predicate isAdditionalTaintStep(DataFlow::Node n1, DataFlow::Node n2) {
    exists(FunctionCall fc |
      fc.getTarget().getQualifiedName().matches("subprocess.%") and
      n1 = fc.getArgument(_) and
      n2 = fc.getArgument(_)
    )
  }
}

