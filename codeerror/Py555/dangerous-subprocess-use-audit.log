Rule Content:
/**
 * @name Dangerous subprocess use audit
 * @description Detects subprocess function calls without static strings which may lead to command injection
 * @kind path-problem
 * @problem.severity error
 * @id py/dangerous-subprocess-use-audit
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class SubprocessCall extends DataFlow::CallNode {
  SubprocessCall() {
    this.getCallee().getQualifiedName().matches("subprocess.%")
  }
}

class ShellInvocation extends DataFlow::Node {
  ShellInvocation() {
    exists(SubprocessCall call |
      call.getArgument(0) = this and
      this.asExpr().toString().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)")
    )
  }
}

class PythonInvocation extends DataFlow::Node {
  PythonInvocation() {
    exists(SubprocessCall call |
      call.getArgument(0) = this and
      this.asExpr().toString().regexpMatch("(python)")
    )
  }
}

class StaticArgsSanitizer extends DataFlow::Node {
  StaticArgsSanitizer() {
    exists(SubprocessCall call |
      call.getArgument(0) = this and
      this.asExpr() instanceof ConstantExpr
    )
  }
}

predicate isSource(DataFlow::Node source) {
  source instanceof ShellInvocation or
  source instanceof PythonInvocation
}

predicate isSink(DataFlow::Node sink) {
  sink instanceof SubprocessCall
}

predicate isSanitizer(DataFlow::Node sanitizer) {
  sanitizer instanceof StaticArgsSanitizer
}

predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
  any(SubprocessCall call).getAnArg() = node1 and
  any(SubprocessCall call).getAnArg() = node2 and
  node1 != node2
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where TaintTracking::localTaint(source, sink)
select sink.getNode(), 
  "Detected subprocess function call without a static string. If this data can " +
  "be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'.", source.getNode(), 
  "User-controlled value flows here"
