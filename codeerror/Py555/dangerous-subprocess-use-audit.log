Rule Content:
/**
 * @name Dangerous subprocess use
 * @description Detects subprocess calls without static strings that may lead to command injection
 * @id python/dangerous-subprocess-use
 * @kind path-problem
 * @problem.severity error
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class SubprocessCall extends DataFlow::Node {
  SubprocessCall() {
    exists(Call call | 
      call.getTarget().(FunctionValue).getEnclosingModule().getName() = "subprocess" and
      this = call.getArgument(0)
    )
  }
}

class ShellInvocationSource extends DataFlow::Node {
  ShellInvocationSource() {
    exists(Call call |
      call.getTarget().(FunctionValue).getEnclosingModule().getName() = "subprocess" and
      call.getArgument(0).getStringValue().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)") and
      this = call.getArgument(0)
    )
  }
}

class PythonInvocationSource extends DataFlow::Node {
  PythonInvocationSource() {
    exists(Call call |
      call.getTarget().(FunctionValue).getEnclosingModule().getName() = "subprocess" and
      call.getArgument(0).getStringValue().regexpMatch("python") and
      this = call.getArgument(0)
    )
  }
}

class StaticStringSanitizer extends DataFlow::Node {
  StaticStringSanitizer() {
    this instanceof StringLiteral
  }
}

class SubprocessTaintConfig extends TaintTracking::Configuration {
  SubprocessTaintConfig() { this = "SubprocessTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ShellInvocationSource or
    source instanceof PythonInvocationSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticStringSanitizer
  }
}

from SubprocessTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "Detected subprocess function call without a static string. If this data can " +
  "be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'.",
  source, sink
