Rule Content:
/**
 * @name Dangerous subprocess use audit
 * @description Detected subprocess function without a static string. If this data can
 *              be controlled by a malicious actor, it may be an instance of command injection.
 *              Audit the use of this call to ensure it is not controllable by an external resource.
 *              You may consider using 'shlex.escape()'.
 * @kind taint
 * @problem.severity error
 * @id py/dangerous-subprocess-use-audit
 */

import python
import semmle.python.dataflow.TaintTracking

class SubprocessCall extends DataFlow::CallNode {
  SubprocessCall() {
    exists(string funcName |
      this.getTarget().(Member).getQualifiedName().matches("subprocess." + funcName) and
      (funcName = "Popen" or funcName = "call" or funcName = "run" or funcName = "check_call" or
       funcName = "check_output" or funcName = "getstatusoutput" or funcName = "getoutput")
    )
  }
}

class ShellInvocationSource extends DataFlow::Node {
  ShellInvocationSource() {
    exists(SubprocessCall call |
      call.getArg(0) = this.asExpr() and
      this.getStringValue().regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/")
    )
  }
}

class PythonInvocationSource extends DataFlow::Node {
  PythonInvocationSource() {
    exists(SubprocessCall call |
      call.getArg(0) = this.asExpr() and
      this.getStringValue().regexpMatch("/(python)/")
    )
  }
}

class StaticArgSanitizer extends DataFlow::Node {
  StaticArgSanitizer() {
    exists(SubprocessCall call |
      call.getArg(0) = this.asExpr() and
      this.isConstant()
    )
  }
}

class DangerousSubprocessFlowConfiguration extends TaintTracking::Configuration {
  DangerousSubprocessFlowConfiguration() { this = "DangerousSubprocessFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ShellInvocationSource or
    source instanceof PythonInvocationSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asExpr().getParent() instanceof SubprocessCall
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof StaticArgSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::ParameterNode param1, DataFlow::ParameterNode param2 |
      param1.getCall() = param2.getCall() and
      param1.getCall() != any(SubprocessCall call) and
      param1.getNode() = node1 and
      param2.getNode() = node2
    )
  }
}

from DangerousSubprocessFlowConfiguration cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected subprocess call with potentially unsafe input from $@.", source,
  "this source"
