import python
import semmle.python.security.Xss
import semmle.python.web.flask
import semmle.python.dataflow.new.TaintTracking
import semmle.python.dataflow.new.DataFlow

class AutoescapeOff extends python.StringLiteral {
  AutoescapeOff() {
    this.getText().regexpMatch("\\{%\\s*autoescape\\s+false\\s*%\\}")
  }
}

class AutoescapeOn extends python.StringLiteral {
  AutoescapeOn() {
    this.getText().regexpMatch("\\{%\\s*autoescape\\s+true\\s*%\\}")
  }
}

class TemplateConfig extends TaintTracking::Configuration {
  TemplateConfig() { this = "TemplateConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(AutoescapeOff off | source.asExpr() = off)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(semmle.python.web.flask.TemplateRender render |
      sink.asExpr() = render.getACall().getAnArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AutoescapeOn on | sanitizer.asExpr() = on)
  }
}

from TemplateConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected a segment of a Flask template where autoescaping is explicitly " +
  "disabled with '{% autoescape off %}'. This allows rendering of raw HTML in this " +
  "segment. Ensure no user data is rendered here, otherwise this is a XSS " +
  "vulnerability, or turn autoescape on."
