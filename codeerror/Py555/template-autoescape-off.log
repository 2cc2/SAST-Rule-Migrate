Rule Content:
/**
 * @name Template Autoescape Off
 * @description Detected a segment of a Flask template where autoescaping is explicitly disabled with '{% autoescape off %}'. 
 *              This allows rendering of raw HTML and may lead to XSS vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id python/template-autoescape-off
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class AutoescapeOffConfig extends DataFlow::Configuration {
  AutoescapeOffConfig() { this = "AutoescapeOffConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(string pattern | 
      pattern = "\\{\\%\\s*autoescape\\s+false\\s*\\%\\}" and
      source.asString().getText().regexpMatches(pattern)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getMethod().getName() = "render" and
      call.getMethod().getDeclaringType().getName() = "Template" and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(string pattern |
      pattern = "\\{\\%\\s*autoescape\\s+true\\s*\\%\\}" and
      sanitizer.asString().getText().regexpMatches(pattern)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, AutoescapeOffConfig config
where config.hasFlowPath(source, sink)
select sink, "Potential XSS vulnerability: template rendering with autoescape disabled", source,
  "Autoescape is disabled here with '{% autoescape false %}'"
