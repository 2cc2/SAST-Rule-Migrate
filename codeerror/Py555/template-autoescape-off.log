import python
import semmle.python.Concepts
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.web.flask.Flask

class AutoescapeOff extends DataFlow::Node {
  AutoescapeOff() {
    exists(string s |
      s = this.getValue() and
      s.matches("\\{%\\s*autoescape\\s+false\\s*%\\}")
    )
  }
}

class AutoescapeOn extends DataFlow::Node {
  AutoescapeOn() {
    exists(string s |
      s = this.getValue() and
      s.matches("\\{%\\s*autoescape\\s+true\\s*%\\}")
    )
  }
}

class FlaskTemplateRender extends DataFlow::Node {
  string templateContent;

  FlaskTemplateRender() {
    exists(Call call |
      call.getCallee().(Name).getId() = "render" and
      this.asExpr() = call and
      templateContent = call.getArg(0).getValue()
    )
  }

  override Domain::CFGNode asCfgNode() { result = this }
  override string toString() { result = this.templateContent }
  override Location getLocation() { result = this.getLocation() }
  override BasicBlock::BasicBlock getBasicBlock() { result = none() }
  override Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = none() }
}

class TemplateAutoescapeConfig extends TaintTracking::Configuration {
  TemplateAutoescapeConfig() { this = "TemplateAutoescapeConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof AutoescapeOff
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof FlaskTemplateRender
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof AutoescapeOn
  }
}

from AutoescapeOff source, FlaskTemplateRender sink, TemplateAutoescapeConfig config
where config.hasFlow(source, sink)
select sink, "Detected a segment of a Flask template where autoescaping is explicitly disabled. " +
  "This allows rendering of raw HTML in this segment. Ensure no user data is " +
  "rendered here, otherwise this is a cross-site scripting (XSS) vulnerability, " +
  "or turn autoescape on."
