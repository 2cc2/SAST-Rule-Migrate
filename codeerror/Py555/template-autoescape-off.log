Rule Content:
/**
 * @name Template Autoescape Off
 * @description Detected a segment of a Flask template where autoescaping is explicitly disabled. This allows rendering of raw HTML in this segment.
 * @kind path-problem
 * @problem.severity warning
 * @id python/flask/template-autoescape-off
 */

import python
import semmle.python.security.XSS
import semmle.python.web.flask.Template as FlaskTemplate

class AutoescapeOff extends Expr::Literal {
  AutoescapeOff() {
    this.getStringValue().regexpMatch("\\{%\\s*autoescape\\s+false\\s*%\\}")
  }
}

class AutoescapeOn extends Expr::Literal {
  AutoescapeOn() {
    this.getStringValue().regexpMatch("\\{%\\s*autoescape\\s+true\\s*%\\}")
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TemplateAutoescapeOffConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(AutoescapeOff ao |
      source.asExpr() = ao
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(FlaskTemplate::RenderMethodCall render |
      sink.asExpr() = render.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AutoescapeOn on |
      sanitizer.asExpr() = on
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected a segment of a Flask template where autoescaping is explicitly disabled with '{% autoescape off %}'. " +
  "This allows rendering of raw HTML in this segment. Ensure no user data is rendered here, otherwise this is a " +
  "cross-site scripting (XSS) vulnerability, or turn autoescape on.", source, sink
