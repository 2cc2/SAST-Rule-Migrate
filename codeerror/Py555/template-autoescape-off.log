Rule Content:
/**
 * @name Template Autoescape Off
 * @description Detects segments of Flask templates where autoescaping is explicitly
 *              disabled, potentially leading to XSS vulnerabilities.
 * @kind problem
 * @problem.severity warning
 * @id python/flask/template-autoescape-off
 */

import python
import semmle.python.web.flask.FlaskRouting
import semmle.python.web.flask.Template
import semmle.python.regexp.Regexp

from TemplateBlock block, RegexpLiteral lit
where
  lit.getValue().regexpMatch("\\{%\\s*autoescape\\s+false\\s*%\\}") and
  block.contains(lit) and
  exists(TemplateRenderer renderer |
    renderer.getTargetTemplate().getFile() = block.getFile() and
    not exists(TemplateBlock sanitizeBlock |
      sanitizeBlock.contains(RegexpLiteral sanitizeLit |
        sanitizeLit.getValue().regexpMatch("\\{%\\s*autoescape\\s+true\\s*%\\}")
      )
    )
  )
select block, "Detected a segment of a Flask template where autoescaping is explicitly disabled " +
  "with '{% autoescape off %}'. This allows rendering of raw HTML in this segment. " +
  "Ensure no user data is rendered here, otherwise this is a cross-site scripting " +
  "(XSS) vulnerability, or turn autoescape on."
