Rule Content:
/**
 * @name Template autoescape off
 * @description Detected a segment of a Flask template where autoescaping is explicitly disabled.
 * @kind path-problem
 * @problem.severity warning
 * @id python/flask/template-autoescape-off
 */

import python
import semmle.python.security.xss.TemplateString
import DataFlow::PathGraph

class AutoescapeOffConfiguration extends TemplateString::Configuration {
  AutoescapeOffConfiguration() {
    this = "Template autoescape off"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(stringregexpr |
      source.asExpr().(StringLiteral).getText() = stringregexpr and
      stringregexpr.matches("\\{\\%\\s*autoescape\\s+false\\s*\\%\\}")
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(stringregexpr |
      sanitizer.asExpr().(StringLiteral).getText() = stringregexpr and
      stringregexpr.matches("\\{\\%\\s*autoescape\\s+true\\s*\\%\\}")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCallNode call |
      call.getMethod().getName() = "render" and
      call.getReceiver().getType().getName() = "Template" and
      call.getReceiver().getType().getPackage().getName() = "flask" and
      sink.asExpr() = call.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, AutoescapeOffConfiguration config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Detected a segment of a Flask template where autoescaping is explicitly disabled " +
  "with '{% autoescape off %}'. This allows rendering of raw HTML in this segment."
