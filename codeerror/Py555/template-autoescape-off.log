Rule Content:
/**
 * @name Template Autoescape Off
 * @description Detects Flask templates where autoescaping is explicitly disabled,
 *              which could lead to XSS vulnerabilities if user-supplied data is rendered.
 * @kind path-problem
 * @problem.severity warning
 * @id python/flask/template-autoescape-off
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.Concepts
import semmle.python.web.flask.Templates

class AutoescapeOff extends Expr {
  AutoescapeOff() {
    exists(string literal |
      literal = this.getStringLiteral() and
      regexpMatch(literal, "\\{\\%\\s*autoescape\\s+false\\s*\\%\\}")
    )
  }
}

class AutoescapeOn extends Expr {
  AutoescapeOn() {
    exists(string literal |
      literal = this.getStringLiteral() and
      regexpMatch(literal, "\\{\\%\\s*autoescape\\s+true\\s*\\%\\}")
    )
  }
}

class FlaskTemplateRender extends DataFlow::Node {
  FlaskTemplateRender() {
    exists(Call call |
      call.getTarget().getName() = "render" and
      call.getTarget().getDeclaringType().getName() = "Template" and
      call.getTarget().getDeclaringType().getAPackage().getName() = "flask" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TemplateAutoescapeOff" }

  override predicate isSource(DataFlow::Node source) {
    exists(AutoescapeOff off | source.asExpr() = off)
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FlaskTemplateRender
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AutoescapeOn on | sanitizer.asExpr() = on)
  }
}

from Config config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Detected a Flask template where autoescaping is explicitly disabled with '{% autoescape off %}'. " +
  "This allows rendering of raw HTML which could lead to XSS vulnerabilities if user data is included."
