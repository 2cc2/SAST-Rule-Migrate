Rule Content:
/**
 * @id sqlalchemy-execute-raw-query
 * @severity ERROR
 * @name SQL Injection through string concatenation in SQLAlchemy execute
 * @description Avoiding SQL string concatenation: untrusted input concatenated with raw
 *   SQL query can result in SQL Injection. In order to execute raw query
 *   safely, prepared statement should be used.
 */
import python

class SQLConcatenationSource extends DataFlow::Node {
  SQLConcatenationSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      (
        ma.getAnArg().getText().matches("%(\\+|%|format|f\")%") or
        ma.getAnArg().toString().matches("%(concat|format|join|replace)%")
      )
    )
  }
}

class SQLExecutionSink extends DataFlow::Node {
  SQLExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getQualifier().getType().getName() = "sqlalchemy"
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "text" and
      ma.getQualifier().getType().getName() = "sqlalchemy"
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  // Define the taint flow
  DataFlow::localFlow(source.getNode(), sink.getNode()) and
  // Source is SQL concatenation
  source.getNode() instanceof SQLConcatenationSource and
  // Sink is SQL execution
  sink.getNode() instanceof SQLExecutionSink and
  // Exclude cases where the source was sanitized with prepared statement
  not exists(PreparedStatementSanitizer ps |
    DataFlow::localFlow(source.getNode(), ps)
  )
select sink.getNode(), "Potential SQL injection from unsafe string concatenation in SQLAlchemy execute() call"
