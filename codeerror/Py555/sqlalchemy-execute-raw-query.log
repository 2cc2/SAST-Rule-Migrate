Rule Content:
/**
 * @name SQLAlchemy raw SQL query execution with string concatenation
 * @description Detects SQL injection vulnerabilities when untrusted input is concatenated
 *              with raw SQL queries in SQLAlchemy execute() calls.
 * @kind path-problem
 * @problem.severity error
 * @id python/sqlalchemy-execute-raw-query
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow
import DataFlow::PathGraph

class SqlalchemyExecuteMethod extends Callable {
  SqlalchemyExecuteMethod() {
    getName() = "execute" and
    getAPICategory() = "sqlalchemy"
  }
}

class SqlStringConcatenation extends DataFlow::Node {
  SqlStringConcatenation() {
    exists(BinaryExpr bin |
      bin.getOperator() = "+" and
      bin.getLeftOperand().getType() = "str" and
      bin.getRightOperand().getType() = "str" and
      this.asExpr() = bin
    )
    or
    exists(StrFormat fmt | this.asExpr() = fmt)
  }
}

class SqlalchemyTextSanitizer extends Callable {
  SqlalchemyTextSanitizer() {
    getName() = "text" and
    getAPICategory() = "sqlalchemy"
  }
}

class SqlInjectionConfiguration extends DataFlow::Configuration {
  SqlInjectionConfiguration() { this = "SqlInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof SqlStringConcatenation
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCallee() instanceof SqlalchemyExecuteMethod and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getCallee() instanceof SqlalchemyTextSanitizer and
      sanitizer.asExpr() = call
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where any(SqlInjectionConfiguration conf).hasFlowPath(source, sink)
select sink, source, sink,
  "Potential SQL injection: untrusted input concatenated with raw SQL query. " +
  "Use prepared statements with sqlalchemy.text() for safe execution."
