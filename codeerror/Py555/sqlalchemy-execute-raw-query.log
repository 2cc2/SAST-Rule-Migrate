Rule Content:
/**
 * @name SQLAlchemy Raw SQL Injection
 * @description Avoiding SQL string concatenation: untrusted input concatenated with raw
 * SQL query can result in SQL Injection. In order to execute raw query
 * safely, prepared statement should be used.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/sqlalchemy-execute-raw-query
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class SqlExecuteMethod extends DataFlow::Node {
  SqlExecuteMethod() { 
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getQualifier().getType().getASourceDeclaration().hasQualifiedName("sqlalchemy", "engine")
    )
  }
}

class StringConcatenation extends DataFlow::Node {
  StringConcatenation() {
    exists(BinaryOperation binop |
      binop.getOperator() = "+" and
      binop.getLeftOperand() instanceof DataFlow::Node and
      binop.getRightOperand() instanceof DataFlow::Node
    )
    or
    exists(Call call |
      call.getCalleeName().matches("%format") or
      call.getCalleeName().matches("%") or
      call.getCalleeName() = "f"
    )
  }
}

class SqlTextSanitizer extends DataFlow::Node {
  SqlTextSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "text" and
      ma.getQualifier().getType().getASourceDeclaration().hasQualifiedName("sqlalchemy", "sql")
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "SQLAlchemyRawSQLInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringConcatenation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteMethod and
    sink.asExpr() = any(SqlExecuteMethod sem).asExpr()
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SqlTextSanitizer
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Potential SQL injection vulnerability due to raw SQL string concatenation in sqlalchemy.execute()"
