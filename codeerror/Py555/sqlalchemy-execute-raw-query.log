Rule Content:
/**
 * @name SQLAlchemy Raw Query Execution with String Concatenation
 * @description Detects unsafe SQL string concatenation in SQLAlchemy execute() calls,
 *              which can lead to SQL injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id python/sqlalchemy-execute-raw-query
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

private class SqlConcatenation extends DataFlow::Node {
  SqlConcatenation() {
    exists(Call call |
      call.getTarget().toString().matches("%.execute(%.+(\\+|%|format|f\").+)") and
      this.asExpr() = call
    )
  }
}

private class SqlExecuteCall extends DataFlow::Node {
  SqlExecuteCall() {
    exists(Call call |
      call.getTarget().toString().matches("%.execute") and
      this.asExpr() = call.getArg(0)
    )
  }
}

private class PreparedStatementSanitizer extends DataFlow::BarrierGuard {
  PreparedStatementSanitizer() {
    exists(Call call |
      call.getTarget().toString().matches("%.text") and
      this.asExpr() = call
    )
  }
}

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlConcatenation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // String concatenation propagation
    exists(BinaryExpr bin |
      bin.getOperator() = "+" and
      (pred.asExpr() = bin.getLeft() and succ.asExpr() = bin) or
      (pred.asExpr() = bin.getRight() and succ.asExpr() = bin)
    )
  }
}

