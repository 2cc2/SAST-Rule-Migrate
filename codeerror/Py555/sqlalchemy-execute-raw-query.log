Rule Content:
/**
 * @name SQLAlchemy execute with raw query
 * @description Detects SQL injection vulnerabilities where untrusted input is concatenated with raw SQL queries
 * @kind path-problem
 * @problem.severity error
 * @id python/sqlalchemy-execute-raw-query
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class SqlStringConcatenation extends DataFlow::Expr {
  SqlStringConcatenation() {
    exists(BinaryOperation binop |
      binop.getOperator() = "+" or binop.getOperator() = "%" and
      binop.getLeftOperand().getType() = "str" and
      binop.getRightOperand().getType() = "str" and
      this = binop
    )
    or
    exists(StrFormat format |
      this = format
    )
  }
}

class SqlalchemyExecuteSink extends DataFlow::Node {
  SqlalchemyExecuteSink() {
    exists(Call call |
      call.getCallee().getQualifiedName() = "sqlalchemy.engine.Engine.execute" and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class SqlalchemyTextSanitizer extends DataFlow::Node {
  SqlalchemyTextSanitizer() {
    exists(Call call |
      call.getCallee().getQualifiedName() = "sqlalchemy.sql.expression.text" and
      this.asExpr() = call
    )
  }
}

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SQL Injection in SQLAlchemy" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlStringConcatenation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlalchemyExecuteSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SqlalchemyTextSanitizer
  }
}

from SqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. " +
  "In order to execute raw query safely, prepared statement should be used.",
  source, sink,
  "Potential SQL injection vulnerability"
