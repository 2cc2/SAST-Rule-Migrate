Rule Content:
/**
 * @name SQLAlchemy raw query execution with string concatenation
 * @description Avoiding SQL string concatenation: untrusted input concatenated with raw
 *              SQL query can result in SQL Injection. In order to execute raw query
 *              safely, prepared statement should be used.
 * @kind path-problem
 * @problem.severity error
 * @id python/sqlalchemy-execute-raw-query
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class SqlConcatSource extends TaintTracking::Source {
  SqlConcatSource() {
    exists(Python::BinaryOperation binop |
      binop.getOperator() = "+" or 
      binop.getOperator() = "%" or
      exists(string formattingMethod | formattingMethod = ["format", "f"] | 
        binop.getAnOperand().toString().matches("%%" + formattingMethod + "%%")
      )
    )
  }

  override predicate sinks(TaintTracking::SinkNode sink) { 
    sink instanceof SqlExecutionSink
  }
}

class SqlExecutionSink extends TaintTracking::Sink {
  SqlExecutionSink() {
    exists(Python::MethodAccess call |
      call.getTarget().getName() = "execute" and
      call.getReceiver().getType().getName() = "sqlalchemy"
    )
  }
}

class PreparedStatementSanitizer extends TaintTracking::Sanitizer {
  PreparedStatementSanitizer() {
    exists(Python::MethodAccess call |
      call.getTarget().getName() = "text" and
      call.getReceiver().getType().getName() = "sqlalchemy"
    )
  }
}

from SqlConcatSource source, SqlExecutionSink sink
where TaintTracking::localTaint(source, sink)
select sink, "Potential SQL injection from string concatenation in SQLAlchemy execute() call"
