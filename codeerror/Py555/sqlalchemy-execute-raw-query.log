Rule Content:
/**
 * @name SQLAlchemy raw query concatenation
 * @description Avoiding SQL string concatenation: untrusted input concatenated with raw
 *    SQL query can result in SQL Injection. In order to execute raw query
 *    safely, prepared statement should be used.
 * @kind path-problem
 * @problem.severity error
 * @id python/sqlalchemy-execute-raw-query
 */
import python
import semmle.python.DataFlow
import semmle.python.Concepts
import semmle.python.ApiGraphs

class SqlExecuteCall extends DataFlow::Node {
  SqlExecuteCall() {
    exists(MethodAccess ma |
      ma.getMethod().getName().toString() = "execute" and
      ma.getQualifier().getType().getName().toString() = "sqlalchemy" and
      this = ma.getAnArg()
    )
  }
}

class SqlStringConcatenation extends DataFlow::Node {
  SqlStringConcatenation() {
    exists(MethodAccess ma |
      this = ma.getAnArg() and
      ma.getMethod().getName().toString().regexpMatch(".*(\\+|%|format|f\").*") and
      ma.getQualifier().getType().getName().toString() = "str"
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName().toString() = "text" and
      ma.getQualifier().getType().getName().toString() = "sqlalchemy" and
      this = ma.getAnArg()
    )
  }
}

class SqlConcatConfig extends DataFlow::Configuration {
  SqlConcatConfig() { this = "SqlConcatConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlStringConcatenation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

from SqlConcatConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection due to string concatenation in SQLAlchemy execute()"
