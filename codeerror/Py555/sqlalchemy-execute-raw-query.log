Rule Content:
/**
 * @name sqlalchemy-execute-raw-query
 * @description Avoiding SQL string concatenation: untrusted input concatenated with
 *              raw SQL query can result in SQL Injection. In order to execute raw query
 *              safely, prepared statement should be used.
 * @kind path-problem
 * @problem.severity error
 * @id python/sql-injection/sqlalchemy-concatenation
 */

import python
import semmle.python.security.injection.SqlInjection
import semmle.python.ApiGraphs

class SqlalchemyExecuteMethod extends Method {
  SqlalchemyExecuteMethod() {
    this.getQualifiedName().matches("%.execute") and
    this.getAPICategory() = "sqlalchemy"
  }
}

class SqlStringConcatenation extends DataFlow::Node {
  SqlStringConcatenation() {
    exists(string op | op = "+" or op = "%" or op = "format" or op = "f\"" |
      this.asExpr().(BinaryOperation).getOp() = op or
      this.asExpr().(FormattedString)
    )
  }
}

class SqlalchemyTextSanitizer extends Method {
  SqlalchemyTextSanitizer() {
    this.getQualifiedName().matches("%.text") and
    this.getAPICategory() = "sqlalchemy"
  }
}

query predicate isSink(DataFlow::Node sink) {
  exists(SqlalchemyExecuteMethod execute |
    sink.asExpr() = execute.getACall().getArgument(0)
  )
}

query predicate isSource(DataFlow::Node source) {
  source.asExpr() instanceof SqlStringConcatenation
}

query predicate isSanitizer(DataFlow::Node sanitizer) {
  exists(SqlalchemyTextSanitizer text |
    sanitizer.asExpr() = text.getACall().getResult()
  )
}

from Configuration config, DataFlow::PathNode source, DataFlow::PathNode sink
where
  config.hasFlowPath(source, sink) and
  isSource(source.getNode()) and
  isSink(sink.getNode())
select sink.getNode(), source, sink,
  "Avoid SQL string concatenation as it may lead to SQL injection vulnerabilities. Use prepared statements instead."
