Rule Content:
/**
 * @name SQLAlchemy raw SQL execute with string concatenation
 * @description Avoiding SQL string concatenation: untrusted input concatenated with raw
 *              SQL query can result in SQL Injection. In order to execute raw query
 *              safely, prepared statement should be used.
 * @kind problem
 * @problem.severity error
 * @id python/sqlalchemy-execute-raw-query
 */

import python
import semmle.python.TaintTracking
import DataFlow::PathGraph

private class SqlConcatenation extends DataFlow::Node, TaintTracking::Source {
  SqlConcatenation() {
    exists(BinaryExpr bin |
      bin.getOp() = "+" or
      bin.getOp() = "%" or
      exists(ParenthesizedExpr pe | pe = bin.getOp())
      |
      bin.getAnOperand() = this.asExpr()
    )
  }

  override predicate isSource(DataFlow::Node source) { this = source }

  predicate asCfgNode() { none() }
  Location getLocation() { this.asExpr().getLocation() }
  predicate getBasicBlock() { none() }
  string toString() { result = this.asExpr().toString() }
  predicate getScope() { this.asExpr().getScope() }
  predicate asVariable() { none() }
}

private class SqlExecuteCall extends DataFlow::Node, TaintTracking::Sink {
  SqlExecuteCall() {
    exists(Call call |
      call.getCallable().getName() = "execute" and
      call.getCallable().getBoundReceiverTypeRef().toString() = "sqlalchemy"
    )
  }

  override predicate isSink(DataFlow::Node sink) { this = sink }

  predicate asCfgNode() { none() }
  Location getLocation() { this.asExpr().getLocation() }
  predicate getBasicBlock() { none() }
  string toString() { result = this.asExpr().toString() }
  predicate getScope() { this.asExpr().getScope() }
  predicate asVariable() { none() }
}

private class PreparedStatementSanitizer extends TaintTracking::Sanitizer {
  PreparedStatementSanitizer() {
    exists(Call call |
      call.getCallable().getName() = "text" and
      call.getCallable().getBoundReceiverTypeRef().toString() = "sqlalchemy"
    )
  }

  override predicate isSanitizer(DataFlow::Node node) { this = node }
}

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlConcatenation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteCall
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof PreparedStatementSanitizer
  }
}

