Rule Content:
/**
 * @name SQL Injection in SQLAlchemy raw query
 * @description Avoiding SQL string concatenation: untrusted input concatenated with raw
 *              SQL query can result in SQL Injection. Use prepared statements instead.
 * @kind path-problem
 * @problem.severity error
 * @id python/sql-injection-sqlalchemy
 */

import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts

class SqlConcatSource extends TaintTracking::TaintSource {
  SqlConcatSource() {
    exists(Call call |
      call.getTarget().hasName("execute") and
      call.getAnArg().toString().regexpMatches(".*(\\+|%|format|f\").*")
    )
  }

  override predicate isSourceOf(TaintKind kind) { kind = TaintKind::SQL() }
}

class SqlExecutionSink extends TaintTracking::TaintSink {
  SqlExecutionSink() {
    exists(Call call |
      call.getTarget().hasName("execute") and
      call.getReceiverType().getName() = "sqlalchemy.engine.base.Engine" and
      this = call.getArg(0)
    )
  }

  override predicate makesSink(TaintKind kind) { kind = TaintKind::SQL() }
}

class PreparedStatementSanitizer extends TaintTracking::Sanitizer {
  PreparedStatementSanitizer() {
    exists(CallExpr call |
      call.getTarget().hasName("text") and
      call.getReceiverType().getName().matches("sqlalchemy.sql.%") and
      this = call
    )
  }

  override predicate hasSanitizer(TaintKind kind) { kind = TaintKind::SQL() }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "SQLAlchemy raw query configuration" }

  override predicate isSource(DataFlow::Node source) { source instanceof SqlConcatSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecutionSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

from Config cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential SQL injection from string concatenation in raw SQL query"
