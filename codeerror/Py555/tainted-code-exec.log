Rule Content:
/**
 * @name Tainted code execution via eval/exec
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic 
 *              content. If this content can be input from outside the program, this may be a code 
 *              injection vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-code-exec
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow

class EventParam extends DataFlow::ParameterNode {
  EventParam() {
    exists(Function f, Parameter p |
      f.getName() = "event" and
      p = f.getAParameter(_) and
      this = p
    )
  }
}

class EvalExecCall extends DataFlow::Node {
  EvalExecCall() {
    exists(Call call |
      call.getFunc().(Name).getId() = ["eval", "exec"] and
      this = call.getArg(0)
    )
  }
}

class TaintedCodeExecConfig extends TaintTracking::Configuration {
  TaintedCodeExecConfig() { this = "TaintedCodeExecConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalExecCall
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedCodeExecConfig conf
where conf.hasFlowPath(source, sink)
select sink, source, sink, "Dynamic code evaluation from unsafe input to $@.", 
  source.getNode(), "user input"
