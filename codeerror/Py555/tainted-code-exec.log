Rule Content:
/**
 * @name Tainted code execution
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic content.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id python/tainted-code-exec
 */

import python
import DataFlow
import TaintTracking
import semmle.python.ApiGraphs

class EventParam extends TaintTracking::TaintSource {
  EventParam() {
    exists(Function f, Parameter p |
      f.getParameter(p) and
      p.getName() = "event" and
      this.asParameterNode() = p
    )
  }

  override predicate isSource(TaintSource source) { this = source }

  /* Implementing DataFlow::Node abstract methods */
  DataFlow::CfgNode asCfgNode() { result = this.asParameterNode().getFunction().getBody() }
  Location getLocation() { result = this.asParameterNode().getLocation() }
  DataFlow::BasicBlock getBasicBlock() { result = this.asParameterNode().getBasicBlock() }
  string toString() { result = "Event parameter '" + this.asParameterNode().getName() + "'" }
  DataFlow::Scope getScope() { result = this.asParameterNode().getScope() }
  Variable asVariable() { result = this.asParameterNode().asVariable() }
}

class EvalExec extends TaintTracking::TaintSink {
  EvalExec() {
    exists(Call call, Name name |
      call.getFunc() = name and
      name.getId() = ["eval", "exec"] and
      this.asExprNode() = call.getArg(0)
    )
  }

  override predicate isSink(TaintSink sink) { this = sink }

  /* Implementing DataFlow::Node abstract methods */
  DataFlow::CfgNode asCfgNode() { result = this.asExprNode().getParent().getParent+() }
  Location getLocation() { result = this.asExprNode().getLocation() }
  DataFlow::BasicBlock getBasicBlock() { result = this.asExprNode().getBasicBlock() }
  string toString() { result = "Eval/exec call argument" }
  DataFlow::Scope getScope() { result = this.asExprNode().getScope() }
  Variable asVariable() { result = this.asExprNode().asVariable() }
}

class TaintedCodeExecutionConfig extends TaintTracking::Configuration {
  TaintedCodeExecutionConfig() { this = "TaintedCodeExecutionConfig" }

  override predicate isSource(TaintSource source) {
    source instanceof EventParam
  }

  override predicate isSink(TaintSink sink) {
    sink instanceof EvalExec
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Parameter p, Argument arg |
      node1.asParameterNode() = p and
      node2.asArgumentNode() = arg and
      DataFlow::localFlow(arg, p)
    )
  }
}

from TaintedCodeExecutionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected the use of $@. This can be dangerous if used to evaluate dynamic content.",
  sink.getNode(), "eval/exec call"
