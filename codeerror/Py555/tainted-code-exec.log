Rule Content:
/**
 * @name Dangerous use of exec/eval
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate 
 * dynamic content. If this content can be input from outside the program, this may be 
 * a code injection vulnerability. Ensure evaluated content is not definable by external sources.
 * @kind path-problem
 * @problem.severity warning
 * @id py/unsafe-code-execution
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class EventParam extends DataFlow::Node, TaintTracking::TaintSource {
  EventParam() {
    exists(Function f, Parameter p |
      f.getName() = "event" and
      p = f.getAParameter() and
      this.asParameter() = p
    )
  }

  override predicate isSourceOf(TaintKind kind) { kind = TaintKind::execEvalTaint() }
}

class EvalExecCall extends DataFlow::Node, TaintTracking::TaintSink {
  EvalExecCall() {
    exists(Call call, Name name |
      call.getTarget() = name and
      name.getId() = ["eval", "exec"].getAValue() and
      this = call.getArgument(0)
    )
  }

  override predicate isSinkOf(TaintKind kind) { kind = TaintKind::execEvalTaint() }
}

class TaintedCodeExecFlowConfiguration extends TaintTracking::Configuration {
  TaintedCodeExecFlowConfiguration() { this = "TaintedCodeExecFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventParam }

  override predicate isSink(DataFlow::Node sink) { sink instanceof EvalExecCall }
}

from TaintedCodeExecFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential code injection vulnerability from $@ to $@.", source, source.toString(), 
  sink, "evaluated code"
