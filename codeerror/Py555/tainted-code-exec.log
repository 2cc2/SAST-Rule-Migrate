Rule Content:
/**
 * @name Tainted code execution via eval/exec
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic content.
 *              If this content can be input from outside the program, this may be a code injection vulnerability.
 *              Ensure evaluated content is not definable by external sources.
 * @kind path-problem
 * @id py/tainted-code-exec
 * @problem.severity warning
 */

import python
import semmle.python.security.strings.CodeExecution
import semmle.python.dataflow.TaintTracking

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(FunctionValue f, Parameter p |
      f.getAParameter() = p and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class EvalExecCall extends DataFlow::Node {
  EvalExecCall() {
    exists(CallNode call |
      call.getCalleeName().matches("eval|exec") and
      call.getArgument(0) = this.asExpr()
    )
  }
}

class TaintedCodeExecFlowConfiguration extends TaintTracking::Configuration {
  TaintedCodeExecFlowConfiguration() {
    this = "TaintedCodeExecFlowConfiguration"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalExecCall
  }
}

from TaintedCodeExecFlowConfiguration config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, 
  "Potential code injection vulnerability from event parameter to eval/exec call. Dynamic code execution " +
  "with user-controlled input may lead to security issues."
