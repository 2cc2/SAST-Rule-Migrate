Rule Content:
/**
 * @name Tainted Code Execution via exec/eval
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic content.
 *              If this content can be input from outside the program, this may be a code injection vulnerability.
 *              Ensure evaluated content is not definable by external sources.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-code-exec
 * @tags security
 *       external/cwe/cwe-094
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(FunctionValue f, Parameter p |
      f.getAParameter() = p and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class EvalExec extends DataFlow::Node {
  EvalExec() {
    exists(Call call |
      call.getFunc().(Name).getId() = ["eval", "exec"] and
      this.asExpr() = call.getArg(0)
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "TaintedCodeExecution" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalExec
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
      param.asDefiningArgument() = arg and
      node1.asParameter() = param and
      node2.asArgument() = arg
    )
  }
}

from TaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential code injection vulnerability: Unsafe use of exec/eval with parameter '$@' that may be tainted from external input.",
  source.getNode(), "event parameter"
