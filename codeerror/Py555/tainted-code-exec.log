Rule Content:
/**
 * @name Tainted Code Execution
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic content.
 *              If this content can be input from outside the program, this may be a code injection vulnerability.
 *              Ensure evaluated content is not definable by external sources.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-code-exec
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(FunctionValue f, Parameter p |
      p = f.getAParameter() and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class EvalExecSink extends DataFlow::Node {
  EvalExecSink() {
    exists(CallNode call |
      call.getFunction().getName().matches("eval|exec") and
      this = call.getArg(0)
    )
  }
}

class TaintedFlowConfig extends TaintTracking::Configuration {
  TaintedFlowConfig() { this = "TaintedCodeExecution" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventParam }

  override predicate isSink(DataFlow::Node sink) { sink instanceof EvalExecSink }

  override predicate isSanitizer(DataFlow::Node node) { none() }
}

from TaintedFlowConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential code injection: $@ flows from event parameter to eval/exec call.",
  source.getNode(), "user-provided value",
  sink.getNode(), "call to eval/exec"
