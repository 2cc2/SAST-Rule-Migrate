Rule Content:
/**
 * @name Tainted code execution
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic 
 * content. If this content can be input from outside the program, this may be a code injection
 * vulnerability. Ensure evaluated content is not definable by external sources.
 * @kind path-problem
 * @problem.severity warning
 * @id python/security/tainted-code-exec
 */

import python
import DataFlow::PathGraph
import DataFlow::Configuration
import TaintTracking

class EventParam extends DataFlow::Configuration::Parameter {
  EventParam() { 
    hasName(this, "event") 
  }
}

class EvalExecCall extends DataFlow::CallNode {
  EvalExecCall() {
    exists(string name | 
      name = this.getTarget().getName() |
      name.matches("%eval%") or name.matches("%exec%")
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TaintedCodeExecution" }

  override predicate isSource(DataFlow::Node source) {
    source.asParameter() instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asExpr() = any(EvalExecCall e | e.getArgument(0))
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, Config conf
where conf.hasFlowPath(source, sink)
select sink, "Potential tainted code execution. Ensure this eval/exec content is safe.", 
  source, "Untrusted input from event parameter"
