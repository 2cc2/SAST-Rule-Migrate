/**
 * @name Tainted code execution via exec/eval
 * @description Detects the use of `exec/eval` with potentially tainted input from an event parameter.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-code-exec
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class EventParam extends DataFlow::ParameterNode {
  EventParam() {
    this.getParameter().getName() = "event"
  }
}

class EvalExecCall extends DataFlow::CallNode {
  EvalExecCall() {
    this.getTarget().getName() = ["eval", "exec"].getAValue() and
    regexMatches("eval|exec", this.getTarget().getName())
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TaintedCodeExecutionConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof EventParam
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(EvalExecCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    none()
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  source, 
  "Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic content. " +
  "If this content can be input from outside the program, this may be a code injection vulnerability. " +
  "Ensure evaluated content is not definable by external sources."
