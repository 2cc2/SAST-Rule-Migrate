Rule Content:
/**
 * @name Tainted Code Execution via eval/exec
 * @description Detection of potentially dangerous usage of eval/exec functions.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-code-exec
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class EvalExecCall extends DataFlow::Call {
  EvalExecCall() {
    exists(string funcName | 
      this.getTarget().(FunctionValue).getBaseName() = funcName and
      regexpMatch(funcName, "^(eval|exec)$")
    )
  }
}

class EventParamSource extends DataFlow::Parameter {
  EventParamSource() {
    this.getName() = "event"
  }
}

class TaintedEvalExecConfig extends TaintTracking::Configuration {
  TaintedEvalExecConfig() {
    this = "Tainted eval/exec Configuration"
  }

  override predicate isSource(DataFlow::Node source) {
    source.asParameter() instanceof EventParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(EvalExecCall call |
      call.getAnArgument() = sink.asExpr()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedEvalExecConfig conf
where conf.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected the use of $@. This can be dangerous if used to evaluate dynamic content. " +
  "If this content can be input from outside the program, this may be a code injection vulnerability. " +
  "Ensure evaluated content is not definable by external sources.",
  source.getNode(), "user-provided event parameter",
  sink.getNode(), "eval/exec call"
