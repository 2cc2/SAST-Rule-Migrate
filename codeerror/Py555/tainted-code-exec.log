Rule Content:
/**
 * @name Tainted code execution
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic content.
 * @id python/tainted-code-exec
 * @kind path-problem
 * @problem.severity warning
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class EventParam extends DataFlow::ParameterNode {
  EventParam() {
    this.getParameter().getName() = "event"
  }

  override predicate isSource(TaintTracking::TaintSource source) {
    source = this
  }
}

class EvalExecSink extends DataFlow::Node {
  EvalExecSink() {
    exists(Call call |
      call.getCallee().getName() in ["eval", "exec"] and
      this.asExpr() = call.getArg(0)
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink = this
  }
}

class TaintedCodeExecConfig extends TaintTracking::Configuration {
  TaintedCodeExecConfig() { this = "TaintedCodeExecConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof EventParam
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof EvalExecSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    none()
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  any(TaintedCodeExecConfig conf).hasFlowPath(source, sink)
select sink, "Potential code injection vulnerability from eval/exec call", source,
  "User-controlled input flows to eval/exec call"
