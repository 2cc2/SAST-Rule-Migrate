Rule Content:
/**
 * @name Tainted HTML String Construction
 * @description Detected user input flowing into a manually constructed HTML string.
 * @kind problem
 * @severity warning
 * @id python/security/tainted-html-string
 */

import python
import semmle.python.ApiGraphs
import DataFlow
import DataFlow::PathGraph
import TaintTracking

class HtmlStringConstruction extends DataFlow::Node {
  HtmlStringConstruction() {
    exists(DataFlow::StrFormatOperation formatOp |
      this = formatOp.getTarget() and
      (
        formatOp instanceof PercentFormatOperation or
        formatOp instanceof DotFormatOperation or
        formatOp instanceof PlusFormatOperation or
        formatOp instanceof FStrFormatOperation
      )
    )
  }
}

class EventParameter extends DataFlow::Node {
  EventParameter() {
    exists(Method method |
      this = method.getAParameter() and
      this.hasName("event")
    )
  }
}

class SanitizerPrint extends DataFlow::Node {
  SanitizerPrint() {
    exists(Call call |
      call = this.asExpr().(Call) and
      call.getTarget().getName() = "print"
    )
  }
}

predicate isSource(DataFlow::Node source) {
  source instanceof EventParameter
}

predicate isSink(DataFlow::Node sink) {
  sink instanceof HtmlStringConstruction
}

predicate isSanitizer(DataFlow::Node sanitizer) {
  sanitizer instanceof SanitizerPrint
}

module TaintConfig implements TaintTracking::Configuration {
  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlStringConstruction
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SanitizerPrint
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), "Detected user input flowing into a manually constructed HTML string. " +
  "You may be accidentally bypassing secure methods of rendering HTML by manually " +
  "constructing HTML and this could create a cross-site scripting vulnerability, " +
  "which could let attackers steal sensitive user data. To be sure this is safe, " +
  "check that the HTML is rendered safely. Otherwise, use templates which will " +
  "safely render HTML instead."
