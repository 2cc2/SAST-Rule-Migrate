/**
 * @name Tainted HTML string construction
 * @description Detected user input flowing into manually constructed HTML string.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-string
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.Strings

class EventParam extends DataFlow::ParameterNode {
  EventParam() {
    this.getName() = "event"
  }
}

class HtmlConstruction extends DataFlow::ExprNode {
  HtmlConstruction() {
    exists(StrFormat fmt | this = fmt.getAnOutput() |
      fmt.getAPrimaryQlClass() instanceof StrInterpolation
    )
    or
    exists(StrConcat concat | this = concat.getAnOperand() |
      concat.getParent() instanceof StrInterpolation
    )
  }
}

class Sanitizer extends DataFlow::Node {
  Sanitizer() {
    exists(Call call | this = call.getFunction() |
      call.getFuncDisplayName() = "print"
    )
  }
}

class TaintedHtmlFlowConfiguration extends TaintTracking::Configuration {
  TaintedHtmlFlowConfiguration() { this = "TaintedHtmlFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlConstruction
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof Sanitizer
  }
}

from TaintedHtmlFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user input flowing into a manually constructed HTML string. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability, which could let attackers steal sensitive user data. To be sure this is safe, check that the HTML is rendered safely. Otherwise, use templates which will safely render HTML instead."
