Rule Content:
/** 
 * @name Tainted HTML String Detection
 * @description Detects user input flowing into manually constructed HTML strings potentially creating XSS vulnerabilities
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-string
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow
import DataFlow::PathGraph

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(Function f, Parameter p |
      f.getAParameter() = p and
      p = this.asParameter() and
      p.getName() = "event"
    )
  }
}

class HtmlConstructionSink extends DataFlow::Node {
  HtmlConstructionSink() {
    exists(Call c |
      c.getPattern().regexpMatch("^\"\\$HTMLSTR\" % .*|^\"\\$HTMLSTR\"\\.format\\(.*|^\"\\$HTMLSTR\" \\+ .*|^f\"\\$HTMLSTR\\{.*\\}.*") and
      c = this.asExpr()
    )
  }
}

class PrintSanitizer extends DataFlow::Node {
  PrintSanitizer() {
    exists(Call c |
      c.getTarget().getName() = "print" and
      c = this.asExpr()
    )
  }
}

class TaintedHtmlConfiguration extends TaintTracking::Configuration {
  TaintedHtmlConfiguration() { this = "TaintedHtmlConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlConstructionSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PrintSanitizer
  }
}

from TaintedHtmlConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected user input flowing into a manually constructed HTML string. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability, which could let attackers steal sensitive user data.",
  source, sink,
  "To be sure this is safe, check that the HTML is rendered safely. Otherwise, use templates which will safely render HTML instead."
