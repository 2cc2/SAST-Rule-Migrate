Rule Content:
/**
 * @name Tainted HTML String
 * @description Detected user input flowing into a manually constructed HTML string.
 * @id tainted-html-string
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 */
import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class EventParam extends TaintTracking::TaintSource {
  EventParam() {
    exists(Parameter p |
      p.getAParameterName() = "event"
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      p.getName() = "event" and
      source.asParameter() = p
    )
  }

  override DataFlow::Node getCfgNode() { result = this.asParameter().getAnAncestor() }
  override Location getLocation() { result = this.asParameter().getLocation() }
  override string toString() { result = "Event parameter source" }
  override BasicBlock getBasicBlock() { result = this.asParameter().getBasicBlock() }
  override DataFlow::Scope getScope() { result = this.asParameter().getScope() }
  override Variable getVariable() { result = this.asParameter().getVariable() }
}

class HtmlConstructionSink extends TaintTracking::TaintSink {
  HtmlConstructionSink() {}

  override predicate isSink(DataFlow::Node sink) {
    exists(Call c, string pattern |
      pattern = "^\"\\$HTMLSTR\" % .*|^\"\\$HTMLSTR\"\\.format\\(.*|^\"\\$HTMLSTR\" \\+ .*|^f\"\\$HTMLSTR\\{.*\\}.*\"" and
      c.getCode().regexpMatch(pattern) and
      sink.asExpr() = c
    )
  }

  override DataFlow::Node getCfgNode() { result = this.asExpr().getAnAncestor() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override string toString() { result = "HTML construction sink" }
  override BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }
  override Variable getVariable() { result = this.asExpr().getVariable() }
}

class PrintSanitizer extends TaintTracking::Sanitizer {
  PrintSanitizer() {}

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call c |
      c.getTarget().hasQualifiedName("print") and
      sanitizer.asExpr() = c
    )
  }

  override DataFlow::Node getCfgNode() { result = this.asExpr().getAnAncestor() }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override string toString() { result = "Print sanitizer" }
  override BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }
  override Variable getVariable() { result = this.asExpr().getVariable() }
}

class TaintedHtmlStringConfig extends TaintTracking::Configuration {
  TaintedHtmlStringConfig() { this = "TaintedHtmlStringConfig" }

  override predicate isSource(TaintTracking::TaintSource source) { source instanceof EventParam }

  override predicate isSink(TaintTracking::TaintSink sink) { sink instanceof HtmlConstructionSink }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) { sanitizer instanceof PrintSanitizer }

  override predicate isAdditionalTaintStep(TaintTracking::TaintFlow step) {
    exists(ParameterNode p, ArgNode a |
      step.getFromNode() = a and
      step.getToNode() = p and
      a.getParentCall() = p.getParentCall()
    )
  }
}

from TaintedHtmlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected user input flowing into a manually constructed HTML string. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability, which could let attackers steal sensitive user data. To be sure this is safe, check that the HTML is rendered safely. Otherwise, use templates which will safely render HTML instead."
