Rule Content:
/**
 * @name Tainted Html String
 * @description Detected user input flowing into a manually constructed HTML string. 
 *              You may be accidentally bypassing secure methods of rendering HTML by 
 *              manually constructing HTML and this could create a cross-site scripting 
 *              vulnerability. To be sure this is safe, check that the HTML is rendered 
 *              safely. Otherwise, use templates which will safely render HTML instead.
 * @id tainted-html-string
 * @kind path-problem
 * @problem.severity warning
 */

import python
import semmle.python.security.strings.TaintedString
import semmle.python.Concepts
import DataFlow::PathGraph

class HtmlStringConstruction extends DataFlow::CallNode {
  HtmlStringConstruction() {
    exists(string formatOp |
      // Matches various string formatting patterns that could construct HTML
      formatOp.regexpMatch("^\"\\$HTMLSTR\" % .*") or
      formatOp.regexpMatch("^\"\\$HTMLSTR\"\\.format\\(.*") or
      formatOp.regexpMatch("^\"\\$HTMLSTR\" \\+ .*") or
      formatOp.regexpMatch("^f\"\\$HTMLSTR\\{.*\\}.*\"")
    )
  }
}

class EventParameter extends DataFlow::ParameterNode {
  EventParameter() { this.getName() = "event" }
}

class SanitizerPrint extends DataFlow::CallNode {
  SanitizerPrint() { this.getTarget().getName() = "print" }
}

predicate isSource(DataFlow::Node source) { source instanceof EventParameter }

predicate isSink(DataFlow::Node sink) { sink instanceof HtmlStringConstruction }

predicate isSanitizer(DataFlow::Node sanitizer) {
  sanitizer instanceof SanitizerPrint
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(DataFlow::PathNode sanitizer |
    DataFlow::localFlow(source, sink) and
    TaintTracking::localTaint(source, sink) and
    isSanitizer(sanitizer.getNode()) and
    not DataFlow::localFlow(source, sanitizer)
  )
select sink, "Potential XSS vulnerability: user input flows into manually constructed HTML string", 
  source, "User input from event parameter"
