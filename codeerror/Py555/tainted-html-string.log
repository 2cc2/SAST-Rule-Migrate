/**
 * @name Tainted HTML string construction
 * @description Detected user input flowing into a manually constructed HTML string.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-string
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

private class EventParameter extends TaintTracking::Source {
  EventParameter() {
    exists(string paramName |
      paramName = this.asParameterNode().getName() and
      paramName.regexpMatch("event")
    )
  }

  override predicate isSource(DataFlow::Node source) { this = source }

  override predicate asCfgNode() { this.asParameterNode().asCfgNode() }
  override predicate getLocation() { this.asParameterNode().getLocation() }
  override predicate getBasicBlock() { this.asParameterNode().getBasicBlock() }
  override predicate toString() { this.asParameterNode().toString() }
  override predicate getScope() { this.asParameterNode().getScope() }
  override predicate asVariable() { this.asParameterNode().asVariable() }
}

private class HtmlConstructionSink extends TaintTracking::Sink {
  HtmlConstructionSink() {
    exists(string code |
      code = this.(DataFlow::ExpressionNode).getExpr().toString() and
      (
        code.regexpMatch("^\"\\$HTMLSTR\" % .*") or
        code.regexpMatch("^\"\\$HTMLSTR\"\\.format\\(.*") or
        code.regexpMatch("^\"\\$HTMLSTR\" \\+ .*") or
        code.regexpMatch("^f\"\\$HTMLSTR\\{.*\\}.*\"")
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) { this = sink }

  override predicate asCfgNode() { this.(DataFlow::ExpressionNode).asCfgNode() }
  override predicate getLocation() { this.(DataFlow::ExpressionNode).getLocation() }
  override predicate getBasicBlock() { this.(DataFlow::ExpressionNode).getBasicBlock() }
  override predicate toString() { this.(DataFlow::ExpressionNode).toString() }
  override predicate getScope() { this.(DataFlow::ExpressionNode).getScope() }
  override predicate asVariable() { this.(DataFlow::ExpressionNode).asVariable() }
}

private class PrintSanitizer extends TaintTracking::Sanitizer {
  PrintSanitizer() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "print" and
      this = mc.(DataFlow::Node)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { this = sanitizer }

  override predicate asCfgNode() { this.(DataFlow::ExpressionNode).asCfgNode() }
  override predicate getLocation() { this.(DataFlow::ExpressionNode).getLocation() }
  override predicate getBasicBlock() { this.(DataFlow::ExpressionNode).getBasicBlock() }
  override predicate toString() { this.(DataFlow::ExpressionNode).toString() }
  override predicate getScope() { this.(DataFlow::ExpressionNode).getScope() }
  override predicate asVariable() { this.(DataFlow::ExpressionNode).asVariable() }
}

query predicate isSource(TaintTracking::Source node) { node instanceof EventParameter }
query predicate isSink(TaintTracking::Sink node) { node instanceof HtmlConstructionSink }
query predicate isSanitizer(TaintTracking::Sanitizer node) { node instanceof PrintSanitizer }

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(EventParameter ep | ep = source.getNode() and
  exists(HtmlConstructionSink hcs | hcs = sink.getNode())) and
  TaintTracking::localTaint(DataFlow::parameterNode(source), DataFlow::exprNode(sink))
select sink.getNode(), source, sink,
  "Detected user input flowing into a manually constructed HTML string. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability, which could let attackers steal sensitive user data. To be sure this is safe, check that the HTML is rendered safely. Otherwise, use templates which will safely render HTML instead."
