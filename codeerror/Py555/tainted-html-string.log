Rule Content:
/**
 * @name Tainted HTML String Construction
 * @description Detected user input flowing into a manually constructed HTML string.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-string
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class EventParameter extends DataFlow::Node {
  EventParameter() {
    exists(Parameter p |
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class HtmlConstructionSink extends DataFlow::Node {
  HtmlConstructionSink() {
    exists(string htmlstr |
      (
        getCode().regexpMatch("^\"\\$HTMLSTR\" % .*") or
        getCode().regexpMatch("^\"\\$HTMLSTR\"\\.format\\(.*") or
        getCode().regexpMatch("^\"\\$HTMLSTR\" \\+ .*") or
        getCode().regexpMatch("^f\"\\$HTMLSTR\\{.*\\}.*\"")
      ) and
      this.asExpr().getType().getName() = "HTML"
    )
  }
}

class PrintSanitizer extends DataFlow::Node {
  PrintSanitizer() {
    exists(Call call |
      call.getFunc().(Name).getId() = "print" and
      this.asExpr() = call
    )
  }
}

class TaintedHtmlConfig extends TaintTracking::Configuration {
  TaintedHtmlConfig() { this = "TaintedHtmlConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlConstructionSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PrintSanitizer
  }
}

from TaintedHtmlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected user input flowing into a manually constructed HTML string. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability, which could let attackers steal sensitive user data. To be sure this is safe, check that the HTML is rendered safely. Otherwise, use templates which will safely render HTML instead."
