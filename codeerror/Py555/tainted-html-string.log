Rule Content:
/**
 * @name Tainted HTML String
 * @description Detected user input flowing into a manually constructed HTML string.
 * @kind problem
 * @problem.severity warning
 * @id python/tainted-html-string
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class EventParam extends DataFlow::ParameterNode {
  EventParam() {
    this.getText() = "event"
  }
}

class HtmlConstruction extends DataFlow::ExprNode {
  HtmlConstruction() {
    exists(StrFormat fmt |
      this = fmt.getAnOperand() |
      fmt.getFormatString().getText().matches("%.*HTMLSTR.*")
    )
    or
    exists(StrConcat cat |
      this = cat.getAnOperand() |
      cat.getLeftOperand().getText().matches(".*HTMLSTR.*") or
      cat.getRightOperand().getText().matches(".*HTMLSTR.*")
    )
    or
    exists(StrFormat fmt |
      this = fmt.getAQlClass() |
      fmt.getFormatString().getText().matches(".*\{.*HTMLSTR.*\}.*")
    )
  }
}

class PrintSanitizer extends TaintTracking::Sanitizer {
  PrintSanitizer() {
    exists(Call printCall |
      printCall.getCalledMember().getName() = "print" |
      this = printCall.getAChild()
    )
  }
}

class TaintedHtmlConfiguration extends TaintTracking::Configuration {
  TaintedHtmlConfiguration() {
    this = "TaintedHtmlConfiguration"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlConstruction
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof PrintSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where any(TaintedHtmlConfiguration cfg).hasFlowPath(source, sink)
select sink, "Detected user input flowing into a manually constructed HTML string. " +
  "You may be accidentally bypassing secure methods of rendering HTML by manually " +
  "constructing HTML and this could create a cross-site scripting vulnerability."
