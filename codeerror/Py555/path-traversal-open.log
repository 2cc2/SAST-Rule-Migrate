Rule Content:
/**
 * @name Path Traversal in open() call
 * @description Found request data in a call to 'open'. Ensure the request data is validated 
 * or sanitized, otherwise it could result in path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.ApiGraphs

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall mc |
      mc.getMethod().getName() in ["get", "__getitem__"] and
      (
        mc.getQualifier().getType().getName() = "request" and
        mc.getQualifier().getQualifier().getType().getName() = "flask" or
        mc.getQualifier().getName() = "request" and
        mc.getQualifier().getQualifier().getName() = "flask"
      )
    ) and
    this.asExpr() = mc
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      regexpMatches(p.getName(), "(ROUTEVAR|INTERM)") and
      this.asParameter() = p
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "open" and
      (
        mc.getQualifier().getType().getName() = "builtins" or
        mc.getQualifier() instanceof BuiltinClass
      ) and
      this.asExpr() = mc
    )
  }
}

module TaintFlow = TaintTracking::Global<FlaskRequestSource, OpenSink>;
module RouteFlow = TaintTracking::Global<RouteParamSource, OpenSink>;

from TaintFlow::PathNode source, TaintFlow::PathNode sink
where TaintFlow::flow(source, sink)
select sink.getNode(), source, sink, "Potential path traversal via flask.request data in open()"

from RouteFlow::PathNode source, RouteFlow::PathNode sink
where RouteFlow::flow(source, sink)
select sink.getNode(), source, sink, "Potential path traversal via route parameter in open()"
