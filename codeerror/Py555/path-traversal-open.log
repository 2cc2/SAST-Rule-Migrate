Rule Content:
/**
 * @name Path traversal in open() call
 * @description Detects path traversal vulnerabilities when unsanitized request data is used in open() calls
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */
import semmle.python.dataflow.DataFlow
import semmle.python.web.Flask
import semmle.python.security.dataflow.RemoteFlowSource

/** The request parameter coming from Flask request object */
class FlaskRequestSource extends RemoteFlowSource {
  FlaskRequestSource() {
    exists(Method call, Method accessMethod |
      call.getTarget().hasQualifiedName("flask.request", "*") and
      accessMethod.getQualifiedName() in [
        "flask.request.args.get",
        "flask.request.args.__getitem__",
        "flask.request.form.get",
        "flask.request.form.__getitem__"
      ] and
      call.getAChildExpr() = accessMethod and
      accessMethod = this.asExpr()
    )
  }
}

/** The route parameter source */
class RouteParamSource extends RemoteFlowSource {
  RouteParamSource() {
    exists(Parameter p |
      p.getType().getName().matches("%ROUTEVAR%|%INTERM%") and
      p = this.asParameter()
    )
  }
}

/** The open() sink */
class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(Method open |
      open.hasQualifiedName("builtins", "open") and
      this.asExpr().(Call).getTarget() = open
    )
  }
}

from FlaskRequestSource source, OpenSink sink
where DataFlow::flow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."

from RouteParamSource source, OpenSink sink
where DataFlow::flow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
