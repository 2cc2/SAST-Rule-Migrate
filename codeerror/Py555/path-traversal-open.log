Rule Content:
/**
 * @name Path Traversal via Flask Request to open()
 * @description Detects path traversal vulnerabilities when Flask request parameter flows to open() call
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal/open-flask
 */

import python
import codeql.python.security.dataflow.TaintTracking
import codeql.python.web.Flask
import DataFlow::PathGraph

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      (ma.getMethodQualifiedName().matches("flask.request.args.get") or
       ma.getMethodQualifiedName().matches("flask.request.args.__getitem__") or
       ma.getMethodQualifiedName().matches("flask.request.form.get") or
       ma.getMethodQualifiedName().matches("flask.request.form.__getitem__")) and
      this.asSource(ma)
    )
    or
    exists(Parameter p |
      p.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this.asSource(p)
    )
  }
}

class OpenSink extends TaintTracking::Sink {
  OpenSink() {
    exists(Call call |
      call.getCalleeName() = "open" and
      call.getCallee().getLocation().getFile().getName() = "builtins" and
      this.asSink(call.getArg(0))
    )
  }
}

class FlaskPathTraversalConfiguration extends TaintTracking::Configuration {
  FlaskPathTraversalConfiguration() { this = "Flask path traversal to open()" }

  override predicate isSource(DataFlow::Node source) { any(FlaskRequestSource f).isSource(source) }

  override predicate isSink(DataFlow::Node sink) { any(OpenSink o).isSink(sink) }
}

from FlaskPathTraversalConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
