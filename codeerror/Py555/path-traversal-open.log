/**
 * @name Path Traversal via Flask Request to File Open
 * @description Detects when Flask request data flows to a file open operation without sanitization
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import semmle.python.ApiGraphs
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class FlaskRequestSource extends RemoteFlowSource {
  FlaskRequestSource() {
    exists(CallNode call, ApiGraphs::FunctionNode func |
      call.getFunc() = func and
      func.getQualifiedName() in [
        "flask.request.args.get",
        "flask.request.args.__getitem__",
        "flask.request.form.get",
        "flask.request.form.__getitem__"
      ]
    )
  }

  override predicate isSource(DataFlow::Node source) { source = this }
}

class RouteParamSource extends RemoteFlowSource {
  RouteParamSource() {
    exists(ParameterNode p |
      p.getType().toString().matches("%ROUTEVAR%|%INTERM%") and
      this.asParameter() = p
    )
  }

  override predicate isSource(DataFlow::Node source) { source = this }
}

class OpenSink extends RemoteFlowSink {
  OpenSink() {
    exists(CallNode call |
      call.getFunc().getName() = "open" and
      this.asExpr() = call
    )
  }

  override predicate isSink(DataFlow::Node sink) { sink = this }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof OpenSink
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks.", 
  source, "User input flows here"
