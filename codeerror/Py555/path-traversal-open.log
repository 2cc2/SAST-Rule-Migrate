Rule Content:
/**
 * @name Path Traversal in File Open
 * @description Detects potential path traversal vulnerabilities when user-controlled data
 *              flows into file open operations without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import semmle.python.security.PathTraversal
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.Flask

class FlaskRequestSource extends RemoteFlowSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "get" or ma.getMethod().hasQualifiedName("flask.request.args", "__getitem__") or
       ma.getMethod().hasQualifiedName("flask.request.form", "get") or ma.getMethod().hasQualifiedName("flask.request.form", "__getitem__")) and
      ma.getReceiver().getType().hasQualifiedName("flask.request", _)
    )
  }
}

class RouteParamSource extends RemoteFlowSource::Range {
  RouteParamSource() {
    exists(MethodParameter mp |
      mp.getName().matches("%ROUTEVAR%") or mp.getName().matches("%INTERM%")
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(FunctionCall fc |
      fc.getTarget().hasQualifiedName("builtins", "open") and
      this.asExpr() = fc.getAnArgument()
    )
  }
}

from FlaskRequestSource source, OpenSink sink
where TaintTracking::localTaint(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."

from RouteParamSource source, OpenSink sink
where TaintTracking::localTaint(source, sink)
select sink, "Found route parameter in a call to 'open'. Ensure the parameter is validated or sanitized, otherwise it could result in path traversal attacks."
