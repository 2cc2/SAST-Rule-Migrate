Rule Content:
/**
 * @name Path Traversal in open()
 * @kind path-problem
 * @problem.severity error
 * @description Detects path traversal vulnerability when request data flows to open() call.
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.ApiGraphs

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call call |
      call.getTarget().hasQualifiedName(["flask", "request", "args"], ["get", "__getitem__"]) or
      call.getTarget().hasQualifiedName(["flask", "request", "form"], ["get", "__getitem__"]) |
      this.asExpr() = call
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      regexpMatch(p.getName(), "\\$ROUTEVAR|\\$INTERM") and
      this.asParameter() = p
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(Call call |
      call.getTarget().hasQualifiedName("builtins", "open") and
      this.asExpr() = call
    )
  }
}

from FlaskRequestSource source, OpenSink sink, DataFlow::PathNode path
where path.getSource() = source and path.getSink() = sink
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
