Rule Content:
/**
 * @name Path Traversal in open() call
 * @description Detects unsanitized request data used in open() calls that could lead to path traversal
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */
import python
import semmle.python.dataflow.TaintTracking
import DataFlow

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(API::Call call |
      call.getTarget().hasGlobalName(["args.get", "args.__getitem__", "form.get", "form.__getitem__"]) and
      API::isBuiltIn(call.getQualifier(), "flask", "request") and
      this = call.getAnArg()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().matches("%(ROUTEVAR|INTERM)%") and
      this = DataFlow::parameterNode(p)
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().hasGlobalName("open") and
      this = call.getAnArg()
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }
}

from PathTraversalConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, 
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized.", 
  source, "Untrusted data source"
