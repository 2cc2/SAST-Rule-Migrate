Rule Content:
/**
 * @name Path Traversal in open()
 * @description Detects path traversal vulnerabilities when user input is passed to open() without sanitization.
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import DataFlow::PathGraph
import DataFlow::Web::Flask
import DataFlow::RemoteFlowSource

class FlaskRequestSource extends DataFlow::SourceNode {
  FlaskRequestSource() {
    exists(DataFlow::Call call |
      call.getTarget().hasQualifiedName(["flask.request.args", "get"]) or
      call.getTarget().hasQualifiedName(["flask.request.args", "__getitem__"]) or
      call.getTarget().hasQualifiedName(["flask.request.form", "get"]) or
      call.getTarget().hasQualifiedName(["flask.request.form", "__getitem__"])
    |
      this = call.asSource()
    )
  }
}

class RouteParamSource extends DataFlow::SourceNode {
  RouteParamSource() {
    exists(string name | name = this.asParameter().getName() |
      name.regexpMatch("\\$ROUTEVAR|\\$INTERM")
    )
  }
}

class OpenSink extends DataFlow::SinkNode {
  OpenSink() {
    exists(DataFlow::Call call |
      call.getTarget().hasQualifiedName(["builtins", "open"])
    |
      this = call.asSink()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where DataFlow::localFlow(source, sink)
  and (
    source.getSource() instanceof FlaskRequestSource or
    source.getSource() instanceof RouteParamSource
  )
  and sink.getSink() instanceof OpenSink
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
