/**
 * @id path-traversal-open
 * @kind path-problem
 * @severity error
 */

import python
import semmle.python.security.PathTraversal
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getTarget().getPackage() = "flask.request" and
      (
        call.getTarget().getName() = "get" or
        call.getTarget().getName() = "__getitem__"
      ) and
      (
        call.getReceiverType().getName() = "args" or
        call.getReceiverType().getName() = "form"
      ) and
      this.asExpr() = call
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      (p.getName() matches(/\$ROUTEVAR|\$INTERM/) or
       p.getName() =~ "\$ROUTEVAR|\$INTERM") and
      this.asParameter() = p
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(MethodCall call |
      call.getTarget().getName() = "open" and
      call.getTarget().getPackage() = "builtins" and
      this.asExpr() = call
    )
  }
}

predicate isSanitizer(DataFlow::Node node) { none() }

from FlaskRequestSource source, OpenSink sink
where DataFlow::localFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."

from RouteParamSource source, OpenSink sink
where DataFlow::localFlow(source, sink)
select sink, "Found route parameter in a call to 'open'. Ensure the parameter is validated or sanitized, otherwise it could result in path traversal attacks."
