Rule Content:
/**
 * @name Path traversal via open()
 * @kind path-problem
 * @problem.severity error
 * @description Detects request data being passed to `open()` without validation,
 *              which could lead to path traversal attacks.
 * @id python/path-traversal-open
 */

import python
import semmle.python.security.Requests
import semmle.python.web.Flask
import DataFlow::PathGraph

class FlaskRequestSource extends RemoteFlowSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["get", "__getitem__"] and
      (
        ma.getQualifier().getType().hasName("flask.request.args") or
        ma.getQualifier().getType().hasName("flask.request.form")
      ) and
      this = ma.getArgument(0)
    )
    or
    exists(Parameter p |
      p.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this = p
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(FunctionCall openCall |
      openCall.getTarget().getName() = "open" and
      openCall.getTarget().getPackageName() = "builtins" and
      this = openCall.getArgument(0)
    )
  }
}

from FlaskRequestSource source, OpenSink sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where DataFlow::flowPath(sourceNode, sinkNode)
select sinkNode, "Found request data in a call to 'open'. Ensure the request data is " +
  "validated or sanitized, otherwise it could result in path traversal attacks.", sourceNode, sinkNode.toString()
