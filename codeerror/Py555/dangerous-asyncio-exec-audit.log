Rule Content:
/**
 * @name dangerous-asyncio-exec-audit
 * @description Detected subprocess function '$LOOP.subprocess_exec' without a static string.
 * @kind path-problem
 * @problem.severity error
 * @id py/dangerous-asyncio-exec-audit
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class DynamicSubprocessArg extends DataFlow::Node {
  DynamicSubprocessArg() {
    exists(Value v | 
      (v = Value::literal() or v = Value::call()) and
      v.getStringValue() != "..." and
      not v.getMethodName() = "subprocess_exec"
    )
  }
}

class SubprocessExecSink extends DataFlow::Node {
  SubprocessExecSink() {
    exists(Call c | 
      c = Call::named(["asyncio", "subprocess_exec"]) and
      (this = c.getArgument(1) or this = c.getArgument(2))
    )
  }
}

class StaticSubprocessArgSanitizer extends DataFlow::Node {
  StaticSubprocessArgSanitizer() {
    exists(Value v | 
      v = Value::literal() and
      v.getStringValue() = "..." and
      this = v
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "dangerous-asyncio-exec-audit" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicSubprocessArg
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessExecSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof StaticSubprocessArgSanitizer
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
