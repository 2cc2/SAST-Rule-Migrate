import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.dataflow.DataFlow
import DataFlow::PathGraph2

private class DynamicSubprocessArg extends DataFlow::Node {
  DynamicSubprocessArg() {
    exists(DataFlow::Node node |
      node = this and
      (node.asExpr().(StringLiteral).getValue() != "..." or
       node.getCall().getFuncName() != "subprocess_exec")
    )
  }

  override predicate isSource() { this instanceof DynamicSubprocessArg }

  override DataFlow::CfgNode asCfgNode() { result = this.asExpr() }
  override DataFlow::Location getLocation() { result = this.asExpr().getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }
  override DataFlow::Variable asVariable() { result = this.asExpr().asVariable() }
}

private class SubprocessExecCall extends DataFlow::Node {
  SubprocessExecCall() {
    exists(Call call |
      call = this.getCall() and
      call.getFuncName() = "subprocess_exec" and
      call.getCallee().(Name).getModule().getQualifiedName() = "asyncio" and
      this = call.getArgument(1) or this = call.getArgument(2)
    )
  }

  override predicate isSink(DataFlow::Node node) { node instanceof SubprocessExecCall }

  override DataFlow::CfgNode asCfgNode() { result = this.asExpr() }
  override DataFlow::Location getLocation() { result = this.asExpr().getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }
  override DataFlow::Variable asVariable() { result = this.asExpr().asVariable() }
}

private class StaticSubprocessArgSanitizer extends DataFlow::Node {
  StaticSubprocessArgSanitizer() {
    exists(DataFlow::Node node |
      node = this and
      node.asExpr().(StringLiteral).getValue() = "..."
    )
  }

  override predicate isSanitizer() { this instanceof StaticSubprocessArgSanitizer }

  override DataFlow::CfgNode asCfgNode() { result = this.asExpr() }
  override DataFlow::Location getLocation() { result = this.asExpr().getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }
  override DataFlow::Variable asVariable() { result = this.asExpr().asVariable() }
}

class DangerousAsyncioExecConfig extends TaintTracking::Configuration {
  DangerousAsyncioExecConfig() { this = "DangerousAsyncioExecConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof DynamicSubprocessArg
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SubprocessExecCall
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof StaticSubprocessArgSanitizer
  }
}

from DangerousAsyncioExecConfig cfg, DataFlow::PathNode2 source, DataFlow::PathNode2 sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape().'"
