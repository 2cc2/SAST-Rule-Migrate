Rule Content:
/**
 * @name Dangerous asyncio subprocess_exec audit
 * @description Detected subprocess function '$LOOP.subprocess_exec' without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection. 
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class DynamicSubprocessArg extends DataFlow::Node {
  DynamicSubprocessArg() {
    exists(DataFlow::Node n |
      n.asExpr() instanceof Literal or n.asExpr() instanceof Call and
      not n.asExpr().(Literal).getStringValue() = "..." and
      not n.asExpr().(Call).getMethodName() = "subprocess_exec"
    )
  }
}

class SubprocessExecCall extends DataFlow::Node {
  SubprocessExecCall() {
    exists(Call c |
      c.getMethodName() = "subprocess_exec" and
      c.getImportedFromPackage() = "asyncio" and
      this.asExpr() = c
    )
  }
}

class StaticSubprocessArgSanitizer extends DataFlow::Node {
  StaticSubprocessArgSanitizer() {
    exists(DataFlow::Node n |
      n.asExpr() instanceof Literal and
      n.asExpr().(Literal).getStringValue() = "..."
    )
  }
}

class DangerousAsyncioExecConfiguration extends TaintTracking::Configuration {
  DangerousAsyncioExecConfiguration() {
    this = "DangerousAsyncioExecConfiguration"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicSubprocessArg
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessExecCall and
    (
      sink.asExpr().getParent().getArg(1) = sink.asExpr() or
      sink.asExpr().getParent().getArg(2) = sink.asExpr()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticSubprocessArgSanitizer
  }
}

from DangerousAsyncioExecConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
