/**
 * @name Dangerous asyncio exec audit
 * @description Detected subprocess function '$LOOP.subprocess_exec' without a static string.
 * @id dangerous-asyncio-exec-audit
 * @kind path-problem
 * @severity error
 */
import semmle.python.ApiGraphs
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class SubprocessExecCall extends DataFlow::FunctionCallNode {
  SubprocessExecCall() {
    exists(string packageName, string methodName |
      packageName = "asyncio" and
      methodName = "subprocess_exec" and
      this.getTarget().(Method).getQualifiedName() = packageName + "." + methodName
    )
  }

  int getVulnerableArg() { result = 1 or result = 2 }
}

class DynamicSubprocessArg extends DataFlow::Node {
  DynamicSubprocessArg() {
    exists(DataFlow::Node node |
      node = this and
      not exists(node.asExpr().(StringLiteral).getValue()) and
      not exists(SubprocessExecCall subproc | node.asExpr() = subproc.getAnArgument())
    )
  }

  override predicate isSource() { this instanceof DataFlow::ParameterNode }
}

class StaticSubprocessArgSanitizer extends DataFlow::Node {
  StaticSubprocessArgSanitizer() {
    exists(StringLiteral lit |
      lit = this.asExpr() and
      lit.getValue() = "..."
    )
  }
}

class DangerousSubprocessExecFlow extends TaintTracking::Configuration {
  DangerousSubprocessExecFlow() { this = "DangerousSubprocessExecFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicSubprocessArg
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SubprocessExecCall call |
      call.getAnArgument() = sink.asExpr() and
      call.getVulnerableArg() = sink.asExpr().getArgumentIndex()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticSubprocessArgSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::ArgumentNode arg |
      arg = pred and
      arg.asParameter() = succ
    )
  }
}

from DangerousSubprocessExecFlow cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
