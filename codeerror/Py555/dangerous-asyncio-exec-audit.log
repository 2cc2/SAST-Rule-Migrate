Rule Content:
/**
 * @name Dangerous asyncio.subprocess_exec call with dynamic argument
 * @description Detects subprocess function 'LOOP.subprocess_exec' called with dynamic input.
 *              If this data can be controlled by a malicious actor, it may be an instance 
 *              of command injection.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts

class DynamicSubprocessArg extends DataFlow::Source {
  DynamicSubprocessArg() {
    exists(string literalValue | 
      this.asExpr() = literalValue and literalValue != "..."
    )
    or
    exists(Call call | 
      this.asExpr() = call and not call.getMethod().getName() = "subprocess_exec"
    )
  }
}

class SubprocessExecSink extends DataFlow::Sink {
  SubprocessExecSink() {
    exists(Call call |
      call.getMethod().getName() = "subprocess_exec" and
      call.getMethod().getDeclaringType().hasQualifiedName("asyncio") and
      this.asExpr() = call.getArgument([1, 2])
    )
  }
}

class StaticSubprocessArgSanitizer extends DataFlow::Sanitizer {
  StaticSubprocessArgSanitizer() {
    exists(string literalValue | 
      this.asExpr() = literalValue and literalValue = "..."
    )
  }
}

class DangerousAsyncIoSubprocessExecConfiguration extends TaintTracking::Configuration {
  DangerousAsyncIoSubprocessExecConfiguration() {
    this = "Dangerous asyncio.exec call config"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicSubprocessArg
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessExecSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticSubprocessArgSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
      pred = arg and succ = param |
      arg.(DataFlow::ArgumentNode).flowsTo(param)
    )
  }
}

from DangerousAsyncIoSubprocessExecConfiguration config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, 
  "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'.", source, "Dynamic argument flows to subprocess_exec"
