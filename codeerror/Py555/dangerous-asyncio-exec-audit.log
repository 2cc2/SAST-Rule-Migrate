import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

private class DynamicSubprocessArg extends DataFlow::Node {
  DynamicSubprocessArg() {
    exists(FunctionValue v |
      (v.isLiteral() or v.isCall()) and
      v.getStringContent() != "..." and
      v.getFunctionName() != "subprocess_exec"
    | result = v.getAValueSource()
    )
  }

  override predicate asCfgNode(CfgNode node) { none() }
  override DataFlow::Location getLocation() { result = getSourceLocation() }
  override BasicBlock::BasicBlock getBasicBlock() { none() }
  override string toString() { result = "Dynamic subprocess argument" }
  override DataFlow::Scope getScope() { result = getEnclosingScope() }
  override DataFlow::Variable asVariable() { none() }
}

private class SubprocessExecSink extends DataFlow::Node {
  SubprocessExecSink() {
    exists(FunctionCall fc |
      fc.getTarget().hasQualifiedName("asyncio", "subprocess_exec") and
      (
        fc.getArgument(1) = result.asExpr() or
        fc.getArgument(2) = result.asExpr()
      )
    )
  }

  override predicate asCfgNode(CfgNode node) { none() }
  override DataFlow::Location getLocation() { result = getSourceLocation() }
  override BasicBlock::BasicBlock getBasicBlock() { none() }
  override string toString() { result = "subprocess_exec call" }
  override DataFlow::Scope getScope() { result = getEnclosingScope() }
  override DataFlow::Variable asVariable() { none() }
}

private class StaticSubprocessArgSanitizer extends DataFlow::Node {
  StaticSubprocessArgSanitizer() {
    exists(FunctionValue v |
      v.isLiteral() and
      v.getStringContent() = "..."
    | result = v.getAValueSource()
    )
  }

  override predicate asCfgNode(CfgNode node) { none() }
  override DataFlow::Location getLocation() { result = getSourceLocation() }
  override BasicBlock::BasicBlock getBasicBlock() { none() }
  override string toString() { result = "Static subprocess argument" }
  override DataFlow::Scope getScope() { result = getEnclosingScope() }
  override DataFlow::Variable asVariable() { none() }
}

class DangerousAsyncIoExec extends TaintTracking::Configuration {
  DangerousAsyncIoExec() { this = "Dangerous async io exec configuration" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof DynamicSubprocessArg
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SubprocessExecSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof StaticSubprocessArgSanitizer
  }
}

from DangerousAsyncIoExec cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected subprocess function 'subprocess_exec' without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection. Audit the use of this call to ensure it is not controllable by an external resource. You may consider using 'shlex.escape()'."
