Rule Content:
/**
 * @name Dangerous asyncio.exec call audit
 * @description Detects subprocess function '$LOOP.subprocess_exec' without a static string
 * @kind problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking

class SubprocessExecCall extends Call {
  SubprocessExecCall() {
    this.getMember(Token(Identifier("subprocess_exec"))) and
    this.getObject().getObject().getMember(Token(Identifier("BaseEventLoop")))
  }
}

class DynamicSubprocessArg extends Expr {
  DynamicSubprocessArg() {
    not this = any(StringLiteral sl | sl.getStringValue() = "...") and
    not this.(Call).getMember(Token(Identifier("subprocess_exec")))
  }
}

class DangerousAsyncIoExecTaintConfig extends TaintTracking::Configuration {
  DangerousAsyncIoExecTaintConfig() { this = "DangerousAsyncIoExecTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(DynamicSubprocessArg dynArg |
      source.asExpr() = dynArg
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SubprocessExecCall call |
      sink.asExpr() = call.getArgument(1) or
      sink.asExpr() = call.getArgument(2)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral staticArg |
      staticArg.getStringValue() = "..." and
      sanitizer.asExpr() = staticArg
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
      param.getParameter().getContainer() = arg.getCallable() and
      arg.asExpr() = node1.asExpr() and
      param.asExpr() = node2.asExpr()
    )
  }
}

from DangerousAsyncIoExecTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
