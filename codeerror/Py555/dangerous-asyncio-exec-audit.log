/**
 * @name Dangerous asyncio subprocess_exec call with dynamic input
 * @description Detects unsafe usage of asyncio's subprocess_exec with dynamic arguments
 * @id dangerous-asyncio-exec-audit
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class DangerousAsyncIoSubprocessExecConfiguration extends TaintTracking::Configuration {
  DangerousAsyncIoSubprocessExecConfiguration() { this = "DangerousAsyncIoSubprocessExecConfiguration" }

  override predicate isSource(TaintTracking::TaintSource source) {
    exists(DynamicSubprocessArg src |
      source.asSource() = src.asSource()
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(SubprocessExecSink s |
      sink.asSink() = s.asSink()
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer san) {
    exists(StaticSubprocessArgSanitizer s |
      san.asSanitizer() = s.asSanitizer()
    )
  }

  override predicate isAdditionalTaintStep(TaintTracking::DataFlow::Node src, TaintTracking::DataFlow::Node sink) {
    exists(ArgToSubprocessPropagation step |
      src = step.getSource() and
      sink = step.getSink()
    )
  }
}

class DynamicSubprocessArg extends TaintTracking::TaintSource {
  DynamicSubprocessArg() {
    exists(Literal l |
      l.getStringValue() != "..." and
      this.asSource() = l
    ) or
    exists(Call c |
      c.getMethodAccess().getName() != "subprocess_exec" and
      this.asSource() = c
    )
  }
}

class SubprocessExecSink extends TaintTracking::TaintSink {
  SubprocessExecSink() {
    exists(Call c, MethodAccess ma |
      ma = c.getMethodAccess() and
      ma.getMethod().getName() = "subprocess_exec" and
      ma.getMethod().getDeclaringType().hasQualifiedName("asyncio", "Loop") and
      (c.getArgument(1) = this.asSink() or c.getArgument(2) = this.asSink())
    )
  }
}

class StaticSubprocessArgSanitizer extends TaintTracking::Sanitizer {
  StaticSubprocessArgSanitizer() {
    exists(Literal l |
      l.getStringValue() = "..." and
      this.asSanitizer() = l
    )
  }
}

class ArgToSubprocessPropagation {
  TaintTracking::DataFlow::Node src;
  TaintTracking::DataFlow::Node sink;

  ArgToSubprocessPropagation() {
    exists(Parameter p, Argument a |
      src.asDefinition() = a.asDefinition() and
      sink.asDefinition() = p.asDefinition()
    )
  }

  TaintTracking::DataFlow::Node getSource() { result = src }
  TaintTracking::DataFlow::Node getSink() { result = sink }
}
