Rule Content:
/**
 * @name Dangerous asyncio subprocess_exec audit
 * @description Detected subprocess function '$LOOP.subprocess_exec' without a static string. If controllable by a malicious actor, it may be command injection.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 */

import python
import DataFlow
import DataFlow::PathGraph

class DangerousAsyncIoSubprocessExecConfiguration extends DataFlow::Configuration {
  DangerousAsyncIoSubprocessExecConfiguration() { this = "DangerousAsyncIoSubprocessExecConfiguration" }

  override predicate isSource(DataFlow::SourceNode source) { 
    source.asExpr() instanceof DynamicSubprocessArg
  }

  override predicate isSink(DataFlow::SinkNode sink) { 
    sink.asExpr() instanceof SubprocessExecSink
  }

  override predicate isBarrier(DataFlow::BarrierNode barrier) { 
    barrier.asExpr() instanceof StaticSubprocessArgSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node n1, DataFlow::Node n2) { 
    result instanceof ArgToSubprocessPropagation
  }
}

class DynamicSubprocessArg extends DataFlow::SourceNode {
  DynamicSubprocessArg() { 
    this.asExpr() instanceof StringLiteral or
    this.asExpr() = any(Call c).getCallee()
      .getQualifiedName() != "subprocess_exec"
  }
}

class SubprocessExecSink extends DataFlow::SinkNode {
  SubprocessExecSink() { 
    exists(Call c |
      c.getCallee().getQualifiedName() = "asyncio.subprocess_exec" and
      (this.asExpr() = c.getArgument(1) or this.asExpr() = c.getArgument(2))
    )
  }
}

class StaticSubprocessArgSanitizer extends DataFlow::BarrierNode {
  StaticSubprocessArgSanitizer() { 
    this.asExpr().(StringLiteral).getValue() = "..."
  }
}

class ArgToSubprocessPropagation extends DataFlow::AdditionalTaintStep {
  override predicate step(DataFlow::Node n1, DataFlow::Node n2) {
    exists(Function::Parameter p |
      n1.asDefinition() = p.asDefinition() and
      n2.asDefinition() = p.getAnArgument().getDefinition()
    )
  }

  override string toString() { result = "argument propagation" }
}

from DangerousAsyncIoSubprocessExecConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
