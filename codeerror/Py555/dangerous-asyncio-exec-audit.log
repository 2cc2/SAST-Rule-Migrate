/**
 * @name dangerous-asyncio-exec-audit
 * @description Detected subprocess function '$LOOP.subprocess_exec' without a static string.
 * @kind path-problem
 * @problem.severity error
 * @id py/dangerous-asyncio-exec-audit
 * @message Detected subprocess function '$LOOP.subprocess_exec' without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection. Audit the use of this call to ensure it is not controllable by an external resource. You may consider using 'shlex.escape()'.
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class SubprocessExecCall extends DataFlow::CallNode {
  SubprocessExecCall() {
    this.getTarget().(Attribute).getAttrName() = "subprocess_exec" and
    this.getTarget().(Attribute).getObject().getType().basename() = "AbstractEventLoop"
  }
}

class DynamicSubprocessArg extends DataFlow::Node {
  DynamicSubprocessArg() {
    exists(Literal lit | lit = this and lit.getStringValue() != "..." and not lit.getStringValue().isStaticCall())
    or
    exists(Call call | call = this and not call.getTarget().toString() = "subprocess_exec")
  }
}

class StaticSubprocessArgSanitizer extends DataFlow::Node {
  StaticSubprocessArgSanitizer() {
    exists(Literal lit | lit = this and lit.getStringValue() = "...")
  }
}

class DangerousAsyncioExecConfiguration extends TaintTracking::Configuration {
  DangerousAsyncioExecConfiguration() { this = "DangerousAsyncioExecConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof DynamicSubprocessArg }

  override predicate isSink(DataFlow::Node sink) { sink = any(SubprocessExecCall c).getArg(1) or sink = any(SubprocessExecCall c).getArg(2) }

  override predicate isSanitizer(DataFlow::Node node) { node instanceof StaticSubprocessArgSanitizer }
}

from DangerousAsyncioExecConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'.", source, sink, "Potential command injection"
