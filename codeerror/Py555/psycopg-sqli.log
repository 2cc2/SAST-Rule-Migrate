Rule Content:
/**
 * @name psycopg-sqli
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/psycopg-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking

class UserInputSource extends DataFlow::Source {
  UserInputSource() {
    exists(string regexp | regexp.matches(".*user.*input.*|.*user.*control.*") |
      this.asExpr().getText() = regexp
    )
  }
}

class StringFormatSource extends DataFlow::Source {
  StringFormatSource() {
    exists(CallNode call | 
      call.getMethodName() = "format" and
      call.getReceiver().getType().hasQualifiedName("str", "") and
      this.asExpr() = call
    )
  }
}

class StringModSource extends DataFlow::Source {
  StringModSource() {
    exists(CallNode call |
      call.getMethodName() = "__mod__" and
      call.getReceiver().getType().hasQualifiedName("str", "") and
      this.asExpr() = call
    )
  }
}

class PsycopgSink extends DataFlow::Sink {
  PsycopgSink() {
    exists(CallNode call |
      call.getReceiver().getType().hasQualifiedName("psycopg2", "") and
      call.getMethodName().matches("execute%") and
      this.asExpr() = call.getArgument(1)
    )
  }
}

class ParamQuerySanitizer extends DataFlow::Sanitizer {
  ParamQuerySanitizer() {
    exists(string sql |
      sql.matches("^SELECT.*%s.*$") and
      this.asExpr().getText() = sql
    )
  }
}

class PsycopgSqliConfig extends TaintTracking::Configuration {
  PsycopgSqliConfig() { this = "PsycopgSqliConfig" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof UserInputSource or
    source instanceof StringFormatSource or
    source instanceof StringModSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof PsycopgSink
  }

  override predicate isSanitizer(DataFlow::Sanitizer san) {
    san instanceof ParamQuerySanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(CallNode call |
      pred.asExpr() = call.getAnArgument() and
      succ.asExpr() = call
    )
  }
}

from PsycopgSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection vulnerability due to string concatenation in psycopg2 query"
