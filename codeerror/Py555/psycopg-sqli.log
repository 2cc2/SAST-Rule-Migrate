Rule Content:
/**
 * @name Psycopg SQL Injection
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/psycopg-sqli
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.Concepts

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    this.asExpr().(StringLiteral).getValue().matches("%user%input%") or
    this.asExpr().(StringLiteral).getValue().matches("%user%control%")
  }
}

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(Call call |
      call = this.asExpr() |
      call.getCalleeName() = "format" and
      call.getImportedScope().getName() = "str"
    )
  }
}

class StringModSource extends DataFlow::Node {
  StringModSource() {
    exists(Call call |
      call = this.asExpr() |
      call.getCalleeName() = "__mod__" and
      call.getImportedScope().getName() = "str"
    )
  }
}

class PsycopgSink extends DataFlow::Node {
  PsycopgSink() {
    exists(Call call |
      call = this.asExpr() |
      (call.getCalleeName() = "execute" or
       call.getCalleeName() = "executemany" or
       call.getCalleeName() = "mogrify") and
      call.getImportedScope().getName() = "psycopg2" and
      this = call.getArgument(1)
    )
  }
}

class ParamQuerySanitizer extends DataFlow::Node {
  ParamQuerySanitizer() {
    this.asExpr().(StringLiteral).getValue().regexpMatch("^SELECT.*%s.*$")
  }
}

class PsycopgSQLIConfig extends DataFlow::Configuration {
  PsycopgSQLIConfig() { this = "PsycopgSQLIConfig" } 

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource or
    source instanceof StringFormatSource or
    source instanceof StringModSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PsycopgSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParamQuerySanitizer
  }
}

from DataFlow::Node source, DataFlow::Node sink, PsycopgSQLIConfig config
where config.hasFlow(source, sink)
select sink, "Detected string concatenation with a non-literal variable in a psycopg2 Python SQL " +
       "statement. This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
