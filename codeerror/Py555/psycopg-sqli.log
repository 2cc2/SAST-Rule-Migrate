Rule Content:
/**
 * @name Psycopg2 SQL Injection
 * @description Detects string concatenation with non-literal variables in psycopg2 SQL statements,
 *              which could lead to SQL injection if the variable is user-controlled.
 * @severity Warning
 * @kind path-problem
 * @problem.severity warning
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts

class PsycopgSQLExecution extends TaintTracking::Configuration, DataFlow::CallNode {
  PsycopgSQLExecution() {
    exists(MethodCall call |
      call.getReceiver().(Name).getId() = "psycopg2" and
      call.getMethodName() in ["execute", "executemany", "mogrify"] and
      this = call.getACall()
    )
  }

  override predicate isSource(DataFlow::Node source) { 
    any(UserInputSource src).flowsTo(source) or
    any(StringFormatOperation fmt).flowsTo(source) or
    any(StringModOperation mod).flowsTo(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(PsycopgSQLExecution exec |
      exec.getArg(0) = sink.asExpr()
    )
  }
}

private class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(string userInput |
      userInput.matches("%user%input%") or
      userInput.matches("%user%control%") and
      this.asExpr() = userInput
    )
  }
}

private class StringFormatOperation extends DataFlow::Node {
  StringFormatOperation() {
    exists(MethodCall call |
      call.getMethodName() = "format" and
      call.getReceiver().getType() instanceof StrType and
      this.asExpr() = call
    )
  }
}

private class StringModOperation extends DataFlow::Node {
  StringModOperation() {
    exists(MethodCall call |
      call.getMethodName() = "__mod__" and
      call.getReceiver().getType() instanceof StrType and
      this.asExpr() = call
    )
  }
}

private predicate isParamQuerySanitizer(DataFlow::Node node) {
  exists(string query |
    query.matches("SELECT.*%s.*") and
    node.asExpr() = query
  )
}

from PsycopgSQLExecution cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink) and not isParamQuerySanitizer(sink)
select sink, "Potential SQL injection via unsafe string concatenation in psycopg2 call"
