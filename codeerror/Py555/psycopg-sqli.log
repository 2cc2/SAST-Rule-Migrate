Rule Content:
/**
 * @name Psycopg SQL Injection
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/psycopg-sqli
 */

import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class PsycopgSink extends DataFlow::Node {
  PsycopgSink() {
    exists(Call call |
      call.getTarget().getName() in ["execute", "executemany", "mogrify"] and
      call.getPrimaryQlClass() = "psycopg2" and
      this.asExpr() = call.getArg(1)
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(string text |
      this.asExpr().(StringLiteral).getText() = text and
      text.regexpMatch(".*user.*input.*|.*user.*control.*")
    )
  }
}

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(Call call |
      call.getTarget().getName() = "format" and
      call.getPrimaryQlClass() = "str" and
      this.asExpr() = call
    )
  }
}

class StringModSource extends DataFlow::Node {
  StringModSource() {
    exists(Call call |
      call.getTarget().getName() = "__mod__" and
      call.getPrimaryQlClass() = "str" and
      this.asExpr() = call
    )
  }
}

class ParamQuerySanitizer extends DataFlow::Node {
  ParamQuerySanitizer() {
    exists(string text |
      this.asExpr().(StringLiteral).getText() = text and
      text.regexpMatch("^SELECT.*%s.*$")
    )
  }
}

query predicate edges(DataFlow::Node node1, DataFlow::Node node2) {
  edgesStringConcat(node1, node2)
  or
  edgesStringFormat(node1, node2)
}

predicate edgesStringConcat(DataFlow::Node node1, DataFlow::Node node2) {
  exists(Call call |
    call.getTarget().getName() = "__add__" and
    call.getPrimaryQlClass() = "str" and
    (
      node1.asExpr() = call.getArg(0) and node2.asExpr() = call
      or
      node1.asExpr() = call.getArg(1) and node2.asExpr() = call
    )
  )
}

predicate edgesStringFormat(DataFlow::Node node1, DataFlow::Node node2) {
  exists(Call call |
    call.getTarget().getName() = "format" and
    call.getPrimaryQlClass() = "str" and
    node1.asExpr() = call.getArg(_) and
    node2.asExpr() = call
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(UserInputSource input | input = source.getNode()) or
  exists(StringFormatSource format | format = source.getNode()) or
  exists(StringModSource mod | mod = source.getNode())
  and
  exists(PsycopgSink psycopg | psycopg = sink.getNode())
  and
  not exists(ParamQuerySanitizer sanitizer | sink.getNode() = sanitizer)
  and
  hasFlowPath(source, sink)
select sink, "Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized.", source, source.getNode(),
  "User-provided value flows to SQL query"
