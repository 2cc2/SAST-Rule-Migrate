Rule Content:
/**
 * @name psycopg-sqli
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/psycopg-sqli
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class UserInputSource extends TaintTracking::TaintSource {
  UserInputSource() {
    exists(string pattern |
      pattern.regexpMatch(".*user.*input.*|.*user.*control.*") and
      this.asExpr().toString() = pattern
    )
  }

  override predicate isSourceOfDataFlow() { this instanceof UserInputSource }

  override string getSourceType() { "User-controlled input" }

  override Expr asExpr() { result = this }
}

class StringFormatOperation extends TaintTracking::TaintSource {
  string format;

  StringFormatOperation() {
    exists(MethodCall call |
      call.getTarget().getName() = "format" and
      call.getTarget().getType().stripAnnots().stripModifiers().getName() = "str" and
      this.asExpr() = call
    )
  }

  override predicate isSourceOfDataFlow() { this instanceof StringFormatOperation }

  override string getSourceType() { "String format operation" }

  override Expr asExpr() { result = this }
}

class StringModOperation extends TaintTracking::TaintSource {
  StringModOperation() {
    exists(MethodCall call |
      call.getTarget().getName() = "__mod__" and
      call.getTarget().getType().stripAnnots().stripModifiers().getName() = "str" and
      this.asExpr() = call
    )
  }

  override predicate isSourceOfDataFlow() { this instanceof StringModOperation }

  override string getSourceType() { "String modulo operation" }

  override Expr asExpr() { result = this }
}

class PsycopgSink extends TaintTracking::TaintSink {
  PsycopgSink() {
    exists(MethodCall call |
      call.getTarget().getName().matches("execute|executemany|mogrify") and
      call.getTarget().getDeclaringType().getQualifiedName() = "psycopg2" and
      this.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node node) { this.asExpr() = node.asExpr() }

  override string getSinkType() { "Psycopg2 SQL execution method" }

  override Expr asExpr() { result = this }
}

class ParametrizedQuerySanitizer extends TaintTracking::Sanitizer {
  ParametrizedQuerySanitizer() {
    exists(string query |
      query.regexpMatch("^SELECT.*%s.*$") and
      this.asExpr().toString() = query
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    this.asExpr() = node.asExpr()
  }

  override Expr asExpr() { result = this }
}

query predicate edges(DataFlow::PathNode source, DataFlow::PathNode sink) {
  source.hasFlowPath(sink) and
  exists(UserInputSource src | src = source.getNode()) and
  exists(PsycopgSink snk | snk = sink.getNode())
  or
  source.hasFlowPath(sink) and
  exists(StringFormatOperation src | src = source.getNode()) and
  exists(PsycopgSink snk | snk = sink.getNode())
  or
  source.hasFlowPath(sink) and
  exists(StringModOperation src | src = source.getNode()) and
  exists(PsycopgSink snk | snk = sink.getNode())
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where edges(source, sink)
select sink, "Potential SQL injection in psycopg2: variable concatenation using $@", source,
  "Non-constant variable concatenated in SQL query from $@.", source.getNode(), "user input"
