Rule Content:
/**
 * @name Psycopg SQL Injection
 * @description Detects string concatenation with non-literal variables in psycopg2 SQL statements
 * @kind path-problem
 * @problem.severity warning
 * @id py/psycopg-sqli
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.ApiGraphs

class PsycopgSQLExecution extends DataFlow::Node {
  PsycopgSQLExecution() {
    exists(MethodCall call |
      call.getMethod().getName() = ["execute", "executemany", "mogrify"] and
      call.getReceiverType().getAPackage().getName() = "psycopg2" and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(string lit |
      lit.toLowerCase().regexpMatch(".*user.*input.*|.*user.*control.*") and
      this.asExpr() = lit
    )
  }
}

class StringFormatOperation extends DataFlow::Node {
  StringFormatOperation() {
    exists(MethodCall call |
      call.getMethod().getName() = "format" and
      call.getReceiverType().getName() = "str" and
      this.asExpr() = call
    )
  }
}

class StringModOperation extends DataFlow::Node {
  StringModOperation() {
    exists(MethodCall call |
      call.getMethod().getName() = "__mod__" and
      call.getReceiverType().getName() = "str" and
      this.asExpr() = call
    )
  }
}

class ParamQuerySanitizer extends DataFlow::Node {
  ParamQuerySanitizer() {
    exists(string lit |
      lit.regexpMatch("^SELECT.*%s.*$") and
      this.asExpr() = lit
    )
  }
}

query predicate edges(DataFlow::Node pred, DataFlow::Node succ) {
  DataFlow::binaryExprNode(pred, succ, "+") or
  exists(MethodCall call |
    (call.getMethod().getName() = "format" or call.getMethod().getName() = "__mod__") and
    succ.asExpr() = call and
    pred.asExpr() = call.getAnArgument()
  )
}

from UserInputSource source, PsycopgSQLExecution sink
where DataFlow::flow(source, sink) and
not DataFlow::flow(ParamQuerySanitizer(), sink)
select sink, "Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
