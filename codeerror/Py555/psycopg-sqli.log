Rule Content:
/**
 * @name psycopg-sqli
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @id psycopg-sqli
 * @kind path-problem
 * @problem.severity warning
 */

import python
import semmle.python.security.TaintedPaths
import semmle.python.ApiGraphs
import semmle.python.Concepts

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%user%input%") or
      ma.getMethod().getName().matches("%user%control%")
    )
  }
}

class StringFormatOperation extends DataFlow::Node {
  StringFormatOperation() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getQualifier().getType().hasName("str")
    )
  }
}

class StringModOperation extends DataFlow::Node {
  StringModOperation() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "__mod__" and
      ma.getQualifier().getType().hasName("str")
    )
  }
}

class PsycopgSink extends DataFlow::Node {
  PsycopgSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("psycopg2", "execute") or
      ma.getMethod().hasQualifiedName("psycopg2", "executemany") or
      ma.getMethod().hasQualifiedName("psycopg2", "mogrify") and
      ma.getArgument(1) = this
    )
  }
}

class ParamQuerySanitizer extends DataFlow::Node {
  ParamQuerySanitizer() {
    exists(StringLiteral s |
      s.getValue().regexpMatch("^SELECT.*%s.*$")
    )
  }
}

predicate isSource(DataFlow::Node source) {
  source instanceof UserInputSource or
  source instanceof StringFormatOperation or
  source instanceof StringModOperation
}

predicate isSink(DataFlow::Node sink) {
  sink instanceof PsycopgSink
}

predicate isSanitizer(DataFlow::Node sanitizer) {
  sanitizer instanceof ParamQuerySanitizer
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  hasFlowPath(source, sink) and
  isSource(source.getNode()) and
  isSink(sink.getNode()) and
  not exists(DataFlow::PathNode sanitizer |
    sanitizer.getNode() instanceof ParamQuerySanitizer and
    isBetween(source, sanitizer, sink)
  )
select sink, "Potential SQL injection due to untrusted input in psycopg2 SQL statement", source,
  "This variable may contain user input and is used in a SQL statement"
