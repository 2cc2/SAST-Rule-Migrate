import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.Concepts

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(string pattern |
      pattern.regexpMatch(".*user.*input.*|.*user.*control.*") and
      this.asExpr().(StringLiteral).getText() = pattern
    )
  }
}

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodCall call |
      call.getMethod().getName() = "format" and
      call.getCallee().getType() = string and
      this.asExpr() = call
    )
  }
}

class StringModSource extends DataFlow::Node {
  StringModSource() {
    exists(MethodCall call |
      call.getMethod().getName() = "__mod__" and
      call.getCallee().getType() = string and
      this.asExpr() = call
    )
  }
}

class PsycopgSink extends DataFlow::Node {
  PsycopgSink() {
    exists(MethodCall call |
      call.getMethod().getName().matches("execute|executemany|mogrify") and
      call.getCallee().(Name).getId().matches("psycopg2%") and
      this.asExpr() = call.getArg(1)
    )
  }
}

class ParamQuerySanitizer extends DataFlow::BarrierGuardNode {
  ParamQuerySanitizer() {
    exists(string pattern |
      pattern.regexpMatch("^SELECT.*%s.*$") and
      this.asExpr().(StringLiteral).getText() = pattern
    )
  }
}

class PsycopgSqliConfig extends TaintTracking::Configuration {
  PsycopgSqliConfig() { this = "PsycopgSqliConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource or
    source instanceof StringFormatSource or
    source instanceof StringModSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PsycopgSink
  }

  override predicate isSanitizer(DataFlow::BarrierGuardNode sanitizer) {
    sanitizer instanceof ParamQuerySanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodCall call |
      call.getMethod().getName().matches("__add__|format|__mod__") and
      node1.asExpr() = call.getArg(0) and
      node2.asExpr() = call
    )
  }
}

from PsycopgSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
