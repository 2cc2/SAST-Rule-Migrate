Rule Content:
/**
 * @name psycopg-sqli
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement. 
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/psycopg-sqli
 */

import semmle.python.dataflow.PathGraph
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class UserInputSource extends DataFlow::Node, TaintTracking::TaintSource {
  override predicate isSource(DataFlow::Node source) {
    exists(string s |
      this = DataFlow::literalNode(s) and
      s.matches("%user%input%") or s.matches("%user%control%")
    )
  }
  
  override predicate asCfgNode(ControlFlow::BasicBlock node) { none() }
  override string toString() { result = "User input source" }
  override predicate getLocation(Location loc) { loc = this.getLocation() }
  override predicate getBasicBlock(ControlFlow::BasicBlock block) { none() }
  override predicate getScope(TheScope scope) { none() }
  override predicate asVariable(Variable v) { none() }
}

class StringFormatSource extends DataFlow::Node, TaintTracking::TaintSource {
  override predicate isSource(DataFlow::Node source) {
    exists(MethodCall mc |
      mc = source.asExpr() and
      mc.getMethod().getName() = "format" and
      mc.getQualifier().getType().getName() = "str"
    )
  }
  
  override predicate asCfgNode(ControlFlow::BasicBlock node) { none() }
  override string toString() { result = "String format source" }
  override predicate getLocation(Location loc) { loc = this.getLocation() }
  override predicate getBasicBlock(ControlFlow::BasicBlock block) { none() }
  override predicate getScope(TheScope scope) { none() }
  override predicate asVariable(Variable v) { none() }
}

class StringModSource extends DataFlow::Node, TaintTracking::TaintSource {
  override predicate isSource(DataFlow::Node source) {
    exists(MethodCall mc |
      mc = source.asExpr() and
      mc.getMethod().getName() = "__mod__" and
      mc.getQualifier().getType().getName() = "str"
    )
  }
  
  override predicate asCfgNode(ControlFlow::BasicBlock node) { none() }
  override string toString() { result = "String mod source" }
  override predicate getLocation(Location loc) { loc = this.getLocation() }
  override predicate getBasicBlock(ControlFlow::BasicBlock block) { none() }
  override predicate getScope(TheScope scope) { none() }
  override predicate asVariable(Variable v) { none() }
}

class ExecuteSink extends DataFlow::Node, TaintTracking::TaintSink {
  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall mc, string pkg |
      mc = sink.asExpr() and
      mc.getMethod().getName().matches("execute%") and
      pkg = mc.getQualifier().getType().getName() and
      pkg.matches("%psycopg2%") and
      sink.asExpr() = mc.getArgument(0)
    )
  }
  
  override predicate asCfgNode(ControlFlow::BasicBlock node) { none() }
  override string toString() { result = "SQL execute sink" }
  override predicate getLocation(Location loc) { loc = this.getLocation() }
  override predicate getBasicBlock(ControlFlow::BasicBlock block) { none() }
  override predicate getScope(TheScope scope) { none() }
  override predicate asVariable(Variable v) { none() }
}

class ParamQuerySanitizer extends DataFlow::Node, TaintTracking::Sanitizer {
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(string s |
      this = DataFlow::literalNode(s) and
      s.matches("SELECT%")
    )
  }
  
  override predicate asCfgNode(ControlFlow::BasicBlock node) { none() }
  override string toString() { result = "Parameterized query sanitizer" }
  override predicate getLocation(Location loc) { loc = this.getLocation() }
  override predicate getBasicBlock(ControlFlow::BasicBlock block) { none() }
  override predicate getScope(TheScope scope) { none() }
  override predicate asVariable(Variable v) { none() }
}

class PsycopgSQLIConfig extends TaintTracking::Configuration {
  PsycopgSQLIConfig() { this = "PsycopgSQLIConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(UserInputSource uis, StringFormatSource sfs, StringModSource sms |
      source.(TaintTracking::TaintSource) = uis or
      source.(TaintTracking::TaintSource) = sfs or
      source.(TaintTracking::TaintSource) = sms
    )
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecuteSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParamQuerySanitizer
  }
  
  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Captures string concatenation and formatting propagation
    exists(MethodCall mc |
      (mc.getMethod().getName() = "format" or mc.getMethod().getName() = "__mod__") and
      node1.asExpr() = mc.getArgument(0) and
      node2.asExpr() = mc.getQualifier()
    )
  }
}

from PsycopgSQLIConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "Potential SQL injection due to string concatenation in psycopg2 query"
