Rule Content:
/**
 * @name psycopg-sqli
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 * @id python/psycopg-sqli
 * @kind path-problem
 * @problem.severity warning
 */

import python
import semmle.python.security.SqlInjectionCustom
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(string pattern | pattern.regexpMatch(".*user.*input.*|.*user.*control.*") |
      this.asStringConst().getStringValue().regexpMatches(pattern)
    )
  }
}

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "format" and
      mc.getQualifier().getType().hasName("str") and
      this = mc.getAnArgument()
    )
  }
}

class StringModSource extends DataFlow::Node {
  StringModSource() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "__mod__" and
      mc.getQualifier().getType().hasName("str") and
      this = mc.getAnArgument()
    )
  }
}

class ExecuteSink extends DataFlow::Node {
  ExecuteSink() {
    exists(MethodCall mc |
      mc.getMethod().getName().regexpMatch("execute|executemany|mogrify") and
      mc.getQualifier().getType().hasName("psycopg2") and
      this = mc.getArgument(1)
    )
  }
}

class ParamQuerySanitizer extends DataFlow::Node {
  ParamQuerySanitizer() {
    this.asStringConst().getStringValue().regexpMatches("^SELECT.*%s.*$")
  }
}

class Psycopg2SqlConfiguration extends TaintTracking::Configuration {
  Psycopg2SqlConfiguration() { this = "Psycopg2SqlConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource or
    source instanceof StringFormatSource or
    source instanceof StringModSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecuteSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParamQuerySanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodCall mc |
      (mc.getMethod().getName() = "format" or mc.getMethod().getName() = "__mod__") and
      node1 = mc.getAnArgument() and
      node2 = mc
    )
  }
}

from Psycopg2SqlConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), "Detected string concatenation with a non-literal variable in a psycopg2 SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized.",
  source.getNode(), "User input flows into SQL query here"
