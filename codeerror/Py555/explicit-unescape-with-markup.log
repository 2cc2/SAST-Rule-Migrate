Rule Content:
/**
 * @name Python Explicit Unescape with Markup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits 
 * the unescaped data to include unescaped HTML which could result in cross-site scripting.
 * Ensure this data is not externally controlled, or consider rewriting to not use 'Markup()'.
 * @kind path-problem
 * @problem.severity warning
 * @id python/explicit-unescape-with-markup
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class MarkupUnescapeSource extends AsyncCallable {
  MarkupUnescapeSource() {
    this.getPackage() = "flask" and
    this.getName() = "Markup" and
    this.getCallsiteKind() = "unescape" and
    exists(FunctionCallNode call |
      call.getTarget() = this and
      call.getArg(0).asExpr() = call.getEnclosingCallable().getAParameter()
    )
  }
}

class MarkupInitSink extends AsyncCallable {
  MarkupInitSink() {
    this.getPackage() = "flask" and
    this.getName() = "Markup" and
    this.getCallsiteKind() = "__init__"
  }
}

class MarkupUnescapeToInitConfiguration extends TaintTracking::Configuration {
  MarkupUnescapeToInitConfiguration() { this = "MarkupUnescapeToInitConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(MarkupUnescapeSource mus |
      source.asParameter() = mus.getAParameter()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(FunctionCallNode call, MarkupInitSink mis |
      call.getTarget() = mis and
      sink.asExpr() = call.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from MarkupUnescapeToInitConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected explicitly unescaped content using 'Markup()'. This permits the unescaped data to include unescaped HTML which could result in cross-site scripting."
