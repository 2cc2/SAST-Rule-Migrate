/**
 * @name Explicit unescape with markup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits the unescaped
 *              data to include unescaped HTML which could result in cross-site scripting. Ensure
 *              this data is not externally controlled, or consider rewriting to not use 'Markup()'.
 * @kind taint-problem
 * @problem.severity warning
 * @id python/explicit-unescape-with-markup
 */

import python
import semmle.python.security.dataflow.TaintTracking

class MarkupUnescapeSource extends DataFlow::Node {
  MarkupUnescapeSource() {
    exists(Call call |
      call.getFunc().(Attribute).getObject().(Name).getId() = "Markup" and
      call.getFunc().(Attribute).getAttr() = "unescape" and
      call.getArgument(0) = this.asExpr()
    )
  }
}

class MarkupInitSink extends DataFlow::Node {
  MarkupInitSink() {
    exists(Call call |
      call.getFunc().(Name).getId() = "Markup" and
      call.getFuncParentScope().(Class).getName() = "Markup" and
      call.getFuncParentScope().getFile().getAbsolutePath().matches("%flask%") and
      call.getArgument(0) = this.asExpr()
    )
  }
}

class MarkupTaintConfig extends TaintTracking::Configuration {
  MarkupTaintConfig() { this = "MarkupTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof MarkupUnescapeSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MarkupInitSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // ARG_TO_PARAM propagation
    exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
      node1.asExpr() = arg.getAnArg() and
      node2.asExpr() = param.getAnAccess() and
      arg.bindsTo(param)
    )
  }
}

from MarkupTaintConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Detected explicitly unescaped content using 'Markup()'. This permits the unescaped " +
       "data to include unescaped HTML which could result in cross-site scripting."
