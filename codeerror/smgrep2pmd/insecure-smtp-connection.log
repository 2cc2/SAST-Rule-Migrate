package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTBlock;
import net.sourceforge.pmd.lang.java.ast.ASTTryStatement;

public class InsecureSmtpConnectionRule extends AbstractJavaRulechainRule {

    public InsecureSmtpConnectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("send".equals(node.getMethodName())) {
            boolean hasSslConnect = false;
            boolean hasCheckIdentity = false;
            
            // Check parent block or try statement for all required settings
            ASTBlock parentBlock = node.ancestors(ASTBlock.class).first();
            if (parentBlock != null) {
                for (ASTExpression expr : parentBlock.descendants(ASTExpression.class)) {
                    if (expr instanceof ASTMethodCall) {
                        ASTMethodCall call = (ASTMethodCall) expr;
                        if ("setSSLOnConnect".equals(call.getMethodName())) {
                            hasSslConnect = true;
                        } else if ("setSSLCheckServerIdentity".equals(call.getMethodName())) {
                            hasCheckIdentity = true;
                        }
                    }
                }
            }
            
            // If SSL is on but no server identity check
            if (hasSslConnect && !hasCheckIdentity) {
                addViolation(data, node);
            }
        }
        return data;
    }
}
