# 修复策略说明：
1. 确保所有的Java源文件都以合法的package声明开头，而不是以#开头的注释
2. 每个规则类必须正确定义为public class并继承AbstractJavaRulechainRule
3. 修复AvoidMD5ForPasswordRule.java中的非法字符和语法错误
4. 移除所有文件开头可能存在的非法注释标记

# 修改后的完整规则示例：
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTBinaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class NoStringEqeqRule extends AbstractJavaRulechainRule {

    public NoStringEqeqRule() {
        super(ASTBinaryExpression.class);
    }

    @Override
    public Object visit(ASTBinaryExpression node, Object data) {
        if (node.getOperator().equals("==") || node.getOperator().equals("!=")) {
            ASTExpression leftOperand = node.getLeftOperand();
            ASTExpression rightOperand = node.getRightOperand();

            boolean leftIsString = isStringType(leftOperand);
            boolean rightIsString = isStringType(rightOperand);

            if ((leftIsString && !rightIsString && !isNullLiteral(rightOperand)) ||
                (rightIsString && !leftIsString && !isNullLiteral(leftOperand))) {
                asCtx(data).addViolation(node);
            }
        }
        return data;
    }

    private boolean isStringType(ASTExpression expr) {
        return expr instanceof ASTStringLiteral || 
               (expr instanceof ASTVariableAccess && 
                TypeTestUtil.isA(String.class, ((ASTVariableAccess) expr)));
    }

    private boolean isNullLiteral(ASTExpression expr) {
        return expr instanceof ASTStringLiteral && 
               "null".equals(((ASTStringLiteral) expr).getConstValue());
    }
}
