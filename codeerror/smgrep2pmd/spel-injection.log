package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

import org.springframework.expression.ExpressionParser;
import org.springframework.expression.spel.standard.SpelExpressionParser;
import org.springframework.expression.common.TemplateAwareExpressionParser;
import org.springframework.expression.spel.support.StandardEvaluationContext;


public class SpelInjectionRule extends AbstractJavaRulechainRule {

    public SpelInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isParseExpressionCall(node)) {
            ASTExpression arg = node.getArguments().get(0);
            if (isUnsafeExpression(arg)) {
                asCtx(data).addViolation(arg);
            }
        }
        return super.visit(node, data);
    }

    private boolean isParseExpressionCall(ASTMethodCall node) {
        return "parseExpression".equals(node.getMethodName())
                && (TypeTestUtil.isA(SpelExpressionParser.class, node.getQualifier())
                    || TypeTestUtil.isA(TemplateAwareExpressionParser.class, node.getQualifier()));
    }

    private boolean isUnsafeExpression(ASTExpression expr) {
        // Check if the argument contains variable access (not a constant string)
        return !expr.descendantsOrSelf()
                   .filterIs(ASTStringLiteral.class)
                   .nonEmpty() 
               || expr.descendantsOrSelf()
                   .filterIs(ASTVariableAccess.class)
                   .nonEmpty();
    }
}
