Rule Content:
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class JpaSqlInjectionRule extends AbstractJavaRulechainRule {

    public JpaSqlInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node == null) {
            return data;
        }
        
        String methodName = node.getMethodName();
        if (("createQuery".equals(methodName) || "createNativeQuery".equals(methodName))
            && TypeTestUtil.isA("javax.persistence.EntityManager", node.getQualifier())) {
            
            if (node.getArguments().size() > 0) {
                checkForConcatenation(node.getArguments().get(0), data);
            }
        }
        return data;
    }

    private void checkForConcatenation(ASTExpression expr, Object data) {
        if (expr == null) {
            return;
        }

        if (expr instanceof ASTStringLiteral) {
            ASTStringLiteral literal = (ASTStringLiteral) expr;
            String content = literal.getContent();
            if (content.contains("'+") || content.contains("+'") 
                || content.contains("+ '")) {
                asCtx(data).addViolation(literal);
            }
        }
        else if (expr instanceof ASTMethodCall) {
            ASTMethodCall methodCall = (ASTMethodCall) expr;
            if ("format".equals(methodCall.getMethodName()) 
                && TypeTestUtil.isA("java.lang.String", methodCall.getQualifier())) {
                asCtx(data).addViolation(methodCall);
            }
        }
    }
}
