package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTCompilationUnit;
import net.sourceforge.pmd.lang.java.ast.JavaNode;

public class JwtNoSignatureRule extends AbstractJavaRulechainRule {

    public JwtNoSignatureRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        if ("compact".equals(methodName)) {
            // Check if parent is Jwts.builder() chain without signWith()
            JavaNode parent = node.getParent();
            boolean hasSignWith = false;
            
            while (parent != null && parent instanceof ASTMethodCall) {
                ASTMethodCall methodCall = (ASTMethodCall) parent;
                if ("signWith".equals(methodCall.getMethodName())) {
                    hasSignWith = true;
                    break;
                }
                parent = methodCall.getParent();
            }
            
            if (!hasSignWith) {
                // Check if it's Jwts.builder() call
                JavaNode current = node;
                while (current != null && current instanceof ASTMethodCall) {
                    ASTMethodCall methodCall = (ASTMethodCall) current;
                    if ("builder".equals(methodCall.getMethodName())) {
                        ASTName qualifier = methodCall.getQualifier().getFirstDescendantOfType(ASTName.class);
                        if (qualifier != null && qualifier.getImage().endsWith("Jwts")) {
                            addViolation(data, node, "JWT token is created without signature");
                            break;
                        }
                    }
                    current = methodCall.getParent();
                }
            }
        }
        return super.visit(node, data);
    }
}
