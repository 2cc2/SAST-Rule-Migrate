// 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.rule.RuleContext;

public class JjwtNoneAlgRule extends AbstractJavaRule {

    public JjwtNoneAlgRule() {
        super.addRuleChainVisit(ASTClassOrInterfaceDeclaration.class);
    }

    @Override
    public Object visit(ASTClassOrInterfaceDeclaration node, Object data) {
        for (ASTMethodCall methodCall : node.findDescendantsOfType(ASTMethodCall.class)) {
            if (isJjwtBuilderWithoutSignWith(methodCall)) {
                ((RuleContext) data).addViolationWithMessage(methodCall, "JJWT builder used without specifying 'signWith'. This can lead to security issues.");
            }
        }
        return super.visit(node, data);
    }

    private boolean isJjwtBuilderWithoutSignWith(ASTMethodCall methodCall) {
        if ("compact".equals(methodCall.getMethodName())) {
            ASTMethodCall builderCall = methodCall.getFirstParentOfType(ASTMethodCall.class);
            while (builderCall != null && !"builder".equals(builderCall.getMethodName())) {
                builderCall = builderCall.getFirstParentOfType(ASTMethodCall.class);
            }
            if (builderCall != null) {
                for (ASTMethodCall siblingCall : builderCall.findChildrenOfType(ASTMethodCall.class)) {
                    if ("signWith".equals(siblingCall.getMethodName())) {
                        return false;
                    }
                }
                return true;
            }
        }
        return false;
    }
}
