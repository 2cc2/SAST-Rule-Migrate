package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;

public class JJWTNoneAlgorithmRule extends AbstractJavaRule {

    public JJWTNoneAlgorithmRule() {
        addRuleChainVisit(ASTVariableDeclaratorId.class);
        addRuleChainVisit(ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTVariableDeclaratorId node, Object data) {
        if (node.getName() != null) {
            ASTType typeNode = node.getTypeNode();
            if (typeNode != null && typeNode.getType() != null) {
                String typeName = typeNode.getType().getName();
                if (typeName != null && (typeName.contains("io.jsonwebtoken.JwtBuilder") || 
                                         typeName.contains("io.jsonwebtoken.Jwts"))) {
                    checkJWTCalls(node, data);
                }
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        ASTType resultTypeNode = node.getResultTypeNode();
        if (resultTypeNode != null && resultTypeNode.getType() != null) {
            String returnTypeName = resultTypeNode.getType().getName();
            if (returnTypeName != null && (returnTypeName.contains("io.jsonwebtoken.JwtBuilder") || 
                                          returnTypeName.contains("io.jsonwebtoken.Jwts"))) {
                checkJWTCalls(node, data);
            }
        }
        return super.visit(node, data);
    }

    private void checkJWTCalls(Node node, Object data) {
        for (ASTPrimaryExpression primaryExpr : node.findChildrenOfType(ASTPrimaryExpression.class)) {
            if (isJwtBuilderCall(primaryExpr) && !isInsideSecureMethod(primaryExpr)) {
                addViolation(data, primaryExpr, "Detected use of the 'none' algorithm in a JWT token. " +
                        "The 'none' algorithm assumes the integrity of the token has already " +
                        "been verified. This would allow a malicious actor to forge a JWT token " +
                        "that will automatically be verified. Do not explicitly use the 'none' " +
                        "algorithm. Instead, use an algorithm such like 'HS256'.");
            }
        }
    }

    private boolean isJwtBuilderCall(ASTPrimaryExpression expr) {
        ASTName name = expr.getFirstDescendantOfType(ASTName.class);
        return name != null && name.getImage() != null && name.getImage().contains("Jwts.builder");
    }

    private boolean isInsideSecureMethod(ASTPrimaryExpression expr) {
        ASTMethodDeclaration method = expr.getFirstParentOfType(ASTMethodDeclaration.class);
        if (method != null) {
            for (ASTPrimaryExpression innerExpr : method.findChildrenOfType(ASTPrimaryExpression.class)) {
                ASTName name = innerExpr.getFirstDescendantOfType(ASTName.class);
                if (name != null && name.getImage() != null && name.getImage().contains("signWith")) {
                    return true;
                }
            }
        }
        return false;
    }
}
