package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class JwtNoneAlgorithmRule extends AbstractJavaRulechainRule {

    public JwtNoneAlgorithmRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        
        // Check for Algorithm.none() calls
        if ("none".equals(methodName) && 
            TypeTestUtil.isA("com.auth0.jwt.algorithms.Algorithm", node.getQualifier())) {
            asCtx(data).addViolation(node);
        }
        
        // Check for JWT.create().sign(Algorithm.none())
        if ("sign".equals(methodName) && 
            TypeTestUtil.isA("com.auth0.jwt.JWT", node.getQualifier())) {
            node.getArguments().forEach(arg -> {
                if (arg instanceof ASTMethodCall) {
                    ASTMethodCall nestedCall = (ASTMethodCall)arg;
                    if ("none".equals(nestedCall.getMethodName()) && 
                        TypeTestUtil.isA("com.auth0.jwt.algorithms.Algorithm", nestedCall.getQualifier())) {
                        asCtx(data).addViolation(node);
                    }
                }
            });
        }
        
        return super.visit(node, data);
    }
}
