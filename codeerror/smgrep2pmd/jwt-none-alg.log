package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.ASTCompilationUnit;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class JWTSignatureCheckRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTCompilationUnit node, Object data) {
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("compact") 
                && isJWTSBuilderChain(node)) {
            if (!hasSignWithMethod(node)) {
                addViolation(data, node, "JWT token is missing signature configuration");
            }
        }
        return super.visit(node, data);
    }

    private boolean isJWTSBuilderChain(ASTMethodCall node) {
        ASTMethodCall previousCall = getPreviousMethodCallInChain(node);
        while (previousCall != null) {
            if ("builder".equals(previousCall.getMethodName()) 
                    && previousCall.getQualifier() != null 
                    && previousCall.getQualifier().getType() != null 
                    && "io.jsonwebtoken.Jwts".equals(previousCall.getQualifier().getType().getName())) {
                return true;
            }
            previousCall = getPreviousMethodCallInChain(previousCall);
        }
        return false;
    }

    private boolean hasSignWithMethod(ASTMethodCall node) {
        ASTMethodCall current = node;
        while ((current = getPreviousMethodCallInChain(current)) != null) {
            if ("signWith".equals(current.getMethodName())) {
                return true;
            }
        }
        return false;
    }

    private ASTMethodCall getPreviousMethodCallInChain(ASTMethodCall node) {
        if (node.getParent() != null 
                && node.getParent().getNumChildren() > 0 
                && node.getParent().getChild(0) instanceof ASTMethodCall) {
            return (ASTMethodCall) node.getParent().getChild(0);
        }
        return null;
    }
}
