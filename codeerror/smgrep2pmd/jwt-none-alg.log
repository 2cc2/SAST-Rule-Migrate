package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.properties.PropertyDescriptor;
import net.sourceforge.pmd.properties.PropertyFactory;

public class JJWTNoneAlgorithmRule extends AbstractJavaRule {

    public JJWTNoneAlgorithmRule() {
        addRuleChainVisit(ASTVariableDeclaratorId.class);
        addRuleChainVisit(ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTVariableDeclaratorId node, Object data) {
        if (node.getName() != null) {
            String typeName = node.getType() != null ? node.getType().getName() : "";
            if (typeName.contains("io.jsonwebtoken.JwtBuilder") || typeName.contains("io.jsonwebtoken.Jwts")) {
                checkJWTCalls(node, data);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        ASTResultType returnType = node.getResultType();
        if (returnType != null) {
            String returnTypeName = returnType.getTypeImage();
            if (returnTypeName != null && (returnTypeName.contains("io.jsonwebtoken.JwtBuilder") ||
                                          returnTypeName.contains("io.jsonwebtoken.Jwts"))) {
                checkJWTCalls(node, data);
            }
        }
        return super.visit(node, data);
    }

    private void checkJWTCalls(ASTNode node, Object data) {
        node.findChildrenOfType(ASTMethodCall.class)
            .stream()
            .filter(methodCall -> {
                String methodName = methodCall.getMethodName();
                String image = methodCall.getImage();
                return "builder".equals(methodName) && 
                       (image != null && image.contains("io.jsonwebtoken.Jwts"));
            })
            .forEach(methodCall -> {
                if (!isInsideSecureMethod(methodCall)) {
                    addViolation(data, methodCall, "Detected use of the 'none' algorithm in a JWT token. " +
                            "The 'none' algorithm assumes the integrity of the token has already " +
                            "been verified. This would allow a malicious actor to forge a JWT token " +
                            "that will automatically be verified. Do not explicitly use the 'none' " +
                            "algorithm. Instead, use an algorithm such as 'HS256'.");
                }
            });
    }

    private boolean isInsideSecureMethod(ASTMethodCall methodCall) {
        return methodCall.ancestors()
                        .filter(ASTMethodDeclaration.class::isInstance)
                        .map(ASTMethodDeclaration.class::cast)
                        .anyMatch(method -> {
                            return method.findDescendantsOfType(ASTMethodCall.class)
                                        .stream()
                                        .anyMatch(call -> "signWith".equals(call.getMethodName()));
                        });
    }
}
