package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.ASTCompilationUnit;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTPrimarySuffix;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class JWTSignatureCheckRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTCompilationUnit node, Object data) {
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTPrimaryExpression node, Object data) {
        if (isCompactMethodCall(node) && isJWTSBuilderChain(node)) {
            if (!hasSignWithMethod(node)) {
                addViolation(data, node, "JWT token is missing signature configuration");
            }
        }
        return super.visit(node, data);
    }

    private boolean isCompactMethodCall(ASTPrimaryExpression node) {
        ASTPrimarySuffix suffix = node.getFirstDescendantOfType(ASTPrimarySuffix.class);
        return suffix != null && "compact".equals(suffix.getImage());
    }

    private boolean isJWTSBuilderChain(ASTPrimaryExpression node) {
        ASTPrimaryPrefix prefix = node.getFirstDescendantOfType(ASTPrimaryPrefix.class);
        if (prefix != null) {
            ASTPrimarySuffix suffix = prefix.getNextSiblingOfType(ASTPrimarySuffix.class);
            while (suffix != null) {
                if ("builder".equals(suffix.getImage())) {
                    return true;
                }
                suffix = suffix.getNextSiblingOfType(ASTPrimarySuffix.class);
            }
        }
        return false;
    }

    private boolean hasSignWithMethod(ASTPrimaryExpression node) {
        ASTPrimarySuffix suffix = node.getFirstDescendantOfType(ASTPrimarySuffix.class);
        while (suffix != null) {
            if ("signWith".equals(suffix.getImage())) {
                return true;
            }
            suffix = suffix.getNextSiblingOfType(ASTPrimarySuffix.class);
        }
        return false;
    }
}
