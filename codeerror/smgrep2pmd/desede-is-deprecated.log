package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.crypto.Cipher;

public class DesedeDeprecatedRule extends AbstractJavaRulechainRule {

    public DesedeDeprecatedRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("getInstance")) {
            // Check for Cipher.getInstance calls
            if (node.getQualifier() != null && TypeTestUtil.isA(Cipher.class, node.getQualifier())) {
                // Check arguments for DESede pattern
                node.getArguments().forEach(arg -> {
                    if (arg instanceof ASTStringLiteral) {
                        String algorithm = ((ASTStringLiteral) arg).getContent();
                        if (algorithm != null && (algorithm.contains("DESede") || algorithm.contains("DES"))) {
                            asCtx(data).addViolation(node);
                        }
                    }
                });
            }
        }
        return data;
    }
}
