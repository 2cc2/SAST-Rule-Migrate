package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.crypto.Cipher;

public class DesedeDeprecatedRule extends AbstractJavaRulechainRule {

    public DesedeDeprecatedRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("getInstance".equals(node.getMethodName())) {
            if (node.getQualifier() != null 
                && TypeTestUtil.isA(Cipher.class, node.getQualifier())) {
                
                for (int i = 0; i < node.getArguments().size(); i++) {
                    if (node.getArgument(i) instanceof ASTStringLiteral) {
                        String algorithm = ((ASTStringLiteral) node.getArgument(i)).getConstValue();
                        if (algorithm != null && 
                            (algorithm.contains("DESede") || algorithm.contains("DES"))) {
                            asCtx(data).addViolation(node);
                        }
                    }
                }
            }
        }
        return data;
    }
}
