  import javax.net.ssl.HttpsURLConnection;
  import javax.net.ssl.SSLSession;

5. 修正PMD规则继承结构
- 确保所有规则类都继承自AbstractJavaRulechainRule
- 正确实现visit方法

6. 配置Maven编译器插件
- 在pom.xml中添加:
  <properties>
