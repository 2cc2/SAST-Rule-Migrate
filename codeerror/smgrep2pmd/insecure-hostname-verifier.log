# 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.net.ssl.HostnameVerifier;
import javax.net.ssl.HttpsURLConnection;
import javax.net.ssl.SSLSession;

public class InsecureHostnameVerifierRule extends AbstractJavaRulechainRule {
    
    public InsecureHostnameVerifierRule() {
        super(ASTClassOrInterfaceDeclaration.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTClassOrInterfaceDeclaration node, Object data) {
        if (TypeTestUtil.isA(HostnameVerifier.class, node)) {
            for (ASTMethodDeclaration method : node.findChildrenOfType(ASTMethodDeclaration.class)) {
                if ("verify".equals(method.getName()) && method.getFormalParameters().size() == 2) {
                    if (method.getBody().toString().contains("return true;")) {
                        asCtx(data).addViolation(method);
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("setDefaultHostnameVerifier".equals(node.getMethodName()) 
                && TypeTestUtil.isA(HttpsURLConnection.class, node.getQualifier())) {
            if (node.getArguments().size() == 1 
                    && node.getArgument(0).toString().contains("verify(String hostname, SSLSession session)")) {
                asCtx(data).addViolation(node);
            }
        }
        return super.visit(node, data);
    }
}
```

