Rule Content:
package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTAllocationExpression;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceType;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class UnsafeSnakeYamlConstructorRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (isYamlConstructor(node) && !hasSafeConstructor(node)) {
            addViolation(data, node, "Unsafe Yaml constructor detected. Use SafeConstructor instead.");
        }
        return super.visit(node, data);
    }

    private boolean isYamlConstructor(ASTConstructorCall node) {
        ASTClassOrInterfaceType type = node.getFirstChildOfType(ASTClassOrInterfaceType.class);
        return type != null && "Yaml".equals(type.getImage());
    }

    private boolean hasSafeConstructor(ASTConstructorCall node) {
        ASTConstructorCall constructorArg = node.getFirstChildOfType(ASTConstructorCall.class);
        if (constructorArg != null) {
            ASTClassOrInterfaceType argType = constructorArg.getFirstChildOfType(ASTClassOrInterfaceType.class);
            return argType != null && "SafeConstructor".equals(argType.getImage());
        }
        
        ASTName name = node.getFirstChildOfType(ASTName.class);
        return name != null && name.getImage().contains("SafeConstructor");
    }
}
