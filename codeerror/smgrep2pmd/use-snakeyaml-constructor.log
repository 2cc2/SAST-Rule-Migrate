package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class SnakeYamlConstructorRule extends AbstractJavaRulechainRule {

    public SnakeYamlConstructorRule() {
        super(ASTConstructorCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA("org.yaml.snakeyaml.Yaml", node)) {
            // 检查是否使用了不安全的无参构造函数
            if (node.getArguments().size() == 0) {
                addViolation(data, node);
            }
            // 进一步检查是否使用了SafeConstructor以外的构造函数
            else if (!TypeTestUtil.isA("org.yaml.snakeyaml.constructor.SafeConstructor", node.getArguments().get(0))) {
                addViolation(data, node);
            }
        }
        return data;
    }
}
