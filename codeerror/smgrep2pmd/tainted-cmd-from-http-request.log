package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class TaintedCommandFromHttpRequestRule extends AbstractJavaRulechainRule {
    public TaintedCommandFromHttpRequestRule() {
        super(ASTMethodCall.class, ASTAdditiveExpression.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isProcessBuilderStartCall(node) || isRuntimeExecCall(node)) {
            checkForTaintedArguments(node, data);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTAdditiveExpression node, Object data) {
        if (node.getOperator() == "+" && isCommandStringConstruction(node)) {
            checkForTaintedOperands(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isProcessBuilderStartCall(ASTMethodCall node) {
        return "start".equals(node.getMethodName()) 
                && TypeTestUtil.isA(ProcessBuilder.class, node.getQualifier());
    }

    private boolean isRuntimeExecCall(ASTMethodCall node) {
        return "exec".equals(node.getMethodName()) 
                && TypeTestUtil.isA(Runtime.class, node.getQualifier());
    }

    private boolean isCommandStringConstruction(ASTAdditiveExpression node) {
        Node parent = node.getParent();
        if (parent instanceof ASTArgumentList) {
            Node grandparent = parent.getParent();
            return grandparent instanceof ASTMethodCall 
                    && isProcessBuilderConstruction((ASTMethodCall) grandparent);
        }
        return false;
    }

    private boolean isProcessBuilderConstruction(ASTMethodCall node) {
        return TypeTestUtil.isA(ProcessBuilder.class, node) 
                && ("<init>".equals(node.getMethodName()) || "command".equals(node.getMethodName()));
    }

    private void checkForTaintedArguments(ASTMethodCall node, Object data) {
        ASTArgumentList args = node.getArguments();
        for (int i = 0; i < args.size(); i++) {
            ASTExpression arg = args.get(i);
            if (isTaintedSource(arg)) {
                addViolation(data, node);
            }
        }
    }

    private void checkForTaintedOperands(ASTAdditiveExpression node, Object data) {
        if (isTaintedSource(node.getLeftOperand()) || isTaintedSource(node.getRightOperand())) {
            addViolation(data, node);
        }
    }

    private boolean isTaintedSource(ASTExpression expr) {
        // Check if expression comes from HTTP request
        if (expr instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) expr;
            return isRequestParameter(varAccess.getSignature().getSymbol().getName());
        } else if (expr instanceof ASTMethodCall) {
            ASTMethodCall call = (ASTMethodCall) expr;
            return isRequestParameterMethod(call);
        }
        return false;
    }

    private boolean isRequestParameter(String varName) {
        return varName != null && 
               (varName.equals("param") || varName.equals("bar") || varName.equals("argsEnv"));
    }

    private boolean isRequestParameterMethod(ASTMethodCall node) {
        return "getHeader".equals(node.getMethodName()) 
                || "getParameter".equals(node.getMethodName())
                || "getCookie".equals(node.getMethodName())
                || "getCookies".equals(node.getMethodName());
    }
}
