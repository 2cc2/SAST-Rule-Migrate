# 修正后的PMD规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class TaintedSessionFromHttpRequestRule extends AbstractJavaRulechainRule {

    public TaintedSessionFromHttpRequestRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isSessionSetAttributeCall(node) || isSessionPutValueCall(node)) {
            ASTArguments args = node.getArguments();
            if (args.size() >= 2) {
                ASTExpression secondArg = args.get(1);
                if (isParameterFromRequest(secondArg)) {
                    addViolation(data, node);
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isSessionSetAttributeCall(ASTMethodCall node) {
        return node.getMethodName().equals("setAttribute")
                && TypeTestUtil.isA("javax.servlet.http.HttpSession", node.getQualifier());
    }

    private boolean isSessionPutValueCall(ASTMethodCall node) {
        return node.getMethodName().equals("putValue")
                && TypeTestUtil.isA("javax.servlet.http.HttpSession", node.getQualifier());
    }

    private boolean isParameterFromRequest(ASTExpression expr) {
        if (expr instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) expr;
            SymbolReference symbolRef = varAccess.getReferencedSym();
            if (symbolRef != null && symbolRef.hasTryNode()) {
                ASTVariableDeclaratorId varDecl = symbolRef.getTryNode();
                ASTExpression init = varDecl.getInitializer();
                if (init != null && isRequestSource(init)) {
                    return true;
                }
            }
        }
        return false;
    }

    private boolean isRequestSource(ASTExpression expr) {
        if (expr instanceof ASTMethodCall) {
            ASTMethodCall call = (ASTMethodCall) expr;
            return call.getMethodName().matches("getCookies|getHeaders|getParameter")
                    || (call.getMethodName().equals("getValue") 
                        && call.getQualifier() instanceof ASTMethodCall
                        && ((ASTMethodCall)call.getQualifier()).getMethodName().equals("nextElement"));
        }
        return false;
    }
}
