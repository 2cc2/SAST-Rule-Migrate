# 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.InternalApiBridge;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class FindSqlStringConcatenationRule extends AbstractJavaRulechainRule {

    public FindSqlStringConcatenationRule() {
        super(ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        for (JavaNode child : node.descendants()) {
            if (child instanceof ASTExpression) {
                checkSqlStringConcatenation((ASTExpression) child, data);
            }
        }
        return data;
    }

    private void checkSqlStringConcatenation(ASTExpression expr, Object data) {
        if (expr.getNumChildren() == 0) {
            return;
        }

        // 检查SQL字符串字面量
        boolean hasSqlLiteral = false;
        for (ASTStringLiteral lit : expr.descendantsOrSelf().filter(ASTStringLiteral.class)) {
            if (lit.getText().toLowerCase().contains("select")) {
                hasSqlLiteral = true;
                break;
            }
        }

        // 检查字符串拼接操作符
        boolean hasStringConcatenation = false;
        for (JavaNode child : expr.descendantsOrSelf()) {
            if ("+".equals(child.getImage())) {
                hasStringConcatenation = true;
                break;
            }
        }

        // 检查变量访问
        boolean hasVariable = !expr.descendantsOrSelf().filter(ASTVariableAccess.class).isEmpty();

        if (hasSqlLiteral && hasStringConcatenation && hasVariable) {
            asCtx(data).addViolation(expr);
        }
    }
}
