            package package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class TaintedSqlStringRule extends AbstractJavaRulechainRule {

    public TaintedSqlStringRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class, ASTAssignmentExpression.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isSqlStringConcatenation(node)) {
            asCtx(data).addViolation(node);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTAssignmentExpression node, Object data) {
        ASTExpression rightOperand = node.getRightOperand();
        if (isSqlStringLiteral(rightOperand)) {
            asCtx(data).addViolation(node);
        }
        return super.visit(node, data);
    }

    private boolean isSqlStringConcatenation(ASTMethodCall node) {
        // Check if the method is .concat() or String.format()
        String methodName = node.getMethodName();
        return "concat".equals(methodName) || "format".equals(methodName);
    }

    private boolean isSqlStringLiteral(ASTExpression expression) {
        if (expression instanceof ASTStringLiteral) {
            String literal = ((ASTStringLiteral) expression).getImage();
            return literal.matches("(?i)(select|delete|insert|create|update|alter|drop)\\b");
        }
        return false;
    }
}确保包路径为package package com.example.pmdrules;
