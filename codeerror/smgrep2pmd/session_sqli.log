            package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceType;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.AbstractJavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SeamLogInjectionRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        if (isLogInfoCall(node)) {
            ASTArgumentList args = node.getFirstChildOfType(ASTArgumentList.class);
            if (args != null && args.getNumChildren() > 0) {
                AbstractJavaNode firstArg = (AbstractJavaNode) args.getChild(0);
                if (isStringConcatenation(firstArg)) {
                    addViolation(data, node, "Potential log injection vulnerability detected");
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isLogInfoCall(ASTMethodDeclaration node) {
        return "info".equals(node.getMethodName())
            && node.getFirstChildOfType(ASTPrimaryExpression.class) != null
            && node.getFirstChildOfType(ASTPrimaryExpression.class)
                   .getFirstChildOfType(ASTPrimaryPrefix.class)
                   .getFirstChildOfType(ASTName.class) != null
            && node.getFirstChildOfType(ASTPrimaryExpression.class)
                   .getFirstChildOfType(ASTPrimaryPrefix.class)
                   .getFirstChildOfType(ASTName.class)
                   .getImage().endsWith("log");
    }

    private boolean isStringConcatenation(AbstractJavaNode node) {
        // Check for string concatenation with '+'
        return node.findChildrenOfType(ASTLiteral.class).stream()
            .anyMatch(lit -> lit.isStringLiteral() && node.hasDescendantOfType(ASTClassOrInterfaceType.class));
    }
}
