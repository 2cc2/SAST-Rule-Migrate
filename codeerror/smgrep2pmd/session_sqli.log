package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;

public class SqlStringConcatenationRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        checkForSqlConcatenation(node, data);
        return super.visit(node, data);
    }

    private void checkForSqlConcatenation(ASTMethodDeclaration methodNode, Object data) {
        // Check for string concatenation patterns
        methodNode.descendants(ASTVariableDeclaratorId.class)
            .filter(var -> {
                // Check if variable is used in string concatenation
                ASTVariableDeclarator declarator = var.getParent();
                ASTExpression initializer = declarator.getInitializer();
                if (initializer instanceof ASTAdditiveExpression) {
                    ASTAdditiveExpression addExpr = (ASTAdditiveExpression) initializer;
                    return containsVariableReference(addExpr, var.getName());
                }
                return false;
            })
            .forEach(var -> {
                // Check if the concatenated string is used in prepareStatement
                String varName = var.getName();
                methodNode.descendants(ASTMethodCall.class)
                    .filter(mcall -> mcall.getMethodName().equals("prepareStatement"))
                    .filter(mcall -> {
                        // Verify the argument to prepareStatement references our variable
                        ASTArgumentList args = mcall.getFirstChildOfType(ASTArgumentList.class);
                        if (args != null) {
                            for (Node arg : args.children()) {
                                if (arg instanceof ASTName &&
                                    arg.hasDescendantOfType(ASTName.class, n -> n.getImage().contains(varName))) {
                                    return true;
                                }
                            }
                        }
                        return false;
                    })
                    .forEach(mcall -> {
                        // Found SQL injection vulnerability
                        addViolation(data, declarator, "In " + methodNode.getName() + 
                            ", " + varName + " is used to construct a SQL query via string concatenation.");
                    });
            });
    }

    private boolean containsVariableReference(ASTExpression expr, String varName) {
        return expr.descendants(ASTName.class)
            .anyMatch(name -> name.getImage().equals(varName));
    }
}
