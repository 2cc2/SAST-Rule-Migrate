package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SqlStringConcatenationRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTVariableDeclarator node, Object data) {
        if (node.getInitializer() instanceof ASTAdditiveExpression) {
            ASTAdditiveExpression additiveExpr = (ASTAdditiveExpression) node.getInitializer();
            if (containsSqlString(additiveExpr)) {
                addViolation(data, node, "Detected SQL query string concatenation, this may lead to SQL injection");
            }
        }
        return super.visit(node, data);
    }

    private boolean containsSqlString(ASTAdditiveExpression expr) {
        for (ASTLiteral literal : expr.findDescendantsOfType(ASTLiteral.class)) {
            if (literal.getImage() != null && literal.getImage().toLowerCase().contains("select") 
                && literal.getImage().toLowerCase().contains("from")) {
                return true;
            }
        }
        
        for (ASTPrimaryExpression primaryExpr : expr.findDescendantsOfType(ASTPrimaryExpression.class)) {
            for (ASTPrimaryPrefix prefix : primaryExpr.findChildrenOfType(ASTPrimaryPrefix.class)) {
                if (prefix.getFirstDescendantOfType(ASTLiteral.class) != null) {
                    ASTLiteral lit = prefix.getFirstDescendantOfType(ASTLiteral.class);
                    if (lit.getImage() != null && lit.getImage().toLowerCase().contains("select") 
                        && lit.getImage().toLowerCase().contains("from")) {
                        return true;
                    }
                }
            }
        }
        return false;
    }

    @Override
    public Object visit(ASTPrimaryExpression node, Object data) {
        if (node.getFirstDescendantOfType(ASTAdditiveExpression.class) != null) {
            ASTAdditiveExpression additiveExpr = node.getFirstDescendantOfType(ASTAdditiveExpression.class);
            if (containsSqlString(additiveExpr)) {
                addViolation(data, node, "Detected SQL query string concatenation, this may lead to SQL injection");
            }
        }
        return super.visit(node, data);
    }
}
