java
package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SqlStringConcatenationRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        // Check for method parameters with String type
        ASTFormalParameters params = node.getFirstChildOfType(ASTFormalParameters.class);
        if (params == null) {
            return super.visit(node, data);
        }

        boolean hasStringParam = false;
        for (ASTFormalParameter param : params.findDescendantsOfType(ASTFormalParameter.class)) {
            ASTType type = param.getFirstChildOfType(ASTType.class);
            if (type != null && "String".equals(type.getTypeImage())) {
                hasStringParam = true;
                break;
            }
        }

        if (!hasStringParam) {
            return super.visit(node, data);
        }

        // Check for string concatenation used in SQL query
        for (ASTVariableDeclarator varDecl : node.findDescendantsOfType(ASTVariableDeclarator.class)) {
            if (varDecl.getName() == null) {
                continue;
            }

            ASTVariableInitializer initializer = varDecl.getFirstChildOfType(ASTVariableInitializer.class);
            if (initializer == null) {
                continue;
            }

            // Check for string concatenation
            if (initializer.hasDescendantOfType(ASTAdditiveExpression.class)) {
                // Check if this variable is used in prepareStatement
                for (ASTPrimaryExpression expr : node.findDescendantsOfType(ASTPrimaryExpression.class)) {
                    ASTPrimaryPrefix prefix = expr.getFirstChildOfType(ASTPrimaryPrefix.class);
                    if (prefix == null) {
                        continue;
                    }

                    ASTName name = prefix.getFirstChildOfType(ASTName.class);
                    if (name == null || !name.getImage().contains("prepareStatement")) {
                        continue;
                    }

                    ASTArguments args = expr.getFirstChildOfType(ASTArguments.class);
                    if (args != null && args.getNumChildren() > 0) {
                        ASTExpression argExpr = args.getFirstChildOfType(ASTExpression.class);
                        if (argExpr != null && argExpr.hasDescendantOfType(ASTName.class)) {
                            ASTName argName = argExpr.getFirstDescendantOfType(ASTName.class);
                            if (argName != null && argName.getImage().equals(varDecl.getName())) {
                                addViolation(data, node, "In " + node.getMethodName() + 
                                    ", SQL query constructed via string concatenation may lead to SQL injection");
                            }
                        }
                    }
                }
            }
        }

        return super.visit(node, data);
    }
}
