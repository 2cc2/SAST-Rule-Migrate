// 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclarator;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.rule.RuleContext;

public class DetectSqlStringConcatenationRule extends AbstractJavaRule {

    public DetectSqlStringConcatenationRule() {
        addRuleChainVisit(ASTVariableDeclarator.class);
    }

    @Override
    public Object visit(ASTVariableDeclarator node, Object data) {
        if (node.hasDescendantOfType(ASTLiteral.class)) {
            ASTLiteral literal = node.getFirstDescendantOfType(ASTLiteral.class);
            if (literal.isStringLiteral() && literal.getImage().matches(".*select\\s+foo\\s+from\\s+bar\\s+where.*")) {
                ASTMethodCall methodCall = node.getFirstParentOfType(ASTMethodCall.class);
                if (methodCall != null && methodCall.getMethodName().equals("prepareStatement")) {
                    RuleContext ctx = (RuleContext) data;
                    addViolation(ctx, node);
                }
            }
        }
        return super.visit(node, data);
    }
}
