package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTAdditiveExpression;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTPreparedStatement;
import net.sourceforge.pmd.lang.java.ast.JavaNode;

public class SqlStringConcatenationRule extends AbstractJavaRulechainRule {

    public SqlStringConcatenationRule() {
        super(ASTPreparedStatement.class);
    }

    @Override
    public Object visit(ASTPreparedStatement node, Object data) {
        ASTMethodCall prepareCall = node.getFirstParentOfType(ASTMethodCall.class);
        if (prepareCall != null && "prepareStatement".equals(prepareCall.getMethodName())) {
            ASTExpression arg = prepareCall.getArguments().get(0);
            checkStringConcatenation(arg, data);
        }
        return super.visit(node, data);
    }

    private void checkStringConcatenation(ASTExpression expr, Object data) {
        if (expr instanceof ASTAdditiveExpression) {
            ASTAdditiveExpression additive = (ASTAdditiveExpression) expr;
            if (isStringConcatenation(additive)) {
                asCtx(data).addViolation(expr);
            }
        } else if (expr instanceof ASTVariableAccess) {
            // TODO: Track variable definitions back to their origins
        }
    }

    private boolean isStringConcatenation(ASTAdditiveExpression expr) {
        return expr.descendantsOrSelf()
            .filterIs(ASTStringLiteral.class)
            .nonEmpty() && 
            expr.hasOperandsMatching(
                operand -> operand instanceof ASTStringLiteral || 
                           operand instanceof ASTVariableAccess
            );
    }
}
