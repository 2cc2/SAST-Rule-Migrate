// 转换后的 PMD 规则
package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.properties.PropertyDescriptor;
import net.sourceforge.pmd.properties.PropertyFactory;

public class SqlStringConcatenationRule extends AbstractJavaRule {
    
    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        // 检查方法体内是否存在字符串拼接构造SQL查询的情况
        node.getBody().accept(new JavaNodeVisitorAdapter() {
            private boolean hasSessionVariable = false;
            private boolean hasStringConcatenation = false;
            private boolean hasPrepareStatement = false;
            private boolean hasExecuteQuery = false;
            
            @Override
            public Object visit(ASTVariableDeclaratorId node, Object data) {
                if ("Session".equals(node.getTypeImage())) {
                    hasSessionVariable = true;
                }
                return super.visit(node, data);
            }
            
            @Override
            public Object visit(ASTAdditiveExpression node, Object data) {
                // 检测字符串拼接
                if (node.getImage().equals("+")) {
                    hasStringConcatenation = true;
                }
                return super.visit(node, data);
            }
            
            @Override
            public Object visit(ASTMethodCall node, Object data) {
                String methodName = node.getMethodName();
                if ("prepareStatement".equals(methodName) && hasSessionVariable) {
                    hasPrepareStatement = true;
                } else if ("executeQuery".equals(methodName) && hasPrepareStatement) {
                    hasExecuteQuery = true;
                }
                
                if (hasStringConcatenation && hasExecuteQuery) {
                    addViolation(data, node, "In " + ((ASTMethodDeclaration)node.getNthParent(4)).getMethodName() + 
                        ", string concatenation is used to construct SQL query which could lead to SQL Injection.");
                }
                return super.visit(node, data);
            }
        }, data);
        
        return super.visit(node, data);
    }
}
