// 转换后的 PMD 规则
package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;

public class SqlStringConcatenationRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        boolean hasStringParameter = false;
        boolean hasSession = false;
        boolean hasQueryConcatenation = false;
        boolean hasPrepareStatement = false;
        boolean hasExecuteQuery = false;

        // Check for String parameters
        for (ASTFormalParameter param : node.findDescendantsOfType(ASTFormalParameter.class)) {
            if (param.getTypeNode() instanceof ASTReferenceType) {
                ASTReferenceType refType = (ASTReferenceType) param.getTypeNode();
                if (refType.getType() != null && "java.lang.String".equals(refType.getType().getName())) {
                    hasStringParameter = true;
                    break;
                }
            }
        }

        if (!hasStringParameter) {
            return super.visit(node, data);
        }

        // Check for required patterns in method body
        for (ASTVariableDeclarator varDecl : node.findDescendantsOfType(ASTVariableDeclarator.class)) {
            if ("Session".equals(varDecl.getTypeNode().getTypeImage())) {
                hasSession = true;
            }
        }

        for (ASTAssignmentOperator assign : node.findDescendantsOfType(ASTAssignmentOperator.class)) {
            ASTVariableDeclarator varDecl = assign.getFirstParentOfType(ASTVariableDeclarator.class);
            if (varDecl != null && "String".equals(varDecl.getTypeNode().getTypeImage())) {
                if (assign.getFirstDescendantOfType(ASTAdditiveExpression.class) != null) {
                    hasQueryConcatenation = true;
                }
            }
        }

        for (ASTPrimaryExpression expr : node.findDescendantsOfType(ASTPrimaryExpression.class)) {
            if (expr.findChildrenOfType(ASTPrimaryPrefix.class).size() > 0) {
                ASTPrimaryPrefix prefix = expr.getFirstDescendantOfType(ASTPrimaryPrefix.class);
                if (prefix != null && prefix.hasImageEqualTo("prepareStatement")) {
                    hasPrepareStatement = true;
                } else if (prefix != null && prefix.hasImageEqualTo("executeQuery")) {
                    hasExecuteQuery = true;
                }
            }
        }

        if (hasSession && hasQueryConcatenation && hasPrepareStatement && hasExecuteQuery) {
            addViolation(data, node, "In " + node.getMethodName() + ", string concatenation is used to construct SQL query");
        }

        return super.visit(node, data);
    }
}
