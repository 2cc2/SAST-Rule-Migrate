// 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTAdditiveExpression;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclarator;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SqlStringConcatenationRule extends AbstractJavaRule {

    public SqlStringConcatenationRule() {
        addRuleChainVisit(ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        node.findDescendantsOfType(ASTVariableDeclarator.class).stream()
            .filter(var -> var.hasDescendantOfType(ASTAdditiveExpression.class))
            .forEach(var -> {
                ASTAdditiveExpression expr = var.getFirstDescendantOfType(ASTAdditiveExpression.class);
                if (expr.hasDescendantOfType(ASTLiteral.class) && isSqlQuery(expr)) {
                    addViolation(data, expr);
                }
            });
        return data;
    }

    private boolean isSqlQuery(ASTAdditiveExpression expr) {
        return expr.getImage().matches(".*select\\s+.*from\\s+.*where\\s+.*");
    }
}
