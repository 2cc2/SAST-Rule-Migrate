package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.typeresolution.TypeSystem;
import net.sourceforge.pmd.lang.ast.Node;

public class SqlStringConcatenationRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        ASTVariableDeclaratorId parameter = findStringParameter(node);
        if (parameter == null) {
            return super.visit(node, data);
        }

        ASTLocalVariableDeclaration queryVar = findQueryString(node, parameter);
        if (queryVar == null) {
            return super.visit(node, data);
        }

        ASTLocalVariableDeclaration sessionVar = findSessionVariable(node);
        if (sessionVar == null) {
            return super.visit(node, data);
        }

        boolean hasPrepareStatementCall = hasPrepareStatementCall(node, queryVar, sessionVar);
        if (hasPrepareStatementCall) {
            String methodName = node.getMethodName();
            addViolation(data, node, "In " + methodName + ", " + parameter.getName() 
                + " is used to construct a SQL query via string concatenation.");
        }

        return super.visit(node, data);
    }

    private ASTVariableDeclaratorId findStringParameter(ASTMethodDeclaration method) {
        return method.firstChild(ASTFormalParameters.class)
            .children(ASTFormalParameter.class)
            .stream()
            .filter(p -> p.getTypeNode().getType() == TypeSystem.getType(String.class))
            .map(p -> p.firstChild(ASTVariableDeclaratorId.class))
            .findFirst()
            .orElse(null);
    }

    private ASTLocalVariableDeclaration findQueryString(ASTMethodDeclaration method, ASTVariableDeclaratorId param) {
        ASTBlock block = method.firstChild(ASTBlock.class);
        return block.descendants(ASTLocalVariableDeclaration.class)
            .stream()
            .filter(var -> var.getTypeNode().getType() == TypeSystem.getType(String.class))
            .filter(var -> {
                ASTInfixExpression expr = var.firstDescendant(ASTInfixExpression.class);
                return expr != null && containsParameterAccess(expr, param.getName());
            })
            .findFirst()
            .orElse(null);
    }

    private boolean containsParameterAccess(ASTInfixExpression expr, String paramName) {
        return expr.descendants(ASTPrimaryExpression.class)
            .stream()
            .anyMatch(pe -> pe.hasDecendantMatching(n -> 
                n instanceof ASTPrimaryPrefix 
                && ((ASTPrimaryPrefix)n).getImage() != null 
                && ((ASTPrimaryPrefix)n).getImage().equals(paramName)));
    }

    private ASTLocalVariableDeclaration findSessionVariable(ASTMethodDeclaration method) {
        ASTBlock block = method.firstChild(ASTBlock.class);
        return block.descendants(ASTLocalVariableDeclaration.class)
            .stream()
            .filter(var -> var.getFirstChildOfType(ASTType.class).getTypeImage().equals("Session"))
            .findFirst()
            .orElse(null);
    }

    private boolean hasPrepareStatementCall(ASTMethodDeclaration method, ASTLocalVariableDeclaration queryVar, 
                                          ASTLocalVariableDeclaration sessionVar) {
        return method.firstChild(ASTBlock.class)
            .descendants(ASTPrimaryExpression.class)
            .stream()
            .anyMatch(pe -> {
                ASTPrimarySuffix suffix = pe.firstDescendant(ASTPrimarySuffix.class);
                if (suffix == null || suffix.getImage() == null || !suffix.getImage().equals("prepareStatement")) {
                    return false;
                }
                
                ASTArgumentList args = pe.firstDescendant(ASTArgumentList.class);
                return args != null && args.descendants(ASTPrimaryExpression.class)
                    .anyMatch(n -> n.getImage() != null 
                        && n.getImage().equals(queryVar.getVariableDeclaratorId().getName()));
            });
    }
}
