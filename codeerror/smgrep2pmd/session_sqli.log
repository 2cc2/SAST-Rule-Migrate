package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTBinaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class SqlStringConcatenationRule extends AbstractJavaRulechainRule {

    public SqlStringConcatenationRule() {
        super(ASTMethodCall.class, ASTBinaryExpression.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("prepareStatement")) {
            JavaNode argument = node.getArguments().get(0);
            if (argument instanceof ASTBinaryExpression) {
                checkForStringConcatenation((ASTBinaryExpression) argument, data);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTBinaryExpression node, Object data) {
        checkForStringConcatenation(node, data);
        return super.visit(node, data);
    }

    private void checkForStringConcatenation(ASTBinaryExpression node, Object data) {
        if (node.getOperator().equals("+")) {
            if (node.getLeftOperand() instanceof ASTStringLiteral || 
                node.getRightOperand() instanceof ASTStringLiteral) {
                if (containsSqlKeyword(node)) {
                    asCtx(data).addViolation(node);
                }
            }
        }
    }

    private boolean containsSqlKeyword(ASTBinaryExpression node) {
        String sqlQuery = node.getImage();
        return sqlQuery != null && 
               (sqlQuery.contains("select") || 
                sqlQuery.contains("from") || 
                sqlQuery.contains("where") || 
                sqlQuery.contains("insert") || 
                sqlQuery.contains("update") || 
                sqlQuery.contains("delete"));
    }
}
