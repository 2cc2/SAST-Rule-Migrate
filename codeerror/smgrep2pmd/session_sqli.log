package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;

public class SqlStringConcatenationRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        if (isSqlStringConcatenationMethod(node)) {
            addViolation(data, node, "In " + node.getMethodName() 
                + ", string concatenation is used to construct a SQL query");
        }
        return super.visit(node, data);
    }

    private boolean isSqlStringConcatenationMethod(ASTMethodDeclaration method) {
        // Check for string concatenation in query construction
        boolean hasStringConcatenation = method.descendants(ASTAdditiveExpression.class)
            .filter(expr -> expr.getOperator() == ASTAdditiveExpression.Operator.PLUS)
            .any(expr -> expr.hasDescendantOfType(ASTVariableDeclaration.class));

        // Check for prepareStatement call with concatenated string
        boolean hasPrepStatement = method.descendants(ASTMethodCall.class)
            .filter(mcall -> "prepareStatement".equals(mcall.getMethodName()))
            .filter(mcall -> {
                ASTPrimaryExpression primaryExpr = mcall.getFirstChildOfType(ASTPrimaryExpression.class);
                return primaryExpr != null && primaryExpr.hasDescendantOfType(ASTVariableAccess.class);
            })
            .any();

        // Check for Session.connection() call
        boolean hasSessionConnection = method.descendants(ASTMethodCall.class)
            .filter(mcall -> "connection".equals(mcall.getMethodName()))
            .filter(mcall -> {
                ASTPrimaryPrefix prefix = mcall.getFirstChildOfType(ASTPrimaryPrefix.class);
                return prefix != null && prefix.hasDescendantOfType(ASTClassOrInterfaceType.class);
            })
            .any();

        // Check for executeQuery call
        boolean hasExecuteQuery = method.descendants(ASTMethodCall.class)
            .filter(mcall -> "executeQuery".equals(mcall.getMethodName()))
            .any();

        return hasStringConcatenation && hasPrepStatement && hasSessionConnection && hasExecuteQuery;
    }
}
