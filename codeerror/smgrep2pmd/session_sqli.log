Rule Content:
package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.ASTAssignmentOperator;
import net.sourceforge.pmd.lang.java.ast.ASTBlockStatement;
import net.sourceforge.pmd.lang.java.ast.ASTClassType;
import net.sourceforge.pmd.lang.java.ast.ASTLocalVariableDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTStatementExpression;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclarator;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.ast.AbstractJavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SqlStringConcatenationRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        if (containsSqlStringConcatenation(node)) {
            addViolation(data, node, "In " + node.getMethodName() + ", SQL query is constructed via string concatenation.");
        }
        return super.visit(node, data);
    }

    private boolean containsSqlStringConcatenation(ASTMethodDeclaration node) {
        boolean hasSession = false;
        boolean hasStringConcat = false;
        boolean hasPrepareStatement = false;
        boolean hasExecuteQuery = false;
        String queryVarName = null;

        for (ASTBlockStatement stmt : node.findDescendantsOfType(ASTBlockStatement.class, true)) {
            // Check for Session variable
            ASTLocalVariableDeclaration varDecl = stmt.getFirstDescendantOfType(ASTLocalVariableDeclaration.class);
            if (varDecl != null) {
                ASTClassType type = varDecl.getFirstDescendantOfType(ASTClassType.class);
                if (type != null && "Session".equals(type.getName())) {
                    hasSession = true;
                    continue;
                }
            }

            // Check for String concatenation
            ASTStatementExpression stmtExpr = stmt.getFirstDescendantOfType(ASTStatementExpression.class);
            if (stmtExpr != null) {
                ASTPrimaryExpression primaryExpr = stmtExpr.getFirstDescendantOfType(ASTPrimaryExpression.class);
                if (primaryExpr != null && primaryExpr.getFirstDescendantOfType(ASTAssignmentOperator.class) != null) {
                    ASTVariableDeclaratorId varId = stmtExpr.getFirstDescendantOfType(ASTVariableDeclaratorId.class);
                    if (varId != null) {
                        ASTClassType typeNode = varId.getTypeNode();
                        if (typeNode != null && "String".equals(typeNode.getTypeImage())) {
                            if (stmtExpr.toString().contains("+")) {
                                hasStringConcat = true;
                                queryVarName = varId.getImage();
                            }
                        }
                    }
                }
            }

            // Check for prepareStatement call
            if (queryVarName != null && stmtExpr != null) {
                ASTPrimaryExpression prepareExpr = stmtExpr.getFirstDescendantOfType(ASTPrimaryExpression.class);
                if (prepareExpr != null) {
                    ASTName methodName = prepareExpr.getFirstDescendantOfType(ASTName.class);
                    if (methodName != null && methodName.getImage().endsWith("prepareStatement")) {
                        ASTPrimaryPrefix prefix = prepareExpr.getFirstDescendantOfType(ASTPrimaryPrefix.class);
                        if (prefix != null && prefix.toString().contains(queryVarName)) {
                            hasPrepareStatement = true;
                        }
                    }
                }
            }

            // Check for executeQuery call
            if (stmtExpr != null) {
                ASTPrimaryExpression execExpr = stmtExpr.getFirstDescendantOfType(ASTPrimaryExpression.class);
                if (execExpr != null) {
                    ASTName methodName = execExpr.getFirstDescendantOfType(ASTName.class);
                    if (methodName != null && methodName.getImage().endsWith("executeQuery")) {
                        hasExecuteQuery = true;
                    }
                }
            }
        }

        return (hasStringConcat && hasSession && hasPrepareStatement && hasExecuteQuery);
    }
}
