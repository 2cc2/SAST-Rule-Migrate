package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SqlStringConcatenationRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        ASTFormalParameters params = node.firstChild(ASTFormalParameters.class);
        if (params == null) {
            return super.visit(node, data);
        }

        boolean hasStringParam = false;
        for (ASTFormalParameter param : params.descendants(ASTFormalParameter.class)) {
            ASTType type = param.firstChild(ASTType.class);
            if (type != null && "String".equals(type.getTypeImage())) {
                hasStringParam = true;
                break;
            }
        }

        if (!hasStringParam) {
            return super.visit(node, data);
        }

        for (ASTVariableDeclarator varDecl : node.descendants(ASTVariableDeclarator.class)) {
            if (varDecl.getName() == null) {
                continue;
            }

            ASTVariableInitializer initializer = varDecl.firstChild(ASTVariableInitializer.class);
            if (initializer == null) {
                continue;
            }

            if (initializer.hasDescendantOfType(ASTAdditiveExpression.class)) {
                for (ASTPrimaryExpression expr : node.descendants(ASTPrimaryExpression.class)) {
                    ASTPrimaryPrefix prefix = expr.firstChild(ASTPrimaryPrefix.class);
                    if (prefix == null) {
                        continue;
                    }

                    ASTName name = prefix.firstChild(ASTName.class);
                    if (name == null || !name.getImage().contains("prepareStatement")) {
                        continue;
                    }

                    ASTArguments args = expr.firstChild(ASTArguments.class);
                    if (args != null && args.size() > 0) {
                        ASTExpression argExpr = args.firstChild(ASTExpression.class);
                        if (argExpr != null && argExpr.hasDescendantOfType(ASTName.class)) {
                            ASTName argName = argExpr.descendants(ASTName.class).first();
                            if (argName != null && argName.getImage().equals(varDecl.getName())) {
                                asCtx(data).addViolation(node, 
