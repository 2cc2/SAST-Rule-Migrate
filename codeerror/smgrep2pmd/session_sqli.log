package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;

public class SqlStringConcatenationRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        ASTVariableDeclaratorId parameter = findStringParameter(node);
        if (parameter == null) {
            return super.visit(node, data);
        }

        ASTVariableDeclaration queryVar = findQueryString(node, parameter);
        if (queryVar == null) {
            return super.visit(node, data);
        }

        ASTVariableDeclaration sessionVar = findSessionVariable(node);
        if (sessionVar == null) {
            return super.visit(node, data);
        }

        boolean hasPrepareStatementCall = hasPrepareStatementCall(node, queryVar, sessionVar);
        if (hasPrepareStatementCall) {
            String methodName = node.getMethodName();
            addViolation(data, node, "In " + methodName + ", " + parameter.getName() 
                + " is used to construct a SQL query via string concatenation.");
        }

        return super.visit(node, data);
    }

    private ASTVariableDeclaratorId findStringParameter(ASTMethodDeclaration method) {
        return method.getFirstDescendantOfType(ASTFormalParameters.class)
            .findChildrenOfType(ASTFormalParameter.class)
            .stream()
            .filter(p -> p.getTypeNode().isStringType())
            .map(p -> p.getFirstDescendantOfType(ASTVariableDeclaratorId.class))
            .findFirst()
            .orElse(null);
    }

    private ASTVariableDeclaration findQueryString(ASTMethodDeclaration method, ASTVariableDeclaratorId param) {
        ASTBlock block = method.getFirstDescendantOfType(ASTBlock.class);
        return block.findDescendantsOfType(ASTVariableDeclaration.class)
            .stream()
            .filter(var -> var.getTypeNode().isStringType())
            .filter(var -> {
                ASTInfixExpression expr = var.getFirstDescendantOfType(ASTInfixExpression.class);
                return expr != null && containsParameterAccess(expr, param.getName());
            })
            .findFirst()
            .orElse(null);
    }

    private boolean containsParameterAccess(ASTInfixExpression expr, String paramName) {
        return expr.findDescendantsOfType(ASTPrimaryExpression.class)
            .stream()
            .anyMatch(pe -> pe.hasDescendantMatching(n -> 
                n instanceof ASTPrimaryPrefix 
                && ((ASTPrimaryPrefix)n).hasImageEqualTo(paramName)));
    }

    private ASTVariableDeclaration findSessionVariable(ASTMethodDeclaration method) {
        ASTBlock block = method.getFirstDescendantOfType(ASTBlock.class);
        return block.findDescendantsOfType(ASTVariableDeclaration.class)
            .stream()
            .filter(var -> var.getFirstChildOfType(ASTType.class).getTypeImage().equals("Session"))
            .findFirst()
            .orElse(null);
    }

    private boolean hasPrepareStatementCall(ASTMethodDeclaration method, ASTVariableDeclaration queryVar, 
                                          ASTVariableDeclaration sessionVar) {
        return method.getFirstDescendantOfType(ASTBlock.class)
            .findDescendantsOfType(ASTPrimaryExpression.class)
            .stream()
            .anyMatch(pe -> {
                ASTPrimarySuffix suffix = pe.getFirstDescendantOfType(ASTPrimarySuffix.class);
                if (suffix == null || !suffix.hasImage("prepareStatement")) {
                    return false;
                }
                
                ASTArgumentList args = pe.getFirstDescendantOfType(ASTArgumentList.class);
                return args != null && args.hasDescendantMatching(n -> 
                    n instanceof ASTPrimaryExpression 
                    && ((ASTPrimaryExpression)n).hasImageEqualTo(queryVar.getVariableName()));
            });
    }
}
