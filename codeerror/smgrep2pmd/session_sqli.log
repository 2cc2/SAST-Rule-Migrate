// 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.rule.RuleContext;

public class FindSqlStringConcatenationRule extends AbstractJavaRule {

    public FindSqlStringConcatenationRule() {
        super.addRuleChainVisit(ASTLocalVariableDeclaration.class);
    }

    @Override
    public Object visit(ASTLocalVariableDeclaration node, Object data) {
        ASTVariableDeclarator declarator = node.getFirstDescendantOfType(ASTVariableDeclarator.class);
        if (declarator != null) {
            ASTVariableInitializer initializer = declarator.getFirstChildOfType(ASTVariableInitializer.class);
            if (initializer != null && initializer.hasDescendantOfType(ASTAdditiveExpression.class)) {
                ASTAdditiveExpression expr = initializer.getFirstDescendantOfType(ASTAdditiveExpression.class);
                if (isStringConcatenation(expr)) {
                    RuleContext ctx = (RuleContext) data;
                    ctx.addViolation(data, node);
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isStringConcatenation(ASTAdditiveExpression expr) {
        ASTExpression left = expr.getFirstChildOfType(ASTExpression.class);
        ASTExpression right = expr.getFirstChildOfType(ASTExpression.class, 1);
        return (left != null && right != null && (left.getType() == String.class || right.getType() == String.class));
    }
}
