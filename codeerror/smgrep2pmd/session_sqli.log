package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.ast.JavaTokenConstants;

public class SqlStringConcatenationRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        ASTFormalParameters params = node.getFirstChildOfType(ASTFormalParameters.class);
        
        // Check if method has any String parameters
        boolean hasStringParam = false;
        ASTResultType returnType = node.getResultType();
        if (params != null) {
            for (ASTFormalParameter param : params.findChildrenOfType(ASTFormalParameter.class)) {
                ASTType type = param.getTypeNode();
                if (type != null && "String".equals(type.getTypeImage())) {
                    hasStringParam = true;
                    break;
                }
            }
        }

        if (hasStringParam) {
            // Check for string concatenation pattern
            for (ASTAdditiveExpression addExpr : node.findDescendantsOfType(ASTAdditiveExpression.class)) {
                if (addExpr.getOperator() == JavaTokenConstants.PLUS) {
                    // Check for prepareStatement call with concatenated string
                    for (ASTMethodCallExpression methodCall : node.findDescendantsOfType(ASTMethodCallExpression.class)) {
                        if ("prepareStatement".equals(methodCall.getMethodName())) {
                            ASTPrimaryExpression primaryExpr = methodCall.getFirstChildOfType(ASTPrimaryExpression.class);
                            if (primaryExpr != null) {
                                ASTPrimaryPrefix prefix = primaryExpr.getFirstChildOfType(ASTPrimaryPrefix.class);
                                if (prefix != null) {
                                    ASTName name = prefix.getFirstChildOfType(ASTName.class);
                                    if (name != null && name.getImage().endsWith("connection")) {
                                        // Check for executeQuery call
                                        for (ASTMethodCallExpression execCall : node.findDescendantsOfType(ASTMethodCallExpression.class)) {
                                            if ("executeQuery".equals(execCall.getMethodName())) {
                                                addViolation(data, node, node.getMethodName() + " constructs SQL query via string concatenation which may lead to SQL injection");
                                                return super.visit(node, data);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
