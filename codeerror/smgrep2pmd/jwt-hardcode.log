package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTVariableId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class HardCodedJWTSecretRule extends AbstractJavaRulechainRule {

    private static final String JWT_ALGORITHM_CLASS = "com.auth0.jwt.algorithms.Algorithm";
    private static final String HMAC256_METHOD = "HMAC256";

    public HardCodedJWTSecretRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isHMAC256MethodCall(node) && node.getArguments().size() == 1) {
            checkArgument(node.getArguments().get(0), data);
        }
        return super.visit(node, data);
    }

    private boolean isHMAC256MethodCall(ASTMethodCall node) {
        return HMAC256_METHOD.equals(node.getMethodName())
                && TypeTestUtil.isA(JWT_ALGORITHM_CLASS, node.getQualifier());
    }

    private void checkArgument(ASTExpression arg, Object data) {
        if (arg instanceof ASTStringLiteral) {
            // Direct string literal as secret
            asCtx(data).addViolation(arg);
        } else if (arg instanceof ASTVariableAccess) {
            // Variable reference - check if initialized with hardcoded string
            ASTVariableId varDecl = ((ASTVariableAccess) arg).getSignature().getSymbol().tryGetNode();
            if (varDecl != null && varDecl.getInitializer() instanceof ASTStringLiteral) {
                asCtx(data).addViolation(arg);
            }
        }
    }
}
