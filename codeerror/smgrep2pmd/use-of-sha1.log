package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class AvoidSHA1UsageRule extends AbstractJavaRulechainRule {

    public AvoidSHA1UsageRule() {
        super(ASTMethodCall.class, ASTConstructorCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("getInstance".equals(node.getMethodName())) {
            if (node.getArguments().size() > 0) {
                ASTStringLiteral algorithmLiteral = node.getArguments().get(0)
                    .descendantsOrSelf()
                    .filterIs(ASTStringLiteral.class)
                    .first();
                
                if (algorithmLiteral != null && ("SHA-1".equals(algorithmLiteral.getContent()) 
                    || "SHA1".equals(algorithmLiteral.getContent()))) {
                    addViolation(data, algorithmLiteral);
                }
            }
        } else if ("getSha1Digest".equals(node.getMethodName()) 
                  && TypeTestUtil.isA("org.apache.commons.codec.digest.DigestUtils", node.getQualifier())) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA("java.security.MessageDigest", node) 
            && node.getArguments().size() > 0) {
            ASTStringLiteral algorithmLiteral = node.getArguments().get(0)
                .descendantsOrSelf()
                .filterIs(ASTStringLiteral.class)
                .first();
                
            if (algorithmLiteral != null && ("SHA-1".equals(algorithmLiteral.getContent()) 
                || "SHA1".equals(algorithmLiteral.getContent()))) {
                addViolation(data, algorithmLiteral);
            }
        }
        return super.visit(node, data);
    }
}
