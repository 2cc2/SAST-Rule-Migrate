package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.parsers.SAXParserFactory;

public class ExternalEntitiesRule extends AbstractJavaRulechainRule {

    public ExternalEntitiesRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        if ("setFeature".equals(methodName)) {
            checkFeatureSetting(node, data);
        }
        return data;
    }

    private void checkFeatureSetting(ASTMethodCall node, Object data) {
        if (node.getArguments().size() < 2) {
            return;
        }

        ASTExpression receiver = node.getQualifier();
        if (receiver == null) {
            return;
        }

        boolean isDocumentBuilderFactory = TypeTestUtil.isA(DocumentBuilderFactory.class, receiver);
        boolean isSAXParserFactory = TypeTestUtil.isA(SAXParserFactory.class, receiver);

        if (isDocumentBuilderFactory || isSAXParserFactory) {
            ASTExpression firstArg = node.getArguments().get(0);
            ASTExpression secondArg = node.getArguments().get(1);

            if (firstArg instanceof ASTStringLiteral && secondArg instanceof ASTBooleanLiteral) {
                String feature = ((ASTStringLiteral) firstArg).getContent();
                boolean value = ((ASTBooleanLiteral) secondArg).getValue();

                if ("http://xml.org/sax/features/external-parameter-entities".equals(feature) && value) {
                    asCtx(data).addViolation(node);
                }
            }
        }
    }
}
