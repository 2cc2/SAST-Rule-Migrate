package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class TaintedFilePathRule extends AbstractJavaRulechainRule {

    public TaintedFilePathRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(FileInputStream.class, node) || 
            TypeTestUtil.isA(FileReader.class, node) ||
            TypeTestUtil.isA(File.class, node)) {
            checkForTaintedPath(node.getArguments(), data);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("getResource") && 
            node.getArguments().size() > 0) {
            checkForTaintedPath(node.getArguments(), data);
        }
        return super.visit(node, data);
    }

    private void checkForTaintedPath(ASTArguments args, Object data) {
        if (args.size() == 0) return;

        ASTExpression pathExpr = args.get(0);
        // Check for string concatenation with variables
        if (pathExpr instanceof ASTAdditiveExpression) {
            ASTAdditiveExpression additive = (ASTAdditiveExpression) pathExpr;
            if (containsUserInput(additive)) {
                asCtx(data).addViolation(pathExpr);
            }
        }
        // Check for variable usage
        else if (pathExpr instanceof ASTVariableAccess) {
            asCtx(data).addViolation(pathExpr);
        }
    }

    private boolean containsUserInput(ASTAdditiveExpression expr) {
        return expr.descendants()
            .filter(ASTVariableAccess.class::isInstance)
            .anyMatch(v -> {
                ASTVariableId var = ((ASTVariableAccess)v).getSignature().getSymbol().tryGetNode();
                return var != null && var.isParameter();
            });
    }
}
