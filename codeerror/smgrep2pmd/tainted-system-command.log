package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class TaintedSystemCommandRule extends AbstractJavaRulechainRule {

    public TaintedSystemCommandRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("start".equals(node.getMethodName()) || "exec".equals(node.getMethodName())) {
            JavaNode parent = node.getParent();
            if (parent instanceof ASTConstructorCall) {
                checkForTaintedCommand((ASTConstructorCall) parent, data);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA("java.lang.ProcessBuilder", node)) {
            checkForTaintedCommandsInArgs(node, data);
        }
        return super.visit(node, data);
    }

    private void checkForTaintedCommandsInArgs(ASTConstructorCall node, Object data) {
        // 实现检查ProcessBuilder参数是否包含用户输入的代码
        // 示例实现：
        node.getArguments().forEach(arg -> {
            String argValue = arg.toString();
            if (argValue.contains("sh -c") || 
                argValue.contains("cmd /c") ||
                argValue.contains("Runtime.getRuntime().exec")) {
                asCtx(data).addViolation(node);
            }
        });
    }
}
