package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import net.sourceforge.pmd.lang.java.ast.JavaNode;

public class TaintedSystemCommandRule extends AbstractJavaRulechainRule {

    public TaintedSystemCommandRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("start".equals(node.getMethodName()) || "exec".equals(node.getMethodName())) {
            JavaNode parent = node.getParent();
            if (parent instanceof ASTExpression) {
                checkForTaintedCommand((ASTExpression) parent, data);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(ProcessBuilder.class, node)) {
            checkForTaintedCommand(node, data);
        }
        return super.visit(node, data);
    }

    private void checkForTaintedCommand(ASTExpression expr, Object data) {
        // Check for string concatenation with potentially tainted input
        if (expr != null) {
            expr.descendantsOrSelf()
                .filterIs(ASTStringLiteral.class)
                .filter(lit -> {
                    String text = lit.getText();
                    return text.contains("sh -c") || text.contains("cmd /c") || 
                           text.contains("bash -c") || text.contains("ping");
                })
                .forEach(lit -> asCtx(data).addViolation(lit));

            expr.descendantsOrSelf()
                .filterIs(ASTVariableAccess.class)
                .forEach(var -> {
                    // Check if variable contains user input from @RequestParam
                    ASTVariableId varDecl = var.getSignature().getSymbol().tryGetNode();
                    if (varDecl != null && varDecl.getInitializer() != null) {
                        varDecl.getInitializer().descendantsOrSelf()
                            .filterIs(ASTStringLiteral.class)
                            .filter(lit -> lit.getText().contains("@RequestParam"))
                            .findFirst()
                            .ifPresent(lit -> asCtx(data).addViolation(var));
                    }
                });
        }
    }
}
