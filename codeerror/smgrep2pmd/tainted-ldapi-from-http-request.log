package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTAssignmentOperator;
import net.sourceforge.pmd.lang.java.ast.ASTAssignableExpr.AccessType;
import net.sourceforge.pmd.lang.java.ast.JavaNode;

public class TaintedLdapQueryRule extends AbstractJavaRulechainRule {

    public TaintedLdapQueryRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isDirContextSearchCall(node)) {
            checkForTaintedInput(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isDirContextSearchCall(ASTMethodCall node) {
        return TypeTestUtil.isA("javax.naming.directory.DirContext", node.getMethodTypeReceiver())
               && "search".equals(node.getMethodName());
    }

    private void checkForTaintedInput(ASTMethodCall node, Object data) {
        // Check if the filter parameter contains user input
        if (node.getArguments().size() > 1) {
            JavaNode filterArg = node.getArguments().get(1);
            if (containsTaintedVariable(filterArg) || containsStringLiteralUserInput(filterArg)) {
                asCtx(data).addViolation(node);
            }
        }
    }

    private boolean containsTaintedVariable(JavaNode node) {
        return node.descendantsOrSelf()
                .filterIs(ASTVariableAccess.class)
                .anyMatch(var -> {
                    String varName = var.getName();
                    // Check for common sources indicating user input
                    return varName.equals("param") || varName.equals("bar");
                });
    }

    private boolean containsStringLiteralUserInput(JavaNode node) {
        return node.descendantsOrSelf()
                .filterIs(ASTStringLiteral.class)
                .anyMatch(lit -> lit.getText().contains("request.get"));
    }
}
