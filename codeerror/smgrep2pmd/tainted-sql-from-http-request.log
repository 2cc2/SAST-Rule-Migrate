package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class TaintedSqlFromHttpRequestRule extends AbstractJavaRulechainRule {

    public TaintedSqlFromHttpRequestRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isDatabaseOperation(node)) {
            JavaNode sqlArgument = node.getArguments().get(0);
            if (isTaintedString(sqlArgument)) {
                addViolation(data, node);
            }
        }
        return super.visit(node, data);
    }

    private boolean isDatabaseOperation(ASTMethodCall node) {
        String methodName = node.getMethodName();
        return "prepareCall".equals(methodName) || 
               "executeUpdate".equals(methodName) ||
               "prepareStatement".equals(methodName) ||
               "queryForObject".equals(methodName) ||
               "queryForRowSet".equals(methodName);
    }

    private boolean isTaintedString(JavaNode node) {
        if (node instanceof ASTMethodCall) {
            ASTMethodCall methodCall = (ASTMethodCall) node;
            String methodName = methodCall.getMethodName();
            if ("getParameter".equals(methodName) || 
                "getHeader".equals(methodName) || 
                "getHeaders".equals(methodName)) {
                return true;
            }
        }
        
        if (node instanceof ASTStringLiteral) {
            ASTStringLiteral literal = (ASTStringLiteral) node;
            if (literal.getParent() instanceof ASTArgumentList) {
                ASTArgumentList args = (ASTArgumentList) literal.getParent();
                if (args.size() > 0 && isTaintedString(args.get(0))) {
                    return true;
                }
            }
        }
        
        if (node instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) node;
            if (varAccess.getSignature() != null && 
                varAccess.getSignature().getSymbol() != null) {
                return true;
            }
        }
        
        return false;
    }
}
