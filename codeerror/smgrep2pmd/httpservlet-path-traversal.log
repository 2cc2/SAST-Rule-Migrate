package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTVariableId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTAssignableExpr.AccessType;
import java.io.File;

public class HttpServletPathTraversalRule extends AbstractJavaRulechainRule {

    public HttpServletPathTraversalRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isExactlyA(File.class, node)) {
            if (node.getArguments().size() > 0) {
                checkForPathTraversal(data, node.getArguments().get(0));
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("getParameter")) {
            ASTVariableId paramVar = getVariableFromMethodCall(node);
            if (paramVar != null) {
                checkVariableUsage(data, paramVar);
            }
        }
        return super.visit(node, data);
    }

    private void checkForPathTraversal(Object data, ASTExpression expr) {
        if (expr instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) expr;
            ASTVariableId varDecl = varAccess.getSignature().getSymbol().tryGetNode();
            if (varDecl != null) {
                checkVariableUsage(data, varDecl);
            }
        }
    }

    private ASTVariableId getVariableFromMethodCall(ASTMethodCall node) {
        if (node.getQualifier() instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) node.getQualifier();
            return varAccess.getSignature().getSymbol().tryGetNode();
        }
        return null;
    }

    private void checkVariableUsage(Object data, ASTVariableId varDecl) {
        varDecl.getLocalUsages().forEach(usage -> {
            if (usage.getAccessType() == AccessType.READ) {
                asCtx(data).addViolation(usage.getNode());
            }
        });
    }
}
