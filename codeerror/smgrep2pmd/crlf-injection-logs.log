package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.servlet.ServletRequest;

public class CrlfInjectionLogsRule extends AbstractJavaRulechainRule {

    public CrlfInjectionLogsRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isLoggerMethod(node) && node.getArguments().size() > 0) {
            ASTExpression arg = node.getArguments().get(0);
            if (containsRequestParameter(arg)) {
                addViolation(data, node);
            }
        }
        return data;
    }

    private boolean isLoggerMethod(ASTMethodCall node) {
        String methodName = node.getMethodName();
        return ("info".equals(methodName) || "log".equals(methodName)) 
                && TypeTestUtil.isA(java.util.logging.Logger.class, node.getQualifier());
    }

    private boolean containsRequestParameter(ASTExpression expr) {
        if (expr instanceof ASTMethodCall) {
            ASTMethodCall call = (ASTMethodCall) expr;
            if ("getParameter".equals(call.getMethodName()) 
                    && TypeTestUtil.isA(ServletRequest.class, call.getQualifier())) {
                return true;
            }
        }

        if (expr.getFirstDescendantOfType(ASTMethodCall.class) != null) {
            for (ASTMethodCall call : expr.descendants(ASTMethodCall.class)) {
                if ("getParameter".equals(call.getMethodName()) 
                        && TypeTestUtil.isA(ServletRequest.class, call.getQualifier())) {
                    return true;
                }
            }
        }

        if (expr.getFirstDescendantOfType(ASTVariableAccess.class) != null) {
            for (ASTVariableAccess var : expr.descendants(ASTVariableAccess.class)) {
                if (var.getSignature() != null && var.getSignature().getSymbol() != null) {
                    ASTExpression init = var.getSignature().getSymbol().tryGetNode().getInitializer();
                    if (init != null && containsRequestParameter(init)) {
                        return true;
                    }
                }
            }
        }

        return false;
    }
}
