/**
 * 修复完整后的SpringSqliRule规则
 */
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import java.util.Arrays;

public class SpringSqliRule extends AbstractJavaRulechainRule {

    public SpringSqliRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA("org.springframework.jdbc.core.PreparedStatementCreatorFactory", node)) {
            ASTArgumentList args = node.getArguments();
            if (args != null && !args.isEmpty()) {
                checkSqliVulnerability(args.get(0), data);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        if (methodName != null && Arrays.asList("execute", "batchUpdate", "queryForObject", 
                "queryForList", "queryForMap", "queryForRowSet", "queryForInt", 
                "queryForLong", "query").contains(methodName)) {
            ASTExpression firstArg = node.getArguments().getFirst();
            if (firstArg != null) {
                checkSqliVulnerability(firstArg, data);
            }
        }
        return super.visit(node, data);
    }

    private void checkSqliVulnerability(ASTExpression expr, Object data) {
        if (expr == null) {
            return;
        }

        // 检查字符串拼接
        if (expr instanceof ASTAddExpression) {
            asCtx(data).addViolation(expr);
            return;
        }

        // 检查String.format调用
        if (expr instanceof ASTMethodCall) {
            ASTMethodCall methodCall = (ASTMethodCall) expr;
            if ("format".equals(methodCall.getMethodName())) {
                asCtx(data).addViolation(expr);
                return;
            }
        }

        // 检查变量引用
        if (expr instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) expr;
            if (varAccess.getSignature() != null && 
                varAccess.getSignature().getSymbol() != null) {
                ASTVariableId varDecl = varAccess.getSignature().getSymbol().tryGetNode();
                if (varDecl != null && varDecl.getInitializer() != null) {
                    checkSqliVulnerability(varDecl.getInitializer(), data);
                }
            }
        }
    }
}
