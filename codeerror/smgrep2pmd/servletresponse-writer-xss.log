package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCallExpression;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class ServletResponseWriterXssRule extends AbstractJavaRule {
    public ServletResponseWriterXssRule() {
        addRuleChainVisit(ASTMethodCallExpression.class);
    }

    @Override
    public Object visit(ASTMethodCallExpression node, Object data) {
        // 匹配 resp.getWriter().write(...) 形式
        if ("write".equals(node.getMethodName())) {
            ASTMethodCallExpression getWriterCall = node.getFirstParentOfType(ASTMethodCallExpression.class);
            if (getWriterCall != null 
                && "getWriter".equals(getWriterCall.getMethodName()) 
                && isServletResponseWriter(getWriterCall)) {
                
                // 检查参数是否是直接来自请求参数
                if (node.getArguments().size() > 0 
                    && isRequestParameter(node.getArgument(0))) {
                    addViolation(data, node);
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isServletResponseWriter(ASTMethodCallExpression methodCall) {
        // 检查调用getWriter()的对象是否是HttpServletResponse类型
        String exprImage = methodCall.getQualifier() != null 
            ? methodCall.getQualifier().getImage() 
            : "";
        return exprImage.endsWith("resp") || exprImage.endsWith("response");
    }

    private boolean isRequestParameter(Object expr) {
        // 检查表达式是否包含getParameter调用
        if (expr instanceof ASTMethodCallExpression) {
            ASTMethodCallExpression call = (ASTMethodCallExpression) expr;
            return "getParameter".equals(call.getMethodName()) 
                && call.getQualifier() != null 
                && call.getQualifier().getImage().endsWith("req");
        }
        return false;
    }
}
