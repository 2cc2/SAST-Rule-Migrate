package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import java.util.Optional;

/**
 * 检测Servlet响应写入未编码用户输入的XSS漏洞
 */
public class ServletResponseWriterXssRule extends AbstractJavaRule {

    private static final String SERVLET_RESPONSE = "HttpServletResponse";
    private static final String SERVLET_REQUEST = "HttpServletRequest";
    
    public ServletResponseWriterXssRule() {
        addRuleChainVisit(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (!"write".equals(node.getMethodName())) {
            return super.visit(node, data);
        }

        node.ancestors(ASTMethodCall.class)
            .filter(call -> "getWriter".equals(call.getMethodName()))
            .filter(this::isServletResponseWriter)
            .findFirst()
            .ifPresent(call -> {
                if (node.getArguments().size() > 0 && isRequestParameter(node.getArgument(0))) {
                    addViolation(data, node);
                }
            });

        return super.visit(node, data);
    }

    private boolean isServletResponseWriter(ASTMethodCall methodCall) {
        return Optional.ofNullable(methodCall.getQualifier())
                      .map(qualifier -> qualifier.getTypeImage())
                      .filter(type -> type != null && type.endsWith(SERVLET_RESPONSE))
                      .isPresent();
    }

    private boolean isRequestParameter(ASTExpression expr) {
        if (!(expr instanceof ASTMethodCall)) {
            return false;
        }
        
        ASTMethodCall call = (ASTMethodCall) expr;
        if (!"getParameter".equals(call.getMethodName())) {
            return false;
        }

        return Optional.ofNullable(call.getQualifier())
                      .map(qualifier -> qualifier.getTypeImage())
                      .filter(type -> type != null && type.endsWith(SERVLET_REQUEST))
                      .isPresent();
    }
}
