Rule Content:
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

/**
 * 检测Servlet响应写入未编码用户输入的XSS漏洞
 */
public class ServletResponseWriterXssRule extends AbstractJavaRule {

    public ServletResponseWriterXssRule() {
        addRuleChainVisit(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        // 匹配 resp.getWriter().write(...) 模式
        if ("write".equals(node.getMethodName())) {
            node.ancestors(ASTMethodCall.class)
                .filter(call -> "getWriter".equals(call.getMethodName()))
                .filter(this::isServletResponseWriter)
                .findFirst()
                .ifPresent(call -> {
                    if (node.getArguments().size() > 0 
                        && isRequestParameter(node.getArgument(0))) {
                        addViolation(data, node);
                    }
                });
        }
        return super.visit(node, data);
    }

    private boolean isServletResponseWriter(ASTMethodCall methodCall) {
        return Optional.ofNullable(methodCall.getQualifier())
                      .map(ASTExpression::getTypeImage)
                      .filter(type -> type.endsWith("HttpServletResponse"))
                      .isPresent();
    }

    private boolean isRequestParameter(ASTExpression expr) {
        return expr instanceof ASTMethodCall 
            && "getParameter".equals(((ASTMethodCall)expr).getMethodName())
            && Optional.ofNullable(((ASTMethodCall)expr).getQualifier())
                      .map(ASTExpression::getTypeImage)
                      .filter(type -> type.endsWith("HttpServletRequest"))
                      .isPresent();
    }
}
