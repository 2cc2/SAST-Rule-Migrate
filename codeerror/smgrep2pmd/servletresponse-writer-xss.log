import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;

public class ServletResponseWriterXssRule extends AbstractJavaRule {
    
    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        // Check if method parameters include HttpServletRequest and HttpServletResponse
        boolean hasRequest = false;
        boolean hasResponse = false;
        
        for (Node param : node.getFormalParameters()) {
            ASTName paramName = param.getFirstDescendantOfType(ASTName.class);
            if (paramName != null && "HttpServletRequest".equals(paramName.getImage())) {
                hasRequest = true;
            } else if (paramName != null && "HttpServletResponse".equals(paramName.getImage())) {
                hasResponse = true;
            }
        }
        
        if (hasRequest && hasResponse) {
            return super.visit(node, data);
        }
        return data;
    }
    
    @Override
    public Object visit(ASTPrimaryExpression node, Object data) {
        if (node.getNumChildren() >= 2) {
            Node firstName = node.getChild(0);
            Node secondName = node.getChild(1);
            
            // Check for patterns like resp.getWriter().write(param)
            if (firstName instanceof ASTPrimaryPrefix) {
                ASTPrimaryPrefix prefix = (ASTPrimaryPrefix)firstName;
                if (prefix.getNumChildren() > 0 && prefix.getChild(0) instanceof ASTName) {
                    ASTName name = (ASTName)prefix.getChild(0);
                    if (name.getImage().endsWith("getWriter")) {
                        if (secondName instanceof ASTName && ((ASTName)secondName).getImage().equals("write")) {
                            ASTArgumentList args = node.getFirstDescendantOfType(ASTArgumentList.class);
                            if (args != null && args.getNumChildren() > 0) {
                                Node arg = args.getChild(0);
                                if (arg instanceof ASTLiteral) {
                                    String argValue = ((ASTLiteral)arg).getImage();
                                    if (argValue != null && !argValue.contains("Encode.forHtml") && !argValue.startsWith("\"")) {
                                        addViolation(data, node);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
