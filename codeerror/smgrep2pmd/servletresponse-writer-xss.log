// 转换后的 PMD 规则
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class ServletResponseWriterXssRule extends AbstractJavaRule {
    public ServletResponseWriterXssRule() {
        addRuleChainVisit(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        // 匹配 resp.getWriter().write(...) 形式
        if (node.getMethodName().equals("write")) {
            ASTMethodCall getWriterCall = node.getFirstParentOfType(ASTMethodCall.class);
            if (getWriterCall != null 
                && getWriterCall.getMethodName().equals("getWriter") 
                && isServletResponseWriter(getWriterCall)) {
                
                // 检查参数是否是直接来自请求参数
                if (node.getArguments().size() > 0 
                    && isRequestParameter(node.getArgument(0))) {
                    addViolation(data, node);
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isServletResponseWriter(ASTMethodCall methodCall) {
        // 检查调用getWriter()的对象是否是HttpServletResponse类型
        String exprImage = methodCall.getQualifier() != null 
            ? methodCall.getQualifier().getImage() 
            : "";
        return exprImage.endsWith("resp") || exprImage.endsWith("response");
    }

    private boolean isRequestParameter(Object expr) {
        // 检查表达式是否包含getParameter调用
        if (expr instanceof ASTMethodCall) {
            ASTMethodCall call = (ASTMethodCall) expr;
            return call.getMethodName().equals("getParameter") 
                && call.getQualifier() != null 
                && call.getQualifier().getImage().endsWith("req");
        }
        return false;
    }
}
