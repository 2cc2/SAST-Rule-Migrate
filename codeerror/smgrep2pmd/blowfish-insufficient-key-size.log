Rule Content:
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTNumericLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.crypto.KeyGenerator;

public class BlowfishInsufficientKeySizeRule extends AbstractJavaRulechainRule {

    public BlowfishInsufficientKeySizeRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isKeyGeneratorInitCall(node)) {
            ASTExpression arg = node.getArguments().get(0);
            if (arg instanceof ASTNumericLiteral) {
                Number keySize = ((ASTNumericLiteral) arg).getValueAsNumber();
                if (keySize != null && keySize.intValue() < 128) {
                    asCtx(data).addViolation(node, "Blowfish key size must be at least 128 bits");
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isKeyGeneratorInitCall(ASTMethodCall node) {
        return "init".equals(node.getMethodName())
                && node.getQualifier() != null
                && TypeTestUtil.isA(KeyGenerator.class, node.getQualifier());
    }
}
