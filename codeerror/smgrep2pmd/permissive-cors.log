/*
 * 修复策略：
 * 1. 移除了所有可能导致编译错误的非法字符(如开头的#注释符号)
 * 2. 确保所有Java文件有正确的包声明和类结构
 * 3. 更新了maven-compiler-plugin配置，使用--release 8替代过时的-source和-target
 * 4. 在pom.xml中添加了UTF-8编码配置
 * 5. 保留了原始规则的完整功能逻辑
 */

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTAdditiveExpression;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTMemberSelector;
import net.sourceforge.pmd.lang.java.ast.JavaNode;

/**
 * 检测Permissive CORS配置的PMD规则
 * 原始功能保持不变，仅修复语法问题
 */
public class PermissiveCorsRule extends AbstractJavaRulechainRule {

    public PermissiveCorsRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        
        if (("addHeader".equals(methodName) || "setHeader".equals(methodName) || "set".equals(methodName)) 
            && node.getArguments().size() >= 2) {
            
            JavaNode firstArg = node.getArguments().get(0);
            String headerName = getStringLiteralValue(firstArg);
            
            if ("Access-Control-Allow-Origin".equalsIgnoreCase(headerName) || 
                "access-control-allow-origin".equalsIgnoreCase(headerName)) {
                
                JavaNode secondArg = node.getArguments().get(1);
                String headerValue = getStringLiteralValue(secondArg);
                
                if ("*".equals(headerValue) || "null".equalsIgnoreCase(headerValue) || 
                    (headerValue != null && headerValue.startsWith("*."))) {
                    asCtx(data).addViolation(node);
                }
            }
        }
        return super.visit(node, data);
    }

    private String getStringLiteralValue(JavaNode node) {
        if (node instanceof ASTStringLiteral) {
            return ((ASTStringLiteral) node).getImage();
        } else if (node instanceof ASTName) {
            return ((ASTName) node).getImage();
        } else if (node instanceof ASTPrimaryExpression) {
            ASTPrimaryPrefix prefix = node.getFirstDescendantOfType(ASTPrimaryPrefix.class);
            if (prefix != null) {
                ASTName name = prefix.getFirstDescendantOfType(ASTName.class);
                if ( name != null) {
                    return name.getImage();
                }
            }
        }
        return null;
    }
}
