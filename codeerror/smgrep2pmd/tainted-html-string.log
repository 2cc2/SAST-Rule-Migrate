package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTReturnStatement;

public class TaintedHtmlStringRule extends AbstractJavaRulechainRule {

    public TaintedHtmlStringRule() {
        super(ASTMethodCall.class, ASTConstructorCall.class, ASTReturnStatement.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("format") 
            || node.getMethodName().equals("htmlEscapeHex") 
            || node.getMethodName().equals("escapeHtml4")) {
            checkTaintedHtmlString(node, data);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTReturnStatement node, Object data) {
        if (node.getFirstChildOfType(ASTStringLiteral.class) != null) {
            checkTaintedHtmlString(node, data);
        }
        return super.visit(node, data);
    }

    private void checkTaintedHtmlString(JavaNode node, Object data) {
        ASTStringLiteral literal = node.firstDescendantOfType(ASTStringLiteral.class);
        if (literal != null && containsHtmlTags(literal.getContent())) {
            ASTVariableAccess varAccess = node.firstDescendantOfType(ASTVariableAccess.class);
            if (varAccess != null || node.hasDescendantOfType(ASTLiteral.class)) {
                addViolation(data, node);
            }
        }
    }

    private boolean containsHtmlTags(String content) {
        return content.matches(".*<[a-z][\\s\\S]*>.*") 
            || content.contains("<img") 
            || content.contains("<b>") 
            || content.contains("</br>");
    }
}
