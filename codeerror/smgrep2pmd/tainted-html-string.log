package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.JavaNode;

public class TaintedHtmlStringRule extends AbstractJavaRulechainRule {

    public TaintedHtmlStringRule() {
        super(ASTMethodCall.class);  // 指定要处理的节点类型
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isHtmlFormatMethod(node)) {
            checkTaintedHtmlString(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isHtmlFormatMethod(ASTMethodCall node) {
        String methodName = node.getMethodName();
        return "format".equals(methodName) 
            || "htmlEscapeHex".equals(methodName)
            || "escapeHtml4".equals(methodName);
    }

    private void checkTaintedHtmlString(JavaNode node, Object data) {
        ASTStringLiteral literal = node.firstDescendantOfType(ASTStringLiteral.class);
        if (literal != null && containsHtmlTags(literal.getContent())) {
            addViolation(data, node);
        }
    }

    private boolean containsHtmlTags(String content) {
        return content.matches(".*<[a-z][\\s\\S]*>.*") 
            || content.contains("<img") 
            || content.contains("<b>")
            || content.contains("</br>");
    }
}
