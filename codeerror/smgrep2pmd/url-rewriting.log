package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.servlet.http.HttpServletResponse;

/**
 * 检测不安全的URL重写方法调用规则
 */
public class UrlRewritingRule extends AbstractJavaRulechainRule {

    public UrlRewritingRule() {
        super(ASTMethodCall.class, ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        node.descendants(ASTMethodCall.class)
            .filter(methodCall -> {
                String callName = methodCall.getMethod().getName();
                return "encodeURL".equals(callName) 
                    || "encodeUrl".equals(callName)
                    || "encodeRedirectURL".equals(callName)
                    || "encodeRedirectUrl".equals(callName);
            })
            .filter(methodCall -> TypeTestUtil.isA(HttpServletResponse.class, methodCall.getQualifier()))
            .forEach(methodCall -> {
                asCtx(data).addViolation(methodCall);
            });

        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String callName = node.getMethod().getName();
        if (("encodeURL".equals(callName) 
            || "encodeUrl".equals(callName)
            || "encodeRedirectURL".equals(callName)
            || "encodeRedirectUrl".equals(callName))
            && TypeTestUtil.isA(HttpServletResponse.class, node.getQualifier())) {
            asCtx(data).addViolation(node);
        }
        return super.visit(node, data);
    }
}
