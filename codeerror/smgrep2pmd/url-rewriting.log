package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class UrlRewritingRule extends AbstractJavaRulechainRule {

    public UrlRewritingRule() {
        super(ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        String methodName = node.getName();
        
        node.descendants(ASTMethodCall.class)
            .filter(methodCall -> {
                String callName = methodCall.getMethodName();
                return "encodeURL".equals(callName) 
                    || "encodeUrl".equals(callName)
                    || "encodeRedirectURL".equals(callName)
                    || "encodeRedirectUrl".equals(callName);
            })
            .forEach(methodCall -> {
                if (TypeTestUtil.isA(HttpServletResponse.class, methodCall.getQualifier())) {
                    asCtx(data).addViolation(node);
                }
            });

        return super.visit(node, data);
    }
}
