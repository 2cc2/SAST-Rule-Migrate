/**
 * 修复后的 URL 重写规则检测
 */
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.servlet.http.HttpServletResponse;

public class UrlRewritingRule extends AbstractJavaRulechainRule {

    /**
     * 规则构造函数，声明要处理的AST节点类型
     */
    public UrlRewritingRule() {
        super(ASTMethodCall.class, ASTMethodDeclaration.class);
    }

    /**
     * 处理方法声明节点
     */
    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        // 检查方法体中的所有方法调用
        node.descendants(ASTMethodCall.class)
            .filter(this::isUrlRewritingMethodCall)
            .forEach(methodCall -> asCtx(data).addViolation(methodCall));
        
        return super.visit(node, data);
    }

    /**
     * 处理方法调用节点
     */
    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isUrlRewritingMethodCall(node)) {
            asCtx(data).addViolation(node);
        }
        return super.visit(node, data);
    }

    /**
     * 判断是否是URL重写方法调用
     */
    private boolean isUrlRewritingMethodCall(ASTMethodCall methodCall) {
        String callName = methodCall.getMethodName();
        boolean isTargetMethod = "encodeURL".equals(callName) 
                             || "encodeUrl".equals(callName)
                             || "encodeRedirectURL".equals(callName)
                             || "encodeRedirectUrl".equals(callName);
        
        return isTargetMethod 
            && TypeTestUtil.isA(HttpServletResponse.class, methodCall.getQualifier());
    }
}
