package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class SqlInjectionRule extends AbstractJavaRulechainRule {

    public SqlInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        
        // Check for SQL execution methods
        if ("executeQuery".equals(methodName) || "execute".equals(methodName) || "createQuery".equals(methodName)) {
            ASTExpression qualifier = node.getQualifier();
            if (qualifier instanceof ASTMethodCall) {
                ASTMethodCall previousCall = (ASTMethodCall) qualifier;
                if ("createStatement".equals(previousCall.getMethodName())) {
                    checkSqlStringArguments(node, data);
                } else if ("getConnection".equals(previousCall.getMethodName())) {
                    checkSqlStringArguments(node, data);
                }
            } else if (TypeTestUtil.isExactlyA("javax.persistence.EntityManager", qualifier)) {
                checkSqlStringArguments(node, data);
            }
        }
        
        return super.visit(node, data);
    }

    private void checkSqlStringArguments(ASTMethodCall node, Object data) {
        for (ASTExpression arg : node.getArguments()) {
            if (isDynamicSqlString(arg)) {
                addViolation(data, arg);
            }
        }
    }

    private boolean isDynamicSqlString(ASTExpression expr) {
        // Check for string concatenation
        if (expr instanceof ASTAdditiveExpression) {
            return true;
        }
        
        // Check for String.format calls
        if (expr instanceof ASTMethodCall) {
            ASTMethodCall methodCall = (ASTMethodCall) expr;
            if ("format".equals(methodCall.getMethodName()) && 
                TypeTestUtil.isExactlyA("java.lang.String", methodCall.getQualifier())) {
                return true;
            }
        }
        
        // Check for string variables being built with concatenation
        if (expr instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) expr;
            if (varAccess.getSignature() != null) {
                ASTVariableId var = varAccess.getSignature().tryGetNode();
                if (var != null) {
                    ASTExpression initializer = var.getInitializer();
                    if (initializer != null && isDynamicSqlString(initializer)) {
                        return true;
                    }
                }
            }
        }
        
        // Check for SQL string literals with concatenation or interpolation
        if (expr instanceof ASTStringLiteral) {
            String sql = ((ASTStringLiteral) expr).getConstValue();
            return sql != null && (sql.contains("+") || sql.contains("%s"));
        }
        
        return false;
    }
}
