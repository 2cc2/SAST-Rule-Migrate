Rule Content:
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTAssignmentExpression;
import net.sourceforge.pmd.lang.java.ast.ASTIfStatement;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class AssignmentComparisonRule extends AbstractJavaRulechainRule {
    public AssignmentComparisonRule() {
        super(ASTIfStatement.class);
    }

    @Override
    public Object visit(ASTIfStatement node, Object data) {
        ASTExpression condition = node.getCondition();
        if (condition instanceof ASTAssignmentExpression) {
            asCtx(data).addViolation(node);
        }
        return data;
    }
}
