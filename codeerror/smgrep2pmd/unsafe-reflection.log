Rule Content:
# 转换后的 PMD 规则

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTPrimarySuffix;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class UnsafeReflectionRule extends AbstractJavaRulechainRule {

    public UnsafeReflectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("forName".equals(node.getMethodName()) 
                && node.getQualifier() != null 
                && TypeTestUtil.isA(Class.class, node.getQualifier())) {
            
            ASTPrimaryPrefix prefix = node.getQualifier().getFirstDescendantOfType(ASTPrimaryPrefix.class);
            if (prefix != null) {
                ASTPrimaryExpression expr = prefix.getFirstParentOfType(ASTPrimaryExpression.class);
                if (expr != null) {
                    for (ASTPrimarySuffix suffix : expr.findChildrenOfType(ASTPrimarySuffix.class)) {
                        if (suffix.getImage() != null && suffix.getImage().contains("userInput")) {
                            addViolation(data, node);
                            break;
                        }
                    }
                }
            }
        }
        return data;
    }
}
