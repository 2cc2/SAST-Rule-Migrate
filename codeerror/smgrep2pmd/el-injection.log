Rule Content:
# 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class ElInjectionRule extends AbstractJavaRulechainRule {

    public ElInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        
        // Check for unsafe ValueExpression creation
        if ("createValueExpression".equals(methodName) && node.getArguments().size() >= 2) {
            if (!(node.getArgument(1) instanceof ASTStringLiteral)) {
                asCtx(data).addViolation(node);
            }
        }
        
        // Check for unsafe MethodExpression creation
        else if ("createMethodExpression".equals(methodName) && node.getArguments().size() >= 2) {
            if (!(node.getArgument(1) instanceof ASTStringLiteral)) {
                asCtx(data).addViolation(node);
            }
        }
        
        // Check for unsafe buildConstraintViolationWithTemplate
        else if ("buildConstraintViolationWithTemplate".equals(methodName) && !node.getArguments().isEmpty()) {
            if (!(node.getArgument(0) instanceof ASTStringLiteral)) {
                asCtx(data).addViolation(node);
            }
        }

        return super.visit(node, data);
    }
}
