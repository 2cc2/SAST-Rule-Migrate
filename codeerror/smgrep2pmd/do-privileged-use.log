package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceBodyDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTLambdaExpression;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class DoPrivilegedUseRule extends AbstractJavaRulechainRule {

    public DoPrivilegedUseRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("doPrivileged")) {
            if (TypeTestUtil.isA("java.security.AccessController", node.getQualifier())) {
                asCtx(data).addViolation(node);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTClassOrInterfaceBodyDeclaration node, Object data) {
        if (node.isAnonymousClass() || node.isEnum()) {
            ASTClassOrInterfaceDeclaration parent = node.getFirstParentOfType(ASTClassOrInterfaceDeclaration.class);
            if (parent != null && TypeTestUtil.isA("java.security.PrivilegedAction", parent)) {
                asCtx(data).addViolation(node);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTLambdaExpression node, Object data) {
        ASTVariableDeclaratorId lambdaParam = node.getFormalParameters().firstChild(ASTVariableDeclaratorId.class);
        if (lambdaParam != null && TypeTestUtil.isA("java.security.PrivilegedAction", lambdaParam.getTypeNode())) {
            asCtx(data).addViolation(node);
        }
        return super.visit(node, data);
    }
}
