/**
 * 修改策略：
 * 1. 确保所有Java文件以合法的package声明开头
 * 2. 修正规则类的节点类型声明
 * 3. 完善visit方法实现
 * 4. 添加必要的类型检查和边界条件处理
 */
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class DoPrivilegedUseRule extends AbstractJavaRulechainRule {

    public DoPrivilegedUseRule() {
        super(ASTMethodCall.class, ASTClassOrInterfaceBodyDeclaration.class, ASTLambdaExpression.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        // 检查方法调用是否为AccessController.doPrivileged
        if ("doPrivileged".equals(node.getMethodName())) {
            ASTExpression qualifier = node.getQualifier();
            if (qualifier != null && TypeTestUtil.isA("java.security.AccessController", qualifier)) {
                addViolation(data, node);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTClassOrInterfaceBodyDeclaration node, Object data) {
        // 检查匿名类实现PrivilegedAction的情况
        if (node.isAnonymousClass()) {
            ASTClassOrInterfaceDeclaration parent = 
                node.getFirstParentOfType(ASTClassOrInterfaceDeclaration.class);
            if (parent != null && TypeTestUtil.isA("java.security.PrivilegedAction", parent)) {
                addViolation(data, node);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTLambdaExpression node, Object data) {
        // 检查Lambda表达式实现PrivilegedAction的情况
        ASTVariableDeclaratorId lambdaParam = 
            node.getFirstDescendantOfType(ASTVariableDeclaratorId.class);
        if (lambdaParam != null) {
            ASTTypeNode typeNode = lambdaParam.getTypeNode();
            if (typeNode != null && TypeTestUtil.isA("java.security.PrivilegedAction", typeNode)) {
                addViolation(data, node);
            }
        }
        return super.visit(node, data);
    }
}
