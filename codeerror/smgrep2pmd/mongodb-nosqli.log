Rule Content:
import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCallExpression;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCallExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;

public class MongoDbNoSqlInjectionRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodCallExpression node, Object data) {
        String methodName = node.getMethodName() != null ? node.getMethodName().getImage() : "";
        
        if (isMongoDbOperation(node) && 
            (methodName.equals("put") || methodName.equals("append") || 
             methodName.equals("add") || methodName.equals("putAll"))) {
            
            ASTPrimaryExpression primaryExpr = node.ancestors(ASTPrimaryExpression.class).first();
            if (primaryExpr != null) {
                checkForInjection(primaryExpr, data);
            }
        } else if (isConstructorWithWhereCondition(node)) {
            checkForInjection(node, data);
        }
        
        return super.visit(node, data);
    }

    private boolean isMongoDbOperation(ASTMethodCallExpression node) {
        ASTPrimaryExpression primaryExpr = node.ancestors(ASTPrimaryExpression.class).first();
        if (primaryExpr == null) return false;
        
        String expression = primaryExpr.getImage();
        return expression != null && 
              (expression.contains("BasicDBObject") || 
               expression.contains("BasicDBObjectBuilder"));
    }

    private boolean isConstructorWithWhereCondition(Node node) {
        if (!(node instanceof ASTConstructorCallExpression)) return false;
        
        ASTConstructorCallExpression constCall = (ASTConstructorCallExpression)node;
        String constructor = constCall.getCallingType().getSimpleName();
        if (!constructor.equals("BasicDBObject") && !constructor.equals("BasicDBObjectBuilder")) {
            return false;
        }

        ASTArgumentList args = constCall.getArguments();
        if (args == null || args.size() < 1) return false;

        Node firstArg = args.getChild(0);
        if (firstArg instanceof ASTStringLiteral) {
            String argValue = ((ASTStringLiteral) firstArg).getImage();
            return argValue != null && argValue.contains("$where");
        }
        return false;
    }

    private void checkForInjection(Node node, Object data) {
        ASTArgumentList args = node.firstChild(ASTArgumentList.class);
        if (args == null) return;

        for (Node arg : args.children()) {
            if (arg instanceof ASTStringLiteral) {
                String literalValue = ((ASTStringLiteral) arg).getImage();
                if (literalValue != null && 
                    (literalValue.contains("$where") && 
                     (literalValue.contains("\" +") || literalValue.matches(".*\"\\s*\\+\\s*.*")))) {
                    addViolation(data, node, "Potential NoSQL injection risk found");
                }
            }
        }
    }
}
