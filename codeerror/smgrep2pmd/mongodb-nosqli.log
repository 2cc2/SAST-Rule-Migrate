package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class MongoDbNoSqlInjectionRule extends AbstractJavaRulechainRule {

    public MongoDbNoSqlInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        
        // Detect risky MongoDB operations (put, putAll, append, etc)
        if (("put".equals(methodName) || "append".equals(methodName) || "putAll".equals(methodName) 
            || "add".equals(methodName) || "start".equals(methodName) || "parse".equals(methodName))
            && node.getQualifier() != null) {
            
            // Check if it's a BasicDBObject operation
            if (TypeTestUtil.isA("com.mongodb.BasicDBObject", node.getQualifier())
                || TypeTestUtil.isA("com.mongodb.BasicDBObjectBuilder", node.getQualifier())) {
                
                // Check for $where clause with string concatenation
                if (node.getArguments().size() > 0) {
                    ASTStringLiteral keyLiteral = node.getArguments().get(0).descendantsOrSelf()
                            .filterIs(ASTStringLiteral.class).first();
                    
                    if (keyLiteral != null && "$where".equals(keyLiteral.getConstValue())) {
                        ASTStringLiteral valueLiteral = node.getArguments().get(1).descendantsOrSelf()
                                .filterIs(ASTStringLiteral.class).first();
                        
                        if (valueLiteral != null) {
                            String value = valueLiteral.getConstValue();
                            if (value != null && value.contains("\" +")) {
                                addViolation(data, node);
                            }
                        }
                        
                        // Also check for variable access in the value
                        ASTVariableAccess varAccess = node.getArguments().get(1).descendantsOrSelf()
                                .filterIs(ASTVariableAccess.class).first();
                        if (varAccess != null) {
                            addViolation(data, node);
                        }
                    }
                }
            }
        }
        return data;
    }
}
