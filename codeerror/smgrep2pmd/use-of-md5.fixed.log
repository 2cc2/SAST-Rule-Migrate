package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.ast.AbstractJavaTypeNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

import java.security.MessageDigest;
import java.util.Arrays;

public class AvoidMD5Rule extends AbstractJavaRulechainRule {

    public AvoidMD5Rule() {
        super(ASTMethodCall.class, ASTConstructorCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isMessageDigestGetInstanceSHA512(node)) {
            addViolation(data, node);
        } else if (isDigestUtilsGetMd5DigestCall(node)) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(MessageDigest.class, node)) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    private boolean isMessageDigestGetInstanceSHA512(ASTMethodCall node) {
        return node.getMethodName().equals("getInstance") &&
               TypeTestUtil.isA(MessageDigest.class, node.getQualifier()) &&
               node.getArguments().size() == 1 &&
               node.getArgument(0) instanceof String &&
               "SHA-512".equals(node.getArgument(0));
    }

    private boolean isDigestUtilsGetMd5DigestCall(ASTMethodCall node) {
        return node.getMethodName().equals("getMd5Digest") &&
               TypeTestUtil.isA("org.apache.commons.codec.digest.DigestUtils", node.getQualifier());
    }
}
