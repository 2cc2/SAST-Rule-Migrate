package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class JdbcSqliRule extends AbstractJavaRulechainRule {

    public JdbcSqliRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        if (isJdbcExecuteMethod(methodName)) {
            if (isConcatenatedQuery(node) || isVariablePassedDirectly(node)) {
                asCtx(data).addViolation(node);
            }
        }
        return super.visit(node, data);
    }

    private boolean isJdbcExecuteMethod(String methodName) {
        return methodName.equals("executeQuery") 
            || methodName.equals("execute")
            || methodName.equals("executeUpdate")
            || methodName.equals("executeLargeUpdate")
            || methodName.equals("addBatch")
            || methodName.equals("nativeSQL");
    }

    private boolean isConcatenatedQuery(ASTMethodCall node) {
        return node.getArguments().descendants(ASTStringLiteral.class)
            .anyMatch(lit -> lit.getContent().contains("'+") || lit.getContent().contains("+\""));
    }

    private boolean isVariablePassedDirectly(ASTMethodCall node) {
        return !node.getArguments().descendants(ASTVariableAccess.class).isEmpty();
    }
}
