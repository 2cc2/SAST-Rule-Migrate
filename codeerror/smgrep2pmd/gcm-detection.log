package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class GcmHardcodedIVRule extends AbstractJavaRulechainRule {

    public GcmHardcodedIVRule() {
        super(ASTConstructorCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA("javax.crypto.spec.GCMParameterSpec", node)) {
            ASTArgumentList arguments = node.getArguments();
            if (arguments.size() > 1) {
                checkIVArgument(data, arguments.get(1));
            }
        }
        return super.visit(node, data);
    }

    private void checkIVArgument(Object data, ASTExpression argument) {
        if (argument == null) {
            return;
        }

        if (argument instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess)argument;
            if (varAccess.getSignature() != null 
                && varAccess.getSignature().getSymbol() != null) {
                ASTVariableId varDecl = varAccess.getSignature().getSymbol().tryGetNode();
                if (varDecl != null && isHardcodedIV(varDecl.getName())) {
                    addViolation(data, argument);
                }
            }
        } else if (argument instanceof ASTStringLiteral) {
            String literalValue = ((ASTStringLiteral)argument).getImage();
            if (isHardcodedIV(literalValue)) {
                addViolation(data, argument);
            }
        } else if (argument instanceof ASTArrayInitializer) {
            addViolation(data, argument);
        }
    }

    private boolean isHardcodedIV(String value) {
        return value != null && 
              (value.equals("ab0123456789") ||
               value.contains("0123456789") ||
               value.equalsIgnoreCase("BAD_IV") ||
               value.equalsIgnoreCase("BAD_IV2"));
    }

    private void addViolation(Object data, ASTNode node) {
        asCtx(data).addViolation(node);
    }
}
