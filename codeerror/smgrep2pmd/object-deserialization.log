# 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTTryStatement;
import net.sourceforge.pmd.lang.java.ast.ASTResource;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import java.io.ObjectInputStream;

public class ObjectDeserializationRule extends AbstractJavaRulechainRule {

    public ObjectDeserializationRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class, ASTTryStatement.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isExactlyA(ObjectInputStream.class, node)) {
            asCtx(data).addViolation(node);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("readObject".equals(node.getMethodName()) 
            && node.getQualifier() instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) node.getQualifier();
            if (TypeTestUtil.isExactlyA(ObjectInputStream.class, varAccess.getTypeMirror())) {
                asCtx(data).addViolation(node);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTTryStatement node, Object data) {
        for (ASTResource resource : node.getResources()) {
            if (resource.getInitializer() instanceof ASTConstructorCall) {
                ASTConstructorCall constructor = (ASTConstructorCall) resource.getInitializer();
                if ("ObjectInputStream".equals(constructor.getTypeName())) {
                    asCtx(data).addViolation(constructor);
                }
            }
        }
        return super.visit(node, data);
    }
}
