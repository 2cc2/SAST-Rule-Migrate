package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTVariableId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class AvoidMD5UsageRule extends AbstractJavaRulechainRule {

    public AvoidMD5UsageRule() {
        super(ASTMethodCall.class, ASTConstructorCall.class, ASTVariableDeclaration.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        if ("getInstance".equals(methodName) && node.getArguments().size() > 0) {
            String arg = node.getArguments().get(0).toString();
            if (arg.contains("MD5")) {
                addViolation(data, node);
            }
        } else if ("getMd5Digest".equals(methodName)) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(MessageDigest.class, node)) {
            if (node.getArguments().size() > 0) {
                String arg = node.getArguments().get(0).toString();
                if (arg.contains("MD5")) {
                    addViolation(data, node);
                }
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTVariableDeclaration node, Object data) {
        for (ASTVariableId var : node) {
            if (var.getInitializer() != null) {
                String init = var.getInitializer().toString();
                if (init.contains("MD5") || init.contains("getMd5Digest")) {
                    addViolation(data, node);
                }
            }
        }
        return super.visit(node, data);
    }
}
