package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTAssignmentOperator;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;

public class TaintedSqlStringRule extends AbstractJavaRulechainRule {

    public TaintedSqlStringRule() {
        super(ASTVariableDeclaratorId.class, ASTMethodCall.class, ASTAssignmentOperator.class);
    }

    @Override
    public Object visit(ASTVariableDeclaratorId node, Object data) {
        if (node.getName().equals("sql") && node.getInitializer() != null) {
            checkForTaintedString(node.getInitializer(), data);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("concat".equals(node.getMethodName()) || "append".equals(node.getMethodName())) {
            if (TypeTestUtil.isA(StringBuilder.class, node.getQualifier()) || 
                TypeTestUtil.isA(String.class, node.getQualifier())) {
                checkForTaintedString(node, data);
            }
        } else if ("format".equals(node.getMethodName()) && "java.lang.String".equals(node.getMethodType().getClassName())) {
            checkForTaintedString(node, data);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTAssignmentOperator node, Object data) {
        if (node.getLeftOperand() instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) node.getLeftOperand();
            if (varAccess.getName().equals("sql")) {
                checkForTaintedString(node.getRightOperand(), data);
            }
        }
        return super.visit(node, data);
    }

    private void checkForTaintedString(ASTExpression expr, Object data) {
        boolean hasTaintedInput = expr.descendantsOrSelf()
            .filter(ASTVariableAccess.class::isInstance)
            .map(ASTVariableAccess.class::cast)
            .anyMatch(v -> v.getName().equals("name"));

        boolean isSqlString = expr.descendantsOrSelf()
            .filter(ASTStringLiteral.class::isInstance)
            .map(ASTStringLiteral.class::cast)
            .anyMatch(s -> s.getImage().contains("SELECT") || 
                          s.getImage().contains("INSERT") || 
                          s.getImage().contains("UPDATE") || 
                          s.getImage().contains("DELETE"));

        if (hasTaintedInput && isSqlString) {
            asCtx(data).addViolation(expr);
        }
    }
}
