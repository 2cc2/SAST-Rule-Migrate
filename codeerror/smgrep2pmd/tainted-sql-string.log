package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class TaintedSqlStringRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTVariableDeclaratorId node, Object data) {
        if (node.getName() != null && node.getName().equals("query")) {
            if (node.getParent() instanceof ASTVariableDeclarator) {
                ASTVariableDeclarator declarator = (ASTVariableDeclarator) node.getParent();
                ASTVariableInitializer initializer = declarator.getInitializer();
                
                if (initializer != null && initializer.hasDescendantOfType(ASTAdditiveExpression.class)) {
                    ASTAdditiveExpression additiveExpr = initializer.descendants(ASTAdditiveExpression.class).first();
                    if (additiveExpr.hasDescendantOfType(ASTVariableAccess.class)) {
                        ASTVariableAccess varAccess = additiveExpr.descendants(ASTVariableAccess.class).first();
                        if (varAccess != null) {
                            addViolation(data, node, "Database query built using string concatenation with unparameterized user input");
                        }
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTStatementExpression node, Object data) {
        if (node.hasDescendantOfType(ASTPrimaryExpression.class)) {
            ASTPrimaryExpression primaryExpr = node.descendants(ASTPrimaryExpression.class).first();
            if (primaryExpr.hasDescendantOfType(ASTPrimaryPrefix.class)) {
                ASTPrimaryPrefix prefix = primaryExpr.descendants(ASTPrimaryPrefix.class).first();
                if (prefix != null && "executeQuery".equals(prefix.getImage())) {
                    if (node.hasDescendantOfType(ASTArguments.class)) {
                        ASTArguments args = node.descendants(ASTArguments.class).first();
                        if (args != null && args.hasDescendantOfType(ASTAdditiveExpression.class)) {
                            ASTAdditiveExpression additiveExpr = args.descendants(ASTAdditiveExpression.class).first();
                            if (additiveExpr.hasDescendantOfType(ASTVariableAccess.class)) {
                                ASTVariableAccess varAccess = additiveExpr.descendants(ASTVariableAccess.class).first();
                                if (varAccess != null) {
                                    addViolation(data, node, "Database query executed with unparameterized user input");
                                }
                            }
                        }
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
