import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTAdditiveExpression;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTBlockStatement;
import net.sourceforge.pmd.lang.java.ast.ASTStatementExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.JavaNode;

public class TaintedSQLStringRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        // Check each statement in the method body
        for (ASTBlockStatement blockStmt : node.findChildrenOfType(ASTBlockStatement.class)) {
            // Look for statement expressions (method calls)
            ASTStatementExpression stmtExpr = blockStmt.getFirstDescendantOfType(ASTStatementExpression.class);
            if (stmtExpr != null) {
                checkForTaintedSQL(stmtExpr, data);
            }
        }
        return super.visit(node, data);
    }

    private void checkForTaintedSQL(ASTStatementExpression stmtExpr, Object data) {
        // Check if this is a Statement.executeQuery() call
        ASTPrimaryExpression primaryExpr = stmtExpr.getFirstDescendantOfType(ASTPrimaryExpression.class);
        if (primaryExpr == null) return;

        ASTName methodName = primaryExpr.getFirstDescendantOfType(ASTName.class);
        if (methodName != null && methodName.getImage().endsWith(".executeQuery")) {
            // Get the argument passed to executeQuery
            ASTArgumentList args = primaryExpr.getFirstDescendantOfType(ASTArgumentList.class);
            if (args != null && args.getNumChildren() > 0) {
                ASTExpression argExpr = (ASTExpression) args.getChild(0);
                // Check if the SQL string contains concatenation with non-literal values
                if (containsNonLiteralConcatenation(argExpr)) {
                    addViolation(data, argExpr, "Potential SQL injection - SQL string concatenated with non-literal value");
                }
            }
        }
    }

    private boolean containsNonLiteralConcatenation(JavaNode node) {
        // Look for additive expressions (string concatenation)
        for (ASTAdditiveExpression addExpr : node.findDescendantsOfType(ASTAdditiveExpression.class)) {
            // Check if either operand is not a string literal
            for (int i = 0; i < addExpr.getNumChildren(); i++) {
                ASTLiteral literal = addExpr.getChild(i).getFirstDescendantOfType(ASTLiteral.class);
                if (literal == null) {
                    return true;
                }
            }
        }
        return false;
    }
}
