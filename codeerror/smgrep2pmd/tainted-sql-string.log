package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTAssignmentOperator;
import net.sourceforge.pmd.lang.java.ast.ASTAssignmentExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class TaintedSqlStringRule extends AbstractJavaRulechainRule {

    public TaintedSqlStringRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (!"executeQuery".equals(node.getMethodName())) {
            return data;
        }

        if (node.getArguments().size() == 0) {
            return data;
        }

        ASTExpression arg = node.getArguments().get(0);
        if (arg instanceof ASTStringLiteral) {
            String sql = ((ASTStringLiteral) arg).getContent();
            if (sql.matches(".*=\\s*\\+\\s*\\w+.*")) {
                asCtx(data).addViolation(arg);
            }
        } else if (arg instanceof ASTVariableAccess) {
            // Check if variable is constructed with user input
            ASTVariableAccess varAccess = (ASTVariableAccess) arg;
            if (varAccess.getSignature() != null && varAccess.getSignature().getSymbol() != null) {
                varAccess.getSignature().getSymbol().getDeclarations().forEach(decl -> {
                    if (decl.getInitializer() != null) {
                        checkExpressionForTaintedConcatenation(decl.getInitializer(), data);
                    }
                });
            }
        }

        return data;
    }

    private void checkExpressionForTaintedConcatenation(ASTExpression expr, Object data) {
        if (expr instanceof ASTAssignmentExpression) {
            ASTAssignmentExpression assign = (ASTAssignmentExpression) expr;
            if (assign.getOperator() == ASTAssignmentOperator.ASSIGN) {
                checkExpressionForTaintedConcatenation(assign.getRightOperand(), data);
            }
        } else if (expr != null && expr.descendantsOrSelf()
                .filterIs(ASTStringLiteral.class)
                .anyMatch(lit -> lit.getContent().matches(".*=\\s*\\+\\s*\\w+.*"))) {
            asCtx(data).addViolation(expr);
        }
    }
}
