// 转换后的 PMD 规则
package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class TaintedSqlStringRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTVariableDeclaratorId node, Object data) {
        if (node.getName() != null && node.getName().equals("query")) {
            ASTVariableDeclarator declarator = (ASTVariableDeclarator) node.getParent();
            ASTVariableInitializer initializer = declarator.getInitializer();
            
            if (initializer != null) {
                ASTAdditiveExpression additiveExpr = initializer.getFirstDescendantOfType(ASTAdditiveExpression.class);
                if (additiveExpr != null) {
                    ASTName name = additiveExpr.getFirstDescendantOfType(ASTName.class);
                    if (name != null && !name.getImage().startsWith("'")) {
                        addViolation(data, node, "Database query built using string concatenation with unparameterized user input");
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTStatementExpression node, Object data) {
        ASTPrimaryExpression primaryExpr = node.getFirstDescendantOfType(ASTPrimaryExpression.class);
        if (primaryExpr != null) {
            ASTPrimaryPrefix prefix = primaryExpr.getFirstDescendantOfType(ASTPrimaryPrefix.class);
            if (prefix != null && "executeQuery".equals(prefix.getImage())) {
                ASTArguments args = node.getFirstDescendantOfType(ASTArguments.class);
                if (args != null) {
                    ASTAdditiveExpression additiveExpr = args.getFirstDescendantOfType(ASTAdditiveExpression.class);
                    if (additiveExpr != null) {
                        ASTName name = additiveExpr.getFirstDescendantOfType(ASTName.class);
                        if (name != null && !name.getImage().startsWith("'")) {
                            addViolation(data, node, "Database query executed with unparameterized user input");
                        }
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
