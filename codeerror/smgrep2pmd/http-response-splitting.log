# 转换后的 PMD 规则

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTVariableId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.servlet.http.Cookie;
import javax.servlet.http.HttpServletResponse;

public class HttpResponseSplittingRule extends AbstractJavaRulechainRule {

    public HttpResponseSplittingRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(Cookie.class, node)) {
            if (node.getArguments().size() > 0) {
                checkCookieValueArgument(data, node.getArguments().get(0));
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("addCookie".equals(node.getMethodName())) {
            ASTExpression qualifier = node.getQualifier();
            if (qualifier != null && TypeTestUtil.isA(HttpServletResponse.class, qualifier)
                && node.getArguments().size() > 0) {
                checkCookieValueArgument(data, node.getArguments().get(0));
            }
        }
        return super.visit(node, data);
    }

    private void checkCookieValueArgument(Object data, ASTExpression expr) {
        if (expr == null) {
            return;
        }

        if (expr instanceof ASTMethodCall) {
            ASTMethodCall methodCall = (ASTMethodCall) expr;
            if ("getParameter".equals(methodCall.getMethodName())) {
                asCtx(data).addViolation(expr);
            }
        } else if (expr instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) expr;
            if (varAccess.getSignature() != null 
                && varAccess.getSignature().getSymbol() != null) {
                ASTVariableId varDecl = varAccess.getSignature().getSymbol().tryGetNode();
                if (varDecl != null) {
                    ASTExpression initializer = varDecl.getInitializer();
                    if (initializer != null) {
                        checkCookieValueArgument(data, initializer);
                    }
                }
            }
        } else if (expr instanceof ASTStringLiteral) {
            ASTStringLiteral literal = (ASTStringLiteral) expr;
            if (containsCRLF(literal.getContent())) {
                asCtx(data).addViolation(expr);
            }
        }
    }

    private boolean containsCRLF(String value) {
        return value != null && (value.contains("\r") || value.contains("\n"));
    }
}
