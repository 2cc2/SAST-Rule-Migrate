Rule Content:
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class RSANoPaddingRule extends AbstractJavaRulechainRule {

    public RSANoPaddingRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("getInstance")) {
            ASTStringLiteral literal = node.getArguments()
                                         .descendantsOrSelf()
                                         .filterIs(ASTStringLiteral.class)
                                         .first();
            
            if (literal != null) {
                String algorithm = literal.getConstantValue();
                if (algorithm != null && algorithm.matches("(?i)RSA/NONE/NoPadding")) {
                    asCtx(data).addViolation(node);
                }
            }
        }
        return super.visit(node, data);
    }
}
