/**
 * 修复策略：
 * 1. 保留原始的规则核心逻辑，检测GroovyShell的危险使用方法
 * 2. 修复方法调用链语法，使用更兼容的PMD API
 * 3. 确保所有方法都有正确的返回类型
 * 4. 添加必要的空检查
 * 5. 保持原有的安全检测能力
 */
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import java.util.Iterator;

public class DangerousGroovyShellRule extends AbstractJavaRulechainRule {

    public DangerousGroovyShellRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isGroovyShellEvaluateCall(node) || 
            isGroovyShellParseCall(node) || 
            isGroovyClassLoaderParseClassCall(node)) {
            
            if (!node.getArguments().isEmpty()) {
                ASTExpression firstArg = node.getArguments().get(0);
                if (firstArg != null && !isHardcodedString(firstArg)) {
                    asCtx(data).addViolation(node);
                }
            } else {
                asCtx(data).addViolation(node);
            }
        }
        return super.visit(node, data);
    }

    private boolean isGroovyShellEvaluateCall(ASTMethodCall node) {
        return node != null 
            && TypeTestUtil.isA("groovy.lang.GroovyShell", node.getQualifier())
            && "evaluate".equals(node.getMethodName());
    }

    private boolean isGroovyShellParseCall(ASTMethodCall node) {
        return node != null 
            && TypeTestUtil.isA("groovy.lang.GroovyShell", node.getQualifier())
            && "parse".equals(node.getMethodName());
    }

    private boolean isGroovyClassLoaderParseClassCall(ASTMethodCall node) {
        return node != null 
            && TypeTestUtil.isA("groovy.lang.GroovyClassLoader", node.getQualifier())
            && "parseClass".equals(node.getMethodName());
    }

    private boolean isHardcodedString(ASTExpression expr) {
        if (expr == null) {
            return false;
        }
        
        Iterator<ASTStringLiteral> stringLiterals = expr.descendants(ASTStringLiteral.class).iterator();
        return stringLiterals.hasNext();
    }
}
