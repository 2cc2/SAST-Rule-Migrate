Rule Content:
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class JdoSqlInjectionRule extends AbstractJavaRulechainRule {

    public JdoSqlInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isJdoQueryMethod(node)) {
            checkForSqlInjection(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isJdoQueryMethod(ASTMethodCall node) {
        String methodName = node.getMethodName();
        return "setFilter".equals(methodName) 
                || "setGrouping".equals(methodName)
                || "newQuery".equals(methodName);
    }

    private void checkForSqlInjection(ASTMethodCall node, Object data) {
        ASTArgumentList args = node.getArguments();
        if (args.size() == 0) {
            return;
        }

        ASTExpression firstArg = args.get(0);
        if (firstArg == null) {
            return;
        }

        if (isStringConcatenation(firstArg)) {
            if (containsVariable(firstArg)) {
                asCtx(data).addViolation(node);
            }
        } else if (firstArg instanceof ASTVariableAccess) {
            asCtx(data).addViolation(node);
        }
    }

    private boolean isStringConcatenation(ASTExpression expr) {
        return expr instanceof ASTAdditiveExpression 
                && ((ASTAdditiveExpression) expr).getOperator() == ASTAdditiveExpression.Operator.PLUS;
    }

    private boolean containsVariable(ASTExpression expr) {
        return expr.descendants(ASTVariableAccess.class).nonEmpty()
                || (expr instanceof ASTAdditiveExpression 
                    && (containsVariable(((ASTAdditiveExpression) expr).getLeftOperand())
                        || containsVariable(((ASTAdditiveExpression) expr).getRightOperand())));
    }
}
