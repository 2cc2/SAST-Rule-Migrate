# 转换后的 PMD 规则

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class AnonymousLdapBindRule extends AbstractJavaRulechainRule {

    public AnonymousLdapBindRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isVulnerableLdapBind(node)) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    private boolean isVulnerableLdapBind(ASTMethodCall node) {
        return node.getMethodName().equals("put") &&
               isEnvVariable(node.getQualifier()) &&
               hasInsecureAuthentication(node.getArguments());
    }

    private boolean isEnvVariable(ASTExpression expr) {
        return expr instanceof ASTVariableAccess && 
               ((ASTVariableAccess) expr).getName().equals("env");
    }

    private boolean hasInsecureAuthentication(List<ASTExpression> args) {
        if (args.size() < 2) return false;
        
        ASTExpression firstArg = args.get(0);
        ASTExpression secondArg = args.get(1);
        
        return isSecurityAuthentication(firstArg) && 
               isNoneAuthentication(secondArg);
    }

    private boolean isSecurityAuthentication(ASTExpression expr) {
        return expr instanceof ASTVariableAccess && 
               ((ASTVariableAccess) expr).getName().equals("SECURITY_AUTHENTICATION");
    }

    private boolean isNoneAuthentication(ASTExpression expr) {
        return expr instanceof ASTStringLiteral &&
               "none".equals(((ASTStringLiteral) expr).getConstantValue());
    }
}
