# 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import java.security.MessageDigest;
import org.apache.commons.codec.digest.DigestUtils;

public class AvoidMD5DigestRule extends AbstractJavaRulechainRule {

    public AvoidMD5DigestRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isMD5DigestUtilsCall(node) || isMessageDigestMD5Call(node)) {
            asCtx(data).addViolation(node);
        }
        return super.visit(node, data);
    }

    private boolean isMD5DigestUtilsCall(ASTMethodCall node) {
        return TypeTestUtil.isA(DigestUtils.class, node.getQualifier())
                && "getMd5Digest".equals(node.getMethodName());
    }

    private boolean isMessageDigestMD5Call(ASTMethodCall node) {
        if (!"getInstance".equals(node.getMethodName()) || !TypeTestUtil.isA(MessageDigest.class, node.getQualifier())) {
            return false;
        }

        ASTExpression firstArg = node.getFirstChildOfType(ASTExpression.class);
        if (firstArg instanceof ASTStringLiteral) {
            ASTStringLiteral literal = (ASTStringLiteral) firstArg;
            return "MD5".equals(literal.getConstValue());
        }
        return false;
    }
}
