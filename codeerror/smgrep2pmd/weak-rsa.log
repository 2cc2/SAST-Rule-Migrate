            ```java
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class WeakRSAKeyRule extends AbstractJavaRulechainRule {
    
    public WeakRSAKeyRule() {
        super(ASTMethodCall.class);
    }
    
    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("initialize") && 
            TypeTestUtil.isA(KeyPairGenerator.class, node.getQualifier())) {
            ASTLiteral literal = node.getFirstDescendantOfType(ASTLiteral.class);
            if (literal != null && literal.getValue() instanceof Number) {
                int keySize = ((Number) literal.getValue()).intValue();
                if (keySize < 2048) {
                    addViolation(data, node, "使用弱RSA密钥长度(" + keySize + "位)，建议使用2048位或以上的密钥");
                }
            }
        }
        return data;
    }
}
```
