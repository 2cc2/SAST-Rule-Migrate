// 转换后的 PMD 规则
package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class JaxRsPathTraversalRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTClassOrInterfaceDeclaration node, Object data) {
        if (hasJaxRsPathAnnotation(node)) {
            return super.visit(node, data);
        }
        return data;
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        if (hasJaxRsAnnotations(node)) {
            checkForPathTraversalVulnerability(node, data);
        }
        return super.visit(node, data);
    }

    private boolean hasJaxRsPathAnnotation(ASTClassOrInterfaceDeclaration node) {
        return node.getAnnotation("Path") != null;
    }

    private boolean hasJaxRsAnnotations(ASTMethodDeclaration node) {
        return node.getAnnotation("GET") != null 
                && node.getAnnotation("Path") != null 
                && node.getAnnotation("Produces") != null;
    }

    private void checkForPathTraversalVulnerability(ASTMethodDeclaration node, Object data) {
        node.findDescendantsOfType(ASTPrimaryPrefix.class).forEach(primaryPrefix -> {
            if (isFileConstructorCall(primaryPrefix)) {
                ASTArgumentList args = primaryPrefix.getFirstParentOfType(ASTArgumentList.class);
                if (args != null && args.size() > 1) {
                    // Check if second argument is raw PathParam without sanitization
                    if (!isSanitized(args.getChild(1))) {
                        addViolation(data, primaryPrefix, "Potential path traversal vulnerability - unsanitized path parameter used in File constructor");
                    }
                }
            }
        });
    }

    private boolean isFileConstructorCall(ASTPrimaryPrefix node) {
        ASTName name = node.getFirstDescendantOfType(ASTName.class);
        return name != null && name.getImage().equals("File");
    }

    private boolean isSanitized(org.apache.commons.lang3.tuple.Pair<ASTArgumentList, Integer> arg) {
        // Check for common sanitization methods like FilenameUtils.getName()
        ASTPrimaryPrefix prefix = arg.getLeft().getFirstDescendantOfType(ASTPrimaryPrefix.class);
        if (prefix != null) {
            ASTName name = prefix.getFirstDescendantOfType(ASTName.class);
            return name != null && name.getImage().contains("FilenameUtils.getName");
        }
        return false;
    }
}
