package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.ast.ASTAnnotation;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class JaxRsPathTraversalRule extends AbstractJavaRulechainRule {

    public JaxRsPathTraversalRule() {
        super(ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        // 检查是否为JAX-RS GET方法
        if (node.getAnnotation("GET") == null) {
            return data;
        }

        // 检查是否有Path注解
        ASTAnnotation pathAnnotation = node.getAnnotation("Path");
        if (pathAnnotation == null) {
            return data;
        }

        // 检查方法参数是否直接用于File构造
        node.getFormalParameters().forEach(param -> {
            ASTVariableDeclaratorId varId = param.getVarId();
            if (varId != null) {
                varId.getLocalUsages().forEach(usage -> {
                    if (usage.getParent() instanceof ASTConstructorCall) {
                        ASTConstructorCall constructorCall = (ASTConstructorCall) usage.getParent();
                        if (TypeTestUtil.isA(File.class, constructorCall) && 
                            constructorCall.getArguments().size() > 1 &&
                            isPathParamWithoutValidation(param)) {
                            asCtx(data).addViolation(constructorCall);
                        }
                    }
                });
            }
        });

        return data;
    }

    private boolean isPathParamWithoutValidation(ASTFormalParameter param) {
        // 检查是否有PathParam注解
        boolean hasPathParam = param.getAnnotations().any(it -> 
            "PathParam".equals(it.getAnnotationName()));

        // 检查是否使用了FilenameUtils.getName等安全处理
        boolean hasValidation = param.getLocalUsages().stream().anyMatch(usage -> {
            if (usage.getParent() instanceof ASTMethodCall) {
                ASTMethodCall methodCall = (ASTMethodCall) usage.getParent();
                return "getName".equals(methodCall.getMethodName()) && 
                       "FilenameUtils".equals(methodCall.getQualifier().toString());
            }
            return false;
        });

        return hasPathParam && !hasValidation;
    }
}
