# 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class BadHexaConversionRule extends AbstractJavaRulechainRule {

    public BadHexaConversionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("toHexString".equals(node.getMethodName())) {
            JavaNode qualifier = node.getQualifier();
            if (qualifier instanceof ASTVariableAccess) {
                ASTVariableAccess varAccess = (ASTVariableAccess) qualifier;
                if ("Integer".equals(varAccess.getName())) {
                    if (isInHashingContext(node)) {
                        ASTStringLiteral formatLiteral = node.getParent()
                            .descendantsOrSelf()
                            .filter(ASTStringLiteral.class)
                            .first();
                        if (formatLiteral == null || !"%02X".equals(formatLiteral.getConstantValue())) {
                            addViolation(data, node);
                        }
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isInHashingContext(ASTMethodCall node) {
        return node.ancestors().any(it -> it.toString().contains("MessageDigest"));
    }
}
