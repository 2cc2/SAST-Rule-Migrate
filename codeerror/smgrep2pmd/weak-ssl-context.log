import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.net.ssl.SSLContext;

public class WeakSSLContextRule extends AbstractJavaRulechainRule {

    private static final String[] WEAK_PROTOCOLS = {
        "SSL",
        "TLS", 
        "TLSv1",
        "SSLv3",
        "TLSv1.1"
    };

    public WeakSSLContextRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("getInstance") 
            && TypeTestUtil.isA(SSLContext.class, node.getMethodType().getResultType())) {
            
            node.getArguments().forEach(arg -> {
                ASTStringLiteral literal = arg.descendantsOrSelf()
                    .filterIs(ASTStringLiteral.class)
                    .first();
                
                if (literal != null) {
                    String protocol = literal.getConstValue();
                    for (String weakProtocol : WEAK_PROTOCOLS) {
                        if (weakProtocol.equals(protocol)) {
                            asCtx(data).addViolation(node);
                            break;
                        }
                    }
                }
            });
        }
        return data;
    }
}
