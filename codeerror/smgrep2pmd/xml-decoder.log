package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class XmlDecoderRule extends AbstractJavaRulechainRule {

    public XmlDecoderRule() {
        super(ASTConstructorCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isExactlyA(java.beans.XMLDecoder.class, node)) {
            if (node.getArguments().size() > 0) {
                ASTExpression firstArg = node.getArguments().get(0);
                if (!isSafeXmlSource(firstArg)) {
                    asCtx(data).addViolation(node);
                }
            }
        }
        return data;
    }

    private boolean isSafeXmlSource(ASTExpression expr) {
        if (expr != null && expr.descendantsOrSelf().filterIs(ASTStringLiteral.class).nonEmpty()) {
            return true;
        }
        
        if (expr instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) expr;
            if (varAccess.getSignature() != null && varAccess.getSignature().getSymbol() != null) {
                ASTExpression init = varAccess.getSignature().getSymbol().tryGetNode().getInitializer();
                if (init != null && init.descendantsOrSelf().filterIs(ASTStringLiteral.class).nonEmpty()) {
                    return true;
                }
            }
        }
        return false;
    }
}
