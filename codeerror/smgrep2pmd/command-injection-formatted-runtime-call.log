package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class CommandInjectionRuntimeCallRule extends AbstractJavaRulechainRule {

    public CommandInjectionRuntimeCallRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isRuntimeExecCall(node) || isRuntimeLoadLibraryCall(node)) {
            checkForCommandInjection(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isRuntimeExecCall(ASTMethodCall node) {
        return TypeTestUtil.isA(Runtime.class, node.getQualifier())
                && "exec".equals(node.getMethodName())
                && node.getArguments().size() > 0;
    }

    private boolean isRuntimeLoadLibraryCall(ASTMethodCall node) {
        return TypeTestUtil.isA(Runtime.class, node.getQualifier())
                && "loadLibrary".equals(node.getMethodName())
                && node.getArguments().size() > 0;
    }

    private void checkForCommandInjection(ASTMethodCall node, Object data) {
        node.getArguments().forEach(arg -> {
            if (arg instanceof ASTStringLiteral) {
                ASTStringLiteral literal = (ASTStringLiteral) arg;
                String image = literal.getImage();
                if (image.contains("$") || image.contains("%")) {
                    asCtx(data).addViolation(node);
                }
            } else {
                // For non-literal arguments (variables, expressions), we consider them risky
                asCtx(data).addViolation(node);
            }
        });
    }
}
