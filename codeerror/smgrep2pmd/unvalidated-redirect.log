Rule Content:
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

public class UnvalidatedRedirectRule extends AbstractJavaRulechainRule {
    
    public UnvalidatedRedirectRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        
        if (("sendRedirect".equals(methodName) || "addHeader".equals(methodName)) 
            && TypeTestUtil.isA(HttpServletResponse.class, node.getQualifier())) {
            
            if ("addHeader".equals(methodName)) {
                if (node.getArguments().size() > 0 
                    && node.getArguments().get(0) instanceof ASTStringLiteral) {
                    ASTStringLiteral literal = (ASTStringLiteral) node.getArguments().get(0);
                    if (!"Location".equals(literal.getConstValue())) {
                        return super.visit(node, data);
                    }
                }
            }
            
            if (node.getArguments().size() > 1) {
                checkForUnvalidatedParam(node.getArguments().get(1), data);
            } else if (node.getArguments().size() > 0) {
                checkForUnvalidatedParam(node.getArguments().get(0), data);
            }
        }
        
        return super.visit(node, data);
    }
    
    private void checkForUnvalidatedParam(JavaNode arg, Object data) {
        if (arg instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) arg;
            if (varAccess.getSignature() != null && varAccess.getSignature().getSymbol() != null) {
                ASTVariableId varDecl = varAccess.getSignature().getSymbol().tryGetNode();
                
                varDecl.getLocalUsages().forEach(usage -> {
                    if (usage.getParent() instanceof ASTMethodCall) {
                        ASTMethodCall methodCall = (ASTMethodCall) usage.getParent();
                        if ("getParameter".equals(methodCall.getMethodName()) 
                            && TypeTestUtil.isA(HttpServletRequest.class, methodCall.getQualifier())) {
                            asCtx(data).addViolation(methodCall);
                        }
                    }
                });
            }
        } else if (arg instanceof ASTMethodCall) {
            ASTMethodCall methodCall = (ASTMethodCall) arg;
            if ("getParameter".equals(methodCall.getMethodName()) 
                && TypeTestUtil.isA(HttpServletRequest.class, methodCall.getQualifier())) {
                asCtx(data).addViolation(methodCall);
            }
        }
    }
}
