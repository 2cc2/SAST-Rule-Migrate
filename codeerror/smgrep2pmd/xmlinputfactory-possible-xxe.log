package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.AbstractJavaTypeNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge pmd.lang.ast.Node;

public class XMLInputFactoryXXERule extends AbstractJavaRule {
    private static final String XML_INPUT_FACTORY = "XMLInputFactory";
    private static final String IS_SUPPORTING_EXTERNAL_ENTITIES = "IS_SUPPORTING_EXTERNAL_ENTITIES";
    private static final String SUPPORT_DTD = "SUPPORT_DTD";
    private static final String SET_PROPERTY = "setProperty";

    @Override
    public Object visit(ASTClassOrInterfaceDeclaration node, Object data) {
        return super.visit(node, data);
    }

    private boolean isXMLInputFactoryNewFactoryCall(AbstractJavaTypeNode node) {
        return "newFactory".equals(node.getImage())
            && node.getFirstParentOfType(ASTVariableDeclaratorId.class) != null
            && node.getFirstParentOfType(ASTVariableDeclaratorId.class).getName().contains(XML_INPUT_FACTORY);
    }

    private void checkXXEProperties(AbstractJavaTypeNode factoryCall, Object data) {
        boolean hasDTDSet = false;
        boolean hasExternalEntitiesSet = false;

        Node parent = factoryCall.getParent().getParent();
        for (AbstractJavaTypeNode methodCall : parent.findDescendantsOfType(AbstractJavaTypeNode.class)) {
            if (!SET_PROPERTY.equals(methodCall.getImage())
                || methodCall.getFirstParentOfType(ASTMethodDeclaration.class) == null) {
                continue;
            }

            ASTArgumentList args = methodCall.getFirstChildOfType(ASTArgumentList.class);
            if (args == null || args.getNumChildren() < 2) continue;

            Node firstArg = args.getChild(0);
            if (firstArg instanceof ASTName) {
                ASTName name = (ASTName) firstArg;
                String propName = name.getImage();
                if (propName.endsWith(SUPPORT_DTD)) {
                    hasDTDSet = isSafeValue(args.getChild(1));
                } else if (propName.endsWith(IS_SUPPORTING_EXTERNAL_ENTITIES)) {
                    hasExternalEntitiesSet = isSafeValue(args.getChild(1));
                }
            } else if (firstArg instanceof ASTLiteral) {
                String propValue = ((ASTLiteral) firstArg).getImage();
                if ("\"javax.xml.stream.isSupportingExternalEntities\"".equals(propValue)) {
                    hasExternalEntitiesSet = isSafeValue(args.getChild(1));
                }
            }
        }

        if (!hasDTDSet || !hasExternalEntitiesSet) {
            addViolation(data, factoryCall, "XMLInputFactory instance without proper XXE protection. "
                + "Ensure both SUPPORT_DTD and IS_SUPPORTING_EXTERNAL_ENTITIES are set to false.");
        }
    }

    private boolean isSafeValue(Node valueNode) {
        if (valueNode instanceof ASTLiteral) {
            String val = ((ASTLiteral) valueNode).getImage();
            return "false".equals(val) || "Boolean.FALSE".equals(val);
        }
        return false;
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        for (AbstractJavaTypeNode methodCall : node.findDescendantsOfType(AbstractJavaTypeNode.class)) {
            if (isXMLInputFactoryNewFactoryCall(methodCall)) {
                checkXXEProperties(methodCall, data);
            }
        }
        return super.visit(node, data);
    }
}
