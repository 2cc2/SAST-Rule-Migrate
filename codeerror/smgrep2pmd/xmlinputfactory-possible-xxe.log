package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.ast.ASTAssignableExpr.ASTNamedReferenceExpr;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import static net.sourceforge.pmd.lang.java.types.TypeTestUtil.isA;

public class XMLInputFactoryXXERule extends AbstractJavaRulechainRule {

    private static final String XML_INPUT_FACTORY = "javax.xml.stream.XMLInputFactory";
    private static final String IS_SUPPORTING_EXTERNAL_ENTITIES = "IS_SUPPORTING_EXTERNAL_ENTITIES";
    
    public XMLInputFactoryXXERule() {
        super(ASTConstructorCall.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(XML_INPUT_FACTORY, node)) {
            ASTNamedReferenceExpr varRef = node.getFirstParentOfType(ASTNamedReferenceExpr.class);
            if (varRef != null) {
                checkForUnsafeProperties(data, varRef.getReferencedDeclarator());
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("setProperty".equals(node.getMethodName()) 
                && isA(XML_INPUT_FACTORY, node.getQualifier())) {
            
            ASTExpression propertyNameExpr = node.getArguments().get(0);
            ASTExpression propertyValueExpr = node.getArguments().size() > 1 
                ? node.getArguments().get(1) 
                : null;
            
            if (isUnsafePropertySetting(propertyNameExpr, propertyValueExpr)) {
                asCtx(data).addViolation(node);
            }
        }
        return super.visit(node, data);
    }

    private boolean isUnsafePropertySetting(ASTExpression propertyName, ASTExpression propertyValue) {
        // Check property name matches DTD or external entities
        String propName = getPropertyName(propertyName);
        if ("SUPPORT_DTD".equals(propName) || "javax.xml.stream.isSupportingExternalEntities".equals(propName)
                || IS_SUPPORTING_EXTERNAL_ENTITIES.equals(propName)) {
            
            // Check if property value is true or missing
            return propertyValue == null || isBooleanTrue(propertyValue);
        }
        return false;
    }

    private String getPropertyName(ASTExpression expr) {
        // Implementation to extract property name from expression
        // Handle both string literals and constant references
        return ""; // placeholder
    }

    private boolean isBooleanTrue(ASTExpression expr) {
        // Implementation to check if expression evaluates to true
        return false; // placeholder
    }

    private void checkForUnsafeProperties(Object data, ASTVariableDeclaratorId varDecl) {
        varDecl.getLocalUsages().stream()
            .filter(usage -> usage.getParent() instanceof ASTMethodCall)
            .map(usage -> (ASTMethodCall) usage.getParent())
            .filter(call -> "setProperty".equals(call.getMethodName()))
            .filter(call -> isUnsafePropertySetting(
                call.getArguments().get(0),
                call.getArguments().size() > 1 ? call.getArguments().get(1) : null))
            .forEach(call -> asCtx(data).addViolation(call));
    }
}
