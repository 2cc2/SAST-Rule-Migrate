package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class XMLInputFactoryExternalEntitiesRule extends AbstractJavaRulechainRule {

    public XMLInputFactoryExternalEntitiesRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (!"setProperty".equals(node.getMethodName()) || node.getArguments().size() != 2) {
            return super.visit(node, data);
        }

        ASTExpression firstArg = node.getArguments().get(0);
        ASTExpression secondArg = node.getArguments().get(1);

        // Check for property name patterns
        boolean isDangerousProperty = false;
        if (firstArg instanceof ASTStringLiteral) {
            String propName = ((ASTStringLiteral) firstArg).getConstantValue();
            if ("javax.xml.stream.isSupportingExternalEntities".equals(propName) 
                || "javax.xml.stream.supportDTD".equals(propName)) {
                isDangerousProperty = true;
            }
        } else if (TypeTestUtil.isA("javax.xml.stream.XMLInputFactory$Property", firstArg)) {
            String propName = firstArg.toString();
            if ("SUPPORT_DTD".equals(propName) 
                || "IS_SUPPORTING_EXTERNAL_ENTITIES".equals(propName)) {
                isDangerousProperty = true;
            }
        }

        // Check if property is enabled (true)
        if (isDangerousProperty && secondArg.toString().equals("true")) {
            asCtx(data).addViolation(node);
        }

        return super.visit(node, data);
    }
}
