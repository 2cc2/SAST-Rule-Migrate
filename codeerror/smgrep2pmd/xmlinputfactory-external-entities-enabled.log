Rule Content:
/**
 * @name XMLInputFactory External Entities Enabled
 * @description Detects unsafe XMLInputFactory configurations that enable external entities processing
 * @ruleCategory security
 * @priority critical
 */
package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.ASTArguments;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTQualifiedName;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class XMLInputFactoryExternalEntitiesRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (!"setProperty".equals(node.getMethodName())) {
            return super.visit(node, data);
        }

        if (!TypeTestUtil.isA(javax.xml.stream.XMLInputFactory.class, node.getQualifier())) {
            return super.visit(node, data);
        }

        ASTArguments args = node.getArguments();
        if (args.size() < 2) {
            return super.visit(node, data);
        }

        ASTExpression firstArg = args.get(0);
        String propertyName = getPropertyName(firstArg);
        ASTExpression secondArg = args.get(1);

        if (propertyName != null && isDangerousProperty(propertyName) && isBooleanTrue(secondArg)) {
            addViolation(data, node, "Unsafe XMLInputFactory configuration: " + propertyName + " set to true");
        }

        return super.visit(node, data);
    }

    private String getPropertyName(ASTExpression expr) {
        if (expr instanceof ASTQualifiedName) {
            return ((ASTQualifiedName) expr).getName();
        } else if (expr instanceof ASTLiteral) {
            Object value = ((ASTLiteral) expr).getValue();
            return value instanceof String ? (String) value : null;
        }
        return null;
    }

    private boolean isDangerousProperty(String property) {
        return "javax.xml.stream.isSupportingExternalEntities".equals(property)
                || "SUPPORT_DTD".equals(property)
                || "IS_SUPPORTING_EXTERNAL_ENTITIES".equals(property);
    }

    private boolean isBooleanTrue(ASTExpression expr) {
        return expr instanceof ASTLiteral && Boolean.TRUE.equals(((ASTLiteral) expr).getValue());
    }
}
