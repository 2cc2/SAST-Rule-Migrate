package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTBooleanLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTFieldAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import static net.sourceforge.pmd.lang.java.types.TypeTestUtil.isA;

public class XMLInputFactoryExternalEntitiesRule extends AbstractJavaRulechainRule {

    private static final String XML_INPUT_FACTORY = "javax.xml.stream.XMLInputFactory";
    private static final String UNSAFE_PROPERTIES = "javax.xml.stream.isSupportingExternalEntities|javax.xml.stream.supportDTD";

    public XMLInputFactoryExternalEntitiesRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (!"setProperty".equals(node.getMethodName()) || node.getArguments().size() != 2) {
            return super.visit(node, data);
        }

        ASTExpression firstArg = node.getArguments().get(0);
        ASTExpression secondArg = node.getArguments().get(1);

        boolean isDangerous = false;
        String propertyName = null;

        // Check property name
        if (firstArg instanceof ASTStringLiteral) {
            propertyName = ((ASTStringLiteral) firstArg).getConstantValue();
            isDangerous = propertyName.matches(UNSAFE_PROPERTIES);
        } else if (isA(XML_INPUT_FACTORY + "$Property", firstArg) && firstArg instanceof ASTFieldAccess) {
            ASTFieldAccess fieldAccess = (ASTFieldAccess) firstArg;
            String fieldName = fieldAccess.getFieldName();
            isDangerous = "SUPPORT_DTD".equals(fieldName) || "IS_SUPPORTING_EXTERNAL_ENTITIES".equals(fieldName);
        }

        // Check property value is true
        boolean isEnabled = secondArg instanceof ASTBooleanLiteral 
            && ((ASTBooleanLiteral) secondArg).getValue();

        if (isDangerous && isEnabled) {
            addViolation(data, node);
        }

        return super.visit(node, data);
    }
}
