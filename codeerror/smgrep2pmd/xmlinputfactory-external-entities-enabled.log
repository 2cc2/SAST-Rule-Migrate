import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.*;
import net.sourceforge.pmd.properties.PropertyDescriptor;
import net.sourceforge.pmd.properties.PropertyFactory;

public class XmlExternalEntitiesEnabledRule extends AbstractJavaRule {
    private static final String XML_INPUT_FACTORY = "javax.xml.stream.XMLInputFactory";
    private static final String SUPPORT_DTD = "javax.xml.stream.supportDTD";
    private static final String IS_SUPPORTING_EXTERNAL_ENTITIES = "javax.xml.stream.isSupportingExternalEntities";

    @Override
    public Object visit(ASTMethodCallExpression node, Object data) {
        if (isXMLInputFactorySetPropertyCall(node)) {
            checkForVulnerableProperty(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isXMLInputFactorySetPropertyCall(ASTMethodCallExpression node) {
        return "setProperty".equals(node.getMethodName())
                && node.getFirstChildOfType(ASTPrimaryExpression.class) != null
                && node.getFirstChildOfType(ASTPrimaryExpression.class)
                    .getFirstChildOfType(ASTPrimaryPrefix.class) != null
                && node.getFirstChildOfType(ASTPrimaryExpression.class)
                    .getFirstChildOfType(ASTPrimaryPrefix.class)
                    .getFirstChildOfType(ASTName.class) != null
                && XML_INPUT_FACTORY.equals(node.getFirstChildOfType(ASTPrimaryExpression.class)
                    .getFirstChildOfType(ASTPrimaryPrefix.class)
                    .getFirstChildOfType(ASTName.class)
                    .getTypeName());
    }

    private void checkForVulnerableProperty(ASTMethodCallExpression node, Object data) {
        ASTArguments arguments = node.getFirstChildOfType(ASTArguments.class);
        if (arguments != null && arguments.getArgumentCount() == 2) {
            ASTLiteral propertyNameLiteral = arguments.getFirstDescendantOfType(ASTLiteral.class);
            ASTBooleanLiteral propertyValueLiteral = arguments.getFirstDescendantOfType(ASTBooleanLiteral.class);

            if (propertyNameLiteral != null && propertyValueLiteral != null) {
                String propertyName = getLiteralValue(propertyNameLiteral);
                boolean propertyValue = propertyValueLiteral.isTrue();

                if ((SUPPORT_DTD.equals(propertyName) || IS_SUPPORTING_EXTERNAL_ENTITIES.equals(propertyName)) 
                        && propertyValue) {
                    addViolation(data, node, "Disabling DTD or external entities support is required to prevent XXE vulnerabilities");
                }
            }

            // Check for static imports like XMLInputFactory.SUPPORT_DTD
            ASTPrimaryPrefix prefix = arguments.getFirstDescendantOfType(ASTPrimaryPrefix.class);
            if (prefix != null) {
                Node nameNode = prefix.jjtGetChild(0);
                if (nameNode instanceof ASTName) {
                    String fullName = ((ASTName) nameNode).getImage();
                    if (fullName.endsWith("SUPPORT_DTD") || fullName.endsWith("IS_SUPPORTING_EXTERNAL_ENTITIES")) {
                        ASTBooleanLiteral valueLiteral = arguments.getFirstDescendantOfType(ASTBooleanLiteral.class);
                        if (valueLiteral != null && valueLiteral.isTrue()) {
                            addViolation(data, node, "Disabling DTD or external entities support is required to prevent XXE vulnerabilities");
                        }
                    }
                }
            }
        }
    }

    private String getLiteralValue(ASTLiteral literal) {
        Object value = literal.getLiteralValue();
        return value != null ? value.toString() : "";
    }
}
