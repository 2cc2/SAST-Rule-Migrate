java
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.*;
import net.sourceforge.pmd.lang.ast.Node;

public class XmlExternalEntitiesEnabledRule extends AbstractJavaRule {
    private static final String XML_INPUT_FACTORY = "javax.xml.stream.XMLInputFactory";
    private static final String SUPPORT_DTD = "javax.xml.stream.supportDTD";
    private static final String IS_SUPPORTING_EXTERNAL_ENTITIES = "javax.xml.stream.isSupportingExternalEntities";

    @Override
    public Object visit(ASTPrimaryExpression node, Object data) {
        if (isXMLInputFactorySetPropertyCall(node)) {
            checkForVulnerableProperty(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isXMLInputFactorySetPropertyCall(ASTPrimaryExpression node) {
        ASTPrimarySuffix suffix = node.getFirstChildOfType(ASTPrimarySuffix.class);
        if (suffix == null || !"setProperty".equals(suffix.getImage())) {
            return false;
        }
        
        ASTName name = node.getFirstChildOfType(ASTName.class);
        return name != null && XML_INPUT_FACTORY.equals(name.getImage());
    }

    private void checkForVulnerableProperty(ASTPrimaryExpression node, Object data) {
        ASTPrimarySuffix suffix = node.getFirstChildOfType(ASTPrimarySuffix.class);
        if (suffix == null) {
            return;
        }

        ASTArgumentList arguments = suffix.getFirstChildOfType(ASTArgumentList.class);
        if (arguments == null || arguments.size() != 2) {
            return;
        }

        Node propertyNameNode = arguments.getChild(0);
        Node propertyValueNode = arguments.getChild(1);

        String propertyName = getPropertyName(propertyNameNode);
        Boolean propertyValue = getBooleanValue(propertyValueNode);

        if (propertyName != null && propertyValue != null 
                && (SUPPORT_DTD.equals(propertyName) || IS_SUPPORTING_EXTERNAL_ENTITIES.equals(propertyName)) 
                && propertyValue) {
            addViolation(data, node, "Disabling DTD or external entities support is required to prevent XXE vulnerabilities");
        }
    }

    private String getPropertyName(Node node) {
        if (node instanceof ASTLiteral) {
            return ((ASTLiteral) node).getImage();
        } else if (node instanceof ASTName) {
            return ((ASTName) node).getImage();
        }
        return null;
    }

    private Boolean getBooleanValue(Node node) {
        if (node instanceof ASTBooleanLiteral) {
            return ((ASTBooleanLiteral) node).isTrue();
        }
        return null;
    }
}
