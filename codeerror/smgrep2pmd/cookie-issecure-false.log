import net.sourceforge.pmd.lang.java.ast.ASTAllocationExpression;
import net.sourceforge.pmd.lang.java.ast.ASTBlockStatement;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceType;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimarySuffix;
import net.sourceforge.pmd.lang.java.ast.ASTArguments;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class InsecureCookieRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTAllocationExpression node, Object data) {
        ASTClassOrInterfaceType type = node.getFirstChildOfType(ASTClassOrInterfaceType.class);
        if (type != null && "Cookie".equals(type.getImage())) {
            if (!isSecureFlagSet(node)) {
                addViolation(data, node, "Create Cookie without secure flag");
            }
        }
        return super.visit(node, data);
    }

    private boolean isSecureFlagSet(ASTAllocationExpression node) {
        ASTBlockStatement block = node.getFirstParentOfType(ASTBlockStatement.class);
        if (block == null) {
            return false;
        }

        for (ASTPrimaryExpression expr : block.findDescendantsOfType(ASTPrimaryExpression.class)) {
            for (ASTPrimarySuffix suffix : expr.findDescendantsOfType(ASTPrimarySuffix.class)) {
                if ("setSecure".equals(suffix.getImage())) {
                    ASTArguments args = expr.getFirstDescendantOfType(ASTArguments.class);
                    if (args != null) {
                        ASTLiteral literal = args.getFirstDescendantOfType(ASTLiteral.class);
                        if (literal != null && "true".equals(literal.getImage())) {
                            ASTPrimaryPrefix prefix = expr.getFirstDescendantOfType(ASTPrimaryPrefix.class);
                            if (prefix != null) {
                                ASTName name = prefix.getFirstDescendantOfType(ASTName.class);
                                if (name != null && name.getImage().toLowerCase().contains("cookie")) {
                                    return true;
                                }
                            }
                        }
                    }
                }
            }
        }
        return false;
    }
}
