Rule Content:
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class InsecureCookieRule extends AbstractJavaRule {
    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (node.getType() != null && "javax.servlet.http.Cookie".equals(node.getType().getName())) {
            boolean hasSecure = false;
            
            // Check if there's a subsequent setSecure(true) call
            ASTVariableDeclaratorId var = node.getFirstParentOfType(ASTVariableDeclaratorId.class);
            if (var != null) {
                String varName = var.getName();
                
                for (ASTMethodCall methodCall : var.getScope().findDescendantsOfType(ASTMethodCall.class)) {
                    if (methodCall.getMethodName().equals("setSecure") 
                        && methodCall.getArguments().size() == 1
                        && "true".equals(methodCall.getArgument(0).toString())) {
                        hasSecure = true;
                        break;
                    }
                }
            }
            
            if (!hasSecure) {
                addViolation(data, node, "Cookie created without secure flag. Call setSecure(true) to enable it.");
            }
        }
        return super.visit(node, data);
    }
}
