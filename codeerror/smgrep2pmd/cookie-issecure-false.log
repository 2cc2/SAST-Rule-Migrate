Rule Content:
import net.sourceforge.pmd.lang.java.ast.ASTAllocationExpression;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceType;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimarySuffix;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class InsecureCookieRule extends AbstractJavaRule {
    
    @Override
    public Object visit(ASTAllocationExpression node, Object data) {
        ASTClassOrInterfaceType type = node.getFirstChildOfType(ASTClassOrInterfaceType.class);
        if (type != null && "Cookie".equals(type.getImage())) {
            
            boolean isSecureSet = false;
            ASTPrimaryExpression primaryExpr = node.getFirstParentOfType(ASTPrimaryExpression.class);
            
            while (primaryExpr != null) {
                ASTPrimarySuffix suffix = primaryExpr.getFirstDescendantOfType(ASTPrimarySuffix.class);
                if (suffix != null && "setSecure".equals(suffix.getImage())) {
                    ASTLiteral literal = primaryExpr.getFirstDescendantOfType(ASTLiteral.class);
                    if (literal != null && "true".equals(literal.getImage())) {
                        isSecureSet = true;
                        break;
                    }
                }
                primaryExpr = primaryExpr.getFirstParentOfType(ASTPrimaryExpression.class);
            }
            
            if (!isSecureSet) {
                addViolation(data, node);
            }
        }
        return super.visit(node, data);
    }
}
