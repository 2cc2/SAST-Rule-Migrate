import net.sourceforge.pmd.lang.java.ast.ASTAllocationExpression;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceBodyDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTPrimarySuffix;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class InsecureCookieRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTAllocationExpression node, Object data) {
        JavaNode type = node.getFirstChildOfType(ASTName.class);
        if (type != null && "Cookie".equals(type.getImage())) {
            boolean isSecureSet = checkSecureAttribute(node);
            if (!isSecureSet) {
                addViolation(data, node, "Found Cookie creation without secure flag set");
            }
        }
        return super.visit(node, data);
    }

    private boolean checkSecureAttribute(ASTAllocationExpression node) {
        ASTClassOrInterfaceBodyDeclaration parent = node.getFirstParentOfType(ASTClassOrInterfaceBodyDeclaration.class);
        if (parent == null) return false;

        for (ASTMethodDeclaration method : parent.findDescendantsOfType(ASTMethodDeclaration.class)) {
            for (ASTPrimarySuffix suffix : method.findDescendantsOfType(ASTPrimarySuffix.class)) {
                if ("setSecure".equals(suffix.getImage())) {
                    ASTPrimaryPrefix prefix = suffix.getFirstParentOfType(ASTPrimaryPrefix.class);
                    if (prefix != null) {
                        ASTName name = prefix.getFirstDescendantOfType(ASTName.class);
                        if (name != null && name.getImage() != null &&
                            name.getImage().toLowerCase().contains("cookie")) {
                            return true;
                        }
                    }
                }
            }
        }
        return false;
    }
}
