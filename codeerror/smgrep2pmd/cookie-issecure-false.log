Rule Content:
import net.sourceforge.pmd.lang.java.ast.ASTAllocationExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import net.sourceforge.pmd.lang.java.ast.JavaNode;

public class InsecureCookieRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTAllocationExpression node, Object data) {
        if (TypeTestUtil.isA("javax.servlet.http.Cookie", node) && 
            !hasSecureFlagSet(node)) {
            addViolation(data, node, "Creating cookie without setting secure flag");
        }
        return super.visit(node, data);
    }

    private boolean hasSecureFlagSet(ASTAllocationExpression node) {
        JavaNode parent = node.getParent();
        while (parent != null) {
            for (ASTMethodCall methodCall : parent.descendants(ASTMethodCall.class).toList()) {
                if ("setSecure".equals(methodCall.getMethodName()) && 
                    methodCall.getArguments().size() == 1 &&
                    Boolean.TRUE.equals(methodCall.getArgument(0).getLiteralValue()) &&
                    isSameVariable(node, methodCall)) {
                    return true;
                }
            }
            parent = parent.getParent();
        }
        return false;
    }

    private boolean isSameVariable(ASTAllocationExpression alloc, ASTMethodCall call) {
        ASTVariableDeclaratorId varDecl = alloc.getFirstDescendantOfType(ASTVariableDeclaratorId.class);
        if (varDecl != null) {
            return call.getQualifier() != null && 
                   call.getQualifier().getImage().equals(varDecl.getName());
        }
        return false;
    }
}
