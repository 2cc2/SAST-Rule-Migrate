为实现Semgrep规则到PMD工具的迁移，我将原始cookie安全检测规则转换为PMD规则格式。分析原始规则可见，其主要检测Cookie对象创建后未设置Secure标志的情况。以下是转换后的PMD规则：

```java
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.servlet.http.Cookie;

public class CookieSecureFlagRule extends AbstractJavaRulechainRule {

    public CookieSecureFlagRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(Cookie.class, node)) {
            checkSecureFlagSetting(node, data);
        }
        return data;
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        // 跳过已设置secure标志的检查
        if ("setSecure".equals(node.getMethodName()) && 
            TypeTestUtil.isA(Cookie.class, node.getQualifier())) {
            return data;
        }
        return super.visit(node, data);
    }

    private void checkSecureFlagSetting(ASTConstructorCall ctorCall, Object data) {
        // 检查是否后续调用了setSecure(true)
        boolean hasSecureFlag = ctorCall.getEnclosingScope()
            .descendants(ASTMethodCall.class)
            .any(m -> "setSecure".equals(m.getMethodName()) && 
                      TypeTestUtil.isA(Cookie.class, m.getQualifier()));

        if (!hasSecureFlag) {
            addViolation(data, ctorCall, "创建Cookie时未设置Secure标志，可能导致敏感信息泄露");
        }
    }
}
```
