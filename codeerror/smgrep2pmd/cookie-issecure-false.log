package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class SecureCookieRule extends AbstractJavaRulechainRule {

    public SecureCookieRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(javax.servlet.http.Cookie.class, node)) {
            checkCookieSecureFlag(node, data);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("setSecure".equals(node.getMethodName()) 
                && TypeTestUtil.isA(javax.servlet.http.Cookie.class, node.getQualifier())) {
            // This is ok, cookie has setSecure(true) call
            return data;
        }
        return super.visit(node, data);
    }

    private void checkCookieSecureFlag(ASTConstructorCall cookieCtor, Object data) {
        // Check if there's any subsequent setSecure(true) call
        boolean hasSecureFlag = cookieCtor.getEnclosingType()
            .descendants(ASTMethodCall.class)
            .any(m -> "setSecure".equals(m.getMethodName()) 
                   && TypeTestUtil.isA(javax.servlet.http.Cookie.class, m.getQualifier()));
        
        if (!hasSecureFlag) {
            asCtx(data).addViolation(cookieCtor);
        }
    }
}
