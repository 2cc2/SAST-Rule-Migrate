import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclarator;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class CookieIsSecureFalseRule extends AbstractJavaRule {
    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if ("javax.servlet.http.Cookie".equals(getDeclaredType(node))
                || "jakarta.servlet.http.Cookie".equals(getDeclaredType(node))) {
            boolean hasSecureSet = false;
            ASTVariableDeclarator parent = node.getFirstParentOfType(ASTVariableDeclarator.class);
            
            if (parent != null) {
                for (ASTMethodCall methodCall : parent.findDescendantsOfType(ASTMethodCall.class)) {
                    ASTName methodName = methodCall.getFirstChildOfType(ASTName.class);
                    if (methodName != null && "setSecure".equals(methodName.getImage())) {
                        hasSecureSet = true;
                        break;
                    }
                }
            }
            
            if (!hasSecureSet) {
                addViolation(data, node, "Cookie created without secure flag set");
            }
        }
        return super.visit(node, data);
    }
    
    private String getDeclaredType(ASTConstructorCall node) {
        return node.getQualifiedName().getBinaryName();
    }
}
