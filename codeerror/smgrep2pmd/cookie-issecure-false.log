java
import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class InsecureCookieRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        // 检查是否是Cookie类的构造函数
        if (isCookieConstructor(node)) {
            // 检查是否没有设置secure标志
            if (!isSecureFlagSet(node)) {
                addViolation(data, node, "Create Cookie without secure flag");
            }
        }
        return super.visit(node, data);
    }

    private boolean isCookieConstructor(ASTConstructorCall node) {
        ASTClassOrInterfaceType type = node.getFirstChildOfType(ASTClassOrInterfaceType.class);
        return type != null && "Cookie".equals(type.getImage());
    }

    private boolean isSecureFlagSet(ASTConstructorCall node) {
        // 查找同一代码块中是否有cookie.setSecure(true)调用
        ASTBlockStatement block = node.getFirstParentOfType(ASTBlockStatement.class);
        if (block == null) {
            return false;
        }

        for (ASTPrimaryExpression expr : block.findDescendantsOfType(ASTPrimaryExpression.class)) {
            ASTPrimarySuffix suffix = expr.getFirstDescendantOfType(ASTPrimarySuffix.class);
            if (suffix != null && "setSecure".equals(suffix.getImage())) {
                ASTArguments args = expr.getFirstDescendantOfType(ASTArguments.class);
                if (args != null) {
                    ASTPrimaryPrefix prefix = expr.getFirstDescendantOfType(ASTPrimaryPrefix.class);
                    if (prefix != null) {
                        ASTName name = prefix.getFirstDescendantOfType(ASTName.class);
                        if (name != null && name.getImage() != null &&
                            name.getImage().toLowerCase().contains("cookie")) {
                            ASTLiteral literal = args.getFirstDescendantOfType(ASTLiteral.class);
                            return literal != null && "true".equals(literal.getImage());
                        }
                    }
                }
            }
        }
        return false;
    }
}
