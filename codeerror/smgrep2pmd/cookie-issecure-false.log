import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class InsecureCookieRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if ("Cookie".equals(node.getTypeName()) && 
            node.getFirstParentOfType(ASTMethodCall.class) == null) {
            addViolation(data, node, "Creating cookie without setting secure flag");
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("setSecure".equals(node.getMethodName()) && 
            node.getArguments().size() == 1 && 
            "true".equals(node.getArgument(0).toString())) {
            ASTVariableDeclaratorId var = node.getFirstParentOfType(ASTVariableDeclaratorId.class);
            if (var != null) {
                suppressViolation(var);
            }
        }
        return super.visit(node, data);
    }
}
