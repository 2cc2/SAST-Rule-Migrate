import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class InsecureCookieRule extends AbstractJavaRule {
    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (node.getFirstChildOfType(ASTClassOrInterfaceType.class) != null
                && "Cookie".equals(node.getFirstChildOfType(ASTClassOrInterfaceType.class).getImage())) {
            
            boolean isSecureSet = false;
            ASTMethodCall methodCall = node.getFirstParentOfType(ASTMethodCall.class);
            while (methodCall != null) {
                if ("setSecure".equals(methodCall.getMethodName()) 
                        && methodCall.getFirstChildOfType(ASTExpression.class) != null
                        && Boolean.TRUE.toString().equals(methodCall.getFirstChildOfType(ASTExpression.class).getImage())) {
                    isSecureSet = true;
                    break;
                }
                methodCall = methodCall.getFirstParentOfType(ASTMethodCall.class);
            }
            
            if (!isSecureSet) {
                addViolation(data, node);
            }
        }
        return super.visit(node, data);
    }
}
