Rule Content:
# 转换后的 PMD 规则

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import org.springframework.jdbc.core.JdbcTemplate;

public class JdbcSqlFormattedStringRule extends AbstractJavaRulechainRule {

    public JdbcSqlFormattedStringRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isJdbcTemplateMethod(node)) {
            checkSqlConcatenation(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isJdbcTemplateMethod(ASTMethodCall node) {
        return node.getQualifier() != null 
            && TypeTestUtil.isA(JdbcTemplate.class, node.getQualifier())
            && (node.getMethodName().equals("queryForObject") 
                || node.getMethodName().equals("queryForList")
                || node.getMethodName().equals("update"));
    }

    private void checkSqlConcatenation(ASTMethodCall node, Object data) {
        for (ASTExpression arg : node.getArguments()) {
            // 检查直接字符串拼接
            checkStringLiteralConcatenation(arg, data);
            
            // 检查变量拼接
            if (arg instanceof ASTVariableAccess) {
                checkVariableInitializer((ASTVariableAccess) arg, data);
            }
        }
    }

    private void checkStringLiteralConcatenation(ASTExpression expr, Object data) {
        expr.descendants(ASTStringLiteral.class)
            .filter(lit -> lit.getContent().contains("'+") || lit.getContent().contains("\"+"))
            .forEach(lit -> addViolation(data, lit));
    }

    private void checkVariableInitializer(ASTVariableAccess varAccess, Object data) {
        ASTVariableId varId = varAccess.getReferencedSym();
        if (varId != null && varId.getInitializer() != null) {
            checkStringLiteralConcatenation(varId.getInitializer(), data);
        }
    }
}
