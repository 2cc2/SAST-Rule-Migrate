package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import org.springframework.jdbc.core.JdbcTemplate;

public class JdbcSqlFormattedStringRule extends AbstractJavaRulechainRule {

    public JdbcSqlFormattedStringRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isJdbcTemplateMethod(node)) {
            checkSqlConcatenation(node, data);
        }
        return data;
    }

    private boolean isJdbcTemplateMethod(ASTMethodCall node) {
        return TypeTestUtil.isA(JdbcTemplate.class, node.getQualifier())
                && (node.getMethodName().equals("queryForObject") 
                    || node.getMethodName().equals("queryForList")
                    || node.getMethodName().equals("update"));
    }

    private void checkSqlConcatenation(ASTMethodCall node, Object data) {
        if (node.getArguments().size() == 0) return;
        
        ASTStringLiteral literal = node.getArguments().get(0).descendantsOrSelf()
                .filterIs(ASTStringLiteral.class).first();
        
        if (literal != null && literal.getContent().contains("\"'\")) {
            asCtx(data).addViolation(literal);
        }
        
        ASTVariableAccess varAccess = node.getArguments().get(0).descendantsOrSelf()
                .filterIs(ASTVariableAccess.class).first();
        
        if (varAccess != null) {
            checkVariableInitializer(varAccess, data);
        }
    }

    private void checkVariableInitializer(ASTVariableAccess varAccess, Object data) {
        if (varAccess.getSignature() == null || varAccess.getSignature().getSymbol() == null) return;
        
        ASTStringLiteral literal = varAccess.getSignature().getSymbol()
                .tryGetNode()
                .getInitializer()
                .descendantsOrSelf()
                .filterIs(ASTStringLiteral.class)
                .first();
        
        if (literal != null && literal.getContent().contains("\"'\")) {
            asCtx(data).addViolation(literal);
        }
    }
}
