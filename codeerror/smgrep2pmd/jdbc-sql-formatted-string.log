# 修改后的 PMD 规则

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTVariableId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import org.springframework.jdbc.core.JdbcTemplate;

public class JdbcSqlFormattedStringRule extends AbstractJavaRulechainRule {

    public JdbcSqlFormattedStringRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isJdbcTemplateMethod(node)) {
            checkSqlConcatenation(node, data);
        }
        return data;
    }

    private boolean isJdbcTemplateMethod(ASTMethodCall node) {
        return TypeTestUtil.isA(JdbcTemplate.class, node.getQualifier())
                && (node.getMethodName().equals("queryForObject") 
                    || node.getMethodName().equals("queryForList")
                    || node.getMethodName().equals("update"));
    }

    private void checkSqlConcatenation(ASTMethodCall node, Object data) {
        node.getArguments().forEach(arg -> {
            // 检查字符串字面量
            arg.descendantsOrSelf()
                .filterIs(ASTStringLiteral.class)
                .filter(lit -> lit.getContent().matches(".*['\"+]\\s*\\+.*"))
                .forEach(lit -> asCtx(data).addViolation(lit));
            
            // 检查变量引用
            arg.descendantsOrSelf()
                .filterIs(ASTVariableAccess.class)
                .forEach(var -> checkVariableInitializer(var, data));
        });
    }

    private void checkVariableInitializer(ASTVariableAccess varAccess, Object data) {
        if (varAccess.getSignature() == null 
            || varAccess.getSignature().getSymbol() == null) return;
        
        ASTVariableId varId = varAccess.getSignature().getSymbol().tryGetNode();
        if (varId == null || varId.getInitializer() == null) return;
        
        varId.getInitializer().descendantsOrSelf()
            .filterIs(ASTStringLiteral.class)
            .filter(lit -> lit.getContent().contains("'+"))
            .forEach(lit -> asCtx(data).addViolation(lit));
    }
}
