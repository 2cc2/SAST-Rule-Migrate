package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.xml.transform.TransformerFactory;

public class TransformerFactorySecurityRule extends AbstractJavaRulechainRule {

    public TransformerFactorySecurityRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("newTransformer")) {
            ASTExpression qualifier = node.getQualifier();
            if (qualifier != null && TypeTestUtil.isA(TransformerFactory.class, qualifier)) {
                checkTransformerFactorySecurity(qualifier, node, data);
            }
        }
        return super.visit(node, data);
    }

    private void checkTransformerFactorySecurity(ASTExpression factoryExpr, ASTMethodCall newTransformerCall, Object data) {
        boolean hasExternalDTDDisabled = false;
        boolean hasExternalStylesheetDisabled = false;

        // Check previous method calls on the factory
        ASTVariableDeclaratorId varId = factoryExpr.getLocalScope().lookupVariable(factoryExpr.getImage());
        if (varId != null) {
            varId.getLocalUsages().forEach(usage -> {
                if (usage.getParent() instanceof ASTMethodCall) {
                    ASTMethodCall methodCall = (ASTMethodCall) usage.getParent();
                    if (methodCall.getMethodName().equals("setAttribute")) {
                        ASTExpression firstArg = methodCall.getArguments().get(0);
                        String attributeName = firstArg.toString();
                        if (attributeName.equals("XMLConstants.ACCESS_EXTERNAL_DTD") 
                            || attributeName.contains("accessExternalDTD")) {
                            hasExternalDTDDisabled = true;
                        } else if (attributeName.equals("XMLConstants.ACCESS_EXTERNAL_STYLESHEET") 
                                 || attributeName.contains("accessExternalStylesheet")) {
                            hasExternalStylesheetDisabled = true;
                        }
                    }
                }
            });
        }

        if (!hasExternalDTDDisabled || !hasExternalStylesheetDisabled) {
            asCtx(data).addViolation(newTransformerCall);
        }
    }
}
