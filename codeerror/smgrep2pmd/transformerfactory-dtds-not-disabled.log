"""
为解决以下编译错误，建议采取以下修复步骤：

1. 移除所有Java文件开头的非法注释标记(#)：
   - 确保每个Java文件以合法的Java语法开头（package声明或import语句）
   - 替换所有Markdown格式注释为Java标准注释(//或/* */)

2. 修复语法结构问题：
   - 确保每个.java文件有且仅有一个public类
   - 类名必须与文件名严格匹配（区分大小写）
   - 检查并修复所有非法字符和语法错误（如非法点号、缺少分号等）

3. 更新构建配置：
   - 在pom.xml中添加编译器配置：
     <properties>
       <maven.compiler.release>8</maven.compiler.release>
     </properties>

4. 针对TransformerFactorySecurityRule的具体修复：
   - 添加缺失的XMLConstants导入
   - 修复lambda表达式中使用的非final变量问题
   - 改进AST节点遍历逻辑
   - 增强属性检查的健壮性

修改后的完整规则代码如下：
"""

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.xml.transform.TransformerFactory;
import javax.xml.XMLConstants;

public class TransformerFactorySecurityRule extends AbstractJavaRulechainRule {

    public TransformerFactorySecurityRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("newTransformer".equals(node.getMethodName())) {
            ASTExpression qualifier = node.getQualifier();
            if (qualifier != null && TypeTestUtil.isA(TransformerFactory.class, qualifier)) {
                checkTransformerFactorySecurity(qualifier, node, data);
            }
        }
        return super.visit(node, data);
    }

    private void checkTransformerFactorySecurity(ASTExpression factoryExpr, 
                                              ASTMethodCall newTransformerCall, 
                                              Object data) {
        final boolean[] securityFlags = {false, false}; // DTD, Stylesheet

        ASTVariableDeclaratorId varId = factoryExpr.getLocalScope()
            .lookupVariable(factoryExpr.getImage());
        
        if (varId != null) {
            varId.getLocalUsages().forEach(usage -> {
                if (usage.getParent() instanceof ASTMethodCall) {
                    ASTMethodCall methodCall = (ASTMethodCall) usage.getParent();
                    if ("setAttribute".equals(methodCall.getMethodName()) 
                        && methodCall.getArguments().size() >= 2) {
                        
                        String attributeName = methodCall.getArguments().get(0)
                            .toString()
                            .replace("\"", "");
                            
                        if (XMLConstants.ACCESS_EXTERNAL_DTD.equals(attributeName) 
                            || "http://javax.xml.XMLConstants/property/accessExternalDTD"
                               .equals(attributeName)) {
                            securityFlags[0] = true;
                        } else if (XMLConstants.ACCESS_EXTERNAL_STYLESHEET.equals(attributeName) 
                                 || "http://javax.xml.XMLConstants/property/accessExternalStylesheet"
                                    .equals(attributeName)) {
                            securityFlags[1] = true;
                        }
                    }
                }
            });
        }

        if (!securityFlags[0] || !securityFlags[1]) {
            asCtx(data).addViolation(newTransformerCall);
        }
    }
}
