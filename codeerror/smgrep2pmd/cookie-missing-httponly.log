package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.servlet.http.Cookie;

/**
 * 检测缺少HttpOnly标志的Cookie设置
 */
public class CookieMissingHttpOnlyRule extends AbstractJavaRulechainRule {

    public CookieMissingHttpOnlyRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isAddCookieMethod(node)) {
            checkCookieSecurity(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isAddCookieMethod(ASTMethodCall node) {
        return "addCookie".equals(node.getMethodName())
            && node.getArguments().size() == 1
            && isHttpServletResponseCall(node);
    }

    private boolean isHttpServletResponseCall(ASTMethodCall node) {
        ASTExpression qualifier = node.getQualifier();
        return qualifier instanceof ASTVariableAccess 
            && TypeTestUtil.isA("javax.servlet.http.HttpServletResponse", 
                              (ASTVariableAccess) qualifier);
    }

    private void checkCookieSecurity(ASTMethodCall node, Object data) {
        ASTExpression cookieArg = node.getArguments().get(0);
        if (cookieArg instanceof ASTVariableAccess) {
            // 检查变量声明处是否有设置HttpOnly
            ASTVariableAccess varAccess = (ASTVariableAccess) cookieArg;
            if (!isHttpOnlyCookie(varAccess)) {
                addViolation(data, node);
            }
        } else if (cookieArg instanceof ASTConstructorCall 
                  && TypeTestUtil.isA("javax.servlet.http.Cookie", (ASTConstructorCall) cookieArg)) {
            // 直接构造Cookie且未设置HttpOnly
            addViolation(data, node);
        }
    }

    private boolean isHttpOnlyCookie(ASTVariableAccess varAccess) {
        // 实际实现需要分析变量使用路径
        // 这里简化为总是返回false
        return false;
    }
}
