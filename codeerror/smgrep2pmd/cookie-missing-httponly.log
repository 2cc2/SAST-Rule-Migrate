package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class CookieMissingHttpOnlyRule extends AbstractJavaRulechainRule {

    public CookieMissingHttpOnlyRule() {
        super(ASTMethodCall.class, ASTConstructorCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isAddCookieMethodCall(node) || isResponseCookieConstructor(node)) {
            ASTExpression qualifier = node.getQualifier();
            if (qualifier != null && qualifier instanceof ASTVariableAccess) {
                ASTVariableAccess varAccess = (ASTVariableAccess) qualifier;
                if (varAccess.getSignature() != null && "HttpServletResponse".equals(varAccess.getTypeMirror().toString())) {
                    if (!isHttpOnlyCookie(node)) {
                        asCtx(data).addViolation(node);
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isAddCookieMethodCall(ASTMethodCall node) {
        return "addCookie".equals(node.getMethodName()) 
            && node.getArguments().size() == 1;
    }

    private boolean isResponseCookieConstructor(ASTMethodCall node) {
        if ("from".equals(node.getMethodName())) {
            ASTExpression nextCall = node.getParent().getFirstChildOfType(ASTMethodCall.class);
            return nextCall != null && "build".equals(nextCall.getMethodName());
        }
        return false;
    }

    private boolean isHttpOnlyCookie(ASTMethodCall node) {
        // Check if cookie has HttpOnly flag set
        // This would require more sophisticated analysis in a real implementation
        // Here we just demonstrate the structure
        ASTExpression arg = node.getArguments().get(0);
        if (arg instanceof ASTConstructorCall) {
            ASTConstructorCall ctor = (ASTConstructorCall) arg;
            return TypeTestUtil.isA("javax.servlet.http.Cookie", ctor)
                && hasHttpOnlyProperty(node);
        }
        return false;
    }

    private boolean hasHttpOnlyProperty(ASTMethodCall node) {
        // In a real implementation, would need to track if setHttpOnly(true) was called
        // This is simplified for demonstration
        return false;
    }
}
