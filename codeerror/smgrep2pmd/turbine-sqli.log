Rule Content:
// TurbineSqlInjectionRule.java
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class TurbineSqlInjectionRule extends AbstractJavaRulechainRule {

    public TurbineSqlInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        if ("executeQuery".equals(methodName)) {
            // Check if the method is called on BasePeer or GroupPeer
            boolean isBasePeerCall = TypeTestUtil.isA("org.apache.turbine.om.peer.BasePeer", node.getQualifier());
            boolean isGroupPeerCall = TypeTestUtil.isA("org.apache.turbine.om.security.peer.GroupPeer", node.getQualifier());
            
            if (!isBasePeerCall && !isGroupPeerCall) {
                // Static method calls
                isBasePeerCall = TypeTestUtil.isA("org.apache.turbine.om.peer.BasePeer", node.getMethodType().getDeclaringType());
                isGroupPeerCall = TypeTestUtil.isA("org.apache.turbine.om.security.peer.GroupPeer", node.getMethodType().getDeclaringType());
            }
            
            if (isBasePeerCall || isGroupPeerCall) {
                // Check if first argument is not a string literal (to exclude constant values)
                if (node.getArguments().size() > 0 && node.getArguments().get(0) instanceof ASTVariableAccess) {
                    ASTVariableAccess varAccess = (ASTVariableAccess) node.getArguments().get(0);
                    if (!isConstantString(varAccess)) {
                        addViolation(data, node);
                    }
                } else {
                    addViolation(data, node);
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isConstantString(ASTVariableAccess varAccess) {
        if (varAccess.getReferencedSym().isFinal()) {
            return varAccess.getInitializer() instanceof ASTStringLiteral;
        }
        return false;
    }
}
