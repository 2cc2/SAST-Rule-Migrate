Rule Content:
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTBinaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.rule.internal.JavaRuleUtil;

public class EqualsOnSameVariableRule extends AbstractJavaRulechainRule {

    public EqualsOnSameVariableRule() {
        super(ASTBinaryExpression.class);
    }

    @Override
    public Object visit(ASTBinaryExpression node, Object data) {
        if (JavaRuleUtil.isOperator(node, "==") || JavaRuleUtil.isOperator(node, "!=")) {
            ASTExpression left = node.getLeftOperand();
            ASTExpression right = node.getRightOperand();
            
            if (left instanceof ASTVariableAccess && right instanceof ASTVariableAccess) {
                ASTVariableAccess leftVar = (ASTVariableAccess) left;
                ASTVariableAccess rightVar = (ASTVariableAccess) right;
                
                if (leftVar.getName().equals(rightVar.getName())) {
                    addViolation(data, node);
                }
            }
        }
        return super.visit(node, data);
    }
}
