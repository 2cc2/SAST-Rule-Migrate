package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class JacksonUnsafeDeserializationRule extends AbstractJavaRulechainRule {

    public JacksonUnsafeDeserializationRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        if ("readValue".equals(methodName) && isObjectMapperCall(node)) {
            ASTExpression firstArg = node.getArguments().get(0);
            ASTExpression secondArg = node.getArguments().get(1);
            
            // Check for enableDefaultTyping elsewhere in the code
            if (hasEnableDefaultTyping(node)) {
                asCtx(data).addViolation(node, "Unsafe Jackson deserialization with enabled default typing");
            }
            // Or check if second argument is a Class object (Car.class in the example)
            else if (secondArg != null && secondArg instanceof ASTClassLiteral) {
                asCtx(data).addViolation(node, "Potential unsafe Jackson deserialization");
            }
        }
        return super.visit(node, data);
    }

    private boolean isObjectMapperCall(ASTMethodCall node) {
        return TypeTestUtil.isA("com.fasterxml.jackson.databind.ObjectMapper", node.getQualifier());
    }

    private boolean hasEnableDefaultTyping(ASTMethodCall node) {
        // Search for enableDefaultTyping calls in the surrounding context
        ASTMethodDeclaration method = node.ancestors(ASTMethodDeclaration.class).first();
        if (method != null) {
            return method.descendants(ASTMethodCall.class)
                .filter(call -> "enableDefaultTyping".equals(call.getMethodName()))
                .filter(call -> TypeTestUtil.isA("com.fasterxml.jackson.databind.ObjectMapper", call.getQualifier()))
                .nonEmpty();
        }
        return false;
    }
}
