import net.sourceforge.pmd.RuleContext;
import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.*;

public class JacksonUnsafeDeserializationRule extends AbstractJavaRule {
    private boolean isObjectMapperWithDefaultTyping = false;

    @Override
    public Object visit(ASTVariableDeclarator node, Object data) {
        if (node.getTypeNode() != null && "ObjectMapper".equals(node.getTypeNode().getImage())) {
            ASTAssignmentOperator assign = node.getFirstParentOfType(ASTAssignmentOperator.class);
            if (assign != null) {
                ASTPrimaryExpression primaryExpr = assign.getFirstDescendantOfType(ASTPrimaryExpression.class);
                if (primaryExpr != null) {
                    ASTMethodCall methodCall = primaryExpr.getFirstDescendantOfType(ASTMethodCall.class);
                    if (methodCall != null && "enableDefaultTyping".equals(methodCall.getMethodName())) {
                        isObjectMapperWithDefaultTyping = true;
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isObjectMapperWithDefaultTyping && "readValue".equals(node.getMethodName())) {
            ASTClassOrInterfaceType type = node.getFirstDescendantOfType(ASTClassOrInterfaceType.class);
            if (type != null && !"Another".equals(type.getImage())) {
                addViolation(data, node, "Potential unsafe Jackson deserialization with default typing enabled");
            }
        }
        return super.visit(node, data);
    }

    @Override
    public void start(RuleContext ctx) {
        isObjectMapperWithDefaultTyping = false;
        super.start(ctx);
    }
}
