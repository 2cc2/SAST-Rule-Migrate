package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class SecureDocumentBuilderFactoryRule extends AbstractJavaRulechainRule {

    private static final String DISALLOW_DOCTYPE_FEATURE = "http://apache.org/xml/features/disallow-doctype-decl";

    public SecureDocumentBuilderFactoryRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        if (!"setFeature".equals(methodName)) {
            return super.visit(node, data);
        }

        if (node.getArguments().size() < 2) {
            return super.visit(node, data);
        }

        ASTExpression firstArg = node.getArguments().get(0);
        ASTExpression secondArg = node.getArguments().get(1);

        if (firstArg instanceof ASTStringLiteral 
            && DISALLOW_DOCTYPE_FEATURE.equals(((ASTStringLiteral) firstArg).getConstantValue())) {
            if (secondArg instanceof ASTStringLiteral 
                && "false".equals(((ASTStringLiteral) secondArg).getConstantValue())) {
                asCtx(data).addViolation(node);
            } else if (secondArg != null) {
                ASTStringLiteral literal = secondArg.getFirstChildOfType(ASTStringLiteral.class);
                if (literal != null && "false".equals(literal.getConstantValue())) {
                    asCtx(data).addViolation(node);
                }
            }
        }

        return super.visit(node, data);
    }
}
