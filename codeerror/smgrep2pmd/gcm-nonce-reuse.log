package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTArrayAllocation;
import net.sourceforge.pmd.lang.java.ast.ASTArrayInitializer;
import net.sourceforge.pmd.lang.java.ast.ASTAssignableExpr.AccessType;
import net.sourceforge.pmd.lang.java.ast.ASTAssignmentExpression;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTVariableId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class GcmNonceReuseRule extends AbstractJavaRulechainRule {

    public GcmNonceReuseRule() {
        super(ASTConstructorCall.class, ASTAssignmentExpression.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(GCMParameterSpec.class, node)) {
            ASTArgumentList arguments = node.getArguments();
            if (arguments.size() > 1) {
                validateNonceArgument(data, arguments.get(1));
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTAssignmentExpression node, Object data) {
        if (node.getLeftOperand() instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) node.getLeftOperand();
            if (varAccess.getSignature() != null && varAccess.getSignature().getSymbol() != null) {
                validateNonceArgument(data, node.getRightOperand());
            }
        }
        return super.visit(node, data);
    }

    private void validateNonceArgument(Object data, ASTExpression expr) {
        if (expr == null) {
            return;
        }

        if (expr instanceof ASTMethodCall) {
            ASTMethodCall methodCall = (ASTMethodCall) expr;
            if (methodCall.getMethodName().equals("getBytes")) {
                ASTExpression qualifier = methodCall.getQualifier();
                if (qualifier instanceof ASTStringLiteral) {
                    asCtx(data).addViolation(qualifier);
                }
            }
        } else if (expr instanceof ASTArrayAllocation) {
            ASTArrayInitializer arrayInit = ((ASTArrayAllocation) expr).getArrayInitializer();
            if (arrayInit != null) {
                asCtx(data).addViolation(arrayInit);
            }
        } else if (expr instanceof ASTStringLiteral) {
            asCtx(data).addViolation(expr);
        } else if (expr instanceof ASTVariableAccess) {
            ASTVariableId varDecl = ((ASTVariableAccess) expr).getSignature().getSymbol().tryGetNode();
            if (varDecl != null) {
                validateNonceArgument(data, varDecl.getInitializer());
            }
        }
    }
}
