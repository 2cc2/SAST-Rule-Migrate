package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclarator;
import net.sourceforge.pmd.lang.java.ast.ASTReturnStatement;
import net.sourceforge.pmd.lang.java.ast.ASTBlock;
import net.sourceforge.pmd.lang.java.ast.ASTEmptyStatement;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

import javax.net.ssl.X509TrustManager;
import javax.net.ssl.X509ExtendedTrustManager;

public class InsecureTrustManagerRule extends AbstractJavaRulechainRule {

    public InsecureTrustManagerRule() {
        super(ASTClassOrInterfaceDeclaration.class);
    }

    @Override
    public Object visit(ASTClassOrInterfaceDeclaration node, Object data) {
        if (TypeTestUtil.isA(X509TrustManager.class, node) || TypeTestUtil.isA(X509ExtendedTrustManager.class, node)) {
            checkTrustManagerMethods(node, data);
        }
        return data;
    }

    private void checkTrustManagerMethods(ASTClassOrInterfaceDeclaration node, Object data) {
        for (ASTMethodDeclaration method : node.findDescendantsOfType(ASTMethodDeclaration.class)) {
            ASTMethodDeclarator declarator = method.getFirstChildOfType(ASTMethodDeclarator.class);
            if (declarator == null) {
                continue;
            }

            String methodName = declarator.getName();
            if ("checkClientTrusted".equals(methodName) || "checkServerTrusted".equals(methodName)) {
                ASTBlock block = method.getFirstChildOfType(ASTBlock.class);
                if (block != null && (block.findChildrenOfType(ASTEmptyStatement.class).size() > 0 || block.getNumChildren() == 0)) {
                    asCtx(data).addViolation(method);
                }
            } else if ("getAcceptedIssuers".equals(methodName)) {
                for (ASTReturnStatement ret : method.findDescendantsOfType(ASTReturnStatement.class)) {
                    if (ret.getExpr() == null) {
                        asCtx(data).addViolation(method);
                    }
                }
            }
        }
    }
}
