# 转换后的 PMD 规则

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTBlock;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import java.net.Socket;
import java.lang.ProcessBuilder;

public class JavaReverseShellRule extends AbstractJavaRulechainRule {

    public JavaReverseShellRule() {
        super(ASTMethodCall.class, ASTConstructorCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        if (methodName.equals("redirectErrorStream") 
            || methodName.equals("start")
            || methodName.equals("getInputStream")
            || methodName.equals("getErrorStream") 
            || methodName.equals("getOutputStream")
            || methodName.equals("write")) {
            
            checkForSocketUsage(node.getParent(), data);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (node.getTypeMirror().isSubtypeOf(Socket.class)) {
            asCtx(data).addViolation(node);
        } else if (node.getTypeMirror().isSubtypeOf(ProcessBuilder.class)) {
            checkForReverseShellPattern(node, data);
        }
        return super.visit(node, data);
    }

    private void checkForSocketUsage(ASTExpression parent, Object data) {
        parent.ancestors(ASTBlock.class).firstOptional().ifPresent(block -> {
            block.descendants(ASTConstructorCall.class)
                .filter(n -> TypeTestUtil.isA(ProcessBuilder.class, n))
                .forEach(pb -> checkForReverseShellPattern(pb, data));
        });
    }

    private void checkForReverseShellPattern(ASTConstructorCall processBuilder, Object data) {
        processBuilder.ancestors(ASTBlock.class).firstOptional().ifPresent(block -> {
            block.descendants(ASTConstructorCall.class)
                .filter(n -> TypeTestUtil.isA(Socket.class, n))
                .findAny()
