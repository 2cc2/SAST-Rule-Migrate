# 修复后的 PMD 规则

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import java.security.MessageDigest;

public class AvoidInsecureDigestRule extends AbstractJavaRulechainRule {

    public AvoidInsecureDigestRule() {
        super(ASTMethodCall.class, ASTConstructorCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isDigestUtilsMethod(node) || isMessageDigestMethod(node)) {
            asCtx(data).addViolation(node);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(MessageDigest.class, node)) {
            ASTExpression firstArg = node.getFirstChildOfType(ASTExpression.class);
            if (firstArg != null) {
                ASTStringLiteral literal = firstArg.getFirstChildOfType(ASTStringLiteral.class);
                if (literal != null) {
                    String algo = literal.getText();
                    if ("MD5".equalsIgnoreCase(algo) || "SHA-1".equalsIgnoreCase(algo)) {
                        asCtx(data).addViolation(node);
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isDigestUtilsMethod(ASTMethodCall node) {
        String methodName = node.getMethodName();
        return methodName != null && 
              (methodName.startsWith("getMd5Digest") || 
               methodName.startsWith("getSha1Digest"));
    }

    private boolean isMessageDigestMethod(ASTMethodCall node) {
        return "getInstance".equals(node.getMethodName()) &&
               TypeTestUtil.isA(MessageDigest.class, node.getQualifier());
    }
}
```

