package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

import java.util.HashSet;
import java.util.Set;
import java.nio.file.attribute.PosixFilePermission;

public class OverlyPermissiveFilePermissionRule extends AbstractJavaRulechainRule {

    public OverlyPermissiveFilePermissionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (TypeTestUtil.isA(Files.class, node.getMethodType().getDeclaringType())) {
            // Check for Files.setPosixFilePermissions calls with dangerous permissions
            if ("setPosixFilePermissions".equals(node.getMethodName())) {
                checkPermissionString(node, data);
                checkPermissionSet(node, data);
            }
        }
        return super.visit(node, data);
    }

    private void checkPermissionString(ASTMethodCall node, Object data) {
        node.getArguments().stream()
            .filter(arg -> arg instanceof ASTStringLiteral)
            .map(arg -> (ASTStringLiteral) arg)
            .filter(literal -> {
                String perms = literal.getConstantValue();
                return perms != null && (perms.contains("rw-rw-rw-") || perms.contains("rw-rw-r--"));
            })
            .forEach(literal -> asCtx(data).addViolation(literal));
    }

    private void checkPermissionSet(ASTMethodCall node, Object data) {
        node.getArguments().stream()
            .flatMap(arg -> arg.getLocalVariableDeclarations().stream())
            .filter(var -> TypeTestUtil.isA(Set.class, var.getTypeMirror()))
            .forEach(var -> {
                var.getInitializer().ifPresent(init -> {
                    if (init.toString().contains("OTHERS_READ") || 
                        init.toString().contains("OTHERS_WRITE") || 
                        init.toString().contains("OTHERS_EXECUTE")) {
                        asCtx(data).addViolation(var);
                    }
                });
            });
    }
}
