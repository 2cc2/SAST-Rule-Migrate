# 转换后的 PMD 规则

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclarator;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import java.nio.file.Files;
import java.nio.file.attribute.PosixFilePermission;
import java.util.Set;

public class OverlyPermissiveFilePermissionRule extends AbstractJavaRulechainRule {

    public OverlyPermissiveFilePermissionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodType() != null && 
            TypeTestUtil.isA(Files.class, node.getMethodType().getDeclaringType()) &&
            "setPosixFilePermissions".equals(node.getMethodName())) {
            
            checkPermissionString(node, data);
            checkPermissionSet(node, data);
        }
        return super.visit(node, data);
    }

    private void checkPermissionString(ASTMethodCall node, Object data) {
        node.getArguments()
            .forEach(arg -> {
                if (arg instanceof ASTStringLiteral) {
                    String perms = ((ASTStringLiteral)arg).getConstValue();
                    if (perms != null && (perms.matches("rw[rw-]{5}") || perms.matches("rwx[rwx-]{5}"))) {
                        addViolation(data, (ASTStringLiteral)arg);
                    }
                }
            });
    }

    private void checkPermissionSet(ASTMethodCall node, Object data) {
        node.getArguments()
            .forEach(arg -> {
                arg.descendants(ASTVariableDeclarator.class)
                   .forEach(var -> {
                       if (var.getTypeNode() != null && 
                           TypeTestUtil.isA(Set.class, var.getTypeNode().getTypeMirror()) &&
                           var.getInitializer() != null) {
                           String initStr = var.getInitializer().toString();
                           if (initStr.contains("OTHERS_READ") || 
                               initStr.contains("OTHERS_WRITE") ||
                               initStr.contains("OTHERS_EXECUTE")) {
                               addViolation(data, var);
                           }
                       }
                   });
            });
    }
}
