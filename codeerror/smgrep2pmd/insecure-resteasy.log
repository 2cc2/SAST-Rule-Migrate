import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import java.util.Optional;

public class InsecureRestEasyDeserializationRule extends AbstractJavaRulechainRule {

    public InsecureRestEasyDeserializationRule() {
        super(ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        checkInsecureConsumesAnnotation(node, data);
        checkDefaultProviderAbuse(node, data);
        return super.visit(node, data);
    }

    private void checkInsecureConsumesAnnotation(ASTMethodDeclaration node, Object data) {
        for (ASTAnnotation annotation : node.getDeclaredAnnotations()) {
            if ("Consumes".equals(annotation.getAnnotationName())) {
