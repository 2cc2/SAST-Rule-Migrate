package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class InsecureRestEasyDeserializationRule extends AbstractJavaRulechainRule {

    public InsecureRestEasyDeserializationRule() {
        super(ASTClassOrInterfaceBodyDeclaration.class, ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        // Check for @Consumes("*/*") pattern
        checkInsecureConsumesAnnotation(node, data);
        
        // Check for default resteasy provider abuse
        checkDefaultProviderAbuse(node, data);
        
        return super.visit(node, data);
    }
    
    private void checkInsecureConsumesAnnotation(ASTMethodDeclaration node, Object data) {
        for (ASTAnnotation annotation : node.getDeclaredAnnotations()) {
            if ("Consumes".equals(annotation.getAnnotationName())) {
                ASTMemberValue value = annotation.getMemberValue();
                if (value instanceof ASTMemberValueArray) {
                    ASTMemberValueArray array = (ASTMemberValueArray) value;
                    for (ASTExpression expr : array.findChildrenOfType(ASTExpression.class)) {
                        if (expr instanceof ASTStringLiteral) {
                            String literal = ((ASTStringLiteral) expr).getConstValue();
                            if ("*/*".equals(literal)) {
                                addViolation(data, node, "Insecure RESTEasy deserialization found - @Consumes(\"*/*\") is vulnerable");
                            }
                        }
                    }
                }
            }
        }
    }
    
    private void checkDefaultProviderAbuse(ASTMethodDeclaration node, Object data) {
        boolean hasConsumes = node.getDeclaredAnnotations()
            .any(it -> "Consumes".equals(it.getAnnotationName()));
            
        boolean hasProduces = node.getDeclaredAnnotations()
            .any(it -> "Produces".equals(it.getAnnotationName()));
            
        if (!hasConsumes && hasProduces) {
            ASTClassOrInterfaceDeclaration classDecl = node.getFirstParentOfType(ASTClassOrInterfaceDeclaration.class);
            if (classDecl != null && classDecl.getDeclaredAnnotations().any(it -> "Path".equals(it.getAnnotationName()))) {
                
                boolean classHasConsumes = classDecl.getDeclaredAnnotations()
                    .any(it -> "Consumes".equals(it.getAnnotationName()));
                    
                boolean classHasProduces = classDecl.getDeclaredAnnotations()
                    .any(it -> "Produces".equals(it.getAnnotationName()));
                    
                if (!classHasConsumes || !classHasProduces) {
                    if (node.getFirstChildOfType(ASTFormalParameters.class).getParameterCount() > 0) {
                        addViolation(data, node, 
                            "Potential default RESTEasy provider abuse - method accepts request body without proper @Consumes annotation");
                    }
                }
            }
        }
    }
}
