package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class InsecureRestEasyDeserializationRule extends AbstractJavaRulechainRule {

    public InsecureRestEasyDeserializationRule() {
        super(ASTClassOrInterfaceBodyDeclaration.class, ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        ASTAnnotation annotation = node.getAnnotation("Consumes");
        if (annotation != null) {
            ASTMemberValue value = annotation.getMemberValue();
            if (value != null && value instanceof ASTMemberValueArray) {
                ASTMemberValueArray array = (ASTMemberValueArray) value;
                for (int i = 0; i < array.size(); i++) {
                    ASTExpression expr = array.get(i);
                    if (expr instanceof ASTStringLiteral) {
                        String literal = ((ASTStringLiteral) expr).getContent();
                        if (literal.equals("*/*")) {
                            addViolation(data, node, "Insecure RESTEasy deserialization found - @Consumes(\"*/*\") is vulnerable");
                        }
                    }
                }
            }
        }
        
        // Check for default resteasy provider abuse
        if (node.getAnnotation("Consumes") == null && node.getAnnotation("Produces") != null &&
            node.getParent() instanceof ASTClassOrInterfaceBodyDeclaration &&
            ((ASTClassOrInterfaceBodyDeclaration) node.getParent()).getParent() instanceof ASTClassOrInterfaceDeclaration) {
            
            ASTClassOrInterfaceDeclaration classDecl = (ASTClassOrInterfaceDeclaration) ((ASTClassOrInterfaceBodyDeclaration) node.getParent()).getParent();
            if (classDecl.getAnnotation("Path") != null && 
                (classDecl.getAnnotation("Consumes") == null || classDecl.getAnnotation("Produces") == null)) {
                
                ASTMethodDeclarator declarator = node.getFirstChildOfType(ASTMethodDeclarator.class);
                if (declarator != null) {
                    boolean hasRequestBody = declarator.getParameterCount() > 0;
                    if (hasRequestBody) {
                        addViolation(data, node, "Potential default RESTEasy provider abuse - method accepts request body without proper @Consumes annotation");
                    }
                }
            }
        }

        return super.visit(node, data);
    }
}
