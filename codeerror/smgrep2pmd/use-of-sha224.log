- 检查package声明是否正确
- 移除文件中间位置的非法独立文本

4. 修正POM配置
- 将编译选项从"-source 8 -target 1.8"改为"--release 8"
- 添加必要的依赖声明(如PMD核心库)

5. 重建项目结构
- 确保src/main/java目录结构正确
- 每个规则类应放在正确的包路径下
- 清理target目录后重新编译

6. 验证修复
- 执行mvn clean compile验证编译通过
- 检查PMD规则加载是否正常
- 测试规则在实际代码扫描中的效果

修复后的AvoidSHA224UsageRule示例：
```java
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.*;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class AvoidSHA224UsageRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("getInstance".equals(node.getMethodName())) {
            ASTLiteral arg = node.getArguments().firstChild(ASTLiteral.class);
            if (arg != null && "SHA-224".equals(arg.getConstantValue())) {
                addViolation(data, node);
            }
        } else if ("getSha3_224Digest".equals(node.getMethodName()) || 
                 ("digest".equals(node.getMethodName()) && 
                  TypeTestUtil.isA(DigestUtils.class, node.getQualifier()))) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(DigestUtils.class, node)) {
            ASTLiteral arg = node.getArguments().firstChild(ASTLiteral.class);
            if (arg != null && arg.getConstantValue() instanceof String && 
                ((String)arg.getConstantValue()).contains("SHA-224")) {
                addViolation(data, node);
            }
        }
        return super.visit(node, data);
    }
}
