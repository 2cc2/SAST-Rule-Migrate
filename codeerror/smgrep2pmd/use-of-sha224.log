"""
为解决以下错误：[ERROR] COMPILATION ERROR，请按照以下步骤进行修复：

1. 移除所有Java文件开头的非法标记字符
- 删除文件开头的"# 修改后的 PMD 规则"等非java语法内容
- 确保每个文件以合法的package声明开头

2. 修复规则类的继承关系
- 将AbstractJavaRulechainRule改为正确的AbstractJavaRule
- 确保构造函数和visit方法签名正确

3. 修正AST节点类型使用
- 将ASTStringLiteral改为更通用的ASTLiteral
- 添加对常量值的类型检查

4. 修复方法调用检查
- 优化getInstance方法名的检查方式
- 添加对qualifier的类型安全检查

5. 添加必要的import声明
- 确保DigestUtils等依赖类正确导入
- 添加缺失的PMD相关import

修复后的完整规则代码如下：
"""

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import org.apache.commons.codec.digest.DigestUtils;

public class AvoidSHA224UsageRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("getInstance".equals(node.getMethodName())) {
            ASTLiteral arg = node.getArguments().firstChild(ASTLiteral.class);
            if (arg != null && "SHA-224".equals(arg.getConstantValue())) {
                addViolation(data, node);
            }
        } else if ("getSha3_224Digest".equals(node.getMethodName()) || 
                 ("digest".equals(node.getMethodName()) && 
                  node.getQualifier() != null &&
                  TypeTestUtil.isA(DigestUtils.class, node.getQualifier()))) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(DigestUtils.class, node)) {
            ASTLiteral arg = node.getArguments().firstChild(ASTLiteral.class);
            if (arg != null && arg.getConstantValue() instanceof String && 
                ((String)arg.getConstantValue()).contains("SHA-224")) {
                addViolation(data, node);
            }
        }
        return super.visit(node, data);
    }
}
