package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.rule.internal.TestFrameworksUtil;

public class HibernateSqliRule extends AbstractJavaRulechainRule {

    public HibernateSqliRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        
        if ("sqlRestriction".equals(methodName) 
                || "createQuery".equals(methodName) 
                || "createSQLQuery".equals(methodName)) {
            
            if (node.getArguments().size() > 0) {
                ASTExpression firstArg = node.getArguments().get(0);
                checkForStringConcatenation(firstArg, data);
            }
        }
        
        return super.visit(node, data);
    }

    private void checkForStringConcatenation(ASTExpression expr, Object data) {
        // Find string literals with concatenation
        expr.descendantsOrSelf()
            .filterIs(ASTStringLiteral.class)
            .filter(lit -> {
                ASTExpression parent = lit.getParent();
                // Check if the literal is part of a concatenation
                return parent != null && "+".equals(parent.getOperator());
            })
            .forEach(lit -> {
                // Check if concatenated with non-literal values
                if (containsExternalInput(lit.getParent())) {
                    asCtx(data).addViolation(lit);
                }
            });
    }

    private boolean containsExternalInput(ASTExpression expr) {
        // Check if the expression contains any variable references 
        // that could be user input
        return expr.descendantsOrSelf()
                  .any(it -> it.getClass().getSimpleName().contains("VariableAccess") 
                            || it.getClass().getSimpleName().contains("MethodCall"));
    }
}
