2. 修复AvoidMD5ForPasswordRule.java的语法错误:
   - 检查第22行的非法字符
   - 确保语句结束有分号

3. 升级PMD API使用方法：
   - 更新descendants()为现代的遍历方式
   - 使用PMD 7+的AST节点API

4. 修复后的HibernateSqliRule完整代码：

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTAdditiveExpression;
import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.rule.internal.TestFrameworksUtil;

public class HibernateSqliRule extends AbstractJavaRulechainRule {

    public HibernateSqliRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        
        if ("sqlRestriction".equals(methodName) 
                || "createQuery".equals(methodName) 
                || "createSQLQuery".equals(methodName)) {
            
            if (node.getArguments().size() > 0) {
                checkForStringConcatenation(node.getArguments().get(0), data);
            }
        }
        return super.visit(node, data);
    }

    private void checkForStringConcatenation(ASTExpression expr, Object data) {
        for (ASTAdditiveExpression additive : expr.descendants(ASTAdditiveExpression.class)) {
            if ("+".equals(additive.getOperator()) && containsExternalInput(additive)) {
                asCtx(data).addViolation(additive);
            }
        }
    }

    private boolean containsExternalInput(ASTExpression expr) {
        return expr.descendants()
                  .any(it -> it instanceof ASTVariableAccess 
                        || (it instanceof ASTMethodCall && !isSafeMethodCall((ASTMethodCall)it)));
    }

    private boolean isSafeMethodCall(ASTMethodCall call) {
        String methodName = call.getMethodName();
        return "toString".equals(methodName) 
                || "valueOf".equals(methodName)
                || "trim".equals(methodName);
    }
}
