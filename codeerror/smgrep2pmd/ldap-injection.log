package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTVariableId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class LdapInjectionRule extends AbstractJavaRulechainRule {

    public LdapInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("search".equals(node.getMethodName())) {
            ASTArgumentList arguments = node.getArguments();
            if (arguments.size() >= 2) {
                // Check for string concatenation in filter argument
                if (arguments.get(1).descendantsOrSelf()
                    .filter(ASTStringLiteral.class::isInstance)
                    .anyMatch(lit -> ((ASTStringLiteral)lit).getContent().contains("(uid="))) {
                    
                    asCtx(data).addViolation(node);
                }
                
                // Check variable usage in filter argument
                arguments.get(1).descendantsOrSelf()
                    .filter(ASTVariableAccess.class::isInstance)
                    .forEach(varAccess -> {
                        ASTVariableId varDecl = ((ASTVariableAccess)varAccess).getSignature().getSymbol().tryGetNode();
                        if (varDecl != null && varDecl.getName() != null) {
                            validateVarUsages(data, varDecl);
                        }
                    });
            }
        }
        return super.visit(node, data);
    }

    private void validateVarUsages(Object data, ASTVariableId varDecl) {
        varDecl.getLocalUsages().stream()
            .filter(usage -> usage.getAccessType().isWrite())
            .forEach(usage -> {
                // Check if unsafe user input is assigned to the variable
                asCtx(data).addViolation(usage);
            });
    }
}
