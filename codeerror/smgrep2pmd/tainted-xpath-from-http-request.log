package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTXPathExpression;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class TaintedXPathFromHttpRequestRule extends AbstractJavaRulechainRule {

    public TaintedXPathFromHttpRequestRule() {
        super(ASTXPathExpression.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTXPathExpression node, Object data) {
        // Check if the XPath expression contains user input
        String xpathExpr = node.getExpression();
        if (xpathExpr != null && xpathExpr.contains("' + bar + '")) {
            asCtx(data).addViolation(node, "Potential XPath injection vulnerability - user input used directly in XPath expression");
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        // Check for evaluate() or compile() methods on XPath objects
        if (node.getMethodName().equals("evaluate") || node.getMethodName().equals("compile")) {
            JavaNode qualifier = node.getQualifier();
            if (qualifier != null && TypeTestUtil.isA("javax.xml.xpath.XPath", qualifier)) {
                // Check if arguments contain concatenated user input
                for (ASTExpression arg : node.getArguments()) {
                    if (containsUserInput(arg)) {
                        asCtx(data).addViolation(node, "Potential XPath injection vulnerability - untrusted user input used in XPath evaluation");
                        break;
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean containsUserInput(ASTExpression expr) {
        // Check for string concatenation with variables from HTTP request
        if (expr instanceof ASTStringLiteral) {
            return false;
        }
        
        // Look for variable access that might come from HTTP parameters
        return expr.descendantsOrSelf()
                .filterIs(ASTVariableAccess.class)
                .anyMatch(var -> {
                    String varName = var.getName();
                    return varName.equals("bar") || varName.equals("param") || 
                           varName.endsWith("Request") || varName.endsWith("Parameters");
                });
    }
}
