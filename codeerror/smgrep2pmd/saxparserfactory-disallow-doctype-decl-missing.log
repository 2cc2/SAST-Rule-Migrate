package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTFieldDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTConstructorDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTInitializer;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

import javax.xml.parsers.SAXParserFactory;

public class SecureSAXParserRule extends AbstractJavaRulechainRule {

    public SecureSAXParserRule() {
        super(ASTMethodCall.class, ASTFieldDeclaration.class, ASTConstructorDeclaration.class, ASTInitializer.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("newSAXParser")) {
            checkSAXParserSecurity(node, data);
        }
        return super.visit(node, data);
    }

    private void checkSAXParserSecurity(ASTMethodCall node, Object data) {
        ASTExpression qualifier = node.getQualifier();
        if (qualifier instanceof ASTVariableAccess) {
            ASTVariableDeclaratorId varDecl = ((ASTVariableAccess) qualifier).getReferencedDeclarator();
            if (varDecl != null && TypeTestUtil.isExactlyA(SAXParserFactory.class, varDecl.getTypeMirror())) {
                if (!hasSecureFeatures(varDecl)) {
                    asCtx(data).addViolation(node);
                }
            }
        }
    }

    private boolean hasSecureFeatures(ASTVariableDeclaratorId varDecl) {
        return varDecl.getLocalUsages().stream()
            .anyMatch(usage -> {
                if (usage.getParent() instanceof ASTMethodCall) {
                    ASTMethodCall call = (ASTMethodCall) usage.getParent();
                    if (call.getMethodName().equals("setFeature")) {
                        ASTExpression featureArg = call.getArguments().get(0);
                        if (featureArg instanceof ASTStringLiteral) {
                            String feature = ((ASTStringLiteral) featureArg).getConstantValue();
                            return feature.equals("http://apache.org/xml/features/disallow-doctype-decl")
                                || feature.equals("http://xml.org/sax/features/external-general-entities")
                                || feature.equals("http://xml.org/sax/features/external-parameter-entities");
                        }
                    }
                }
                return false;
            });
    }

    @Override
    public Object visit(ASTFieldDeclaration node, Object data) {
        if (TypeTestUtil.isExactlyA(SAXParserFactory.class, node.getTypeNode())) {
            checkFieldInitialization(node, data);
        }
        return super.visit(node, data);
    }

    private void checkFieldInitialization(ASTFieldDeclaration node, Object data) {
        for (ASTVariableDeclaratorId var : node.getVarIds()) {
            if (!hasSecureFeatures(var)) {
                asCtx(data).addViolation(node);
            }
        }
    }

    @Override
    public Object visit(ASTInitializer node, Object data) {
        if (node.isStatic()) {
            node.descendants(ASTMethodCall.class)
                .filter(call -> call.getMethodName().equals("newSAXParser"))
                .forEach(call -> checkSAXParserSecurity(call, data));
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTConstructorDeclaration node, Object data) {
        node.descendants(ASTMethodCall.class)
            .filter(call -> call.getMethodName().equals("newSAXParser"))
            .forEach(call -> checkSAXParserSecurity(call, data));
        return super.visit(node, data);
    }
}
