package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;

public class DeprecatedCipherAlgorithmRule extends AbstractJavaRulechainRule {

    public DeprecatedCipherAlgorithmRule() {
        super(ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        // Check for Cipher.getInstance calls with weak algorithms
        node.descendants(ASTMethodCall.class)
            .filter(methodCall -> "getInstance".equals(methodCall.getMethodName()))
            .filter(methodCall -> {
                // Check if the argument contains "AES/GCM/NoPadding"
                return methodCall.getArguments().toStream()
                    .filter(arg -> arg instanceof ASTStringLiteral)
                    .anyMatch(arg -> ((ASTStringLiteral)arg).getContent().contains("AES/GCM/NoPadding"));
            })
            .forEach(methodCall -> {
                addViolation(data, methodCall);
            });

        return super.visit(node, data);
    }
}
