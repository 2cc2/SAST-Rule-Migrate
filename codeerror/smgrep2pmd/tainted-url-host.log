package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class TaintedUrlHostRule extends AbstractJavaRulechainRule {

    public TaintedUrlHostRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(URL.class, node)) {
            ASTVariableAccess varAccess = getFirstVariableAccess(node);
            if (varAccess != null) {
                checkForTaintedParameter(data, varAccess);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("getForObject") || node.getMethodName().equals("postForObject")) {
            ASTVariableAccess varAccess = getFirstVariableAccess(node);
            if (varAccess != null) {
                checkForTaintedParameter(data, varAccess);
            }
        }
        return super.visit(node, data);
    }

    private ASTVariableAccess getFirstVariableAccess(ASTMethodCall node) {
        if (node.getArguments().size() > 0) {
            return node.getArguments().get(0).descendantsOrSelf()
                    .filterIs(ASTVariableAccess.class)
                    .first();
        }
        return null;
    }

    private ASTVariableAccess getFirstVariableAccess(ASTConstructorCall node) {
        if (node.getArguments().size() > 0) {
            return node.getArguments().get(0).descendantsOrSelf()
                    .filterIs(ASTVariableAccess.class)
                    .first();
        }
        return null;
    }

    private void checkForTaintedParameter(Object data, ASTVariableAccess varAccess) {
        if (varAccess.getName() != null && isRequestParameter(varAccess.getName())) {
            asCtx(data).addViolation(varAccess);
        }
    }

    private boolean isRequestParameter(String varName) {
        return varName.equals("urlImage") || varName.equals("url");
    }
}
