# 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTConstructorCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import java.net.URL;
import java.util.Objects;

public class TaintedUrlHostRule extends AbstractJavaRulechainRule {

    private static final String[] TARGET_METHODS = {"getForObject", "postForObject"};
    private static final String[] SENSITIVE_PARAMS = {"urlImage", "url"};

    public TaintedUrlHostRule() {
        super(ASTConstructorCall.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTConstructorCall node, Object data) {
        if (TypeTestUtil.isA(URL.class, node)) {
            checkArgumentsForTaint(node, data);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isTargetMethod(node.getMethodName())) {
            checkArgumentsForTaint(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isTargetMethod(String methodName) {
        for (String target : TARGET_METHODS) {
            if (target.equals(methodName)) {
                return true;
            }
        }
        return false;
    }

    private void checkArgumentsForTaint(ASTMethodCall node, Object data) {
        node.getArguments().forEach(arg -> {
            ASTVariableAccess varAccess = findFirstVariableAccess(arg);
            if (varAccess != null) {
                checkForTaintedParameter(data, varAccess);
            }
        });
    }

    private void checkArgumentsForTaint(ASTConstructorCall node, Object data) {
        node.getArguments().forEach(arg -> {
            ASTVariableAccess varAccess = findFirstVariableAccess(arg);
            if (varAccess != null) {
                checkForTaintedParameter(data, varAccess);
            }
        });
    }

    private ASTVariableAccess findFirstVariableAccess(ASTExpression expr) {
        return expr.descendantsOrSelf()
                .filterIs(ASTVariableAccess.class)
                .first();
    }

    private void checkForTaintedParameter(Object data, ASTVariableAccess varAccess) {
        if (varAccess != null 
            && varAccess.getName() != null 
            && isSensitiveParameter(varAccess.getName())) {
            asCtx(data).addViolation(varAccess);
        }
    }

    private boolean isSensitiveParameter(String paramName) {
        for (String sensitiveParam : SENSITIVE_PARAMS) {
            if (sensitiveParam.equals(paramName)) {
                return true;
            }
        }
        return false;
    }
}
