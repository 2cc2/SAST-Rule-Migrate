package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTVariableId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import static net.sourceforge.pmd.lang.java.types.TypeTestUtil.isA;

public class JwtVerifyCheckRule extends AbstractJavaRulechainRule {

    public JwtVerifyCheckRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isMethodCallOnJWT(node, "decode")) {
            // Check if there's a verify call for the same token
            boolean hasVerify = checkForVerifyCall(node);
            if (!hasVerify) {
                addViolation(data, node);
            }
        }
        return super.visit(node, data);
    }

    private boolean isMethodCallOnJWT(ASTMethodCall node, String methodName) {
        return node.getMethodName().equals(methodName) &&
               TypeTestUtil.isA("com.auth0.jwt.JWT", node.getQualifier());
    }

    private boolean checkForVerifyCall(ASTMethodCall decodeCall) {
        // Implement logic to check if there's a corresponding verify call
        // This is a simplified check - you may need more complex analysis
        ASTVariableAccess varAccess = null;
        if (decodeCall.getParent().getParent() instanceof ASTVariableId) {
            ASTVariableId varDecl = (ASTVariableId) decodeCall.getParent().getParent();
            return varDecl.getLocalUsages().stream()
                .anyMatch(usage -> {
                    if (usage.getParent() instanceof ASTMethodCall) {
                        ASTMethodCall call = (ASTMethodCall) usage.getParent();
                        return isMethodCallOnJWT(call, "verify");
                    }
                    return false;
                });
        }
        return false;
    }
}
