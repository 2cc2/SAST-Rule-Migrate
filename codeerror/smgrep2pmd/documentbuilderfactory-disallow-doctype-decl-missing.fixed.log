/**
 * 安全修复策略：
 * 1. 移除所有文件开头的非法'#'字符，确保Java语法正确
 * 2. 修正ASTMethodCall检查逻辑，完善安全特征验证
 * 3. 添加必要的javax.xml.parsers导入
 * 4. 优化方法调用比较方式(null安全)
 */

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTAssignmentExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import javax.xml.parsers.DocumentBuilderFactory;

public class SecureDocumentBuilderFactoryRule extends AbstractJavaRulechainRule {

    private static final String[] SECURE_FEATURES = {
        "http://apache.org/xml/features/disallow-doctype-decl",
        "http://xml.org/sax/features/external-general-entities", 
        "http://xml.org/sax/features/external-parameter-entities"
    };

    public SecureDocumentBuilderFactoryRule() {
        super(ASTVariableDeclaration.class, ASTAssignmentExpression.class, ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTVariableDeclaration node, Object data) {
        if (TypeTestUtil.isExactlyA(DocumentBuilderFactory.class, node.getTypeNode())) {
            checkSecurity(node, data);
        }
        return super.visit(node, data);
    }
    
    @Override
    public Object visit(ASTAssignmentExpression node, Object data) {
        if (TypeTestUtil.isExactlyA(DocumentBuilderFactory.class, node.getLeftOperand())) {
            checkSecurity(node, data);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("newDocumentBuilder".equals(node.getMethodName())) {
            checkSecurity(node, data);
        }
        return super.visit(node, data);
    }

    private void checkSecurity(Object node, Object data) {
        boolean hasSecureFeature = false;
        
        if (node instanceof ASTMethodCall) {
            ASTMethodCall methodCall = (ASTMethodCall) node;
            if ("setFeature".equals(methodCall.getMethodName()) 
                && methodCall.getArguments().size() >= 2) {
                
                String feature = methodCall.getArguments().get(0).getLiteral();
                for (String secureFeature : SECURE_FEATURES) {
                    if (secureFeature.equals(feature)) {
                        hasSecureFeature = true;
                        break;
                    }
                }
            }
        }

        if (!hasSecureFeature && node instanceof ASTMethodCall
            && "newDocumentBuilder".equals(((ASTMethodCall) node).getMethodName())) {
            addViolation(data, node);
        }
    }
}
