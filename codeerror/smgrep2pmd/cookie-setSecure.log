package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class CookieSetSecureRule extends AbstractJavaRulechainRule {

    public CookieSetSecureRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("setSecure".equals(node.getMethodName()) && node.getArguments().size() == 1) {
            ASTExpression arg = node.getArguments().get(0);
            if (arg instanceof net.sourceforge.pmd.lang.java.ast.ASTBooleanLiteral) {
                net.sourceforge.pmd.lang.java.ast.ASTBooleanLiteral boolLit = 
                    (net.sourceforge.pmd.lang.java.ast.ASTBooleanLiteral) arg;
                if (!boolLit.isTrue()) {
                    addViolation(data, node, "Found cookie.setSecure(false) usage - this can create security vulnerabilities");
                }
            }
        }
        return super.visit(node, data);
    }
}
