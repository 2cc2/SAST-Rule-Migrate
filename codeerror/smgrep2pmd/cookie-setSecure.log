import net.sourceforge.pmd.lang.java.ast.ASTAllocationExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTBooleanLiteral;

public class CookieSetSecureRule extends AbstractJavaRule {
    private static final String COOKIE_TYPE = "javax.servlet.http.Cookie";
    private static final String SET_SECURE_METHOD = "setSecure";

    @Override
    public Object visit(ASTPrimaryExpression node, Object data) {
        ASTPrimaryPrefix prefix = node.getFirstDescendantOfType(ASTPrimaryPrefix.class);
        if (prefix != null && SET_SECURE_METHOD.equals(prefix.getImage())) {
            // Check if the method is setSecure and called on Cookie object
            ASTAllocationExpression alloc = node.getFirstParentOfType(ASTAllocationExpression.class);
            if (alloc != null && COOKIE_TYPE.equals(alloc.getType())) {
                
                // Check if the argument is false
                ASTArgumentList args = node.getFirstDescendantOfType(ASTArgumentList.class);
                if (args != null && args.size() == 1) {
                    ASTBooleanLiteral boolLit = args.getFirstDescendantOfType(ASTBooleanLiteral.class);
                    if (boolLit != null && !boolLit.isTrue()) {
                        addViolation(data, node);
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
