# 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTBooleanLiteral;

public class CookieSetSecureRule extends AbstractJavaRulechainRule {

    public CookieSetSecureRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("setSecure".equals(node.getMethodName()) && node.getArguments().size() == 1) {
            ASTExpression arg = node.getArguments().get(0);
            if (arg instanceof ASTBooleanLiteral) {
                ASTBooleanLiteral boolLit = (ASTBooleanLiteral) arg;
                if (!boolLit.isTrue()) {
                    addViolation(data, node, "Found cookie.setSecure(false) usage - this can create security vulnerabilities");
                }
            }
        }
        return super.visit(node, data);
    }
}
