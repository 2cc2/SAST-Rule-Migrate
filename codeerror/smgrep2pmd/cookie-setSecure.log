Rule Content:
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class CookieSetSecureRule extends AbstractJavaRule {
    
    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        for (ASTPrimaryExpression expr : node.findDescendantsOfType(ASTPrimaryExpression.class)) {
            ASTPrimaryPrefix prefix = expr.getFirstDescendantOfType(ASTPrimaryPrefix.class);
            if (prefix != null) {
                ASTName name = prefix.getFirstDescendantOfType(ASTName.class);
                if (name != null && name.getImage().endsWith(".setSecure")) {
                    if (expr.getNumChildren() >= 3) {
                        ASTLiteral arg = expr.getChild(2).getFirstDescendantOfType(ASTLiteral.class);
                        if (arg != null && "false".equals(arg.getImage())) {
                            addViolation(data, expr);
                        }
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
