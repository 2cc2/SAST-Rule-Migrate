import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class CookieSetSecureRule extends AbstractJavaRule {
    
    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("setSecure".equals(node.getMethodName())) {
            if (node.getArguments().size() == 1) {
                ASTLiteral arg = node.getArguments().getFirstDescendantOfType(ASTLiteral.class);
                if (arg != null && "false".equals(arg.getImage())) {
                    addViolation(data, node);
                }
            }
        }
        return super.visit(node, data);
    }
}
