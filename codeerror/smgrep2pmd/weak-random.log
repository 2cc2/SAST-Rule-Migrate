```java
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class WeakRandomRule extends AbstractJavaRule {

    public WeakRandomRule() {
        // 正确的构造函数初始化
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isWeakRandomMethodCall(node)) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTFieldDeclaration node, Object data) {
        if (node.getInitializer() instanceof ASTMethodCall) {
            ASTMethodCall methodCall = (ASTMethodCall) node.getInitializer();
            if (isWeakRandomMethodCall(methodCall)) {
                addViolation(data, methodCall);
            }
        }
        return super.visit(node, data);
    }

    private boolean isWeakRandomMethodCall(ASTMethodCall node) {
        String methodName = node.getMethodName();
        
        if (node.getQualifier() != null && 
            TypeTestUtil.isA("java.util.Random", node.getQualifier())) {
            return "nextInt".equals(methodName) || 
                   "nextFloat".equals(methodName) || 
                   "nextDouble".equals(methodName) || 
                   "nextLong".equals(methodName);
        }
        
        if ("random".equals(methodName) && 
            node.getQualifier() != null && 
            TypeTestUtil.isA("java.lang.Math", node.getQualifier())) {
            return true;
        }
        
        return false;
    }
}
