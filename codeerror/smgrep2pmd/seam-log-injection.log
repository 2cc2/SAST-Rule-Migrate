    }

    private boolean hasStringConcatenation(ASTMethodCall node) {
        ASTArgumentList args = node.getFirstChildOfType(ASTArgumentList.class);
        if (args == null) {
            return false;
        }

        for (ASTExpression expr : args.findChildrenOfType(ASTExpression.class)) {
            if (expr.hasDescendantOfType(ASTStringLiteral.class) 
                && expr.toString().contains("+")) {
                return true;
            }
        }
        return false;
    }
}
