Rule Content:
// Conversion from Semgrep to PMD rule for detecting Seam log injection vulnerabilities

package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceType;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SeamLogInjectionRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isSeamLogCall(node)) {
            checkForStringConcatenation(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isSeamLogCall(ASTMethodCall node) {
        return node.getMethodName().equals("info") 
            && node.getFirstParentOfType(ASTClassOrInterfaceType.class) != null 
            && node.getFirstParentOfType(ASTClassOrInterfaceType.class).getImage().equals("Log");
    }

    private void checkForStringConcatenation(ASTMethodCall node, Object data) {
        ASTArgumentList args = node.getFirstChildOfType(ASTArgumentList.class);
        if (args == null || args.getNumChildren() == 0) {
            return;
        }

        JavaNode firstArg = args.getChild(0);
        if (firstArg instanceof ASTPrimaryExpression) {
            ASTPrimaryExpression expr = (ASTPrimaryExpression) firstArg;
            ASTPrimaryPrefix prefix = expr.getFirstChildOfType(ASTPrimaryPrefix.class);
            if (prefix != null && prefix.jjtGetNumChildren() > 0 && prefix.jjtGetChild(0) instanceof ASTStringLiteral) {
                // Check if there's string concatenation in the arguments
                if (expr.getNumChildren() > 1 || args.getNumChildren() > 1) {
                    addViolation(data, node, "Potential log injection vulnerability detected. Avoid string concatenation in Seam log messages. Use parameterized logging instead.");
                }
            }
        }
    }
}
