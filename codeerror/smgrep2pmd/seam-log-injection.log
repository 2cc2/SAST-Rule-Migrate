// 转换后的 PMD 规则
package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;

public class SeamLogInjectionRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isLogInfoCall(node)) {
            checkForStringConcatenation(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isLogInfoCall(ASTMethodCall node) {
        return "info".equals(node.getMethodName())
                && node.getFirstParentOfType(ASTPrimaryExpression.class)
                        .getFirstDescendantOfType(ASTPrimaryPrefix.class)
                        .usesThisModifier()
                        && "log".equals(node.getFirstParentOfType(ASTPrimaryExpression.class)
                                .getFirstDescendantOfType(ASTPrimaryPrefix.class)
                                .getImage());
    }

    private void checkForStringConcatenation(ASTMethodCall node, Object data) {
        ASTArgumentList args = node.getFirstDescendantOfType(ASTArgumentList.class);
        if (args.getChildCount() == 1) {
            ASTExpression expr = (ASTExpression) args.getChild(0);
            if (expr.getNumChildren() > 1) {
                // Detects string concatenation using '+'
                addViolation(data, node);
            }
        }
    }
}
