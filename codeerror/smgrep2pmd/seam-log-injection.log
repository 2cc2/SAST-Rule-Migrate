// 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTPrimarySuffix;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclarator;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SeamLogInjectionRule extends AbstractJavaRule {

    public SeamLogInjectionRule() {
        addRuleChainVisit(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("info") && node.getArgumentCount() == 1) {
            ASTPrimaryExpression primaryExpression = node.getFirstParentOfType(ASTPrimaryExpression.class);
            if (primaryExpression != null) {
                ASTPrimaryPrefix prefix = primaryExpression.getFirstChildOfType(ASTPrimaryPrefix.class);
                if (prefix != null && prefix.usesThisModifier()) {
                    ASTPrimarySuffix suffix = primaryExpression.getFirstChildOfType(ASTPrimarySuffix.class);
                    if (suffix != null && suffix.getImage() != null && suffix.getImage().equals("log")) {
                        ASTVariableDeclarator var = prefix.getFirstParentOfType(ASTVariableDeclarator.class);
                        if (var != null && var.getName().equals("log")) {
                            addViolation(data, node);
                        }
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
