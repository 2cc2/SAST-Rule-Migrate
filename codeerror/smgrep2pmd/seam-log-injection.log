package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class SeamLogInjectionRule extends AbstractJavaRulechainRule {

    public SeamLogInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (!"info".equals(node.getMethodName())) {
            return super.visit(node, data);
        }

        ASTExpression qualifier = node.getQualifier();
        if (qualifier instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) qualifier;
            if ("log".equals(varAccess.getName())) {
                ASTArguments args = node.getArguments();
                if (args.size() > 0) {
                    ASTExpression firstArg = args.get(0);
                    if (firstArg instanceof ASTInfixExpression) {
                        ASTInfixExpression infixExpr = (ASTInfixExpression) firstArg;
                        if (infixExpr.getOperator() == JavaTokenKinds.PLUS) {
                            asCtx(data).addViolation(node);
                        }
                    } else if (firstArg instanceof ASTStringLiteral) {
                        ASTStringLiteral strLiteral = (ASTStringLiteral) firstArg;
                        if (!strLiteral.getImage().contains("#0")) {
                            asCtx(data).addViolation(node);
                        }
                    }
                }
            }
        }

        return super.visit(node, data);
    }
}
