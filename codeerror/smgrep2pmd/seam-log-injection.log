package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class SeamLogInjectionRule extends AbstractJavaRulechainRule {

    public SeamLogInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (TypeTestUtil.isA("org.jboss.seam.log.Log", node.getMethodType().getDeclaringType())) {
            if (node.getMethodName().equals("info")) {
                // Check for concatenated string arguments
                if (node.getArguments().size() > 0) {
                    ASTExpression firstArg = node.getArguments().get(0);
                    if (containsStringConcatWithVariables(firstArg)) {
                        asCtx(data).addViolation(node);
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean containsStringConcatWithVariables(ASTExpression expr) {
        // Check for direct string concatenation with variables
        if (expr instanceof ASTStringLiteral) {
            return false;
        }
        
        // Check if expression contains any string concatenation patterns
        return expr.descendantsOrSelf()
            .filter(it -> it != expr)
            .anyMatch(it -> {
                String image = it.getImage();
                return image != null && image.contains("+");
            });
    }
}
