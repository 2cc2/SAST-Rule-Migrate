// 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SeamLogInjectionRule extends AbstractJavaRule {

    public SeamLogInjectionRule() {
        addRuleChainVisit(ASTMethodDeclaration.class);
    }

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        if ("logUser".equals(node.getName()) || "doFilter".equals(node.getName())) {
            ASTMethodCall logCall = node.getFirstDescendantOfType(ASTMethodCall.class);
            if (logCall != null && "info".equals(logCall.getMethodName())) {
                ASTPrimaryExpression expr = logCall.getFirstParentOfType(ASTPrimaryExpression.class);
                if (expr != null) {
                    if (expr.jjtGetNumChildren() > 1 && expr.jjtGetChild(1).hasImageEqualTo("+")) {
                        addViolation(data, logCall);
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
