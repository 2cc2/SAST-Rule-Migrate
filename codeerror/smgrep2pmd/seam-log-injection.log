Rule Content:
// 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTPrimarySuffix;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SeamLogInjectionRule extends AbstractJavaRule {

    public SeamLogInjectionRule() {
        super();
        setProperty(CODECLIMATE_CATEGORIES, "Security");
        setProperty(CODECLIMATE_REMEDIATION_MULTIPLIER, 150);
        setProperty(CODECLIMATE_BLOCK_HIGHLIGHTING, false);
    }

    @Override
    public Object visit(ASTPrimaryExpression node, Object data) {
        if (isLoggingCall(node) && hasInsecureConcatenation(node)) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    private boolean isLoggingCall(ASTPrimaryExpression node) {
        ASTPrimaryPrefix prefix = node.getFirstChildOfType(ASTPrimaryPrefix.class);
        if (prefix != null && prefix.usesThisModifier()) {
            ASTPrimarySuffix suffix = node.getFirstChildOfType(ASTPrimarySuffix.class);
            if (suffix != null && "info".equals(suffix.getImage())) {
                return true;
            }
        }
        return false;
    }

    private boolean hasInsecureConcatenation(ASTPrimaryExpression node) {
        ASTPrimarySuffix suffix = node.getFirstChildOfType(ASTPrimarySuffix.class);
        if (suffix != null) {
            ASTLiteral literal = suffix.getFirstChildOfType(ASTLiteral.class);
            if (literal != null && literal.isStringLiteral()) {
                String literalValue = literal.getImage();
                return literalValue.contains("+");
            }
        }
        return false;
    }
}
