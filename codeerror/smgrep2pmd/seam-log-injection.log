package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SeamLogInjectionRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isLogInfoCall(node) && hasStringConcatenationArgument(node)) {
            addViolation(data, node, "Potential log injection vulnerability detected");
        }
        return super.visit(node, data);
    }

    private boolean isLogInfoCall(ASTMethodCall node) {
        return "info".equals(node.getMethodName())
                && node.getQualifier() != null
                && node.getQualifier() instanceof ASTVariableAccess
                && "log".equals(((ASTVariableAccess) node.getQualifier()).getName());
    }

    private boolean hasStringConcatenationArgument(ASTMethodCall node) {
        ASTArgumentList args = node.firstChild(ASTArgumentList.class);
        if (args != null) {
            return args.descendants(ASTStringLiteral.class)
                    .anyMatch(lit -> lit.getText().contains("+")) 
                    || args.getFirstDescendant(ASTStringLiteral.class) == null;
        }
        return false;
    }
}
