package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceType;
import net.sourceforge.pmd.lang.java.ast.ASTInfixExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCallPattern;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteralExpression;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.ast.InfixOperator;

public class SeamLogInjectionRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodCallPattern node, Object data) {
        if (isSeamLogCall(node)) {
            checkForStringConcatenation(node, data);
        }
        return super.visit(node, data);
    }

    private boolean isSeamLogCall(ASTMethodCallPattern node) {
        return "info".equals(node.getMethodSignature().getName())
            && node.getFirstParentOfType(ASTClassOrInterfaceType.class) != null 
            && "Log".equals(node.getFirstParentOfType(ASTClassOrInterfaceType.class).getImage());
    }

    private void checkForStringConcatenation(ASTMethodCallPattern node, Object data) {
        List<JavaNode> args = node.arguments();
        if (args == null || args.isEmpty()) {
            return;
        }

        JavaNode firstArg = args.get(0);
        if (firstArg instanceof ASTInfixExpression) {
            ASTInfixExpression expr = (ASTInfixExpression) firstArg;
            if (expr.getOperator() == InfixOperator.PLUS) {
                addViolation(data, node, "Potential log injection vulnerability detected. Avoid string concatenation in Seam log messages. Use parameterized logging instead.");
            }
        } else if (args.size() == 1 && firstArg.getFirstDescendantOfType(ASTInfixExpression.class) != null) {
            addViolation(data, node, "Potential log injection vulnerability detected. Avoid string concatenation in Seam log messages.");
        }
    }
}
