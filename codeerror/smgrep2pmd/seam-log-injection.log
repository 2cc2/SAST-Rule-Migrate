import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTCompilationUnit;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SeamLogInjectionRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTCompilationUnit node, Object data) {
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isLogInfoCall(node) && hasStringConcatenationInArguments(node)) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    private boolean isLogInfoCall(ASTMethodCall node) {
        ASTPrimaryExpression primaryExpression = node.getFirstParentOfType(ASTPrimaryExpression.class);
        if (primaryExpression == null) {
            return false;
        }

        ASTPrimaryPrefix prefix = primaryExpression.getFirstDescendantOfType(ASTPrimaryPrefix.class);
        if (prefix == null) {
            return false;
        }

        String methodName = node.getMethodName();
        ASTName name = prefix.getFirstDescendantOfType(ASTName.class);
        return "info".equals(methodName) 
            && name != null 
            && name.getImage().endsWith("log");
    }

    private boolean hasStringConcatenationInArguments(ASTMethodCall node) {
        ASTArgumentList args = node.getFirstChildOfType(ASTArgumentList.class);
        if (args == null) {
            return false;
        }

        for (ASTExpression expr : args.findChildrenOfType(ASTExpression.class)) {
            if (expr.getImage() != null && expr.getImage().contains("+")) {
                return true;
            }
        }
        return false;
    }
}
