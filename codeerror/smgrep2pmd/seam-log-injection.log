// 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SeamLogInjectionRule extends AbstractJavaRule {

    public SeamLogInjectionRule() {
        addRuleChainVisit(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isLogMethod(node) && hasInjectionRisk(node)) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    private boolean isLogMethod(ASTMethodCall node) {
        return node.getMethodName().equals("info") && node.getArgumentCount() == 1;
    }

    private boolean hasInjectionRisk(ASTMethodCall node) {
        ASTExpression expression = node.getFirstDescendantOfType(ASTExpression.class);
        if (expression != null && expression.hasDescendantOfType(ASTMethodCall.class)) {
            ASTMethodCall methodCall = expression.getFirstDescendantOfType(ASTMethodCall.class);
            if (methodCall != null && methodCall.getMethodName().equals("log")) {
                return true;
            }
        }
        return false;
    }
}
