package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTInfixExpression;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class SeamLogInjectionRule extends AbstractJavaRulechainRule {

    public SeamLogInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (!"info".equals(node.getMethodName())) {
            return super.visit(node, data);
        }

        String qualifier = "";
        ASTExpression qualifierExpr = node.getQualifier();
        if (qualifierExpr instanceof ASTVariableAccess) {
            qualifier = ((ASTVariableAccess) qualifierExpr).getName();
        }

        if (!"log".equals(qualifier)) {
            return super.visit(node, data);
        }

        ASTExpression firstArg = node.getArguments().size() > 0 
            ? node.getArguments().get(0)
            : null;
        if (firstArg == null) {
            return super.visit(node, data);
        }

        checkForLogInjection(firstArg, data);

        return super.visit(node, data);
    }

    private void checkForLogInjection(ASTExpression expr, Object data) {
        // Check for string concatenation
        if (expr instanceof ASTInfixExpression) {
            ASTInfixExpression infixExpr = (ASTInfixExpression) expr;
            if ("+".equals(infixExpr.getOperator())) {
                asCtx(data).addViolation(infixExpr);
            }
        }
        // Check for string literals with suspicious patterns
        else if (expr instanceof ASTStringLiteral) {
            ASTStringLiteral literal = (ASTStringLiteral) expr;
            String value = literal.getConstValue();
            if (value != null && (value.contains("method=") || value.contains("URL=") || 
                value.contains("Current logged in user"))) {
                asCtx(data).addViolation(literal);
            }
        }
    }
}
