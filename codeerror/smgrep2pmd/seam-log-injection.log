package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class SeamLogInjectionRule extends AbstractJavaRulechainRule {

    public SeamLogInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isLogInfoCall(node) && hasStringConcatenation(node)) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    private boolean isLogInfoCall(ASTMethodCall node) {
        return "info".equals(node.getMethodName()) 
            && TypeTestUtil.isA("org.jboss.seam.log.Log", node.getQualifier());
    }

    private boolean hasStringConcatenation(ASTMethodCall node) {
        // Check if any argument is a string concatenation
        return node.getArguments().toStream()
            .anyMatch(arg -> arg.descendantsOrSelf()
                .filter(ASTStringLiteral.class::isInstance)
                .anyMatch(lit -> {
                    ASTExpression parent = lit.getParent();
                    // Detect string concatenation pattern (String + ...)
                    return parent != null && "+".equals(parent.getImage());
                }));
    }
}
