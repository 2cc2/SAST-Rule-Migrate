Rule Content:
// 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SeamLogInjectionRule extends AbstractJavaRule {

    public SeamLogInjectionRule() {
        super.addRuleChainVisit(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isLogMethod(node) && isConcatenationInLog(node)) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }

    private boolean isLogMethod(ASTMethodCall node) {
        return node.getMethodName().equals("info") && node.getArguments().size() == 1
                && node.getFirstParentOfType(ASTPrimaryExpression.class)
                       .getFirstChildOfType(ASTMethodCall.class)
                       .getImage().matches("log");
    }

    private boolean isConcatenationInLog(ASTMethodCall node) {
        ASTPrimaryExpression expr = node.getFirstParentOfType(ASTPrimaryExpression.class);
        return expr.hasDescendantOfType(ASTMethodCall.class) && expr.getImage().contains("+");
    }
}
