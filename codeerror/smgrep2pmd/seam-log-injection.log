// 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTClassOrInterfaceDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTPrimarySuffix;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclarator;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.symboltable.VariableNameDeclaration;
import net.sourceforge.pmd.lang.symboltable.NameDeclaration;

public class SeamLogInjectionRule extends AbstractJavaRule {

    public SeamLogInjectionRule() {
        addRuleChainVisit(ASTClassOrInterfaceDeclaration.class);
    }

    @Override
    public Object visit(ASTClassOrInterfaceDeclaration node, Object data) {
        for (ASTMethodDeclaration method : node.findDescendantsOfType(ASTMethodDeclaration.class)) {
            for (ASTPrimaryExpression expr : method.findDescendantsOfType(ASTPrimaryExpression.class)) {
                ASTPrimaryPrefix prefix = expr.getFirstChildOfType(ASTPrimaryPrefix.class);
                ASTPrimarySuffix suffix = expr.getFirstChildOfType(ASTPrimarySuffix.class);

                if (prefix != null && suffix != null) {
                    ASTMethodCall methodCall = prefix.getFirstChildOfType(ASTMethodCall.class);
                    if (methodCall != null && methodCall.getMethodName().equals("info")) {
                        if (isLogMethod(methodCall)) {
                            if (containsStringConcatenation(suffix)) {
                                addViolation(data, expr);
                            }
                        }
                    }
                }
            }
        }
        return data;
    }

    private boolean isLogMethod(ASTMethodCall methodCall) {
        NameDeclaration nd = methodCall.getNameDeclaration();
        if (nd instanceof VariableNameDeclaration) {
            return ((VariableNameDeclaration) nd).getName().equals("log");
        }
        return false;
    }

    private boolean containsStringConcatenation(ASTPrimarySuffix suffix) {
        return suffix.hasDescendantOfType(ASTVariableDeclarator.class);
    }
}
