package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTInfixExpression;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;

public class SeamLogInjectionRule extends AbstractJavaRulechainRule {

    public SeamLogInjectionRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("info")) {
            if (node.getQualifier() != null && node.getQualifier().toString().equals("log")) {
                ASTExpression firstArg = node.getArguments().size() > 0 ? node.getArguments().get(0) : null;
                
                if (firstArg != null) {
                    checkForStringConcatenation(firstArg, data);
                }
            }
        }
        return super.visit(node, data);
    }

    private void checkForStringConcatenation(JavaNode node, Object data) {
        if (node instanceof ASTInfixExpression) {
            ASTInfixExpression infix = (ASTInfixExpression) node;
            if (infix.getOperator() == ASTInfixExpression.Operator.PLUS) {
                asCtx(data).addViolation(infix);
            }
        } else if (node instanceof ASTStringLiteral) {
            // Check if the string contains unescaped user input patterns
            ASTStringLiteral literal = (ASTStringLiteral) node;
            if (literal.getImage().contains("=") || literal.getImage().contains(":")) {
                asCtx(data).addViolation(node);
            }
        }

        // Recursively check child nodes
        for (JavaNode child : node.children()) {
            checkForStringConcatenation(child, data);
        }
    }
}
