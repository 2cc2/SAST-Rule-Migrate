package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.reporting.RuleContext;
import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;

public class SeamLogInjectionRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("info")) {
            ASTPrimaryExpression primaryExpr = node.ancestors(ASTPrimaryExpression.class).first();
            if (primaryExpr != null && primaryExpr.firstChild(ASTPrimaryPrefix.class) != null) {
                Node prefixChild = primaryExpr.firstChild(ASTPrimaryPrefix.class).getChild(0);
                if (prefixChild instanceof JavaNode 
                     && prefixChild.getImage() != null 
                     && prefixChild.getImage().equals("log")) {
                    
                    ASTArgumentList args = node.firstChild(ASTArgumentList.class);
                    if (args != null && args.getNumChildren() > 0 
                        && args.getChild(0).getImage().contains("+")) {
                        RuleContext ctx = (RuleContext) data;
                        ctx.addViolation(node, "Potential log injection vulnerability detected. Use parameterized logging instead of string concatenation.");
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
