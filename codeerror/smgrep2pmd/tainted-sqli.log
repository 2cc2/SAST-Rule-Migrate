# 转换后的 PMD 规则

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaration;

public class TaintedSQLiRule extends AbstractJavaRulechainRule {

    public TaintedSQLiRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("executeQuery".equals(node.getMethodName())) {
            for (ASTExpression arg : node.getArguments()) {
                for (ASTVariableAccess var : arg.descendants(ASTVariableAccess.class)) {
                    ASTVariableDeclaration declaration = var.getReferencedDeclaration();
                    if (declaration != null) {
                        ASTExpression initializer = declaration.getInitializer();
                        if (initializer != null) {
                            for (ASTStringLiteral lit : initializer.descendants(ASTStringLiteral.class)) {
                                if (lit.getText().contains("emp_id=")) {
                                    addViolation(data, node);
                                    break;
                                }
                            }
                        }
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
