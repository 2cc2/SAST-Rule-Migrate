package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.ASTStatement;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;

public class TaintedSQLiRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTStatement node, Object data) {
        if (isSQLStatement(node)) {
            Node parent = node.jjtGetParent();
            // Check if SQL query contains concatenated user input
            if (hasStringConcatenation(node)) {
                addViolation(data, node, "Potential SQL injection vulnerability found. Use prepared statements instead of string concatenation.");
            }
        }
        return super.visit(node, data);
    }

    private boolean isSQLStatement(Node node) {
        // Check if node represents an SQL statement execution
        if (node instanceof ASTStatement) {
            String image = node.getImage();
            return image != null && (image.contains("executeQuery") || image.contains("executeUpdate"));
        }
        return false;
    }

    private boolean hasStringConcatenation(Node node) {
        // Check for string concatenation in the SQL statement
        for (int i = 0; i < node.jjtGetNumChildren(); i++) {
            Node child = node.jjtGetChild(i);
            if (child instanceof ASTLiteral && ((ASTLiteral) child).isStringLiteral()) {
                String literal = ((ASTLiteral) child).getImage();
                if (literal.matches(".*\\+\\s*[^\"'].*")) {
                    return true;
                }
            }
        }
        return false;
    }
}
