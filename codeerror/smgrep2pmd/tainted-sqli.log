import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTAdditiveExpression;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class TaintedSQLQueryRule extends AbstractJavaRule {
    
    public TaintedSQLQueryRule() {
        addRuleChainVisit(ASTPrimaryExpression.class);
    }

    @Override
    public Object visit(ASTPrimaryExpression node, Object data) {
        // 查找方法调用
        for (ASTPrimaryPrefix prefix : node.findDescendantsOfType(ASTPrimaryPrefix.class)) {
            if (prefix.jjtGetNumChildren() > 0 && prefix.jjtGetChild(0) instanceof ASTName) {
                ASTName name = (ASTName) prefix.jjtGetChild(0);
                if (name.getImage() != null && name.getImage().endsWith("executeQuery")) {
                    // 检查参数是否被污染
                    for (ASTPrimaryExpression arg : node.findDescendantsOfType(ASTPrimaryExpression.class)) {
                        if (isTaintedSQL(arg)) {
                            addViolation(data, node);
                            break;
                        }
                    }
                }
            }
        }
        return data;
    }

    private boolean isTaintedSQL(ASTPrimaryExpression expr) {
        // 检查字符串连接
        if (!expr.findDescendantsOfType(ASTAdditiveExpression.class).isEmpty()) {
            return true;
        }
        
        // 检查变量使用
        return !expr.findDescendantsOfType(ASTVariableDeclaratorId.class).isEmpty();
    }
}
