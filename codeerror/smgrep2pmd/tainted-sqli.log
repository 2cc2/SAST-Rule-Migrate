/**
 * 检测拼接SQL查询的风险规则
 */
public class TaintedSQLQueryRule extends AbstractJavaRule {
    public TaintedSQLQueryRule() {
        addRuleChainVisit(ASTPrimaryExpression.class);
    }

    @Override
    public Object visit(ASTPrimaryExpression node, Object data) {
        // Find method calls in primary expressions
        for (ASTPrimaryPrefix prefix : node.findChildrenOfType(ASTPrimaryPrefix.class)) {
            // Check if this is an executeQuery call
            if (prefix.jjtGetNumChildren() > 0 &&
                prefix.jjtGetChild(0) instanceof ASTName) {
                ASTName name = (ASTName) prefix.jjtGetChild(0);
                if (name.getImage() != null && 
                    name.getImage().endsWith("executeQuery")) {
                    
                    // Get the arguments passed to executeQuery
                    for (ASTExpression arg : node.findDescendantsOfType(ASTExpression.class)) {
                        if (isTaintedSQL(arg)) {
                            addViolation(data, node);
                            break;
                        }
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isTaintedSQL(ASTExpression expr) {
        // Check for string concatenation
        if (expr.hasDescendantOfType(ASTAdditiveExpression.class)) {
            return true;
        }
        
        // Check for named variables in SQL
        return !expr.findDescendantsOfType(ASTVariableDeclaratorId.class).isEmpty();
    }
}
