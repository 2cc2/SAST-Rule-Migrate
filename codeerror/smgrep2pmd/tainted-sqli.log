package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaration;
import net.sourceforge.pmd.lang.java.ast.JavaNode;

public class TaintedSQLiRule extends AbstractJavaRulechainRule {

    public TaintedSQLiRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("executeQuery")) {
            boolean hasTaintedInput = node.getArguments().any(it ->
                it.descendantsOrSelf()
                    .filterIs(ASTVariableAccess.class)
                    .exists(var -> {
                        ASTVariableDeclaration declaration = var.getReferencedDeclaration();
                        if (declaration != null) {
                            ASTExpression initializer = declaration.getInitializer();
                            return initializer != null && initializer.descendantsOrSelf()
                                .filterIs(ASTStringLiteral.class)
                                .anyMatch(lit -> lit.getText().contains("emp_id="));
                        }
                        return false;
                    })
            );

            if (hasTaintedInput) {
                addViolation(data, node);
            }
        }
        return super.visit(node, data);
    }
}
