package net.sourceforge.pmd.rules;

import net.sourceforge.pmd.lang.java.ast.ASTAssignmentOperator;
import net.sourceforge.pmd.lang.java.ast.ASTBlockStatement;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodDeclaration;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryExpression;
import net.sourceforge.pmd.lang.java.ast.ASTPrimaryPrefix;
import net.sourceforge.pmd.lang.java.ast.ASTPrimarySuffix;
import net.sourceforge.pmd.lang.java.ast.ASTStatementExpression;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.ast.ASTArgumentList;

public class TaintedSqlInjectionRule extends AbstractJavaRule {

    @Override
    public Object visit(ASTMethodDeclaration node, Object data) {
        // Look for SQL execution methods
        Node block = node.getFirstChildOfType(ASTBlockStatement.class);
        if (block != null) {
            checkForTaintedSql(block, data);
        }
        return super.visit(node, data);
    }

    private void checkForTaintedSql(Node node, Object data) {
        for (int i = 0; i < node.getNumChildren(); i++) {
            Node child = node.getChild(i);
            
            if (child instanceof ASTStatementExpression) {
                ASTStatementExpression stmt = (ASTStatementExpression) child;
                Node primaryExpr = stmt.getFirstChildOfType(ASTPrimaryExpression.class);
                
                if (primaryExpr != null) {
                    Node primaryPrefix = primaryExpr.getFirstChildOfType(ASTPrimaryPrefix.class);
                    Node primarySuffix = primaryExpr.getFirstChildOfType(ASTPrimarySuffix.class);
                    
                    if (primaryPrefix != null && primarySuffix != null 
                            && primarySuffix.hasImageEqualTo("executeQuery")
                            && primaryPrefix.hasImageEqualTo("statement")) {
                        
                        ASTArgumentList args = primaryExpr.getFirstChildOfType(ASTArgumentList.class);
                        if (args != null && args.getNumChildren() > 0) {
                            Node arg = args.getChild(0);
                            if (arg instanceof ASTPrimaryExpression) {
                                ASTPrimaryExpression expr = (ASTPrimaryExpression) arg;
                                if (isConcatenatedString(expr)) {
                                    addViolation(data, stmt);
                                }
                            }
                        }
                    }
                }
            }
            checkForTaintedSql(child, data);
        }
    }

    private boolean isConcatenatedString(ASTPrimaryExpression expr) {
        boolean hasConcatenation = false;
        boolean hasVariable = false;
        
        for (int i = 0; i < expr.getNumChildren(); i++) {
            Node child = expr.getChild(i);
            if (child instanceof ASTLiteral) {
                hasConcatenation = true;
            } else if (child instanceof ASTPrimaryPrefix) {
                ASTPrimaryPrefix prefix = (ASTPrimaryPrefix) child;
                if (prefix.getFirstChildOfType(ASTName.class) != null) {
                    hasVariable = true;
                }
            }
        }
        return hasConcatenation && hasVariable;
