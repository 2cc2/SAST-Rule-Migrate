import net.sourceforge.pmd.lang.java.ast.ASTStatement;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTAdditiveExpression;
import net.sourceforge.pmd.lang.java.ast.ASTName;

public class TaintedSQLQueryRule extends AbstractJavaRule {
    public TaintedSQLQueryRule() {
        addRuleChainVisit(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (node.getMethodName().equals("executeQuery")) {
            ASTExpression args = node.getFirstDescendantOfType(ASTExpression.class);
            if (args != null && isConcatenatedWithVariables(args)) {
                addViolation(data, node);
            }
        }
        return super.visit(node, data);
    }

    private boolean isConcatenatedWithVariables(ASTExpression expr) {
        if (expr instanceof ASTAdditiveExpression) {
            return true;
        }
        if (expr.hasDescendantOfType(ASTName.class)) {
            return true;
        }
        return false;
    }
}
