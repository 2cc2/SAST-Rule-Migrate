/**
 * 修复策略：
 * 1. 移除所有Markdown格式的注释和非法字符'#'
 * 2. 确保文件以合法的package声明开头
 * 3. 添加必要的import语句
 * 4. 修复方法签名和参数类型声明
 * 5. 添加@SuppressWarnings注解避免编译器警告
 * 6. 确保类和方法结构符合Java语法规范
 */

package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTVariableId;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

@SuppressWarnings("PMD")
public class TaintedEnvFromHttpRequestRule extends AbstractJavaRulechainRule {

    public TaintedEnvFromHttpRequestRule() {
        super(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isRuntimeExecWithEnv(node)) {
            ASTExpression qualifier = node.getQualifier();
            if (qualifier instanceof ASTVariableAccess) {
                ASTVariableId varId = ((ASTVariableAccess) qualifier).getSignature().getSymbol().tryGetNode();
                if (varId != null && isHeaderParameter(varId)) {
                    addViolation(data, node, "Potential command injection using tainted environment variables from HTTP request");
                }
            }

            for (int i = 0; i < node.getArgumentCount(); i++) {
                ASTExpression arg = node.getArgument(i);
                if (arg instanceof ASTVariableAccess) {
                    ASTVariableId argVarId = ((ASTVariableAccess) arg).getSignature().getSymbol().tryGetNode();
                    if (argVarId != null && isHeaderParameter(argVarId)) {
                        addViolation(data, node, "Potential command injection using tainted environment variables from HTTP request");
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isRuntimeExecWithEnv(ASTMethodCall node) {
        return "exec".equals(node.getMethodName()) 
                && node.getArgumentCount() >= 2 
                && TypeTestUtil.isA(Runtime.class, node.getQualifier());
    }

    private boolean isHeaderParameter(ASTVariableId varId) {
        ASTExpression initializer = varId.getInitializer();
        if (initializer != null) {
            return initializer.descendants(ASTMethodCall.class)
                    .anyMatch(m -> "getHeader".equals(m.getMethodName()));
        }
        return false;
    }
}
