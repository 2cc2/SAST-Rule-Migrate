package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableAccess;
import net.sourceforge.pmd.lang.java.ast.ASTStringLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRulechainRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;

public class CommandInjectionProcessBuilderRule extends AbstractJavaRulechainRule {
    
    public CommandInjectionProcessBuilderRule() {
        super(ASTMethodCall.class);
    }
    
    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isProcessBuilderCommandCall(node)) {
            checkCommandArguments(node, data);
        }
        return data;
    }
    
    private boolean isProcessBuilderCommandCall(ASTMethodCall node) {
        return "command".equals(node.getMethodName()) 
            && TypeTestUtil.isA("java.lang.ProcessBuilder", node.getQualifier());
    }
    
    private void checkCommandArguments(ASTMethodCall node, Object data) {
        for (ASTExpression arg : node.getArguments()) {
            if (isUnsafeCommandArgument(arg)) {
                addViolation(data, arg);
                break;
            }
        }
    }
    
    private boolean isUnsafeCommandArgument(ASTExpression arg) {
        if (arg instanceof ASTVariableAccess) {
            return true;
        }
        
        if (arg instanceof ASTStringLiteral) {
            String value = ((ASTStringLiteral)arg).getConstantValue();
            if (value != null && (value.equals("-c") || value.equals("/c"))) {
                ASTExpression nextArg = arg.getNextSibling();
                if (nextArg instanceof ASTVariableAccess) {
                    return true;
                }
            }
        }
        
        return false;
    }
}
