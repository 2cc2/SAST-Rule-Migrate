// 转换后的 PMD 规则
package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class InsecureJmsDeserializationRule extends AbstractJavaRule {

    public InsecureJmsDeserializationRule() {
        setMessage("Potential insecure JMS deserialization detected");
        since("6.55.0");
        setSeverity(Severity.HIGH);
    }

    @Override
    public Object visit(ASTPrimaryExpression node, Object data) {
        checkGetObjectCall(node, data);
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTCastExpression node, Object data) {
        checkCastExpression(node, data);
        return super.visit(node, data);
    }

    private void checkGetObjectCall(ASTPrimaryExpression node, Object data) {
        if (node.jjtGetNumChildren() < 2) {
            return;
        }

        ASTPrimaryPrefix prefix = node.getFirstDescendantOfType(ASTPrimaryPrefix.class);
        ASTPrimarySuffix suffix = node.getFirstDescendantOfType(ASTPrimarySuffix.class);

        if (suffix != null 
            && suffix.isArguments() 
            && "getObject".equals(suffix.getImage())
            && prefix != null 
            && prefix.getFirstChildOfType(ASTName.class) != null) {
            String methodCall = prefix.getFirstChildOfType(ASTName.class).getImage();
            if (methodCall.endsWith("ObjectMessage")) {
                addViolation(data, node, "Direct call to getObject() on ObjectMessage detected");
            }
        }
    }

    private void checkCastExpression(ASTCastExpression node, Object data) {
        boolean hasGetObjectCall = node.findDescendantsOfType(ASTPrimarySuffix.class)
            .stream()
            .anyMatch(suffix -> suffix.isArguments() && "getObject".equals(suffix.getImage()));

        if (hasGetObjectCall && !node.getTypeNode().getTypeImage().equals("Object")) {
            addViolation(data, node, "Unsafe casting of JMS deserialized object to custom type");
        }
    }
}
