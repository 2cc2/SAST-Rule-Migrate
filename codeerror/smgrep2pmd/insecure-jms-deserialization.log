package net.sourceforge.pmd.lang.java.rule.security;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.properties.PropertyDescriptor;
import net.sourceforge.pmd.properties.PropertyFactory;

public class InsecureJmsDeserializationRule extends AbstractJavaRule {

    private static final PropertyDescriptor<String> MESSAGE_DESCRIPTOR = 
        PropertyFactory.stringProperty("message")
            .desc("Violation message")
            .defaultValue("Potential insecure JMS deserialization detected")
            .build();

    public InsecureJmsDeserializationRule() {
        definePropertyDescriptor(MESSAGE_DESCRIPTOR);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("getObject".equals(node.getMethodName())) {
            ASTPrimaryExpression primaryExpr = node.getFirstParentOfType(ASTPrimaryExpression.class);
            if (primaryExpr != null && isObjectMessageCall(primaryExpr)) {
                addViolation(data, node, getProperty(MESSAGE_DESCRIPTOR));
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTCastExpression node, Object data) {
        ASTExpression expr = node.getExpr();
        if (expr instanceof ASTPrimaryExpression) {
            ASTPrimaryExpression primaryExpr = (ASTPrimaryExpression) expr;
            if (containsGetObjectCall(primaryExpr) && !isObjectCast(node)) {
                addViolation(data, node, getProperty(MESSAGE_DESCRIPTOR));
            }
        }
        return super.visit(node, data);
    }

    private boolean isObjectMessageCall(ASTPrimaryExpression node) {
        ASTPrimaryPrefix prefix = node.getFirstDescendantOfType(ASTPrimaryPrefix.class);
        if (prefix == null) return false;
        
        ASTName name = prefix.getFirstDescendantOfType(ASTName.class);
        return name != null && name.getImage() != null 
            && name.getImage().endsWith("ObjectMessage");
    }

    private boolean containsGetObjectCall(ASTPrimaryExpression node) {
        return node.findDescendantsOfType(ASTMethodCall.class)
            .stream()
            .anyMatch(mc -> "getObject".equals(mc.getMethodName()));
    }

    private boolean isObjectCast(ASTCastExpression node) {
        ASTType type = node.getTypeNode();
        return type != null && "Object".equals(type.getTypeImage());
    }
}
