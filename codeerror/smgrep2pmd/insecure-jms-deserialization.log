package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import static net.sourceforge.pmd.lang.java.types.TypeTestUtil.isExactlyA;

public class InsecureJMSDeserializationRule extends AbstractJavaRule {

    public InsecureJMSDeserializationRule() {
        addRuleChainVisit(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if ("getObject".equals(node.getMethodName()) 
            && isExactlyA("javax.jms.ObjectMessage", node.getQualifier())) {
            addViolation(data, node);
        }
        return super.visit(node, data);
    }
}
