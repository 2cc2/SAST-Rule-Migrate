// 转换后的 PMD 规则
rule "Insecure JMS Deserialization"
    language = java
    message = "Potential insecure JMS deserialization detected"
    since = "6.55.0"
    severity = HIGH

    /**
     * Detects dangerous JMS deserialization patterns:
     * 1. Direct call to getObject() on ObjectMessage
     * 2. Casting result of getObject() to custom class
     */
    rulechain {
        ast = "PrimaryExpression"
    }

    /**
     * Match variant 1: calling getObject() method directly on ObjectMessage
     */
    object getObjectCall : (
        // PrimaryExpression[PrimaryPrefix/Name[ends-with(@Image, '.getObject')]]
        // or
        PrimaryExpression[
            PrimaryPrefix/PrimarySuffix[ends-with(@Image, 'getObject')]
            and PrimaryPrefix/Name[ends-with(@Image, 'ObjectMessage')]
        ]
    )

    /**
     * Match variant 2: calling getObject() and casting to custom class
     */
    object getObjectCast : (
        // CastExpression[Type/ReferenceType/ClassOrInterfaceType[@Image != 'Object']]
