Rule Content:
/**
 * @name Dangerous asyncio exec audit
 * @description Detected subprocess function without a static string. If this data can be controlled by a malicious actor,
 *              it may be an instance of command injection.
 * @kind path-problem
 * @problem.severity error
 * @id py/dangerous-asyncio-exec-audit
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.ApiGraphs

private class SubprocessExecCall extends API::FunctionValue {
  SubprocessExecCall() {
    this.getMethodName() = "subprocess_exec" and
    this.getScope().(API::ClassValue).getDisplayName() = "AbstractEventLoop" and
    this.getScope().getScope().(API::ModuleValue).getName() = "asyncio"
  }
}

class ShellSubprocessCall extends SubprocessExecCall {
  predicate matchesShell() {
    exists(string shell | 
      this.getAnArg().getStringValue().regexpMatch("sh|bash|ksh|csh|tcsh|zsh"))
  }

  predicate hasDashCArgument() {
    exists(string arg | 
      this.getAnArg().getStringValue() = "-c")
  }
}

class UntrustedInput extends DataFlow::Node {
  UntrustedInput() {
    exists(CallExpr call | call.getAChild() = this) or
    exists(Literal literal | literal.getValue() = this)
  }

  predicate isNotStaticString() {
    not exists(string val | val = this.getStringValue() and regexpMatch(val, "\.\.\."))
  }
}

class CommandSink extends DataFlow::Node {
  CommandSink() {
    exists(SubprocessExecCall call, DataFlow::Node arg |
      arg = call.getAnArg() and
      arg = this
    )
  }
}

class ShellCommandSink extends CommandSink {
  ShellCommandSink() {
    exists(ShellSubprocessCall call |
      call.matchesShell() and
      call.hasDashCArgument()
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "DangerousAsyncioExecTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UntrustedInput and
    source.isNotStaticString()
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CommandSink or
    sink instanceof ShellCommandSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(string val | val = node.getStringValue() and val = "...")
  }

  override predicate isBarrier(DataFlow::Node node) {
    node.(ReturnStmt).exists()
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig config
where config.hasFlowPath(source, sink)
select sink, "Command injection risk in subprocess call. Consider using shlex.escape().", 
  source, sink, "Untrusted input flows to subprocess call."
