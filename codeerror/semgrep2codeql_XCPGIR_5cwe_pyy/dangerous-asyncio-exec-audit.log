    constraints:
      path:
        must_not: [{pattern: "CALL(asyncio.AbstractEventLoop.subprocess_exec($PROTOCOL, \"=~/(sh|bash|ksh|csh|tcsh|zsh)/\", \"-c\", \"...\", ...)"}]

report:
  message: "Command injection risk in subprocess call. Consider using shlex.escape()."
  locations: ["source", "sink", "path"]
  evidence:
    capture:
      - argument: 1
      - argument: 2
