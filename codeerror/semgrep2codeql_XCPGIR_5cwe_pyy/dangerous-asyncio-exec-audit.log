Rule Content:
/**
 * @name Dangerous asyncio exec audit
 * @description Detected subprocess function without a static string. If this data can be controlled by a malicious actor,
 *              it may be an instance of command injection.
 * @kind path-problem
 * @problem.severity error
 * @id py/dangerous-asyncio-exec-audit
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import DataFlow::PathGraph

private class SubprocessExecCall extends API::Call {
  SubprocessExecCall() {
    this =
      API::moduleMember("asyncio", "AbstractEventLoop").getMember("subprocess_exec").getACall()
      or
      this =
        API::moduleMember("asyncio", "AbstractEventLoop").getMemberValue("subprocess_exec").getACall()
  }

  int getCommandArgIndex() { result = 1 }
}

private class ShellSubprocessCall extends SubprocessExecCall {
  string getShell() {
    exists(string shell | shell = this.getArg(getCommandArgIndex()).getStringLiteral().getText() |
      shell.regexpMatch("/sh|bash|ksh|csh|tcsh|zsh/"))
  }

  predicate hasDashCArgument() {
    this.getArg(getCommandArgIndex() + 1).getStringLiteral().getText() = "-c"
  }
}

predicate isStaticString(Expr e) {
  e.getStringLiteral().getText() matches /\.\.\./
}

class UntrustedInput extends DataFlow::ExprNode {
  UntrustedInput() {
    exists(Call call | call.(UntrustedSourceCall).getAnInput() = this) or
    exists(Literal literal | literal = this)
  }
}

private class CommandSink extends DataFlow::Node {
  CommandSink() {
    exists(SubprocessExecCall call |
      call.getArg(call.getCommandArgIndex()) = this.getBasicNode()
    )
  }
}

private class ShellCommandSink extends CommandSink {
  ShellCommandSink() {
    exists(ShellSubprocessCall call |
      call.getArg(call.getCommandArgIndex()) = this.getBasicNode()
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "DangerousAsyncioExecTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UntrustedInput and
    not isStaticString(source.getBasicNode())
  }

  override predicate isSink(DataFlow::Node sink) {
    (sink instanceof CommandSink and not exists(SubprocessExecCall call |
      call.getArg(call.getCommandArgIndex()) = sink.getBasicNode() and
      isStaticString(call.getArg(call.getCommandArgIndex()))
    ))
    or
    (sink instanceof ShellCommandSink and not exists(ShellSubprocessCall call |
      call.getArg(call.getCommandArgIndex()) = sink.getBasicNode() and
      isStaticString(call.getArg(call.getCommandArgIndex())) and
      call.hasDashCArgument()
    ))
  }

  override predicate isSanitizer(DataFlow::Node node) {
    isStaticString(node.getBasicNode())
  }

  override predicate isBarrier(DataFlow::Node node) {
    node.getBasicNode() instanceof Return
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig config
where config.hasFlowPath(source, sink)
select sink, "Command injection risk in subprocess call. Consider using shlex.escape().", source, sink,
  "Untrusted input flows to subprocess call."
