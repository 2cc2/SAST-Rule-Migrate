Rule Content:
/**
 * @id formatted-sql-query
 * @kind path-problem
 * @severity warning
 * @name Detected possible formatted SQL query
 * @description User input reaches SQL execution without sanitization. Use parameterized queries instead.
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow
import semmle.python.Strings

class StringFormatSource extends TaintTracking::TaintSource {
  StringFormatSource() {
    exists(MethodCall mc |
      (mc.getMethod().hasName("format") or mc.getMethod().hasName("__mod__")) and
      this.asExpr() = mc
    ) or
    exists(FStringFormat fmt | this.asExpr() = fmt)
  }
}

class SqlExecuteSink extends TaintTracking::TaintSink {
  SqlExecuteSink() {
    exists(MethodCall mc |
      mc.getMethod().hasName("execute") and
      this.asExpr() = mc.getArgument(0)
    )
  }
}

class FormattedSqlQueryConfig extends TaintTracking::Configuration {
  FormattedSqlQueryConfig() { this = "FormattedSqlQueryConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof StringFormatSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SqlExecuteSink
  }
}

from FormattedSqlQueryConfig cfg, TaintTracking::PathNode source, TaintTracking::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches SQL execution without sanitization",
  source.getNode(), sink.getNode(),
  "Formatted string flows to SQL execution without sanitization"
