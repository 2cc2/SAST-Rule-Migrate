Rule Content:
/**
 * @id formatted-sql-query
 * @name Detected possible formatted SQL query
 * @description User input reaches SQL execution without sanitization. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @tags security
 *       python
 *       sql-injection
 */

import python
import DataFlow::PathGraph

class StringFormatOperation extends DataFlow::Node {
  StringFormatOperation() {
    // Matches string formatting operations (%), .format(), and f-strings
    exists(Call call |
      (call.getCalleeName() = "__mod__" or 
       call.getCalleeName() = "format") and
      this.asExpr() = call
    ) or
    exists(FString fstr | this.asExpr() = fstr)
  }
}

class SqlExecuteCall extends DataFlow::Node {
  SqlExecuteCall() {
    exists(Call call |
      call.getCalleeName() = "execute" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class FormattedSqlQueryConfig extends TaintTracking::Configuration {
  FormattedSqlQueryConfig() { this = "FormattedSqlQueryConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatOperation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteCall
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, FormattedSqlQueryConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(),
  "User input reaches SQL execution without sanitization. ${sink.getNode()} " +
  "receives unparameterized input from ${source.getNode()}."
