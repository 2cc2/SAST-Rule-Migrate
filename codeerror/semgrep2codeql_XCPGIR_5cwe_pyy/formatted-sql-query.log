Rule Content:
/**
 * @id formatted-sql-query
 * @name Detected possible formatted SQL query
 * @description User input reaches SQL execution without sanitization. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @tags security
 *       python
 *       sql-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow
import semmle.python.Concepts
import semmle.python.ApiGraphs

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(DataFlow::CallNode call |
      (call.getMethodName() = "format" or call.getMethodName() = "__mod__") and
      this = call.asDefiningArgument()
    ) or
    exists(DataFlow::FStringNode fstr | this = fstr.asDefiningArgument())
  }
}

class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() {
    exists(DataFlow::CallNode call |
      call.getMethodName() = "execute" and
      this = call.getArgument(0)
    )
  }
}

class FormattedSqlQueryConfig extends TaintTracking::Configuration {
  FormattedSqlQueryConfig() { this = "formatted_sql_query_config" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteSink
  }
}

from FormattedSqlQueryConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches SQL execution without sanitization",
  source.getNode(), sink.getNode(),
  "Formatted string flows to SQL execution without sanitization"
