/**
 * @name Path Traversal via open()
 * @description Detects when unsanitized user input reaches file open operations
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Requests

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Parameter p | 
      p.getVariable().getType() instanceof RouteVarType and
      this.asParameter() = p
    )
  }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["get", "__getitem__", "__call__"] and
      ma.getReceiver().getType().hasQualifiedName("flask", "Request") and
      this.asExpr() = ma
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(Call c |
      c.getFunc().getName() = "open" and
      this.asExpr() = c.getArg(0)
    )
  }
}

class RouteVarType extends Type {
  RouteVarType() { 
    this.getName().matches("%ROUTEVAR%")
  }
}

predicate isTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
  exists(DataFlow::BasicCallNode call |
    call = pred.asCall() and
    succ.asExpr() = call.getAnArgument()
  )
  or
  exists(DataFlow::AssignmentNode assign |
    assign.getSource() = pred.asExpr() and
    assign.getDest() = succ.asExpr()
  )
}

from FlaskRequestSource source, FileOpenSink sink
where DataFlow::localTaint(source, sink, isTaintStep)
select sink, "User input reaches file open operation without sanitization", 
  source, "Source of user input", sink, "File open operation"

from RouteParameterSource source, FileOpenSink sink
where DataFlow::localTaint(source, sink, isTaintStep)
select sink, "Route parameter reaches file open operation without sanitization",
  source, "Route parameter", sink, "File open operation"
