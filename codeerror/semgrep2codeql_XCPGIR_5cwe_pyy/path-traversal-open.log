Rule Content:
/**
 * @name Path Traversal via open()
 * @description Detects when unsanitized user input reaches file open operations
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.dataflow.TaintTracking
import flask.FlaskRequest

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() instanceof ["get", "__getitem__", "__call__"] and
      ma.getReceiver().getType().hasQualifiedName("flask", "request")
    )
  }
}

class RouteVariableSource extends DataFlow::Node {
  RouteVariableSource() {
    exists(Parameter p |
      p.getVariable().getName().matches("%ROUTEVAR%")
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(Call call |
      call.getFunc().getName() = "open" and
      this.asExpr() = call.getArg(0)
    )
  }
}

predicate isTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
  any() or  // All edges are potential taint steps
  exists(DataFlow::ParameterNode p, DataFlow::ArgumentNode a |
    pred = a and succ = p
  ) or
  exists(DataFlow::AssignmentNode assign |
    pred = assign.getSource() and succ = assign.getDest()
  )
}

from FlaskRequestSource source, FileOpenSink sink
where DataFlow::localTaint(source, sink, isTaintStep)
select sink, "User input reaches file open operation without sanitization", source, sink.toString()

from RouteVariableSource source, FileOpenSink sink
where DataFlow::localTaint(source, sink, isTaintStep)
select sink, "User input from route variable reaches file open operation without sanitization", source, sink.toString()
