Rule Content:
/**
 * @name Path Traversal via open()
 * @description Detects when unsanitized user input reaches file open operations
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("get|__getitem__|__call__") and
      ma.getReceiver().getType().hasQualifiedName("flask", "request")
    )
  }
}

class RouteVariableSource extends TaintTracking::Source {
  RouteVariableSource() {
    exists(Function f, Parameter p |
      p = f.getAParameter() and
      p.getName().matches("\\$ROUTEVAR")  
    )
  }
}

class FileOpenSink extends TaintTracking::Sink {
  FileOpenSink() {
    exists(Call c |
      c.getFunc().getName() = "open" and
      this.asExpr() = c.getArg(0)
    )
  }
}

predicate isTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
  TaintTracking::localTaintStep(pred, succ)
    or
  exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
    pred.asExpr() = arg.getExpr() and
    succ.asExpr() = param.getExpr()
  )
    or
  exists(DataFlow::AssignmentNode assign |
    pred.asExpr() = assign.getSource().getAnExpr() and
    succ.asExpr() = assign.getDest().getAnExpr()
  )
}

from FlaskRequestSource source, FileOpenSink sink
where TaintTracking::localTaint(source, sink, isTaintStep)
select sink, "User input reaches file open operation without sanitization", 
  source, "User input source", sink, "File open sink"

from RouteVariableSource source, FileOpenSink sink
where TaintTracking::localTaint(source, sink, isTaintStep)
select sink, "User input from route variable reaches file open operation without sanitization",
  source, "Route variable source", sink, "File open sink"
