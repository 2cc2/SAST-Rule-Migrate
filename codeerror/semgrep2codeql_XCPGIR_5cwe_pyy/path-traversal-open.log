Rule Content:
/**
 * @name Path Traversal via open()
 * @description Detects when unsanitized user input reaches file open operations
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.HttpRequest

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(RequestAccess request |
      request = ...
      request.getMethodName().regexpMatch("get|__getitem__|__call__") and
      this.asExpr() = request
    )
  }
}

class RouteVariableSource extends DataFlow::Node {
  RouteVariableSource() {
    exists(Function f, Parameter p |
      p = f.getParameter(0) and
      p.getName().regexpMatch("\\$ROUTEVAR") and
      this.asParameter() = p
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(Call call |
      call.getCalleeName() = "open" and
      this.asExpr() = call.getArgument(0)
    )
  }
}

predicate isTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
  TaintTracking::localTaintStep(pred, succ)
  or
  exists(ParameterNode param, ArgumentNode arg |
    pred.asExpr() = arg.getExpr() and
    succ.asParameter() = param
  )
  or
  exists(AssignmentNode assign |
    pred.asExpr() = assign.getSource() and
    succ.asExpr() = assign.getDest()
  )
}

from FlaskRequestSource source, FileOpenSink sink
where TaintTracking::localTaint(source, sink, isTaintStep)
select sink, "User input reaches file open operation without sanitization"

from RouteVariableSource source, FileOpenSink sink
where TaintTracking::localTaint(source, sink, isTaintStep)
select sink, "Route parameter reaches file open operation without sanitization"
