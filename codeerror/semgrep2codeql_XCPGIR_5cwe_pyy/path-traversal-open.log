/**
 * @name Path Traversal via open()
 * @description Detects when unsanitized user input reaches file open operations
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(CallNode call |
      call.getTarget().hasQualifiedName("flask", "request") and
      call.getMethodName().matches("get|__getitem__|__call__") and
      this.asExpr() = call
    )
  }
}

class RouteVariableSource extends DataFlow::Node {
  RouteVariableSource() {
    exists(Parameter p |
      p.getName().regexpMatch("\\$ROUTEVAR") and
      this.asParameter() = p
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(CallNode call |
      call.getTarget().hasQualifiedName("builtins", "open") and
      this.asExpr() = call.getArg(0)
    )
  }
}

predicate isTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
  // Argument to parameter flow
  exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
    arg.asExpr() = pred.asExpr() and
    param.asVariable() = succ.asVariable()
  )
  // Assignment flow
  or
  exists(DataFlow::AssignmentNode assign |
    assign.getSource().asExpr() = pred.asExpr() and
    assign.getDest().asExpr() = succ.asExpr()
  )
}

from FlaskRequestSource source, FileOpenSink sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where DataFlow::localPath(source, sink, isTaintStep, sourceNode, sinkNode)
select sink, "User input reaches file open operation without sanitization",
  sourceNode, source, sinkNode, sink

from RouteVariableSource source, FileOpenSink sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where DataFlow::localPath(source, sink, isTaintStep, sourceNode, sinkNode)
select sink, "User input from route variable reaches file open operation without sanitization",
