Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables
 *              in the SQL statement are not properly sanitized. Use a prepared statements 
 *              (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Hibernate

class HibernateSqlInjectionConfiguration extends TaintTracking::Configuration {
  HibernateSqlInjectionConfiguration() { this = "HibernateSqlInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    // String concatenation source
    exists(AssignmentExpr assign |
      assign.getRightOperand().toString().matches(".+\\+.+") and
      source.asExpr() = assign.getRightOperand()
    )
    or
    // String.format() source
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      source.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // Hibernate Restrictions.sqlRestriction()
    exists(MethodAccess ma |
      ma.getMethod().hasName("sqlRestriction") and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate.criterion", "Restrictions") and
      sink.asExpr() = ma.getArgument(0)
    )
    or
    // Hibernate Session methods
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("createQuery|createSQLQuery") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal l | sanitizer.asExpr() = l and l.isStringLiteral())
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    none()  // No additional taint steps needed for this rule
  }
}

from HibernateSqlInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches SQL execution without sanitization. " +
  "Potential SQL injection vulnerability via $@.", 
  source.getNode(), "user input",
  sink.getNode(), "SQL execution"
