Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables
 *              in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Hibernate

class StringConcatSource extends DataFlow::ExprNode {
  StringConcatSource() {
    exists(AssignExpr assign |
      assign.getTarget() instanceof LocalVariableAccess and
      assign.getTarget().getName().matches("%SQL%") and
      assign.getSource() instanceof BinaryExpr and
      assign.getSource().getOp() instanceof Add
    )
  }
}

class StringFormatSource extends DataFlow::ExprNode {
  StringFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")
    )
  }
}

class SqlParamSource extends DataFlow::ParameterNode {
  SqlParamSource() { this.getParameter().getName().matches("%SQL%") }
}

class SqlRestrictionSink extends DataFlow::ExprNode {
  SqlRestrictionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("sqlRestriction") and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate.criterion", "Restrictions")
    ) and
    this.asExpr() = any(MethodAccess ma).getArgument(0)
  }
}

class SessionMethodSink extends DataFlow::ExprNode {
  SessionMethodSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("createQuery|createSQLQuery") and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate", "Session")
    ) and
    this.asExpr() = any(MethodAccess ma).getArgument(0)
  }
}

class StaticStringSanitizer extends DataFlow::ExprNode {
  StaticStringSanitizer() { this instanceof StringLiteral }
}

/**
 * Taint-tracking configuration for SQL injection in Hibernate.
 */
module InjectionConfig implements TaintTracking::Configuration {
  InjectionConfig() { this = "Hibernate SqlInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringConcatSource or
    source instanceof StringFormatSource or
    source instanceof SqlParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlRestrictionSink or
    sink instanceof SessionMethodSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticStringSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagate taint through assignments
    exists(AssignExpr assign |
      node1.asExpr() = assign.getSource() and
      node2.asExpr() = assign.getTarget()
    ) or
    // Propagate taint from arguments to parameters
    exists(Method m, Parameter p, Callable c, int argIdx |
      m = c.getSourceDeclaration() and
      p = m.getParameter(argIdx) and
      node1.asExpr() = c.getArgument(argIdx) and
      node2.asParameter() = p
    )
  }
}

from InjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink) and
      // Exclude paths that go through static strings
      not exists(DataFlow::PathNode sanitized |
        sanitized.getNode() instanceof StaticStringSanitizer and
        sanitized = source.getAPathElement()
      )
select sink, source, sink,
  "Detected a formatted string in a SQL statement. This could lead to SQL injection."
