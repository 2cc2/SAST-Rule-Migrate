import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Hibernate

class StringConcatSource extends DataFlow::ExprNode {
  StringConcatSource() {
    exists(AssignExpr assign |
      assign.getRightOperand().toString().regexpMatch(".+\\+.+") and
      this.asExpr() = assign.getRightOperand()
    )
