Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables
 *              in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Hibernate

class StringConcatSource extends DataFlow::ExprNode {
  StringConcatSource() {
    exists(Variable v, Expr init |
      v.getType() instanceof TypeString and
      v.getName().matches("%SQL%") and
      init instanceof AddExpr and
      this.asExpr() = init
    )
  }
}

class StringFormatSource extends DataFlow::ExprNode {
  StringFormatSource() {
    exists(Method m, MethodAccess ma |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class SqlParamSource extends DataFlow::ParameterNode {
  SqlParamSource() {
    this.getParameter().getName().matches("%SQL%")
  }
}

class SqlRestrictionSink extends DataFlow::ExprNode {
  SqlRestrictionSink() {
    exists(Method m, MethodAccess ma |
      m.hasName("sqlRestriction") and
      m.getDeclaringType().hasQualifiedName("org.hibernate.criterion", "Restrictions") and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SessionMethodSink extends DataFlow::ExprNode {
  SessionMethodSink() {
    exists(Method m, MethodAccess ma |
      m.hasName("createQuery") or m.hasName("createSQLQuery") and
      m.getDeclaringType().hasQualifiedName("org.hibernate", "Session") and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class StaticStringSanitizer extends DataFlow::ExprNode {
  StaticStringSanitizer() {
    this.asExpr() instanceof StringLiteral
  }
}

class InjectionConfig extends TaintTracking::Configuration {
  InjectionConfig() { this = "InjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringConcatSource or
    source instanceof StringFormatSource or
    source instanceof SqlParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlRestrictionSink or
    sink instanceof SessionMethodSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticStringSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(ExprAssign assign |
      node1.asExpr() = assign.getRHS() and
      node2.asExpr() = assign.getLHS()
    ) or
    exists(Method m, Parameter p, MethodAccess ma, int i |
      node1.asExpr() = ma.getArgument(i) and
      node2.asParameter() = m.getParameter(i) and
      m = ma.getMethod() and
      p = m.getParameter(i)
    )
  }
}

from InjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink) and
      not exists(DataFlow::Node sanitized |
        sanitized instanceof StaticStringSanitizer and
        cfg.hasFlowPath(source, sanitized)
      )
select sink, source, sink,
  "Detected a formatted string in a SQL statement. This could lead to SQL injection."
