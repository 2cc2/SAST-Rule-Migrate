/**
 * @name DefaultHttpClient is deprecated
 * @kind problem
 * @id java/defaulthttpclient-is-deprecated
 * @security-severity 8.8
 * @precision high
 * @tags security
 *       deprecated
 */

import java

// Source: DefaultHttpClient constructor call
class DefaultHttpClientConstructor extends MethodAccess {
  DefaultHttpClientConstructor() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("org.apache.http.impl.client", "DefaultHttpClient") and
      m.isConstructor() and
      this.getMethod() = m
    )
  }
}

// Sink: Any method call on DefaultHttpClient
class DefaultHttpClientMethodCall extends MethodAccess {
  DefaultHttpClientMethodCall() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("org.apache.http.impl.client", "DefaultHttpClient") and
      !m.isConstructor() and
      this.getMethod() = m
    )
  }
}

from DefaultHttpClientConstructor source, DefaultHttpClientMethodCall sink
where sink.getEnclosingCallable() = source.getEnclosingCallable()
select sink, 
  "DefaultHttpClient is deprecated and poses security risks due to lack of TLS1.2 support. Use HttpClientBuilder instead."
