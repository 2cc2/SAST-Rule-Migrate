/**
 * @name JDBC SQL Injection
 * @description Detected potential SQL injection vulnerability due to string concatenation
 *              or formatting in SQL statements. Use prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.JDBCCalls

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(Method method, MethodAccess call |
      method.hasName("format") and
      method.getDeclaringType().hasQualifiedName("java.lang", "String") and
      call.getMethod() = method and
      this.asExpr() = call
    )
  }
}

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(Variable v, BinaryExpr add |
      v.getInitializer() = add and
      v.getType().hasName("String") and
      add instanceof BinaryAddExpr and
      this.asExpr() = add
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess call |
      JDBCCalls::isExecuteMethod(call.getMethod()) and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess call |
      call.getMethod().getName() = "prepareStatement" and
      call.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Connection") and
      sanitizer.asExpr() = call
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SqlInjectionConfig config
where config.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization",
  source, sink,
  "Potential SQL injection vulnerability due to string formatting or concatenation in SQL statement."
