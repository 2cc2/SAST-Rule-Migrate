Rule Content:
/**
 * @name JDBC SQL Injection
 * @description Detected potential SQL injection vulnerability due to string concatenation
 *              or formatting in SQL statements. Use prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jdbc.Jdbc

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma
    )
  }
}

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(Variable v, Expr init |
      init = v.getInitializer() and
      v.getType().getName() = "String" and
      exists(AddExpr add |
        add = init and
        init instanceof AddExpr and
        this.asExpr() = add
      )
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      Jdbc::isStatementExecuteMethod(ma.getMethod()) and
