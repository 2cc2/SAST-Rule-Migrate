/**
 * @name JDBC SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables
 *              in the SQL statement are not properly sanitized. Use prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringExtensions

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(Method m, MethodAccess ma |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(Variable v, Expr init, BinaryExpr add |
      v.getInitializer() = init and
      v.getType().hasName("String") and
      init = add and
      add instanceof AddExpr and
      this.asExpr() = add
    )
  }
}

class JdbcStatementExecute extends DataFlow::Node {
  JdbcStatementExecute() {
    exists(Method m, MethodAccess ma |
      (m.hasName("executeQuery") or
       m.hasName("execute") or
       m.hasName("executeUpdate") or
       m.hasName("executeLargeUpdate") or
       m.hasName("addBatch") or
       m.hasName("nativeSQL")) and
      m.getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(Method m, MethodAccess ma |
      m.hasName("prepareStatement") and
      m.getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class SqlInjectionTaintTracking extends TaintTracking::Configuration {
  SqlInjectionTaintTracking() {
    this = "SqlInjectionTaintTracking"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JdbcStatementExecute
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

from SqlInjectionTaintTracking cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches SQL execution without sanitization",
  source.getNode(), sink.getNode(),
  "Potential SQL injection vulnerability due to string formatting or concatenation in SQL statement."
