/**
 * @name JDBC SQL Injection
 * @description Detects a formatted string in a SQL statement without prepared statement sanitization
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringOperators

class SqlFormatSource extends DataFlow::ExprNode {
  SqlFormatSource() {
    exists(Method m, MethodAccess ma |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class SqlConcatSource extends DataFlow::ExprNode {
  SqlConcatSource() {
    exists(AssignmentExpr assign |
      assign.getRight().toString().regexpMatch("String \\w+ = .*\\+.*") and
      this.asExpr() = assign.getRight()
    )
  }
}

class SqlSink extends DataFlow::ExprNode {
  SqlSink() {
    exists(Method m, MethodAccess ma |
      m.getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      m.hasName(["executeQuery", "execute", "executeUpdate", "executeLargeUpdate", "addBatch", "nativeSQL"]) and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(Method m, MethodAccess ma |
      m.getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      m.hasName("prepareStatement") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class SQLInjectionConfig extends TaintTracking::Configuration {
  SQLInjectionConfig() { this = "SQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlFormatSource or source instanceof SqlConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof PreparedStatementSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SQLInjectionConfig config
where config.hasFlowPath(source, sink)
select sink, "User input reaches SQL execution without prepared statement sanitization",
  source, sink, "$@ flows to here without sanitization.", source.getNode(), 
  "User-provided value"
