Rule Content:
/**
 * @name JDBC SQL Injection
 * @description Detects a formatted string in a SQL statement without prepared statement sanitization
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat

class SQLInjectionConfig extends TaintTracking::Configuration {
  SQLInjectionConfig() { this = "SQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma | 
      (ma.getMethod().hasName("format") and 
       ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String"))
      and source.asExpr() = ma
    )
    or
    exists(Assignment assign |
      assign.getRight().toString().matches("%String %SQL = %x + %y%") and
      source.asExpr() = assign.getRight()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      ma.getMethod().getName() in ["executeQuery", "execute", "executeUpdate", 
                                  "executeLargeUpdate", "addBatch", "nativeSQL"] and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      ma.getMethod().hasName("prepareStatement") and
      node.asExpr() = ma
    )
  }

  override predicate isBarrier(DataFlow::Node node) {
    exists(StringLiteral sl |
      sl.getValue().matches("SELECT%") or
      sl.getValue().matches("INSERT%") or
      sl.getValue().matches("UPDATE%") or
      sl.getValue().matches("DELETE%") and
      node.asExpr() = sl
    )
  }
}

from SQLInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input reaches SQL execution without prepared statement sanitization"
