Rule Content:
/**
 * @name Insecure XSSRequestWrapper Implementation
 * @description Detects insecure implementations of XSSRequestWrapper from dzone that lack proper XSS filtering
 * @kind path-problem
 * @problem.severity warning
 * @id java/xssrequestwrapper-is-insecure
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

predicate isXSSRequestWrapper(Class c) {
  exists(c.getASupertype() | 
    c.getASupertype().hasQualifiedName("javax.servlet.http", "HttpServletRequestWrapper") and
    c.getName().matches("XSSRequestWrapper")
  )
}

predicate hasUnsafeXSSFilter(Expr e) {
  e instanceof MethodAccess and
  e.getMethod().getName() = "compile" and
  exists(MethodAccess ma | 
    ma.getArgument(0).toString().matches("\"</script>\"") and
    ma.getArgument(1).toString().matches(".*CASE_INSENSITIVE.*")
  )
}

predicate isXSSTaintSource(DataFlow::Node source) {
  exists(MethodAccess ma |
    ma.getMethod().hasQualifiedName("javax.servlet.http", "HttpServletRequest", "getParameter") and
    source.asExpr() = ma
  )
}

predicate isSafeSanitizer(DataFlow::Node sanitizer) {
  exists(MethodAccess ma |
    ma.getMethod().hasQualifiedName("org.apache.commons.lang", "StringEscapeUtils", "escapeHtml") and
    sanitizer.asExpr() = ma
  )
}

class XSSRequestWrapperFlowConfig extends TaintTracking::Configuration {
  XSSRequestWrapperFlowConfig() { this = "XSSRequestWrapperFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    isXSSTaintSource(source) or
    exists(Class c | isXSSRequestWrapper(c) and source.asExpr() instanceof ClassInstanceExpr)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("javax.servlet.http", "HttpServletRequest", "getParameter") and
      sink.asExpr() = ma
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    isSafeSanitizer(sanitizer)
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma | ma.getMethod().hasName("getParameter") and pred.asExpr() = ma.getQualifier())
  }
}

from XSSRequestWrapperFlowConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Insecure XSSRequestWrapper implementation detected. $@ flows here and may be vulnerable to XSS.",
  source.getNode(), "Potential XSS source"
