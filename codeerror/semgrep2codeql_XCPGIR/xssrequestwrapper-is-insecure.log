Rule Content:
/**
 * @name Insecure XSSRequestWrapper Implementation
 * @description Detects insecure implementations of XSSRequestWrapper from dzone that lack proper XSS filtering
 * @kind path-problem
 * @problem.severity warning
 * @id java/xssrequestwrapper-is-insecure
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

predicate isXSSRequestWrapper(Class c) {
  exists(Method m | m = c.getConstructor() | 
    c.getASupertype().hasQualifiedName("javax.servlet.http", "HttpServletRequestWrapper") and
    c.getName().matches("XSSRequestWrapper%")
  )
}

predicate hasUnsafeXSSFilter(Expr e) {
  e.(MethodAccess).getMethod().getName() = "compile" and
  exists(MethodAccess ma | 
    ma.getArgument(0).toString() = "</script>" and
    ma.getArgument(1).toString().regexpMatch(".*CASE_INSENSITIVE.*")
  )
}

class XSSRequestWrapperConfig extends TaintTracking::Configuration {
  XSSRequestWrapperConfig() { this = "XSSRequestWrapperConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Class c |
      isXSSRequestWrapper(c) and
      source.asExpr() = c.getConstructor().getACall()
    ) or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "getParameter" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "getParameter" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      sink.asExpr() = ma
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "escapeHtml" and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.lang", "StringEscapeUtils") and
      sanitizer.asExpr() = ma
    )
  }
}

from XSSRequestWrapperConfig cfg, DataFlow::PathNode source, DataFlow::Node sink
where cfg.hasFlowPath(source, sink)
select sink, "Insecure XSSRequestWrapper implementation detected. Potential XSS vulnerability due to insufficient filtering.",
  source.getNode(), "Source of potentially unsafe input"
