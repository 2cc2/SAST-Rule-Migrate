/**
 * @name Insecure XSSRequestWrapper Implementation
 * @description Detects insecure implementations of XSSRequestWrapper from dzone that lack proper XSS filtering
 * @kind problem
 * @problem.severity warning
 * @id java/xssrequestwrapper-is-insecure
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.frameworks.HttpServlets
import semmle.code.java.security.XSS

predicate isXSSRequestWrapper(Class c) {
  exists(c.getASupertype() | 
    c.getASupertype().hasQualifiedName("javax.servlet.http", "HttpServletRequestWrapper") and
    c.getName().matches("XSSRequestWrapper")
  )
}

predicate hasUnsafeXSSFilter(Method m) {
  m.getName() = "compile" and
  m.getDeclaringType().getSourceDeclaration().getName().matches("Pattern") and
  exists(MethodAccess ma |
    ma.getMethod() = m and
    ma.getArgument(0).toString().matches("\"</script>\"") and
    ma.getArgument(1).toString().matches(".*CASE_INSENSITIVE.*")
  )
}

from Class c, Method unsafeFilter
where 
  isXSSRequestWrapper(c) or
  hasUnsafeXSSFilter(unsafeFilter)
select c, "Insecure XSSRequestWrapper implementation detected. $@ may be vulnerable to XSS attacks due to insufficient filtering.",
  c.getName(), "Potentially vulnerable XSSRequestWrapper implementation"
