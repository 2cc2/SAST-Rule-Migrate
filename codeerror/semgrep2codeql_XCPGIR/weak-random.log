/**
 * @name Weak Random Number Generator Detection
 * @description Detects usage of non-cryptographically strong random number generators
 * @kind problem
 * @problem.severity warning
 * @id java/weak-random
 * @tags security
 */

import java

predicate isWeakRandomCall(MethodAccess ma) {
  exists(Method m | 
    (ma.getMethod() = m and 
     m.getDeclaringType().hasQualifiedName("java.util", "Random") and
     ma.getUnknownPrimaryQlClass() instanceof MethodAccess)
    or
    (ma.getMethod() = m and
     m.getDeclaringType().hasQualifiedName("java.lang", "Math") and
     m.hasName("random"))
  )
}

from MethodAccess ma
where isWeakRandomCall(ma)
select ma, "Non-cryptographic RNG usage detected: " + ma.getMethod().getName() + 
  ". Use java.security.SecureRandom instead for passwords or secret tokens."
