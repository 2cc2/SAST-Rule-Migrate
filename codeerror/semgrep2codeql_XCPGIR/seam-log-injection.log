      node: CALL
      where:
        - op: eq
          left: api.type
          right: "*ServletRequest"
          method: getParameter

sinks:
  - id: SEAM_LOG
    match:
      node: CALL
      api: { package: org.jboss.seam.log, type: Log, method: $INFO }
      where:
        - op: regex
          left: api.method
          right: (debug|error|fatal|info|trace|warn)

propagations:
  - id: ARG_TO_RETURN
    edge: arg->return
    kind: taint
  - id: STRING_CONCAT
    edge: arg->call
    kind: taint

flows:
  - source: USER_INPUT
    sink: SEAM_LOG
    through: [ARG_TO_RETURN*, STRING_CONCAT*]

report:
  message: "Potential expression language injection in Seam Logging API"
  locations: ["source","sink","path"]
  evidence: { capture: [{ argument: 0 }] }

metadata:
  cwe: "CWE-95: Improper Neutralization of Directives in Dynamically Evaluated Code ('Eval Injection')"
