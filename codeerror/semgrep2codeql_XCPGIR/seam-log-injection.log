 *       external/cwe/cwe-95
 *       owasp-a03
 *       jboss
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.web.HttpRequest

class SeamLoggingMethod extends Method {
  SeamLoggingMethod() {
    this.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
    this.getName().matches("debug|error|fatal|info|trace|warn")
  }
}

class ServletRequestSource extends DataFlow::ExprNode {
  ServletRequestSource() {
    exists(Method m |
      m.getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet", "ServletRequest") and
      m.getName() = "getParameter" and
      this.asExpr() = m.getACall()
    )
  }
}

class SeamLogConfig extends TaintTracking::Configuration {
  SeamLogConfig() { this = "SeamLogInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod() instanceof SeamLoggingMethod and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagate taint through method returns
    exists(Method m, DataFlow::ParameterNode pn, DataFlow::ReturnNode rn |
      m.getAParameter() = pn.getParameter() and
      rn.getMethod() = m and
      node1.asExpr() = pn.asExpr() and
      node2.asExpr() = rn.asExpr()
    )
    or
    // Propagate taint through string concatenation
    exists(AddExpr add |
      add.getAnOperand() = node1.asExpr() and
      add = node2.asExpr() and
      add.getType() instanceof TypeString
    )
  }
}

