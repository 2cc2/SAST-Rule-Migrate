Rule Content:
/**
 * @name Seam Log Injection
 * @description Detects potential log injection vulnerabilities in JBoss Seam logging API
 * @kind path-problem
 * @problem.severity error
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class SeamLogInjectionConfig extends TaintTracking::Configuration {
  SeamLogInjectionConfig() { this = "SeamLogInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p 
      and not p.getCallable().getParameterDefaultValue(p.getIndex()).getStringValue() = ""
    )
    or
    exists(Field f | source.asField() = f 
      and not f.getVariable().getInitializer().getStringValue() = ""
    )
    or
    exists(LocalVariableDecl l | source.asLocalVariable() = l 
      and not l.getInitializer().getStringValue() = ""
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      ma.getMethod().getId().matches("debug|error|fatal|info|trace|warn") and
      sink.asExpr() = ma.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SeamLogInjectionConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Seam Log Injection detected. Untrusted input from $@ flows into log statement.",
  source.getNode(), "user input"
