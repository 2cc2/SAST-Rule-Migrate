/**
 * @name Seam Log Injection
 * @description Detects potential expression language injection in Seam Logging API
 * @kind path-problem
 * @problem.severity error
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-95
 *       owasp-a03
 *       jboss
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.ServletRequest

class SeamLogMethod extends Method {
  SeamLogMethod() {
    this.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
    this.getName().matches("debug|error|fatal|info|trace|warn")
  }
}

class ServletRequestParamSource extends DataFlow::Node {
  ServletRequestParamSource() { 
    exists(Method m | 
      m.getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet", "ServletRequest") and
      m.getName() = "getParameter" and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
  }
}

class SeamLogInjectionConfig extends TaintTracking::Configuration {
  SeamLogInjectionConfig() { this = "SeamLogInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod() instanceof SeamLogMethod and
      ma.getArgument(0) = sink.asExpr()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagate taint through method returns
    exists(Method m, Parameter p, DataFlow::Node ret |
      m.getAParameter() = p and
      ret.asExpr() = m.getAReturnStmt().getResult() and
      node1.asExpr() = p.getAnAccess() and
      node2 = ret
    )
    or
    // Propagate taint through string concatenation
    exists(AddExpr add |
      add.getAnOperand() = node1.asExpr() and
      add = node2.asExpr() and
      add.getType() instanceof TypeString
    )
  }
}

