/**
 * @name Seam Log Injection
 * @description Seam Logging API supports expression language which can lead to 
 *              unwanted code execution via dynamic values in log messages
 * @kind problem
 * @problem.severity error
 * @security-severity 9.0
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow

class SeamLogSink extends Expr {
  SeamLogSink() {
    exists(Method m, MethodAccess ma |
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      m.getName().matches("debug|error|fatal|info|trace|warn") and
      ma.getMethod() = m and
      this = ma.getArgument(0)
    )
  }
}

class SeamLogTaintConfig extends TaintTracking::Configuration {
  SeamLogTaintConfig() { this = "SeamLogTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      ma.getMethod().getName().matches("debug|error|fatal|info|trace|warn") and
      source.asExpr() = ma.getArgument(0) and
      not ma.getArgument(0).isConstant()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.getType() instanceof SeamLogSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(BinaryExpr be |
      be.getOp() = "+" and
      (
        (node1.asExpr() = be.getLeftOperand() and node2.asExpr() = be) or
        (node1.asExpr() = be.getRightOperand() and node2.asExpr() = be)
      )
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SeamLogTaintConfig cfg
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  source, sink, 
  "Seam Logging API expression language evaluates dynamic value which could lead to code execution"
