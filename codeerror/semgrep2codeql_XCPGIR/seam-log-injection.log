/**
 * @name Seam Log Injection
 * @description Detects potential expression language injection in Seam Logging API
 * @kind problem
 * @problem.severity error
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-95
 *       owasp-a03
 *       jboss
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.J2EE

class SeamLoggingCall extends MethodAccess {
  SeamLoggingCall() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      this.getMethod() = m and
      m.getName().matches("debug|error|fatal|info|trace|warn")
    )
  }

  // The logged message is the first argument
  Expr getLoggedMessage() { result = this.getArgument(0) }
}

class ServletRequestParamSource extends RemoteFlowSource {
  ServletRequestParamSource() {
    exists(Method m | 
      m.getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet", "ServletRequest") and
      m.getName() = "getParameter" and
      this.asExpr() = m.getACall()
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "SeamLogInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof ServletRequestParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SeamLoggingCall call |
      call.getLoggedMessage() = sink.asExpr()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagate taint through arguments to return values
    exists(Method m | m.getAParamType() = node1.getType() and m.getReturnType() = node2.getType() |
      node2.asExpr() = m.getReturn() and
      node1.asExpr() = m.getAParam()
    )
    or
    // Propagate taint through string concatenation
    exists(AddExpr add | add.getAnOperand() = node1.asExpr() and add = node2.asExpr())
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential expression language injection in Seam Logging API. User input flows into log message.",
  source.getNode(), sink.getNode(),
  "User input from $@ flows into log message", source.getNode(), source.toString()
