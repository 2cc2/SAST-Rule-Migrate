/**
 * @name Seam Log Injection
 * @description Seam Logging API supports expression language which may lead to code injection when dynamic values are used without validation.
 * @kind path-problem
 * @problem.severity error
 * @id java/thread-safety/seam-log-injection
 * @tags security
 *       external/jboss
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class LogCall extends MethodAccess {
  LogCall() {
    exists(Method m |
      m.getDeclaringType().getQualifiedName() = "org.jboss.seam.log.Log" and
      m.getName().matches("%debug|error|fatal|info|trace|warn%") and
      this.getMethod() = m
    )
  }
}

class SeamLogInjectionConfiguration extends TaintTracking::Configuration {
  SeamLogInjectionConfiguration() { this = "SeamLogInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(Literal l | l = source.asExpr() and not l.getStringValue().isConstant()) or
    exists(Identifier i | i = source.asExpr())
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma instanceof LogCall and
      ma.getArgument(0) = sink.asExpr()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodCall mc |
      mc.getArgument(0) = node1.asExpr() and
      node2.asExpr() = mc
    )
  }
}

