Rule Content:
/**
 * @name Seam Log Expression Language Injection
 * @description Detects potential Expression Language injection in Seam logging API calls.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Seam

class SeamLogExprInjectionConfig extends TaintTracking::Configuration {
  SeamLogExprInjectionConfig() { this = "SeamLogExprInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Literal l | 
      source.asExpr() = l and 
      not l instanceof StringLiteral
    )
    or
    exists(Identifier i |
      source.asExpr() = i
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType() instanceof JBossSeamLog and
      ma.getMethod().getName().matches("debug|error|fatal|info|trace|warn") and
      sink.asExpr() = ma
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::BinaryExpr bin |
      bin.getOp() instanceof Concat and
      (bin.getLeftOperand(), bin.getRightOperand()) = (node1.asExpr(), node2.asExpr()) or
      (node1.asExpr(), node2.asExpr()) = (bin.getRightOperand(), bin.getLeftOperand())
    )
  }
}

from SeamLogExprInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential EL injection in Seam logging. Untrusted data flows to log expression."
