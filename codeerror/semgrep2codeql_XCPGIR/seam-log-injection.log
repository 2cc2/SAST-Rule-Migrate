/**
 * @name Seam Log Expression Language Injection
 * @description Detects potential Expression Language injection in Seam logging API calls.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.JBossSeam

class SeamLogExprInjectionConfig extends TaintTracking::Configuration {
  SeamLogExprInjectionConfig() { this = "SeamLogExprInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Literal l | 
      source.asExpr() = l and 
      not l instanceof StringLiteral
    )
    or
    exists(IdentifierExpr i |
      source.asExpr() = i
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      ma.getMethod().getName().matches("debug|error|fatal|info|trace|warn") and
      sink.asExpr() = ma
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(AddExpr add |
      add.getOp() = ADD and
      (node1.asExpr() = add.getLeftOperand() and node2.asExpr() = add.getRightOperand() or
       node1.asExpr() = add.getRightOperand() and node2.asExpr() = add.getLeftOperand())
    )
  }
}

