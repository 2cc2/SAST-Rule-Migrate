/**
 * @name Seam Log Injection
 * @description Seam Logging API supports expression language which can lead to 
 *              unwanted code execution via dynamic values in log messages
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.0
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class SeamLogSink extends MethodAccess {
  SeamLogSink() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      m.getName().matches("debug|error|fatal|info|trace|warn") and
      this.getMethod() = m
    )
  }
}

class SeamLogTaintConfig extends TaintTracking::Configuration {
  SeamLogTaintConfig() { this = "SeamLogTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma | 
      ma instanceof SeamLogSink and
      source.asExpr() = ma.getArgument(0) and
      not ma.getArgument(0).isConstant()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SeamLogSink sls | 
      sink.asExpr() = sls.getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(BinaryExpr be | 
      be.getOp() instanceof AddOperator and
      (node1.asExpr() = be.getLeftOperand() and node2.asExpr() = be) or
      (node1.asExpr() = be.getRightOperand() and node2.asExpr() = be)
    )
  }
}

