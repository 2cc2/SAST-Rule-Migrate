Rule Content:
/**
 * @name java-jwt-hardcoded-secret
 * @description A hard-coded credential was detected. It is not recommended to store credentials 
 *              in source-code as this risks secrets being leaked.
 * @kind problem
 * @problem.severity warning
 * @id java/jwt-hardcoded-secret
 */

import java

// Source: Hardcoded credential used in JWT algorithm
class HardcodedSecret extends StringLiteral {
  HardcodedSecret() {
    exists(MethodAccess ma |
      ma.getMethod().getName() matches "HMAC(384|256|512)" and
      ma.getArgument(0) = this
    )
  }
}

// Sink: JWT Algorithm using the hardcoded secret
class JwtAlgorithm extends MethodAccess {
  JwtAlgorithm() {
    getMethod().getName() matches "HMAC(384|256|512)"
  }
}

// Data flow from hardcoded secret to JWT algorithm
query predicate flow(DataFlow::Node source, DataFlow::Node sink) {
  exists(DataFlow::PathNode path |
    path.getSource() = source and
    path.getSink() = sink and
    source instanceof HardcodedSecret and
    sink.asExpr() = any(JwtAlgorithm jwt).getArgument(0) and
    TaintTracking::localTaint(path, _)    
  )
}

from HardcodedSecret secret, JwtAlgorithm algo, DataFlow::PathNode path
where flow(secret, path.getSink())
select algo, "A hard-coded credential was detected in JWT algorithm.", 
      secret, "Hardcoded secret used here."
