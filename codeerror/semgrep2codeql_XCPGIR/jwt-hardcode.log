/**
 * @name java-jwt-hardcoded-secret
 * @description A hard-coded credential was detected. It is not recommended to store credentials in source-code,
 * as this risks secrets being leaked and used by either an internal or external malicious adversary.
 * It is recommended to use environment variables to securely provide credentials or retrieve credentials
 * from a secure vault or HSM (Hardware Security Module).
 * @kind problem
 * @problem.severity warning
 * @id java/jwt-hardcoded-secret
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringTemplate

class HardcodedSecret extends TaintTracking::Source {
  HardcodedSecret() {
    exists(StringLiteral l |
      l.getValue().regexpMatch(".*") and
      this.asExpr() = l
    )
  }
}

class JWTAlgorithm extends TaintTracking::Sink {
  JWTAlgorithm() {
    exists(Method m, MethodAccess ma |
      m.hasName(["HMAC256", "HMAC384", "HMAC512"]) and
      m.getDeclaringType().hasQualifiedName("com.auth0.jwt.algorithms", "Algorithm") and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class HardcodedSecretToJWTAlgorithm extends TaintTracking::Configuration {
  HardcodedSecretToJWTAlgorithm() { this = "HardcodedSecretToJWTAlgorithm" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof HardcodedSecret
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof JWTAlgorithm
  }
}

from HardcodedSecretToJWTAlgorithm cfg, TaintTracking::Source src, TaintTracking::Sink sink
where cfg.hasFlow(src, sink)
select sink, "A hard-coded credential is used in JWT algorithm. Consider using environment variables or secure vault."
