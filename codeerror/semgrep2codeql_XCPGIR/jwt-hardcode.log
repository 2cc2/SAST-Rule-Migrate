/**
 * @name java-jwt-hardcoded-secret
 * @description A hard-coded credential was detected. It is not recommended to store credentials in source-code,
 * as this risks secrets being leaked and used by either an internal or external malicious adversary.
 * It is recommended to use environment variables to securely provide credentials or retrieve credentials
 * from a secure vault or HSM (Hardware Security Module).
 * @kind problem
 * @problem.severity warning
 * @id java/jwt-hardcoded-secret
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringTemplate

class HardcodedSecret extends DataFlow::Node {
  HardcodedSecret() {
    exists(StringLiteral l |
      l.getValue().regexpMatch(".*") and
      this.asExpr() = l
    )
  }
}

class JWTAlgorithm extends DataFlow::Node {
  JWTAlgorithm() {
    exists(Method m, Call ma |
      m.hasName(["HMAC256", "HMAC384", "HMAC512"]) and
      m.getDeclaringType().hasQualifiedName("com.auth0.jwt.algorithms", "Algorithm") and
      ma.getCallee() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class DirectAssignment extends DataFlow::Configuration {
  DirectAssignment() { this = "DirectAssignment" }

  override predicate isSource(DataFlow::Node source) { true }

  override predicate isSink(DataFlow::Node sink) { true }

  override predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Variable v, DataFlow::ParameterNode p |
      node1.asExpr() = v.getAnAssignedValue() and
      node2.asExpr() = v.getAnAccess() and
      p.asParameter() = v.getAnAccess().getEnclosingCallable().getAParameter()
    )
  }
}

from HardcodedSecret source, JWTAlgorithm sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where exists(DirectAssignment conf |
  conf.hasFlowPath(sourceNode, sinkNode) and
  sourceNode.getNode() = source and
  sinkNode.getNode() = sink
)
select sink, "A hard-coded credential is used in JWT algorithm. Consider using environment variables or secure vault.",
  source, "Hard-coded secret here",
  sink, "JWT algorithm using hard-coded secret"
