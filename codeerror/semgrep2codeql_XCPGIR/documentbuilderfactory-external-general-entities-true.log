/**
 * @name DocumentBuilderFactory External General Entities True
 * @description Detects allowing external entities in DocumentBuilderFactory which is vulnerable to XXE attacks.
 * @kind problem
 * @problem.severity error
 * @id java/documentbuilderfactory-external-general-entities-true
 * @tags security
 */

import java

predicate isFeatureSetToTrue(MethodAccess ma) {
  ma.getMethod().hasName("setFeature") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
  ma.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-general-entities" and
  ma.getArgument(1).(BooleanLiteral).getValue() = true
}

from MethodAccess newInstanceCall, MethodAccess setFeatureCall
where
  newInstanceCall.getMethod().hasName("newInstance") and
  newInstanceCall.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
  isFeatureSetToTrue(setFeatureCall) and
  newInstanceCall.getEnclosingCallable() = setFeatureCall.getEnclosingCallable()
select setFeatureCall, 
  "External entities are allowed for DocumentBuilderFactory instance. This is vulnerable to XML external entity attacks. Disable this by setting the feature \"http://xml.org/sax/features/external-general-entities\" to false."
