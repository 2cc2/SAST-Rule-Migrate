/**
 * @name DocumentBuilderFactory External General Entities Enabled
 * @description Detects when DocumentBuilderFactory enables external general entities, which can lead to XXE vulnerabilities.
 * @kind problem
 * @id java/xxe/documentbuilderfactory-external-general-entities
 * @severity error
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isXXEConfig(Expr e) {
  exists(Method m, Literal featureName, Literal enableValue |
    m.hasName("setFeature") and
    e = m.getACall() and
    featureName = e.getArgument(0) and
    featureName.getValue() = "http://xml.org/sax/features/external-general-entities" and
    enableValue = e.getArgument(1) and
    enableValue.getValue().(boolean) = true
  )
}

from Expr config
where isXXEConfig(config)
select config, 
  "External entities are allowed for DocumentBuilderFactory. This is vulnerable to XML external entity attacks. Disable this by setting the feature \"http://xml.org/sax/features/external-general-entities\" to false."
