/**
 * @id spring-sqli
 * @kind path-problem
 * @name Potential SQL Injection in Spring JDBC
 * @description Detected a string argument from a public method contract in a raw SQL statement. 
 *              This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 * @severity Warning
 * @precision high
 * @tags security
 * @cwe CWE-89
 * @owasp A01:2017
 * @owasp A03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Spring.JdbcTemplate

class PublicStringParameter extends DataFlow::Node {
  PublicStringParameter() {
    exists(Method m, Parameter p |
      m.isPublic() and
      p = m.getAParameter() and
      p.getType().hasName("java.lang.String") and
      this.asParameter() = p
    )
  }
}

class JdbcTemplateCall extends DataFlow::Node {
  JdbcTemplateCall() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") or
       ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "PreparedStatementCreatorFactory") or
       ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "NamedParameterBatchUpdateUtils") or
       ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "BatchUpdateUtils")) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::BarrierGuard {
  override predicate checks(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      node.asExpr() = ma
    )
  }
}

class SpringSQLiConfig extends TaintTracking::Configuration {
  SpringSQLiConfig() { this = "Spring SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof PublicStringParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JdbcTemplateCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

