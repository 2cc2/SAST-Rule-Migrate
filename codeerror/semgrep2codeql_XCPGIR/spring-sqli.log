/**
 * @name Spring SQL Injection
 * @description Detected a string argument from a public method contract in a raw SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/spring-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.DataFlow

class PublicMethodStringParam extends UntrackedSource {
  PublicMethodStringParam() {
    exists(Method m, Parameter p |
      p = m.getAParameter() and
      p.getType() instanceof TypeString and
      m.isPublic()
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      // JDBC template methods
      (ma.getMethod().hasName(["query", "update", "batchUpdate"]) and
       ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")) or
      // Prepared statement creator
      (ma.getMethod().isConstructor() and
       ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "PreparedStatementCreatorFactory")) or
      // Batch update utilities
      (ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core.namedparam", "NamedParameterBatchUpdateUtils")) or
      (ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "BatchUpdateUtils"))
    )
  }
}

class SafeConstructor extends DataFlow::BarrierGuard {
  SafeConstructor() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasName(["PreparedStatement"])
    )
  }
}

class SpringSqlInjectionConfig extends TaintTracking::Configuration {
  SpringSqlInjectionConfig() { this = "SpringSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof PublicMethodStringParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeConstructor
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    DataFlow::parameterNode(pred, succ)
  }
}

from SpringSqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "SQL injection risk in " + sink.getNode().asExpr().(MethodAccess).getMethod().getSignature() +
  ", input from " + source.getNode().asParameter().getName(),
  source.getNode(), 
  sink.getNode()
