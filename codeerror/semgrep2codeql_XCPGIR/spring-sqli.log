Rule Content:
/**
 * @id spring-sqli
 * @kind path-problem
 * @name Potential SQL Injection in Spring JDBC
 * @description Detected a string argument from a public method contract in a raw SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 * @severity Warning
 * @precision high
 * @tags security
 * @cwe "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"
 * @owasp ["A01:2017 - Injection", "A03:2021 - Injection"]
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringJdbc

class PublicStringArg extends DataFlow::Node {
  PublicStringArg() {
    exists(Method m, Parameter p |
      m.isPublic() and
      p = m.getAParameter() and
      p.getType().hasName("java.lang.String") and
      this.asParameter() = p
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(Call call |
      (call.getCallee().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") or
       call.getCallee().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "PreparedStatementCreatorFactory") or
       call.getCallee().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "NamedParameterBatchUpdateUtils") or
       call.getCallee().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "BatchUpdateUtils")) and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends BarrierGuard {
  override predicate checks(DataFlow::Node node, BarrierGuardKind kind) {
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      node.asExpr() = call and
      kind = BarrierGuardKind::Sanitize
    )
  }
}

class SpringSqlInjectionConfiguration extends TaintTracking::Configuration {
  SpringSqlInjectionConfiguration() { this = "SpringSqlInjection" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof PublicStringArg
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.(BarrierGuard).checks(_, BarrierGuardKind::Sanitize)
  }
}

