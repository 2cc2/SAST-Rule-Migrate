```yaml
xcpgir_version: "1.0"
rule:
  id: spring-sqli
  kind: taint
  severity: WARNING
  message: |
    Detected a string argument from a public method contract in a raw SQL statement. This could lead to
    SQL injection if variables in the SQL statement are not properly sanitized.
    Use a prepared statements (java.sql.PreparedStatement) instead.
scope:
  languages: [java]
  frameworks: ["spring"]

sources:
  - id: PUBLIC_METHOD_STRING_PARAM
    match:
      node: PARAM
      type:
        name: java.lang.String
      where:
        - op: regex
          left: methodFullName
          right: "public.*"

sinks:
  - id: SQL_EXECUTION
    match:
      node: CALL
      pattern-either:
        - api: { type: org.springframework.jdbc.core.PreparedStatementCreatorFactory, method: "<init>" }
          arg_index: 0
        - api: { type: org.springframework.jdbc.core.JdbcTemplate }
          method: "query|update|batchUpdate"
          arg_index: 0
        - api: { type: org.springframework.jdbc.core.namedparam.NamedParameterBatchUpdateUtils }
        - api: { type: org.springframework.jdbc.core.BatchUpdateUtils }

sanitizers:
  - id: SAFE_CONSTRUCTOR
    match:
      node: CALL
      pattern: "new $TYPE(..., $A, ...)"
    effect: neutralize
    scope: { sinks: [SQL_EXECUTION] }

propagations:
  - id: PARAM_TO_ARG
    edge: arg->param
    kind: taint

flows:
  - source: PUBLIC_METHOD_STRING_PARAM
    sink: SQL_EXECUTION
    through: [PARAM_TO_ARG*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(.*PreparedStatement.*)" } ]

report:
  message: "SQL injection risk in ${sink.methodFullName}"
  locations: ["source", "sink"]
  evidence:
    capture:
      - source_arg: 0
      - sink_arg: 0

metadata:
  cwe: "CWE-89"
  owasp:
    - "A01:2017 - Injection"
    - "A03:2021 - Injection"
  category: security
  likelihood: MEDIUM
  impact: MEDIUM
  confidence: MEDIUM
```
