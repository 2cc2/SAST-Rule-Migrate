Rule Content:
/**
 * @name Spring SQL Injection
 * @description Detected a string argument from a public method contract in a raw SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/spring-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.Spring

class PublicMethodStringParam extends RemoteFlowSource::Range {
  PublicMethodStringParam() {
    exists(Method m, Parameter p |
      this.asParameter() = p and
      p.getType() instanceof TypeString and
      m.isPublic() and
      p = m.getAParameter()
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    // JdbcTemplate methods
    exists(MethodAccess ma |
      (ma.getMethod().hasName(["query", "update", "batchUpdate"]) and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")) and
      this.asExpr() = ma.getArgument(0)
    )
    or
    // PreparedStatementCreatorFactory constructor
    exists(NewExpr ne |
      ne.getConstructor().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "PreparedStatementCreatorFactory") and
      this.asExpr() = ne.getArgument(0)
    )
    or
    // Batch update utilities
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core.namedparam", "NamedParameterBatchUpdateUtils") or
       ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "BatchUpdateUtils")) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SafeConstructor extends DataFlow::GuardNode {
  SafeConstructor() {
    exists(NewExpr ne |
      ne.getConstructor().getDeclaringType().getName().matches("%PreparedStatement%") and
      this.asExpr() = ne
    )
  }
}

class SpringSqlInjectionConfig extends TaintTracking::Configuration {
  SpringSqlInjectionConfig() { this = "SpringSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof PublicMethodStringParam }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecutionSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof SafeConstructor }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Parameter p | pred.asParameter() = p | succ.asParameter().getAnAccess() = p)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SpringSqlInjectionConfig config
where config.hasFlowPath(source, sink)
select sink, 
  "SQL injection risk in " + sink.getNode().asExpr().toString() +
  ". Input from public method parameter: " + source.getNode().toString(),
  source, sink
