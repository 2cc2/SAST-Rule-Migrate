Rule Content:
/**
 * @id spring-sqli
 * @kind path-problem
 * @name Potential SQL Injection in Spring JDBC
 * @description Detected a string argument from a public method contract in a raw SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 * @severity Warning
 * @precision high
 * @tags security
 * @cwe "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"
 * @owasp ["A01:2017 - Injection", "A03:2021 - Injection"]
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringJdbc

class PublicStringArg extends DataFlow::Node {
  PublicStringArg() {
    exists(Method m, Parameter p |
      m.isPublic() and
      p = m.getAParameter() and
      p.getType().hasName("java.lang.String") and
      this.asParameter() = p
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().getQualifiedName() matches "org.springframework.jdbc.core.JdbcTemplate" or
       ma.getMethod().getDeclaringType().getQualifiedName() matches "org.springframework.jdbc.core.PreparedStatementCreatorFactory" or
       ma.getMethod().getDeclaringType().getQualifiedName() matches "org.springframework.jdbc.core.NamedParameterBatchUpdateUtils" or
       ma.getMethod().getDeclaringType().getQualifiedName() matches "org.springframework.jdbc.core.BatchUpdateUtils") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      this.asExpr() = ma
    )
  }
}

class SpringSqlInjectionConfiguration extends TaintTracking::Configuration {
  SpringSqlInjectionConfiguration() { this = "SpringSqlInjection" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof PublicStringArg
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

from SpringSqlInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches SQL execution without sanitization. $@", 
  source.getNode(),
  "Potential SQL injection source here"
