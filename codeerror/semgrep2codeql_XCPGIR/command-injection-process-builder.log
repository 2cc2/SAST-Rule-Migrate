import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class ProcessBuilderSink extends DataFlow::Node {
  ProcessBuilderSink() {
    exists(MethodCall mc |
      mc.getMethod().hasQualifiedName("java.lang", "ProcessBuilder", "<init>") and
      mc.getArgument(0) = this.asExpr()
    )
    or
    exists(MethodCall mc |
      mc.getMethod().hasQualifiedName("java.lang", "ProcessBuilder", "command") and
      mc.getArgument(0) = this.asExpr()
