Rule Content:
/**
 * @name Command injection via ProcessBuilder
 * @description Detects command injection vulnerabilities when user-controlled input is passed
 *              to ProcessBuilder constructors or command() methods without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.ProcessBuilder

class ProcessBuilderCommandInjectionConfig extends TaintTracking::Configuration {
  ProcessBuilderCommandInjectionConfig() { this = "ProcessBuilderCommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p, LocalVariableDecl v |
      source.asParameter() = p or
      source.asLocalVariable() = v
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc, MethodAccess ma |
      (
        // Match ProcessBuilder constructor with array argument
        cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
        sink.asExpr() = cc.getArgument(0)
      )
      or
      (
        // Match ProcessBuilder.command() method
        ma.getMethod().hasQualifiedName("java.lang", "ProcessBuilder", "command") and
        sink.asExpr() = ma.getArgument(0)
      )
    )
  }

  // Define sanitizers (safe patterns)
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // String literals
    exists(StringLiteral sl | sanitizer.asExpr() = sl)
    or
    // Arrays.asList() calls
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.util", "Arrays", "asList") and
      sanitizer.asExpr() = ma
    )
    or
    // String array literals
    exists(ArrayInit ai | sanitizer.asExpr() = ai)
  }
}

