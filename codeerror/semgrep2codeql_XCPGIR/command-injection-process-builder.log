Rule Content:
/**
 * @name Command injection via ProcessBuilder
 * @description Detects when user-controlled input is used to construct ProcessBuilder commands,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class ProcessBuilderSource extends DataFlow::Node {
  ProcessBuilderSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getParameter") or
      ma.getMethod().hasName("getQueryString") or
      ma.getMethod().hasName("getHeader") or
      any(Method m | m = ma.getMethod() | m.isSource() and m.hasAnnotation())
      and
      ma.getASuccessor*() = this.asExpr()
    ) or
    exists(Parameter p | this.asParameter() = p and p.getAPredecessor*() instanceof RemoteFlowSource)
  }
}

class ProcessBuilderSink extends DataFlow::Node {
  ProcessBuilderSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      cc.getArgument(0) = this.asExpr()
    ) or
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.lang", "ProcessBuilder", "command") and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class ProcessBuilderSanitizer extends DataFlow::Node {
  ProcessBuilderSanitizer() {
    exists(StringLiteral sl | sl = this.asExpr()) or
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.util", "Arrays", "asList") and
      ma.getArgument(0).(StringLiteral).getValue().matches("\"[^\"]+\"") and
      ma.getASuccessor*() = this.asExpr()
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof ProcessBuilderSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof ProcessBuilderSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ProcessBuilderSanitizer
  }
}

from CommandInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "A formatted or concatenated string was detected as input to a ProcessBuilder call. " +
  "This is dangerous if a variable is controlled by user input and could result in a command injection."
