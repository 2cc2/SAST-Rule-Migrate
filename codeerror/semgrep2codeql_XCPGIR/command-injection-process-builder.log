/**
 * @name Command injection via ProcessBuilder
 * @description Detects when user-controlled input is used to construct ProcessBuilder commands,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.security.CommandInjectionQuery

class ProcessBuilderTaintConfig extends TaintTracking::Configuration {
  ProcessBuilderTaintConfig() { this = "ProcessBuilderTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource or
    exists(Parameter p | source.asParameter() = p)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (ma.getMethod().hasQualifiedName("java.lang", "ProcessBuilder", "<init>") or
       ma.getMethod().hasQualifiedName("java.lang", "ProcessBuilder", "command")) and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sanitizer.asExpr() = sl)
    or
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.util", "Arrays", "asList") and
      exists(StringLiteral sl | ma.getArgument(0) = sl and sl.getValue().matches("^\"[^\"]+\"$"))
    )
  }
}

