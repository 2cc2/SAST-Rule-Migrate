/**
 * @name Command injection via ProcessBuilder
 * @description Detects command injection vulnerabilities when user-controlled input 
 *              is passed to ProcessBuilder constructors or command() methods without
 *              proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.security.CommandInjection

class ProcessBuilderCommandInjectionConfig extends TaintTracking::Configuration {
  ProcessBuilderCommandInjectionConfig() { this = "ProcessBuilderCommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p) or
    exists(LocalVariable v | source.asVariable() = v)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc | 
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = cc.getArgument(0)
    )
    or
    exists(Method m | 
      m.hasQualifiedName("java.lang", "ProcessBuilder", "command") and
      exists(MethodAccess ma | ma.getMethod() = m and sink.asExpr() = ma.getArgument(0))
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sanitizer.asExpr() = sl)
    or
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.util", "Arrays", "asList") and
      sanitizer.asExpr() = ma
    )
    or
    exists(ArrayInit ai | sanitizer.asExpr() = ai)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ProcessBuilderCommandInjectionConfig conf
where conf.hasFlowPath(source, sink)
select sink, 
  "Potential command injection via ProcessBuilder with unvalidated input: " + sink.getNode().toString(),
  source, sink,
  "User input reaches ProcessBuilder command here"
