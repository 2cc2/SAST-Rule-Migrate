/**
 * @name Spring JSP Evaluation Injection
 * @description Detects Spring expression evaluation with potentially untrusted input
 * @kind problem
 * @problem.severity warning
 * @precision high
 * @id java/spring-jsp-eval
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import DataFlow::PathGraph
import semmle.code.java.frameworks.spring.SpringComponents

class JspDynamicValue extends Expr {
  JspDynamicValue() { this.toString().matches("<spring:eval.*expression=.*>") }
}

class EvalTagSink extends Method {
  EvalTagSink() {
    this.getDeclaringType().getQualifiedName() = "org.springframework.web.servlet.tags.EvalTag" and
    this.hasName("doEndTag")
  }
}

class SpringJspEvalConfig extends TaintTracking::Configuration {
  SpringJspEvalConfig() { this = "SpringJspEvalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof JspDynamicValue
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCallee() instanceof EvalTagSink and
      sink.asExpr() = call.getArgument(0)
    )
  }
}

from SpringJspEvalConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Spring expression evaluation with potentially untrusted input"
