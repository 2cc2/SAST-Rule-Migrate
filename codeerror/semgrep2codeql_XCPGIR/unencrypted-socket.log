/**
 * @name Unencrypted Socket Detection
 * @description Detected use of a Java socket that is not encrypted. Use SSLSocket instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/unencrypted-socket
 * @tags security
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.security.Sockets

predicate isInsecureSocket(Expr e) {
  exists(MethodAccess ma |
    ma.getMethod().getName() = "Socket" and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.net", "Socket")
  )
}

predicate isInsecureServerSocket(Expr e) {
  exists(MethodAccess ma |
    ma.getMethod().getName() = "ServerSocket" and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.net", "ServerSocket")
  )
}

from Expr socketCreation, DataFlow::Node source
where
  (isInsecureSocket(socketCreation) or isInsecureServerSocket(socketCreation)) and
  source.asExpr() = socketCreation
select socketCreation, "Use of unencrypted socket detected. Use SSLSocket created by SSLSocketFactory or SSLServerSocketFactory instead.",
source, "Socket created here"
