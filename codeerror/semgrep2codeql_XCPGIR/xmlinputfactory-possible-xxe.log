/**
 * @name XMLInputFactory possible XXE
 * @description XML external entities are not explicitly disabled for this XMLInputFactory.
 *              This could be vulnerable to XML external entity vulnerabilities.
 * @kind path-problem
 * @id java/xmlinputfactory-possible-xxe
 * @security-severity 8.0
 * @problem.severity warning
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.XML

class XMLInputFactoryCreation extends MethodAccess {
  XMLInputFactoryCreation() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      m.getName() = "newFactory" and
      this.getMethod() = m
    )
    or
    exists(Constructor c | 
      c.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      this.getConstructor() = c
    )
  }
}

class XXESink extends MethodAccess {
  XXESink() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      m.getName() = "setProperty" and
      this.getMethod() = m and
      not this.getArgument(1).(Literal).getValue().toString() = "false"
    )
  }
}

class DisableXXE extends MethodAccess {
  DisableXXE() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      m.getName() = "setProperty" and
      this.getMethod() = m and
      this.getArgument(1).(Literal).getValue().toString() = "false"
    )
  }
}

class XMLInputFactoryXXEConfig extends TaintTracking::Configuration {
  XMLInputFactoryXXEConfig() { this = "XMLInputFactoryXXE" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(XMLInputFactoryCreation creation |
      source.asExpr() = creation
    )
  }
  
  override predicate isSink(DataFlow::Node sink) {
    exists(XXESink s |
      sink.asExpr() = s
    )
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(DisableXXE d |
      sanitizer.asExpr() = d
    )
  }
}

from XMLInputFactoryXXEConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Missing XML external entity protection"
