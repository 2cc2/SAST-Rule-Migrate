/**
 * @name XMLInputFactory possible XXE
 * @description XML external entities are not explicitly disabled for this XMLInputFactory.
 *              This could be vulnerable to XML external entity vulnerabilities.
 * @kind path-problem
 * @id java/xmlinputfactory-possible-xxe
 * @security-severity 8.0
 * @problem.severity warning
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class XMLInputFactoryCreation extends DataFlow::Node {
  XMLInputFactoryCreation() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      m.getName() = "newFactory" and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getMethodCall()
    )
    or
    exists(Class cl | 
      cl.hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      this.asExpr() = any(ConstructorCall cc | cc.getConstructedType() = cl).getConstructorCall()
    )
  }
}

class XXESink extends DataFlow::Node {
  XXESink() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      m.getName() = "setProperty" and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getMethodCall() and
      not this.asExpr().getArgument(1).toString() = "false"
    )
  }
}

class DisableXXE extends DataFlow::Node {
  DisableXXE() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      m.getName() = "setProperty" and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getMethodCall() and
      this.asExpr().getArgument(1).toString() = "false"
    )
  }
}

class XMLInputFactoryXXEConfig extends TaintTracking::Configuration {
  XMLInputFactoryXXEConfig() { this = "XMLInputFactoryXXE" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof XMLInputFactoryCreation
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof XXESink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof DisableXXE
  }
}

from XMLInputFactoryXXEConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Missing XML external entity protection"
