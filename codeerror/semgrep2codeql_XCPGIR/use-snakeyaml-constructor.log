/**
 * @name Use SnakeYAML Constructor Safely
 * @description Detects usage of the no-argument SnakeYAML Yaml() constructor,
 *              which is vulnerable to deserialization attacks. Use the one-argument
 *              Yaml(...) constructor with SafeConstructor or a custom Constructor instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/use-snakeyaml-constructor
 */

import java
import semmle.code.java.dataflow.DataFlow

// Source: No-argument Yaml() constructor
predicate isUnsafeYamlConstructor(ConstructorCall call) {
  call.getConstructedType().hasQualifiedName("org.yaml.snakeyaml", "Yaml") and
  call.getNumberOfArguments() = 0
}

// Sink: Yaml.load() method call
predicate isYamlLoadMethodCall(Method method, Expr arg) {
  method.hasName("load") and
  method.getDeclaringType().hasQualifiedName("org.yaml.snakeyaml", "Yaml")
}

// Configuring data flow analysis
class UnsafeYamlConfig extends DataFlow::Configuration {
  UnsafeYamlConfig() { this = "UnsafeYamlConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(ConstructorCall call |
      call = source.asExpr() and
      isUnsafeYamlConstructor(call)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma, Method m |
      ma = sink.asExpr() and
      m = ma.getMethod() and
      isYamlLoadMethodCall(m, ma.getArgument(0))
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, UnsafeYamlConfig conf
where conf.hasFlowPath(source, sink)
select sink.getNode(),
  "Deserialization attack vulnerability detected. Used SnakeYAML org.yaml.snakeyaml.Yaml() " +
  "constructor with no arguments, which is vulnerable to deserialization attacks. Use " +
  "the one-argument Yaml(...) constructor instead, with SafeConstructor or a custom " +
  "Constructor as the argument.",
  source.getNode(), "Unsafe Yaml() constructor here"
