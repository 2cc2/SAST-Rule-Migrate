Rule Content:
/**
 * @name Use SnakeYAML Constructor Safely
 * @description Detects usage of the no-argument SnakeYAML Yaml() constructor,
 *              which is vulnerable to deserialization attacks. Use the one-argument
 *              Yaml(...) constructor with SafeConstructor or a custom Constructor instead.
 * @kind problem
 * @problem.severity warning
 * @id java/use-snakeyaml-constructor
 */

import java

// Source: No-argument Yaml() constructor
predicate isUnsafeYamlConstructor(ConstructorCall call) {
  call.getConstructedType().hasQualifiedName("org.yaml.snakeyaml", "Yaml") and
  call.getNumberOfArguments() = 0
}

// Sink: Yaml.load() method call
predicate isYamlLoadMethodCall(MethodAccess access) {
  exists(Method m |
    m = access.getMethod() and
    m.hasName("load") and
    m.getDeclaringType().hasQualifiedName("org.yaml.snakeyaml", "Yaml")
  )
}

// Flow: From unsafe constructor to load() call via receiver object
predicate flowFromSourceToSink(DataFlow::PathNode source, DataFlow::PathNode sink) {
  exists(ConstructorCall unsafeYaml, MethodAccess yamlLoad |
    unsafeYaml = source.asExpr() and
    isUnsafeYamlConstructor(unsafeYaml) and
    yamlLoad = sink.asExpr() and
    isYamlLoadMethodCall(yamlLoad) and
    DataFlow::localFlow(source, sink) and
    unsafeYaml.getQualifier() = yamlLoad.getQualifier()
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where flowFromSourceToSink(source, sink)
select sink.getNode(), 
  "Deserialization attack vulnerability detected. Used SnakeYAML org.yaml.snakeyaml.Yaml() " +
  "constructor with no arguments, which is vulnerable to deserialization attacks. Use " +
  "the one-argument Yaml(...) constructor instead, with SafeConstructor or a custom " +
  "Constructor as the argument.", source.getNode(), "Unsafe Yaml() constructor here"
