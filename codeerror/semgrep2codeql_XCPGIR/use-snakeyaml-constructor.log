/**
 * @name Insecure SnakeYAML Constructor Usage
 * @description Detects usage of SnakeYAML's no-argument Yaml() constructor which is vulnerable to deserialization attacks
 * @kind path-problem
 * @id java/use-snakeyaml-constructor
 * @security-severity 8.5
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-502
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow

class YamlNoArgConstructor extends Expr {
  YamlNoArgConstructor() {
    exists(Method m, Call call |
      m.getDeclaringType().hasQualifiedName("org.yaml.snakeyaml", "Yaml") and
      m.getName() = "<init>" and
      m.getNumberOfParameters() = 0 and
      call = m.getACall() and
      this = call
    )
  }
}

class YamlLoadMethodAccess extends DataFlow::MethodCallNode {
  YamlLoadMethodAccess() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("org.yaml.snakeyaml", "Yaml") and
      m.getName() = "load" and
      this.getTarget() = m
    )
  }
}

class YamlUsageConfig extends TaintTracking::Configuration {
  YamlUsageConfig() {
    this = "SnakeYAML insecure constructor usage"
  }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof YamlNoArgConstructor
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(YamlLoadMethodAccess yl |
      sink.asExpr() = yl.getQualifier()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, YamlUsageConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Insecure SnakeYAML constructor usage detected. Yaml() constructor with no arguments is vulnerable to deserialization attacks. Use the one-argument Yaml(...) constructor with SafeConstructor or a custom Constructor."
