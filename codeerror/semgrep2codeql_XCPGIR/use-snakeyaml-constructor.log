Rule Content:
/**
 * @name Use SnakeYAML Constructor Safely
 * @description Detects usage of the no-argument SnakeYAML Yaml() constructor,
 *              which is vulnerable to deserialization attacks. Use the one-argument
 *              Yaml(...) constructor with SafeConstructor or a custom Constructor instead.
 * @kind problem
 * @problem.severity warning
 * @id java/use-snakeyaml-constructor
 */

import java
import semmle.code.java.dataflow.TaintTracking

class UnsafeYamlConstructor extends TaintTracking::Configuration {
  UnsafeYamlConstructor() { this = "UnsafeYamlConstructor" }

  override predicate isSource(DataFlow::Node source) {
    exists(ConstructorCall call |
      call.getConstructedType().hasQualifiedName("org.yaml.snakeyaml", "Yaml") and
      not call.getAnArgument().exists() // 替代getNumberOfArguments() = 0
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("load") and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.yaml.snakeyaml", "Yaml")
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(ConstructorCall call, MethodAccess ma |
      call = node1.asExpr() and
      ma = node2.asExpr() and
      call.getAChild*() = ma.getQualifier()
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, UnsafeYamlConfiguration config
where config.hasFlow(source, sink)
select sink,
  "Deserialization attack vulnerability detected. Used SnakeYAML org.yaml.snakeyaml.Yaml() " +
  "constructor with no arguments, which is vulnerable to deserialization attacks. Use " +
  "the one-argument Yaml(...) constructor instead, with SafeConstructor or a custom " +
  "Constructor as the argument.",
  source, "Unsafe Yaml() constructor here"
