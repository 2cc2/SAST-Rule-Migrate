Rule Content:
/**
 * @name Tainted SQL String
 * @kind problem
 * @id java/tainted-sql-string
 * @problem.severity error
 * @description Detected user input used to manually construct a SQL string. This is usually bad
 *              bad practice because manual construction could accidentally result in a SQL 
 *              injection. An attacker could use a SQL injection to steal or modify contents of
 *              the database. Instead, use a parameterized query which is available by default
 *              in most database engines. Alternatively, consider using an object-relational 
 *              mapper (ORM) such as Sequelize which will protect your queries.
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.aws.AWSLambda

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(MethodParameter p |
      p = this.asParameter() and
      exists(Class c |
        c.getASupertype*().hasQualifiedName("com.amazonaws.services.lambda.runtime", "RequestHandler") and
        (
          exists(Method m | m = p.getDeclaringMethod() and m.isHandler() and m.getDeclaringType() = c) or
          m.getName() != ""
        )
      )
    )
  }
}

class SqlConcatSink extends DataFlow::Node {
  SqlConcatSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "concat" and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) or
      (ma.getMethod().getName() = "format" and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) or
      exists(string s | s = this.asExpr().getStringValue() | s.regexpMatch(".*(?i)(select|insert|update|delete).*"))
    )
  }
}

class PrintlnBarrier extends BarrierGuard {
  PrintlnBarrier() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "println" and
      ma.getQualifier() = any(FieldRead fr | fr.getField().hasName("out") and
      fr.getQualifier().getType().hasQualifiedName("java.lang", "System"))
    )
  }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlString" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlConcatSink }

  override predicate isBarrier(DataFlow::Node barrier) { barrier instanceof PrintlnBarrier }
}

