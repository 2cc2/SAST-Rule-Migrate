      node: METHOD_PARAMETER_IN
      where:
        - op: regex
          left: name
          right: \$EVENT
        - op: or
          left:
            op: eq
            left: parentMethod.fullName
            right: "$HANDLER($TYPE, com.amazonaws.services.lambda.runtime.Context)"
          right:
            op: eq
            left: parentMethod.fullName
            right: "$HANDLER(InputStream, OutputStream, com.amazonaws.services.lambda.runtime.Context)"

sinks:
