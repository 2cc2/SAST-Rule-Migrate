Rule Content:
/**
 * @name tainted-sql-string
 * @id java/tainted-sql-string
 * @kind path-problem
 * @problem.severity error
 * @description User data flows into manually-constructed SQL string. Use prepared statements (`connection.PreparedStatement`) or a safe library instead.
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringController
import semmle.code.java.security.QueryInjection
import DataFlow::PathGraph

class SpringRequestSource extends TaintTracking::Source {
  SpringRequestSource() { 
    exists(Parameter p |
      p.getAnAnnotation().getType().getName().matches(
        "%(RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue)%"
      ) and
      not p.getType().hasName([
        "Integer", "Long", "Float", "Double", "Char", "Boolean",
        "int", "long", "float", "double", "char", "boolean"
      ])
    )
  }

  override string getSourceType() { result = "Spring request parameter" }
}

class SqlStringConstruction extends TaintTracking::Sink {
  SqlStringConstruction() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%(?i)(select|delete|insert|create|update|alter|drop)%") and
      (
        exists(AddExpr add | add.getAnOperand() = this.asExpr()) or
        exists(MethodAccess concat | 
          concat.getMethod().getName() = "concat" and 
          concat.getAnArgument() = this.asExpr()
        ) or
        exists(MethodAccess format |
          format.getMethod().getName() = "format" and
          format.getArgument(0) = this.asExpr()
        )
      )
    )
  }

  override string getSinkType() { result = "SQL string construction" }
}

class PreparedStatementSanitizer extends TaintTracking::Sanitizer {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("prepareStatement") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma
    )
  }
}

class LoggerBarrier extends TaintTracking::BarrierGuard {
  LoggerBarrier() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.slf4j", "Logger") and
      ma.getMethod().getName().matches("%(info|warn|warning|debug|debugging|error)%") and
      this.asExpr() = ma
    )
  }
}

class ThrowBarrier extends TaintTracking::BarrierGuard {
  ThrowBarrier() { this.getNode() instanceof ThrowStmt }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SpringRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlStringConstruction }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof LoggerBarrier or barrier instanceof ThrowBarrier
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSqlStringConfig config
where config.hasFlowPath(source, sink)
select sink, source, "Potential SQL injection vulnerability from $@ to unsafe SQL string construction",
  source, "user input", sink, "unsafe SQL construction"
