      where:
        - op: regex
          left: argument.value
          right: '(?i)(select|delete|insert|create|update|alter|drop)\b'

propagations:
  - id: ASSIGNMENT_PROP
    edge: assignment
    kind: taint
  - id: METHOD_ARG_PROP
    edge: arg->param
    kind: taint

flows:
  - source: LAMBDA_EVENT_PARAM
    sink: SQL_CONCAT
    through: [METHOD_ARG_PROP*, ASSIGNMENT_PROP*]
  - source: LAMBDA_EVENT_PARAM
    sink: SQL_STRING_BUILDER
    through: [METHOD_ARG_PROP*, ASSIGNMENT_PROP*]
  - source: LAMBDA_EVENT_PARAM
    sink: SQL_STRING_FORMAT
    through: [METHOD_ARG_PROP*, ASSIGNMENT_PROP*]

report:
  message: "Detected user input used to manually construct a SQL string."
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "String sql = \"SELECT * FROM users WHERE id = \" + event.getInput();"
  negative:
    - "String sql = \"SELECT * FROM users WHERE id = ?\";"
    - "PreparedStatement stmt = conn.prepareStatement(sql);"
