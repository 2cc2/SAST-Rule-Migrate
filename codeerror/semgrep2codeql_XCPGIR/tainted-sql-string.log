Rule Content:
/**
 * @id tainted-sql-string
 * @kind problem
 * @severity error
 * @description User data flows into manually-constructed SQL string. Use prepared statements (`connection.PreparedStatement`) or a safe library instead.
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringController

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, Parameter p | 
      source.asParameter() = p and
      hasSpringRequestAnnotation(p.getAnAnnotation()) and
      not isPrimitiveType(p.getType())
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      (
        ma.getAnArgument() = sink.asExpr() or
        sink.asExpr() instanceof StringConcat or
        sink.asExpr() instanceof StringBufferAppend or
        sink.asExpr() instanceof StringFormat
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      sanitizer.asExpr() = ma
    )
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    exists(MethodAccess ma |
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("org.slf4j", "Logger") and
        ma.getMethod().getName().matches("info|warn|warning|debug|debugging|error")
      ) or
      barrier.asExpr() instanceof ThrowStmt
    )
  }

  override bool propagatesTaint(DataFlow::Node pred, DataFlow::Node succ) {
    pred.asParameter() = succ.asParameter() // arg->param propagation
  }
}

predicate hasSpringRequestAnnotation(Annotation a) {
  a.getType().getName().matches("RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue")
}

from TaintedSqlStringConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Potential SQL injection vulnerability from $@ to $@.", source, sink.toString()
