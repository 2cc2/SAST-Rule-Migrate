scope:
  languages: [java]
  frameworks: ["aws-lambda"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: USER_INPUT
    match:
      node: PARAM
      where:
        - op: or
          conditions:
            - left: $HANDLERTYPE
              op: neq
              right: ""
            - left: $HANDLER
              op: isset

sinks:
  - id: SQL_CONCAT
    match:
      node: CALL
      where:
        - op: or
          conditions:
            - left: methodFullName
              op: eq
              right: "java.lang.String.concat"
            - left: methodFullName
              op: eq
              right: "java.lang.String.format"
    match:
      node: ASSIGNMENT
      where:
        - left: code
          op: contains
          right: "$SQLPATTERN"

sanitizers: []

barriers:
  - id: PRINTLN_BARRIER
    match:
      node: CALL
      api: { type: java.lang.System, method: out.println }
    effect: stop

propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint
  - id: STRING_BUILDER
    edge: arg->param
    kind: taint

flows:
  - source: USER_INPUT
    sink: SQL_CONCAT
    through: [STRING_CONCAT*, STRING_BUILDER*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(java.lang.System.out.println)" } ]

report:
  message: "Detected user input used to manually construct a SQL string"
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "String query = \"SELECT * FROM users WHERE id = \" + userInput;"
  negative:
    - "System.out.println(\"SELECT * FROM users WHERE id = \" + userInput);"
```
