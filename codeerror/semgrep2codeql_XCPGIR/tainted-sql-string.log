Rule Content:
/**
 * @name Tainted SQL string construction
 * @description Detected user input used to manually construct a SQL string.
 *              This is usually bad practice because manual construction could accidentally result in a SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class LambdaEventHandler extends Method {
  LambdaEventHandler() {
    (
      this.getDeclaringType().getASourceSupertype*().hasQualifiedName("com.amazonaws.services.lambda.runtime", 
        "RequestHandler") and
      (
        this.getName().matches("%HANDLER%") or
        this.getNumberOfParameters() = 2 and
        this.getParameter(1).getType().hasQualifiedName("com.amazonaws.services.lambda.runtime", "Context")
      ) or
      this.getNumberOfParameters() = 3 and
      this.getParameter(2).getType().hasQualifiedName("com.amazonaws.services.lambda.runtime", "Context")
    )
  }

  Parameter getEventParameter() {
    result = this.getAParameter() and
    result.getName().matches("%EVENT%")
  }
}

class SqlStringConcat extends DataFlow::ExprNode {
  SqlStringConcat() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "concat" and
      ma.getQualifier().toString() = "$SQLSTR" or
      ma.getMethod().getName() = "+" and
      ma.toString().matches("%\"$SQLSTR\"\\s*\\+%")
    )
  }
}

class SqlStringFormat extends DataFlow::ExprNode {
  SqlStringFormat() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      exists(string s | s = ma.getArgument(0).getStringValue() |
        s.regexpMatches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
      )
    )
  }
}

class SqlStringBuilder extends DataFlow::ExprNode {
  SqlStringBuilder() {
    exists(MethodAccess ma |
