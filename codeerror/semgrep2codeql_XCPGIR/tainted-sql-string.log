/**
 * @name Tainted SQL String
 * @kind path-problem
 * @id java/tainted-sql-string
 * @problem.severity error
 * @description Detected user input used to manually construct a SQL string. This is usually bad
 *              practice because manual construction could accidentally result in a SQL 
 *              injection. An attacker could use a SQL injection to steal or modify contents of
 *              the database. Instead, use a parameterized query which is available by default
 *              in most database engines. Alternatively, consider using an object-relational 
 *              mapper (ORM) such as Sequelize which will protect your queries.
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormatProcessors

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Method m, Parameter p |
      m = p.getDeclaringMethod() and
      p = this.asParameter() and
      (
        exists(Class c | 
          c.getASupertype*().hasQualifiedName("com.amazonaws.services.lambda.runtime", "RequestHandler") and
          m.getDeclaringType() = c
        )
        or
        m.getName() != ""
      )
    )
  }
}

class SqlConcatSink extends DataFlow::Node {
  SqlConcatSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "concat" and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) or
      (ma.getMethod().getName() = "format" and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String"))
    )
    or
    exists(LocalVariableAssignment lva |
      lva.getTarget() = this.asExpr() and
      lva.getSource().toString().matches("%(select|insert|update|delete)%")
    )
  }
}

class PrintlnBarrier extends DataFlow::BarrierGuard {
  PrintlnBarrier() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "println" and
      ma.getQualifier().(FieldRead).getField().hasName("out") and
      ma.getQualifier().(FieldRead).getQualifier().getType().hasQualifiedName("java.lang", "System")
    )
  }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlString" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlConcatSink }

  override predicate isBarrier(DataFlow::Node barrier) { barrier instanceof PrintlnBarrier }

  override predicate isExtension(DataFlow::Extension extension) {
    extension instanceof StringConcatExtension or
    extension instanceof StringBuilderExtension
  }
}

class StringConcatExtension extends DataFlow::Extension {
  StringConcatExtension() { this = "StringConcat" }

  override predicate propagate(DataFlow::Node source, DataFlow::Node dest) {
    exists(BinaryExpr be | 
      be.getOperator() = ADD and
      ((be.getRightOperand() = source.asExpr() and be.getLeftOperand() = dest.asExpr()) or
      (be.getLeftOperand() = source.asExpr() and be.getRightOperand() = dest.asExpr()))
    )
  }
}

class StringBuilderExtension extends DataFlow::Extension {
  StringBuilderExtension() { this = "StringBuilder" }

  override predicate propagate(DataFlow::Node source, DataFlow::Node dest) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%append%") and
      source.asExpr() = ma.getArgument(0) and
      dest.asExpr() = ma.getQualifier()
    )
  }
}

