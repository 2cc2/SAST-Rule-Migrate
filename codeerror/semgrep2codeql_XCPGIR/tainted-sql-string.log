/**
 * @name Tainted SQL string construction
 * @description Detected user input used to manually construct a SQL string.
 *              This is usually bad practice because manual construction could accidentally result in a SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import DataFlow::PathGraph

class LambdaHandlerPredicate extends Method {
  LambdaHandlerPredicate() {
    exists(string handlerName |
      this.getName() = handlerName and
      (
        (this.getNumberOfParameters() = 2 and
         this.getParameter(1).getType().hasQualifiedName("com.amazonaws.services.lambda.runtime", "Context"))
        or
        (this.getNumberOfParameters() = 3 and
         this.getParameter(2).getType().hasQualifiedName("com.amazonaws.services.lambda.runtime", "Context"))
      )
    )
  }

  Parameter getEventParameter() {
    exists(string paramName |
      paramName.matches("%EVENT%") and
      result = this.getAParameter() and
      result.getName() = paramName
    )
  }
}

class SqlStringConcatSink extends DataFlow::Node {
  SqlStringConcatSink() {
    exists(MethodAccess ma, string methodName |
      (methodName = "+" or methodName = "concat") and
      (
        (ma.getMethod().hasName(methodName) and
         ma.getQualifier().toString().matches("%SQLSTR%"))
        or
        ma.toString().matches("%\"SQLSTR\"\\s*\\+%")
      )
    )
  }
}

class SqlStringBuilderSink extends DataFlow::Node {
  SqlStringBuilderSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("append") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder")
    )
    or
    exists(AssignmentStmt assign |
      assign.toString().matches("%VAR\\s*\\+=%")
    )
  }
}

class SqlStringFormatSink extends DataFlow::Node {
  SqlStringFormatSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      exists(string formatStr |
        formatStr = ma.getArgument(0).getStringConstant() and
        formatStr.matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
      )
    )
  }
}

class TaintedSqlFlowConfig extends TaintTracking::Configuration {
  TaintedSqlFlowConfig() { this = "TaintedSqlFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(LambdaHandlerPredicate handler |
      source.asParameter() = handler.getEventParameter()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlStringConcatSink or
    sink instanceof SqlStringBuilderSink or
    sink instanceof SqlStringFormatSink
  }
}

