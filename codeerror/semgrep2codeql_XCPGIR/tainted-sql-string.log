Rule Content:
/**
 * @name Tainted SQL string construction
 * @description Detects when user input flows into manually-constructed SQL strings,
 *              which could lead to SQL injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringControllerRequest

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Method m, Parameter p |
      m.hasAnnotation() and
      (
        m.getAnnotation().getType().getQualifiedName() matches %"RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue"% and
        p = m.getAParameter() and
        not p.getType() instanceof BoxedPrimitiveType and
        not p.getType() instanceof PrimitiveType and
        this.asParameter() = p
      )
    )
  }
}

class SqlStringSink extends DataFlow::Node {
  SqlStringSink() {
    // String concatenation patterns
    exists(BinaryExpr b |
      b.getOperator() = "+" and
      b.getLeftOperand().getStringValue() != "" and
      b.getRightOperand().getType() instanceof TypeString and
      b.getLeftOperand().getStringValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      this.asExpr() = b
    )
    or
    // String.concat() pattern
    exists(MethodAccess ma |
      ma.getMethod().hasName("concat") and
      ma.getQualifier().getStringValue() != "" and
      ma.getQualifier().getStringValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      this.asExpr() = ma
    )
    or
    // String.format() pattern
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType() instanceof TypeString and
      ma.getArgument(0).getStringValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      this.asExpr() = ma
    )
    or
    // StringBuilder.append() pattern
    exists(MethodAccess ma, Variable sb |
      ma.getMethod().hasName("append") and
      ma.getMethod().getDeclaringType().getName() = "StringBuilder" and
      exists(LocalVariableDeclExpr lvde |
        lvde.getVariable() = sb and
        lvde.getInitializer().getStringValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b")
      ) and
      ma.getQualifier() = sb.getAnAccess() and
      this.asExpr() = ma
    )
    or
    // += operator pattern
    exists(AssignExpr ae, Variable v |
      ae.getOperator() = "+=" and
      exists(LocalVariableDeclExpr lvde |
        lvde.getVariable() = v and
        lvde.getInitializer().getStringValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b")
      ) and
      ae.getLValue() = v.getAnAccess() and
      this.asExpr() = ae
    )
  }

  override predicate isSinkOf(Node sourceNode) {
    not exists(Expr e |
      parentExpr*(e, this.asExpr()) and
      (
        e = any(SysOutExpr soe).getAnArgument() or
        e = any(LoggingMethod lm).getAnArgument() or
        e = any(NewException ne).getAnArgument() or
        e instanceof ThrowStmt
      )
    )
  }
}

class UserDataToSqlFlowConfig extends TaintTracking::Configuration {
  UserDataToSqlFlowConfig() { this = "UserDataToSqlFlowConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlStringSink }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // String concatenation taint step
    exists(BinaryExpr b | b.getOperator() = "+" and pred.asExpr() = b.getAnOperand() and succ.asExpr() = b)
    or
    // Method call taint steps
    exists(MethodAccess ma | succ.asExpr() = ma and pred.asExpr() instanceof Argument)
  }
}

