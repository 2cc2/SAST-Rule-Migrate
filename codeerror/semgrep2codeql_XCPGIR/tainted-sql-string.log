    match:
      node: CALL
      where:
        - op: or
          conditions:
            - pattern: '"$SQL_STR" + ...'
            - pattern: '"$SQL_STR".concat(...)'
            - pattern: 'String.format("$SQL_STR", ...)'
            - patterns:
                - pattern: '$SB.append(...)'
                - context: 'StringBuilder $SB = new StringBuilder("$SQL_STR");'
            - patterns:
                - pattern: '$VAR += ...'
