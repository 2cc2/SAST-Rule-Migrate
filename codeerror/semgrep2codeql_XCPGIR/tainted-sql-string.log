Rule Content:
/**
 * @name Tainted SQL String Construction
 * @description Detects user input used to manually construct a SQL string.
 * @kind problem
 * @severity error
 * @id java/tainted-sql-string
 * @tags security
 * @precision high
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringUtil

class LambdaInput extends DataFlow::Node {
  LambdaInput() {
    exists(Method m, Parameter p | 
      m.getName() = "handleRequest" and 
      p = m.getAParameter() and 
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class SqlConcatSink extends DataFlow::Node {
  SqlConcatSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "concat" and ma.getMethod().getDeclaringType() instanceof TypeString) or
      (ma.getMethod().getName() = "format" and ma.getMethod().getDeclaringType() instanceof TypeString) or
      (ma.getMethod().getName() = "append" and ma.getMethod().getDeclaringType() instanceof TypeStringBuilder) |
      ma.getReceiver().toString().matches("/select|delete|insert|create|update|alter|drop/i") and
      this.asExpr() = ma
    )
  }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlConcatSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Assignment assn | node1.asExpr() = assn.getRhs() and node2.asExpr() = assn.getLhs()) or
    exists(MethodAccess ma | ma.getMethod() instanceof Method and ma.getMethod().getReturnType() = node2.getType() and 
      node1.asExpr() = ma.getAnArgument() and node2.asExpr() = ma)
  }
}

