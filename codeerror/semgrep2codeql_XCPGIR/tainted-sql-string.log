Rule Content:
/**
 * @name Tainted SQL String
 * @kind path-problem
 * @id java/tainted-sql-string
 * @problem.severity error
 * @description Detected user input used to manually construct a SQL string.
 *              This is usually bad practice because manual construction could
 *              accidentally result in a SQL injection. Use parameterized queries
 *              or ORMs like Sequelize instead.
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.aws.AWSLambda

class LambdaInputSource extends DataFlow::Node {
  LambdaInputSource() {
    exists(Method m, Parameter p |
      m = p.getDeclaringMethod() and
      p = this.asParameter() and
      exists(Class c |
        c.getASupertype*().hasQualifiedName("com.amazonaws.services.lambda.runtime", "RequestHandler") and
        m.getDeclaringType() = c and
        m.hasName("handleRequest")
      )
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p | p = this.asParameter()) or
    exists(RemoteFlowSource rfs | rfs = this.asExpr())
  }
}

class SqlConcatSink extends DataFlow::Node {
  SqlConcatSink() {
    exists(Method m |
      (m.hasName("concat") or m.hasName("format")) and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = m.getACall()
    ) or
    exists(Expr e |
      this.asExpr() = e and
      e.toString().matches("%SELECT%FROM%") or
      e.toString().matches("%INSERT%INTO%") or
      e.toString().matches("%UPDATE%SET%") or
      e.toString().matches("%DELETE%FROM%")
    )
  }
}

class PrintlnBarrier extends TaintTracking::BarrierGuard {
  PrintlnBarrier() {
    exists(Method m |
      m.hasName("println") and
      m.getDeclaringType().hasQualifiedName("java.io", "PrintStream") and
      this.asExpr() = m.getACall()
    )
  }
}

class StringConcatExtension extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(BinaryExpr be |
      be.getOp() = "*+" and
      (be.getRightOperand() = pred.asExpr() and
      be.getLeftOperand() = succ.asExpr()) or
      (be.getLeftOperand() = pred.asExpr() and
      be.getRightOperand() = succ.asExpr())
    )
  }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlString" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaInputSource or
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlConcatSink }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof PrintlnBarrier
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringConcatExtension ext | ext.step(pred, succ))
  }
}

