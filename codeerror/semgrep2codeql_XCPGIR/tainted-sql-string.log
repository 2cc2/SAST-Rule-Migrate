/**
 * @name Tainted SQL string construction
 * @description Detects when user input flows into manually-constructed SQL strings,
 *              which could lead to SQL injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Method m, Parameter p |
      m.getAnAnnotation() instanceof Annotation and
      (
        m.getAnAnnotation().getType().getName().matches("RequestMapping|RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue") and
        p = m.getAParameter() and
        not p.getType() instanceof BoxedType and
        not p.getType() instanceof PrimitiveType and
        this.asParameter() = p
      )
    )
  }
}

class SqlStringSink extends DataFlow::Node {
  SqlStringSink() {
    // String concatenation patterns
    exists(BinaryAddExpr b |
      b.getLeftOperand().getStringValue() != "" and
      b.getRightOperand().getType() instanceof TypeString and
      b.getLeftOperand().getStringValue().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      this.asExpr() = b
    )
    or
    // String.concat() pattern
    exists(MethodAccess ma |
      ma.getMethod().hasName("concat") and
      ma.getQualifier().getStringValue() != "" and
      ma.getQualifier().getStringValue().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      this.asExpr() = ma
    )
    or
    // String.format() pattern
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType() instanceof TypeString and
      ma.getArgument(0).getStringValue().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      this.asExpr() = ma
    )
    or
    // StringBuilder.append() pattern
    exists(MethodAccess ma, LocalVariableDecl lv |
      ma.getMethod().hasName("append") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder") and
      exists(lv.getInitializer() |
        _.getStringValue().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
      ) and
      ma.getQualifier() = lv.getAUse() and
      this.asExpr() = ma
    )
    or
    // += operator pattern
    exists(AssignAddExpr ae, LocalVariableDecl lv |
      exists(lv.getInitializer() |
        _.getStringValue().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
      ) and
      ae.getLhs() = lv.getAUse() and
      this.asExpr() = ae
    )
  }
}

class SqlStringSanitization extends TaintTracking::AdditionalTaintStep {
  override predicate steps(DataFlow::Node pred, DataFlow::Node succ) {
    exists(BinaryAddExpr b | b.getAnOperand() = pred.asExpr() and b = succ.asExpr())
    or
    exists(MethodAccess ma | ma.getAnArgument() = pred.asExpr() and ma = succ.asExpr())
  }
}

class UserDataToSqlFlowConfiguration extends TaintTracking::Configuration {
  UserDataToSqlFlowConfiguration() { this = "UserDataToSqlFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlStringSink }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "println" and
      ma.getQualifier().getType().hasQualifiedName("java.lang", "System") and
      node.asExpr() = ma.getAnArgument()
    )
    or
    exists(Logging log | node.asExpr() = log.getOutputArgument())
    or
    exists(Exception exc | node.asExpr() = exc.getAnArgument())
  }
}

