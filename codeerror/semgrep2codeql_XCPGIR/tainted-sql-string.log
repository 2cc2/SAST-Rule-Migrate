/**
 * @name Tainted SQL String Construction
 * @description Detected user input used to manually construct a SQL string.
 * @id tainted-sql-string
 * @kind path-problem
 * @severity error
 * @tags security
 * @precision high
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class LambdaInput extends DataFlow::Node {
  LambdaInput() {
    exists(Method m, Parameter p |
      m.getName() = "handleRequest" and
      p = m.getAParameter() and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class SqlConcatSink extends DataFlow::Node {
  SqlConcatSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().hasName(["concat", "format"]) and
        ma.getMethod().getDeclaringType() instanceof TypeString
      ) or
      (
        ma.getMethod().getName() = "append" and
        ma.getMethod().getDeclaringType() instanceof TypeStringBuilder
      )
      and
      ma.getReceiver().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
      and
      this.asExpr() = ma
    )
  }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlConcatSink }

  override predicate isAdditionalTaintStep(DataFlow::Node src, DataFlow::Node sink) {
    exists(AssignExpr a | src.asExpr() = a.getRhs() and sink.asExpr() = a.getLhs())
    or
    exists(MethodAccess ma | src.asExpr() = ma.getAnArgument() and sink.asExpr() = ma)
  }
}

