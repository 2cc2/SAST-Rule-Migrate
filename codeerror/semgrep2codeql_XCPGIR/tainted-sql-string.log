    match:
      node: PARAM
      where:
        - op: regex
          left: annotation
          right: "(RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue)"
        - op: not_regex
          left: type
          right: "(Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean)"

sinks:
