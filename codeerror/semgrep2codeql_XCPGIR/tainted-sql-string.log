/**
 * @name Tainted SQL String Construction
 * @description Detects user input used to manually construct a SQL string.
 * @kind path-problem
 * @severity error
 * @id java/tainted-sql-string
 * @tags security
 * @precision high
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringOperations

class LambdaInput extends DataFlow::Node {
  LambdaInput() {
    exists(Method m, Parameter p | 
      m.getName() = "handleRequest" and 
      p = m.getAParameter() and 
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class SqlConcatSink extends DataFlow::Node {
  SqlConcatSink() {
    exists(Method ma |
      (ma.getName() = "concat" and ma.getDeclaringType() instanceof TypeString) or
      (ma.getName() = "format" and ma.getDeclaringType() instanceof TypeString) or
      (ma.getName() = "append" and ma.getDeclaringType() instanceof TypeStringBuilder) |
      ma.getQualifier().toString().matches("(?i)(select|delete|insert|create|update|alter|drop).*") and
      this.asExpr() = ma.getACall()
    )
  }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlConcatSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(AssignExpr assn | node1.asExpr() = assn.getRhs() and node2.asExpr() = assn.getLhs()) or
    exists(MethodAccess ma | node1.asExpr() = ma.getAnArgument() and node2.asExpr() = ma)
  }
}

