/**
 * @name TaintedSQLString
 * @kind problem
 * @id java/tainted-sql-string
 * @severity error
 * @description User data flows into manually-constructed SQL string. Use prepared statements (`connection.PreparedStatement`) or a safe library instead.
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringController
import semmle.code.java.StringFormat

class SpringRequestSource extends RemoteFlowSource {
  SpringRequestSource() {
    exists(Parameter p |
      p.getAnAnnotation().getType().getName().matches("%(RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue)%") and
      not p.getType() instanceof PrimitiveType
    )
  }
}

class TaintedSQLStringConfig extends TaintTracking::Configuration {
  TaintedSQLStringConfig() { this = "TaintedSQLStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SpringRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, MethodAccess ma |
      ma.getMethod() = m and
      m.getName().matches("%(?i)(select|delete|insert|create|update|alter|drop)%") and
      (
        ma.getAnArgument() = sink.asExpr() or
        exists(StringConcatenation sc | sc.getAnOperand() = sink.asExpr()) or
        exists(StringFormat sf | sf.getAnArgument() = sink.asExpr()) or
        exists(StringBufferAppend sba | sba.getAnArgument() = sink.asExpr())
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Method m, MethodAccess ma |
      ma.getMethod() = m and
      m.hasName("prepareStatement") and
      m.getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      sanitizer.asExpr() = ma
    )
  }

  override predicate isBarrier(DataFlow::Node node) {
    exists(Method m, MethodAccess ma |
      ma.getMethod() = m and
      m.getDeclaringType().hasQualifiedName("org.slf4j", "Logger") and
      m.getName().matches("%(info|warn|warning|debug|debugging|error)%") and
      node.asExpr() = ma
    ) or
    exists(ThrowStmt ts | node.asExpr() = ts)
  }
}

from DataFlow::Node source, DataFlow::Node sink, TaintedSQLStringConfig config
where config.hasFlow(source, sink)
select sink, "Potential SQL injection vulnerability from Spring request parameter to SQL string construction", source, sink
