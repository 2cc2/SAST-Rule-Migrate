/**
 * @name Use of SHA1
 * @description Detected SHA1 hash algorithm which is considered insecure. SHA1 is not collision resistant and is therefore not suitable as a cryptographic signature. Instead, use PBKDF2 for password hashing or SHA256 or SHA512 for other hash function applications.
 * @kind problem
 * @id java/use-of-sha1
 * @severity Warning
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isSha1Call(Method m) {
  m.hasName("getInstance") and
  m.getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
  exists(Expr arg | arg = m.getACall().getArgument(0) |
    arg.(StringLiteral).getValue().matches("(SHA1|SHA-1)")
  )
}

predicate isSha1DigestCall(Method m) {
  m.hasName("digest") and
  m.getDeclaringType().getAMethod().getName().matches("getSha1Digest")
}

from MethodAccess ma, Method m
where 
  (isSha1Call(m) and ma.getMethod() = m) or
  (isSha1DigestCall(m) and ma.getMethod() = m)
select ma, "Use of insecure SHA1 hash algorithm"
