Rule Content:
/**
 * @name Use of SHA1
 * @description Detected SHA1 hash algorithm which is considered insecure. SHA1 is not collision resistant and 
 * is therefore not suitable as a cryptographic signature. Instead, use PBKDF2 for password hashing or SHA256 
 * or SHA512 for other hash function applications.
 * @kind problem
 * @id java/use-of-sha1
 * @severity Warning
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isSha1Call(MethodAccess ma) {
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
  exists(ma.getArgument(0).(Literal).getValue() |
    regexpMatch("(SHA1|SHA-1)", _)
  )
}

predicate isSha1DigestCall(MethodAccess ma) {
  ma.getMethod().hasName("digest") and
  ma.getQualifier().(MethodAccess).getMethod().getName().matches("getSha1Digest")
}

from MethodAccess sha1Call, MethodAccess sha1DigestCall
where 
  isSha1Call(sha1Call) or 
  isSha1DigestCall(sha1DigestCall)
select sha1Call, "Use of insecure SHA1 hash algorithm" or
select sha1DigestCall, "Use of insecure SHA1 hash algorithm"
