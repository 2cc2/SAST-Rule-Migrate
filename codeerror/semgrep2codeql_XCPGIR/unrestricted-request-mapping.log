/**
 * @name Unrestricted Request Mapping
 * @description Detected a method annotated with 'RequestMapping' that does not specify the HTTP method. CSRF protections are not enabled for GET, HEAD, TRACE, or OPTIONS.
 * @kind problem
 * @id java/unrestricted-request-mapping
 * @severity warning
 * @security-severity 8.0
 * @precision high
 * @tags security
 *       external/cwe/cwe-352
 */

import java
import semmle.code.java.frameworks.spring.SpringAnnotations

// Define Request Mapping methods without specified HTTP method
class UnrestrictedRequestMapping extends Method {
  UnrestrictedRequestMapping() {
    exists(Annotation requestMapping |
      requestMapping.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestMapping") and
      this.getAnAnnotation() = requestMapping and
      not exists(requestMapping.getValue("method"))
    )
  }
}

// Define state-changing methods (save|update|delete|create)
class StateChangingMethod extends Method {
  StateChangingMethod() {
    this.getName().matches("save|update|delete|create") or
    exists(Stmt s | 
      s.getEnclosingCallable() = this and
      s.toString().matches(".*(save|update|delete|create).*")
    )
  }
}

from UnrestrictedRequestMapping requestMapping, StateChangingMethod stateChangingMethod
where requestMapping = stateChangingMethod
select requestMapping,
  "Potential CSRF vulnerability due to unrestricted RequestMapping annotation",
  requestMapping,
  "This method uses @RequestMapping without HTTP method restriction and contains state-changing operations."
