/**
 * @name Unrestricted Request Mapping
 * @description Detected a method annotated with 'RequestMapping' that does not specify the HTTP method. 
 *              CSRF protections are not enabled for GET, HEAD, TRACE, or OPTIONS, and by default all 
 *              HTTP methods are allowed when the HTTP method is not explicitly specified. This means 
 *              that a method that performs state changes could be vulnerable to CSRF attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/unrestricted-request-mapping
 * @tags security
 *       external/cwe/cwe-352
 */

import java
import semmle.code.java.frameworks.spring.SpringRequestMappings
import semmle.code.java.security.Csrf

predicate isStateChangingMethod(Method m) {
  exists(string methodName |
    methodName = m.getName() and
    regexpMatch("update|save|delete|insert|modify|create", methodName)
  )
}

from Method sourceMethod, Method sinkMethod, RequestMappingAnnotation requestMapping
where
  // Source: Method with RequestMapping annotation without specified HTTP method
  requestMapping.getMethod().toString() = "*" and
  sourceMethod = requestMapping.getMethodDeclaration() and
  
  // Sink: Method with state-changing name
  isStateChangingMethod(sinkMethod) and
  
  // Flow from source to sink
  sinkMethod = sourceMethod
select sinkMethod, 
  "Potential CSRF vulnerability due to unrestricted RequestMapping on state-changing method", 
  sinkMethod,
  "Method is annotated with @RequestMapping but doesn't specify HTTP method"
