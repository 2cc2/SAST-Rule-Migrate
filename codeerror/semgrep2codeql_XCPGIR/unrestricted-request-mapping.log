Rule Content:
/**
 * @name Unrestricted Request Mapping
 * @description Detected a method annotated with 'RequestMapping' that does not specify the HTTP method.
 *              CSRF protections are not enabled for GET, HEAD, TRACE, or OPTIONS, and by default all
 *              HTTP methods are allowed when the HTTP method is not explicitly specified. This means
 *              that a method that performs state changes could be vulnerable to CSRF attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/unrestricted-request-mapping
 * @tags security
 *       external/cwe/cwe-352
 */

import java
import DataFlow::PathGraph

class RequestMappingWithoutMethod extends Annotation {
  RequestMappingWithoutMethod() {
    this.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestMapping") and
    not exists(MethodElement m | m = this.getValue("method"))
  }
}

predicate isStateChangingMethod(Method m) {
  m.getName().matches("update|save|delete|insert|modify|create")
}

class UnrestrictedRequestMappingFlow extends TaintTracking::Configuration {
  UnrestrictedRequestMappingFlow() { this = "UnrestrictedRequestMappingFlow" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, RequestMappingWithoutMethod annot |
      source.asExpr() = annot.getAnnotated() and
      m = annot.getAnnotated() and
      m.getReturnType().toString() != "void"
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m |
      sink.asExpr() = m.getAnAccess() and
      isStateChangingMethod(m)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, UnrestrictedRequestMappingFlow config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Potential CSRF vulnerability due to unrestricted RequestMapping",
  source.getNode(), "Unrestricted @RequestMapping"
