/**
 * @name Jackson unsafe deserialization
 * @description Using Jackson with default typing enabled can lead to RCE when deserializing untrusted JSON
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @id java/jackson-unsafe-deserialization
 * @tags security
 *       external/cwe/cwe-502
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Jackson

class JacksonUnsafeDeserializationConfig extends TaintTracking::Configuration {
  JacksonUnsafeDeserializationConfig() { this = "JacksonUnsafeDeserializationConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p | 
      m.getAParameter() = p and
      p.getType().hasName("String") and
      source.asParameter() = p
    )
    or
    exists(Field f |
      f.getType().hasName("String") and
      source.asField() = f
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "readValue" and
      ma.getMethod().getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Annotation a |
      a.getType().hasQualifiedName("com.fasterxml.jackson.annotation", "JsonTypeInfo") and
      not a.getValue("use").(Literal).getValue().toString() = "Id.CLASS" and
      sanitizer.asExpr() = a
    )
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    exists(Field f |
      f.getType() instanceof RefType and
      (
        f.getType().hasName("Object") or
        f.getType().hasName("Serializable") or
        f.getType().hasName("Comparable")
      ) and
      barrier.asField() = f
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Field f |
      pred.asField() = f and
      succ.asExpr() = f.getAnAccess()
    )
  }
}

