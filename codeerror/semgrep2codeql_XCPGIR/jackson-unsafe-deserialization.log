/**
 * @name Jackson Unsafe Deserialization
 * @description Detects unsafe Jackson deserialization configurations that can lead to RCE
 * @kind path-problem
 * @problem.severity warning
 * @id java/jackson-unsafe-deserialization
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Jackson

class JacksonUnsafeDeserializationConfig extends TaintTracking::Configuration {
  JacksonUnsafeDeserializationConfig() { this = "JacksonUnsafeDeserializationConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Source: Unsafe JSON input to readValue
    exists(MethodAccess readValue |
      readValue.getMethod().hasName("readValue") and
      readValue.getMethod().getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      source.asParameter() = readValue.getArgument(0).asParameter() or
      source.asExpr() = readValue.getArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // Sink 1: Unsafe deserialization via readValue
    exists(MethodAccess readValue |
      readValue.getMethod().hasName("readValue") and
      readValue.getMethod().getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      sink.asExpr() = readValue
    )
    or
    // Sink 2: enableDefaultTyping call
    exists(MethodAccess enableTyping |
      enableTyping.getMethod().hasName("enableDefaultTyping") and
      enableTyping.getMethod().getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      sink.asExpr() = enableTyping
    )
    or
    // Sink 3: Dangerous @JsonTypeInfo annotation
    exists(Annotation annotation |
      annotation.getType().hasQualifiedName("com.fasterxml.jackson.annotation", "JsonTypeInfo") and
      annotation.getValue("use").toString().matches("%Id\.CLASS%") and
      sink.asExpr() = annotation
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Sanitizer: Safe type declarations
    exists(Type t |
      not t.getName().matches("Object|Serializable|Comparable") and
      sanitizer.asType() = t
    )
  }
}

from JacksonUnsafeDeserializationConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Unsafe Jackson deserialization detected (source: $@, sink: $@)",
  source.getNode(), "User-controlled input",
  sink.getNode(), "Potential unsafe deserialization"
