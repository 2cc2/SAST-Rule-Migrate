/**
 * @name Jackson Unsafe Deserialization
 * @description Detects unsafe Jackson deserialization configurations that can lead to RCE
 * @kind path-problem
 * @problem.severity warning
 * @id java/jackson-unsafe-deserialization
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Jackson

class JacksonUnsafeDeserializationConfig extends TaintTracking::Configuration {
  JacksonUnsafeDeserializationConfig() { this = "JacksonUnsafeDeserialization" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, MethodAccess ma |
      m.hasName("readValue") and
      m.getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      ma.getMethod() = m and
      (
        source.asParameter() = ma.getArgument(0)
        or
        source.asExpr() = ma.getArgument(0)
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // Sink 1: readValue call
    exists(Method m, MethodAccess ma |
      m.hasName("readValue") and
      m.getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      ma.getMethod() = m and
      sink.asExpr() = ma
    )
    or
    // Sink 2: enableDefaultTyping call
    exists(Method m, MethodAccess ma |
      m.hasName("enableDefaultTyping") and
      m.getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      ma.getMethod() = m and
      sink.asExpr() = ma
    )
    or
    // Sink 3: Dangerous JsonTypeInfo annotation
    exists(Annotation a |
      a.getType().hasQualifiedName("com.fasterxml.jackson.annotation", "JsonTypeInfo") and
      exists(Expr useExpr |
        a.getValue("use") = useExpr and
        useExpr.toString().matches(".*Id\\.CLASS.*")
      ) and
      sink.asExpr() = a
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(RefType t |
      t = node.getType() and
      not t.hasName("Object") and
      not t.hasName("Serializable") and
      not t.hasName("Comparable")
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagation via method calls
    exists(MethodAccess ma |
      node1.asExpr() = ma.getArgument(_) and
      node2.asExpr() = ma
    )
    or
    // Propagation via field access
    exists(Field f, FieldRead fr |
      node1.asExpr() = fr.getQualifier() and
      node2.asExpr() = fr
    )
  }
}

