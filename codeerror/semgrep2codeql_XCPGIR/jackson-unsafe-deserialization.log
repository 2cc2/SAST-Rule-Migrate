/**
 * @name Jackson Unsafe Deserialization
 * @description Detects unsafe Jackson deserialization configurations that can lead to RCE
 * @kind path-problem
 * @problem.severity warning
 * @id java/jackson-unsafe-deserialization
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Jackson

class JacksonUnsafeDeserializationConfig extends TaintTracking::Configuration {
  JacksonUnsafeDeserializationConfig() { this = "JacksonUnsafeDeserializationConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, CallExpr call |
      m.hasName("readValue") and
      m.getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      call.getCallee() = m and
      (
        source.asParameter() = call.getArgument(0).asParameter()
        or
        source.asExpr() = call.getArgument(0)
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // Unsafe deserialization via readValue
    exists(Method m, CallExpr call |
      m.hasName("readValue") and
      m.getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      call.getCallee() = m and
      sink.asExpr() = call
    )
    or
    // enableDefaultTyping call
    exists(Method m, CallExpr call |
      m.hasName("enableDefaultTyping") and
      m.getDeclaringType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
      call.getCallee() = m and
      sink.asExpr() = call
    )
    or
    // Dangerous @JsonTypeInfo annotation
    exists(Annotation ann, AnnotationType atype |
      atype.hasQualifiedName("com.fasterxml.jackson.annotation", "JsonTypeInfo") and
      ann.getType() = atype and
      exists(AnnotationElement annotElem |
        annotElem.getName() = "use" and
        annotElem.getValue().toString().matches("%Id\\.CLASS%")
      ) and
      sink.asExpr() = ann
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(RefType t |
      not t.getName().matches("Object|Serializable|Comparable") and
      sanitizer.asType() = t
    )
  }
}

