Rule Content:
/**
 * @name Tainted environment variables from HTTP request in Runtime.exec()
 * @description Detects when user input from HTTP request reaches environment variables in Runtime.exec()
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-env-from-http-request
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Servlets

class HttpRequestSource extends DataFlow::ExprNode {
  HttpRequestSource() {
    exists(Method m |
      (m.getName() = "getParameter" and m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")) or
      (m.getName() = "getValue" and m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie"))
    |
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getAnArgument()
    )
  }
}

class RuntimeExecSink extends DataFlow::ExprNode {
  RuntimeExecSink() {
    exists(Method m |
      m.getName() = "exec" and 
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      m.getNumberOfParameters() = 2
    |
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(1)
    )
  }
}

class TaintedEnvFlowConfiguration extends TaintTracking::Configuration {
  TaintedEnvFlowConfiguration() { this = "TaintedEnvFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RuntimeExecSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    node1.asExpr().getASuccessor+() = node2.asExpr()
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedEnvFlowConfiguration config
where config.hasFlowPath(source, sink)
select sink, 
  "User input from HTTP request reaches environment variables in Runtime.exec()",
  source, sink, "$@ flows to $@ here.", source.getNode(),
  "User input from HTTP request", sink.getNode(), "environment variables in Runtime.exec()"
