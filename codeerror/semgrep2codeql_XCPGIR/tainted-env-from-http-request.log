/**
 * @name Tainted environment variables from HTTP request in Runtime.exec()
 * @description Detects when user input from HTTP request reaches environment variables in Runtime.exec()
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-env-from-http-request
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpRequestSource extends DataFlow::Source {
  HttpRequestSource() {
    exists(MethodAccess ma | 
      ma.getMethod().getName() = "getParameter" and
      ma.getQualifier().getType().hasName("HttpServletRequest")
      and this.asExpr() = ma
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "getValue" and
      ma.getQualifier().getType().hasName("Cookie")
      and this.asExpr() = ma
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    source.asExpr() = this
  }
}

class RuntimeExecSink extends DataFlow::Sink {
  RuntimeExecSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "exec" and
      ma.getMethod().getDeclaringType().hasName("Runtime") and
      ma.getArgument(1) = this.asExpr()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asExpr() = this
  }
}

class TaintedEnvFlowConfig extends TaintTracking::Configuration {
  TaintedEnvFlowConfig() { this = "TaintedEnvFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RuntimeExecSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(FieldAccess fa | 
      node1.asExpr() = fa.getQualifier() and
      node2.asExpr() = fa
    )
    or
    exists(MethodCall mc | 
      node1.asExpr() = mc.getAnArgument() and
      node2.asExpr() = mc
    )
  }
}

from TaintedEnvFlowConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input from HTTP request reaches environment variables in Runtime.exec()"
