Rule Content:
/**
 * @id tainted-session-from-http-request
 * @kind path-problem
 * @severity warning
 * @name Unsanitized session operation from HTTP request input
 * @description Detected input from a HTTPServletRequest going into a session command. User input could lead to malicious code in session parameters.
 * @tags security/external-input
 * @precision high
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

predicate isHttpGetParameter(Expr e) {
  exists(Method m |
    m.hasName("getParameter") and
    m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
    e = any(MethodAccess ma | 
      ma.getMethod() = m and
      not exists(MethodAccess getSessionCall | 
        getSessionCall.getMethod().hasName("getSession") and
        getSessionCall.getQualifier().getType().hasQualifiedName("javax.servlet.http", "HttpSession") and
        ma.getEnclosingCallable() = getSessionCall.getEnclosingCallable()
      )
    ).getAnArgument()
  )
}

predicate isCookieGetValue(Expr e) {
  exists(Method m |
    m.hasName("getValue") and
    m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    e = any(MethodAccess ma | ma.getMethod() = m).getAnArgument()
  )
}

predicate isRequestGetHeaders(Expr e) {
  exists(Method m |
    m.hasName("getHeaders") and
    m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
    e = any(MethodAccess ma | ma.getMethod() = m).getAnArgument()
  )
}

class HttpRequestInput extends DataFlow::Node {
  HttpRequestInput() {
    isHttpGetParameter(this.asExpr()) or
    isCookieGetValue(this.asExpr()) or
    isRequestGetHeaders(this.asExpr())
  }
}

class SessionOperation extends DataFlow::Node {
  SessionOperation() {
    exists(Method m |
      (m.hasName("putValue") or m.hasName("setAttribute")) and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpSession") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(1)
    )
  }
}

class TaintedSessionConfig extends TaintTracking::Configuration {
  TaintedSessionConfig() { this = "TaintedSessionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SessionOperation }
}

