/**
 * @id tainted-session-from-http-request
 * @kind path-problem
 * @severity warning
 * @name Unsanitized session operation from HTTP request input
 * @description Detected input from a HTTPServletRequest going into a session command. User input could lead to malicious code in session parameters.
 * @tags security/external-input
 * @precision high
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpRequestInput extends DataFlow::Node {
  HttpRequestInput() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getParameter") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      not (ma.getQualifier().getType().hasQualifiedName("javax.servlet.http", "HttpSession") and
           ma.getEnclosingCallable().getName() = "getSession") and
      this.asExpr() = ma
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("getValue") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.asExpr() = ma
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("getHeaders") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      this.asExpr() = ma
    )
  }
}

class SessionOperation extends DataFlow::Node {
  SessionOperation() {
    exists(MethodAccess ma |
      (ma.getMethod().hasName("putValue") or ma.getMethod().hasName("setAttribute")) and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpSession") and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class TaintedSessionConfig extends TaintTracking::Configuration {
  TaintedSessionConfig() { this = "TaintedSessionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SessionOperation }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }

  override predicate isBarrier(DataFlow::Node barrier) { none() }
}

from TaintedSessionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "User input reaches session operation without sanitization", source, sink,
  "Unsanitized user input from $@ flows into session operation", source, source.toString()
