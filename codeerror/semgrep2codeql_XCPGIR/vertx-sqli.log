    match:
      node: CALL
      api: { type: java.lang.String, method: format }
  - id: STRING_CONCAT_SOURCE
    match:
      node: ASSIGNMENT
      where:
        - op: regex
          left: value
          right: ".*\\+.*"

sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: { method: "(query|preparedQuery|prepare)" }
      arg_index: 0

sanitizers:
  - id: PREPARED_STATEMENT
    match: { node: CALL, api: { type: java.sql.Connection, method: prepareStatement } }
