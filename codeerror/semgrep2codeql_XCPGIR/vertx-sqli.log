/**
 * @name Vertx SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id vertx-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.vertx.VertxDataFlow

class UnsafeSqlFormatSource extends DataFlow::Node {
  UnsafeSqlFormatSource() {
    exists(MethodAccess ma | ma.getMethod().getName() = "format" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") |
      this.asExpr() = ma)
  }
}

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(BinaryExpr be | be.getOperator() = BinaryOperator.PLUS | this.asExpr() = be)
  }
}

class SqlVarDeclSource extends DataFlow::Node {
  SqlVarDeclSource() {
    exists(LocalVariableDecl lvd | lvd.getVariable().getName().matches("^SQL$") | 
      this.asExpr() = lvd.getVariable().getAnAccess())
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma | 
      ma.getMethod().getName().matches("^(query|preparedQuery|prepare)$") and
      (ma.getMethod().getDeclaringType().hasQualifiedName("io.vertx.sqlclient", "SqlClient") or
       ma.getMethod().getDeclaringType().hasQualifiedName("io.vertx.sqlclient", "SqlConnection")) |
      this.asExpr() = ma)
  }
}

class VertxSQLInjectionConfig extends TaintTracking::Configuration {
  VertxSQLInjectionConfig() { this = "VertxSQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeSqlFormatSource or
    source instanceof StringConcatSource or
    source instanceof SqlVarDeclSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(ConstantExpr ce | node.asExpr() = ce)
  }
}

