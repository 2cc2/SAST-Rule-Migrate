    match: 
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "\".*\" \\+ \".*\"" 
    effect: stop

propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
  - id: ASSIGNMENT_PROP
    edge: assignment
    kind: taint

