Rule Content:
/**
 * @name Vert.x SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id vertx-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.VertX

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma
    )
  }
}

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(AddExpr add |
      add.getLeftOperand().getType() instanceof TypeString and
      this.asExpr() = add
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("query|preparedQuery|prepare") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma
    )
  }
}

class SafeStringConcatBarrier extends DataFlow::Node {
  SafeStringConcatBarrier() {
    exists(AddExpr add |
      add.getLeftOperand() instanceof StringLiteral and
      add.getRightOperand() instanceof StringLiteral and
      this.asExpr() = add
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "VertxSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof SafeStringConcatBarrier
  }
}

from Config config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), sink, source, sink.getNode(), 
  "User input reaches SQL execution without sanitization"
