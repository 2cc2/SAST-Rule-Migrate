    - "String sql = \"SELECT * FROM \" + table; connection.query(sql);"
  negative:
    - "SqlClient.query(\"SELECT * FROM users\" + \" WHERE name=?\")"
    - "PreparedStatement pstmt = connection.prepareStatement(\"SELECT * FROM users\");"
