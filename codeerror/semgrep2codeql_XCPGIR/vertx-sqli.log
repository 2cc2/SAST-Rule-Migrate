/**
 * @name Vert.x SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id vertx-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormatQuery

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(Method m, MethodAccess ma |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(BinaryOperation add |
      add.getLeftOperand().getType() instanceof TypeString and
      add.getOperator() = "+" and
      this.asExpr() = add
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(Method m, MethodAccess ma |
      m.getName().matches("query|preparedQuery|prepare") and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends TaintTracking::Sanitizer {
  PreparedStatementSanitizer() {
    exists(Method m, MethodAccess ma |
      m.getName() = "prepareStatement" and
      m.getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class SafeStringConcatBarrier extends TaintTracking::BarrierGuard {
  SafeStringConcatBarrier() {
    exists(BinaryOperation add |
      add.getOperator() = "+" and
      add.getLeftOperand() instanceof StringLiteral and
      add.getRightOperand() instanceof StringLiteral and
      this.asExpr() = add
    )
  }
}

class VertxSqlInjectionConfig extends TaintTracking::Configuration {
  VertxSqlInjectionConfig() { this = "VertxSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

