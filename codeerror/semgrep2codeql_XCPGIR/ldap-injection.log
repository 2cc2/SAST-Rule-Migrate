Rule Content:
/**
 * @name LDAP Injection
 * @description Detected non-constant data passed into an LDAP query. If this can be controlled by users, this is an injection.
 *               Ensure data passed to LDAP queries is not controllable or properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ldap-injection
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.security.LDAPInjection

class LDAPTaintConfig extends TaintTracking::Configuration {
  LDAPTaintConfig() { this = "LDAPTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      // Source is any non-empty string parameter
      source.asParameter() != null and
      source.asParameter().getCallable().getName().regexpMatch(".*") and
      not source.asExpr().(StringLiteral).getValue() = "" and
      ma.getAnArgument() = source.asExpr()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      // Sink is search() method of InitialDirContext where argument 1 is tainted
      ma.getMethod().getName() = "search" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.naming.directory", "InitialDirContext") and
      sink.asExpr() = ma.getArgument(1)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Constant strings are safe
    exists(StringLiteral sl | sl.getValue() != "" and sanitizer.asExpr() = sl)
  }
}

from LDAPTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches LDAP query without sanitization. $@ flows to $@.",
  source.getNode(), "user input here", sink.getNode(), "LDAP query here"
