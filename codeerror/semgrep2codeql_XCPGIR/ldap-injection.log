Rule Content:
/**
 * @name LDAP Injection
 * @description Detected non-constant data passed into an LDAP query. If this data can be
 *              controlled by an external user, this is an LDAP injection.
 *              Ensure data passed to an LDAP query is not controllable; or properly sanitize
 *              the data.
 * @kind path-problem
 * @id java/ldap-injection
 * @problem.severity Warning
 * @security-severity 7.5
 */
import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class LDAPInjectionFlow extends TaintTracking::Configuration {
  LDAPInjectionFlow() { this = "LDAPInjectionFlow" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, Parameter p |
      ma.getMethod().getAParameter() = p and
      source.asParameter() = p and
      not ma.getArgument(p.getIndex()).(Literal).getStringValue().regexpMatch("\".*\"")
    )
  }
  
  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.naming.directory", "DirContext") and
      ma.getMethod().getName() = "search" and
      sink.asExpr() = ma.getArgument(1)
    )
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal l |
      l.getStringValue().regexpMatch("\".*\"") and
      sanitizer.asExpr() = l
    )
  }
}

from LDAPInjectionFlow config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "User-controlled input reaches LDAP query without sanitization. $@ flows from $@ here.",
  source.getNode().asParameter().getCallable(),
  source.getNode().asParameter().getCallable().getName(),
  "Parameter"
