/**
 * @name LDAP Injection
 * @description Detected non-constant data passed into an LDAP query. If this can be controlled by users, this is an injection.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ldap-injection
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.security.QueryInjection

class LDAPConfiguration extends DataFlow::Configuration {
  LDAPConfiguration() { this = "LDAP Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      source.asParameter() = p and
      not exists(p.getAnAccess().(StringLiteral).getValue())
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m | 
      m.hasName("search") and
      m.getDeclaringType().hasQualifiedName("javax.naming.directory", "InitialDirContext") and
      exists(Call c | c.getMethod() = m and sink.asExpr() = c.getArgument(1))
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | 
      sl.getValue() != "" and
      sanitizer.asExpr() = sl
    )
  }
}

