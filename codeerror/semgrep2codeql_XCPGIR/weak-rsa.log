Rule Content:
/**
 * @name Use of Weak RSA Key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-weak-rsa-key
 * @tags security
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class RSAKeyGeneratorCall extends Expr {
  RSAKeyGeneratorCall() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getInstance") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
      ma.getArgument(0).(StringLiteral).getValue() = "RSA" and
      this = ma
    )
  }
}

class WeakRSAKeyInitialization extends MethodAccess {
  WeakRSAKeyInitialization() {
    this.getMethod().hasName("initialize") and
    this.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
    exists(int size |
      this.getArgument(0).(Literal).getIntValue() = size and
      size < 2048
    )
  }
}

class WeakRSAKeyFlowConfig extends TaintTracking::Configuration {
  WeakRSAKeyFlowConfig() { this = "WeakRSAKeyFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof RSAKeyGeneratorCall
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(WeakRSAKeyInitialization init |
      sink.asExpr() = init and
      sink.asExpr().getArgument(0) = init.getArgument(0)
    )
  }
}

from WeakRSAKeyFlowConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "Insecure RSA key size: " + sink.getNode().asExpr().toString() + " bits"
