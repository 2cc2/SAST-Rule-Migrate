Rule Content:
/**
 * @name Use of Weak RSA Key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-weak-rsa-key
 * @tags security
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class RSAKeyGeneration extends MethodAccess {
  RSAKeyGeneration() {
    this.getMethod().hasName("getInstance") and
    this.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
    this.getArgument(0).(StringLiteral).getValue() = "RSA"
  }
}

class WeakRSAKeyInitialization extends MethodAccess {
  int keySize

  WeakRSAKeyInitialization() {
    this.getMethod().hasName("initialize") and
    this.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
    keySize = this.getArgument(0).(Literal).getIntValue() and
    keySize < 2048
  }
}

class WeakRSAKeyFlowConfig extends TaintTracking::Configuration {
  WeakRSAKeyFlowConfig() { this = "WeakRSAKeyFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof RSAKeyGeneration
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(WeakRSAKeyInitialization init |
      sink.asExpr() = init and
      sink = DataFlow::exprNode(init.getArgument(0))
    )
  }
}

from WeakRSAKeyFlowConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
