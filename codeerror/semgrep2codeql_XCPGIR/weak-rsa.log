Rule Content:
/**
 * @name Use of weak RSA key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind path-problem
 * @id java/use-of-weak-rsa-key
 * @security-severity 7.5
 * @tags security
 * @precision high
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class RSAKeyPairGeneratorCall extends MethodAccess {
  RSAKeyPairGeneratorCall() {
    this.getMethod().hasName("getInstance") and
    this.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
    this.getArgument(0).toString() = "\"RSA\""
  }
}

class WeakInitializeCall extends MethodAccess {
  WeakInitializeCall() {
    this.getMethod().hasName("initialize") and
    this.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
    this.getArgument(0).getIntValue() < 2048
  }
}

class RSAKeyConfiguration extends TaintTracking::Configuration {
  RSAKeyConfiguration() { this = "RSAKeyConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(RSAKeyPairGeneratorCall call |
      source.asExpr() = call.getQualifier()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(WeakInitializeCall call |
      sink.asExpr() = call.getQualifier()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, WeakInitializeCall call
where
  any(RSAKeyConfiguration cfg).hasFlowPath(source, sink)
select sink, "Insecure RSA key size detected: " + call.getArgument(0).toString() + " bits (below 2048 bits)"
