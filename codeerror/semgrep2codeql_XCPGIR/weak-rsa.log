/**
 * @name Use of weak RSA key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind problem
 * @id java/use-of-weak-rsa-key
 * @security-severity warning
 * @tags security
 */

import java

from MethodAccess keyPairGen, MethodAccess initializeCall, int keySizeArg
where
  // Source: KeyPairGenerator.getInstance("RSA")
  keyPairGen.getMethod().hasName("getInstance") and
  keyPairGen.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
  exists(keyPairGen.getArgument(0) as stringLit | stringLit = "RSA") and
  
  // Sink: initialize() with key size < 2048
  initializeCall.getMethod().hasName("initialize") and
  initializeCall.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
  keySizeArg = initializeCall.getArgument(0).getIntValue() and
  keySizeArg < 2048 and
  
  // Data flow
  keyPairGen.getQualifier().getAUse().getEnclosingCallable() = initializeCall.getQualifier().getAUse().getEnclosingCallable()
select initializeCall, "Insecure RSA key size detected: " + keySizeArg.toString() + " bits (below 2048 bits)"
