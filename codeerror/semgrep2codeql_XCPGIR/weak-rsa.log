Rule Content:
/**
 * @name Use of weak RSA key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind problem
 * @id java/use-of-weak-rsa-key
 * @security-severity warning
 * @tags security
 */

import java
import semmle.code.java.dataflow.DataFlow

class RSAKeyPairGenerator extends Method {
  RSAKeyPairGenerator() {
    this.hasName("getInstance") and
    this.getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
    exists(MethodAccess ma |
      ma.getMethod() = this and
      ma.getArgument(0).(StringLiteral).getValue() = "RSA"
    )
  }
}

class WeakInitializeCall extends MethodAccess {
  WeakInitializeCall() {
    this.getMethod().hasName("initialize") and
    this.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
    this.getArgument(0).(Literal).getIntValue() < 2048
  }
}

module FlowConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    exists(RSAKeyPairGenerator rsa |
      source.asExpr() = rsa.getACall().getQualifier()
    )
  }

  predicate isSink(DataFlow::Node sink) {
    exists(WeakInitializeCall init |
      sink.asExpr() = init.getQualifier()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, WeakInitializeCall init
where
  DataFlow::flowPath(new FlowConfig(), source, sink)
select init, "Insecure RSA key size detected: " + init.getArgument(0).toString() + " bits (below 2048 bits)"
