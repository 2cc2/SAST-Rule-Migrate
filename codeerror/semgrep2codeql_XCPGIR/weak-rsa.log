Rule Content:
/**
 * @name Use of Weak RSA Key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-weak-rsa-key
 * @tags security
 */

import java

predicate isRSAKeyPairGeneratorCall(MethodAccess ma) {
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
  ma.getArgument(0).(StringLiteral).getValue() = "RSA"
}

predicate isInitializeCallWithSmallKeySize(MethodAccess ma) {
  exists(int size |
    ma.getMethod().hasName("initialize") and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
    ma.getArgument(0).(Literal).getLiteralValue() = size and
    size < 2048
  )
}

from MethodAccess keyGen, MethodAccess keyInit
where
  isRSAKeyPairGeneratorCall(keyGen) and
  isInitializeCallWithSmallKeySize(keyInit) and
  Flow::localFlow(DataFlow::exprFlow(keyGen.getQualifier(), keyInit.getQualifier()))
select keyInit, "Insecure RSA key size: " + keyInit.getArgument(0).toString() + " bits"
