/**
 * @name JWT None Algorithm
 * @description Detects use of the 'none' algorithm in a JWT token.
 * @kind problem
 * @problem.severity error
 * @id java/jjwt-none-alg
 */

import java

class JwtBuilderCall extends MethodAccess {
  JwtBuilderCall() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("io.jsonwebtoken", "Jwts") and
      m.getName() = "builder" and
      this.getMethod() = m
    )
  }
}

class SecureJwtBuilder extends MethodAccess {
  SecureJwtBuilder() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("io.jsonwebtoken", "Jwts") and
      m.getName() = "signWith" and
      this.getMethod() = m
    )
  }
}

from JwtBuilderCall jwtBuilder
where not exists(SecureJwtBuilder signWith |
  signWith.getEnclosingCallable() = jwtBuilder.getEnclosingCallable() and
  signWith.getEnclosingCallable().getASourceElement().getFile().getRelativePath() =
    jwtBuilder.getEnclosingCallable().getASourceElement().getFile().getRelativePath() and
  jwtBuilder.getParent+() = signWith.getParent+()
)
select jwtBuilder, 
  "Detected use of the 'none' algorithm in a JWT token. The 'none' algorithm assumes the integrity of the token has already been verified. This would allow a malicious actor to forge a JWT token that will automatically be verified. Do not explicitly use the 'none' algorithm. Instead, use an algorithm such as 'HS256'."
