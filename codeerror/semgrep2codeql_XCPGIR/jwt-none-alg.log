Rule Content:
/**
 * @name JWT none algorithm detected
 * @description Detected use of the 'none' algorithm in a JWT token. The 'none' algorithm 
 *              assumes the integrity of the token has already been verified. This would 
 *              allow a malicious actor to forge a JWT token that will automatically be 
 *              verified. Do not explicitly use the 'none' algorithm. Instead, use an 
 *              algorithm such as 'HS256'.
 * @kind problem
 * @tags security
 *       java
 *       jwt
 *       external/cwe/cwe-345
 * @precision high
 * @id java/jwt-none-alg
 * @severity error
 */

import java
import semmle.code.java.dataflow.DataFlow

class JwtBuilderCall extends MethodAccess {
  JwtBuilderCall() {
    exists(Method m | 
      this.getMethod() = m and
      m.hasName("builder") and
      m.getDeclaringType().hasQualifiedName("io.jsonwebtoken", "Jwts")
    )
  }
}

class SignWithCall extends MethodAccess {
  SignWithCall() {
    exists(Method m |
      this.getMethod() = m and
      m.hasName("signWith") and
      m.getDeclaringType().hasQualifiedName("io.jsonwebtoken", "Jwts")
    )
  }
}

class JwtUnsafeConstruct extends DataFlow::Node {
  JwtUnsafeConstruct() {
    exists(JwtBuilderCall builderCall |
      this.asExpr() = builderCall.getQualifier()
    )
  }
}

class JwtNoneAlgConfig extends DataFlow::Configuration {
  JwtNoneAlgConfig() { this = "JwtNoneAlgConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof JwtUnsafeConstruct
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("compact") and
      ma.getQualifier() = sink.asExpr() and
      not exists(SignWithCall signWith |
        signWith.getQualifier() = sink.asExpr().getParent().getParent()*()
      )
    )
  }

  override predicate isBarrier(DataFlow::Node barrier) { none() }
}

from DataFlow::Node jwtConstruct, DataFlow::Node compactCall, JwtNoneAlgConfig config
where config.hasFlow(jwtConstruct, compactCall)
select compactCall, 
  "Detected use of the 'none' algorithm in a JWT token. This allows token forgery.",
  jwtConstruct, "JWT builder called here without signature"
