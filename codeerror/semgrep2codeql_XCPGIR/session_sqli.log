Rule Content:
/**
 * @name find-sql-string-concatenation
 * @description In $METHOD, $X is used to construct a SQL query via string concatenation.
 * @kind path-problem
 * @problem.severity error
 * @id java/sql-string-concatenation
 * @tags security
 *       external/jboss
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.security.QueryInjection

class SqlStringConcatenationConfig extends TaintTracking::Configuration {
  SqlStringConcatenationConfig() { this = "SqlStringConcatenationConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      source.asParameter() = p and
      p.getType().hasName("java.lang.String")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("executeQuery") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      sink.asExpr() = ma.getQualifier() and
      exists(MethodAccess prepareStatementCall |
        prepareStatementCall.getMethod().hasName("prepareStatement") and
        prepareStatementCall.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection")
      )
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exprConcatenation(node1, node2)
    or
    stringConcatMethod(node1, node2)
  }
}

predicate exprConcatenation(DataFlow::Node node1, DataFlow::Node node2) {
  exists(BinaryExpr bin |
    bin.getOperatorKind() = ADD and
    (bin.getLeftOperand() = node1.asExpr() or bin.getRightOperand() = node1.asExpr()) and
    node2.asExpr() = bin
  )
}

predicate stringConcatMethod(DataFlow::Node node1, DataFlow::Node node2) {
  exists(MethodAccess ma |
    ma.getMethod().hasName("concat") and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
    ma.getAnArgument() = node1.asExpr() and
    node2.asExpr() = ma
  )
}

