/**
 * @name SQL injection vulnerability due to string concatenation
 * @description Detects when user input is directly concatenated into a SQL query.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.0
 * @precision high
 * @id java/find-sql-string-concatenation
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.JBoss

class SQLStringConcatConfig extends TaintTracking::Configuration {
  SQLStringConcatConfig() { this = "SQLStringConcatConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      source.asParameter() = p and
      p.getType().hasName("java.lang.String")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Call call |
      call.getCallee() = m and
      m.hasName("executeQuery") and
      m.getDeclaringType().hasName("java.sql.PreparedStatement") and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // String concatenation taint propagation
    exists(AddExpr add |
      (pred.asExpr() = add.getLeftOperand() and succ.asExpr() = add) or
      (pred.asExpr() = add.getRightOperand() and succ.asExpr() = add)
    ) or
    // Argument to argument propagation
    exists(Call call, int i, int j |
      pred.asExpr() = call.getArgument(i) and
      succ.asExpr() = call.getArgument(j)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Method m, Call call |
      call.getCallee() = m and
      m.getDeclaringType().getQualifiedName().matches("org.owasp.esapi.%") and
      call.getArgument(0) = node.asExpr()
    )
  }
}

