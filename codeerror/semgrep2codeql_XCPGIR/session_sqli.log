/**
 * @name SQL Injection from string concatenation
 * @description Detects SQL injection vulnerabilities caused by string concatenation of user input
 * @kind path-problem
 * @problem.severity error
 * @precision medium
 * @id java/sql-injection-string-concatenation
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.jboss.JBoss
import semmle.code.java.security.SqlInjectionQuery
import DataFlow::PathGraph

class StringParam extends DataFlow::Expr {
  StringParam() {
    exists(Method m, Parameter p | 
      m.getAParameter() = p and
      p.getType().hasName("String") and
      this.asParameter() = p
    )
  }
}

class PreparedStatementExecution extends DataFlow::Expr {
  PreparedStatementExecution() {
    exists(MethodAccess ma | 
      ma.getMethod().hasName("executeQuery") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      this = ma.getQualifier()
    )
  }
}

class SqlStringConcatenationConfig extends TaintTracking::Configuration {
  SqlStringConcatenationConfig() { this = "SqlStringConcatenationConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof StringParam
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasName({"prepareStatement", "createStatement"}) and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      sink.asExpr() = ma.getQualifier()
    ) or
    sink.asExpr() instanceof PreparedStatementExecution
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(StringConcatenation sc | 
      node1.asExpr().(StringConcatenation).getAnOperand() = node2.asExpr()
    ) or
    exists(Assignment assign |
      assign.getDest() = node1.asExpr() and
      assign.getSource() = node2.asExpr()
    )
  }
}

