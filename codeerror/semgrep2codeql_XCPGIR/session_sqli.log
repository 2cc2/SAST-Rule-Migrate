/**
 * @name find-sql-string-concatenation
 * @description Detects SQL query construction via string concatenation in Java with JBoss.
 * @kind path-problem
 * @problem.severity error
 * @id java/sql-string-concatenation
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.JBoss
import DataFlow::PathGraph

class SqlStringSource extends DataFlow::Expr {
  SqlStringSource() {
    exists(MethodParameter p |
      p.getName().matches("%X") and
      this.asParameter() = p
    )
  }
}

class SqlStringSink extends DataFlow::Expr {
  SqlStringSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "executeQuery" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      this = ma.getArgument(0)
    )
  }
}

class SqlStringFlowConfig extends TaintTracking::Configuration {
  SqlStringFlowConfig() { this = "SqlStringFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof SqlStringSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asExpr() instanceof SqlStringSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Handle string concatenation
    exists(MethodAccess concat |
      concat.getMethod().hasQualifiedName("java.lang", "String", "concat") and
      node1.asExpr() = concat.getArgument(0) and
      node2.asExpr() = concat
    )
    or
    // Handle parameter to local variable flow
    exists(LocalVariableDecl lvd |
      node1.asParameter() = lvd.getAnAccess() and
      node2.asVariable() = lvd.getVariable()
    )
  }

  override predicate isBarrier(DataFlow::Node node) {
    none()
  }
}

