/**
 * @name SQL injection vulnerability due to string concatenation
 * @description Detects when user input is directly concatenated into a SQL query.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.0
 * @precision high
 * @id java/unsafe-sql-concatenation
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jboss.JBoss

class UnsafeSQLConcatenationConfig extends TaintTracking::Configuration {
  UnsafeSQLConcatenationConfig() { this = "UnsafeSQLConcatenationConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(MethodParameter p |
      source.asParameter() = p and
      p.getType().hasName("java.lang.String")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "executeQuery" and
      ma.getMethod().getDeclaringType().hasName("java.sql.PreparedStatement") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // String concatenation taint propagation
    exists(BinaryExpr concat |
      (concat.getOp() instanceof Add or concat.getOp() instanceof Concat) and
      (pred.asExpr() = concat.getLeftOperand() and succ.asExpr() = concat) or
      (pred.asExpr() = concat.getRightOperand() and succ.asExpr() = concat)
    ) or
    // Argument to argument propagation
    exists(MethodAccess ma, int i, int j |
      pred.asExpr() = ma.getArgument(i) and
      succ.asExpr() = ma.getArgument(j)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getArgument(0) = node.asExpr() and
      ma.getMethod().getDeclaringType().hasName("org.owasp.esapi.Encoder")
    )
  }
}

from UnsafeSQLConcatenationConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization in $@", 
  source.getNode(), source.getVerboseString(),
  sink.getNode(), sink.getVerboseString()
