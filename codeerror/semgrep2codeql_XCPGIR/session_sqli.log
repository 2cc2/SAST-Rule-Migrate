/**
 * @name find-sql-string-concatenation
 * @description In $METHOD, $X is used to construct a SQL query via string concatenation.
 * @kind path-problem
 * @id java/sql-string-concatenation
 * @severity error
 * @tags security
 *       external/jboss
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class SqlStringConcatenationConfig extends TaintTracking::Configuration {
  SqlStringConcatenationConfig() {
    this = "SqlStringConcatenationConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Operation op, AssignExpr assign |
      assign.getRValue() = op and
      (
        op.getRightOperand().toString().matches(".*\\+\\s*\\$X\\s*\\+.*") or
        op.getLeftOperand().toString().matches(".*\\+\\s*\\$X\\s*\\+.*")
      ) and
      source.asExpr() = assign.getRValue()
