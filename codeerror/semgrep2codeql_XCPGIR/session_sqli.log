/**
 * @name find-sql-string-concatenation
 * @description In $METHOD, $X is used to construct a SQL query via string concatenation.
 * @kind problem
 * @problem.severity error
 * @id java/sql-string-concatenation
 * @tags security
 *       external/jboss
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jboss.JBossClasses

class SqlStringConcatenationConfig extends TaintTracking::Configuration {
  SqlStringConcatenationConfig() { this = "SqlStringConcatenationConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodParameter p |
      source.asParameter() = p and
      p.getType().hasName("java.lang.String")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "executeQuery" and
      ma.getQualifier().getType().getSourceDeclaration().getQualifiedName() = "java.sql.PreparedStatement" and
      sink.asExpr() = ma.getQualifier() and
      exists(MethodAccess prepareStatementCall |
        prepareStatementCall.getMethod().getName() = "prepareStatement" and
        prepareStatementCall.getQualifier().getType().getSourceDeclaration().getQualifiedName() = "java.sql.Connection"
      )
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "concat" and ma.getMethod().getDeclaringType().hasName("java.lang.String")) or
      (ma.getMethod().getName() = "plus" and ma.getMethod().getDeclaringType().hasName("java.lang.String"))
      and
      node1.asExpr() = ma.getAnArgument() and
      node2.asExpr() = ma
    )
  }
}

