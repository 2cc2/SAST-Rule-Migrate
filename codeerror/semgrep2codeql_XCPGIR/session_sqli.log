/**
 * @name find-sql-string-concatenation
 * @description In $METHOD, $X is used to construct a SQL query via string concatenation.
 * @kind path-problem
 * @id java/sql-string-concatenation
 * @severity error
 * @tags security
 *       external/jboss
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jboss.JBoss

class SqlStringConcatenationConfig extends TaintTracking::Configuration {
  SqlStringConcatenationConfig() {
    this = "SqlStringConcatenationConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(AssignmentExpr assign |
      source.asExpr() = assign.getRightOperand() and
      exists(stringAddition |
        stringAddition.getRightOperand().toString().matches("%\\+\\s*\\$X\\s*\\+%") or
        stringAddition.getLeftOperand().toString().matches("%\\+\\s*\\$X\\s*\\+%") and
        source.asExpr() = stringAddition
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall mc |
      mc.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      mc.getMethod().hasName("executeQuery") and
      sink.asExpr() = mc.getArgument(0)
    )
  }
}

