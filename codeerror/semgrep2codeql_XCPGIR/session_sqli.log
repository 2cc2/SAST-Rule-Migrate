      m.hasName("executeQuery") and
      m.getDeclaringType().getSourceDeclaration().hasQualifiedName("java.sql", "PreparedStatement") and
      ma.getMethod() = m and
      sink.asExpr() = ma.getQualifier() and
      exists(Method prepareStatementMethod |
        prepareStatementMethod.hasName("prepareStatement") and
