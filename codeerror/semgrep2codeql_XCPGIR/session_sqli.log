/**
 * @name find-sql-string-concatenation
 * @description In $METHOD, $X is used to construct a SQL query via string concatenation.
 * @kind problem
 * @id java/sql-string-concatenation
 * @severity error
 * @tags security
 *       external/jboss
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow

class SqlStringConcatenation extends TaintTracking::Configuration {
  SqlStringConcatenation() {
    this = "SqlStringConcatenation"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(AssignmentExpr assign |
      source.asExpr() = assign.getRightOperand() and
      exists(MethodAccess ma | 
        ma.getMethod().getName().matches("%.+\\+\\s*\\$X\\s*\\+%") and
        source.asExpr() = ma
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess executeQuery |
      executeQuery.getMethod().getDeclaringType() instanceof TypeSqlPreparedStatement and
      executeQuery.getMethod().hasName("executeQuery") and
      sink.asExpr() = executeQuery.getArgument(0)
    )
  }
}

