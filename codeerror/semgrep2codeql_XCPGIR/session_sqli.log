Rule Content:
/**
 * @name SQL Injection via String Concatenation
 * @description Detects SQL injection vulnerabilities caused by string concatenation
 * @kind path-problem
 * @problem.severity error
 * @id java/sql-string-concatenation
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.JavaSql

class StringParameterSource extends DataFlow::Node {
  StringParameterSource() {
    exists(Method m, Parameter p |
      p.getType().hasName("java.lang.String") and
      this.asParameter() = p
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "executeQuery" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class StringConcatTaintStep extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(BinaryExpr expr |
      expr.getOperator() = BinaryExpr::PLUS and
      pred.asExpr() = expr.getLeftOperand() and
      succ.asExpr() = expr
    )
  }
}

class QueryPropagationTaintStep extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(AssignStmt assign, LocalVariableAccess lva |
      pred.asExpr() = assign.getRValue() and
      succ.asExpr() = lva and
      lva.getVariable() = assign.getLValue()
    ) or
    exists(VariableAccess va |
      pred.asExpr() = va.getVariable().getAnAssignedValue() and
      succ.asExpr() = va
    )
  }
}

class SqlStringConcatConfig extends TaintTracking::Configuration {
  SqlStringConcatConfig() {
    this = "SqlStringConcatConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    pred instanceof StringConcatTaintStep or
    pred instanceof QueryPropagationTaintStep
  }

  override predicate isBarrier(DataFlow::Node node) {
    exists(ReturnStmt ret | node.asExpr() = ret.getExpr())
  }
}

from SqlStringConcatConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, 
  "In $@, user input reaches SQL execution via string concatenation.", source.getNode(),
  "User input flows to SQL execution"
