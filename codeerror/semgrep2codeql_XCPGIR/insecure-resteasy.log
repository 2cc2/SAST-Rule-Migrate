Rule Content:
/**
 * @name Insecure RESTEasy deserialization
 * @description Detects insecure RESTEasy deserialization through wildcard media type or missing @Consumes annotation
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @precision medium
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08-2017
 *       external/owasp/a08-2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jaxrs.JaxRsAnnotations
import semmle.code.java.frameworks.resteasy.ResteasyProviders

class InsecureDeserializationConfig extends TaintTracking::Configuration {
  InsecureDeserializationConfig() { 
    this = "InsecureRestEasyDeserializationConfig" 
  }

  override predicate isSource(DataFlow::Node source) {
    // Source 1: Wildcard consumes annotation
    exists(Annotation consumesAnnotation |
      consumesAnnotation.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      (
        exists(consumesAnnotation.getLiteralValue().toString() as valueStr |
          valueStr.regexpMatch("(application/x-java-serialized-object|\\*/\\*|MediaType\\.WILDCARD_TYPE)")
        )
        or
        consumesAnnotation.toString().matches("MediaType.WILDCARD_TYPE")
      ) and
      source.asAnnotation() = consumesAnnotation
    )
    or
    // Source 2: Missing consumes annotation on JAX-RS method
    exists(Method m |
      exists(Annotation pathAnnot | 
        pathAnnot = m.getAnAnnotation() and
        pathAnnot.getType().hasQualifiedName("javax.ws.rs", "Path")
      ) and
      not exists(m.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "Consumes")) and
      source.asMethod() = m
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("org.jboss.resteasy.providers", "SerializationProvider") and
      sink.asExpr() = call
    )
  }
}

from InsecureDeserializationConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Potential insecure deserialization vulnerability via RESTEasy provider. " +
  if source.getNode() instanceof Annotation then 
    "Wildcard media type leads to potential deserialization vulnerability"
  else 
    "Missing @Consumes annotation leads to default deserialization behavior"
  endif,
  source, sink,
  "Vulnerable deserialization call"
