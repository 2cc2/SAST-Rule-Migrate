/**
 * @name Insecure RESTEasy deserialization
 * @description Detects potential insecure deserialization via RESTEasy endpoint due to wildcard media type or missing Consumes annotation
 * @kind problem
 * @id java/insecure-resteasy-deserialization
 * @severity Warning
 */

import java
import JaxRs

// Source: Wildcard Consumes annotation
predicate isWildcardConsumes(Annotation a) {
  exists(Method m |
    a = m.getAnAnnotation() and
    a.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
    (
      a.getAValue().toString().regexpMatch("application/x-java-serialized-object|\\*/\\*") or
      a.getAValue().toString() = "MediaType.WILDCARD_TYPE"
    )
  )
}

// Source: Missing Consumes annotation
predicate hasNoConsumesAnnotation(Method m) {
  not exists(Annotation a |
    a = m.getAnAnnotation() and
    a.getType().hasQualifiedName("javax.ws.rs", "Consumes")
  )
}

// Sink: REST endpoint with Path annotation
predicate isRestEndpoint(Method m) {
  exists(Annotation a |
    a = m.getAnAnnotation() and
    a.getType().hasQualifiedName("javax.ws.rs", "Path")
  )
}

from Method m, Annotation a
where 
  (
    (isWildcardConsumes(a) and a.getParent() = m) or
    (hasNoConsumesAnnotation(m))
  ) and
  isRestEndpoint(m)
select m, "Potential insecure deserialization via RESTEasy endpoint"
