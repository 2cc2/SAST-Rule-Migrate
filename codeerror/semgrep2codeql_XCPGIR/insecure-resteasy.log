    which may lead to arbitrary code execution.
scope:
  languages: [java]
  frameworks: ["jax-rs"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: WILDCARD_CONSUMES
    match:
      node: ANNOTATION
      type:
        name: javax.ws.rs.Consumes
        match: exact
      where:
        - op: in
          left: value
          right: ["*/*", "application/x-java-serialized-object", "MediaType.WILDCARD_TYPE"]

  - id: MISSING_CONSUMES
    match:
      node: METHOD
      where:
        - op: not
          exists:
            match:
              node: ANNOTATION
              type:
                name: javax.ws.rs.Consumes
                match: exact
        - op: exists
          exists:
            match:
              node: ANNOTATION
              type:
                name: javax.ws.rs.Path
                match: exact

sinks:
  - id: DESERIALIZATION_SINK
    match:
      node: METHOD
      api:
        package: org.jboss.resteasy.core.interception
        type: SerializationProvider
        method: readFrom
      arg_index: 0

flows:
  - source: WILDCARD_CONSUMES
    sink: DESERIALIZATION_SINK
    constraints:
      path:
        must: [ { pattern: "CALL(SerializationProvider.readFrom)" } ]

  - source: MISSING_CONSUMES
    sink: DESERIALIZATION_SINK
    constraints:
      path:
        must: [ { pattern: "CALL(SerializationProvider.readFrom)" } ]

report:
  message: "Potential insecure deserialization in Resteasy endpoint"
  locations: ["source", "sink"]
  evidence:
    capture:
      - annotation: "@Consumes"
      - method: "readFrom"

tests:
  positive:
    - "@Consumes({\"*/*\"}) public Response endpoint(...) {...}"
    - "@Path(\"/test\") public Response endpoint(...) {...}"
  negative:
    - "@Consumes({\"application/json\"}) public Response endpoint(...) {...}"
