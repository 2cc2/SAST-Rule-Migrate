Rule Content:
/**
 * @name Insecure Resteasy Deserialization
 * @description Detects unsafe deserialization in Resteasy endpoints using wildcard mediaType
 *              or missing @Consumes annotation, which may lead to arbitrary code execution.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       external/cwe/cwe-502
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jaxrs.JaxRsAnnotations

predicate isWildcardConsumes(Annotation consumes) {
  exists(ArrayInit arrayInit |
    consumes.getValue() = arrayInit and
    exists(Expr value |
      arrayInit.getAnInit() = value and
      value.toString() = "*/*" or
      value.toString() = "application/x-java-serialized-object" or
      value.toString() = "MediaType.WILDCARD_TYPE"
    )
  )
}

predicate missingConsumesAnnotation(Method m) {
  exists(Annotation path |
    m.getAnAnnotation(path) and
    path.getType().hasQualifiedName("javax.ws.rs", "Path") and
    not exists(Annotation consumes |
      m.getAnAnnotation(consumes) and
      consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes")
    )
  )
}

class SerializationProviderReadFrom extends TaintTracking::Sink {
  SerializationProviderReadFrom() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("readFrom") and
      ma.getMethod().getDeclaringType().hasQualifiedName(
        "org.jboss.resteasy.core.interception", 
        "SerializationProvider"
      ) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class WildcardConsumesSource extends TaintTracking::Source {
  WildcardConsumesSource() {
    exists(Annotation consumes |
      consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      isWildcardConsumes(consumes) and
      this.asExpr() = consumes
    )
  }
}

class MissingConsumesSource extends TaintTracking::Source {
  MissingConsumesSource() {
    exists(Method m |
      missingConsumesAnnotation(m) and
      this.asExpr() = m
    )
  }
}

class InsecureResteasyDeserializationConfig extends TaintTracking::Configuration {
  InsecureResteasyDeserializationConfig() { this = "InsecureResteasyDeserializationConfig" }
  
  override predicate isSource(TaintTracking::Source source) {
    source instanceof WildcardConsumesSource or
    source instanceof MissingConsumesSource
  }
  
  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof SerializationProviderReadFrom
  }
}

from InsecureResteasyDeserializationConfig config, TaintTracking::PathNode source, TaintTracking::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential insecure deserialization in Resteasy endpoint ("+
    (source.getNode() instanceof WildcardConsumesSource ? 
      "wildcard consumes annotation" : "missing consumes annotation") + ")",
  source.getNode(), "Source annotation here",
  sink.getNode(), "Deserialization call here"
