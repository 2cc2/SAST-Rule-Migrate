Rule Content:
/**
 * @name Insecure RESTEasy deserialization
 * @description Detects insecure RESTEasy deserialization through wildcard media type or missing @Consumes annotation
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @precision medium
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.jaxrs.JaxRs
import semmle.code.java.frameworks.resteasy.Resteasy

class InsecureDeserializationConfig extends TaintTracking::Configuration {
  InsecureDeserializationConfig() { this = "InsecureRestEasyDeserializationConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Source 1: Wildcard consumes annotation
    exists(Annotation consumesAnnotation |
      consumesAnnotation.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      (
        consumesAnnotation.getAValue().regexpMatch("(application/x-java-serialized-object|\\*/\\*|MediaType\\.WILDCARD_TYPE)") or
        consumesAnnotation.getValue().toString() = "MediaType.WILDCARD_TYPE"
      ) and
      source.asExpr() = consumesAnnotation.getAnnotationValue()
    )
    or
    // Source 2: Missing consumes annotation on JAX-RS method
    exists(Method m |
      m.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "Path") and
      not exists(m.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "Consumes")) and
      source.asExpr() = m.getAnAnnotation()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.jboss.resteasy.providers", "SerializationProvider") and
      sink.asExpr() = ma
    )
  }
}

from InsecureDeserializationConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Potential insecure deserialization vulnerability via RESTEasy provider. " +
  case
    when source.getNode() instanceof Annotation then "Wildcard media type leads to potential deserialization vulnerability"
    else "Missing @Consumes annotation leads to default deserialization behavior"
  end,
  source, sink,
  "Vulnerable deserialization call"
