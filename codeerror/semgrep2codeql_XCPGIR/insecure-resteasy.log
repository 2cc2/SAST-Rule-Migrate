Rule Content:
/**
 * @name Insecure Resteasy deserialization via wildcard consumes
 * @description Detects insecure deserialization through wildcard consumes annotation
 * @kind problem
 * @id java/insecure-resteasy-deserialization
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-502
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.jaxrs.JaxRsAnnotations

class WildcardConsumesAnnotation extends Annotation {
  WildcardConsumesAnnotation() {
    this.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
    this.getValue().regexpMatch('.*("\\*/\\*"|MediaType\\.WILDCARD_TYPE).*')
  }
}

class SerializedConsumesAnnotation extends Annotation {
  SerializedConsumesAnnotation() {
    this.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
    this.getValue().regexpMatch('.*application/x-java-serialized-object.*')
  }
}

class SafeConsumesAnnotation extends Annotation {
  SafeConsumesAnnotation() {
    this.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
    not this.getValue().regexpMatch('.*(\\*/\\*|application/x-java-serialized-object).*')
  }
}

class SerializableProviderReadFrom extends MethodAccess {
  SerializableProviderReadFrom() {
    exists(Method m | 
      m.hasQualifiedName("org.jboss.resteasy.plugins.providers", "SerializableProvider", "readFrom") and
      this.getMethod() = m
    )
  }
}

class RouteWithWildcardConsumes extends DataFlow::Node {
  RouteWithWildcardConsumes() {
    exists(Method m | 
      m.getAnAnnotation() instanceof WildcardConsumesAnnotation and
      this.asParameter() = m.getAParameter()
    )
  }
}

class RouteWithSerializedConsumes extends DataFlow::Node {
  RouteWithSerializedConsumes() {
    exists(Method m | 
      m.getAnAnnotation() instanceof SerializedConsumesAnnotation and
      this.asParameter() = m.getAParameter()
    )
  }
}

predicate isSafe(Method m) {
  exists(SafeConsumesAnnotation a | a.getAnnotatedElement() = m)
}

from Method m, MethodAccess ma, DataFlow::Node source, DataFlow::Node sink
where
  (
    (source instanceof RouteWithWildcardConsumes or source instanceof RouteWithSerializedConsumes) and
    ma instanceof SerializableProviderReadFrom and
    sink.asExpr() = ma and
    DataFlow::localFlow(source, sink)
  ) and not isSafe(m)
select ma, "Insecure deserialization possible via wildcard media type consumes annotation"

/**
 * @name Missing Consumes annotation may lead to insecure deserialization
 * @description Detects missing consumes annotation that may allow deserialization attacks
 * @kind problem
 * @id java/missing-resteasy-consumes
 * @security-severity 7.5
 * @tags security
 *       external/cwe/cwe-502
 */

class NoConsumesAnnotation extends Method {
  NoConsumesAnnotation() {
    not exists(Annotation a |
      a.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      a.getAnnotatedElement() = this
    )
  }
}

class HasConsumesAnnotation extends Method {
  HasConsumesAnnotation() {
    exists(Annotation a |
      a.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      a.getAnnotatedElement() = this
    )
  }
}

from Method m, MethodAccess ma, DataFlow::Node source, DataFlow::Node sink
where
  (
    m instanceof NoConsumesAnnotation and
    ma instanceof SerializableProviderReadFrom and
    sink.asExpr() = ma and
    DataFlow::localFlow(source, sink) and
    source.asParameter() = m.getAParameter()
  ) and not exists(HasConsumesAnnotation hasConsumes | hasConsumes = m)
select ma, "Missing @Consumes annotation may allow deserialization attacks"
