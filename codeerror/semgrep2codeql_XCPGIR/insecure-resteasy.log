Rule Content:
/**  
 * @name Insecure Resteasy Deserialization
 * @description Detects unsafe deserialization in Resteasy endpoints using wildcard mediaType
 *              or missing @Consumes annotation, which may lead to arbitrary code execution.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       external/cwe/cwe-502
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.jaxrs.JaxRs

predicate isWildcardConsumes(Annotation consumes) {
  exists(string value |
    consumes.getValue().(ArrayInit).getValues().getValue().toString() = "*/*" or
    consumes.getValue().(ArrayInit).getValues().getValue().toString() = "application/x-java-serialized-object" or
    consumes.getValue().(ArrayInit).getValues().getValue().toString() = "MediaType.WILDCARD_TYPE"
  )
}

predicate missingConsumesAnnotation(Method m) {
  exists(Annotation path |
    m.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "Path") and
    path.getAnAnnotation() = this and
    not exists(m.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "Consumes"))
  )
}

class SerializationProviderReadFrom extends DataFlow::Node {
  SerializationProviderReadFrom() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("readFrom") and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.jboss.resteasy.core.interception", "SerializationProvider") and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class WildcardConsumesSource extends DataFlow::Node {
  WildcardConsumesSource() {
    exists(Annotation consumes |
      consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      isWildcardConsumes(consumes) and
      this.asExpr() = consumes
    )
  }
}

class MissingConsumesSource extends DataFlow::Node {
  MissingConsumesSource() {
    exists(Method m |
      missingConsumesAnnotation(m) and
      this.asExpr() = m.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "Path")
    )
  }
}

class InsecureResteasyDeserializationConfig extends DataFlow::Configuration {
  InsecureResteasyDeserializationConfig() { this = "InsecureResteasyDeserializationConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof WildcardConsumesSource or
    source instanceof MissingConsumesSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SerializationProviderReadFrom
  }
}

from InsecureResteasyDeserializationConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential insecure deserialization in Resteasy endpoint with " +
  (source.getNode() instanceof WildcardConsumesSource ?
    "wildcard consumes annotation" : "missing consumes annotation") +
  ", which may lead to arbitrary code execution.",
  source.getNode(), "Source annotation here",
  sink.getNode(), "Deserialization call here"
