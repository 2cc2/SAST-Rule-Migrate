Rule Content:
/**
 * @name GCM usage detection
 * @description Detects GCM usage and checks for potential IV/nonce reuse issues. 
 *              Initialization Vector (IV) should be random and unique to prevent
 *              security vulnerabilities when encrypting multiple plaintext blocks.
 * @kind path-problem
 * @problem.severity information
 * @security-severity 8.8
 * @precision high
 * @id java/gcm-detection
 * @tags security
 *       external/cwe/cwe-329
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class GCMInstance extends MethodAccess {
  GCMInstance() {
    this.getMethod().hasName("getInstance") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
    this.getArgument(0).(StringLiteral).getValue() = "AES/GCM/NoPadding"
  }
}

class GCMParameterSpec extends ConstructorAccess {
  GCMParameterSpec() {
    this.getConstructor().getDeclaringType().hasQualifiedName("javax.crypto.spec", "GCMParameterSpec")
  }
}

class CipherUsage extends MethodAccess {
  CipherUsage() {
    this.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
    (
      this.getMethod().hasName("init") or
      this.getMethod().hasName("doFinal") or
      this.getMethod().hasName("update")
    )
  }
}

class GCMConfig extends TaintTracking::Configuration {
  GCMConfig() { this = "GCMConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(GCMInstance gcm | source.asExpr() = gcm.getQualifier()) or
    exists(GCMParameterSpec gcmParam | source.asExpr() = gcmParam)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(CipherUsage usage | sink.asExpr() = usage.getQualifier())
  }
}

from GCMConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(), 
  "GCM usage detected - check for IV/nonce reuse. $@ flows to $@.",
  source.getNode(), "Source", sink.getNode(), "Sink"
