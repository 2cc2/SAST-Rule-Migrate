/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class JdoSqlInjectionConfig extends TaintTracking::Configuration {
  JdoSqlInjectionConfig() { this = "JdoSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, MethodAccess ma |
      // Source: String.format()
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getMethod() = m and
      source.asExpr() = ma.getArgument(0)
    )
    or
    exists(Variable v, Expr rhs |
      // Source: String concatenation in SQL assignment
      rhs.toString().matches("%String \\$SQL = .*\\+.*%") and
      v.getAnAccess() = source.asExpr() and
      exists(AssignStmt assign | assign.getRValue() = rhs | assign.getLValue() = v.getAnAccess())
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, MethodAccess ma |
      (
        // Sink: JDO Query.setFilter() or setGrouping()
        m.hasName(["setFilter", "setGrouping"]) and
        m.getDeclaringType().hasQualifiedName("javax.jdo", "Query") and
        ma.getMethod() = m and
        sink.asExpr() = ma.getArgument(0)
      )
      or
      (
        // Sink: JDO PersistenceManager.newQuery()
        m.hasName("newQuery") and
        m.getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager") and
        ma.getMethod() = m and
        sink.asExpr() = ma.getArgument(1)
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Expr rhs |
      // Sanitizer: Literal string concatenation
      rhs.toString().matches("%String \\$SQL = \".*\" \\+ \".*\"%") and
      node.asExpr() = rhs
    )
  }
}

