          right: 'String \\$SQL = ".*" \\+ ".*"'

propagations:
  - id: ASSIGN_TO_VAR
    edge: arg->param
    kind: taint
  - id: VAR_TO_ARG
    edge: arg->param
    kind: taint

flows:
