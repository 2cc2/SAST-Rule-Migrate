import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat

class JdoSqlInjectionConfig extends TaintTracking::Configuration {
  JdoSqlInjectionConfig() { this = "JdoSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Source 1: String.format() calls
    exists(Method m, MethodAccess ma |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getMethod() = m and
      source.asExpr() = ma
    )
    or
    // Source 2: String concatenation assignments matching pattern
    exists(AssignExpr assign, Expr concatExpr |
      assign.getRExpr() = concatExpr and
      concatExpr instanceof AddExpr and
      exists(Variable v |
        assign.getLExpr() = v.getAnAccess() and
        v.getType().hasName("String") and
        assign.toString().matches("String\\s+\\w+\\s*=\\s*\\w+\\s*\\+\\s*\\w+") and
        source.asExpr() = concatExpr
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // Sink 1: javax.jdo.Query setFilter/setGrouping calls
    exists(Method m, MethodAccess ma |
      (m.hasName("setFilter") or m.hasName("setGrouping")) and
      m.getDeclaringType().hasQualifiedName("javax.jdo", "Query") and
      ma.getMethod() = m and
      sink.asExpr() = ma.getArgument(0)
    )
    or
    // Sink 2: javax.jdo.PersistenceManager newQuery calls
    exists(Method m, MethodAccess ma |
      m.hasName("newQuery") and
      m.getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager") and
      ma.getMethod() = m and
      ma.getNumArgument() > 0 and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Static string literals are sanitizers
    exists(StringLiteral sl | sanitizer.asExpr() = sl)
  }
}

