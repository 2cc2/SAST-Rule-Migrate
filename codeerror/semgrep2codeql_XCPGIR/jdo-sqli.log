/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class JdoSqlInjectionConfig extends TaintTracking::Configuration {
  JdoSqlInjectionConfig() { this = "JdoSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      // Source: String.format()
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      source.asExpr() = ma.getArgument(0)
    )
    or
    exists(AssignmentAssign ast, Variable v |
      // Source: String concatenation in SQL assignment
      ast.getRightOperand().toString().matches("%String \\$SQL = .*\\+.*%") and
      v.getAnAccess() = source.asDef()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      // Sink: JDO Query.setFilter() or setGrouping()
      (
        ma.getMethod().hasName(["setFilter", "setGrouping"]) and
        ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "Query") and
        sink.asExpr() = ma.getArgument(0)
      )
      or
      // Sink: JDO PersistenceManager.newQuery()
      (
        ma.getMethod().hasName("newQuery") and
        ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager") and
        sink.asExpr() = ma.getArgument(1)
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AssignmentAssign ast |
      // Sanitizer: Literal string concatenation
      ast.getRightOperand().toString().matches('String \\$SQL = ".*" \\+ ".*"') and
      sanitizer.asExpr() = ast.getRightOperand()
    )
  }
}

from JdoSqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected a formatted string in a SQL statement. This could lead to SQL injection " +
  "if variables in the SQL statement are not properly sanitized. " +
  "Use prepared statements (java.sql.PreparedStatement) instead."
