/**
 * @id spring-actuator-dangerous-endpoints-enabled
 * @severity WARNING
 * @kind problem
 * @name Potentially dangerous actuator endpoints are exposed
 * @description Detects when potentially dangerous Spring Actuator endpoints are enabled
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringActuator

class DangerousEndpointConfig extends DataFlow::Node {
  DangerousEndpointConfig() {
    exists(FieldRead read |
      read.getField().getName().matches("prometheus|logfile") and
      this.asExpr() = read.getVariable()
    )
  }
}

