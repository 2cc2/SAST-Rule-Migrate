class HostnameVerifierType extends RefType {
  HostnameVerifierType() {
    this.hasQualifiedName("javax.net.ssl", "HostnameVerifier")
  }
}

// Main query
from Method verifyMethod, Class verifierClass
where
  // Check if class implements HostnameVerifier interface
  verifierClass.getASupertype*() instanceof HostnameVerifierType and
  // Check if method is named 'verify'
  verifyMethod.getName() = "verify" and
  // Check if method belongs to the implementing class
  verifyMethod.getDeclaringType() = verifierClass and
  // Check if method always returns true
  exists(ReturnStmt rs |
    rs.getEnclosingCallable() = verifyMethod and
    rs.getExpr() instanceof BooleanLiteral and
    rs.getExpr().(BooleanLiteral).booleanValue() = true
  )
select verifyMethod, "Insecure HostnameVerifier implementation detected. This will accept any SSL certificate with any hostname, which creates the possibility for man-in-the-middle attacks."
