/**
 * @name Insecure HostnameVerifier
 * @description Detects insecure HostnameVerifier implementations that accept any SSL certificate,
 *              creating potential for man-in-the-middle attacks.
 * @id insecure-hostname-verifier
 * @kind problem
 * @precision medium
 * @severity warning
 * @tags security
 *       external/cwe/cwe-295
 */

import java

// Detect insecure verify methods overriding HostnameVerifier.verify that always return true
class InsecureHostnameVerifier extends Method {
  InsecureHostnameVerifier() {
    this.getName() = "verify" and
    this.getDeclaringType().getASupertype*().hasQualifiedName("javax.net.ssl", "HostnameVerifier") and
    exists(ReturnStmt rs |
      rs.getEnclosingCallable() = this and
      rs.getResult().(BooleanLiteral).getValue() = true
    )
  }
}

// Detect imports of NoopHostnameVerifier
class NoopHostnameVerifierImport extends CompilationUnit {
  NoopHostnameVerifierImport() {
    exists(ImportType it |
      it.getImportedType().hasQualifiedName("org.apache.http.conn.ssl", "NoopHostnameVerifier")
    )
  }
}

from InsecureHostnameVerifier ihv
select ihv, "Insecure HostnameVerifier implementation detected. This will accept any SSL certificate with any hostname, which creates the possibility for man-in-the-middle attacks."

from NoopHostnameVerifierImport nvi
select nvi, "Insecure HostnameVerifier implementation detected (NoopHostnameVerifier import). This will accept any SSL certificate with any hostname, which creates the possibility for man-in-the-middle attacks."
