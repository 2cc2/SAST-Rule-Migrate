/**
 * @name Insecure HostnameVerifier Implementation
 * @description Detects insecure HostnameVerifier implementations that accept any SSL certificate,
 *              which creates the possibility for man-in-the-middle attacks
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-hostname-verifier
 * @tags security
 *       external/cwe/cwe-295
 */

import java

// 1. Find all implementations of HostnameVerifier interface
from Class hostnameVerifier, Method verifyMethod
where
  // 1.1 Class implements HostnameVerifier interface
  hostnameVerifier.getASupertype() instanceof TypeHostnameVerifier and
  // 1.2 Method is named 'verify'
  verifyMethod.getName() = "verify" and
  // 1.3 Method belongs to the HostnameVerifier class
  verifyMethod.getDeclaringType() = hostnameVerifier and
  // 1.4 Method always returns true (vulnerable implementation)
  exists(ReturnStmt rs |
    rs.getExpr() instanceof BooleanLiteral and
    rs.getExpr().(BooleanLiteral).getValue() = true and
    rs.getEnclosingCallable() = verifyMethod
  )
select verifyMethod, "Insecure HostnameVerifier implementation detected. This will accept any SSL certificate with any hostname, which creates the possibility for man-in-the-middle attacks."

// Define HostnameVerifier type
class TypeHostnameVerifier extends RefType {
  TypeHostnameVerifier() {
    this.hasQualifiedName("javax.net.ssl", "HostnameVerifier")
  }
}
