/**
 * @name Insecure HostnameVerifier
 * @description Detects insecure HostnameVerifier implementations that accept any SSL certificate,
 *              creating potential for man-in-the-middle attacks.
 * @id insecure-hostname-verifier
 * @kind problem
 * @severity warning
 */

import java

// Detect insecure verify methods that always return true
predicate isInsecureVerify(Method m) {
  m.getName() = "verify" and 
  m.getDeclaringType().getASupertype*().hasQualifiedName("javax.net.ssl", "HostnameVerifier") and
  exists(MethodAccess ma | 
    ma.getMethod() = m and
    ma.getEnclosingMethod().getBody().toString() = "return true;"
  )
}

// Detect imports of NoopHostnameVerifier
predicate importsNoopVerifier(CompilationUnit cu) {
  exists(ImportType it | 
    it.getImportedType().hasQualifiedName("org.apache.http.conn.ssl", "NoopHostnameVerifier") and
    it.getCompilationUnit() = cu
  )
}

from Method m, CompilationUnit cu
where 
  isInsecureVerify(m) or 
  importsNoopVerifier(cu)
select 
  cu, 
  "Insecure HostnameVerifier implementation detected. This will accept any SSL certificate with any hostname, which creates the possibility for man-in-the-middle attacks."
