Rule Content:
/**
 * @name Spring 未验证的重定向漏洞
 * @description 检测Spring应用中未经验证的用户输入用于重定向的情况
 * @id java/spring-unvalidated-redirect
 * @kind path-problem
 * @severity warning
 * @tags security
 * @precision high
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.Spring

class StringParameter extends TaintTracking::Source {
  StringParameter() {
    exists(Parameter p | 
      p.getType().hasName("String") and
      this.asParameter() = p
    )
  }
}

class RedirectSink extends TaintTracking::Sink {
  RedirectSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("org.springframework.web.servlet", "ModelAndView") and
      cc.getArgument(0).toString().matches("^redirect:.*") and
      this.asExpr() = cc.getArgument(0)
    )
    or
    exists(ReturnStmt rs |
      rs.getResult().toString().matches("^redirect:.*") and
      this.asExpr() = rs.getResult()
    )
  }
}

class MethodTaintStep extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Method m | 
      (pred.asParameter() = m.getAParameter() and succ.asExpr() = m.getACall().getResult())
      or
      (pred.asParameter() = m.getAParameter() and succ.asParameter() = m.getThisParameter())
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(StringParameter sp | source.getNode() = sp) and
  exists(RedirectSink rs | sink.getNode() = rs) and
  TaintTracking::localTaint(DataFlow::exprNode(source.getNode()), DataFlow::exprNode(sink.getNode()), 0, new MethodTaintStep())
select sink, source, 
  "未经验证的重定向: 用户输入被直接用作重定向目标",
  source.getNode(), "用户输入来自这里",
  sink.getNode(), "未经验证的重定向到这里"
================================================================================
