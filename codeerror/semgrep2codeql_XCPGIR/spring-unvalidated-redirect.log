Rule Content:
/**
 * @name Spring 未经验证的重定向
 * @description 应用将用户重定向到用户提供的未经验证的目标URL
 * @kind problem
 * @id java/spring-unvalidated-redirect
 * @severity warning
 * @tags security
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringController
import DataFlow::PathGraph

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(MethodParameter p | 
      p.getType().hasName("String") and
      this.asParameter() = p
    )
  }
}

class RedirectSink extends DataFlow::Node {
  RedirectSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName() = "<init>" and
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.web.servlet", "ModelAndView") and
        ma.getArgument(0).toString().matches("^redirect:.*") and
        this.asExpr() = ma.getArgument(0)
      )
      or
      exists(ReturnStmt ret |
        ret.getExpr().toString().matches("^redirect:.*") and
        this.asExpr() = ret.getExpr()
      )
    )
  }
}

predicate isTainted(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
  nodeFrom.asParameter().getAnOutParameter() = nodeTo or
  exists(PrimitiveExpr pe | 
    nodeFrom.asParameter() = pe.getEnclosingCallable().getParameter(pe.getParameterNumber()) and
    pe.getParameterCallable().getAnOutParameter() = nodeTo
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(UserInput ui | source.getNode() = ui) and
  exists(RedirectSink rs | sink.getNode() = rs) and
  isTainted(source.getNode(), sink.getNode())
select sink, "Unvalidated URL redirection detected", source, sink,
  "Unsafe redirect to unchecked URL $@ from user input $@",
  sink.getNode().toString(), source.getNode().toString()
