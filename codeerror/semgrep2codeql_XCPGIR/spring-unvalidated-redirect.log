/**
 * @name Spring Unvalidated Redirect
 * @description Application redirects a user to a destination URL specified by a user supplied parameter that is not validated.
 * @kind problem
 * @id java/spring-unvalidated-redirect
 * @tags security
 *       external/cwe/cwe-601
 *       external/cwe/cwe-79
 * @severity Warning
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class UserProvidedUrlSource extends DataFlow::Node {
  UserProvidedUrlSource() {
    exists(Method m, Parameter p |
      m.hasQualifiedName("org.springframework.web", "Controller") and
      exists(m.getParameter(p) |
        p.getType().hasName("String") and
        (p.getName().matches("URL") or p.getName().matches("url")) and
        this.asParameter() = p
      )
    )
  }
}

class RedirectReturnSink extends DataFlow::Node {
  RedirectReturnSink() {
    exists(Method m, ReturnStmt ret |
      m.hasQualifiedName("org.springframework.web", "Controller") and
      ret.getEnclosingCallable() = m and
      ret.getResult().toString().matches("redirect:.*") and
      this.asExpr() = ret.getResult()
    )
  }
}

class ModelViewRedirectSink extends DataFlow::Node {
  ModelViewRedirectSink() {
    exists(MethodAccess ma |
      ma.getQualifiedName().matches("org.springframework.web.servlet.ModelAndView.%") and
      ma.getArgument(0).toString().matches("redirect:.*") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class UnvalidatedRedirectConfig extends TaintTracking::Configuration {
  UnvalidatedRedirectConfig() {
    this = "Spring Unvalidated Redirect Configuration"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserProvidedUrlSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RedirectReturnSink or
    sink instanceof ModelViewRedirectSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Method m |
      node1.asParameter() = m.getAParameter() and
      node2.asExpr() = m.getReturn().getAValue()
    )
    or
    exists(MethodAccess ma, Parameter p, int pos |
      node1.asParameter() = p and
      pos >= 0 and
      pos < ma.getNumArgument() and
      node2.asExpr() = ma.getArgument(pos)
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, UnvalidatedRedirectConfig config
where config.hasFlow(source, sink)
select sink, "Unvalidated redirect to user-provided URL detected from $@.", source,
  source.toString()
