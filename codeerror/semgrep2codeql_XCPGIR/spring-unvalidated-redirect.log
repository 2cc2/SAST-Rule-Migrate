Rule Content:
/**
 * @name Spring 未经验证的重定向
 * @description 应用将用户重定向到用户提供的未经验证的目标URL
 * @id java/spring-unvalidated-redirect
 * @kind path-problem
 * @severity warning
 * @tags security
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class UserInput extends TaintTracking::Source {
  UserInput() {
    exists(Parameter p |
      p.getType().hasName("String") and
      result.asParameter() = p
    )
  }
}

class RedirectSink extends TaintTracking::Sink {
  RedirectSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("org.springframework.web.servlet", "ModelAndView") and
      cc.getArgument(0).toString().matches("^redirect:.*") and
      result.asExpr() = cc.getArgument(0)
    ) or
    exists(ReturnStmt ret |
      ret.getResult().toString().matches("^redirect:.*") and
      result.asExpr() = ret.getResult()
    )
  }
}

class TaintPropagation extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Parameter p, Method m |
      pred.asParameter() = p and
      m.getAParameter() = p and
      (exists(m.getReturn()) and succ.asExpr() = m.getReturn()) or
      succ.asParameter() = m.getThisParameter()
    )
  }
}

query predicate edges(DataFlow::Node source, DataFlow::Node sink) {
  any(UserInput ui).flowsTo(sink, _, _, new TaintPropagation()) or
  any(RedirectSink rs).hasSource(source, new TaintPropagation())
}

from DataFlow::PathNode source, DataFlow::PathNode sink, string srcText, string sinkText
where
  edges(source, sink) and
  srcText = source.getNode().toString() and
  sinkText = sink.getNode().toString()
select sink, "Unvalidated URL redirection detected", source, sink,
  "Unsafe redirect to unchecked URL $@ from user input $@",
  sinkText, srcText
