Rule Content:
/**
 * @name Spring Unvalidated Redirect
 * @description Application redirects a user to a destination URL specified by a user supplied parameter that is not validated.
 * @kind problem
 * @id java/spring-unvalidated-redirect
 * @tags security
 *       external/cwe/cwe-601
 *       external/cwe/cwe-79
 * @severity Warning
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringControllers

class UserProvidedUrlSource extends TaintTracking::Source {
  UserProvidedUrlSource() {
    exists(MethodParameter p |
      p.getType().hasName("String") and
      (p.getName().matches("URL") or p.getName().matches("url"))
      and
      result = p.getAnAccess()
    )
  }
}

class RedirectReturnSink extends TaintTracking::Sink {
  RedirectReturnSink() {
    exists(MethodReturnStmt ret |
      ret.getExpr().toString().matches("redirect:.*") and
      result = ret.getExpr()
    )
  }
}

class ModelViewRedirectSink extends TaintTracking::Sink {
  ModelViewRedirectSink() {
    exists(MethodAccess ma |
      ma.getType().getName() = "ModelAndView" and
      ma.getTarget().toString().matches("redirect:.*") and
      result = ma.getArgument(0)
    )
  }
}

class UnvalidatedRedirectConfiguration extends TaintTracking::Configuration {
  UnvalidatedRedirectConfiguration() {
    this = "Spring Unvalidated Redirect"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserProvidedUrlSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RedirectReturnSink or
    sink instanceof ModelViewRedirectSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Parameter to return value propagation
    exists(Method m |
      node1.asParameter() = m.getAParameter() and
      node2.asExpr() = m.getReturn() and
      not m.isStatic()
    ) or
    // Parameter to method argument propagation
    exists(MethodAccess ma, int pos |
      node1.asParameter() = ma.getMethod().getAParameter() and
      node2.asExpr() = ma.getArgument(pos)
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink
where any(UnvalidatedRedirectConfiguration c).hasFlow(source, sink)
select sink, source,
  "Unvalidated redirect to user-provided URL detected (" + source + " -> " + sink + ")"
