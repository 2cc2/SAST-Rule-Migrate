Rule Content:
/**
 * @name Permissive CORS Policy
 * @description Permissive CORS policy will allow a malicious application to communicate with the victim
 * application in an inappropriate way, leading to spoofing, data theft, relay and other attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id java/permissive-cors
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.spring.HttpHeaders

class CorsConfig extends DataFlow::Configuration {
  CorsConfig() { this = "PermissiveCorsPolicy" }

  override predicate isSource(DataFlow::Node source) { false }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method method, MethodAccess ma, string headerName, string headerValue |
      method.getName() in ["addHeader", "setHeader", "add", "set", "header"] and
      ma.getMethod() = method and
      (
        method.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") or
        method.getDeclaringType().hasQualifiedName("org.springframework.http", "HttpHeaders") or
        method.getDeclaringType().hasQualifiedName("org.springframework.http", "ResponseEntity") or
        method.getDeclaringType().hasQualifiedName("org.springframework.http.server.reactive", "ServerHttpResponse") or
        method.getDeclaringType().hasQualifiedName("org.springframework.web.reactive.function.server", "ServerResponse")
      ) and
      headerName = ma.getArgument(0).(StringLiteral).getValue() and
      headerName.matches("access-control-allow-origin") and
      headerValue = ma.getArgument(1).(StringLiteral).getValue() and
      (headerValue = "*" or headerValue = "null") and
      sink.asExpr() = ma
    )
  }
}

from DataFlow::Node sink, CorsConfig config
where config.hasFlowTo(sink)
select sink,
  "Insecure CORS policy detected: " + sink.asExpr().(MethodAccess).getMethod().getName() +
  " allows any origin ('*' or null)"
