Rule Content:
/**
 * @name Permissive CORS Policy
 * @description Permissive CORS policy will allow a malicious application to communicate with the victim 
 * application in an inappropriate way, leading to spoofing, data theft, relay and other attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id java/permissive-cors
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.HttpHeaders

class CorsVulnerability extends DataFlow::Configuration {
  CorsVulnerability() { this = "CorsVulnerability" }

  override predicate isSource(DataFlow::Node source) { 
    true // All nodes considered as potential sources
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["addHeader", "setHeader", "add", "set", "header"]) and
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") or
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.http", "HttpHeaders") or
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.http", "ResponseEntity") or
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.http.server.reactive", "ServerHttpResponse") or
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.web.reactive.function.server", "ServerResponse")
      ) and
      ma.getArgument(0).(StringLiteral).getValue().matches("access-control-allow-origin") and
      ma.getArgument(1).(StringLiteral).getValue().matches("*|null")
      and sink.asExpr() = ma
    )
  }
}

from DataFlow::Node sink, CorsVulnerability conf
where conf.hasFlowTo(sink)
select sink, 
  "Insecure CORS policy detected: " + sink.getNode().(MethodAccess).getMethod().getName() + 
  " allows any origin ('*' or null)"
