Rule Content:
/**
 * @name Permissive CORS Policy
 * @description Detects insecure CORS configurations that allow any origin ('*' or null)
 * @kind problem
 * @problem.severity warning
 * @id java/permissive-cors
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.security.HttpHeaders

class CorsVulnerability extends DataFlow::Configuration {
  CorsVulnerability() { this = "PermissiveCorsPolicy" }

  override predicate isSource(DataFlow::Node source) { false }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, MethodAccess ma | 
      m.getName() in ["addHeader", "setHeader", "headers"] and
      ma.getMethod() = m and
      (
        m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") or
        m.getDeclaringType().hasQualifiedName("org.springframework.http", "HttpHeaders") or
        m.getDeclaringType().hasQualifiedName("org.springframework.http", "ResponseEntity") or
        m.getDeclaringType().hasQualifiedName("org.springframework.http.server.reactive", "ServerHttpResponse") or
        m.getDeclaringType().hasQualifiedName("org.springframework.web.reactive.function.server", "ServerResponse")
      ) and
      ma.getArgument(0).(StringLiteral).getValue().toLowerCase() = "access-control-allow-origin" and
      (
        ma.getArgument(1).(StringLiteral).getValue() = "*" or
        ma.getArgument(1).(StringLiteral).getValue() = "null"
      ) and
      sink.asExpr() = ma
    )
  }
}

from DataFlow::Node sink, CorsVulnerability config
where config.hasFlowTo(sink)
select sink, 
  "Insecure CORS policy detected: " + sink.asExpr() + 
  " allows any origin ('*' or null)"
