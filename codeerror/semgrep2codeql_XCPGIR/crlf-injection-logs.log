/**
 * @name CRLF Injection in Logs
 * @description When data from an untrusted source is put into a logger and not neutralized correctly,
 *              an attacker could forge log entries or include malicious content.
 * @kind path-problem
 * @problem.severity warning
 * @id java/crlf-injection-logs
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import semmle.code.java.logging.Logger

class ServletRequestParameterSource extends DataFlow::ExprNode {
  ServletRequestParameterSource() {
    exists(Method m | 
      m.hasName("getParameter") and
      m.getDeclaringType() instanceof ServletRequest and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getQualifier()
    )
  }
}

class LoggerLogSink extends DataFlow::ExprNode {
  LoggerLogSink() {
    exists(Method m |
      m.hasName("log") and
      m.getDeclaringType() instanceof Logger and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(1)
    )
  }
}

class CRLFLogConfig extends TaintTracking::Configuration {
  CRLFLogConfig() { this = "CRLFLogInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof LoggerLogSink
  }
}

