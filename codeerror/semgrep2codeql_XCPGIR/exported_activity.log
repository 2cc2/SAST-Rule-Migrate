```yaml
xcpgir_version: "1.0"
rule:
  id: exported_activity
  kind: pattern
  severity: WARNING
  message: >-
    The application exports an activity. Any application on the device can launch the exported activity which may compromise the integrity of your application or its data.
    Ensure that any exported activities do not have privileged access to your application's control plane.
scope:
  languages: [generic]
  frameworks: [Android]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: EXPORTED_ACTIVITY
    match:
      node: XML_TAG
      where:
        - op: regex
          left: tag
          right: "activity"
        - op: or
          conditions:
            - op: regex
              left: attributes
              right: "android:exported=\"true\""
            - op: contains
              left: children
              right: "<intent-filter>"

sinks:
  - id: VULNERABLE_ACTIVITY
    match:
      node: XML_TAG
      where:
        - op: regex
          left: tag
          right: "activity"
        - op: not_regex
          left: attributes
          right: "android:exported=\"false\""

sanitizers:
  - id: EXPLICITLY_NON_EXPORTED
    match:
      node: XML_TAG
      where:
        - op: regex
          left: attributes
          right: "android:exported=\"false\""
    effect: neutralize

flows:
  - source: EXPORTED_ACTIVITY
    sink: VULNERABLE_ACTIVITY
    constraints:
      path:
        must_not: [ { pattern: "EXPLICITLY_NON_EXPORTED" } ]

report:
  message: "Exported Activity detected"
  locations: ["source"]
  evidence:
    capture:
      - attribute: "attributes"
      - child: "intent-filter"

metadata:
  category: security
  subcategory: [vuln]
  cwe: ["CWE-926"]
  owasp: ["A5:2021"]
  technology: [Android]
```
