Rule Content:
/**
 * @name Exported Activity Detection
 * @description Detects exported activities in AndroidManifest.xml that may compromise application security
 * @kind path-problem
 * @problem.severity warning
 * @id android/exported-activity
 * @tags security
 *       android
 */

import java
import semmle.code.android.dataflow.AndroidManifest
import DataFlow::PathGraph

class ExportedActivityConfig extends XmlElement {
  ExportedActivityConfig() {
    this.hasName("activity") and
    (
      this.hasAttribute("exported", "true") or
      exists(this.getChild("intent-filter"))
    )
  }
}

class NonExportedActivityConfig extends XmlElement {
  NonExportedActivityConfig() {
    this.hasName("activity") and
    this.hasAttribute("exported", "false")
  }
}

predicate isSource(ExportedActivityConfig config) {
  not exists(NonExportedActivityConfig nonExported |
    nonExported = config
  )
}

predicate isNonExportedBarrier(NonExportedActivityConfig config) { true }

query predicate edges(ExportedActivityConfig source, ExportedActivityConfig sink) {
  isSource(source) and
  source = sink
}

from ExportedActivityConfig source, ExportedActivityConfig sink, Edge edge
where
  edges(source, sink, edge) and
  not exists(NonExportedActivityConfig barrier |
    barrier = source
  )
select sink, "Exported activity detected in AndroidManifest.xml", source,
  "This exported activity may be accessed by other applications, potentially compromising security."
