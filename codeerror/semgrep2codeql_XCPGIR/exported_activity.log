Rule Content:
/**
 * @name Exported Activity Detection
 * @description Detects Android activities that are exported and potentially vulnerable
 * @kind problem
 * @problem.severity warning
 * @id android/exported-activity
 * @security-severity 7.5
 * @tags security
 *       android
 *       owasp-a5
 *       cwe/926
 */

import android
import semmle.code.android.Manifest
import DataFlow::PathGraph

class ExportedActivity extends ManifestActivity {
  ExportedActivity() {
    (
      this.isExported() = true() or
      exists(IntentFilter filter | filter = this.getAnIntentFilter())
    )
  }
}

class VulnerableActivity extends ManifestActivity {
  VulnerableActivity() {
    this.isExported() != false()
  }
}

class ExplicitlyNonExported extends ManifestActivity {
  ExplicitlyNonExported() {
    this.isExported() = false()
  }
}

class MyConfig extends TaintTracking::Configuration { 
  MyConfig() { this = "ExportedActivityFlow" }

  override predicate isSource(DataFlow::Node source) {
    source.asManifestActivity() instanceof ExportedActivity
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asManifestActivity() instanceof VulnerableActivity and
    not sink.asManifestActivity() instanceof ExplicitlyNonExported
  }
}

from MyConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(),
  "Exported Activity detected. Any application can launch this activity which may " +
  "compromise your app's integrity. Review activity export settings.",
  source.getNode(),
  "Exported activity declaration here"
