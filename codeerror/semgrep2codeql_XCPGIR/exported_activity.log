/**
 * @name Exported Activity Detection
 * @description Detects exported activities in AndroidManifest.xml that may compromise application security
 * @kind problem
 * @problem.severity warning
 * @id android/exported-activity
 * @tags security
 *       android
 */

import java
import android.ManifestComponents

class ExportedActivity extends ManifestActivity {
  ExportedActivity() {
    (
      this.isExported() = true or
      exists(this.getIntentFilter())
    ) and
    not this.isExported() = false
  }
}

from ExportedActivity activity
select activity, "Exported activity detected in AndroidManifest.xml. " +
  "Any application on the device can launch this exported activity which may " +
  "compromise the integrity of your application or its data."
