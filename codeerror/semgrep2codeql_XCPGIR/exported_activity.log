Rule Content:
/**
 * @name Exported Activity Vulnerability Finder
 * @description Detects activities that are exported and potentially vulnerable to unauthorized access.
 * @id exported-activity
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @tags security
 *       android
 *       cwe/926
 *       owasp-a5
 */

import java
import semmle.code.xml.XML
import DataFlow::PathGraph

class ExportedActivity extends XMLTag {
  ExportedActivity() {
    this.getName().regexpMatch("activity") and
    (
      this.getAttr("android:exported").regexpMatch("true") or
      exists(this.getChild("intent-filter"))
    )
  }

  string getExportStatus() { result = this.getAttr("android:exported").getValue() }
}

class VulnerableActivity extends XMLTag {
  VulnerableActivity() {
    this.getName().regexpMatch("activity") and
    not this.getAttr("android:exported").regexpMatch("false")
  }
}

class ExplicitlyNonExportedSanitizer extends XMLTag {
  ExplicitlyNonExportedSanitizer() {
    this.getName().regexpMatch("activity") and
    this.getAttr("android:exported").regexpMatch("false")
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "ExportedActivityToVulnerable" }

  override predicate isSource(DataFlow::Node source) {
    exists(ExportedActivity activity |
      source.asXmlNode() = activity
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(VulnerableActivity activity |
      sink.asXmlNode() = activity and
      not exists(ExplicitlyNonExportedSanitizer san |
        san = activity
      )
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "Exported Activity detected. " +
  "Any application on the device can launch this exported activity which may compromise " +
  "the integrity of your application or its data. Ensure that exported activities " +
  "don't have privileged access to your application's control plane.",
  source.getNode(), "Exported activity declaration"
