Rule Content:
/**
 * @name Static Initialization Vector
 * @description Initialization Vectors (IVs) for block ciphers should be randomly generated each time they are used.
 *              Using a static IV means the same plaintext encrypts to the same ciphertext every time, weakening the strength of the encryption.
 * @kind problem
 * @problem.severity warning
 * @id java/no-static-initialization-vector
 */

import java
import semmle.code.java.dataflow.TaintTracking

// Define source - static byte array initialization
predicate isStaticIVInitializer(Expr expr) {
  exists(ArrayInit init | 
    expr = init and
    exists(VariableDeclarator vd |
      vd.getInitializer() = expr and
      vd.getType().(ArrayType).getElementType().hasName("byte")
    )
  )
}

// Define sink - IvParameterSpec constructor call
class IvParameterSpecCall extends MethodAccess {
  IvParameterSpecCall() {
    this.getCallee().(Constructor).getDeclaringType().hasQualifiedName("javax.crypto.spec", "IvParameterSpec")
  }
}

// Taint tracking configuration
class StaticIVConfig extends TaintTracking::Configuration {
  StaticIVConfig() { this = "StaticIVConfig" }

  override predicate isSource(DataFlow::Node source) {
    isStaticIVInitializer(source.asExpr())
    or
    exists(Field f |
      exists(isStaticIVInitializer(f.getInitializer())) and
      source.asExpr() = f
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(IvParameterSpecCall call |
      call.getArgument(0) = sink.asExpr()
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, StaticIVConfig config
where config.hasFlow(source, sink)
select sink, "Static IV detected in encryption usage. Initialization Vectors should be randomly generated each time.", 
  source, "Static IV value", sink, "Used in IvParameterSpec constructor"
