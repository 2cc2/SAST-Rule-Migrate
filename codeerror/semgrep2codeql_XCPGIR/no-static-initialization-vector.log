Rule Content:
/**
 * @name Static Initialization Vector
 * @description Initialization Vectors (IVs) for block ciphers should be randomly generated each time they are used.
 *              Using a static IV means the same plaintext encrypts to the same ciphertext every time, weakening the strength of the encryption.
 * @kind problem
 * @problem.severity warning
 * @precision medium
 * @id java/no-static-initialization-vector
 * @tags security
 *       crypto
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Crypto

predicate isStaticByteArrayInitialization(Variable vec) {
  exists(ArrayInit init |
    vec.getInitializer() = init and
    vec.getType().getName() = "byte[]"
  )
  or
  exists(Field f |
    vec = f and
    exists(ArrayInit init |
      f.getInitializer() = init and
      f.getType().getName() = "byte[]"
    )
  )
}

class IvParameterSpecConstruction extends ClassInstanceExpr {
  IvParameterSpecConstruction() {
    this.getConstructedType().hasQualifiedName("javax.crypto.spec", "IvParameterSpec")
  }
}

class StaticIVConfiguration extends TaintTracking::Configuration {
  StaticIVConfiguration() { this = "StaticIVConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(Variable vec |
      isStaticByteArrayInitialization(vec) and
      source.asExpr() = vec.getAnAccess()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(IvParameterSpecConstruction spec |
      spec.getArgument(0) = sink.asExpr()
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, StaticIVConfiguration config
where config.hasFlow(source, sink)
select sink, "Static IV detected in encryption usage. Use randomly generated IVs each time for secure encryption.",
  source, "Static IV initialization",
  sink, "Used in IvParameterSpec constructor"
