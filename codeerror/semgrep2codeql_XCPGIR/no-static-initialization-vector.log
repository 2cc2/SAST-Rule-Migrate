Rule Content:
/**
 * @name Static Initialization Vector
 * @description Initialization Vectors (IVs) for block ciphers should be randomly generated each time they are used. 
 *              Using a static IV means the same plaintext encrypts to the same ciphertext every time, weakening the strength of the encryption.
 * @kind problem
 * @problem.severity warning
 * @id java/no-static-initialization-vector
 */

import java

// Define source - static byte array initialization
predicate isStaticIV(Literal l) {
  l.getText().regexpMatch("^byte\\[\\]\\s+\w+\\s*=\\s*\\{.*\\};")
}

predicate isIvField(Field f) {
  exists(Literal l |
    f.getInitializer() = l and
    isStaticIV(l)
  )
}

// Define sink - IvParameterSpec constructor call
class IvParameterSpecCall extends MethodAccess {
  IvParameterSpecCall() {
    this.getCallee().(Constructor).getDeclaringType().hasQualifiedName("javax.crypto.spec", "IvParameterSpec")
  }
}

// Flow from source to sink
class StaticIVFlow extends TaintTracking::Configuration {
  StaticIVFlow() { this = "StaticIVFlow" }

  override predicate isSource(DataFlow::Node source) {
    exists(Literal l | isStaticIV(l) and source.asExpr() = l) or
    exists(Field f | isIvField(f) and source.asExpr() = f)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(IvParameterSpecCall call |
      call = sink.asExpr() and
      argument(0).toString() = sink.asExpr().toString()
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, StaticIVFlow config
where config.hasFlow(source, sink)
select sink, "Static IV detected in encryption usage", source, sink
