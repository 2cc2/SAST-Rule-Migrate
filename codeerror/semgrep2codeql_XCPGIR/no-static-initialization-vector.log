Rule Content:
/**
 * @name No Static Initialization Vector
 * @description Initialization Vectors (IVs) for block ciphers should be randomly generated each time they are used.
 *              Using a static IV means the same plaintext encrypts to the same ciphertext every time, 
 *              weakening the strength of the encryption.
 * @kind path-problem
 * @problem.severity warning
 * @id java/no-static-initialization-vector
 * @tags security
 *       cryptography
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class StaticIV extends Expr {
  StaticIV() {
    exists(ArrayInitializer ai |
      this = ai |
      this.getType().(ArrayType).getElementType() instanceof PrimitiveType
    )
    and not exists(MethodAccess ma | 
      ma.getMethod().hasQualifiedName("java.security", "SecureRandom", "getSalt")
      or ma.getMethod().hasQualifiedName("java.security", "SecureRandom", "getSeed")
      | this.getASource() = ma
    )
  }
}

class IvParameterSpecConstruction extends MethodAccess {
  IvParameterSpecConstruction() {
    this.getMethod().hasQualifiedName("javax.crypto.spec", "IvParameterSpec", "<init>")
  }
}

class StaticIVConfiguration extends TaintTracking::Configuration {
  StaticIVConfiguration() { this = "StaticIVConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof StaticIV
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(IvParameterSpecConstruction ivps |
      sink.asExpr() = ivps.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, StaticIVConfiguration config
where config.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(), 
  "Static IV detected in cryptographic operation. IVs should be randomly generated each time.",
  source.getNode(), "Static IV here",
  sink.getNode(), "Used in IvParameterSpec constructor"
