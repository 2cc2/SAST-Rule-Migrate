/**
 * @name No Static Initialization Vector
 * @description Initialization Vectors (IVs) for block ciphers should be randomly generated each time they are used.
 *              Using a static IV means the same plaintext encrypts to the same ciphertext every time,
 *              weakening the strength of the encryption.
 * @kind path-problem
 * @problem.severity warning
 * @id java/no-static-initialization-vector
 * @tags security
 *       cryptography
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class StaticIvSource extends ArrayInit {
  StaticIvSource() {
    exists(ArrayType at |
      this.getType() = at and
      at.getElementType() instanceof PrimitiveType
    )
    and not exists(MethodAccess ma |
      ma.getMethod().getName() = "getSeed" and 
      ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "SecureRandom")
    )
  }
}

class IvParameterSpecSink extends Expr {
  IvParameterSpecSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("javax.crypto.spec", "IvParameterSpec") |
      this = cc.getArgument(0)
    )
  }
}

class StaticIvConfig extends TaintTracking::Configuration {
  StaticIvConfig() { this = "Static IV Configuration" }

  override predicate isSource(DataFlow::Node source) {
    exists(StaticIvSource s | source.asExpr() = s)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(IvParameterSpecSink s | sink.asExpr() = s)
  }
}

