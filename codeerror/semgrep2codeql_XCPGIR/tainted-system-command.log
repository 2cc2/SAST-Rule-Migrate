/**
 * @name Tainted system command
 * @description Detected user input entering a method which executes a system command.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-system-command
 * @tags security
 *       external/cwe/cwe-078
 *       owasp-a1
 *       owasp-a3
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class SpringInputSource extends DataFlow::Node {
  SpringInputSource() {
    exists(Method m, Parameter p |
      m.hasAnnotation("org.springframework.web.bind.annotation.RequestBody") or
      m.hasAnnotation("org.springframework.web.bind.annotation.PathVariable") or
      m.hasAnnotation("org.springframework.web.bind.annotation.RequestParam") or
      m.hasAnnotation("org.springframework.web.bind.annotation.RequestHeader") or
      m.hasAnnotation("org.springframework.web.bind.annotation.CookieValue") or
      m.hasAnnotation("org.springframework.web.bind.annotation.ModelAttribute") |
      p = m.getAParameter() and
      not p.getType() instanceof PrimitiveType and
      not p.getType().hasName(["Integer", "Long", "Float", "Double", "Char", "Boolean", 
                               "int", "long", "float", "double", "char", "boolean"]) and
      this.asParameter() = p
    )
  }
}

class ProcessExecSink extends DataFlow::Node {
  ProcessExecSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
       (ma.getMethod().getName() = "command" or ma.getMethod().getName() = "add" or 
        ma.getMethod().getName() = "addAll") and
       ma.getArgument(0) = this.asExpr()) or
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
       (ma.getMethod().getName() = "exec" or ma.getMethod().getName() = "loadLibrary" or
        ma.getMethod().getName() = "load")) or
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
       ma.getMethod().getName() = "start")
    )
  }
}

class StringConcatProp extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
       (ma.getMethod().getName() = "concat" or ma.getMethod().getName() = "format" or
        ma.getMethod().getName() = "join") and
       pred.asExpr() = ma.getAnArgument() and
       succ.asExpr() = ma)
      or
      exists(AddExpr add |
        add.getAnOperand() = pred.asExpr() and
        add = succ.asExpr()
      )
    )
  }
}

class TaintedSystemCommandConfig extends TaintTracking::Configuration {
  TaintedSystemCommandConfig() { this = "TaintedSystemCommandConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SpringInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof ProcessExecSink }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    any(StringConcatProp s).step(pred, succ)
  }
}

