xcpgir_version: "1.0"
rule:
  id: tainted-system-command
  kind: taint
  severity: ERROR
  message: |
    Detected user input entering a method which executes a system command.
    This could result in a command injection vulnerability, which allows an
    attacker to inject an arbitrary system command onto the server. The attacker
    could download malware onto or steal data from the server. Instead, use
    ProcessBuilder, separating the command into individual arguments, like this:
    `new ProcessBuilder("ls", "-al", targetDirectory)`. Further, make sure you
    hardcode or allowlist the actual command so that attackers can't run arbitrary commands.

scope:
  languages: [java]
  frameworks: [spring]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: INPUT
    match:
      node: PARAM
      where:
        - op: regex
          left: annotation
          right: (RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue|ModelAttribute)
        - op: neq
          left: type
          right: (Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean)

  - id: CONCAT
    match:
      node: CALL
      where:
        - op: in
          left: name
          right: [append, concat, format, join, "+", "+="]

sinks:
  - id: COMMAND_EXEC
    match:
      node: CALL
      api: { type: java.lang.Runtime, method: exec }
  
  - id: PROCESS_BUILDER
    match:
      node: CALL
      api: { type: java.lang.ProcessBuilder, method: command }
  
  - id: PROCESS_START
    match:
      node: CALL
      api: { type: java.lang.ProcessBuilder, method: start }

propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint

flows:
  - source: INPUT
    sink: COMMAND_EXEC
    through: [STRING_CONCAT]
  
  - source: INPUT
    sink: PROCESS_BUILDER
    through: [STRING_CONCAT]
  
  - source: INPUT
    sink: PROCESS_START
    through: [STRING_CONCAT]

report:
  message: "User input reaches system command execution without sanitization"
  locations: ["source","sink","path"]
  evidence: { capture: [{ argument: 0 }] }
  
tests:
  positive:
