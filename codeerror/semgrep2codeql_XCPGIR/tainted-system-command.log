    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node from, DataFlow::Node to) {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["append", "concat", "format", "join"]) and
      (
        (ma.getAnArgument() = from.asExpr() and ma.getQualifier() = to.asExpr()) or
        (ma.getQualifier() = from.asExpr() and ma.getAnArgument() = to.asExpr())
      )
    ) or
    exists(BinaryExpr be |
      be.getOperator() instanceof AddOperator and
      (
        (be.getLeftOperand() = from.asExpr() and be.getRightOperand() = to.asExpr()) or
        (be.getRightOperand() = from.asExpr() and be.getLeftOperand() = to.asExpr())
      )
    )
  }
}

