Rule Content:
/**
 * @name Tainted system command
 * @description Detected user input entering a method which executes a system command.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-system-command
 * @tags security
 *       external/cwe/cwe-078
 *       owasp-a1
 *       owasp-a3
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Spring

class SpringInputSource extends DataFlow::Node {
  SpringInputSource() {
    exists(Method m, Parameter p |
      m.getAnAnnotation() instanceof SpringRequestBody or
      m.getAnAnnotation() instanceof SpringPathVariable or
      m.getAnAnnotation() instanceof SpringRequestParam or
      m.getAnAnnotation() instanceof SpringRequestHeader or
      m.getAnAnnotation() instanceof SpringCookieValue or
      m.getAnAnnotation() instanceof SpringModelAttribute |
      p = m.getAParameter() and
      p.getType() instanceof PrimitiveType and        
      not p.getType().hasName(["Integer", "Long", "Float", "Double", "Char", "Boolean"]) and
      this.asParameter() = p
    )
  }
}

class ProcessExecSink extends DataFlow::Node {
  ProcessExecSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
       ma.getMethod().getName() matches "command|add|addAll" and
       ma.getArgument(0) = this.asExpr()) or
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
       ma.getMethod().getName().matches("exec|loadLibrary|load")) or
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
       ma.getMethod().getName() = "start")
    )
  }
}

class StringConcatProp extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
       ma.getMethod().getName().matches("concat|format|join") |
       pred.asExpr() = ma.getAnArgument() and
       succ.asExpr() = ma
      ) or
      exists(AddExpr add |
        add.getAnOperand() = pred.asExpr() and
        add = succ.asExpr()
      )
    )
  }
}

class TaintedSystemCommandConfig extends TaintTracking::Configuration {
  TaintedSystemCommandConfig() { this = "TaintedSystemCommandConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SpringInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ProcessExecSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    any(StringConcatProp s).step(pred, succ)
  }
}

from TaintedSystemCommandConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "Detected user input entering a method which executes a system command (CWE-78: OS Command Injection)",
  source.getNode(), "User input source here",
  sink.getNode(), "Command execution sink here"
