Rule Content:
/**
 * @name Tainted system command
 * @description Detected user input entering a method which executes a system command.
 * @id java/tainted-system-command
 * @kind path-problem
 * @problem.severity error
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringRequest

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p |
      p = m.getAParameter() and
      (
        p.getAnAnnotation() instanceof SpringRequest::RequestBody or
        p.getAnAnnotation() instanceof SpringRequest::PathVariable or
        p.getAnAnnotation() instanceof SpringRequest::RequestParam or
        p.getAnAnnotation() instanceof SpringRequest::RequestHeader or
        p.getAnAnnotation() instanceof SpringRequest::CookieValue or
        p.getAnAnnotation() instanceof SpringRequest::ModelAttribute
      ) and
      not p.getType() instanceof PrimitiveType and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName() = "exec" and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime")
        or
        ma.getMethod().getName() = "command" and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
        or
        ma.getMethod().getName() = "start" and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
      ) and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node from, DataFlow::Node to) {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["append", "concat", "format", "join"] and
      (
        (from.asExpr() = ma.getAnArgument() and to.asExpr() = ma.getQualifier()) or
        (from.asExpr() = ma.getQualifier() and to.asExpr() = ma.getAnArgument())
      )
    ) or
    exists(BinaryExpr be |
      be.getOperator().toString() = "+" and
      (
        (from.asExpr() = be.getLeftOperand() and to.asExpr() = be.getRightOperand()) or
        (from.asExpr() = be.getRightOperand() and to.asExpr() = be.getLeftOperand())
      )
    )
  }
}

