                             "int", "long", "float", "double", "char", "boolean"]) and
      this.asParameter() = p
    )
  }
}

class ProcessExecSink extends DataFlow::Node {
  ProcessExecSink() {
    exists(Expr call |
      (call instanceof MethodAccess and
       ((call.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        (call.getMethod().getName() = "command" or call.getMethod().getName() = "add" or 
         call.getMethod().getName() = "addAll") and
        call.getArgument(0) = this.asExpr()) or
       (call.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
        (call.getMethod().getName() = "exec" or call.getMethod().getName() = "loadLibrary" or
         call.getMethod().getName() = "load")) or
       (call.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        call.getMethod().getName() = "start")))
    )
  }
}

class StringConcatProp extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Expr call |
      call instanceof MethodAccess and
      call.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      (call.getMethod().getName() = "concat" or call.getMethod().getName() = "format" or
       call.getMethod().getName() = "join") and
      pred.asExpr() = call.getAnArgument() and
      succ.asExpr() = call
    )
    or
    exists(AddExpr add |
      add.getAnOperand() = pred.asExpr() and
      add = succ.asExpr()
    )
  }
}

class TaintedSystemCommandConfig extends TaintTracking::Configuration {
  TaintedSystemCommandConfig() { this = "TaintedSystemCommandConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SpringInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof ProcessExecSink }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    any(StringConcatProp s).step(pred, succ)
  }
}

