/**
 * @name Tainted system command
 * @description Detected user input entering a method which executes a system command.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-system-command
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p, SpringAnnotation a |
      m.getAParameter() = p and
      a = p.getAnAnnotation() and
      (
        a.getType().hasName("RequestBody") or
        a.getType().hasName("PathVariable") or
        a.getType().hasName("RequestParam") or
        a.getType().hasName("RequestHeader") or
        a.getType().hasName("CookieValue") or
        a.getType().hasName("ModelAttribute")
      ) and
      not p.getType() instanceof PrimitiveType and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (
        ma.getMethod().hasName("exec") and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") or
        (ma.getMethod().hasName("command") and
         ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")) or
        (ma.getMethod().hasName("start") and
         ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder"))
      ) and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node from, DataFlow::Node to) {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["append", "concat", "format", "join"]) and
      (
        ma.getArgument(_) = from.asExpr() and
        ma.getQualifier() = to.asExpr()
        or
        ma.getQualifier() = from.asExpr() and
        ma.getArgument(0) = to.asExpr()
      )
    ) or
    exists(BinaryExpr be |
      be.getOp() instanceof Add and
      (
        be.getLeftOperand() = from.asExpr() and
        be.getRightOperand() = to.asExpr()
        or
        be.getRightOperand() = from.asExpr() and
        be.getLeftOperand() = to.asExpr()
      )
    )
  }
}

