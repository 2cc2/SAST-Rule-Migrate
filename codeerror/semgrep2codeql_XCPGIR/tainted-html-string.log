import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringAnnotations
import semmle.code.java.Concat
import semmle.code.java.dataflow.TaintTracking

class UserInputSource extends DataFlow::ExprNode {
  UserInputSource() {
    exists(Method m, Parameter p |
      m.getAParameter() = p and
      not p.getType().toString().matches("^(Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean)") and
      (
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestBody") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestParam") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestHeader") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "CookieValue") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "ModelAttribute")
      ) and
      this.asParameter() = p
    )
  }
}

class HtmlResponseSink extends DataFlow::ExprNode {
  HtmlResponseSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("org.springframework.http", "ResponseEntity") and
      cc.getArgument(0) = this.asExpr()
    )
    or
    exists(MethodCall mc |
      mc.getMethod().hasName("body") and
      mc.getQualifier().getType().hasQualifiedName("org.springframework.http", "ResponseEntity") and
      mc.getArgument(0) = this.asExpr()
    )
  }
}

class HtmlSanitizer extends TaintTracking::Sanitizer {
  HtmlSanitizer() {
    exists(MethodCall mc |
      (
        (mc.getMethod().getName().matches("forHtml") or 
         mc.getMethod().getName().matches("sanitize") or 
         mc.getMethod().getName().matches("escapeHtml")) and
        (mc.getMethod().getDeclaringType().getPackage().matches("org.owasp.encoder") or
         mc.getMethod().getDeclaringType().getPackage().matches("org.owasp.esapi"))
      )
      or
      (
        mc.getMethod().hasName("clean") and
        mc.getMethod().getDeclaringType().hasQualifiedName("org.jsoup", "JSoup")
      )
    ) and this = mc
  }
}

class TaintedHtmlConfig extends TaintTracking::Configuration {
  TaintedHtmlConfig() { this = "TaintedHtmlConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof HtmlResponseSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof HtmlSanitizer }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // String concatenation propagation
    exists(ConcatOperation co | 
      co.getAnOperand() = pred.asExpr() and co.getResult() = succ.asExpr()
    )
    or
    // StringBuilder/StringBuffer append propagation
    exists(MethodCall mc |
      mc.getMethod().getName().matches("append%") and
      (mc.getQualifier() = pred.asExpr() or mc.getAnArgument() = pred.asExpr()) and
      mc = succ.asExpr()
    )
    or
    // StringBuilder/StringBuffer toString propagation
    exists(MethodCall mc |
      mc.getMethod().hasName("toString") and
      mc.getQualifier() = pred.asExpr() and
      mc = succ.asExpr()
    )
  }
}

