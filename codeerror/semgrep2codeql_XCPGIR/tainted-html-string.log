Rule Content:
/**
 * @name Tainted HTML String in Response
 * @description Detects user input flowing into a manually constructed HTML string in Spring responses.
 * @id tainted-html-string
 * @kind problem
 * @severity error
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Spring
import semmle.code.java.StringConcatenation

class UserInput extends TaintTracking::Source {
  UserInput() {
    exists(Method m, Parameter p | 
      p = m.getAParameter() and
      not p.getType().(PrimitiveType) and
      (
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestBody") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestParam") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestHeader") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "CookieValue") or
        p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "ModelAttribute")
      )
    )
    and
    this.asParameter() = p
  }
}

class HtmlResponseSink extends TaintTracking::Sink {
  HtmlResponseSink() {
    exists(ConstructorCall cc | 
      cc.getConstructedType().hasQualifiedName("org.springframework.http", "ResponseEntity") and
      this.asExpr() = cc.getArgument(0)
    )
    or
    exists(MethodCall mc | 
      mc.getMethod().hasName("body") and
      mc.getArgument(0) = this.asExpr()
    )
  }
}

class StringConcatProp extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringConcatenationOperation sc |
      sc.getAnOperand() = pred.asExpr() and
      sc.getResult() = succ.asExpr()
    )
  }
}

class StringBuilderProp extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodCall mc | 
      (
        mc.getMethod().getName().matches("append%") and
        mc.getReceiver() = pred.asExpr() and
        mc = succ.asExpr()
      )
      or
      (
        mc.getMethod().hasName("toString") and
        mc.getReceiver() = pred.asExpr() and
        mc = succ.asExpr()
      )
    )
  }
}

class HtmlSanitizer extends TaintTracking::Sanitizer {
  HtmlSanitizer() {
    exists(MethodCall mc |
      (
        mc.getMethod().getName().matches("forHtml|sanitize|escapeHtml") and
        mc.getMethod().getDeclaringType().getPackage().matches("org.owasp.encoder|org.owasp.esapi")
      )
      or
      (
        mc.getMethod().hasName("clean") and
        mc.getMethod().getDeclaringType().hasQualifiedName("org.jsoup", "JSoup")
      )
    )
    and
    this = mc
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  TaintTracking::localTaint(source, sink) and
  source.getNode() instanceof UserInput and
  sink.getNode() instanceof HtmlResponseSink and
  not exists(HtmlSanitizer s | TaintTracking::hasFlowBetween(source.getNode(), s))
select sink, "Potential XSS vulnerability from untrusted input to HTML response", source,
  "User input $@ flows to HTML response without proper sanitization.", source.getNode(), "here"
