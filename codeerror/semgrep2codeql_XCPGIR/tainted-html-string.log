Rule Content:
/**
 * @name Tainted HTML String in Response
 * @description Detects user input flowing into a manually constructed HTML string in Spring responses.
 * @id tainted-html-string
 * @kind path-problem
 * @severity error
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringController
import semmle.code.java.StringOps
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(Method m, Parameter p |
      m.getAParameter() = p and
      not p.getType() instanceof PrimitiveType and
      (
        p.getAnAnnotation() instanceof RequestBody or
        p.getAnAnnotation() instanceof PathVariable or
        p.getAnAnnotation() instanceof RequestParam or
        p.getAnAnnotation() instanceof RequestHeader or
        p.getAnAnnotation() instanceof CookieValue or
        p.getAnAnnotation() instanceof ModelAttribute
      )
    and
    this.asParameter() = p
    )
  }
}

class HtmlResponseSink extends DataFlow::Node {
  HtmlResponseSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("org.springframework.http", "ResponseEntity") and
      this.asExpr() = cc.getArgument(0)
    )
    or
    exists(MethodCall mc |
      mc.getMethod().hasName("body") and
      mc.getQualifier().getType().hasQualifiedName("org.springframework.http", "ResponseEntity") and
      this.asExpr() = mc.getArgument(0)
    )
  }
}

class StringConcatStep extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringConcatenation sc |
      sc.getAnOperand() = pred.asExpr() and
      sc.getResult() = succ.asExpr()
    )
  }
}

class StringBuilderStep extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodCall mc |
      mc.getMethod().getName().matches("append%") and
      (mc.getQualifier() = pred.asExpr() or mc.getAnArgument() = pred.asExpr()) and
      mc = succ.asExpr()
    )
    or
    exists(MethodCall mc |
      mc.getMethod().hasName("toString") and
      mc.getQualifier() = pred.asExpr() and
      mc = succ.asExpr()
    )
  }
}

class HtmlSanitizer extends TaintTracking::Sanitizer {
  HtmlSanitizer() {
    exists(MethodCall mc |
      (mc.getMethod().getName().matches("forHtml|sanitize|escapeHtml") and
       mc.getMethod().getDeclaringType().getPackage().matches("org.owasp.encoder%") or
       mc.getMethod().getDeclaringType().getPackage().matches("org.owasp.esapi%"))
      or
      (mc.getMethod().hasName("clean") and
       mc.getMethod().getDeclaringType().hasQualifiedName("org.jsoup", "JSoup"))
    )
  }
}

query predicate isHtmlTaintFlow(DataFlow::PathNode source, DataFlow::PathNode sink) {
  exists(UserInput input, HtmlResponseSink output |
    source.getNode() = input and
    sink.getNode() = output and
    TaintTracking::sharedFlowPath(input, output, _) and
    not exists(DataFlow::PathNode sanitizedNode |
      sanitizedNode.getNode() instanceof HtmlSanitizer and
      TaintTracking::sharedFlowPath(input, sanitizedNode, _)
    )
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where isHtmlTaintFlow(source, sink)
select sink,
  "Potential XSS vulnerability: Untrusted input flows to HTML response without sanitization",
  source, sink,
  "User input $@ flows to HTML response without proper sanitization.",
  source.getNode(), "here"
