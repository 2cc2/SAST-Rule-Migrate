Rule Content:
/**
 * @name Tainted file path
 * @description Detected user input controlling a file path. An attacker could control the location
 *              of this file, to include going backwards in the directory with '../'. To address this,
 *              ensure that user-controlled variables in file paths are sanitized.
 * @kind problem
 * @problem.severity error
 * @precision high
 * @id java/tainted-file-path
 * @tags security
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringAnnotations

class UserInput extends TaintTracking::Source {
  UserInput() {
    exists(MethodParameter p |
      p.getType().toString() != "Integer" and
      p.getType().toString() != "Long" and
      p.getType().toString() != "Float" and
      p.getType().toString() != "Double" and
      p.getType().toString() != "Char" and
      p.getType().toString() != "Boolean" and
      p.getType().toString() != "int" and
      p.getType().toString() != "long" and
      p.getType().toString() != "float" and
      p.getType().toString() != "double" and
      p.getType().toString() != "char" and
      p.getType().toString() != "boolean" and
      (
        p.getAnAnnotation() instanceof RequestBodyAnnotation or
        p.getAnAnnotation() instanceof PathVariableAnnotation or
        p.getAnAnnotation() instanceof RequestParamAnnotation or
        p.getAnAnnotation() instanceof RequestHeaderAnnotation or
        p.getAnAnnotation() instanceof CookieValueAnnotation or
        p.getAnAnnotation() instanceof ModelAttributeAnnotation
      ) and
      this = p
    )
  }
}

class FileOperationSanitizer extends TaintTracking::Sanitizer {
  FileOperationSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().getPackage().getName() = "org.apache.commons.io" and
      ma.getMethod().getDeclaringType().getName() = "FilenameUtils" and
      ma.getMethod().getName() = "getName" and
      this.asExpr() = ma
    )
  }
}

class FileOperation extends TaintTracking::Sink {
  FileOperation() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getDeclaringType().getPackage().getName() = "java.io" and
        (
          ma.getMethod().getName() = "File" or
          ma.getMethod().getName() = "FileReader" or
          ma.getMethod().getName() = "FileInputStream" or
          ma.getMethod().getName() = "FileOutputStream"
        ) and
        this.asExpr() = ma.getArgument(0)
      )
      or
      (
        (
          ma.getMethod().getName() = "getResourceAsStream" or
          ma.getMethod().getName() = "getResource"
        ) and
        this.asExpr() = ma.getArgument(0)
      )
      or
      (
        ma.getMethod().getDeclaringType().toString() = "java.nio.file.Paths" and
        ma.getMethod().getName() = "get" and
        this.asExpr() = ma.getArgument(0)
      )
    )
  }
}

query predicate isSource(DataFlow::Node source) { source instanceof UserInput }

query predicate isSink(DataFlow::Node sink) { sink instanceof FileOperation }

query predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof FileOperationSanitizer }

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  hasFlowPath(source, sink) and
  isSource(source.getNode()) and
  isSink(sink.getNode())
select sink.getNode(), "User input reaches file operation without sanitization", source.getNode(),
  "User-controlled input is used in file operation."
