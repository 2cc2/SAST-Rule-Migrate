Rule Content:
/**
 * @name Tainted file path
 * @description Detected user input controlling a file path. An attacker could control the location of this file.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-file-path
 * @tags security
 *       external/cwe/cwe-023
 *       external/cwe/cwe-036
 *       external/cwe/cwe-073
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringController
import semmle.code.java.security.FilePathSanitizers
import DataFlow::PathGraph

private class UserInput extends DataFlow::Node {
  UserInput() {
    exists(Method m, Parameter p |
      m.getAnAnnotation() instanceof RequestBody or
      m.getAnAnnotation() instanceof PathVariable or
      m.getAnAnnotation() instanceof RequestParam or
      m.getAnAnnotation() instanceof RequestHeader or
      m.getAnAnnotation() instanceof CookieValue or
      m.getAnAnnotation() instanceof ModelAttribute and
      p = m.getParameter(_) and
      this.asParameter() = p
    )
  }
}

private class FileOperationSink extends DataFlow::Node {
  FileOperationSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "File") and
        ma.getMethod().hasName(["<init>", "renameTo"]) and
        this.asExpr() = ma.getArgument(0)
      ) or
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.io", ["FileReader", "FileInputStream", "FileOutputStream"]) and
        ma.getMethod().hasName("<init>") and
        this.asExpr() = ma.getArgument(0)
      ) or
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.nio.file", "Paths") and
        ma.getMethod().hasName("get") and
        this.asExpr() = ma.getArgument(0)
      ) or
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Class") and
        ma.getMethod().hasName(["getResource", "getResourceAsStream"]) and
        this.asExpr() = ma.getArgument(0)
      )
    )
  }
}

private predicate isSanitized(DataFlow::Node node) {
  exists(MethodAccess ma |
    ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
    ma.getMethod().hasName("getName") and
    node.asExpr() = ma.getArgument(0)
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  source.getNode() instanceof UserInput and
  sink.getNode() instanceof FileOperationSink and
  DataFlow::flowPath(source, sink) and
  not isSanitized(sink.getNode())
select sink.getNode(), source, sink, "User input reaches file operation without path sanitization: $@", source.getNode(),
  "User input comes from here."
