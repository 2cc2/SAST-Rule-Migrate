Rule Content:
/**
 * @name Tainted file path
 * @description Detected user input controlling a file path. An attacker could control
 *              the location of this file, to include going backwards in the directory
 *              with '../'. To address this, ensure that user-controlled variables in
 *              file paths are sanitized.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/tainted-file-path
 * @tags security
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringWeb

class UserInputSource extends DataFlow::ExprNode {
  UserInputSource() {
    exists(Method m, Parameter p |
      p = m.getAParameter() and
      not p.getType() instanceof PrimitiveType and
      (
        p.getAnAnnotation() instanceof RequestBody or
        p.getAnAnnotation() instanceof PathVariable or
        p.getAnAnnotation() instanceof RequestParam or
        p.getAnAnnotation() instanceof RequestHeader or
        p.getAnAnnotation() instanceof CookieValue or
        p.getAnAnnotation() instanceof ModelAttribute
      ) and
      this.asParameter() = p
    )
  }
}

class FileOperationSanitizer extends TaintTracking::Sanitizer {
  FileOperationSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
      ma.getMethod().hasName("getName") and
      this.asExpr() = ma
    )
  }
}

class FileOperationSink extends DataFlow::Node {
  FileOperationSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "File") and
        ma.getMethod().hasName(["File", "FileReader", "FileInputStream", "FileOutputStream"]) and
        this.asExpr() = ma.getArgument(0)
      )
      or
      (
        ma.getMethod().hasName(["getResourceAsStream", "getResource"]) and
        this.asExpr() = ma.getArgument(0)
      )
      or
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.nio.file", "Paths") and
        ma.getMethod().hasName("get") and
        this.asExpr() = ma.getArgument(0)
      )
    )
  }
}

class TaintedFilePathConfig extends TaintTracking::Configuration {
  TaintedFilePathConfig() { this = "TaintedFilePathConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOperationSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FileOperationSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedFilePathConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), "User input reaches file operation without sanitization", source.getNode(),
  "User-controlled input is used in file operation."
