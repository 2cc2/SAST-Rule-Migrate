/**
 * @name Tainted SQL injection in AWS Lambda
 * @description Detected SQL statement that is tainted by user input.
 *              This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/tainted-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.DataFlow

class LambdaEventSource extends DataFlow::Source {
  LambdaEventSource() {
    exists(Method m, Parameter p | 
      m = p.getMethod() and
      p.getType().hasName(["InputStream", "Object"]) and
      p.getName().matches("%EVENT%")
    )
  }
}

class SqlExecutionSink extends DataFlow::Sink {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("execute|query|executeUpdate|batchUpdate|queryForObject|queryForMap") and
      ma.getMethod().getDeclaringType().getName().matches("Statement|PreparedStatement|CallableStatement|JdbcTemplate")) and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class NoSanitizationConstraint extends DataFlow::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    not exists(MethodAccess ma |
      ma.getMethod().getName().matches("setString") and
      ma.getMethod().getDeclaringType().getName() = "PreparedStatement" and
      pred.asExpr().getEnclosingCallable() = ma.getEnclosingCallable()
    )
  }
}

from LambdaEventSource source, SqlExecutionSink sink, DataFlow::PathNode pathNodeSrc, DataFlow::PathNode pathNodeSink
where 
  TaintTracking::localTaint(pathNodeSrc, pathNodeSink) and
  source.getLocation() = pathNodeSrc.getLocation() and
  sink.getLocation() = pathNodeSink.getLocation() and
  not exists(NoSanitizationConstraint constraint | constraint.step(pathNodeSrc.getNode(), pathNodeSink.getNode()))
select sink.getNode().getArgument(0), source, sink, 
  "User input from Lambda event reaches SQL execution without sanitization."
