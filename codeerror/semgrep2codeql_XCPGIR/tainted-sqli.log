Rule Content:
/**
 * @name Tainted SQL Injection in AWS Lambda
 * @description Detected SQL statement that is tainted by user input
 * @id tainted-sqli
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01
 *       external/owasp/a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.aws.AWSLambda

class LambdaEventInput extends DataFlow::Node {
  LambdaEventInput() {
    exists(Method m | 
      m.getName().matches("handleRequest%") and
      this.asParameter() = m.getAParameter() and
      (
        this.getType().hasName("InputStream") or
        this.getType().getASupertype*().hasName("APIGatewayProxyRequestEvent")
      )
    )
  }
}

class SqlExecution extends DataFlow::Node {
  SqlExecution() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName().matches("execute%") or
        ma.getMethod().getName().matches("executeUpdate%") or
        ma.getMethod().getName().matches("query%") or
        ma.getMethod().getName().matches("batchUpdate%")
      ) and
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") or
        ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
        ma.getMethod().getDeclaringType().hasQualifiedName("javax.sql", "DataSource")
      ) and
      this.asExpr() = ma.getArgument(0) and
      ma.getArgument(0).toString().matches("SELECT%.*") or
      ma.getArgument(0).toString().matches("INSERT%.*") or
      ma.getArgument(0).toString().matches("UPDATE%.*")
    )
  }
}

class SqlPreparation extends DataFlow::Node {
  SqlPreparation() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class TaintedSqlInLambdaFlow extends TaintTracking::Configuration {
  TaintedSqlInLambdaFlow() { this = "TaintedSqlInLambdaFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecution or sink instanceof SqlPreparation
  }
}

from TaintedSqlInLambdaFlow config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization. This could lead to SQL injection.",
  source, sink,
  "Unsanitized user input from $@ flows to SQL execution at $@",
  source, sink
