  languages: [java]
  frameworks: ["aws-lambda"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources:
  - id: LAMBDA_EVENT
    match:
      node: METHOD_PARAMETER_IN
      where:
        - op: regex
          left: name
          right: "$EVENT"
      type:
        name: "InputStream|Object"
        match: subtype
sinks:
  - id: SQL_EXECUTION
    match:
      node: CALL
      api:
        type: "java.sql.Statement|java.sql.PreparedStatement|java.sql.CallableStatement|org.springframework.jdbc.core.JdbcTemplate"
        method: "execute|query|executeUpdate|batchUpdate|queryForObject|queryForMap"
      arg_index: 0
propagations:
  - id: PARAM_TO_SQL
    edge: arg->param
    kind: taint
flows:
  - source: LAMBDA_EVENT
    sink: SQL_EXECUTION
    through: [PARAM_TO_SQL*]
    constraints:
      path:
        must_not:
          - pattern: "CALL(java.sql.PreparedStatement.setString)"
report:
  message: "User input from Lambda event reaches SQL execution without sanitization"
  locations: ["source", "sink", "path"]
  evidence:
    capture:
      - {argument: 0}
tests:
  positive:
    - "stmt.executeQuery(event.getParameter());"
  negative:
    - "preparedStatement.executeQuery(ESAPI.encoder().encodeForSQL(event.getParameter()));"
