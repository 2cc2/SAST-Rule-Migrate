Rule Content:
/**
 * @name Tainted SQL injection in AWS Lambda
 * @description Detected SQL statement that is tainted by user input from Lambda event.
 *              This could lead to SQL injection if variables are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/tainted-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class LambdaEventSource extends RemoteFlowSource {
  LambdaEventSource() {
    exists(Method m, Parameter p |
      m = p.getMethod() and
      (p.getType().hasName("InputStream") or p.getType().hasName("Object")) and
      p.getName().matches("%EVENT%")
    )
  }

  override string getSourceType() { "remote" }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess call |
      (
        call.getMethod().getName().matches("execute%") or
        call.getMethod().getName().matches("query%") or
        call.getMethod().getName().equals("executeUpdate") or
        call.getMethod().getName().equals("batchUpdate") or
        call.getMethod().getName().equals("queryForObject") or
        call.getMethod().getName().equals("queryForMap")
      ) and
      (
        call.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") or
        call.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
        call.getMethod().getDeclaringType().hasQualifiedName("java.sql", "CallableStatement") or
        call.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
      ) and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class UnsanitizedSQLConfiguration extends TaintTracking::Configuration {
  UnsanitizedSQLConfiguration() { this = "UnsanitizedSQLConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaEventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecutionSink }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "setString" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      node.asExpr() = ma.getArgument(0)
    )
  }

  override int explorationLimit() { return 5 }
}

from UnsanitizedSQLConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(),
  "User input from Lambda event reaches SQL execution without sanitization. $@",
  source.getNode(), "Untrusted input source",
  sink.getNode(), "Potential SQL injection sink"
