 * @description Detected SQL statement that is tainted by user input
 * @id tainted-sqli
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01
 *       external/owasp/a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.AWSLambda

class LambdaEventInput extends DataFlow::Node {
  LambdaEventInput() {
    exists(Method m, Parameter p |
      m.getName().matches("%Event%") and
      p = m.getAParameter() and
      this.asParameter() = p and
      (
        p.getType().hasName("InputStream") or
        exists(RefType t | 
          t = p.getType() and
          t.getASupertype().hasName("APIGatewayProxyRequestEvent")
        )
      )
    )
  }
}

class SqlExecution extends DataFlow::Node {
  SqlExecution() {
    exists(MethodCall mc |
      (
        mc.getMethod().getName().matches("execute%") or
        mc.getMethod().getName().matches("executeUpdate%") or
        mc.getMethod().getName().matches("query%") or
        mc.getMethod().getName().matches("batchUpdate%")
      ) and
      (
        mc.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") or
        mc.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
        mc.getMethod().getDeclaringType().hasQualifiedName("javax.sql", "DataSource")
      ) and
      this.asExpr() = mc.getArgument(0) and
      (
        mc.getArgument(0).toString().matches("SELECT%.*") or
        mc.getArgument(0).toString().matches("INSERT%.*") or
        mc.getArgument(0).toString().matches("UPDATE%.*")
      )
    )
  }
}

class SqlPreparation extends DataFlow::Node {
  SqlPreparation() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "prepareStatement" and
      mc.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = mc.getArgument(0)
    )
  }
}

class TaintedSqlInLambdaFlow extends TaintTracking::Configuration {
  TaintedSqlInLambdaFlow() { this = "TaintedSqlInLambdaFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecution or sink instanceof SqlPreparation
  }
}

