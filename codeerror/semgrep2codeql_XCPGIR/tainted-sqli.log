 * @description Detected SQL statement that is tainted by user input from AWS Lambda event. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sqli-aws-lambda
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.aws.AWSLambdaModels

class LambdaInputSource extends DataFlow::Node {
  LambdaInputSource() {
    exists(Method m | m.hasName("handleRequest") |
      exists(Parameter p |
        p.getMethod() = m and
        (
          p.getType().hasName("InputStream") or
          p.getType() = AWSLambdaModels::getEventType(m)
        ) and
        this.asParameter() = p
      )
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") or
        ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
        ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "CallableStatement") or
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
      ) and
      ma.getMethod().getName() in ["execute", "executeQuery", "executeUpdate", "queryForObject", "queryForMap"] and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class TaintedSQLInjectionConfig extends TaintTracking::Configuration {
  TaintedSQLInjectionConfig() { this = "TaintedSQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node node) { none() }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      ma.getMethod().getName().matches("set%") and
      node1.asExpr() = ma.getArgument(0) and
      node2.asExpr() = ma.getQualifier()
    )
  }
}

