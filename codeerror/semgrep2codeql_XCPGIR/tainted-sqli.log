Rule Content:
/**
 * @name Tainted SQL Injection
 * @description Detected SQL statement that is tainted by user input. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Spring
import semmle.code.java.frameworks.aws.AWSLambda

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Parameter p |
      p.getType().hasName(["InputStream"]) or
      p.getType() = any(string s | s = getHandlerType()).getType() and
      exists(Method m | m = p.getMethod() | m.getName() = getHandlerName())
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") or
       ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
       ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "CallableStatement") or
       ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")) and
      ma.getMethod().getName() in ["execute", "executeQuery", "executeUpdate", "queryForObject", "queryForMap"] and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class TaintedSQLInjectionConfig extends TaintTracking::Configuration {
  TaintedSQLInjectionConfig() { this = "TaintedSQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node node) { none() }

  override predicate isSanitizerGuard(DataFlow::BarrierGuard guard) { none() }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      ma.getMethod().getName().matches("set%") and
      node1.asExpr() = ma.getArgument(0) and
      node2.asExpr() = ma.getQualifier()
    )
  }
}

from TaintedSQLInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "User input reaches SQL execution without sanitization", source, sink,
  "Potential SQL injection from $@ to $@", source, "source", sink, "sink"
