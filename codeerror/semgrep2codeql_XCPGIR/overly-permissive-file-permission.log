/**
 * @name Overly Permissive File Permission
 * @description Detects file permissions that are overly permissive (read, write, and execute).
 * @kind problem
 * @problem.severity warning
 * @id java/overly-permissive-file-permission
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class OverlyPermissivePermissionConfig extends DataFlow::Configuration {
  OverlyPermissivePermissionConfig() { this = "OverlyPermissivePermissionConfig" }

  override predicate isSource(DataFlow::Node source) {
    none()
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      // Sink 1: Files.setPosixFilePermissions with permissive permissions
      (
        ma.getMethod().hasName("setPosixFilePermissions") and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.nio.file", "Files") and
        regexMatches("/(^......r..$)|(^.......w.$)|(^........x$)/", ma.getArgument(1).toString())
      )
      or
      // Sink 2: PosixFilePermissions.fromString with permissive permissions
      (
        ma.getMethod().hasName("fromString") and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.nio.file.attribute", "PosixFilePermissions") and
        regexMatches("/(^......r..$)|(^.......w.$)|(^........x$)/", ma.getArgument(0).toString())
      )
      or
      // Sink 3: Set.add with OTHERS permissions
      (
        ma.getMethod().hasName("add") and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.util", "Set") and
        ma.getArgument(0).getType().hasName("PosixFilePermission") and
        (
          ma.getArgument(0).toString().matches("OTHERS_READ") or
          ma.getArgument(0).toString().matches("OTHERS_WRITE") or
          ma.getArgument(0).toString().matches("OTHERS_EXECUTE")
        )
      )
      and
      sink.asExpr() = ma
    )
  }
}

from OverlyPermissivePermissionConfig cfg, DataFlow::Node sink
where cfg.hasFlowTo(sink)
select sink, "Overly permissive file permission detected"
