xcpgir_version: "1.0"
rule:
  id: overly-permissive-file-permission
  kind: pattern
  severity: WARNING
  message: >-
    Detected file permissions that are overly permissive (read, write, and execute).
    It is generally a bad practices to set overly permissive file permission such
    as read+write+exec for all users.
    If the file affected is a configuration, a binary, a script or sensitive data,
    it can lead to privilege escalation or information leakage.
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sinks:
  - id: PERMISSION_SET
    match:
      node: CALL
      api: { type: java.nio.file.Files, method: setPosixFilePermissions }
      arg_index: 1
    where:
      - op: regex
        left: arg[1].value
        right: "/(^......r..$)|(^.......w.$)|(^........x$)/"

  - id: PERMISSION_CREATE
    match:
      node: CALL
      api: { type: java.nio.file.attribute.PosixFilePermissions, method: fromString }
    where:
      - op: regex
        left: return.value
        right: "/(^......r..$)|(^.......w.$)|(^........x$)/"

  - id: OTHERS_PERM_ADD
    match:
      node: CALL
      api: { type: java.util.Set, method: add }
      arg_index: 0
    where:
      - op: eq
        left: arg[0].type
        right: java.nio.file.attribute.PosixFilePermission
      - op: in
        left: arg[0].value
        right: [OTHERS_READ, OTHERS_WRITE, OTHERS_EXECUTE]

flows:
  - sink: PERMISSION_SET
    constraints:
      path:
        must: [ { pattern: "CALL(java.nio.file.Files.setPosixFilePermissions)" } ]

  - sink: PERMISSION_CREATE
    constraints:
      path:
        must: [ { pattern: "CALL(java.nio.file.attribute.PosixFilePermissions.fromString)" } ]

  - sink: OTHERS_PERM_ADD
    constraints:
      path:
        must: [ { pattern: "CALL(java.util.Set.add)" } ]

report:
  message: "Overly permissive file permission detected"
  locations: ["sink"]
  evidence: { capture: [{ argument: 1 }] }

tests:
  positive:
    - "Files.setPosixFilePermissions(file, PosixFilePermissions.fromString(\"rwxrwxrwx\"));"
    - "perms.add(PosixFilePermission.OTHERS_WRITE); Files.setPosixFilePermissions(file, perms);"
  negative:
    - "Files.setPosixFilePermissions(file, PosixFilePermissions.fromString(\"rwxr-x---\"));"
```
