Rule Content:
/**
 * @name Use JSTL escaping for Expression Language
 * @description Detected an Expression Language segment in a tag that does not escape output.
 * @kind path-problem
 * @problem.severity warning
 * @id java/use-jstl-escaping
 * @tags security
 *       xss
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat
import DataFlow

class JspExpression extends DataFlow::ExprNode {
  JspExpression() {
    this.asExpr() instanceof StringLiteral and
    this.asExpr().getText().matches("\\$\\{.*?\\}")
  }
}

class UnsafeJspTag extends DataFlow::ExprNode {
  UnsafeJspTag() {
    this.asExpr() instanceof StringLiteral and
    this.asExpr().getText().matches("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>")
  }
}

class JstlOutTag extends DataFlow::ExprNode {
  JstlOutTag() {
    this.asExpr() instanceof StringLiteral and
    this.asExpr().getText().matches("<[A-Za-z0-9]+:out.*>")
  }
}

predicate isSource(DataFlow::Node source) {
  exists(UnsafeJspTag tag | source = tag)
}

predicate isSink(DataFlow::Node sink) {
  exists(JspExpression expr | sink = expr)
}

predicate isSanitizer(DataFlow::Node sanitizer) {
  exists(JstlOutTag outTag | sanitizer = outTag)
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  isSource(source.getNode()) and
  isSink(sink.getNode()) and
  not exists(DataFlow::PathNode sanitizer |
    isSanitizer(sanitizer.getNode()) and
    DataFlow::flowPath(source, sanitizer)
  )
select sink, "Expression Language segment detected without escaping. Use the 'out' tag from JSTL taglib to escape this expression.",
  source, "This expression may contain user-controlled input."
