Rule Content:
/**
 * @name Use JSTL escaping
 * @kind problem
 * @id java/use-jstl-escaping
 * @problem.severity warning
 * @security-severity 7.4
 * @tags security
 * @precision high
 */

import java
import semmle.code.java.StringLiterals
import semmle.code.jsp.JspXss

from JspUnescapedExpr jspUnescaped, MethodAccess ma, RemoteFlowSource remoteSource
where
  exists(DataFlow::localFlow(remoteSource, ma.getAnArgument()) |
    ma.getMethod().getName() = "setValue" and
    jspUnescaped.getAChild() = ma.getAnArgument() and
    not exists(JspOutTagSanitizer jspsanitizer |
      jspsanitizer.getAChild() = jspUnescaped
    )
  )
select jspUnescaped, "Detected an Expression Language segment in a tag that does not escape output. " +
  "This is dangerous because if any data in this expression can be controlled externally, " +
  "it is a cross-site scripting vulnerability. Instead, use the 'out' tag from the " +
  "JSTL taglib to escape this expression."

/**
 * Defines unescaped JSP Expression Language segments
 */
class JspUnescapedExpr extends TagLiteral {
  JspUnescapedExpr() {
    this.getTagRegex().regexpMatch("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>")
  }
}

/**
 * Defines JSTL out tag sanitizers
 */
class JspOutTagSanitizer extends TagLiteral {
  JspOutTagSanitizer() {
    this.getTagRegex().regexpMatch("<[A-Za-z0-9]+:out.*>")
  }
}

class TagLiteral extends HtmlLiteral {
  Regexp getTagRegex() { result = this.getValue() }
}
