/**
 * @name Use JSTL escaping for Expression Language
 * @description Detected an Expression Language segment in a tag that does not escape output.
 * @kind problem
 * @problem.severity warning
 * @id java/use-jstl-escaping
 * @tags security
 *       xss
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.security.XSS
import Html
import Jsp

predicate isUnsafeElExpr(Expr e) {
  exists(JspJspExpression expr |
    expr = e and
    not exists(JspCoreOutTag tag | tag.getExpr().(JspJspExpression).getValue() = expr.getValue())
  )
}

from Expr src, Expr sink
where
  isUnsafeElExpr(src) and
  exists(DataFlow::path(src, sink))
select sink, "Expression Language segment detected without escaping. Use the 'out' tag from JSTL taglib to escape this expression.",
  src, "This expression may contain user-controlled input.",
  sink, "Potentially unsafe output here"
