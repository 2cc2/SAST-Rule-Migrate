Rule Content:
/**
 * @name Use JSTL escaping for Expression Language
 * @description Detected an Expression Language segment in a tag that does not escape output.
 * @kind path-problem
 * @problem.severity warning
 * @id java/use-jstl-escaping
 * @tags security
 *       xss
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class JspExpression extends Expr {
  JspExpression() {
    this instanceof StringLiteral and
    this.getText().matches("\\$\\{.*?\\}")
  }
}

class UnsafeJspTag extends Expr {
  UnsafeJspTag() {
    this instanceof StringLiteral and
    this.getText().matches("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>")
  }
}

class JstlOutTag extends Expr {
  JstlOutTag() {
    this instanceof StringLiteral and
    this.getText().matches("<[A-Za-z0-9]+:out.*>")
  }
}

predicate isSource(DataFlow::Node source) {
  exists(UnsafeJspTag tag | source.asExpr() = tag)
}

predicate isSink(DataFlow::Node sink) {
  exists(JspExpression expr | sink.asExpr() = expr)
}

predicate isSanitizer(DataFlow::Node sanitizer) {
  exists(JstlOutTag outTag | sanitizer.asExpr() = outTag)
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  isSource(source.getNode()) and
  isSink(sink.getNode()) and
  not exists(DataFlow::PathNode sanitizer |
    isSanitizer(sanitizer.getNode()) and
    DataFlow::flowPath(source, sink).getAEdge*(source, sanitizer)
  )
select sink.getNode(), "Expression Language segment detected without escaping. Use the 'out' tag from JSTL taglib to escape this expression.",
  source.getNode(), "This expression may contain user-controlled input."
