/**
 * @name Use JSTL escaping
 * @kind problem
 * @id java/use-jstl-escaping
 * @description Detects Expression Language segments in JSP tags without output escaping
 * @problem.severity warning
 * @security-severity 7.4
 * @tags security
 * @precision high
 */

import java
import semmle.code.jsp.dataflow.JspFlow
import semmle.code.jsp.HtmlLiteral

predicate isJspUnescapedExpr(HtmlLiteral literal) {
  literal.getValue().regexpMatch("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>")
}

predicate isJspOutTag(HtmlLiteral literal) {
  literal.getValue().regexpMatch("<[A-Za-z0-9]+:out.*>")
}

from HtmlLiteral jspExpr
where
  isJspUnescapedExpr(jspExpr) and
  not exists(HtmlLiteral sanitizer | 
    isJspOutTag(sanitizer) and
    sanitizer.getParent() = jspExpr.getParent()
  )
select jspExpr, "Detected an Expression Language segment in a tag that does not escape output. " +
  "This is dangerous because if any data in this expression can be controlled externally, " +
  "it is a cross-site scripting vulnerability. Instead, use the 'out' tag from the " +
  "JSTL taglib to escape this expression."
