 * @description Detects usage of MD5 as password hash which is not secure
 * @kind problem
 * @id java/md5-password-hash
 * @tags security
 *       cryptography
 * @severity warning
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.security.CryptographicHash

class MD5HashSource extends DataFlow::Node {
  MD5HashSource() {
    exists(Method m, Call ma |
      m.hasName("getInstance") and
      m.getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
      ma.getCallee() = m and
      ma.getArgument(0).(StringLiteral).getValue() = "MD5" and
      this.asExpr() = ma.getQualifier()
    )
    or
    exists(Method m, Call ma |
      m.hasName("digest") and
      m.getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
      ma.getCallee() = m and
      this.asExpr() = ma.getQualifier()
    )
  }
}

class PasswordSink extends DataFlow::Node {
  PasswordSink() {
    exists(Method m, Call ma |
      m.getName().matches("%password%") and
      ma.getCallee() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class MD5ToPasswordTaintFlow extends TaintTracking::Configuration {
  MD5ToPasswordTaintFlow() {
    this = "MD5 to password taint flow"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof MD5HashSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PasswordSink
  }
}

