/**
 * @name MD5 used as password hash
 * @description Detects usage of MD5 as password hash which is not secure
 * @kind taint
 * @warning
 * @id java/md5-password-hash
 * @tags security
 *       cryptography
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.security.PasswordHashing

class MD5HashCreation extends TaintTracking::Source {
  MD5HashCreation() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getInstance") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
      ma.getArgument(0).(Literal).getValue() = "MD5" and
      this.asSource(ma)
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("digest") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
      this.asSource(ma)
    )
  }
}

class PasswordSink extends TaintTracking::Sink {
  PasswordSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%password%") and
      this.asSink(ma)
    )
  }
}

class MD5ToPasswordFlow extends TaintTracking::Configuration {
  MD5ToPasswordFlow() {
    this = "MD5 to password flow"
  }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof MD5HashCreation
  }
  
  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof PasswordSink
  }
  
  override predicate isAdditionalTaintStep(TaintTracking::TaintStep step) {
    step instanceof ArgumentToParameter
  }
}

from MD5ToPasswordFlow cfg, TaintTracking::Source src, TaintTracking::Sink sink
where cfg.hasFlow(src, sink)
select sink, "MD5 is used as a password hash. Use PBKDF2 or bcrypt instead.", 
  src, "MD5 hash creation", sink, "Password field usage"
