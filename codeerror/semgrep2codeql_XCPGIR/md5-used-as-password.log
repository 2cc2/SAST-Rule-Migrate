Rule Content:
/**
 * @name MD5 used as password hash
 * @description Detects usage of MD5 as password hash which is not secure
 * @kind problem
 * @id java/md5-password-hash
 * @tags security
 *       cryptography
 * @severity warning
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Spring

class MD5HashSource extends DataFlow::Node {
  MD5HashSource() {
    exists(Method m, MethodAccess ma |
      m.hasName("getInstance") and
      m.getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
      ma.getMethod() = m and
      ma.getArgument(0).(StringLiteral).getValue() = "MD5" and
      this.asParameter() = ma.getQualifier()
    )
    or
    exists(Method m, MethodAccess ma |
      m.hasName("digest") and
      m.getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
      ma.getMethod() = m and
      this.asParameter() = ma.getQualifier()
    )
  }
}

class PasswordSink extends DataFlow::Node {
  PasswordSink() {
    exists(Method m, MethodAccess ma |
      m.getName().matches("%password%") and
      ma.getMethod() = m and
      this.asParameter() = ma.getArgument(0)
    )
  }
}

class MD5ToPasswordTaintFlowConfiguration extends TaintTracking::Configuration {
  MD5ToPasswordTaintFlowConfiguration() {
    this = "MD5 to password taint flow"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof MD5HashSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PasswordSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::node succ) {
    TaintTracking::localTaintStep(pred, succ)
  }
}

from MD5ToPasswordTaintFlowConfiguration cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "MD5 is used as a password hash. Use PBKDF2 or bcrypt instead.",
  source.toString(), source.getLocation(), "MD5 hash creation",
  sink.toString(), sink.getLocation(), "Password field usage"
