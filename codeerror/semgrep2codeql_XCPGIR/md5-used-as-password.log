/**
 * @name MD5 used as password hash
 * @description Detects when MD5 is used in password storage context
 * @kind problem
 * @problem.severity warning
 * @id java/md5-as-password
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.security.MessageDigest

class MD5HashConfiguration extends TaintTracking::Configuration {
  MD5HashConfiguration() { this = "MD5HashConfiguration" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.security.MessageDigest", "getInstance") and
      ma.getArgument(0).(Literal).getValue().toUpperCase() = "MD5" and
      source.asExpr() = ma
    )
  }
  
  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%password%") and
      sink.asExpr() = ma
    )
  }
}

from MD5HashConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "MD5 hash detected in password storage context. MD5 is not secure for passwords, use PBKDF2 or bcrypt instead.",
  source.getNode(), "Insecure MD5 hash created here",
  sink.getNode(), "Password storage method call here"
