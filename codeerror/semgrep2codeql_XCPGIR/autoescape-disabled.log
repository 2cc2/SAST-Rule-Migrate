/**
 * @name Autoescape disabled
 * @description Detected an element with disabled HTML escaping. If external data can reach this,
 *              this is a cross-site scripting (XSS) vulnerability.
 * @kind problem
 * @id java/autoescape-disabled
 * @severity Warning
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.xml.Jsf

predicate isAutoescapeDisabled(Expr e) {
  exists(string value |
    value = e.toString() and
    regexpMatch(".*escape.*?=.*?false.*", value)
  )
}

predicate containsHtmlTags(Expr e) {
  exists(string value |
    value = e.toString() and
    regexpMatch(".*<[^>]+>.*", value)
  )
}

from Expr disabledEscape, Expr htmlTags
where
  isAutoescapeDisabled(disabledEscape) and
  containsHtmlTags(htmlTags) and
  disabledEscape.getLocation() = htmlTags.getLocation()
select disabledEscape, "Detected an element with disabled HTML escaping. This may lead to XSS vulnerability."
