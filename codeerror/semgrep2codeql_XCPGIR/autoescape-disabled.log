/**
 * @name Autoescape disabled
 * @description Detected an element with disabled HTML escaping. If external data can reach this, 
 *              this is a cross-site scripting (XSS) vulnerability.
 * @kind problem
 * @severity Warning
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.xml.Jsf

predicate isLiteralWithDisabledEscape(XmlLiteral literal) {
  exists(string value |
    value = literal.getValue() and
    regexMatches(".*escape.*?=.*?false.*", value)
  )
}

predicate isLiteralWithHtmlTag(XmlLiteral literal) {
  exists(string value |
    value = literal.getValue() and
    regexMatches(".*<[^>]+>.*", value)
  )
}

from XmlLiteral literal1, XmlLiteral literal2
where 
  isLiteralWithDisabledEscape(literal1) and
  isLiteralWithHtmlTag(literal2) and
  literal1.getLocation() = literal2.getLocation()
select literal1, "Detected an element with disabled HTML escaping. This may lead to XSS vulnerability."
