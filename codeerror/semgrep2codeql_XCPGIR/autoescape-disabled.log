/**
 * @name autoescape-disabled
 * @description Detected an element with disabled HTML escaping. If external data can reach this, this is a cross-site scripting (XSS) vulnerability.
 * @kind path-problem
 * @problem.severity WARNING
 * @id js/xss-disabled-escape
 */

import javascript
import DataFlow::PathGraph

class EscapeDisabled extends Expr {
  EscapeDisabled() {
    exists(string value |
      this = value and
      value.regexpMatch(".*escape.*?=.*?false.*")
    )
  }
}

class XssSink extends DataFlow::Node { }

predicate isXssSink(DataFlow::Node sink) {
  exists(CallExpr call |
    sink.asExpr() = call
  )
}

from EscapeDisabled source, XssSink sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where
  sourceNode.asExpr() = source and
  exists(DataFlow::PathNode p |
    DataFlow::flowPath(sourceNode, sinkNode, p) and
    isXssSink(sinkNode)
  )
select sinkNode, "Detected an element with disabled HTML escaping. Potential XSS vulnerability.", sourceNode,
  "source", sourceNode.toString(),
  "sink", sinkNode.toString()
