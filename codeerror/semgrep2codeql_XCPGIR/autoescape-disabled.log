/**
 * @name autoescape-disabled
 * @description Detected an element with disabled HTML escaping. If external data can reach this, this is a cross-site scripting (XSS) vulnerability.
 * @kind problem
 * @problem.severity warning
 * @id jsf/autoescape-disabled
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat

class EscapeDisabled extends Expr {
  EscapeDisabled() {
    exists(Literal literal |
      this = literal and
      literal.getStringValue().regexpMatch(".*escape.*?=.*?false.*")
    )
  }
}

class XssSink extends DataFlow::Node {
  XssSink() {
    exists(MethodAccess ma | this.asExpr() = ma)
  }
}

predicate isTaintedFlow(DataFlow::Node source, DataFlow::Node sink) {
  exists(DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode |
    sourceNode.asExpr() = source and
    DataFlow::flowPath(sourceNode, sinkNode) and
    sinkNode.asExpr() = sink
  )
}

from EscapeDisabled source, XssSink sink
where isTaintedFlow(source, sink)
select sink,
  "Detected an element with disabled HTML escaping. Potential XSS vulnerability.",
  source, "source", source.toString(),
  sink, "sink", sink.toString()
