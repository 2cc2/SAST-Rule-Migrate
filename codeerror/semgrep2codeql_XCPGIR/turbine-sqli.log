Rule Content:
/**
 * @name Turbine SQL Injection Vulnerability
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @id java/turbine-sqli
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.Turbine

class TurbineSqlFormatter extends DataFlow::Node {
  TurbineSqlFormatter() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "format" and
      ma.getMethod().getDeclaringType().getName() = "String" and
      this.asExpr() = ma
    )
  }
}

class TurbineSqlExecution extends DataFlow::Node {
  TurbineSqlExecution() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName() = "executeQuery" and
        (
          ma.getMethod().getDeclaringType().getName() = "BasePeer" or
          ma.getMethod().getDeclaringType().getName() = "GroupPeer"
        )
      ) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class TurbineSqlTaintConfig extends TaintTracking::Configuration {
  TurbineSqlTaintConfig() { this = "TurbineSqlTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof TurbineSqlFormatter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TurbineSqlExecution
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral lit |
      lit.getValue().regexpMatch(".*\" *\\+ *\"+.*") and
      sanitizer.asExpr() = lit
    )
  }
}

from TurbineSqlTaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables " +
  "in the SQL statement are not properly sanitized. Use prepared statements instead.",
  source, sink,
  "Potential SQL injection vulnerability"
