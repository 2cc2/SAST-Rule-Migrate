/**
 * @id el-injection
 * @name Expression Language Injection
 * @description Detects potential Expression Language injection vulnerabilities
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision high
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.el.ExpressionLang

class DynamicSource extends DataFlow::Node {
  DynamicSource() {
    // Match string parameters
    exists(Method m, Parameter p |
      this.asParameter() = p and
      m = p.getMethod() and
      p.getType().hasName("String") and
      exists(DataFlow::Node arg | arg = p.getAnAccessedVariable() | arg.asExpr() != p.getADefaultValue())
    )
    or
    // Match local variables
    exists(LocalVariableDecl lvd |
      this.asLocalVariableDecl() = lvd and
      lvd.getType().hasName("String") and
      exists(DataFlow::Node init | init = lvd.getInitializer() | not init instanceof StringLiteral)
    )
    or
    // Match method returns
    exists(Method m |
      this.asExpr() = m.getReturn().getAnAccess() and
      m.getReturnType().hasName("String") and
      not m.getAReturnStmt().getExpr() instanceof StringLiteral
    )
  }
}

class ExpressionInjectionSink extends DataFlow::Node {
  ExpressionInjectionSink() {
    exists(Method ma |
      ma.getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
      ma.getName() = "createValueExpression" and
      this.asExpr() = ma.getACall().getArgument(1)
    )
  }
}

class MethodInjectionSink extends DataFlow::Node {
  MethodInjectionSink() {
    exists(Method ma |
      ma.getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
      ma.getName() = "createMethodExpression" and
      this.asExpr() = ma.getACall().getArgument(1)
    )
  }
}

class TemplateInjectionSink extends DataFlow::Node {
  TemplateInjectionSink() {
    exists(Method ma |
      ma.getName().matches("buildConstraintViolationWithTemplate") and
      this.asExpr() = ma.getACall().getArgument(0)
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "ELInjection" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExpressionInjectionSink or
    sink instanceof MethodInjectionSink or
    sink instanceof TemplateInjectionSink
  }
}

from Config config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential Expression Language injection vulnerability detected. User-provided data flows into expression evaluation without proper sanitization.",
  source.getNode(), sink.getNode()
