/**
 * @name EL Injection
 * @description Detects expression language injection vulnerabilities where unverified dynamic inputs reach EL evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/el-injection
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class DynamicInputSource extends DataFlow::Node {
  DynamicInputSource() {
    exists(Method m, Parameter p |
      p = this.asParameter() and
      not exists(StringLiteral sl | sl.getStringValue() = "..." and sl = this.asExpr())
    ) or
    exists(LocalVariableDeclaration lvd |
      lvd = this.asVariable().getAnAccess() and
      not exists(StringLiteral sl | sl.getStringValue() = "..." and sl = this.asExpr())
    )
  }
}

class ELValueExpressionSink extends DataFlow::Node {
  ELValueExpressionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
      ma.getMethod().getName() = "createValueExpression" and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class ELMethodExpressionSink extends DataFlow::Node {
  ELMethodExpressionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
      ma.getMethod().getName() = "createMethodExpression" and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class ConstraintViolationSink extends DataFlow::Node {
  ConstraintViolationSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "buildConstraintViolationWithTemplate" and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class StringLiteralSanitizer extends DataFlow::Node {
  StringLiteralSanitizer() {
    exists(StringLiteral sl | sl.getStringValue() = "..." and sl = this.asExpr())
  }
}

class ELInjectionConfig extends TaintTracking::Configuration {
  ELInjectionConfig() { this = "ELInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicInputSource
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StringLiteralSanitizer
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ELValueExpressionSink or
    sink instanceof ELMethodExpressionSink or
    sink instanceof ConstraintViolationSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma |
      pred.asExpr() = ma.getAnArgument() and
      succ.asParameter() = ma.getMethod().getAParameter()
    ) or
    exists(AssignStmt assign |
      pred.asExpr() = assign.getRValue() and
      succ.asExpr() = assign.getLValue()
    )
  }
}

