/**
 * @name EL Injection
 * @description Detects expression language injection vulnerabilities where unverified dynamic inputs reach EL evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/el-injection
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.el.ExpressionLanguage

class DynamicInput extends DataFlow::Node {
  DynamicInput() {
    exists(Method m, Parameter p | 
      this.asParameter() = p and m = p.getMethod() and 
      not this.asConstant().hasStringValue("...")
    ) or
    exists(LocalVariableDecl lvd | 
      this.asLocalVariable() = lvd and
      not this.asConstant().hasStringValue("...")
    )
  }
}

class ELValueExpressionSink extends DataFlow::Node {
  ELValueExpressionSink() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
      m.getName() = "createValueExpression" and
      this.asExpr() = m.getACall().getArgument(1)
    )
  }
}

class ELMethodExpressionSink extends DataFlow::Node {
  ELMethodExpressionSink() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
      m.getName() = "createMethodExpression" and
      this.asExpr() = m.getACall().getArgument(1)
    )
  }
}

class ConstraintViolationSink extends DataFlow::Node {
  ConstraintViolationSink() {
    exists(Method m | 
      m.getName() = "buildConstraintViolationWithTemplate" and
      this.asExpr() = m.getACall().getArgument(0)
    )
  }
}

class ELInjectionConfig extends TaintTracking::Configuration {
  ELInjectionConfig() { this = "ELInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicInput
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(string literal | 
      sanitizer.asConstant().getStringValue() = literal and
      literal = "..."
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ELValueExpressionSink or
    sink instanceof ELMethodExpressionSink or
    sink instanceof ConstraintViolationSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma | 
      pred.asExpr() = ma.getAnArgument() and
      exists(Method m | 
        ma.getMethod() = m and
        succ.asParameter() = m.getAParameter()
      )
    ) or
    exists(AssignStmt as | 
      pred.asExpr() = as.getRValue() and
      succ.asVariable() = as.getLValue()
    )
  }
}

from ELInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential EL injection found: " + sink.getNode().toString(),
  source.getNode(), sink.getNode(),
  "Unverified dynamic input reaches EL evaluation"
