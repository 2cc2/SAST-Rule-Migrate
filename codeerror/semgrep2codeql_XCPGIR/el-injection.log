 * @kind path-problem
 * @problem.severity warning
 * @id java/el-injection
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.EL

class DynamicInput extends DataFlow::Node {
  DynamicInput() {
    exists(Parameter p | 
      this.asParameter() = p and
      not this.getStringValue() = "..."
    ) or
    exists(LocalVariable v | 
      this.asVariable() = v and
      not this.getStringValue() = "..."
    )
  }
}

class ELValueExpressionSink extends DataFlow::Node {
  ELValueExpressionSink() {
    exists(MethodAccess ma | 
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
      ma.getMethod().hasName("createValueExpression") and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class ELMethodExpressionSink extends DataFlow::Node {
  ELMethodExpressionSink() {
    exists(MethodAccess ma | 
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
      ma.getMethod().hasName("createMethodExpression") and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class ConstraintViolationSink extends DataFlow::Node {
  ConstraintViolationSink() {
    exists(MethodAccess ma | 
      ma.getMethod().hasName("buildConstraintViolationWithTemplate") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class StringLiteralSanitizer extends DataFlow::Node {
  StringLiteralSanitizer() {
    exists(StringLiteral sl | sl.getValue() = "..." and this.asExpr() = sl)
  }
}

class ELInjectionConfig extends TaintTracking::Configuration {
  ELInjectionConfig() { this = "ELInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ELValueExpressionSink or
    sink instanceof ELMethodExpressionSink or
    sink instanceof ConstraintViolationSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof StringLiteralSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma | 
      pred.asExpr() = ma.getAnArgument() and
      succ.asExpr() = ma.getMethod().getAParameter().getAnAccess()
    ) or
    exists(AssignExpr assign | 
      pred.asExpr() = assign.getRightOperand() and
      succ.asExpr() = assign.getLeftOperand()
    )
  }
}

