/**
 * @id el-injection
 * @name Expression Language Injection
 * @description Detects potential Expression Language injection vulnerabilities
 * @kind path-problem
 * @severity Warning
 * @precision high
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.el.ExpressionLanguage

class DynamicInput extends DataFlow::Node {
  DynamicInput() {
    exists(Method m, Parameter p | 
      p = m.getAParameter() and this.asParameter() = p and
      p.getType().hasName("String") and
      not p.getCall().getArgument(0).(StringLiteral).getValue() = ""
    ) or
    exists(LocalVariable v | 
      this.asLocalVar() = v and
      v.getType().hasName("String") and
      not v.getInitializer().(StringLiteral).getValue() = ""
    ) or
    exists(Method m | 
      this.asReturn() = m.getReturn() and
      m.getReturnType().hasName("String") and
      not m.getReturnStmt().getReturnValue().(StringLiteral).getValue() = ""
    )
  }
}

class ExpressionInjectionSink extends DataFlow::Node {
  ExpressionInjectionSink() {
    exists(MethodAccess ma | 
      ma = this.asExpr() and
      ma.getMethod().getDeclaringType().getName() = "ExpressionFactory" and
      (
        ma.getMethod().getName() = "createValueExpression" and
        ma.getArgument(1) = this.asExpr()
      ) or
      (
        ma.getMethod().getName() = "createMethodExpression" and
        ma.getArgument(1) = this.asExpr()
      )
    )
  }
}

class TemplateInjectionSink extends DataFlow::Node {
  TemplateInjectionSink() {
    exists(MethodAccess ma | 
      ma = this.asExpr() and
      ma.getMethod().getName().matches("%buildConstraintViolationWithTemplate") and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class StaticStringSanitizer extends DataFlow::Node {
  StaticStringSanitizer() {
    exists(StringLiteral sl | this.asExpr() = sl)
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "ELInjection" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicInput
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExpressionInjectionSink or
    sink instanceof TemplateInjectionSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticStringSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, Config config
where config.hasFlowPath(source, sink)
select sink, "Potential Expression Language injection vulnerability detected", source, sink,
  "User-provided data flows into expression evaluation without proper sanitization"
