/**
 * @id el-injection
 * @name Expression Language Injection
 * @description Detects potential Expression Language injection vulnerabilities
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision high
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class DynamicSource extends DataFlow::Node {
  DynamicSource() {
    // String parameters
    exists(Method m, Parameter p |
      this.asParameter() = p and
      m = p.getMethod() and
      p.getType().hasName("String") and
      not exists(Literal l | l = p.getAnAccess().getExpr() | )
    )
    or
    // String local variables with non-literal initializers
    exists(LocalVariableDecl lvd |
      this.asExpr() = lvd.getInit() and
      lvd.getType().hasName("String") and
      not lvd.getInit() instanceof StringLiteral
    )
    or
    // Non-empty string method returns
    exists(Method m, ReturnStmt ret |
      this.asExpr() = ret.getExpr() and
      m = ret.getEnclosingCallable() and
      m.getReturnType().hasName("String") and
      not ret.getExpr() instanceof StringLiteral
    )
  }
}

class ExpressionInjectionSink extends DataFlow::Node {
  ExpressionInjectionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
      ma.getMethod().getName() = "createValueExpression" and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class MethodInjectionSink extends DataFlow::Node {
  MethodInjectionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
      ma.getMethod().getName() = "createMethodExpression" and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class TemplateInjectionSink extends DataFlow::Node {
  TemplateInjectionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%buildConstraintViolationWithTemplate") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "ELInjection" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExpressionInjectionSink or
    sink instanceof MethodInjectionSink or
    sink instanceof TemplateInjectionSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral
  }
}

from Config config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential Expression Language injection vulnerability detected. User-provided data flows into expression evaluation without proper sanitization.",
  source.getNode(), "Dynamic user input comes from here",
  sink.getNode(), "Potentially vulnerable EL expression evaluation"
