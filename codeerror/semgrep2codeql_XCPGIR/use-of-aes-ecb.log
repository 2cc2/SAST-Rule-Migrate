/**
 * @name Use of AES with ECB mode
 * @id java/use-of-aes-ecb
 * @description Use of AES with ECB mode detected. ECB doesn't provide message confidentiality and is not semantically secure so should not be used.
 * @kind problem
 * @security-severity 7.5
 * @tags security
 *       external/cwe/cwe-327
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isECBCipherGetInstanceCall(MethodAccess ma) {
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
  exists(MethodAccess ma | ma.getArgument(0).toString().matches("AES/ECB.*"))
}

from MethodAccess ma
where isECBCipherGetInstanceCall(ma)
select ma, "Use of AES with ECB mode detected. Consider using AES/CBC/PKCS7PADDING instead."
