Rule Content:
/**
 * @name Unsafe Reflection
 * @description Use of externally-controlled input to select classes may allow bypassing authentication or access control checks
 * @kind path-problem
 * @problem.severity warning
 * @id java/unsafe-reflection
 * @tags security
 *       external/cwe/cwe-470
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.ClassNames

class UnsafeReflectionConfig extends TaintTracking::Configuration {
  UnsafeReflectionConfig() { this = "UnsafeReflectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, Method m |
      ma.getMethod() = m and
      m.hasName("forName") and
      m.getDeclaringType().hasQualifiedName("java.lang", "Class") and
      ma.getArgument(0) = source.asExpr() and
      not source.asExpr().(Literal).exists()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma, Method m |
      ma.getMethod() = m and
      m.hasName("newInstance") and
      m.getDeclaringType().hasQualifiedName("java.lang", "Class") and
      ma.getQualifier() = sink.asExpr()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      ma.getArgument(0) = node1.asExpr() and
      ma.getArgument(_) = node2.asExpr()
    )
  }
}

from UnsafeReflectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "If an attacker can supply values that the application then uses to determine which class to instantiate, the potential exists for the attacker to create unintended control flow paths",
  source, sink,
  "$@ flows to reflection instantiation here.",
  source.getNode(), "User input",
  sink.getNode(), "Class instantiation"
