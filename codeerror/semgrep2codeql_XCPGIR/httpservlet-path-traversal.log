Rule Content:
/**
 * @name PathTraversalServlet
 * @description Detects potential path traversal vulnerabilities where untrusted input from HTTP requests
 *              flows into file operations without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @id java/path-traversal-servlet
 * @tags security
 *       external/cwe/cwe-22
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import semmle.code.java.security.PathTraversal

class HttpRequestSource extends RemoteFlowSource {
  HttpRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      (
        ma.getMethod().getName() matches "getParameter%" or
        ma.getMethod().getName() matches "getQueryString" or
        ma.getMethod().getName() matches "getHeader%"
      ) and
      this.asExpr() = ma
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      ma.getMethod().getName() = "getValue" and
      this.asExpr() = ma
    )
  }
}

class FileOperationSink extends DataFlow::Node {
  FileOperationSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.io", "File") and
      this.asExpr() = cc.getArgument(0)
    )
    or
    exists(ConstructorCall cc |
      (cc.getConstructedType().hasQualifiedName("java.io", "FileInputStream") or
       cc.getConstructedType().hasQualifiedName("java.io", "FileOutputStream")) and
      this.asExpr() = cc.getArgument(0)
    )
  }
}

class FilenameUtilsSanitizer extends Sanitizer {
  FilenameUtilsSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
      ma.getMethod().getName() = "getName" and
      this.asExpr() = ma
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalServlet" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOperationSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FilenameUtilsSanitizer
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Path traversal vulnerability detected: File operation may use untrusted input from $@", source.getNode(),
  source.getNode().toString()
