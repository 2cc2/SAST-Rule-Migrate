/**
 * @name ServletPathTraversal
 * @description Detects path traversal vulnerabilities where untrusted input from
 *              HTTPServlet flows into file operations without sanitization.
 * @kind path-problem
 * @problem.severity error
 * @id java/servlet-path-traversal
 * @tags security
 *       external/cwe/cwe-22
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletSource extends RemoteFlowSource::Range {
  ServletSource() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
       ma.getMethod().getName().matches("getParameter%") or
       ma.getMethod().getName().matches("getQueryString") or
       ma.getMethod().getName().matches("getHeader%"))
      and this.asExpr() = ma
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      ma.getMethod().getName() = "getValue" and
      this.asExpr() = ma
    )
  }
}

class FileOperationSink extends DataFlow::Node {
  FileOperationSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.io", "File") and
      this.asExpr() = cc.getArgument(0)
    )
    or
    exists(ConstructorCall cc |
      (cc.getConstructedType().hasQualifiedName("java.io", "FileInputStream") or
      cc.getConstructedType().hasQualifiedName("java.io", "FileOutputStream")) and
      this.asExpr() = cc.getArgument(0)
    )
  }
}

class FilenameUtilsSanitizer extends TaintTracking::Sanitizer {
  FilenameUtilsSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
      ma.getMethod().getName() = "getName" and
      this.asExpr() = ma
    )
  }
}

class ServletPathTraversalConfig extends TaintTracking::Configuration {
  ServletPathTraversalConfig() { this = "ServletPathTraversal" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOperationSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FilenameUtilsSanitizer
  }

  override predicate isSanitizer(DataFlow::Node node, DataFlow::Node sanitized) {
    node instanceof FilenameUtilsSanitizer
  }
}

from ServletPathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "Path traversal vulnerability detected: File operation may use untrusted input from $@",
  source.getNode(), source.getNode().toString()
