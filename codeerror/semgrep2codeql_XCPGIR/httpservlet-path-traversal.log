Rule Content:
/**
 * @name Path Traversal in Servlet File Operations
 * @description Detects potential path traversal vulnerabilities when user-controlled input
 *              flows into file operations without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/path-traversal-servlet
 * @tags security
 *       external/cwe/cwe-22
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletRequestSource extends RemoteFlowSource {
  ServletRequestSource() {
    exists(Method m |
      m.getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      (m.hasName("getParameter") or m.hasName("getCookies")) and
      this.asParameter() = m.getAParameter() or
      this.asMethod() = m
    )
  }
}

class CookieValueSource extends RemoteFlowSource {
  CookieValueSource() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      m.hasName("getValue") and
      this.asMethod() = m
    )
  }
}

class FileOperationSink extends DataFlow::Node {
  FileOperationSink() {
    exists(Constructor c |
      c.getDeclaringType().hasQualifiedName("java.io", "File") and
      this.asExpr() = c.getAnArgument(0)
    ) or
    exists(Method m |
      (m.getDeclaringType().hasQualifiedName("java.io", "FileInputStream") or
       m.getDeclaringType().hasQualifiedName("java.io", "FileOutputStream")) and
      m.getAParameter().getType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = m.getAnArgument(0)
    )
  }
}

class FilenameUtilsSanitizer extends DataFlow::Node {
  FilenameUtilsSanitizer() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
      m.hasName("getName") and
      this.asExpr() = m.getACall()
    )
  }
}

class ServletPathTraversalConfig extends TaintTracking::Configuration {
  ServletPathTraversalConfig() { this = "ServletPathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestSource or
    source instanceof CookieValueSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOperationSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FilenameUtilsSanitizer
  }
}

from ServletPathTraversalConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Potential path traversal vulnerability: User-controlled input flows into file operation without proper sanitation.",
  source, sink,
  "User input from $@ flows into file operation $@ without proper sanitation.",
  source.getNode(), source.toString(), sink.getNode(), sink.toString()
