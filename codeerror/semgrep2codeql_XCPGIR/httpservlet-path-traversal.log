Rule Content:
/**
 * @name Path Traversal in HttpServlet
 * @description Detects potential path traversal vulnerabilities when user-controlled input 
 *              flows into file operations without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/httpservlet-path-traversal
 * @tags security
 *       external/cwe/cwe-22
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Servlets
import DataFlow::PathGraph

class ServletRequestSource extends RemoteFlowSource::Range {
  ServletRequestSource() {
    this.asParameter() = any(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")
    ).getAParameter()
    or
    this.asExpr() = any(MethodAccess ma |
      ma.getMethod().hasName("getParameter") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")
    )
  }
}

class CookieValueSource extends RemoteFlowSource::Range {
  CookieValueSource() {
    this.asExpr() = any(MethodAccess ma |
      ma.getMethod().hasName("getValue") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
    )
  }
}

class FileOperationSink extends DataFlow::Node {
  FileOperationSink() {
    exists(ConstructorCall cc |
      (
        cc.getConstructedType().hasQualifiedName("java.io", "FileInputStream") or
        cc.getConstructedType().hasQualifiedName("java.io", "FileOutputStream")
      ) and
      this.asExpr() = cc.getArgument(0)
    )
    or
    exists(ClassInstanceExpr cie |
      cie.getConstructedType().hasQualifiedName("java.io", "File") and
      this.asExpr() = cie.getArgument(0)
    )
  }
}

class FilenameUtilsSanitizer extends DataFlow::BarrierGuard {
  FilenameUtilsSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getName") and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
      this.getGuard() = ma
    )
  }
}

class PathTraversalConfiguration extends TaintTracking::Configuration {
  PathTraversalConfiguration() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestSource or source instanceof CookieValueSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOperationSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FilenameUtilsSanitizer
  }
}

from PathTraversalConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential path traversal vulnerability from $@ to $@", 
  source.getNode(), "user input", 
  sink.getNode(), "file operation"
