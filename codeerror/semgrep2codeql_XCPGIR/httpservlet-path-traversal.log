Rule Content:
/**
 * @name Path Traversal in HttpServlet
 * @description Detects potential path traversal vulnerabilities when user-controlled input 
 *              flows into file operations without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/path-traversal
 * @tags security
 *       external/cwe/cwe-22
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      // Servlet request parameters as source
      ma.getMethod().hasName("getParameter") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      source.asExpr() = ma
    )
    or
    exists(MethodAccess ma |
      // Cookie values as source
      ma.getMethod().hasName("getValue") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      // FileInputStream constructor
      cc.getConstructed().hasQualifiedName("java.io", "FileInputStream") and
      sink.asExpr() = cc.getArgument(0)
    )
    or
    exists(ConstructorCall cc |
      // FileOutputStream constructor
      cc.getConstructed().hasQualifiedName("java.io", "FileOutputStream") and
      sink.asExpr() = cc.getArgument(0)
    )
    or
    exists(ClassInstanceCreation cic |
      // File constructor
      cic.getConstructed().hasQualifiedName("java.io", "File") and
      sink.asExpr() = cic.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      // FilenameUtils.getName as sanitizer
      ma.getMethod().hasName("getName") and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
      sanitizer.asExpr() = ma
    )
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential path traversal vulnerability from $@ to $@", 
  source.getNode(), "user input", 
  sink.getNode(), "file operation"
