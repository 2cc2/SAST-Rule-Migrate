Rule Content:
/**
 * @name MongoDB NoSQL Injection
 * @description Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator.
 * @kind path-problem
 * @problem.severity warning
 * @id java/mongodb-nosqli
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.MongoDB

class MongoDbWhereSink extends DataFlow::Node {
  MongoDbWhereSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("put|append") and
      ma.getArgument(0).(Literal).getStringValue() = "$where" and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class UnsanitizedInputSource extends DataFlow::Node {
  UnsanitizedInputSource() {
    not exists(StringLiteral s | this.asExpr() = s) and
    exists(VariableAccess va | this.asExpr() = va) or
    exists(MethodCall mc | this.asExpr() = mc)
  }
}

class NoSQLInjectionConfig extends TaintTracking::Configuration {
  NoSQLInjectionConfig() { this = "NoSQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsanitizedInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MongoDbWhereSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Method m, Parameter p, int i |
      m.getParameter(i) = p and
      node1.asExpr() = m.getArgument(i) and
      node2.asParameter() = p
    )
  }
}

from NoSQLInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Non-constant data passed to MongoDB $where operator may lead to NoSQL injection"
