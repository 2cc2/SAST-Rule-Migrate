/**
 * @name MongoDB NoSQL Injection
 * @description Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator.
 * @kind path-problem
 * @problem.severity warning
 * @id java/mongodb-nosqli
 */

import java
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class MongoDbWhereSink extends DataFlow::Node {
  MongoDbWhereSink() {
    exists(MethodCall ma |
      ma.getMethod().getName().matches("put|append") and
      ma.getQualifier().getType().getName() = "BasicDBObject" and
      ma.getArgument(0).(StringLiteral).getValue() = "$where" and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class UnsanitizedInputSource extends DataFlow::Node {
  UnsanitizedInputSource() {
    not this instanceof StringLiteral and
    (exists(LocalVariableAccess va | this.asExpr() = va) or
    exists(InvokeExpr ie | this.asExpr() = ie))
  }
}

class NoSQLInjectionConfig extends TaintTracking::Configuration {
  NoSQLInjectionConfig() { this = "NoSQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsanitizedInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MongoDbWhereSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Callable c, Expr arg, Parameter p |
      c.getAParameter() = p and
      arg = node1.asExpr() and
      node2.asParameter() = p and
      arg = c.getAnArgument()
    )
  }
}

