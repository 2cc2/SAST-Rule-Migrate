Rule Content:
/**
 * @name MongoDB NoSQL Injection
 * @description Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @tags security
 *       external/cwe/cwe-943
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.MongoDb

class UserControlledInput extends TaintTracking::Source {
  UserControlledInput() {
    exists(MethodAccess ma, Parameter p, Method m |
      ma.getMethod() = m and
      m.getParameter(_) = p and
      this.asExpr() = p.getAnAccess()
    )
    or
    exists(ReturnStmt ret, Method m |
      ret.getEnclosingCallable() = m and
      this.asExpr() = ret.getResult()
    )
    or
    exists(LocalVariableDecl lvd |
      this.asExpr() = lvd.getVariable().getAnAccess()
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    not exists(Literal l | source.asExpr() = l and l.getStringValue().regexpMatch("\".*\""))
  }
}

class MongoWhereSink extends TaintTracking::Sink {
  MongoWhereSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["put", "append", "putAll"]
      and
      ma.getQualifier().getType().hasQualifiedName("com.mongodb", "BasicDBObject")
      and
      ma.getArgument(1) = this.asExpr()
    )
    or
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("com.mongodb", "BasicDBObject")
      and
      cc.getArgument(1) = this.asExpr()
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["add", "append", "start"]
      and
      ma.getQualifier().getType().hasQualifiedName("com.mongodb", "BasicDBObjectBuilder")
      and
      ma.getArgument(1) = this.asExpr()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    not exists(Literal l | sink.asExpr() = l)
  }
}

class MongoDbTaintConfig extends TaintTracking::Configuration {
  MongoDbTaintConfig() { this = "MongoDbTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserControlledInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof MongoWhereSink }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Literal l | node.asExpr() = l and l.getStringValue().regexpMatch("\".*\""))
