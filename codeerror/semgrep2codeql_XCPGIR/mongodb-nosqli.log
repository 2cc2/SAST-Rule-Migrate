Rule Content:
/**
 * @name MongoDB NoSQL Injection via $where
 * @description Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator
 * @id mongodb-nosqli
 * @kind path-problem
 * @severity Warning
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class MongoWhereSink extends DataFlow::Node {
  MongoWhereSink() {
    exists(MethodAccess ma | 
      (ma.getMethod().getName() in ["put", "append", "putAll"] and
       ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject")) |
      ma.getArgument(0).(Literal).getValue() = "$where" and
      this.asExpr() = ma.getArgument(1)
    )
    or
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("com.mongodb", "BasicDBObject") and
      cc.getArgument(0).(Literal).getValue() = "$where" and
      this.asExpr() = cc.getArgument(1)
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["start", "add", "append"] and
      ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObjectBuilder") and
      ma.getArgument(0).(Literal).getValue() = "$where" and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class MongoWhereFlowConfig extends TaintTracking::Configuration {
  MongoWhereFlowConfig() { this = "MongoWhereFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(UserInput input | input.asSource(source))
    source.asExpr() instanceof Literal or
    source.asExpr().(MethodAccess).getMethod().getReturnType().isStringType()
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MongoWhereSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb.client.model", "Filters") and
      node.asExpr() = ma.getAnArgument()
    )
  }
}

from MongoWhereFlowConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Non-constant data passed into NoSQL query using '$where' operator. This could lead to NoSQL injection if the data is user-controllable.",
  source.getNode(), sink.getNode(),
  "source", "sink"
