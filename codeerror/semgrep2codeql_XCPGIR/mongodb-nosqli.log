/**
 * @name MongoDB NoSQL Injection via $where
 * @description Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator
 * @id mongodb-nosqli
 * @kind path-problem
 * @severity Warning
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.security.QueryInjection

class MongoWhereSink extends RemoteFlowSource::Range {
  MongoWhereSink() {
    exists(Method m, MethodAccess ma |
      (m.hasName(["put", "append", "putAll"]) and
       m.getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
       ma.getMethod() = m and
       ma.getArgument(0).toString() = "$where") |
      this.asRange() = ma.getArgument(1)
    )
    or
    exists(Constructor c, ConstructorCall cc |
      c.getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
      c.getName() = "<init>" and
      cc.getConstructor() = c and
      cc.getArgument(0).toString() = "$where" and
      this.asRange() = cc.getArgument(1)
    )
    or
    exists(Method m, MethodAccess ma |
      m.hasName(["start", "add", "append"]) and
      m.getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObjectBuilder") and
      ma.getMethod() = m and
      ma.getArgument(0).toString() = "$where" and
      this.asRange() = ma.getArgument(1)
    )
  }
}

class MongoWhereFlowConfig extends TaintTracking::Configuration {
  MongoWhereFlowConfig() { this = "MongoWhereFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MongoWhereSink mws | sink.asExpr() = mws.asRange().getExpr())
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Method m, MethodAccess ma |
      m.getDeclaringType().hasQualifiedName("com.mongodb.client.model", "Filters") and
      ma.getMethod() = m and
      node.asExpr() = ma.getAnArgument()
    )
  }
}

from MongoWhereFlowConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(),
  "Non-constant data passed into NoSQL query using '$where' operator. This could lead to NoSQL injection if the data is user-controllable.",
  source.getNode(), sink.getNode(),
  "source", "sink"
