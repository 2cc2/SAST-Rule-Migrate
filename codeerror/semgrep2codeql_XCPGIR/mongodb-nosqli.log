Rule Content:
/**
 * @name MongoDB NoSQL Injection
 * @description Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator.
 * @kind path-problem
 * @problem.severity warning
 * @id java/mongodb-nosqli
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.DataflowStubs

class MongoDbWhereSink extends DataFlow::Node {
  MongoDbWhereSink() {
    exists(Method m, MethodAccess ma |
      m.hasName(["put", "append"]) and
      m.getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
      ma.getMethod() = m and
      ma.getArgument(0).(StringLiteral).getValue() = "$where" and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class UnsanitizedInputSource extends DataFlow::Node {
  UnsanitizedInputSource() {
    exists(Expr e |
      // Not a string literal
      not e instanceof StringLiteral and
      // Either a variable access or method call
      (exists(VarAccess va | e = va) or exists(MethodAccess ma | e = ma)) and
      this.asExpr() = e
    )
  }
}

class NoSQLInjectionConfig extends DataFlow::Configuration {
  NoSQLInjectionConfig() { this = "NoSQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsanitizedInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MongoDbWhereSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Method m, Parameter p, int i |
      m.getParameter(i) = p and
      node1.asExpr() = m.getAnArgument() and
      node2.asParameter() = p
    )
  }
}

