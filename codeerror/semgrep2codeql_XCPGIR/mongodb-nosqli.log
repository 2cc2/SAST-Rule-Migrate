Rule Content:
/**
 * @name MongoDB NoSQL Injection
 * @description Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator.
 * @kind path-problem
 * @id mongodb-nosqli
 * @problem.severity warning
 * @precision high
 * @tags security
 *       external/cwe/cwe-943
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.MongoDB

class UserInputSource extends DataFlow::ExprNode {
  UserInputSource() {
    exists(Parameter p | this.asExpr() = p.getAnAccess()) or
    exists(ReturnStmt r | this.asExpr() = r.getResult()) or
    exists(LocalVariableDecl lvd | this.asExpr() = lvd.getInitializer())
  }

  override predicate isConstant() { not exists(StringLiteral sl | this.asExpr() = sl) }
}

class MongoDbSink extends DataFlow::ExprNode {
  MongoDbSink() {
    // BasicDBObject methods
    exists(MethodAccess ma |
      ma.getMethod().hasName(["put", "append", "putAll"]) and
      ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
      ma.getArgument(1) = this.asExpr()
    )
    or
    // BasicDBObject constructor
    exists(ConstructorCall cc |
      cc.getConstructor().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
      cc.getArgument(1) = this.asExpr()
    )
    or
    // BasicDBObjectBuilder methods
    exists(MethodAccess ma |
      ma.getMethod().hasName(["add", "append", "start"]) and
      ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObjectBuilder") and
      ma.getArgument(1) = this.asExpr()
    )
  }
}

class MongoDbTaintConfig extends TaintTracking::Configuration {
  MongoDbTaintConfig() { this = "MongoDB NoSQL Injection" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof MongoDbSink }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral sl | node.asExpr() = sl)
  }
}

