/**
 * @name MongoDB NoSQL Injection
 * @description Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id mongodb-nosqli
 * @tags security
 *       external/cwe/cwe-943
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class UserControlledInput extends DataFlow::Node {
  UserControlledInput() {
    exists(Method m, Parameter p | this.asParameter() = p and m.getAParameter() = p) or
    exists(ReturnStmt r | this.asExpr() = r.getResult()) or
    exists(LocalVariableDecl lvd | this.asExpr() = lvd.getVariable().getAnAccess())
  }

  override predicate isConstant() { none() } // Not a constant value
}

class MongoWhereSink extends DataFlow::Node {
  MongoWhereSink() {
    exists(Method m, MethodAccess ma |
      m.hasName(["put", "append", "putAll"]) and
      m.getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
      ma.getMethod() = m and
      ma.getArgument(1) = this.asExpr()
    )
    or
    exists(Constructor c, ConstructorCall cc |
      c.getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
      cc.getConstructor() = c and
      cc.getArgument(1) = this.asExpr()
    )
    or
    exists(Method m, MethodAccess ma |
      m.hasName(["add", "append", "start"]) and
      m.getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObjectBuilder") and
      ma.getMethod() = m and
      ma.getArgument(1) = this.asExpr()
    )
  }
}

class MongoDbTaintConfig extends TaintTracking::Configuration {
  MongoDbTaintConfig() { this = "MongoDB NoSQL Injection Taint Tracking" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserControlledInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof MongoWhereSink }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral sl | node.asExpr() = sl)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, MongoDbTaintConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Non-constant data passed into NoSQL query may lead to injection",
  source.getNode(), "User input flows to NoSQL query here"
