/**
 * @name MongoDB NoSQL Injection via $where
 * @description Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator
 * @id mongodb-nosqli
 * @kind path-problem
 * @severity Warning
 * @tags security
 *       external/cwe/cwe-943
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class MongoWhereSink extends DataFlow::Node {
  MongoWhereSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("put|append|putAll") and
       ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
       ma.getArgument(0).toString() = "$where") and
      this.asExpr() = ma.getArgument(1)
    )
    or
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("com.mongodb", "BasicDBObject") and
      cc.getArgument(0).toString() = "$where" and
      this.asExpr() = cc.getArgument(1)
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("start|add|append") and
      ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObjectBuilder") and
      ma.getArgument(0).toString() = "$where" and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class MongoWhereSanitizer extends DataFlow::Node {
  MongoWhereSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb.client.model", "Filters") and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

class MongoWhereConfig extends TaintTracking::Configuration {
  MongoWhereConfig() { this = "MongoWhereConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource or
    source.asExpr() instanceof Literal or
    source.asExpr().getExpr().getType() instanceof StringType
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MongoWhereSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof MongoWhereSanitizer
  }
}

