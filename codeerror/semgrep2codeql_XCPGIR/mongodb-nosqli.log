xcpgir_version: "1.0"
rule:
  id: mongodb-nosqli
  kind: taint
  severity: WARNING
  message: "Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator. This could lead to NoSQL injection if the data is user-controllable."
scope:
  languages: [java]
  frameworks: ["mongodb"]
  
sources:
  - id: USER_CONTROLLED_INPUT
    match:
      node: LITERAL | CALL
      where:
        - op: not
          left: value
          right: "\"..."

sinks:
  - id: MONGO_WHERE_QUERY
    match:
      node: CALL
      api: { type: com.mongodb.BasicDBObject, method: put|append|putAll }
      where:
        - op: eq
          left: arg[0].value
          right: "$where"
    - match:
        node: CALL
        api: { type: com.mongodb.BasicDBObject, method: "<init>" }
        where:
          - op: eq
            left: arg[0].value
            right: "$where"
    - match:
        node: CALL
        api: { type: com.mongodb.BasicDBObjectBuilder, method: start|add|append }
        where:
          - op: eq
            left: arg[0].value
            right: "$where"

propagations:
  - id: MONGO_PROPAGATION
    edge: arg->param
    kind: taint

flows:
  - source: USER_CONTROLLED_INPUT
    sink: MONGO_WHERE_QUERY
    through: [MONGO_PROPAGATION*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(com.mongodb.client.model.Filters.*)" } ]

report:
  message: "Non-constant data passed into NoSQL query using '$where' operator"
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: 1 }] }

tests:
  positive:
    - "query.put(\"$where\", userInput);"
    - "new BasicDBObject(\"$where\", request.getParameter(\"filter\"));"
  negative:
    - "query.put(\"$where\", \"static value\");"
    - "Filters.eq(\"name\", userInput);"
