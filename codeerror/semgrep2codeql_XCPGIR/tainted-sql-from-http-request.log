Rule Content:
/**
 * @name Tainted SQL from HTTP Request
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement.
 *              This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sql-from-http-request
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import semmle.code.java.frameworks.Spring

class HttpRequestSource extends RemoteFlowSource::Range {
  HttpRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["getInputStream", "getParameter", "getParameterMap", 
                             "getParameterValues", "getReader", "getCookies", "getHeader",
                             "getHeaderNames", "getHeaders", "getPart", "getParts", "getQueryString"]) and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet", "ServletRequest") and
      this.asExpr() = ma
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    // Statement execute methods
    exists(MethodAccess ma |
      ma.getMethod().hasName(["execute", "query", "executeUpdate", "batchUpdate"]) and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Statement") and
      this.asExpr() = ma.getArgument(0)
    )
    or
    // Connection.prepareStatement
    exists(MethodAccess ma |
      ma.getMethod().hasName("prepareStatement") and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma
    )
    or
    // JdbcTemplate methods
    exists(MethodAccess ma |
      ma.getMethod().hasName(["queryForObject", "queryForMap", "batchUpdate"]) and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      this.asExpr() = ma
    )
  }
}

class HttpToSqlFlowConfiguration extends TaintTracking::Configuration {
  HttpToSqlFlowConfiguration() { this = "HttpRequestToSqlInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }
}

from HttpToSqlFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "User input reaches SQL execution without sanitization", source, sink,
  "User input from $@ flows to SQL execution without sanitization here", source, source.toString()
