/**
 * @name Tainted SQL from HTTP Request
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement.
 *              This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sql-from-http-request
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpRequestSource extends RemoteFlowSource {
  HttpRequestSource() {
    exists(Method m |
      m.hasName(["getInputStream", "getParameter", "getParameterMap", 
                "getParameterValues", "getReader", "getCookies", "getHeader",
                "getHeaderNames", "getHeaders", "getPart", "getParts", "getQueryString"]) and
      m.getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet", "ServletRequest") and
      this.asParameter() = m.getACall()
    )
  }
  
  override string getSourceType() { result = "HTTP request parameter" }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    // Statement execute methods
    exists(MethodCall mc |
      mc.getMethod().hasName(["execute", "query", "executeUpdate", "batchUpdate"]) and
      mc.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Statement") and
      this.asExpr() = mc.getArgument(0)
    )
    or
    // Connection.prepareStatement
    exists(MethodCall mc |
      mc.getMethod().hasName("prepareStatement") and
      mc.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = mc
    )
    or
    // JdbcTemplate methods
    exists(MethodCall mc |
      mc.getMethod().hasName(["queryForObject", "queryForMap", "batchUpdate"]) and
      mc.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      this.asExpr() = mc
    )
  }
}

class HttpToSqlFlowConfiguration extends TaintTracking::Configuration {
  HttpToSqlFlowConfiguration() { this = "HttpRequestToSqlInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }
}

