Rule Content:
/**
 * @name JPA SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jpa-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.JPA

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(Assignment assign |
      assign.getRhs().(AddExpr).getChild(0).(VariableAccess).getName().regexpMatch(".*\\$X.*") and
      assign.getRhs().(AddExpr).getChild(1).(VariableAccess).getName().regexpMatch(".*\\$Y.*") and
      assign.getLhs() = this.asExpr()
    )
  }
}

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("createQuery") or 
       ma.getMethod().getName().matches("createNativeQuery")) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends Sanitizer {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("prepareStatement") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma
    )
  }
}

class JpaSqlInjectionConfig extends TaintTracking::Configuration {
  JpaSqlInjectionConfig() { this = "JpaSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringConcatSource or
    source instanceof StringFormatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

