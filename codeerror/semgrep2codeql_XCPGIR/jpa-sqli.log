/**
 * @name JPA SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jpa-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.jpa.Jpa

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(Assignment assign, Variable lhsVar, Expr rhs |
      rhs instanceof AddExpr and
      assign.getLhs() = lhsVar.getAnAccess() and
      assign.getRhs() = rhs and
      lhsVar.getName().matches("SQL") and
      this.asExpr() = rhs
    )
  }
}

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodAccess formatAccess |
      formatAccess.getMethod().hasName("format") and
      formatAccess.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = formatAccess
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(JpaQueryCreationMethodAccess qcma |
      (qcma.getMethodName() = "createQuery" or qcma.getMethodName() = "createNativeQuery") and
      this.asExpr() = qcma.getQueryArgument()
    )
  }
}

class JpaSqlInjectionConfig extends TaintTracking::Configuration {
  JpaSqlInjectionConfig() { this = "JpaSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringConcatSource or
    source instanceof StringFormatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess prepStmt |
      prepStmt.getMethod().hasName("prepareStatement") and
      prepStmt.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      sanitizer.asExpr() = prepStmt
    )
  }
}

