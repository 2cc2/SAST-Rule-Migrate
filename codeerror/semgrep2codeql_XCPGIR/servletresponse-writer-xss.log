Rule Content:
/**
 * @name ServletResponse writer XSS
 * @description Cross-site scripting detected in HttpServletResponse writer with user input.
 * @kind path-problem
 * @problem.severity error
 * @id java/servletresponse-writer-xss
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletRequestGetParameterSource extends TaintTracking::Source {
  ServletRequestGetParameterSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "getParameter" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet", "ServletRequest")
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    source.asExpr() = any(ServletRequestGetParameterSource s).getAMethodAccess().getAnArgument()
  }
}

class ServletResponseWriterSink extends TaintTracking::Sink {
  ServletResponseWriterSink() {
    exists(MethodAccess ma, MethodAccess write |
      ma.getMethod().getName() = "getWriter" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet", "ServletResponse") and
      write.getMethod().getName() = "write" and
      write.getQualifier() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess write |
      write.getMethod().getName() = "write" and
      write.getMethod().getDeclaringType().hasQualifiedName("java.io", "PrintWriter") and
      sink.asExpr() = write.getArgument(0)
    )
  }
}

class MissingHtmlEncoding extends TaintTracking::AdditionalTaintStep {
  override predicate edges(TaintTracking::Node n1, TaintTracking::Node n2) {
    exists(MethodAccess ma | 
      ma.getMethod().getName() = "forHtml" and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.owasp.encoder", "Encode") and
      n1.asExpr() = ma.getQualifier() and n2.asExpr() = ma
    )
  }
}

from ServletRequestGetParameterSource source, ServletResponseWriterSink sink, DataFlow::PathNode path
where TaintTracking::localTaint(path, source, sink) and not exists(MissingHtmlEncoding mhe | mhe.edges(_, _))
select path, source, sink, "Cross-site scripting detected in HttpServletResponse writer with user input. Ensure data is properly encoded using org.owasp.encoder.Encode.forHtml."
