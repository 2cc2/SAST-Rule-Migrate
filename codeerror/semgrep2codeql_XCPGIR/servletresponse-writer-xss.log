/**
 * @name ServletResponse writer XSS
 * @description Cross-site scripting detected in HttpServletResponse writer with user input.
 * @kind path-problem
 * @problem.severity error
 * @id java/servletresponse-writer-xss
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletRequestGetParameterSource extends DataFlow::CallableNode {
  ServletRequestGetParameterSource() {
    exists(Method m |
      m.hasName("getParameter") and
      m.getDeclaringType().hasQualifiedName("javax.servlet", "ServletRequest") and
      this.asCallable() = m
    )
  }
}

class ServletResponseWriterSink extends DataFlow::Node {
  ServletResponseWriterSink() {
    exists(MethodInvocation getWriter, MethodInvocation write |
      getWriter.getMethod().hasName("getWriter") and
      getWriter.getMethod().getDeclaringType().hasQualifiedName("javax.servlet", "ServletResponse") and
      write.getMethod().hasName("write") and
      write.getQualifier*() = getWriter and
      this.asExpr() = write.getArgument(0)
    )
  }
}

class MissingHtmlEncoding extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodInvocation ma | 
      ma.getMethod().hasName("forHtml") and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.owasp.encoder", "Encode") and
      node1.asExpr() = ma.getQualifier() and node2.asExpr() = ma
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintTracking::Configuration config
where
  config.hasFlowPath(source, sink) and
  exists(ServletRequestGetParameterSource s | source.getNode() = s.getANode()) and
  exists(ServletResponseWriterSink t | sink.getNode() = t) and
  not exists(MissingHtmlEncoding mhe | mhe.step(_, _))
select sink.getNode(), source, sink, "Cross-site scripting detected in HttpServletResponse writer with user input. Ensure data is properly encoded using org.owasp.encoder.Encode.forHtml."
