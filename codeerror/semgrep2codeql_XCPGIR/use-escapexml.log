/**
 * @name Use of unescaped Expression Language output
 * @description Detected an Expression Language segment that does not escape output.
 *              This is dangerous because if any data in this expression can be controlled
 *              externally, it is a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 5.0
 * @precision medium
 * @id java/use-escapexml
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class UnescapedExpressionSource extends DataFlow::Expr {
  UnescapedExpressionSource() {
    exists(string literal |
      this instanceof StringLiteral and
      this.getStringValue().regexpMatch("\\$\\{(?!.*escapeXml).*\\}")
    )
  }
}

class JspPrintSink extends DataFlow::Node {
  JspPrintSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "println" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp", "JspWriter") and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class EscapeXmlSanitizer extends DataFlow::BarrierGuard {
  EscapeXmlSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "escapeXml" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp.jstl.core", "Config") and
      this.asExpr() = ma
    )
  }
}

class UnescapedExpressionToPrintConfig extends TaintTracking::Configuration {
  UnescapedExpressionToPrintConfig() {
    this = "UnescapedExpressionToPrintConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof UnescapedExpressionSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JspPrintSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(EscapeXmlSanitizer exs | exs = sanitizer.asExpr())
  }
}

from UnescapedExpressionToPrintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Unescaped Expression Language segment detected", source, sink,
  "Potential XSS vulnerability from unescaped EL expression to JspWriter.println"
