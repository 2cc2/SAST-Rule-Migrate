/**
 * @name Use of unescaped Expression Language output  
 * @description Detected an Expression Language segment that does not escape output.
 *              This is dangerous because if any data in this expression can be controlled
 *              externally, it is a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning  
 * @security-severity 5.0
 * @precision medium
 * @id java/use-escapexml
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class UnescapedElSource extends DataFlow::Expr {
  UnescapedElSource() {
    this instanceof StringLiteral and
    this.getStringValue().regexpMatch("\\$\\{(?!.*escapeXml).*\\}")
  }
}

class JspWriterPrintlnSink extends DataFlow::Node {
  JspWriterPrintlnSink() {
    exists(Method method, MethodAccess call |
      method.hasName("println") and
      method.getDeclaringType().hasQualifiedName("javax.servlet.jsp", "JspWriter") and
      call.getMethod() = method and
      call.getArgument(0) = this.asExpr()
    )
  }
}

class EscapeXmlSanitizer extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("escapeXml") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp.jstl.core", "Config") and
      pred.asExpr() = ma.getArgument(0) and
      succ.asExpr() = ma
    )
  }
}

class UnescapedElToJspPrintConfig extends TaintTracking::Configuration {
  UnescapedElToJspPrintConfig() {
    this = "UnescapedElToJspPrintConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof UnescapedElSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JspWriterPrintlnSink
  }
}

