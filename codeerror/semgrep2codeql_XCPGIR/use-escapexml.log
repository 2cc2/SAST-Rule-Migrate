Rule Content:
/**
 * @name Expression Language XSS
 * @description Detects Expression Language segments that don't escape output, which could lead to XSS vulnerabilities
 * @id use-escapexml
 * @kind path-problem
 * @problem.severity WARNING
 * @tags security
 *       external/jsp
 *       external/cwe-xss
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

/** The source is an Expression Language input without escapeXml */
predicate isSource(Expr expr) {
  exists(CompileTimeConstantExpr ccExpr |
    ccExpr = expr and
    ccExpr.getStringValue().matches("\\$\\{(?!.*escapeXml).*\\}")
  )
}

/** The sink is Expression Language output */
predicate isSink(DataFlow::Node node) {
  exists(Expr expr | 
    node.asExpr() = expr and
    expr.toString().matches("\\$\\{.*\\}")
  )
}

/** Data flow configuration */
class EscapeXmlConfig extends TaintTracking::Configuration {
  EscapeXmlConfig() { this = "EscapeXmlConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Expr expr |
      shellcoding::isSource(expr) and
      source.asExpr() = expr
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    shellcoding::isSink(sink)
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "escapeXml" and
      sanitizer.asExpr() = ma
    )
  }
}

from EscapeXmlConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Expression Language segment without output escaping detected. Use 'escapeXml' function to prevent XSS.", 
  source.getNode(),
  "Potential XSS source here"
