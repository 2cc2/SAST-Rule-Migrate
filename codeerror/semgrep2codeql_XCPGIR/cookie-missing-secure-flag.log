propagations: []
flows:
  - source: INSECURE_COOKIE
    sink: ADD_COOKIE
    constraints:
      path:
        must_not: 
          - pattern: "CALL(javax.servlet.http.Cookie.setSecure(true))"
report:
  message: "A cookie was detected without setting the 'secure' flag."
  locations: ["sink"]
tests:
  positive:
    - "response.addCookie(new Cookie(\"name\", \"value\"));"
  negative:
    - "Cookie c = new Cookie(\"name\", \"value\"); c.setSecure(true); response.addCookie(c);"
