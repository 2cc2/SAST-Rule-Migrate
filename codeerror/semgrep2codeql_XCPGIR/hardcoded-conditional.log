Rule Content:
/**
 * @name Hardcoded Conditional
 * @description This if statement will always have the same behavior and is therefore unnecessary.
 * @kind problem
 * @problem.severity error
 * @id java/hardcoded-conditional
 */

import java

from IfStmt ifstmt, Expr cond
where
  cond = ifstmt.getCondition() and
  (
    // Match direct boolean literals
    (cond instanceof BooleanLiteral and (cond.(BooleanLiteral).getValue() = true or cond.(BooleanLiteral).getValue() = false)) 
    or
    // Match assignment of boolean literals ($VAR = true/false)
    (exists(AssignExpr assign | assign = cond and assign.getRight() instanceof BooleanLiteral))
    or
    // Match && expressions with boolean literals ($EXPR && false or false && $EXPR)
    (exists(BinaryExpr binary | 
      binary = cond and 
      (binary.getOp() instanceof AndLogicalExpr or binary.getOp() instanceof BitwiseAndExpr) and
      (binary.getLeft() instanceof BooleanLiteral or binary.getRight() instanceof BooleanLiteral)
    ))
    or
    // Match || expressions with boolean literals ($EXPR || true or true || $EXPR)
    (exists(BinaryExpr binary | 
      binary = cond and 
      (binary.getOp() instanceof OrLogicalExpr or binary.getOp() instanceof BitwiseOrExpr) and
      (binary.getLeft() instanceof BooleanLiteral or binary.getRight() instanceof BooleanLiteral)
    ))
  )
select ifstmt, "This if statement will always have the same behavior and is therefore unnecessary."
