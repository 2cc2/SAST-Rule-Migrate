Rule Content:
/**
 * @name Hardcoded Conditional
 * @description This if statement will always have the same behavior and is therefore unnecessary.
 * @kind problem
 * @problem.severity error
 * @id java/hardcoded-conditional
 */

import java

// Match boolean literals (true/false)
predicate isHardcodedCondition(Expr expr) {
  exists(expr.getType()) |
    expr.(BooleanLiteral).getValue() = true or
    expr.(BooleanLiteral).getValue() = false
}

// Match control flow structures with problematic constants
from IfStmt ifStmt, Expr cond
where
  cond = ifStmt.getCondition() and
  (
    // Direct true/false literals
    isHardcodedCondition(cond) or
    // Various problematic boolean expressions
    exists(cond.(BinaryExpr) binary |
      ( // $VAR = true/false
        binary.getOp() instanceof AssignExpr and
        isHardcodedCondition(binary.getRight())
      )
      or
      ( // $EXPR && false or false && $EXPR
        ((binary.getOp() instanceof AndExpr) or (binary.getOp() instanceof LogicalAndExpr)) and
        (isHardcodedCondition(binary.getLeft()) or isHardcodedCondition(binary.getRight()))
      )
      or
      ( // $EXPR || true or true || $EXPR
        ((binary.getOp() instanceof OrExpr) or (binary.getOp() instanceof LogicalOrExpr)) and
        (isHardcodedCondition(binary.getLeft()) or isHardcodedCondition(binary.getRight()))
      )
    )
  )
select ifStmt, "This if statement will always have the same behavior and is therefore unnecessary."
