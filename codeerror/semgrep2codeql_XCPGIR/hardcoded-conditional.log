/**
 * @name Hardcoded Conditional
 * @description Detects if statements that will always have the same behavior
 * @kind problem
 * @id java/hardcoded-conditional
 * @severity error
 * @tags correctness
 */

import java

// Match boolean literals used as conditions
predicate isTrueLiteral(Expr expr) {
  expr instanceof BooleanLiteral and expr.getValue() = true
}

predicate isFalseLiteral(Expr expr) {
  expr instanceof BooleanLiteral and expr.getValue() = false
}

from IfStmt ifStmt, Expr cond
where
  (
    // Condition is directly true/false literal
    (isTrueLiteral(cond) or isFalseLiteral(cond)) and
    cond = ifStmt.getCondition()
  )
  or
  (
    // Condition contains true/false literal
    exists(cond.getAChild*() |
      isTrueLiteral(_) or isFalseLiteral(_)
    )
  )
select ifStmt, "This if statement will always have the same behavior and is therefore unnecessary."
