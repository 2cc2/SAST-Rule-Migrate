/**
 * @name Hardcoded Conditional
 * @description Detect if statements with constant conditions that always evaluate to the same value
 * @kind problem
 * @problem.severity error
 * @id java/hardcoded-conditional
 */

import java

predicate isHardcodedCondition(Expr expr) {
  exists(boolean value | expr = BooleanLiteral.value(value))
}

from IfStmt ifStmt, Expr cond
where
  cond = ifStmt.getCondition() and
  (
    // Direct true/false literals
    isHardcodedCondition(cond)
    or
    // Assignment of boolean literals (VAR = true/false)
    exists(AssignExpr assign | 
      assign.getExpr() = cond and  
      isHardcodedCondition(assign.getRight())
    )
    or
    // Logical AND with false (EXPR && false/false && EXPR)
    exists(LogicalAndExpr andExpr | 
      andExpr.getExpr() = cond and
      (isHardcodedCondition(andExpr.getLeft()) or isHardcodedCondition(andExpr.getRight()))
    )
    or
    // Logical OR with true (EXPR || true/true || EXPR)
    exists(LogicalOrExpr orExpr | 
      orExpr.getExpr() = cond and
      (isHardcodedCondition(orExpr.getLeft()) or isHardcodedCondition(orExpr.getRight()))
    )
  )
select ifStmt, "This if statement will always have the same behavior and is therefore unnecessary."
================================================================================
