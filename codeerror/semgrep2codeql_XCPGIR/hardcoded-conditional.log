/**
 * @name Hardcoded Conditional
 * @description Detects if statements that will always have the same behavior
 * @kind problem
 * @id java/hardcoded-conditional
 * @severity error
 * @tags correctness
 */

import java

// Match boolean literals used as conditions
predicate isTrueLiteral(Expr expr) {
  exists(BooleanLiteral bl | bl = expr and bl.booleanValue() = true)
}

predicate isFalseLiteral(Expr expr) {
  exists(BooleanLiteral bl | bl = expr and bl.booleanValue() = false)
}

from IfStmt ifStmt
where
  // Condition is directly true/false literal
  (isTrueLiteral(ifStmt.getCondition()) or isFalseLiteral(ifStmt.getCondition()))
  or
  // Condition contains true/false literal
  exists(Expr expr |
    expr = ifStmt.getCondition().getAChildExpr() and
    (isTrueLiteral(expr) or isFalseLiteral(expr))
  )
