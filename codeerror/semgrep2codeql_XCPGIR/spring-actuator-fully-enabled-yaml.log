/**
 * @name Spring Boot Actuator Fully Enabled
 * @description Detects when Spring Boot Actuator endpoints are fully exposed ("*")
 *              which may expose sensitive functionality without authentication.
 * @id spring-actuator-fully-enabled-yaml
 * @kind problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-552
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.spring.SpringBoot

class FullyExposedEndpointConfig extends SpringBoot::PropertyValue {
  FullyExposedEndpointConfig() {
    this.getName() = "management.endpoints.web.exposure.include" and
    this.getValue().toString() = "*"
  }
}

class EndpointExposureCall extends MethodAccess {
  EndpointExposureCall() {
    this.getMethod().getDeclaringType().getQualifiedName() = "org.springframework.boot.actuate.endpoint" and
    this.getMethod().getName() = "expose"
  }
}

from FullyExposedEndpointConfig config, EndpointExposureCall call
where DataFlow::localFlow(DataFlow::exprNode(config), DataFlow::exprNode(call.getArgument(0)))
select call,
  "Spring Boot Actuator is fully enabled. This exposes sensitive endpoints such as " +
  "/actuator/env, /actuator/logfile, /actuator/heapdump and others. Unless you have " +
  "Spring Security enabled or another means to protect these endpoints, this " +
  "functionality is available without authentication, causing a severe security risk.",
  config, "Full exposure configuration here",
  call, "Endpoint exposure call here"
