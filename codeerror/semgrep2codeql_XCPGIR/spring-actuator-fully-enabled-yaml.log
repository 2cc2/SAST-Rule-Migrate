Rule Content:
/**
 * @name Spring Boot Actuator Fully Enabled
 * @description Detects when Spring Boot Actuator endpoints are fully exposed ("*")
 *              which may expose sensitive functionality without authentication.
 * @id spring-actuator-fully-enabled-yaml
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-552
 */

import yaml
import DataFlow::PathGraph

class YamlFullyExposedActuatorConfig extends Yaml::Value {
  YamlFullyExposedActuatorConfig() {
    exists(
      Yaml::Mapping m |
      m.getName().getScalar().matches("management.endpoints.web.exposure.include") and
      m = this.getParent().(*)
    ) and
    this.getScalar() = "*"
  }
}

class YamlActuatorEndpointExposure extends Yaml::Value {
  YamlActuatorEndpointExposure() {
    exists(
      Yaml::Mapping m |
      m.getName().getScalar().matches("org.springframework.boot.actuate.endpoint") and
      m.getValue("expose") = this.getParent().(*)
    )
  }
}

from YamlFullyExposedActuatorConfig source, YamlActuatorEndpointExposure sink
where DataFlow::path(source, sink)
select sink, "Spring Boot Actuator is fully enabled. " +
       "This exposes sensitive endpoints such as /actuator/env, /actuator/logfile, " +
       "/actuator/heapdump and others. Unless you have Spring Security enabled or " +
       "another means to protect these endpoints, this functionality is available " +
       "without authentication, causing a severe security risk.", source, source.toString()
