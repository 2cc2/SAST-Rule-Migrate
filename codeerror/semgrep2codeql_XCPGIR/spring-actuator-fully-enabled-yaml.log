Rule Content:
/**
 * @name Spring Boot Actuator Fully Enabled
 * @description Detects when Spring Boot Actuator endpoints are fully exposed ("*")
 *              which may expose sensitive functionality without authentication.
 * @id spring-actuator-fully-enabled-yaml
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-552
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.spring.SpringBoot

class ActuatorFullyExposedConfig extends DataFlow::Node {
  ActuatorFullyExposedConfig() {
    exists(SpringBoot::PropertyValue prop |
      prop.getName().matches("management.endpoints.web.exposure.include") and
      prop.getValue().toString() = "*" and
      this.asExpr() = prop.getValue()
    )
  }
}

class ActuatorEndpointExposure extends DataFlow::Node {
  ActuatorEndpointExposure() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().getQualifiedName() = "org.springframework.boot.actuate.endpoint" and
      ma.getMethod().getName() = "expose" and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

from ActuatorFullyExposedConfig source, ActuatorEndpointExposure sink,
     DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where DataFlow::flowPath(sourceNode, sinkNode) and
      sourceNode.getNode() = source and
      sinkNode.getNode() = sink
select sink,
       "Spring Boot Actuator is fully enabled. " +
       "This exposes sensitive endpoints such as /actuator/env, /actuator/logfile, " +
       "/actuator/heapdump and others. Unless you have Spring Security enabled or " +
       "another means to protect these endpoints, this functionality is available " +
       "without authentication, causing a severe security risk.",
       sourceNode, sinkNode,
       "Full exposure configuration", source.toString(),
       "Endpoint exposure call", sink.toString()
