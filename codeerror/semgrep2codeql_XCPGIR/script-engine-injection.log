Rule Content:
/**
 * @name Script Engine Injection
 * @description Detected potential code injection using ScriptEngine. Ensure user-controlled data cannot enter '.eval()', otherwise, this is a code injection vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/script-engine-injection
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class ScriptEngineEvalCall extends Expr {
  ScriptEngineEvalCall() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.script", "ScriptEngine") and
      m.getName() = "eval" and
      this = m.getACall()
    )
  }
}

class ScriptEngineTaintConfig extends TaintTracking::Configuration {
  ScriptEngineTaintConfig() { this = "ScriptEngineTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asParameter().getType().hasName("*")
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ScriptEngineEvalCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral lit | node.asExpr() = lit)
  }
}

from ScriptEngineTaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "User input reaches ScriptEngine.eval() without sanitization",
  source, sink,
  "User-controlled data flows to ScriptEngine.eval() call"
