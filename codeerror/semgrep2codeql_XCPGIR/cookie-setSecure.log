Rule Content:
/**
 * @name Insecure Cookie.setSecure Usage
 * @description Detects when Cookie.setSecure(false) is called without being overridden by setSecure(true)
 * @kind problem
 * @id java/insecure-cookie-setSecure
 * @security-severity 7.5
 * @precision high
 */
import java

predicate isCookieConstructor(MethodAccess ma) {
  ma.getMethod().hasName("<init>") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
}

predicate isSetSecureFalse(MethodAccess ma) {
  ma.getMethod().hasName("setSecure") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
  exists(FalseLiteral f | ma.getArgument(0) = f)
}

predicate isSetSecureTrue(MethodAccess ma) {
  ma.getMethod().hasName("setSecure") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
  exists(TrueLiteral t | ma.getArgument(0) = t)
}

from MethodAccess cookieCreation, MethodAccess insecureSet, DataFlow::Node src, DataFlow::Node sink
where
  isCookieConstructor(cookieCreation) and
  isSetSecureFalse(insecureSet) and
  not exists(MethodAccess secureSet | isSetSecureTrue(secureSet) and secureSet.getReceiver() = insecureSet.getReceiver()) and
  src.asExpr() = cookieCreation and
  sink.asExpr() = insecureSet and
  DataFlow::localFlow(src, sink)
select insecureSet, "Insecure Transport: Cookie.setSecure(false) detected without secure override. Cookies should be sent only over HTTPS to prevent cross-site scripting attacks."
