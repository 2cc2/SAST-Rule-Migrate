/**
 * @name cookie-setSecure
 * @description Default session middleware settings: `setSecure` not set to true.
 *              This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id java/cookie-setSecure
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class CookieCreation extends Expr {
  CookieCreation() {
    exists(Method m |
      m.hasName("<init>") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this = m.getACall()
    )
  }
}

class InsecureSetSecure extends Expr {
  InsecureSetSecure() {
    exists(Method m, Literal lit |
      m.hasName("setSecure") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this = m.getACall() and
      lit = this.getArgument(0) and
      lit.getValue().toString() = "false"
    )
  }
}

class SecureSetSecure extends Expr {
  SecureSetSecure() {
    exists(Method m, Literal lit |
      m.hasName("setSecure") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this = m.getACall() and
      lit = this.getArgument(0) and
      lit.getValue().toString() = "true"
    )
  }
}

class CookieToInsecureFlow extends TaintTracking::Configuration {
  CookieToInsecureFlow() { this = "CookieToInsecureFlow" }

  override predicate isSource(DataFlow::Node source) {
    exists(CookieCreation cc | source.asExpr() = cc)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(InsecureSetSecure iss | sink.asExpr() = iss)
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(SecureSetSecure sss | node.asExpr() = sss)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, CookieToInsecureFlow config
where config.hasFlowPath(source, sink)
select sink.getNode(), "Default session middleware settings: `setSecure` not set to true.",
  source.getNode(), "Cookie created here"
