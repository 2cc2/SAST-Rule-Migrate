/**
 * @name Insecure Cookie Secure Flag Setting
 * @description Detects when cookies are created without setting the secure flag to true,
 *              which ensures cookies are only sent over HTTPS.
 * @kind path-problem
 * @id java/cookie-setSecure
 * @problem.severity warning
 * @precision high
 * @tags security
 *       external/cwe/cwe-319
 *       external/owasp/a03:2017
 *       external/owasp/a02:2021
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.Servlets

class CookieCreation extends DataFlow::Node {
  CookieCreation() {
    exists(Method m | 
      m.hasName("<init>") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.asExpr() = any(Expr e | e.(ConstructorCall).getConstructedType() = m.getDeclaringType())
    )
  }
}

class InsecureSetSecureCall extends DataFlow::Node {
  InsecureSetSecureCall() {
    exists(Method m | 
      m.hasName("setSecure") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.asExpr() = any(Call call |
        call.getCallee() = m and
        call.getArgument(0).(BooleanLiteral).getValue() = false
      )
    )
  }
}

class SecureSetSecureCall extends DataFlow::Node {
  SecureSetSecureCall() {
    exists(Method m |
      m.hasName("setSecure") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.asExpr() = any(Call call |
        call.getCallee() = m and
        call.getArgument(0).(BooleanLiteral).getValue() = true
      )
    )
  }
}

class InsecureCookieSecureFlow extends DataFlow::Configuration {
  InsecureCookieSecureFlow() { this = "InsecureCookieSecureFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof CookieCreation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InsecureSetSecureCall
  }
}

