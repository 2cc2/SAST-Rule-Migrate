/**
 * @name Insecure Cookie Secure Flag Setting
 * @description Detects when cookies are created without setting the secure flag to true,
 *              which ensures cookies are only sent over HTTPS.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/cookie-setSecure
 * @tags security
 *       external/cwe/cwe-319
 *       external/owasp/a03:2017
 *       external/owasp/a02:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class CookieCreation extends TaintTracking::Source {
  CookieCreation() {
    exists(Method m | 
      m.hasName("<init>") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
  }
}

class InsecureSetSecureCall extends TaintTracking::Sink {
  InsecureSetSecureCall() {
    exists(Method m | 
      m.hasName("setSecure") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.asExpr() = any(MethodAccess ma |
        ma.getMethod() = m and
        ma.getArgument(0).(BooleanLiteral).getValue() = false
      )
    )
  }
}

class SecureSetSecureSanitizer extends TaintTracking::Sanitizer {
  SecureSetSecureSanitizer() {
    exists(Method m |
      m.hasName("setSecure") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.asExpr() = any(MethodAccess ma |
        ma.getMethod() = m and
        ma.getArgument(0).(BooleanLiteral).getValue() = true
      )
    )
  }
}

class InsecureCookieConfig extends TaintTracking::Configuration {
  InsecureCookieConfig() { this = "InsecureCookieConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof CookieCreation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InsecureSetSecureCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SecureSetSecureSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    none() // No additional taint steps needed
  }
}

from InsecureCookieConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Insecure Transport: Cookie.setSecure(false) detected without subsequent secure setting",
  source, "Cookie created here",
  sink, "Insecure Cookie.setSecure(false) call"
