/**
 * @name cookie-setSecure
 * @description Default session middleware settings: `setSecure` not set to true. 
 *              This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/cookie-setSecure
 */

import java
import semmle.code.java.dataflow.DataFlow

class CookieCreation extends MethodAccess {
  CookieCreation() {
    this.getMethod().hasName("<init>") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
  }
}

class InsecureSetSecure extends MethodAccess {
  InsecureSetSecure() {
    this.getMethod().hasName("setSecure") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    this.getArgument(0).(Literal).getValue().toString() = "false"
  }
}

class SecureSetSecure extends MethodAccess {
  SecureSetSecure() {
    this.getMethod().hasName("setSecure") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    this.getArgument(0).(Literal).getValue().toString() = "true"
  }
}

class CookieToInsecureFlow extends TaintTracking::Configuration {
  CookieToInsecureFlow() { this = "CookieToInsecureFlow" }

  override predicate isSource(DataFlow::Node source) {
    exists(CookieCreation cc | source.asExpr() = cc)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(InsecureSetSecure iss | sink.asExpr() = iss)
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SecureSetSecure sss | sanitizer.asExpr() = sss)
  }
}

from DataFlow::Node source, DataFlow::Node sink, CookieToInsecureFlow config
where config.hasFlow(source, sink)
select sink, "Default session middleware settings: `setSecure` not set to true.", 
  source, "Cookie created here"
