Rule Content:
/**
 * @name Insecure Cookie Secure Flag Setting
 * @description Detects when cookies are created without setting the secure flag to true,
 *              which ensures cookies are only sent over HTTPS.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @tags security
 *       external/cwe/cwe-319
 *       external/owasp/a03:2017
 *       external/owasp/a02:2021
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Servlets

class CookieCreation extends DataFlow::Node {
  CookieCreation() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("<init>") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.asExpr() = ma
    )
  }
}

class InsecureSetSecureCall extends DataFlow::Node {
  InsecureSetSecureCall() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("setSecure") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      ma.getArgument(0).(BooleanLiteral).getValue() = false and
      this.asExpr() = ma
    )
  }
}

class SecureSetSecureCall extends DataFlow::Node {
  SecureSetSecureCall() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("setSecure") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      ma.getArgument(0).(BooleanLiteral).getValue() = true and
      this.asExpr() = ma
    )
  }
}

class InsecureCookieSecureFlow extends DataFlow::Configuration {
  InsecureCookieSecureFlow() { this = "InsecureCookieSecureFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof CookieCreation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InsecureSetSecureCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SecureSetSecureCall
  }

  override predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Ensure no secure setting between source and sink
    not exists(SecureSetSecureCall secure |
      DataFlow::localFlow(node1, secure) and
      DataFlow::localFlow(secure, node2)
    )
  }
}

from InsecureCookieSecureFlow flow, DataFlow::Node source, DataFlow::Node sink
where
  flow.hasFlow(source, sink)
select sink, "Insecure Transport: Cookie.setSecure(false) detected without subsequent secure setting",
  source, "Cookie created here",
  sink, "Insecure Cookie.setSecure(false) call"
