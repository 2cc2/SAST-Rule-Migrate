Rule Content:
/**
 * @name Server Dangerous Class Deserialization
 * @description Using a non-primitive class with Java RMI may be an insecure deserialization vulnerability.
 *              Depending on the implementation, this could allow code execution. Use integer IDs or JSON instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/server-dangerous-class-deserialization
 * @tags security
 *       external/cwe/cwe-502
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

predicate isRmiRemoteInterface(RefType t) {
  exists(RefType superType |
    superType.hasQualifiedName("java.rmi", "Remote") and
    t.isInterface() and
    t.getASupertype*() = superType
  )
}

predicate isNonPrimitiveType(Type t) {
  not t instanceof PrimitiveType and
  not t.getUnboxedType().hasName(["int", "boolean", "short", "long", "byte", "char", "float", "double"])
}

class RmiNonPrimitiveParameter extends Parameter {
  RmiNonPrimitiveParameter() {
    exists(Method m |
      isRmiRemoteInterface(m.getDeclaringType()) and
      m.getAParameter() = this and
      isNonPrimitiveType(this.getType()) and
      m.getAnException().getSourceDeclaration().hasQualifiedName("java.rmi", "RemoteException")
    )
  }
}

class RmiTaintTrackingConfig extends TaintTracking::Configuration {
  RmiTaintTrackingConfig() { this = "RmiTaintTrackingConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      source.asParameter() = p and
      isRmiRemoteInterface(p.getType())
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asParameter() instanceof RmiNonPrimitiveParameter
  }
}

from RmiTaintTrackingConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential insecure deserialization via Java RMI non-primitive parameter", 
  source, sink, "Non-primitive parameter in RMI interface"
