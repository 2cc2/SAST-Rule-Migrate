/**
 * @name Server dangerous class deserialization
 * @description Using a non-primitive class with Java RMI may be an insecure deserialization vulnerability.
 * @kind problem
 * @id java/server-dangerous-class-deserialization
 * @security-severity 8.0
 * @tags security
 *       external/cwe/cwe-502
 */

import java

predicate isRmiRemoteMethod(Method method) {
  exists(RefType rt |
    method.getDeclaringType() = rt and
    rt.hasQualifiedName(_, _, name) and
    name.matches(".*Remote$")
  )
}

predicate isNonPrimitiveParameter(Method method) {
  exists(Parameter p |
    p = method.getParameter(0) and
    not p.getType() instanceof PrimitiveType
  )
}

from Method method
where
  isRmiRemoteMethod(method) and
  isNonPrimitiveParameter(method)
select method,
  "This object could be manipulated by a malicious actor allowing them to execute code on your system. " +
  "Instead, use an integer ID to look up your object, or consider alternative serialization schemes such as JSON."
