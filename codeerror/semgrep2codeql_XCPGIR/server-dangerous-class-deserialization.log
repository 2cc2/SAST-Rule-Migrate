Rule Content:
/**
 * @name Server Dangerous Class Deserialization
 * @description Using a non-primitive class with Java RMI may be an insecure deserialization vulnerability.
 *              Depending on the implementation, this could allow code execution. Use integer IDs or JSON instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/server-dangerous-class-deserialization
 * @tags security
 *       external/cwe/cwe-502
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class RmiRemoteInterface extends RefType {
  RmiRemoteInterface() {
    this.getASupertype().hasQualifiedName("java.rmi", "Remote") and
    this.isInterface()
  }
}

class NonPrimitiveType extends Type {
  NonPrimitiveType() {
    not this instanceof PrimitiveType and
    not this.hasName(["int", "boolean", "short", "long", "byte", "char", "float", "double"])
  }
}

class RmiNonPrimitiveParameter extends MethodParameter {
  RmiNonPrimitiveParameter() {
    exists(Method m |
      m.getDeclaringType() instanceof RmiRemoteInterface and
      m.getAParameter() = this and
      this.getType() instanceof NonPrimitiveType and
      m.getAnException().hasQualifiedName("java.rmi", "RemoteException")
    )
  }
}

class RmiTaintTrackingConfig extends TaintTracking::Configuration {
  RmiTaintTrackingConfig() { this = "RmiTaintTrackingConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asParameter().getType().getASupertype().hasQualifiedName("java.rmi", "Remote")
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asParameter() instanceof RmiNonPrimitiveParameter
  }
}

from RmiTaintTrackingConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Potential insecure deserialization via Java RMI non-primitive parameter", sink,
  source.getNode().asParameter().getType(), "comes from $@", source.getNode().asParameter(),
  "this RMI interface parameter"
