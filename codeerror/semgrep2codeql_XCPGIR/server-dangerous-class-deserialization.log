Rule Content:
/**
 * @name Server Dangerous Class Deserialization
 * @description Using a non-primitive class with Java RMI may be an insecure deserialization vulnerability. 
 *              Depending on the implementation, this could allow code execution. Use integer IDs or JSON instead.
 * @kind problem
 * @problem.severity warning
 * @id java/server-dangerous-class-deserialization
 * @tags security
 *       external/cwe/cwe-502
 */

import java

// Find interfaces extending Remote
class RmiRemoteInterface extends RefType {
  RmiRemoteInterface() {
    this.getASupertype().hasQualifiedName("java.rmi", "Remote") and
    this.isInterface()
  }
}

// Match non-primitive parameter types
predicate isNonPrimitiveType(Type t) {
  not t instanceof PrimitiveType
  and not t.getUnannotatedName().matches("int|boolean|short|long|byte|char|float|double")
}

from Method method, Parameter param
where
  // Method is in RMI interface
  method.getDeclaringType() instanceof RmiRemoteInterface and
  // Parameter is non-primitive type
  isNonPrimitiveType(param.getType()) and
  // Method throws RemoteException
  method.getAnException().hasQualifiedName("java.rmi", "RemoteException")
select param, 
  "Potential insecure deserialization via Java RMI non-primitive parameter",
  param.getLocation()
