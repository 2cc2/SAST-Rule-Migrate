Rule Content:
/**
 * @name Anonymous LDAP Bind
 * @description Detected anonymous LDAP bind. This permits anonymous users to execute LDAP statements.
 *              Consider enforcing authentication for LDAP.
 * @id java/anonymous-ldap-bind
 * @kind path-problem
 * @problem.severity warning
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Ldap

class AnonymousAuthSetting extends DataFlow::Node {
  AnonymousAuthSetting() {
    exists(MethodAccess putCall |
      putCall.getMethod().getName() = "put" and
      putCall.getQualifier().toString().matches(".*SECURITY_AUTHENTICATION") and
      putCall.getArgument(1).(Literal).getValue().toLowerCase() = "none" and
      this.asExpr() = putCall
    )
  }
}

class LdapContextInitialization extends DataFlow::Node {
  LdapContextInitialization() {
    exists(ConstructorCall call |
      call.getConstructedType().hasQualifiedName("javax.naming", "InitialDirContext") and
      this.asExpr() = call
    )
  }
}

class LDAPAnonymousBindConfig extends TaintTracking::Configuration {
  LDAPAnonymousBindConfig() { this = "LDAPAnonymousBindConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof AnonymousAuthSetting
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof LdapContextInitialization
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    any(Ldap::EnvironmentLookup envLookup |
      envLookup.getADependentCall() = pred.asExpr() and
      succ.asExpr() = envLookup
    )
  }
}

from LDAPAnonymousBindConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected anonymous LDAP bind. This permits anonymous users to execute LDAP statements. " +
  "Consider enforcing authentication for LDAP.", 
  source, sink,
  "Anonymous authentication setting", "LDAP context initialization"
