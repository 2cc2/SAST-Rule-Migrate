/**
 * @name Java Reverse Shell Detection
 * @description Detects potential reverse shell behavior in Java code
 * @kind path-problem
 * @problem.severity warning
 * @id java/reverse-shell
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow

class SocketCreation extends DataFlow::Node {
  SocketCreation() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("<init>") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.net", "Socket")
      and this.asExpr() = ma
    )
  }
}

class ProcessBuilderStart extends DataFlow::Node {
  ProcessBuilderStart() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("start") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
      and this.asExpr() = ma
    )
  }
}

class IOOperation extends DataFlow::Node {
  IOOperation() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("read") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "InputStream")
      and this.asExpr() = ma
    )
  }
}

class SocketToInputStream extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getInputStream") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.net", "Socket") and
      pred.asExpr() = ma.getQualifier() and
      succ.asExpr() = ma
    )
  }
}

predicate isSocketToIOFlow(DataFlow::Node source, DataFlow::Node sink) {
  exists(MethodAccess socketGetInput |
    socketGetInput.getMethod().hasName("getInputStream") and
    socketGetInput.getMethod().getDeclaringType().hasQualifiedName("java.net", "Socket") and
    DataFlow::localFlow(source, socketGetInput.getQualifier()) and
    DataFlow::localFlow(socketGetInput, sink)
  )
}

predicate isProcessBuilderToIOFlow(DataFlow::Node source, DataFlow::Node sink) {
  DataFlow::localFlow(source, sink)
}

from DataFlow::Node source, DataFlow::Node sink
where 
  (source instanceof SocketCreation and sink instanceof IOOperation and isSocketToIOFlow(source, sink)) or
  (source instanceof ProcessBuilderStart and sink instanceof IOOperation and isProcessBuilderToIOFlow(source, sink))
select sink, "Potential reverse shell behavior detected", source, sink.toString()
