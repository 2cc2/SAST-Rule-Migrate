/**
 * @name Java Reverse Shell Detection
 * @description Detects potential reverse shell behavior in Java code
 * @kind problem
 * @problem.severity warning
 * @id java/reverse-shell
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class SocketSource extends DataFlow::Node {
  SocketSource() {
    exists(Method m |
      m.hasName("<init>") and
      m.getDeclaringType().hasQualifiedName("java.net", "Socket") and
      this.asParameter() = m.getAParameter()
    )
  }
}

class ProcessBuilderSink extends DataFlow::Node {
  ProcessBuilderSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("start") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.asExpr() = ma
    )
  }
}

class IOSink extends DataFlow::Node {
  IOSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("read") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "InputStream") and
      this.asExpr() = ma
    )
  }
}

class SocketToInputStreamTaintStep extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node from, DataFlow::Node to) {
    exists(MethodAccess getInput |
      getInput.getMethod().hasName("getInputStream") and
      getInput.getMethod().getDeclaringType().hasQualifiedName("java.net", "Socket") and
      from.asExpr() = getInput.getQualifier() and
      to.asExpr() = getInput
    )
  }
}

predicate socketToIOFlow(DataFlow::Node source, DataFlow::Node sink) {
  exists(DataFlow::Node inputStream |
    exists(MethodAccess getInput |
      getInput.getMethod().hasName("getInputStream") and
      getInput.getMethod().getDeclaringType().hasQualifiedName("java.net", "Socket") and
      inputStream.asExpr() = getInput
    ) and
    TaintTracking::localTaint(source, inputStream) and
    TaintTracking::localTaint(inputStream, sink)
  )
}

predicate processBuilderToIOFlow(DataFlow::Node source, DataFlow::Node sink) {
  TaintTracking::localTaint(source, sink)
}

from DataFlow::Node source, DataFlow::Node sink
where 
  (source instanceof SocketSource and sink instanceof IOSink and socketToIOFlow(source, sink)) or
  (source instanceof ProcessBuilderSink and sink instanceof IOSink and processBuilderToIOFlow(source, sink))
select sink, "Potential reverse shell behavior detected", source, sink.toString()
