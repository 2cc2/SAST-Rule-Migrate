Rule Content:
/**
 * @name Java Reverse Shell Detection
 * @description Detects potential reverse shell behavior where process output is redirected to socket I/O
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.8
 * @precision high
 * @id java/reverse-shell
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ProcessStartSource extends DataFlow::Node {
  ProcessStartSource() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getMethod().getName() = "start" and
      this.asExpr() = ma
    )
  }
}

class SocketIOSink extends DataFlow::Node {
  SocketIOSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.net", "Socket") and
        ma.getMethod().getName() = "getInputStream"
      ) or
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "InputStream") and
        ma.getMethod().getName() in ["read", "available"]
      ) or
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "OutputStream") and
        ma.getMethod().getName() in ["write", "flush"]
      ) and
      this.asExpr() = ma
    )
  }
}

class ProcessStopBarrier extends BarrierGuard {
  override predicate blocks(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Process") and
      ma.getMethod().getName() = "destroy" and
      succ.asExpr() = ma
    )
  }
}

class ReverseShellConfig extends TaintTracking::Configuration {
  ReverseShellConfig() { this = "ReverseShellConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ProcessStartSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SocketIOSink
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof ProcessStopBarrier
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(FieldAccess fa | 
      fa.getField().getType() instanceof RefType and
      pred.asExpr() = fa.getQualifier() and
      succ.asExpr() = fa
    )
  }
}

from ReverseShellConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  source.getNode() + " produces process output that flows to socket I/O " + sink.getNode() + ", which may indicate a reverse shell",
  source.getNode(), "Process output source",
  sink.getNode(), "Socket I/O sink"
