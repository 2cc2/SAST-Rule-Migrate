xcpgir_version: "1.0"
rule:
  id: "java-reverse-shell"
  kind: hybrid
  severity: WARNING
  message: "Semgrep found potential reverse shell behavior"
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources:
  - id: SOCKET_CREATION
    match:
      node: CALL
      api: { type: "java.net.Socket", method: "<init>" }
sinks:
  - id: PROCESS_BUILDER
    match:
      node: CALL
      api: { type: "java.lang.ProcessBuilder", method: "start" }
  - id: IO_OPERATION
    match:
      node: CALL
      api: { type: "java.io.InputStream", method: "read" }
sanitizers: []
barriers: []
propagations:
