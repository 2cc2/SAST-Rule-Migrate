Rule Content:
/**
 * @name Java Reverse Shell Detection
 * @description Detects potential reverse shell behavior where process output is redirected to socket I/O
 * @kind path-problem
 * @problem.severity warning
 * @id java/reverse-shell
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.ControlFlow

class ProcessStartSource extends DataFlow::Node {
  ProcessStartSource() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      m.getName() = "start" and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getQualifier()
    )
  }
}

class SocketIOOperation extends DataFlow::Node {
  SocketIOOperation() {
    exists(Method m |
      (
        m.getDeclaringType().hasQualifiedName("java.net", "Socket") and
        m.getName() = "getInputStream"
      ) or
      (
        m.getDeclaringType().hasQualifiedName("java.io", "InputStream") and
        m.getName() in ["read", "available"]
      ) or
      (
        m.getDeclaringType().hasQualifiedName("java.io", "OutputStream") and
        m.getName() in ["write", "flush"]
      ) and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
  }
}

class SocketObject extends DataFlow::Node {
  SocketObject() {
    exists(Class c | 
      c.hasQualifiedName("java.net", "Socket") and
      this.getType() = c
    )
  }
}

class WhileLoop extends DataFlow::Node {
  WhileLoop() {
    exists(WhileStmt ws | this.asExpr() = ws.getCondition())
  }
}

class ReverseShellFlow extends TaintTracking::Configuration {
  ReverseShellFlow() { this = "ReverseShellFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ProcessStartSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SocketIOOperation
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(FieldAccess fa | 
      pred.asExpr() = fa.getQualifier() and
      succ.asExpr() = fa
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Process") and
      ma.getMethod().getName() = "destroy" and
      node.asExpr() = ma
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SocketObject socket, WhileLoop loop
where 
  any(ReverseShellFlow cfg).hasFlowPath(source, sink) and
  DataFlow::exprNode(socket.asExpr()).getAPathTo(source.asExpr()).exists() and
  DataFlow::exprNode(loop.asExpr()).getAPathTo(sink.asExpr()).exists()
select sink.getNode(),
  source.getNode() + " produces process output that flows to socket I/O " + sink.getNode() + ", indicating potential reverse shell",
  source.getNode(), "Process output source",
  sink.getNode(), "Socket I/O sink"
