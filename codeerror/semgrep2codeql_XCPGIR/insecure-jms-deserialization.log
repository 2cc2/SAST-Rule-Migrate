Rule Content:
/**
 * @name Insecure JMS Deserialization
 * @description JMS Object messages depend on Java Serialization for marshalling/unmarshalling of the message payload 
 *              when ObjectMessage.getObject() is called. Deserialization of untrusted data can lead to security flaws;
 *              a remote attacker could via a crafted JMS ObjectMessage to execute arbitrary code with the permissions
 *              of the application listening/consuming JMS Messages.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-jms-deserialization
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jms.JMS

class JMSObjectMessageSource extends TaintTracking::Source {
  JMSObjectMessageSource() {
    exists(MethodParameter p | 
      p.getType().hasName("javax.jms.ObjectMessage") and
      this.asParameter() = p
    )
  }
}

class GetObjectSink extends TaintTracking::Sink {
  GetObjectSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getObject") and
      ma.getMethod().getDeclaringType().hasName("javax.jms.ObjectMessage") and
      this.asExpr() = ma
    )
  }
}

class JMSDeserializationConfig extends TaintTracking::Configuration {
  JMSDeserializationConfig() { this = "JMSDeserializationConfig" }
  
  override predicate isSource(TaintTracking::Source source) {
    source instanceof JMSObjectMessageSource
  }
  
  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof GetObjectSink
  }
}

from JMSDeserializationConfig cfg, TaintTracking::PathNode source, TaintTracking::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential insecure JMS deserialization from $@ to $@",
  source.getNode(), "untrusted JMS ObjectMessage",
  sink.getNode(), "call to getObject()"
