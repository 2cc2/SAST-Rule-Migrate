/**
 * @name SAXParserFactory XXE Vulnerability
 * @description DOCTYPE declarations are enabled for this SAXParserFactory. This is vulnerable to XML 
 * external entity attacks. Disable this by setting the feature 
 * `http://apache.org/xml/features/disallow-doctype-decl` to true.
 * @id saxparserfactory-disallow-doctype-decl-missing
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-611
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class SAXParserFactoryInstance extends DataFlow::Node {
  SAXParserFactoryInstance() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      ma.getMethod().getName() = "newInstance" and
      this.asExpr() = ma      
    )
  }
}

class SAXParserInstance extends DataFlow::Node {
  SAXParserInstance() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      ma.getMethod().getName() = "newSAXParser" and
      this.asExpr() = ma
    )
  }
}

class SafeFeatureSetting extends DataFlow::Node {
  SafeFeatureSetting() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      ma.getMethod().getName() = "setFeature" and
      (
        (ma.getArgument(0).(StringLiteral).getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
         ma.getArgument(1).(BooleanLiteral).getValue() = true)
        or
        (ma.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-general-entities" and
         ma.getArgument(1).(BooleanLiteral).getValue() = false)
      ) and
      this.asExpr() = ma
