/**
 * @name SAXParserFactory XXE Vulnerability
 * @description DOCTYPE declarations are enabled for this SAXParserFactory. This is vulnerable to XML 
 * external entity attacks. Disable this by setting the feature 
 * `http://apache.org/xml/features/disallow-doctype-decl` to true.
 * @id saxparserfactory-disallow-doctype-decl-missing
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-611
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class SAXParserFactorySource extends DataFlow::Node {
  SAXParserFactorySource() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      m.hasName("newInstance") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
    and
    not exists(Method mSetFeature |
      mSetFeature.getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      mSetFeature.hasName("setFeature") and
      exists(MethodAccess ma |
        ma.getMethod() = mSetFeature and
        (
          (ma.getArgument(0).(StringLiteral).getValue() = 
            "http://apache.org/xml/features/disallow-doctype-decl")
          or
          (ma.getArgument(0).(StringLiteral).getValue() = 
            "http://xml.org/sax/features/external-general-entities")
        )
      )
    )
  }
}

class SAXParserSink extends DataFlow::Node {
  SAXParserSink() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      m.hasName("newSAXParser") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
  }
}

class SecureSAXFeatureSetting extends DataFlow::Node {
  SecureSAXFeatureSetting() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      m.hasName("setFeature") and
      exists(MethodAccess ma |
        ma.getMethod() = m and
        (
          (ma.getArgument(0).(StringLiteral).getValue() = 
            "http://apache.org/xml/features/disallow-doctype-decl" and
           ma.getArgument(1).(BooleanLiteral).booleanValue() = true)
          or
          (ma.getArgument(0).(StringLiteral).getValue() = 
            "http://xml.org/sax/features/external-general-entities" and
           ma.getArgument(1).(BooleanLiteral).booleanValue() = false)
        )
      ) and
      this.asExpr() = ma
    )
  }
}

class SAXParserTaintConfig extends TaintTracking::Configuration {
  SAXParserTaintConfig() { this = "SAXParserTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SAXParserFactorySource }
  override predicate isSink(DataFlow::Node sink) { sink instanceof SAXParserSink }
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SecureSAXFeatureSetting
  }
}

