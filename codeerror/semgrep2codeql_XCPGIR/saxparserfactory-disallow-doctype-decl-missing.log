/**
 * @name SAXParserFactory vulnerable to XML external entity attacks
 * @description DOCTYPE declarations are enabled for this SAXParserFactory.
 *              This is vulnerable to XML external entity attacks. Disable this
 *              by setting the feature `http://apache.org/xml/features/disallow-doctype-decl` to true.
 * @kind path-problem
 * @problem.severity error
 * @id java/saxparserfactory-disallow-doctype-decl-missing
 * @tags security
 *       external/cwe/cwe-611
 */

import java
import semmle.code.java.dataflow.TaintTracking

class SAXParserFactoryCreation extends DataFlow::Node {
  SAXParserFactoryCreation() {
    exists(Method m |
      m.hasName("newInstance") and
      m.getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      this.asExpr() = m.getACall()
    )
  }
}

class SAXParserCreation extends DataFlow::Node {
  SAXParserCreation() {
    exists(Method m |
      m.hasName("newSAXParser") and
      m.getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      this.asExpr() = m.getACall()
    )
  }
}

class SafeFeatureSetting extends DataFlow::Node {
  SafeFeatureSetting() {
    exists(MethodCall mc, Literal uri, Literal value |
      mc.getMethod().hasName("setFeature") and
      mc.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      uri = mc.getArgument(0) and
      uri.getValue().toString() = "http://apache.org/xml/features/disallow-doctype-decl" and
      value = mc.getArgument(1) and
      value.getValue().toString() = "true" and
      this.asExpr() = mc
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "SAXParserFactoryXXEVulnerability" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SAXParserFactoryCreation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SAXParserCreation
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeFeatureSetting
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    exists(ReturnStmt rs | barrier.asExpr() = rs)
  }
}

