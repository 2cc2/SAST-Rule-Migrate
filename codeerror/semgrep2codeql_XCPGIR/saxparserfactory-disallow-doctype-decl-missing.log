 * @description DOCTYPE declarations are enabled for this SAXParserFactory.
 *              This is vulnerable to XML external entity attacks. Disable this
 *              by setting the feature `http://apache.org/xml/features/disallow-doctype-decl` to true.
 * @kind path-problem
 * @problem.severity error
 * @id java/saxparserfactory-disallow-doctype-decl-missing
 * @tags security
 *       external/cwe/cwe-611
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.XML

class SAXParserFactoryCreation extends MethodAccess {
  SAXParserFactoryCreation() {
    this.getMethod().hasName("newInstance") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory")
  }
}

class SAXParserCreation extends MethodAccess {
  SAXParserCreation() {
    this.getMethod().hasName("newSAXParser") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory")
  }
}

class SafeFeatureSetting extends MethodAccess {
  SafeFeatureSetting() {
    this.getMethod().hasName("setFeature") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
    this.getArgument(0).(Literal).getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
    this.getArgument(1).(Literal).getValue() = "true"
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "SAXParserFactoryXXEVulnerability" }

  override predicate isSource(DataFlow::Node source) {
    exists(SAXParserFactoryCreation create|
      source.asExpr() = create
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SAXParserCreation create|
      sink.asExpr() = create
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SafeFeatureSetting safe|
      sanitizer.asExpr() = safe
    )
  }
}

