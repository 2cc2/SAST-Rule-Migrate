/**
 * @name No JSP Scriptlets
 * @kind problem
 * @problem.severity warning
 * @id java/no-jsp-scriptlets
 * @description JSP scriptlet detected. Scriptlets are difficult to use securely and are considered bad practice. 
 *              See https://stackoverflow.com/a/3180202. Instead, consider migrating to JSF or using the 
 *              Expression Language '${...}' with the escapeXml function in your JSP files.
 */

import java
import semmle.code.java.jsp.Jsp

from JspScriptlet scriptlet
select scriptlet, "JSP scriptlet detected. Scriptlets are difficult to use securely."

/**
 * Custom class to identify JSP scriptlets
 */
private class JspScriptlet extends JspElement {
  JspScriptlet() {
    this.getContent().regexpMatch("<%[^@].*")
  }

  string getContent() { result = this.getText() }
}
