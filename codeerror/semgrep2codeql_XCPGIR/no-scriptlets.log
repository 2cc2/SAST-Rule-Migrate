/**
 * @name JSP scriptlet detector
 * @description Detects JSP scriptlet usage which is considered bad practice
 * @kind problem
 * @problem.severity warning
 * @id no-scriptlets
 */

import java
import regex

predicate isJspScriptlet(StrLiteral literal) {
  exists(RegexMatch r | 
    r.getRegex().matches("<%[^@].*") and
    r.getResult(literal.getValue()) and
    literal.getFile().getRelativePath().matches("%.jsp")
  )
}

from StrLiteral literal
where isJspScriptlet(literal)
select literal, "JSP scriptlet detected. Scriptlets are difficult to use securely and are considered bad practice. Consider migrating to JSF or using Expression Language."
