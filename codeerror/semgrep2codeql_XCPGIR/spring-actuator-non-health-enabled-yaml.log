Rule Content:
/**
 * @name Spring Actuator Dangerous Endpoints Enabled
 * @description Detects when potentially dangerous Spring Boot Actuator endpoints are enabled
 * @kind problem
 * @problem.severity warning
 * @tags security
 *       spring
 *       external/cwe/cwe-749
 */

import java
import DataFlow::PathGraph

class DangerousActuatorEndpoint extends Literal {
  DangerousActuatorEndpoint() {
    this.getStringValue() != "health" and
    this.getStringValue() != "*"
  }
}

class EndpointExposureConfig extends FieldAccess {
  EndpointExposureConfig() {
    exists(Field f |
      f.getName() = "include" and
      this.getField() = f and
      this.getTarget().getType().hasQualifiedName("org.springframework.boot.actuate.autoconfigure.endpoint.web", 
        "ManagementEndpointWebProperties$Exposure")
    )
  }
}

predicate isDangerousActuatorEnabled(Literal source, FieldAccess sink) {
  exists(DataFlow::PathNode src, DataFlow::PathNode snk |
    DataFlow::localFlowPath(src, snk) and
    source.asExpr() = src.asExpr() and
    sink.getQualifier() = snk.asExpr()
  )
}

from DangerousActuatorEndpoint source, EndpointExposureConfig sink
where isDangerousActuatorEnabled(source, sink)
select sink, 
  "Spring Boot Actuator \"" + source.getStringValue() + "\" is enabled. " +
  "Depending on the actuator, this can pose a significant security risk. " +
  "Please double-check if the actuator is needed and properly secured."
