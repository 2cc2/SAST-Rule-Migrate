/**
 * @name Spring Actuator Dangerous Endpoints Enabled
 * @description Detects when potentially dangerous Spring Boot Actuator endpoints are enabled
 * @kind problem
 * @problem.severity warning
 * @tags security
 *       correctness
 *       spring
 *       external/cwe/cwe-749
 */

import java
import DataFlow::PathGraph

class DangerousActuatorLiteral extends Literal {
  DangerousActuatorLiteral() {
    this.getStringValue() != "health" and
    this.getStringValue() != "*"
  }
}

class EndpointExposure extends FieldAccess {
  EndpointExposure() {
    exists(Field f |
      f.getName() = "include" and
      this.getField() = f and
      this.getTarget().getType().hasQualifiedName(
        "org.springframework.boot.actuate.autoconfigure.endpoint.web",
        "ManagementEndpointWebProperties$Exposure"
      )
    )
  }
}

from DangerousActuatorLiteral source, DataFlow::PathNode sink
where DataFlow::localFlow(source, sink)
select sink.getNode(), 
  "Spring Boot Actuator \"" + source.getStringValue() + "\" is enabled. " +
  "Depending on the actuator, this can pose a significant security risk. " +
  "Please double-check if the actuator is needed and properly secured.",
