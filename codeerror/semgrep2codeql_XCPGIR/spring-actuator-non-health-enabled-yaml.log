Rule Content:
/**
 * @name Spring Actuator Dangerous Endpoints Enabled
 * @description Detects when potentially dangerous Spring Boot Actuator endpoints are enabled
 * @kind problem
 * @problem.severity warning
 * @tags security
 *       spring
 *       external/cwe/cwe-749
 */

import java
import semmle.code.yaml.Yaml
import semmle.code.yaml.ElementAccess

class DangerousActuatorEndpoint extends YamlLiteral {
  DangerousActuatorEndpoint() {
    this.getStringValue() != "health" and
    this.getStringValue() != "*"
  }
}

class EndpointExposureConfig extends YamlMappingAccess {
  EndpointExposureConfig() {
    this.getKey().getStringValue() = "include" and
    this.getAncestorOfType(YamlMapping).getStringValue("management.endpoints.web.exposure.include")
  }
}

predicate isDangerousActuatorEnabled(DangerousActuatorEndpoint source, EndpointExposureConfig sink) {
  exists(YamlDocument doc |
    doc.getDescendant(source) and
    doc.getDescendant(sink)
  )
}

from DangerousActuatorEndpoint source, EndpointExposureConfig sink
where isDangerousActuatorEnabled(source, sink)
select sink,
  "Spring Boot Actuator \"" + source.getStringValue() + "\" is enabled. " +
  "Depending on the actuator, this can pose a significant security risk. " +
  "Please double-check if the actuator is needed and properly secured."
