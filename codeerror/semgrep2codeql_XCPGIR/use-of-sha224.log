/**
 * @name Use of SHA-224
 * @description Detects usage of 224-bit hash functions which may be deprecated or disallowed.
 * @kind problem
 * @id java/weak-hash-sha224
 * @severity Warning
 * @tags security
 *       correctness
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isSHA224HashMethod(Method m) {
  exists(MethodAccess ma |
    ma.getMethod().hasName(["getSha3_224Digest", "getSha512_224Digest", "sha3_224", "sha3_224Hex", "sha512_224", "sha512_224Hex"]) and
    ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.codec.digest", "DigestUtils")
  )
}

predicate isMessageDigestSHA224(MethodAccess ma) {
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
  exists(Literal l | ma.getArgument(0) = l and l.getStringValue().regexpMatch(".*224"))
}

from MethodAccess ma
where 
  isSHA224HashMethod(ma.getMethod()) or
  isMessageDigestSHA224(ma)
select ma, "Weak 224-bit hash function usage detected. Consider updating to a stronger hash function such as SHA-384 or higher to ensure compliance and security."
