Rule Content:
/**
 * @name LDAP Entry Poisoning
 * @description Detects unsafe LDAP searches that allow object return,
 *              which could enable LDAP response manipulation leading to remote code execution.
 * @kind problem
 * @id java/ldap-entry-poisoning
 * @problem.severity warning
 * @security-severity 7.5
 * @tags security
 * @precision high
 */

import java

predicate unsafeLdapSearch(ConstructorCall call) {
  exists(MethodAccess ma, Method m | 
    call.getConstructedType().hasQualifiedName("javax.naming.directory", "SearchControls") and
    ma.getMethod() = m and
    m.getName() = "setReturningObjFlag" and
    ma.getArgument(0).(BooleanLiteral).getValue() = true
  )
  or
  exists(Expr arg4 | 
    call.getConstructedType().hasQualifiedName("javax.naming.directory", "SearchControls") and
    arg4 = call.getArgument(4) and
    arg4.(BooleanLiteral).getValue() = true
  )
}

from ConstructorCall call
where unsafeLdapSearch(call)
select call, "Object-returning LDAP search detected. This could allow LDAP response manipulation leading to remote code execution."
