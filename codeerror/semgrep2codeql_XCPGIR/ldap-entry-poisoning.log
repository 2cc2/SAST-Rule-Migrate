Rule Content:
/**
 * @name LDAP Entry Poisoning
 * @description An object-returning LDAP search will allow attackers to control the LDAP response. This could lead to Remote Code Execution.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ldap-entry-poisoning
 */

import java
import semmle.code.java.dataflow.DataFlow

class LdapSearchControlsConstructor extends Method {
  LdapSearchControlsConstructor() {
    this.getDeclaringType().hasQualifiedName("javax.naming.directory", "SearchControls") and
    this.getName() = "<init>" and
    this.getNumberOfParameters() >= 4 and
    this.getParameter(3).getType() instanceof BooleanType and
    // Check if 4th argument is true
    exists(MethodAccess ma | 
      ma.getMethod() = this and
      ma.getArgument(3).(Literal).getValue().toInt() = 1
    )
  }
}

class LdapSetReturningObjFlag extends Method {
  LdapSetReturningObjFlag() {
    this.getDeclaringType().hasQualifiedName("javax.naming.directory", "SearchControls") and
    this.getName() = "setReturningObjFlag" and
    this.getNumberOfParameters() = 1 and
    // Check if argument is true
    exists(MethodAccess ma | 
      ma.getMethod() = this and
      ma.getArgument(0).(Literal).getValue().toInt() = 1
    )
  }
}

class Config extends DataFlow::Configuration {
  Config() { this = "LDAPEntryPoisoningConfig" }

  override predicate isSink(DataFlow::Node sink) {
    exists(LdapSearchControlsConstructor lsc | sink.asExpr() = lsc.getAnAccess())
    or
    exists(LdapSetReturningObjFlag lro | sink.asExpr() = lro.getAnAccess())
  }
}

from Config cfg, DataFlow::Node sink
where cfg.hasFlowTo(sink)
select sink, "An object-returning LDAP search will allow attackers to control the LDAP response. This could lead to Remote Code Execution."
