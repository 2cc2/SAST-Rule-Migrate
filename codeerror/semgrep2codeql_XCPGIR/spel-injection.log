Rule Content:
/**
 * @name SpEL Injection
 * @description Detects Spring Expression Language (SpEL) injection vulnerabilities
 * @id java/spel-injection
 * @kind path-problem
 * @security-severity 8.0
 * @tags security
 *       external/cwe/cwe-094
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.Spring

class SpelParserCall extends MethodAccess {
  SpelParserCall() {
    this.getMethod().hasName("parseExpression") and
    this.getMethod().getDeclaringType().hasQualifiedName("org.springframework.expression", "ExpressionParser")
  }
}

class NonLiteralSource extends FlowSource::Range {
  NonLiteralSource() {
    exists(SpelParserCall call | call.getArgument(0) = this.getExitNode())
    and not this.getNode().(StringLiteral).hasLocationInfo()
  }
}

class SpelInjectionConfig extends TaintTracking::Configuration {
  SpelInjectionConfig() { this = "SpelInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(NonLiteralSource nls | source = nls.getAQlNode())
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SpelParserCall call | sink.asExpr() = call)
  }

  override predicate isAdditionalTaintStep(DataFlow::Node from, DataFlow::Node to) {
    exists(MethodInvocation mi |
      mi.getMethod() instanceof ParameterMethod and
      from.asExpr() = mi.getAnArgument() and
      to.asExpr() = mi.getQualifier()
    )
  }
}

from SpelInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential Spring Expression Language (SpEL) injection vulnerability detected"
