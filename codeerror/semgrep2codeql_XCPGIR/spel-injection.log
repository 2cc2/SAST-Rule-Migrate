/**
 * @name SpEL Injection
 * @kind problem
 * @id java/spel-injection
 * @security-severity 8.0
 * @warning
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.Spring

class SpelInjectionConfig extends TaintTracking::Configuration {
  SpelInjectionConfig() { this = "SpelInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess parseCall |
      parseCall.getMethod().hasName("parseExpression") and
      parseCall.getMethod().getDeclaringType().hasQualifiedName("org.springframework.expression", "ExpressionParser") and
      parseCall.getArgument(0) = source.asExpr() and
      not parseCall.getArgument(0).(StringLiteral).getValue().regexpMatch("\\.\\.\\.")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess parseCall |
      parseCall.getMethod().hasName("parseExpression") and
      parseCall.getMethod().getDeclaringType().hasQualifiedName("org.springframework.expression", "ExpressionParser") and
      sink.asExpr() = parseCall
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      ma.getMethod() instanceof ParameterMethod and
      node1.asExpr() = ma.getAnArgument() and
      node2.asExpr() = ma.getQualifier()
    )
  }
}

from SpelInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential Spring Expression Language (SpEL) injection vulnerability detected"
