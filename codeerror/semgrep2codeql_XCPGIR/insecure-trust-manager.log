Rule Content:
/**
 * @name Insecure Trust Manager
 * @id insecure-trust-manager
 * @description Detected empty trust manager implementations. This is dangerous because it accepts
 *              any certificate, enabling man-in-the-middle attacks. Consider using a KeyStore
 *              and TrustManagerFactory instead.
 * @kind path-problem
 * @severity warning
 * @tags security
 *       external/cwe/cwe-295
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class EmptyTrustManagerMethod extends Method {
  EmptyTrustManagerMethod() {
    this.getDeclaringType().getASupertype*().hasQualifiedName("javax.net.ssl", "X509TrustManager") or
    this.getDeclaringType().getASupertype*().hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager") and
    (
      (this.getName() = "checkClientTrusted" or this.getName() = "checkServerTrusted") and
      this.getBody().getNumStmt() = 0
    ) or
    (
      this.getName() = "getAcceptedIssuers" and
      exists(ReturnStmt ret | ret.getExpr() instanceof NullLiteral)
    )
  }
}

class TrustManagerCreation extends Expr {
  TrustManagerCreation() {
    exists(ClassInstanceExpr cie |
      cie.getType().getASupertype*().hasQualifiedName("javax.net.ssl", "X509TrustManager") or
      cie.getType().getASupertype*().hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager")
    )
  }
}

class EmptyTrustManagerFlow extends TaintTracking::Configuration {
  EmptyTrustManagerFlow() { this = "EmptyTrustManagerFlow" }

  override predicate isSource(DataFlow::Node source) {
    exists(EmptyTrustManagerMethod method |
      source.asExpr() = method.getBody()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(TrustManagerCreation creation |
      sink.asExpr() = creation
    )
  }
}

from EmptyTrustManagerFlow flow, DataFlow::Node source, DataFlow::Node sink
where flow.hasFlow(source, sink)
select sink, "Detected empty trust manager implementations. This accepts any certificate, " +
             "enabling man-in-the-middle attacks."
