Rule Content:
/**
 * @name Insecure Trust Manager
 * @description Detected empty trust manager implementations accepting any certificate.
 * @kind problem
 * @problem.severity warning
 * @security-severity 7.5
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 */

import java

predicate isEmptyBody(Method m) {
    // Check for empty method body
    exists(MethodAccess ma | ma.getMethod() = m and ma.getBody().getNumberOfStmts() = 0)
}

predicate isZeroLengthReturn(Method m) {
    // Check for zero-length return
    (m.getReturnType() instanceof ArrayType) and
    exists(ReturnStmt rs | 
        rs.getExpr() instanceof ArrayCreation and
        rs.getExpr().getSize() = 0 and
        rs.getEnclosingCallable() = m
    )
}

from 
    Type trustManagerType, 
    Method emptyTrustMethod
where
    // Check if type implements X509TrustManager or X509ExtendedTrustManager
    (trustManagerType.getASupertype() instanceof RefType and
     (trustManagerType.getASupertype().hasQualifiedName("javax.net.ssl", "X509TrustManager") or
      trustManagerType.getASupertype().hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager")))
    and
    // Match methods that override trust manager methods
    ((emptyTrustMethod.hasName("checkClientTrusted") and 
      emptyTrustMethod.getNumberOfParameters() = 2 and
      emptyTrustMethod.getParameter(0).getType().hasQualifiedName("java.security.cert", "X509Certificate[]") and
      emptyTrustMethod.getParameter(1).getType().hasName("String"))
     or
     (emptyTrustMethod.hasName("checkServerTrusted") and 
      emptyTrustMethod.getNumberOfParameters() = 2 and
      emptyTrustMethod.getParameter(0).getType().hasQualifiedName("java.security.cert", "X509Certificate[]") and
      emptyTrustMethod.getParameter(1).getType().hasName("String"))
     or
     (emptyTrustMethod.hasName("getAcceptedIssuers") and
      emptyTrustMethod.getReturnType() instanceof ArrayType and
      emptyTrustMethod.getReturnType().getElementType().hasQualifiedName("java.security.cert", "X509Certificate")))
    and
    // Check for empty implementation patterns
    (isEmptyBody(emptyTrustMethod) or isZeroLengthReturn(emptyTrustMethod))
    and
    emptyTrustMethod.getDeclaringType() = trustManagerType
select emptyTrustMethod, "Detected empty trust manager implementations. This is dangerous because it accepts any certificate, enabling man-in-the-middle attacks. Consider using a KeyStore and TrustManagerFactory instead."
