Rule Content:
/**
 * @name Insecure Trust Manager
 * @description Detected empty trust manager implementations accepting any certificate.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 */

import java

predicate isEmptyBody(Method m) {
    // Check method has exactly 1 statement which is empty block
    exists(BlockStmt bs | 
        m.getBody() = bs and 
        not exists(bs.getAChildStmt())
    )
}

predicate isZeroLengthReturn(Method m) {
    exists(ArrayCreation ac | 
        m.getReturnType() instanceof ArrayType and
        exists(ReturnStmt rs |
            rs.getExpr() = ac and ac.getSize() = 0
        )
    )
}

from 
    Class trustManagerClass,
    Method vulnerableMethod
where
    (trustManagerClass.getASupertype().hasQualifiedName("javax.net.ssl", "X509TrustManager") or
     trustManagerClass.getASupertype().hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager")) and
    vulnerableMethod.getDeclaringType() = trustManagerClass and
    (
        // Match checkClientTrusted method
        (vulnerableMethod.getName() = "checkClientTrusted" and
         vulnerableMethod.getNumberOfParameters() = 2 and
         vulnerableMethod.getParameter(0).getType().hasQualifiedName("java.security.cert", "X509Certificate[]") and
         vulnerableMethod.getParameter(1).getType() instanceof TypeString)
        or
        // Match checkServerTrusted method
        (vulnerableMethod.getName() = "checkServerTrusted" and
         vulnerableMethod.getNumberOfParameters() = 2 and
         vulnerableMethod.getParameter(0).getType().hasQualifiedName("java.security.cert", "X509Certificate[]") and
         vulnerableMethod.getParameter(1).getType() instanceof TypeString)
        or
        // Match getAcceptedIssuers method
        (vulnerableMethod.getName() = "getAcceptedIssuers" and
         vulnerableMethod.getReturnType() instanceof ArrayType and
         vulnerableMethod.getReturnType().getElementType().hasQualifiedName("java.security.cert", "X509Certificate"))
    ) and
    (isEmptyBody(vulnerableMethod) or isZeroLengthReturn(vulnerableMethod))
select vulnerableMethod, "Detected empty trust manager implementations. This is dangerous because it accepts any certificate, enabling man-in-the-middle attacks. Consider using a KeyStore and TrustManagerFactory instead."
