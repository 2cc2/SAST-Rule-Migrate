Rule Content:
/**
 * @name Insecure Trust Manager
 * @id insecure-trust-manager
 * @description Detected empty trust manager implementations. This is dangerous because it accepts
 *              any certificate, enabling man-in-the-middle attacks. Consider using a KeyStore
 *              and TrustManagerFactory instead.
 * @kind problem
 * @severity warning
 * @tags security
 *       external/cwe/cwe-295
 */

import java

from Method method
where 
  (method.getDeclaringType() instanceof X509TrustManager or
   method.getDeclaringType() instanceof X509ExtendedTrustManager) and
  ((method.getName() = "checkClientTrusted" or method.getName() = "checkServerTrusted") and
   method.getBody().getNumStmt() = 0) or
  (method.getName() = "getAcceptedIssuers" and
   exists(ReturnStmt ret | ret.getExpr().(NullLiteral).mayExist()))
select method, "Empty trust manager implementation. This is dangerous as it will accept any certificate."

from ClassInstanceExpression cie, ClassInstanceExprType cit
where 
  (cit.getSourceDeclaration() instanceof X509TrustManager or
   cit.getSourceDeclaration() instanceof X509ExtendedTrustManager) and
  not exists(method | 
    method.getDeclaringType() = cit.getSourceDeclaration() and
    (method.getName() = "checkClientTrusted" or method.getName() = "checkServerTrusted") and
    method.getBody().getNumStmt() > 0 and
    method.getThrownExceptionType() instanceof CertificateException)
select cie, "Creation of insecure TrustManager instance."

from TypeDeclaration td
where 
  (td.getASupertype() instanceof X509TrustManager or
   td.getASupertype() instanceof X509ExtendedTrustManager) and
  not exists(Method method |
    method.getDeclaringType() = td and
    (method.getName() = "checkClientTrusted" or method.getName() = "checkServerTrusted") and
    method.getBody().getNumStmt() > 0 and
    method.getThrownExceptionType() instanceof CertificateException)
select td, "Type implements insecure TrustManager interface."
