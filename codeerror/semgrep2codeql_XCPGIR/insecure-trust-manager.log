Rule Content:
/**
 * @name Insecure Trust Manager
 * @description Detected empty trust manager implementations accepting any certificate.
 * @kind problem
 * @problem.severity warning
 * @security-severity 7.5
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 */

import java

predicate isEmptyBody(Method m) {
    exists(Stmt dummy | dummy instanceof EmptyStmt |
        m.getBody().getADeclarationEntry() = dummy and
        m.getBody().getALastStmt() = dummy
    )
    or
    m.getBody().isEmpty()
}

predicate isZeroLengthReturn(Method m) {
    m.getReturnType() instanceof ArrayType and
    (
        exists(ReturnStmt rs |
            rs.getExpr() instanceof ArrayInit and
            rs.getExpr().getSize() = 0
        )
        or
        exists(ReturnStmt rs |
            rs.getExpr() instanceof NewExpr and
            rs.getExpr().getSize() = 0
        )
    )
}

from 
    Class trustManagerClass,
    Method insecureMethod
where
    (
        trustManagerClass.getASupertype*().hasQualifiedName("javax.net.ssl", "X509TrustManager") or
        trustManagerClass.getASupertype*().hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager")
    )
    and
    insecureMethod.getDeclaringType() = trustManagerClass
    and
    (
        (
            insecureMethod.hasName("checkClientTrusted") and
            insecureMethod.getNumberOfParameters() = 2 and
            insecureMethod.getParameter(0).getType().hasQualifiedName("java.security.cert", "X509Certificate[]") and
            insecureMethod.getParameter(1).getType() instanceof TypeString
        )
        or
        (
            insecureMethod.hasName("checkServerTrusted") and
            insecureMethod.getNumberOfParameters() = 2 and
            insecureMethod.getParameter(0).getType().hasQualifiedName("java.security.cert", "X509Certificate[]") and
            insecureMethod.getParameter(1).getType() instanceof TypeString
        )
        or
        (
            insecureMethod.hasName("getAcceptedIssuers") and
            insecureMethod.getReturnType() instanceof ArrayType and
            insecureMethod.getReturnType().getElementType().hasQualifiedName("java.security.cert", "X509Certificate")
        )
    )
    and
    (isEmptyBody(insecureMethod) or isZeroLengthReturn(insecureMethod))
select insecureMethod, "Detected empty trust manager implementations. This is dangerous because it accepts any certificate, enabling man-in-the-middle attacks. Consider using a KeyStore and TrustManagerFactory instead."
