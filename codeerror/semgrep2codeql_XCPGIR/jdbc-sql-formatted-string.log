/**
 * @name JDBC SQL Formatted String Injection
 * @description Detects possible JDBC injection where string concatenation or formatting is used
 *              instead of parameterized queries in Spring JDBC operations.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Spring.SpringJdbc

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Method m |
      (m.getName().matches("getParameter%") or
       m.getName().matches("getAttribute%") or
       m.getName().matches("getHeader%")) and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getQualifier()
    )
  }
}

class DangerousJdbcSink extends DataFlow::Node {
  DangerousJdbcSink() {
    exists(Method m |
      (m.getName().matches("queryForObject") or
       m.getName().matches("queryForList") or
       m.getName().matches("update") or
       m.getName().matches("execute") or
       m.getName().matches("insert")) and
      m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0) and
      (
        exists(AddExpr a | a = this.asExpr()) or
        exists(MethodInvocation mi | mi = this.asExpr() | mi.getMethod().getName() = "format")
      )
    )
  }
}

class ParameterizedQuerySink extends DataFlow::Node {
  ParameterizedQuerySink() {
    exists(Method m |
      (m.getName().matches("queryForObject") or
       m.getName().matches("queryForList")) and
      m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      exists(MethodAccess ma |
        ma.getMethod() = m and
        ma.getArgument(0).toString().matches("%?%")
      )
    )
  }
}

class JdbcStringConcatFlowConfiguration extends TaintTracking::Configuration {
  JdbcStringConcatFlowConfiguration() { this = "JdbcStringConcatFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof DangerousJdbcSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(ParameterizedQuerySink pq | DataFlow::localFlow(_, sanitizer, pq))
  }
}

