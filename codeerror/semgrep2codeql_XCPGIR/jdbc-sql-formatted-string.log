where cfg.hasFlowPath(source, sink)
select sink, 
  "Possible JDBC injection detected. Use the parameterized query feature available in queryForObject " +
  "instead of concatenating or formatting strings.", source, sink,
  "User input reaches JDBC execution without parameterized query"
