/**
 * @name JDBC SQL Formatted String Injection
 * @description Detects possible JDBC injection where string concatenation or formatting is used
 *              instead of parameterized queries in Spring JDBC operations.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringJdbc

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("%getParameter%") or
       ma.getMethod().getName().matches("%getAttribute%") or
       ma.getMethod().getName().matches("%getHeader%")) and
      ma = this.asExpr()
    )
  }
}

class DangerousJdbcSink extends DataFlow::Node {
  DangerousJdbcSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("queryForObject") or
       ma.getMethod().getName().matches("queryForList") or
       ma.getMethod().getName().matches("update") or
       ma.getMethod().getName().matches("execute") or
       ma.getMethod().getName().matches("insert")) and
      ma.getMethod().getDeclaringType().toString().matches("org.springframework.jdbc.core.JdbcTemplate") and
      ma.getArgument(0) = this.asExpr() and
      (
        exists(BinaryOperation bo | bo = this.asExpr() | bo.getOperator().toString() = "+") or
        exists(MethodCall mc | mc = this.asExpr() | mc.getMethod().getName() = "format")
      )
    )
  }
}

class ParameterizedQuerySink extends DataFlow::Node {
  ParameterizedQuerySink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("queryForObject") or
       ma.getMethod().getName().matches("queryForList")) and
      ma.getMethod().getDeclaringType().toString().matches("org.springframework.jdbc.core.JdbcTemplate") and
      ma.getArgument(0).toString().matches("%?%")
    )
  }
}

class JdbcStringConcatFlowConfiguration extends TaintTracking::Configuration {
  JdbcStringConcatFlowConfiguration() { this = "JdbcStringConcatFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource } 

  override predicate isSink(DataFlow::Node sink) { sink instanceof DangerousJdbcSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(ParameterizedQuerySink pq | pq.asExpr() = sanitizer.asExpr())
  }
}

