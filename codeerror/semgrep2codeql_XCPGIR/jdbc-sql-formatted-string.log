Rule Content:
/**
 * @name JDBC SQL Formatted String Injection 
 * @description Detects potential JDBC injection vulnerabilities when
 *              constructing SQL queries using string concatenation or formatting
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.Jdbc
import DataFlow::PathGraph

predicate isStringConcatSource(DataFlow::Node source) {
  exists(MethodAccess ma |
    (ma.getMethod().getName() = "concat" and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) or
    (ma.getMethod().getName() = "format" and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) or
    (ma.getMethod().getName() = "append" and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder")) |
    source.asExpr() = ma
  )
}

predicate isStringAssignmentSource(DataFlow::Node source) {
  exists(AssignmentExpr ae |
    ae.getRight() instanceof MethodAccess and
    (
      (ae.getRight().(MethodAccess).getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") or
      ae.getRight().(MethodAccess).getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder"))
    ) |
    source.asExpr() = ae.getRight()
  )
}

predicate isJdbcSink(DataFlow::Node sink) {
  exists(MethodAccess ma | 
    ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
    (ma.getMethod().getName().matches("%queryForObject%") or
     ma.getMethod().getName().matches("%queryForList%") or
     ma.getMethod().getName().matches("%update%") or  
     ma.getMethod().getName().matches("%execute%") or
     ma.getMethod().getName().matches("%insert%")) and
    sink.asExpr() = ma.getArgument(0)
  )
}

predicate isSafeJdbcCall(DataFlow::Node node) {
  exists(MethodAccess ma |
    ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
    (ma.getMethod().getName().matches("%queryForObject%") or
     ma.getMethod().getName().matches("%queryForList%") or
     ma.getMethod().getName().matches("%update%") or
     ma.getMethod().getName().matches("%execute%") or
     ma.getMethod().getName().matches("%insert%")) and
    ma.getArgument(0).toString().matches("%\\?%") 
  )
}

class JdbcTaintConfig extends TaintTracking::Configuration {
  JdbcTaintConfig() { this = "JdbcTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    isStringConcatSource(source) or
    isStringAssignmentSource(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    isJdbcSink(sink)
  }

  override predicate isSanitizer(DataFlow::Node node) {
    isSafeJdbcCall(node)
  }
}

