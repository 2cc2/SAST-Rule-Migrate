```yaml
xcpgir_version: "1.0"
rule:
  id: jdbc-sql-formatted-string
  kind: taint
  severity: WARNING
  message: "Possible JDBC injection detected. Use the parameterized query feature available in queryForObject instead of concatenating or formatting strings."
scope:
  languages: [java]
  frameworks: ["jdbc"]
  env: { os: ["*"], shell: ["*"] }

sources:
  - id: JDBC_STRING_CONCAT
    match:
      node: CALL
      where:
        - op: regex
          left: methodFullName
          right: "String.concat|String.format|StringBuilder.append"
  - id: JDBC_STRING_ASSIGN
    match:
      node: ASSIGNMENT
      where:
        - op: regex
          left: value
          right: "String\\..*|StringBuilder\\..*"

sinks:
  - id: JDBC_QUERY
    match:
      node: CALL
      api:
        type: org.springframework.jdbc.core.JdbcTemplate
        method: queryForObject|queryForList|update|execute|insert
      arg_index: 0

propagations:
  - id: STRING_FLOW
    edge: arg->param|return|field-store|field-load
    kind: taint

sanitizers:
  - id: PARAMETERIZED_QUERY
    match:
      node: CALL
      api:
        type: org.springframework.jdbc.core.JdbcTemplate
        method: queryForObject|queryForList|update|execute|insert
    where:
      - op: regex
        left: arg[0].value
        right: "\\?.*"
    effect: neutralize

flows:
  - source: JDBC_STRING_CONCAT
    sink: JDBC_QUERY
    through: [STRING_FLOW*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(org.springframework.jdbc.core.JdbcTemplate.query* with ? param)" } ]

report:
  message: "Possible JDBC injection detected in ${sink.methodFullName}"
  locations: ["sink"]
  evidence:
    capture:
      - argument: 0
```
