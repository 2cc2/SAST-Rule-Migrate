/**
 * @name JDBC SQL Formatted String Injection
 * @description Detects potential JDBC injection vulnerabilities when
 *              constructing SQL queries using string concatenation or formatting
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.JDBC
import DataFlow::PathGraph

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.lang.String", "concat") 
      or
      ma.getMethod().hasQualifiedName("java.lang.String", "format")
      or
      ma.getMethod().hasQualifiedName("java.lang.StringBuilder", "append")
      and
      this.asExpr() = ma
    )
  }
}

class StringAssignmentSource extends DataFlow::Node {
  StringAssignmentSource() {
    exists(AssignExpr ae |
      (ae.getRight().(MethodAccess).getMethod().getDeclaringType() instanceof StringType
       or
       ae.getRight().(MethodAccess).getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder"))
      and
      this.asExpr() = ae.getRight()
    )
  }
}

class JdbcSink extends DataFlow::Node {
  JdbcSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      (ma.getMethod().getName().matches("%queryForObject%") or
       ma.getMethod().getName().matches("%queryForList%") or
       ma.getMethod().getName().matches("%update%") or
       ma.getMethod().getName().matches("%execute%") or
       ma.getMethod().getName().matches("%insert%")) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SafeJdbcCall extends DataFlow::Node {
  SafeJdbcCall() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      (ma.getMethod().getName().matches("%queryForObject%") or
       ma.getMethod().getName().matches("%queryForList%") or
       ma.getMethod().getName().matches("%update%") or
       ma.getMethod().getName().matches("%execute%") or
       ma.getMethod().getName().matches("%insert%")) and
      exists(ma.getArgument(0).toString() |
        _.matches("%\\?%")
      )
    )
  )
}

class JdbcTaintConfig extends TaintTracking::Configuration {
  JdbcTaintConfig() { this = "JdbcTaintConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof StringConcatSource or
    source instanceof StringAssignmentSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JdbcSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeJdbcCall
  }
}

from JdbcTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Possible JDBC injection detected in " + sink.getNode().(MethodAccess).getMethod().getName() + 
  ". Use the parameterized query feature instead of concatenating or formatting strings.",
  source, sink,
  "Source of string concatenation/formating", "SQL query method call"
