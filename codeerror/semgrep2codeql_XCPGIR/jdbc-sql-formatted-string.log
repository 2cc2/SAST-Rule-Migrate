/**
 * @name JDBC SQL Formatted String Injection
 * @description Detects potential JDBC injection vulnerabilities when
 *              constructing SQL queries using string concatenation or formatting
 * @kind path-problem
 * @problem.severity warning  
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringDatabase

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(Method m | 
      (m.hasName("concat") and m.getDeclaringType().hasQualifiedName("java.lang", "String")) or
      (m.hasName("format") and m.getDeclaringType().hasQualifiedName("java.lang", "String")) or
      (m.hasName("append") and m.getDeclaringType().hasQualifiedName("java.lang", "StringBuilder")) |
      this.asExpr() = m.getACall()
    )
  }
}

class StringAssignmentSource extends DataFlow::Node {
  StringAssignmentSource() {
    exists(AssignExpr ae, MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") or
       ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder")) and
      ae.getRValue() = ma and
      this.asExpr() = ae.getRValue()
    )
  }
}

class JdbcSink extends DataFlow::Node {
  JdbcSink() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      (m.hasName("queryForObject") or
       m.hasName("queryForList") or
       m.hasName("update") or
       m.hasName("execute") or
       m.hasName("insert")) and
      this.asExpr() = m.getACall().getArgument(0)
    )
  }
}

class SafeJdbcCall extends DataFlow::Node {
  SafeJdbcCall() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      (m.hasName("queryForObject") or
       m.hasName("queryForList") or
       m.hasName("update") or
       m.hasName("execute") or
       m.hasName("insert")) and
      exists(m.getACall().getArgument(0).toString() | it.matches("%\\?%"))
    )
  }
}

class JdbcTaintConfig extends TaintTracking::Configuration {
  JdbcTaintConfig() { this = "JdbcTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringConcatSource or
    source instanceof StringAssignmentSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JdbcSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeJdbcCall
  }
}

