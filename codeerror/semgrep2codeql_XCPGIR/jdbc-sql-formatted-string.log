Rule Content:
/**
 * @name JDBC SQL Formatted String Injection
 * @description Detects possible JDBC injection where string concatenation or formatting is used
 *              instead of parameterized queries in Spring JDBC operations.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Spring

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Method m |
      (m.getName().matches("getParameter%") or
       m.getName().matches("getAttribute%") or
       m.getName().matches("getHeader%")) and
      this.asExpr() = any(Expr e | e.(MethodAccess).getMethod() = m).getQualifier()
    )
  }
}

class DangerousJdbcSink extends DataFlow::Node {
  DangerousJdbcSink() {
    exists(Method m |
      (m.getName().matches("queryForObject%") or
       m.getName().matches("queryForList%") or
       m.getName().matches("update%") or
       m.getName().matches("execute%") or
       m.getName().matches("insert%")) and
      m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      this.asExpr() = any(Expr e | e.(MethodAccess).getMethod() = m).getArgument(0) and
      (
        // Check for string concatenation
        exists(AddExpr add | add = this.asExpr()) or
        // Check for String.format() calls
        exists(MethodCall mc | mc = this.asExpr() | mc.getCallee().getName() = "format")
      )
    )
  }
}

class ParameterizedQuerySanitizer extends TaintTracking::Sanitizer {
  ParameterizedQuerySanitizer() {
    exists(Method m |
      (m.getName().matches("queryForObject%") or
       m.getName().matches("queryForList%")) and
      m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      exists(Expr e |
        e.(MethodAccess).getMethod() = m and
        e.getArgument(0).toString().matches("%?%")
      )
    )
  }
}

class JdbcStringConcatFlow extends TaintTracking::Configuration {
  JdbcStringConcatFlow() { this = "JdbcStringConcatFlow" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof DangerousJdbcSink }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }
}

