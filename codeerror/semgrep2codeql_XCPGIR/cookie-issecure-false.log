Rule Content:
/**
 * @name Insecure Cookie Configuration
 * @description Default session middleware settings: `setSecure` not set to true. This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks.
 * @kind problem
 * @id java/cookie-issecure-false
 * @security-severity 7.5
 * @tags security
 *       external/cwe/cwe-614
 */

import java

// Find all Cookie constructor calls
predicate isCookieConstructor(MethodAccess ma) {
  ma.getMethod().hasName("<init>") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
}

// Find insecure setSecure(false) calls
predicate isInsecureSetSecureCall(MethodAccess ma) {
  ma.getMethod().hasName("setSecure") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
  exists(ma.getAnArgument() | 
    ma.getAnArgument().(Literal).getValue().toInt() = 0
  )
}

// Find secure setSecure(true) calls
predicate isSecureSetSecureCall(MethodAccess ma) {
  ma.getMethod().hasName("setSecure") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
  exists(ma.getAnArgument() | 
    ma.getAnArgument().(Literal).getValue().toInt() = 1
  )
}

from MethodAccess cookieConstructor, MethodAccess insecureSetSecure
where
  isCookieConstructor(cookieConstructor) and
  isInsecureSetSecureCall(insecureSetSecure) and
  insecureSetSecure.getQualifier() = cookieConstructor and
  not exists(MethodAccess secureSetSecure |
    isSecureSetSecureCall(secureSetSecure) and
    secureSetSecure.getQualifier() = cookieConstructor and
    secureSetSecure.getEnclosingStmt().getEnclosingCallable() = 
      insecureSetSecure.getEnclosingStmt().getEnclosingCallable()
  )
select insecureSetSecure, 
  "Default session middleware settings: `setSecure` not set to true. " +
  "This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks."
