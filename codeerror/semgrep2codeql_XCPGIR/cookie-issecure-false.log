Rule Content:
/**
 * @name Cookie created without setting secure flag to true
 * @description Default session middleware settings: `setSecure` not set to true. This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks.
 * @kind problem
 * @id java/cookie-issecure-false
 * @severity warning
 */

import java

// Define source: Cookie creation
predicate isCookieCreation(MethodAccess ma) {
  ma.getMethod().getName() = "<init>" and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
}

// Define insecure sink: setSecure(false)
predicate isInsecureSetSecure(MethodAccess ma) {
  ma.getMethod().getName() = "setSecure" and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
  ma.getArgument(0).(BooleanLiteral).getValue() = false
}

// Define secure sanitizer: setSecure(true)
predicate isSecureSetSecure(MethodAccess ma) {
  ma.getMethod().getName() = "setSecure" and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
  ma.getArgument(0).(BooleanLiteral).getValue() = true
}

from MethodAccess cookieCreation, MethodAccess insecureSetSecure, DataFlow::PathNode source, DataFlow::PathNode sink
where
  // Source is Cookie creation
  isCookieCreation(cookieCreation) and
  source.asExpr() = cookieCreation and
  
  // Sink is insecure setSecure call
  isInsecureSetSecure(insecureSetSecure) and
  sink.asExpr() = insecureSetSecure and
  
  // Data flow exists from source to sink
  DataFlow::localFlow(source, sink) and
  
  // There's no secure set along the path
  not exists(MethodAccess secureSet |
    isSecureSetSecure(secureSet) and
    DataFlow::localFlow(source, DataFlow::exprNode(secureSet)) and
    DataFlow::localFlow(DataFlow::exprNode(secureSet), sink)
  )
select insecureSetSecure, "Cookie created without setting secure flag to true"
