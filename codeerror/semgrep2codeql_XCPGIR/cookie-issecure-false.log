Rule Content:
/**
 * @name Cookie created without setting secure flag to true
 * @description Default session middleware settings: `setSecure` not set to true. This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks.
 * @kind problem
 * @id java/cookie-issecure-false
 * @severity warning
 */

import java
import semmle.code.java.dataflow.DataFlow

predicate isCookieCreation(Expr e) {
  exists(Method m |
    m.getName() = "<init>" and
    m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    e.(ConstructorCall).getConstructedType() = m.getDeclaringType()
  )
}

predicate isInsecureSetSecure(Expr e) {
  exists(MethodAccess ma |
    ma.getMethod().getName() = "setSecure" and
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    ma.getArgument(0).(BooleanLiteral).getValue() = false and
    e = ma
  )
}

predicate isSecureSetSecure(Expr e) {
  exists(MethodAccess ma |
    ma.getMethod().getName() = "setSecure" and
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    ma.getArgument(0).(BooleanLiteral).getValue() = true and
    e = ma
  )
}

from DataFlow::Node source, DataFlow::Node sink
where
  isCookieCreation(source.asExpr()) and
  isInsecureSetSecure(sink.asExpr()) and
  DataFlow::localFlow(source, sink) and
  not exists(IntermediateExpr e |
    DataFlow::localFlow(source, e) and
    DataFlow::localFlow(e, sink) and
    isSecureSetSecure(e.asExpr())
  )
select sink, "Cookie created without setting secure flag to true"
