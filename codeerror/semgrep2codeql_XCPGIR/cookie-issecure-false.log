/**
 * @name Cookie created without secure flag enabled
 * @description Default session middleware settings: `setSecure` not set to true. This ensures 
 * that the cookie is sent only over HTTPS to prevent cross-site scripting attacks.
 * @kind problem
 * @id java/cookie-issecure-false
 * @severity warning
 * @security-severity 7.4
 * @tags security
 *       external/cwe/cwe-614
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

predicate isCookieConstructorCall(Expr e) {
  exists(Method m | 
    e instanceof Call and
    e.(Call).getCallee() = m and
    m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    m.hasName("<init>")
  )
}

predicate isInsecureSetSecureCall(Expr e) {
  exists(Method m, Literal falseArg |
    e instanceof Call and
    e.(Call).getCallee() = m and
    m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    m.hasName("setSecure") and
    falseArg = e.(Call).getArgument(0) and
    falseArg instanceof BooleanLiteral and
    falseArg.(BooleanLiteral).getValue() = false
  )
}

from DataFlow::Node source, DataFlow::Node sink
where
  isCookieConstructorCall(source.asExpr()) and
  isInsecureSetSecureCall(sink.asExpr()) and
  DataFlow::localFlow(source, sink)
select sink, 
  "Cookie created without secure flag enabled. Consider setting setSecure(true) " +
  "to ensure the cookie is only sent over HTTPS."
