Rule Content:
/**
 * @name Cookie created without secure flag enabled
 * @description Default session middleware settings: `setSecure` not set to true. This ensures 
 * that the cookie is sent only over HTTPS to prevent cross-site scripting attacks.
 * @kind problem
 * @id java/cookie-issecure-false
 * @security-severity 7.4
 * @tags security
 *       external/cwe/cwe-614
 */

import java

predicate isCookieCreation(MethodAccess ma) {
  ma.getMethod().hasName("<init>") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
}

predicate isInsecureSetSecure(MethodAccess ma) {
  ma.getMethod().hasName("setSecure") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
  exists(booleanLiteral falseArg | 
    falseArg = ma.getArgument(0) and
    falseArg.getValue().toInt() = 0
  )
}

from MethodAccess cookieCreation, MethodAccess setSecureCall
where
  isCookieCreation(cookieCreation) and
  isInsecureSetSecure(setSecureCall) and
  exists(DataFlow::localFlow(
    DataFlow::exprNode(cookieCreation.getQualifier()),
    DataFlow::exprNode(setSecureCall.getQualifier())
  ))
select setSecureCall, 
  "Cookie created without secure flag enabled. Consider setting setSecure(true) " +
  "to ensure the cookie is only sent over HTTPS."
