Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of URL construction.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class UserInput extends TaintTracking::Source {
  UserInput() {
    exists(Parameter p |
      p.getType().toString().matches("^(?!(Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean))") and
      (
        exists(Annotation anno |
          anno.getType().getName() in ["RequestBody", "PathVariable", "RequestParam", 
                                      "RequestHeader", "CookieValue", "ModelAttribute"] and
          anno.getTarget() = p.getAnnotatedElement()
        )
      ) and
      result = p.asVariable()
    )
  }
}

class URLConstruction extends TaintTracking::Sink {
  URLConstruction() {
    exists(Constructor urlConst |
      urlConst.getDeclaringType().hasQualifiedName("java.net", "URL") and
      (
        // Match URL constructor calls
        exists(MethodAccess ma |
          ma.getConstructor() = urlConst and
          ma.getArgument(0) = result.asExpr()
        )
        or
        // Match URL string literals with placeholders
        exists(StringLiteral sl |
          sl.getValue().regexpMatch("http(s?)://%(v|s|q).*") and
          sl = result.asExpr()
        )
      )
    )
  }
}

class TaintedUrlHostFlowConfiguration extends TaintTracking::Configuration {
  TaintedUrlHostFlowConfiguration() { this = "TaintedUrlHostFlow" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof URLConstruction }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma |
      // Handle string concatenation
      ma.getMethod().getName().matches("concat") and
      pred.asExpr() = ma.getArgument(0) and
      succ.asExpr() = ma
    )
  }
}

