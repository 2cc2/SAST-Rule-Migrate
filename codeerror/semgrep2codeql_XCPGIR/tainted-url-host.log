        pn.getParameter() = p and
        exists(DataFlow::ArgumentNode an |
          an.getCallable() = m and
          node1.asExpr() = an.asExpr() and
          node2.asExpr() = pn.asExpr()
        )
      )
    )
    or
    // String concatenation
    exists(AddExpr add |
      (add.getLeftOperand() = node1.asExpr() or add.getRightOperand() = node1.asExpr()) and
      node2.asExpr() = add
    )
  }
}

