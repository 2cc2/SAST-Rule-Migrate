Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL. This could allow an attacker to 
 *   send data to their own server, potentially exposing sensitive data such as cookies or authorization information 
 *   sent with this request. They could also probe internal servers or other resources that the server running this 
 *   code can access. (This is called server-side request forgery, or SSRF.) Do not allow arbitrary hosts. Instead, 
 *   create an allowlist for approved hosts, hardcode the correct host, or ensure that the user data can only affect 
 *   the path or parameters.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController
import semmle.code.java.StringFormat

class WebRequestParameterSource extends DataFlow::Node {
  WebRequestParameterSource() {
    exists(MethodParameter mp |
      mp = this.asParameter() and
      not mp.getType().toString().matches("^(Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean)") and
      mp.getAnAnnotation().toString().matches("(RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue|ModelAttribute)")
    )
  }
}

class UrlConstructionSink extends DataFlow::Node {
  UrlConstructionSink() {
    exists(ConstructorCall cc |
      cc = this.asExpr() and
      cc.getConstructedType().hasQualifiedName("java.net", "URL") and
      cc.getArgument(0) = this.asExpr()
    )
  }
}

class StringConcatUrlSink extends DataFlow::Node {
  StringConcatUrlSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() matches "concat|append|format" and
      ma.getMethod().getDeclaringType() instanceof TypeString and
      ma.getArgument(_) = this.asExpr() and
      ma.getQualifier().toString().matches("\"http(s?)://%(v|s|q).*\"")
    ) or
    exists(BinaryOperation bo |
      bo.getOperator() = BinaryOperation::PLUS and
      (bo.getLeftOperand().toString().matches("\"http(s?)://%(v|s|q).*\"") or 
       bo.getRightOperand().toString().matches("\"http(s?)://%(v|s|q).*\"")) and
      this.asExpr() = bo
    )
  }
}

class TaintedUrlHostConfiguration extends TaintTracking::Configuration {
  TaintedUrlHostConfiguration() { this = "TaintedUrlHost" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof WebRequestParameterSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrlConstructionSink or
    sink instanceof StringConcatUrlSink
  }
  
  predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Handle parameter passing (arg->param)
    exists(Method m, Parameter p, DataFlow::Argument arg |
      m.getAParameter() = p and
      arg.getCallable() = m and
      arg.(DataFlow::ParameterNode).getParameter() = p and
      node1.asArgument() = arg and
      node2.asParameter() = p
    )
    or
    // Handle string concatenation operations
    exists(BinaryOperation bo |
      bo.getOperator() = BinaryOperation::PLUS and
      (bo.getLeftOperand() = node1.asExpr() or bo.getRightOperand() = node1.asExpr()) and
      node2.asExpr() = bo
    )
    or
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "concat" or 
       ma.getMethod().getName() = "append" or
       ma.getMethod().getName() = "format") and
      ma.getMethod().getDeclaringType() instanceof TypeString and
      (ma.getAnArgument() = node1.asExpr() or ma.getQualifier() = node1.asExpr()) and
      node2.asExpr() = ma
    )
  }
}

from TaintedUrlHostConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potentially tainted URL host construction detected. User input '$@' flows into URL host construction.",
  source.getNode(), "user input"
