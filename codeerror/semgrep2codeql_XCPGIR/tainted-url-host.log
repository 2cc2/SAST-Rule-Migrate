Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of URL construction
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringController
import DataFlow::PathGraph

predicate isSourceParameter(Parameter p) {
  not p.getType() instanceof PrimitiveType and
  exists(Annotation a |
    a.getType().getName() in ["RequestBody", "PathVariable", "RequestParam", 
                             "RequestHeader", "CookieValue", "ModelAttribute"] and
    p.getAnnotatedElement() = a.getAnnotatedElement()
  )
}

class UserInput extends DataFlow::Node {
  UserInput() { this.asParameter() instanceof SpringControllerParameter and isSourceParameter(this.asParameter()) }
}

class URLConstruction extends DataFlow::Node {
  URLConstruction() {
    exists(NewExpr ne |
      ne.getConstructor().getDeclaringType().hasQualifiedName("java.net", "URL") and
      this.asExpr() = ne.getArgument(0)
    )
    or
    exists(StringLiteral sl |
      sl.getValue().regexpMatch("http(s?)://%(v|s|q).*") and
      this.asExpr() = sl
    )
  }
}

class TaintedUrlHostFlow extends TaintTracking::Configuration {
  TaintedUrlHostFlow() { this = "TaintedUrlHostFlow" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof URLConstruction }
  
  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(BinaryExpr be |
      be.getOperator() = BinaryOp.PLUS and
      (be.getLeftOperand() = pred.asExpr() or be.getRightOperand() = pred.asExpr()) and
      succ.asExpr() = be
    )
  }
}

