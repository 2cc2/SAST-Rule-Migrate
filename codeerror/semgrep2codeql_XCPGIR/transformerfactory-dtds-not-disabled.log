/**
 * @name TransformerFactory XXE vulnerability
 * @description Detects when DOCTYPE declarations are enabled for TransformerFactory,
 *              making it vulnerable to XML external entity attacks.
 * @severity ERROR
 * @kind path-problem
 * @id java/transformerfactory-dtds-not-disabled
 * @tags security
 *       external/cwe/cwe-611
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.XML

class UnsafeTransformerFactoryCreation extends MethodAccess {
  UnsafeTransformerFactoryCreation() {
    this.getMethod().hasName("newInstance") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory")
  }
}

class SafeTransformerFactoryConfiguration extends MethodAccess {
  SafeTransformerFactoryConfiguration() {
    this.getMethod().hasName("setAttribute") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
    (
      (this.getArgument(0).toString() = "XMLConstants.ACCESS_EXTERNAL_DTD" and
       this.getArgument(1).toString() = "\"\"") or
      (this.getArgument(0).toString() = "XMLConstants.ACCESS_EXTERNAL_STYLESHEET" and
       this.getArgument(1).toString() = "\"\"")
    )
  }
}

class TransformerUsage extends MethodAccess {
  TransformerUsage() {
    this.getMethod().hasName("newTransformer") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory")
  }
}

class TransformerFactoryXXEFlowConfiguration extends TaintTracking::Configuration {
  TransformerFactoryXXEFlowConfiguration() {
    this = "TransformerFactory XXE Flow Configuration"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(UnsafeTransformerFactoryCreation call |
      source.asExpr() = call
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(TransformerUsage call |
      sink.asExpr() = call
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SafeTransformerFactoryConfiguration call |
      sanitizer.asExpr() = call
    )
  }
}

from TransformerFactoryXXEFlowConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "DOCTYPE declarations are enabled for this TransformerFactory. This is vulnerable to XML external entity attacks. " +
  "Disable this by setting the attributes 'accessExternalDTD' and 'accessExternalStylesheet' to ''.", 
  source, sink,
  "Unsafe TransformerFactory configuration"
================================================================================
