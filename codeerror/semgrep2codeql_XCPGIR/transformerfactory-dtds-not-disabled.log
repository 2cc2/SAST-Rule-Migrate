Rule Content:
/**
 * @name TransformerFactory with DTD enabled
 * @description DOCTYPE declarations are enabled for this TransformerFactory, making it vulnerable to XML external 
 *              entity attacks. Disable this by setting the attributes 'accessExternalDTD' and 
 *              'accessExternalStylesheet' to ''.
 * @kind path-problem
 * @problem.severity error
 * @id java/transformerfactory-dtds-not-disabled
 */

import java
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class TransformerFactoryConfiguration extends TaintTracking::Configuration {
  TransformerFactoryConfiguration() { 
    this = "TransformerFactoryDtdTaint" 
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m | 
      m.hasName("newInstance") and
      m.getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      source.asExpr() = m.getACall()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m | 
      m.hasName("newTransformer") and
      m.getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      sink.asExpr() = m.getACall()
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma, string attrName |
      ma.getMethod().hasName("setAttribute") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      (
        (attrName = "accessExternalDTD" or attrName = "ACCESS_EXTERNAL_DTD" or
         attrName = "accessExternalStylesheet" or attrName = "ACCESS_EXTERNAL_STYLESHEET") and
        ma.getArgument(0).toString() = attrName and
        ma.getArgument(1).toString() = "\"\""
      ) and
      node.asExpr() = ma
    )
  }
}

from TransformerFactoryConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "XML TransformerFactory with DTD enabled found", 
  source.getNode(), sink.getNode(),
  "Vulnerable TransformerFactory instance created here"
