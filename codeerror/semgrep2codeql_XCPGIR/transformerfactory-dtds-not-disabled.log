/**
 * @name TransformerFactory with DTD enabled
 * @description DOCTYPE declarations are enabled for this TransformerFactory,
 *              making it vulnerable to XML external entity attacks.
 *              Disable this by setting the attributes 'accessExternalDTD' and
 *              'accessExternalStylesheet' to ''.
 * @kind path-problem
 * @problem.severity error
 * @id java/transformerfactory-dtds-not-disabled
 */

import java
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class TransformerFactorySource extends DataFlow::ExprNode {
  TransformerFactorySource() {
    exists(Method m, MethodAccess ma |
      m.hasName("newInstance") and
      m.getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class TransformerFactorySink extends DataFlow::ExprNode {
  TransformerFactorySink() {
    exists(Method m, MethodAccess ma |
      m.hasName("newTransformer") and
      m.getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class DisableAttributeSanitizer extends DataFlow::Node {
  DisableAttributeSanitizer() {
    exists(MethodAccess ma, string attrName, string emptyString |
      ma.getMethod().hasName("setAttribute") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      (
        attrName.matches("%(ACCESS_EXTERNAL_DTD|accessExternalDTD)%") or
        attrName.matches("%(ACCESS_EXTERNAL_STYLESHEET|accessExternalStylesheet)%")
      ) and
      ma.getArgument(0).toString() = attrName and
      ma.getArgument(1).toString() = "\"\"" and
      this.asExpr() = ma
    )
  }
}

class TransformerFactoryConfig extends TaintTracking::Configuration {
  TransformerFactoryConfig() {
    this = "TransformerFactoryDtdTaintTracking"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof TransformerFactorySource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TransformerFactorySink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof DisableAttributeSanitizer
  }
}

from TransformerFactoryConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "XML TransformerFactory with DTD enabled found",
