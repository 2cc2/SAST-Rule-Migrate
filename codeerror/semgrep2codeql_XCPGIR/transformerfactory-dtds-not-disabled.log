Rule Content:
/**
 * @name TransformerFactory with DTD enabled
 * @description DOCTYPE declarations are enabled for this TransformerFactory, making it vulnerable to XML external 
 *              entity attacks. Disable this by setting the attributes 'accessExternalDTD' and 
 *              'accessExternalStylesheet' to ''.
 * @kind path-problem
 * @problem.severity error
 * @id java/transformerfactory-dtds-not-disabled
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class TransformerFactoryInstance extends DataFlow::Node {
  TransformerFactoryInstance() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("newInstance") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      this.asExpr() = ma
    )
  }
}

class NewTransformerCall extends DataFlow::Node {
  NewTransformerCall() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("newTransformer") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      this.asExpr() = ma
    )
  }
}

class DtdDisableSanitizer extends DataFlow::Node {
  DtdDisableSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("setAttribute") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      ma.getArgument(0).(StringLiteral).getValue().regexpMatches(".*(ACCESS_EXTERNAL_DTD|accessExternalDTD).*") and
      ma.getArgument(1).(StringLiteral).getValue() = "" and
      this.asExpr() = ma
    )
  }
}

class StylesheetDisableSanitizer extends DataFlow::Node {
  StylesheetDisableSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("setAttribute") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      ma.getArgument(0).(StringLiteral).getValue().regexpMatches(".*(ACCESS_EXTERNAL_STYLESHEET|accessExternalStylesheet).*") and
      ma.getArgument(1).(StringLiteral).getValue() = "" and
      this.asExpr() = ma
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "TransformerFactoryDtdTaint" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof TransformerFactoryInstance
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof NewTransformerCall
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof DtdDisableSanitizer or
    node instanceof StylesheetDisableSanitizer
  }
}

from TaintConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, 
  "XML TransformerFactory with DTD enabled found", 
  source, sink,
  "Vulnerable TransformerFactory instance created here"
