xcpgir_version: "1.0"
rule:
  id: formatted-sql-string
  kind: taint
  severity: ERROR
  message: "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead."
scope:
  languages: [java]
  frameworks: ["*"]

sources:
  - id: USER_INPUT
    match:
      node: PARAM
      where:
        - op: or
          conditions:
            - op: regex
              left: methodFullName
              right: ".*HttpServletRequest.getParameter"
            - op: regex
              left: typeFullName
              right: "javax.servlet.http.HttpServletRequest"

sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api:
        type: java.sql.Statement
        methods: [execute, executeQuery, executeUpdate, addBatch]
      arg_index: 0

propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint
    match:
      node: CALL
      api:
        methods: [String.format, String.join, String.concat]
      where:
        - op: or
          conditions:
            - pattern: "$X + $INPUT"
            - pattern: "$X += $INPUT"
            - pattern: "$STRB.append($INPUT)"

sanitizers:
  - id: PARAMETERIZED_QUERY
    match:
      node: CALL
      api:
        type: java.sql.PreparedStatement
    effect: neutralize

flows:
  - source: USER_INPUT
    sink: SQL_EXEC
    through: [STRING_CONCAT*]
    constraints:
      path:
        must:
          - { pattern: "CALL(java.sql.Statement.execute)" }
          - { pattern: "CALL(java.sql.Connection.prepareStatement)" }
        must_not:
          - { pattern: "CALL(java.sql.PreparedStatement.setString)" }

report:
  message: "User input reaches SQL execution without parameterization"
  locations: ["source", "sink", "path"]
  evidence:
    capture:
      - { argument: 0 }

tests:
  positive:
    - "stmt.executeQuery(\"SELECT * FROM users WHERE id = \" + request.getParameter(\"id\"));"
  negative:
    - "PreparedStatement pstmt = conn.prepareStatement(\"SELECT * FROM users WHERE id = ?\"); pstmt.setString(1, request.getParameter(\"id\"));"
