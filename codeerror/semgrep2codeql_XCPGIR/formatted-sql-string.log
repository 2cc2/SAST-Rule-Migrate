Rule Content:
/**
 * @id formatted-sql-string
 * @severity ERROR
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables 
 *              in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 */

import java
import semmle.code.java.frameworks.ServletRequest
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class FormattedSqlString extends TaintTracking::Configuration {
  FormattedSqlString() { this = "formatted-sql-string" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof Parameter and
    (
      source.getCallable().getName().matches(".*HttpServletRequest.getParameter") or
      source.getType().hasName("javax.servlet.http.HttpServletRequest")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["execute", "executeQuery", "executeUpdate", "addBatch"]) and
      ma.getMethod().getDeclaringType().hasName("java.sql.Statement") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      (
        ma.getMethod().hasName(["format", "join", "concat"]) and
        ma.getMethod().getDeclaringType().hasName("java.lang.String") and
        node1.asExpr() = ma.getArgument(ma.getNumberOfArguments() - 1) and
        node2.asExpr() = ma
      )
      or
      exists(InfixOperation io |
        (
          io.getOperator() = "+" or
          io.getOperator() = "+="
        ) and
        node1.asExpr() = io.getRightOperand() and
        node2.asExpr() = io
      )
      or
      exists(MethodAccess append |
        append.getMethod().hasName("append") and
        append.getMethod().getDeclaringType().getASupertype*().hasName("java.lang.StringBuilder") and
        node1.asExpr() = append.getArgument(0) and
        node2.asExpr() = append
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasName("java.sql.PreparedStatement") and
      sanitizer.asExpr() = ma
    )
  }
}

from FormattedSqlString config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User input reaches SQL execution without parameterization"
