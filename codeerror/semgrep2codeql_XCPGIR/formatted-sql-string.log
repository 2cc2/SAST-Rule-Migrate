Rule Content:
/**
 * @name Formatted SQL String
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized. Use prepared 
 *              statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 * @id java/formatted-sql-string
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class FormattedSqlConfig extends TaintTracking::Configuration {
  FormattedSqlConfig() { this = "FormattedSqlConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Servlet request parameters as source
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getParameter") |
      source.asExpr() = ma
    )
    or
    // String parameters in Servlet methods as source
    exists(Parameter p |
      p.getType().hasName("String") and
      p.getCallable().getDeclaringType().getName().matches("%Servlet%") |
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // SQL execution sinks
    exists(MethodAccess ma |
      (ma.getMethod().hasQualifiedName("java.sql", "Statement", "executeQuery") or
       ma.getMethod().hasQualifiedName("java.sql", "Connection", "prepareStatement")) |
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // CriteriaBuilder methods as sanitizers
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.persistence.criteria", "CriteriaBuilder") |
      sanitizer.asExpr() = ma
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node src, DataFlow::Node dst) {
    // String concatenation propagation
    exists(BinaryExpr be | 
      be.getOp() instanceof ConcatenateOp and
      (src.asExpr() = be.getLeftOperand() and dst.asExpr() = be) or
      (src.asExpr() = be.getRightOperand() and dst.asExpr() = be)
    )
    or
    // StringBuilder append propagation
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.lang", "StringBuilder", "append") |
      (src.asExpr() = ma.getArgument(0) and dst.asExpr() = ma) or
      (src.asExpr() = ma.getQualifier() and dst.asExpr() = ma)
    )
  }
}

