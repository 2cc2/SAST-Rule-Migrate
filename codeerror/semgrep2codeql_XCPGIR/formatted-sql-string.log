/**
 * @id formatted-sql-string
 * @severity ERROR
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized. 
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.FlowSources

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(Method m |
      m.hasName("getParameter") and
      m.getDeclaringType().getQualifiedName().matches("javax.servlet.http.HttpServletRequest") and
      this.asParameter() = any(MethodAccess ma | ma.getMethod() = m).getAnArgument()
    )
    or
    exists(Parameter p |
      p.getType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      this.asParameter() = p
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(Method m |
      m.hasName(["execute", "executeQuery", "executeUpdate", "addBatch"]) and
      m.getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
  }
}

class StringConcatTaintStep extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node node1, DataFlow::Node node2) {
    // String concatenation using '+'
    exists(AddExpr add |
      (add.getRightOperand() = node1.asExpr() or add.getLeftOperand() = node1.asExpr()) and
      add = node2.asExpr()
    )
    // StringBuilder.append()
    or exists(MethodAccess append |
      append.getMethod().hasName("append") and
      append.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.lang", "AbstractStringBuilder") and
      append.getArgument(0) = node1.asExpr() and
      append = node2.asExpr()
    )
    // String methods
    or exists(MethodAccess ma |
      ma.getMethod().hasName(["format", "join", "concat"]) and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getAnArgument() = node1.asExpr() and
      ma = node2.asExpr()
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
  }
}

class SqlInjectionConfiguration extends TaintTracking::Configuration {
  SqlInjectionConfiguration() { this = "Sql injection from request parameter to SQL execution" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof PreparedStatementSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    any(StringConcatTaintStep s).step(pred, succ)
  }
}

