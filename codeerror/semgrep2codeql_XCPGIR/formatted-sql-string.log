Rule Content:
/**
 * @name Formatted SQL String
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized. Use prepared 
 *              statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 * @id java/formatted-sql-string
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.Servlets

class ServletRequestSource extends DataFlow::ExprNode {
  ServletRequestSource() {
    exists(Method m | 
      m.hasQualifiedName("javax.servlet", "ServletRequest", "getParameter") |
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
  }
}

class ServletParameterSource extends DataFlow::ParameterNode {
  ServletParameterSource() {
    this.getType().hasName("String") and
    this.getCallable().getDeclaringType().getName().matches("*Servlet*")
  }
}

class SqlSink extends DataFlow::ExprNode {
  SqlSink() {
    exists(Method m |
      (m.hasQualifiedName("java.sql", "Statement", "executeQuery") or
       m.hasQualifiedName("java.sql", "Connection", "prepareStatement")) |
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
  }
}

class CriteriaBuilderSanitizer extends DataFlow::ExprNode {
  CriteriaBuilderSanitizer() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("javax.persistence.criteria", "CriteriaBuilder") |
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
  }
}

predicate isStringConcat(DataFlow::Node src, DataFlow::Node sink) {
  exists(BinaryExpr concat |
    concat.getOp().toString() = "+" and
    ((src.asExpr() = concat.getLeftOperand() and sink.asExpr() = concat) or
     (src.asExpr() = concat.getRightOperand() and sink.asExpr() = concat))
  )
}

predicate isStringBuilderAppend(DataFlow::Node src, DataFlow::Node sink) {
  exists(MethodAccess append |
    append.getMethod().hasQualifiedName("java.lang", "StringBuilder", "append") and
    ((src.asExpr() = append.getArgument(0) and sink.asExpr() = append) or
     (src.asExpr() = append.getQualifier() and sink.asExpr() = append))
  )
}

class FormattedSqlConfig extends DataFlow::Configuration {
  FormattedSqlConfig() { this = "Formatted SQL String Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestSource or
    source instanceof ServletParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof CriteriaBuilderSanitizer
  }

  override predicate isAdditionalFlowStep(DataFlow::Node src, DataFlow::Node sink) {
    isStringConcat(src, sink) or
    isStringBuilderAppend(src, sink)
  }
}

from FormattedSqlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input reaches SQL execution without sanitization. Source: $@", 
  source.getNode(), "$, Sink: $@", sink.getNode(), "$"
