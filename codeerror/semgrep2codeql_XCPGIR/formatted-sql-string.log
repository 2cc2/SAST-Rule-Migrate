Rule Content:
/**
 * @name Formatted SQL String
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized. Use prepared 
 *              statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 * @id java/formatted-sql-string
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormatting

class FormattedSqlConfiguration extends TaintTracking::Configuration {

    FormattedSqlConfiguration() { this = "FormattedSqlConfiguration" }

    override predicate isSource(DataFlow::Node source) {
        // User input sources
        exists(MethodAccess ma | 
            ma.getMethod().getName() = "getParameter" and
            ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet", "ServletRequest") |
            source.asExpr() = ma
        )
        or
        // Servlet parameter sources
        exists(Parameter p |
            p.getType().hasName("String") and
            p.getCallable().getDeclaringType().getName().matches("*Servlet*") |
            source.asParameter() = p
        )
    }

    override predicate isSink(DataFlow::Node sink) {
        // SQL execution sinks
        exists(MethodAccess ma |
            (ma.getMethod().getName() = "executeQuery" and
             ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement"))
            or
            (ma.getMethod().getName() = "prepareStatement" and
             ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection")) |
            sink.asExpr() = ma.getArgument(0)
        )
    }

    override predicate isSanitizer(DataFlow::Node sanitizer) {
        exists(MethodAccess ma |
            ma.getMethod().getDeclaringType().hasQualifiedName("javax.persistence.criteria", "CriteriaBuilder") |
            sanitizer.asExpr() = ma
        )
    }

    override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
        // String concatenation propagation
        exists(StringConcat sc | node1.asExpr() = sc.getAnOperand() and node2.asExpr() = sc)
        or
        // StringBuilder append propagation
        exists(MethodAccess ma |
            ma.getMethod().getName() = "append" and
            ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder") |
            (node1.asExpr() = ma.getArgument(0) and node2.asExpr() = ma) or
            (node1.asExpr() = ma.getQualifier() and node2.asExpr() = ma)
        )
    }
}

from FormattedSqlConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User input reaches SQL execution without sanitization"
