Rule Content:
/**
 * @id formatted-sql-string
 * @severity ERROR
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized. 
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringConcat

class HttpServletRequestSource extends DataFlow::ExprNode {
  HttpServletRequestSource() {
    exists(Method m | 
      m.hasName("getParameter") and
      m.getDeclaringType().getName().matches("javax.servlet.http.HttpServletRequest") and
      this.asExpr() = any(MethodAccess ma | 
        ma.getMethod() = m
      ).getAnArgument()
    )
    or
    exists(Parameter p |
      p.getType().hasName("javax.servlet.http.HttpServletRequest") and
      this.asExpr() = p.getAnAccess()
    )
  }
}

class SqlSink extends DataFlow::ExprNode {
  SqlSink() {
    exists(Method m | 
      m.hasName(["execute", "executeQuery", "executeUpdate", "addBatch"]) and
      m.getDeclaringType().hasName("java.sql.Statement") and
      this.asExpr() = any(MethodAccess ma | 
        ma.getMethod() = m
      ).getArgument(0)
    )
  }
}

class StringConcatTaint extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node node1, DataFlow::Node node2) {
    // String concat operations
    exists(StringConcatOperation sco | 
      sco.getAnOperand() = node1.asExpr() and
      sco = node2.asExpr()
    )
    or
    // String builder append
    exists(MethodAccess ma |
      ma.getMethod().getName() = "append" and
      ma.getMethod().getDeclaringType().getASupertype*().hasName("java.lang.AbstractStringBuilder") and
      ma.getArgument(0) = node1.asExpr() and
      ma = node2.asExpr()
    )
    or
    // String format/concat
    exists(MethodAccess ma |
      ma.getMethod().hasName(["format", "concat", "join"]) and
      ma.getMethod().getDeclaringType().hasName("java.lang.String") and
      ma.getAnArgument() = node1.asExpr() and
      ma = node2.asExpr()
    )
  }
}

class PreparedStatementSanitizer extends TaintTracking::Sanitizer {
  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasName("java.sql.PreparedStatement") and
      node.asExpr() = ma
    )
  }
}

class SqlQueryTaintConfig extends TaintTracking::Configuration {
  SqlQueryTaintConfig() { this = "SqlQueryTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpServletRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    any(StringConcatTaint s).step(node1, node2)
  }
}

