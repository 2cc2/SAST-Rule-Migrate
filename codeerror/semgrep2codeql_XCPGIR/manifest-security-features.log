/**
 * @name Android Manifest ClearText Traffic
 * @description The Android manifest is configured to allow non-encrypted connections.
 * @kind problem
 * @problem.severity warning
 * @precision medium
 * @tags security
 *       android
 *       external/cwe/cwe-319
 */

import java
import semmle.code.xml.AndroidManifest

from XmlElement manifestElem,
     Attribute cleartextAttribute,
     Attribute securityConfigAttribute
where
  // Find Android manifest element
  manifestElem.getName() = "manifest" and
  
  // Find usesCleartextTraffic attribute with value true
  cleartextAttribute.getParent() = manifestElem and
  cleartextAttribute.getName() = "usesCleartextTraffic" and
  cleartextAttribute.getValue() = "true" and
  
  // Find networkSecurityConfig attribute with any value
  securityConfigAttribute.getParent() = manifestElem and
  securityConfigAttribute.getName() = "networkSecurityConfig" and
  securityConfigAttribute.getValue().regexpMatch(".+")
  
select cleartextAttribute,
  "Manifest uses both `android:usesCleartextTraffic` and Network Security Config. " +
  "The `usesCleartextTraffic` directive is ignored on Android 7 (API 24) and above if a Network Security Config is present.",
  cleartextAttribute,
  securityConfigAttribute.getLocation()
