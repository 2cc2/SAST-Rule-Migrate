import semmle.code.xml.ManifestFile

from ManifestFile manifest,
     XmlElement manifestElem,
     XmlAttribute cleartextAttr,
     XmlAttribute securityConfigAttr
where
  // Find Android manifest element
  manifestElem.getName() = "manifest" and
  manifestElem.getFile() = manifest and
  
  // Find usesCleartextTraffic attribute with value true
  cleartextAttr.getParent() = manifestElem and
  cleartextAttr.getName() = "android:usesCleartextTraffic" and
  cleartextAttr.getValue() = "true" and
  
  // Find networkSecurityConfig attribute with any value
  securityConfigAttr.getParent() = manifestElem and
  securityConfigAttr.getName() = "android:networkSecurityConfig" and
  securityConfigAttr.getValue().matches(".+")
  
select cleartextAttr,
  "Manifest uses both `android:usesCleartextTraffic` and Network Security Config. " +
  "The `usesCleartextTraffic` directive is ignored on Android 7 (API 24) and above if a Network Security Config is present.",
  cleartextAttr,
  securityConfigAttr.getLocation()
