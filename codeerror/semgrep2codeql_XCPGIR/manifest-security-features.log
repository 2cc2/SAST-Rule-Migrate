Rule Content:
/**
 * @name Manifest uses both `android:usesCleartextTraffic` and Network Security Config
 * @id manifest-usesCleartextTraffic
 * @description The Android manifest is configured to allow non-encrypted connections.
 * @kind problem
 * @problem.severity info
 */
import java
import semmle.code.xml.XML

predicate hasCleartextTraffic(XmlElement e) {
  exists(Attribute attr | 
    attr.getElement() = e and
    attr.getName() = "android:usesCleartextTraffic" and
    attr.getValue().toLowerCase() = "true"
  )
}

predicate hasNetworkSecurityConfig(XmlElement e) {
  exists(Attribute attr | 
    attr.getElement() = e and
    attr.getName() = "android:networkSecurityConfig"
  )
}

from XmlElement manifest, Attribute cleartextAttr, Attribute nscAttr
where 
  manifest.getName() = "manifest" and
  cleartextAttr.getElement() = manifest and
  cleartextAttr.getName() = "android:usesCleartextTraffic" and
  cleartextAttr.getValue().toLowerCase() = "true" and
  nscAttr.getElement() = manifest and
  nscAttr.getName() = "android:networkSecurityConfig" and
  not manifest.isInsideComment()
select manifest, 
  "Manifest uses both `android:usesCleartextTraffic` and Network Security Config. " +
  "The `usesCleartextTraffic` directive is ignored on Android 7 (API 24) and above " +
  "if a Network Security Config is present."
