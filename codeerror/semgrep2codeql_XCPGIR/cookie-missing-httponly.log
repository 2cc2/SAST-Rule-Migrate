/**
 * @name Cookie without HttpOnly flag
 * @description Detects cookies that are created without setting the HttpOnly flag.
 * @kind problem
 * @problem.severity warning
 * @precision high
 * @id java/cookie-missing-httponly
 * @tags security
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class CookieCreation extends DataFlow::Node {
  CookieCreation() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "setValue" and
      ma.getMethod().getDeclaringType().hasName("Cookie") and
      ma.getQualifier() = this.asExpr()
    )
  }
}

class CookieWithoutHttpOnly extends DataFlow::Node {
  CookieWithoutHttpOnly() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "setHttpOnly" and
      ma.getMethod().getDeclaringType().hasName("Cookie") and
      ma.getArgument(0).(Literal).getIntValue() = 0 and
      ma.getQualifier() = this.asExpr()
    )
  }
}

class HttpOnlyTrueSanitizer extends DataFlow::Node {
  HttpOnlyTrueSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "setHttpOnly" and
      ma.getMethod().getDeclaringType().hasName("Cookie") and
      ma.getArgument(0).(Literal).getIntValue() = 1 and
      ma.getQualifier() = this.asExpr()
    )
  }
}

class CookieAddition extends DataFlow::Node {
  CookieAddition() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "addCookie" and
      ma.getMethod().getDeclaringType().hasName("HttpServletResponse") and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class CookieHttpOnlyFlowConfig extends TaintTracking::Configuration {
  CookieHttpOnlyFlowConfig() { this = "CookieHttpOnlyFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof CookieCreation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CookieWithoutHttpOnly or sink instanceof CookieAddition
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof HttpOnlyTrueSanitizer
  }
}

from CookieHttpOnlyFlowConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Cookie without 'HttpOnly' flag detected"
