Rule Content:
/**
 * @name Cookie without HttpOnly flag
 * @description Detects cookies that are created without setting the HttpOnly flag.
 * @kind problem
 * @problem.severity warning
 * @precision high
 * @id java/cookie-missing-httponly
 * @tags security
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.Servlets

class CookieSource extends DataFlow::Node {
  CookieSource() {
    exists(Method m, MethodAccess ma |
      ma.getMethod() = m and
      m.hasName("setValue") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      ma.getQualifier() = this.asExpr()
    )
  }
}

class CookieWithoutHttpOnlySink extends DataFlow::Node {
  CookieWithoutHttpOnlySink() {
    exists(Method m, MethodAccess ma |
      ma.getMethod() = m and
      m.hasName("setHttpOnly") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      ma.getArgument(0).(BooleanLiteral).getValue() = false and
      ma.getQualifier() = this.asExpr()
    )
  }
}

class CookieAdditionSink extends DataFlow::Node {
  CookieAdditionSink() {
    exists(Method m, MethodAccess ma |
      ma.getMethod() = m and
      m.hasName("addCookie") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class HttpOnlySanitizer extends DataFlow::Barrierguard {
  HttpOnlySanitizer() {
    exists(Method m, MethodAccess ma |
      ma.getMethod() = m and
      m.hasName("setHttpOnly") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      ma.getArgument(0).(BooleanLiteral).getValue() = true and
      this.asExpr() = ma.getQualifier()
    )
  }
}

class CookieHttpOnlyFlow extends DataFlow::Configuration {
  CookieHttpOnlyFlow() { this = "CookieHttpOnlyFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof CookieSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CookieWithoutHttpOnlySink or
    sink instanceof CookieAdditionSink
  }

  override predicate isBarrierGuard(DataFlow::Barrierguard guard) {
    guard instanceof HttpOnlySanitizer
  }
}

from CookieHttpOnlyFlow flow, DataFlow::Node source, DataFlow::Node sink
where flow.hasFlow(source, sink)
select sink, "Cookie without 'HttpOnly' flag detected", source, 
  "This cookie is missing the HttpOnly flag which prevents client-side script access"
