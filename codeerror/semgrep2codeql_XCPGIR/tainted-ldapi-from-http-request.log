/**
 * @name Tainted LDAP query from HTTP request
 * @description Detects input from HTTPServletRequest going into LDAP query without proper sanitization.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-ldapi-from-http-request
 * @tags security
 *       external/cwe/cwe-90
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.LdapQueries

class HttpRequestSource extends RemoteFlowSource {
  HttpRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getParameter") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      not ma.getArgument(0).(StringLiteral).getValue() = "" and
      this.asExpr() = ma
    )
  }
}

class LdapSink extends MethodAccess {
  LdapSink() {
    exists(Method m |
      (m.hasName("search") and
      m.getDeclaringType().hasQualifiedName("javax.naming.directory", "InitialDirContext") or
      m.getDeclaringType().hasQualifiedName("javax.naming.directory", "DirContext")) and
      this.getMethod() = m and
      not this.getArgument(1).(StringLiteral).getValue() = "\"...""
    )
  }
}

class TaintedFlowConfig extends TaintTracking::Configuration {
  TaintedFlowConfig() { this = "TaintedFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof HttpRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(LdapSink ls |
      sink.asExpr() = ls.getArgument(1)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    false
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedFlowConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User input from HTTP request reaches LDAP query without sanitization"
