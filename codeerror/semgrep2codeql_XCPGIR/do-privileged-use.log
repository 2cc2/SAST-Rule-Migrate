Rule Content:
/**
 * @name Privileged code usage
 * @description Marking code as privileged enables a piece of trusted code to temporarily
 * enable access to more resources than are available directly to the code
 * that called it. Be very careful in your use of the privileged construct,
 * and always remember to make the privileged code section as small as possible.
 * @kind problem
 * @problem.severity warning
 * @id java/privileged-code-usage
 */

import java

// Match calls to AccessController.doPrivileged
predicate isPrivilegedCall(MethodAccess ma) {
  exists(Method m | 
    m = ma.getMethod() and
    m.hasName("doPrivileged") and
    m.getDeclaringType().hasQualifiedName("java.security", "AccessController")
  )
}

// Match types implementing PrivilegedAction
predicate isPrivilegedAction(RefType t) {
  exists(Interface privilegedAction |
    privilegedAction.hasQualifiedName("java.security", "PrivilegedAction") and
    t.getASupertype*() = privilegedAction
  )
}

from MethodAccess ma, string sink
where isPrivilegedCall(ma)
select ma, "Privilege escalation risk detected: direct call to AccessController.doPrivileged"

from RefType t, string sink
where isPrivilegedAction(t)
select t, "Privilege escalation risk detected: type implements PrivilegedAction"
