Rule Content:
/**
 * @name Command injection from formatted runtime call
 * @description Detects command injection vulnerabilities where formatted or concatenated strings 
 *              are passed to java.lang.Runtime calls. This is dangerous if variables are 
 *              controlled by user input without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/command-injection-formatted-runtime-call
 * @tags security
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.security.CommandInjection

class RuntimeExecCall extends MethodAccess {
  RuntimeExecCall() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      m.hasName("exec") and
      this.getMethod() = m
    )
  }
}

class RuntimeLoadLibraryCall extends MethodAccess {
  RuntimeLoadLibraryCall() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      m.hasName("loadLibrary") and
      this.getMethod() = m
    )
  }
}

class UserInputSource extends RemoteFlowSource::Range {
  UserInputSource() {
    exists(
      this.asExpr().(Literal).getValue().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)") or
      this instanceof Parameter or
      this instanceof FieldRead or
      this instanceof MethodCall
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeExecCall exec |
      sink.asExpr() = exec.getArgument(0)
    ) or
    exists(RuntimeLoadLibraryCall loadLib |
      sink.asExpr() = loadLib.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Literal literal |
      node.asExpr() = literal
    )
  }
}

from CommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potentially unsafe formatted/concatenated command string used in Runtime call " +
  "that may lead to command injection if user-controlled", source, sink,
  "User input reaches dangerous Runtime call here"
