Rule Content:
/**
 * @name Command injection from formatted runtime call
 * @description Detects command injection vulnerabilities where formatted or concatenated strings 
 *              are passed to java.lang.Runtime calls. This is dangerous if variables are 
 *              controlled by user input without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/command-injection-formatted-runtime-call
 * @tags security
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.ShellCommandExecution

class RuntimeExecCall extends DataFlow::Node {
  RuntimeExecCall() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      ma.getMethod().hasName("exec") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class RuntimeLoadLibraryCall extends DataFlow::Node {
  RuntimeLoadLibraryCall() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      ma.getMethod().hasName("loadLibrary") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class UserInputSource extends DataFlow::Node::Range {
  UserInputSource() {
    exists(RegexLiteral r |
      r.getValue().regexpMatches(".*(sh|bash|ksh|csh|tcsh|zsh).*") and
      this.asExpr() = r
    ) or
    exists(VariableAccess va | 
      va.getVariable() instanceof Parameter or
      va.getVariable() instanceof Field or
      this.asExpr() = va
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RuntimeExecCall or
    sink instanceof RuntimeLoadLibraryCall
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Literal l | node.asExpr() = l)
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(StringConcatenation sc |  
      node1.asExpr() = sc.getAnOperand() and
      node2.asExpr() = sc
    )
  }
}

from CommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potentially unsafe formatted/concatenated command string used in Runtime call " +
  "that may lead to command injection if user-controlled", source, sink,
  "User input reaches dangerous Runtime call here"
