Rule Content:
/**
 * @name Command Injection in Runtime Call
 * @description Detects when formatted or concatenated strings are used as input to Runtime.exec() or Runtime.loadLibrary() calls
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/command-injection-formatted-runtime-call
 * @tags security
 *       external/cwe/cwe-078
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class RuntimeExecCall extends MethodAccess {
  RuntimeExecCall() {
    exists(Method m | 
      m.hasName("exec") and
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      this.getMethod() = m
    )
  }
}

class RuntimeLoadLibraryCall extends MethodAccess {
  RuntimeLoadLibraryCall() {
    exists(Method m | 
      m.hasName("loadLibrary") and
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      this.getMethod() = m
    )
  }
}

class UserControlledInput extends DataFlow::Node {
  UserControlledInput() {
    // Parameters or fields that are not constants
    (exists(Parameter p | this.asParameter() = p) or
     exists(Field f | this.asField() = f)) and
    not isConstant(this.asExpr())
  }
}

class StringConcatTaintStep extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(BinaryExpr b |
      b.getOperator() = "+" and
      (b.getLeftOperand() = pred.asExpr() or b.getRightOperand() = pred.asExpr()) and
      b = succ.asExpr()
    )
    or
    exists(MethodAccess m |
      m.getMethod().hasName("format") and
      m.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      m.getAnArgument() = pred.asExpr() and
      m = succ.asExpr()
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionInRuntimeCall" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserControlledInput
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeExecCall exec | sink.asExpr() = exec.getArgument(0))
    or
    exists(RuntimeLoadLibraryCall lib | sink.asExpr() = lib.getArgument(0))
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node.asExpr().isConstant()
  }
}

from CommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential command injection: user input flows to $@ via string concatenation/formatting",
  source.getNode(), "user input",
  sink.getNode(), "Runtime call"
