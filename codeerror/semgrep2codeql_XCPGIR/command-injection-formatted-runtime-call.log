Rule Content:
/**
 * @name Command Injection in Formatted Runtime Call
 * @description Detects when formatted or concatenated strings are used as input 
 *              to Runtime.exec() or Runtime.loadLibrary() calls, which could lead
 *              to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-formatted-runtime-call
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-078
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 * @precision high
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.SecurityHelpers
import semmle.code.java.StringFormat
import semmle.code.java.dataflow.TaintTracking

class RuntimeExecMethod extends Method {
  RuntimeExecMethod() {
    this.hasName("exec") and
    this.getDeclaringType().hasQualifiedName("java.lang", "Runtime")
  }
}

class RuntimeLoadLibraryMethod extends Method {
  RuntimeLoadLibraryMethod() {
    this.hasName("loadLibrary") and
    this.getDeclaringType().hasQualifiedName("java.lang", "Runtime")
  }
}

class UserControlledInput extends DataFlow::Node {
  UserControlledInput() {
    exists(Parameter p | this.asParameter() = p) or
    exists(Field f | this.asField() = f)
  }
}

class StringConcatTaintStep extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(BinaryExpr binExpr |
      binExpr.getOp() instanceof Plus and
      (binExpr.getLeftOperand() = pred.asExpr() or binExpr.getRightOperand() = pred.asExpr()) and
      binExpr = succ.asExpr()
    )
    or
    exists(MethodAccess formatCall |
      formatCall.getMethod().hasName("format") and
      formatCall.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      exists(formatCall.getAnArgument() as pred.asExpr()) and
      formatCall = succ.asExpr()
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserControlledInput and
    not exists(source.asExpr().(Literal))
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeExecMethod exec |
      sink.asExpr() = exec.getACall().getArgument(0)
    )
    or
    exists(RuntimeLoadLibraryMethod lib |
      sink.asExpr() = lib.getACall().getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node.asExpr() instanceof Literal
  }
}

from CommandInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Potential command injection: User input flows to $@ via string concatenation/formatting.",
  source.getNode(), "user input",
  sink.getNode(), "Runtime call"
