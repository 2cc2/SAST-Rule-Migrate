Rule Content:
/**
 * @name Command injection from formatted runtime call
 * @description Detects command injection vulnerabilities where formatted or concatenated strings
 *              are passed to java.lang.Runtime calls. This is dangerous if variables are
 *              controlled by user input without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/command-injection-formatted-runtime-call
 * @tags security
 * @security-severity 9.8
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class RuntimeExecution extends DataFlow::Node {
  RuntimeExecution() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      (ma.getMethod().hasName("exec") or ma.getMethod().hasName("loadLibrary")) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class ShellCommandSource extends DataFlow::Node {
  ShellCommandSource() {
    exists(RegexLiteral r | 
      r.getValue().regexpMatch("^/(sh|bash|ksh|csh|tcsh|zsh)/") and
      this.asExpr() = r
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%input%") and
      this.asExpr() = ma
    )
  }
}

class StringOperation extends DataFlow::Node {
  StringOperation() {
    exists(StringFormatOperation sfo | this.asExpr() = sfo)
    or
    exists(AddExpr ae | this.asExpr() = ae and ae.getRightOperand().getType() instanceof TypeString)
  }
}

class CommandInjectionConfiguration extends TaintTracking::Configuration {
  CommandInjectionConfiguration() { 
    this = "Command Injection Configuration" 
  }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof ShellCommandSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RuntimeExecution
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal l | sanitizer.asExpr() = l)
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(StringOperation so |
      (node1.asExpr() = so.asExpr().getAnOperand() and node2.asExpr() = so.asExpr()) or
      exists(Parameter p | node1.asExpr() = p.getAnAccess() and node2.asExpr() = p.getAnAccess())
    )
  }
}

from CommandInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potentially unsafe formatted/concatenated command string used in Runtime call " +
  "that may lead to command injection if user-controlled", source, sink,
  "User input reaches dangerous Runtime call here"
