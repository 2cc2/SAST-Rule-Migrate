rule:
  id: command-injection-formatted-runtime-call
  kind: taint
  severity: ERROR
  message: "A formatted or concatenated string was detected as input to a java.lang.Runtime call. This is dangerous if a variable is controlled by user input and could result in a command injection. Ensure your variables are not controlled by users or sufficiently sanitized."

scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: USER_INPUT
    match:
      node: LITERAL | CALL
      where:
        - op: regex
          left: value
          right: "^=~/(sh|bash|ksh|csh|tcsh|zsh)/"

sinks:
  - id: RUNTIME_EXEC
    match:
      node: CALL
      api: { type: java.lang.Runtime, method: exec }
      arg_index: 0
  - id: RUNTIME_LOADLIB
    match:
      node: CALL
      api: { type: java.lang.Runtime, method: loadLibrary }
      arg_index: 0

propagations:
  - id: ARG_PARAM
    edge: arg->param
    kind: taint
  - id: STRING_CONCAT
    edge: arg->arg
    kind: taint

sanitizers:
  - id: CONSTANT_STRING
    match: { node: LITERAL }
    effect: neutralize

barriers:
  - id: RETURN_STOP
    match: { node: RETURN }
    effect: stop

flows:
  - source: USER_INPUT
    sink: RUNTIME_EXEC
    through: [ARG_PARAM*, STRING_CONCAT*]
    constraints:
      path:
        must:
          - { pattern: "CALL(java.lang.Runtime.exec)" }
        must_not:
          - { pattern: "LITERAL(value=\"...\")" }
  
  - source: USER_INPUT
    sink: RUNTIME_LOADLIB
    through: [ARG_PARAM*, STRING_CONCAT*]
    constraints:
      path:
        must:
          - { pattern: "CALL(java.lang.Runtime.loadLibrary)" }
        must_not:
          - { pattern: "LITERAL(value=\"...\")" }

report:
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "Runtime.getRuntime().exec(\"/bin/sh -c \" + userInput);"
    - "Runtime.getRuntime().exec(String.format(\"/bin/%s -c %s\", shell, command));"
  negative:
    - "Runtime.getRuntime().exec(\"/usr/bin/safe_command\");"
    - "Runtime.getRuntime().exec(new String[]{\"/bin/mv\", \"file1\", \"file2\"});"
```
