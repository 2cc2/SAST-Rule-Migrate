      path:
        must_not: [ { pattern: "LITERAL" } ]
  - source: USER_INPUT
    sink: RUNTIME_LOADLIB
    through: [STRING_CONCAT*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL" } ]

report:
  locations: ["source", "sink"]
  evidence:
    capture:
      - argument: 0
      - operator: "+ | String.format"

tests:
  positive:
    - "Runtime.getRuntime().exec(input + \"ls\");"
    - "Runtime.getRuntime().loadLibrary(String.format(\"%s\", libName));"
  negative:
    - "Runtime.getRuntime().exec(\"fixed_command\");"
    - "Runtime.getRuntime().loadLibrary(\"safe_lib\");"
