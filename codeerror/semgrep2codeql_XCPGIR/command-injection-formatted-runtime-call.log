Rule Content:
/**
 * @name Command Injection in Runtime Call
 * @description Detects when formatted or concatenated strings are used as input to Runtime.exec() or Runtime.loadLibrary() calls.
 * @kind taint
 * @problem.severity error
 * @id java/command-injection-formatted-runtime-call
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-078
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class RuntimeExecCall extends MethodAccess {
  RuntimeExecCall() {
    this.getMethod().hasName("exec") and
    this.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime")
  }
}

class RuntimeLoadLibraryCall extends MethodAccess {
  RuntimeLoadLibraryCall() {
    this.getMethod().hasName("loadLibrary") and
    this.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime")
  }
}

class UserControlledInput extends TaintSource::Range {
  UserControlledInput() {
    exists(PrimaryExpr e |
      e = this.asExpr() and
      not e.isConstant()
    )
  }
}

class StringConcatOperation extends TaintAdditionalTaintStep::Range {
  StringConcatOperation() {
    exists(BinaryExpr b |
      b.getOp() in ["+"] and
      this.asExpr() = b
    )
    or
    exists(MethodAccess m |
      m.getMethod().getName() = "format" and
      m.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = m
    )
  }

  override predicate step(DataFlow::Node n1, DataFlow::Node n2) {
    exists(Expr e |
      (e = n1.asExpr() and e = this.asExpr()) or
      (e = n2.asExpr() and e = this.asExpr())
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "CommandInjectionInRuntimeCall" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof UserControlledInput
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeExecCall exec |
      sink.asExpr() = exec.getArgument(0)
    )
    or
    exists(RuntimeLoadLibraryCall lib |
      sink.asExpr() = lib.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr().isConstant()
  }

  override predicate isAdditionalTaintStep(DataFlow::Node n1, DataFlow::Node n2) {
    exists(StringConcatOperation concat |
      concat.step(n1, n2)
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potentially unsafe command execution. User input flows " +
  "to Runtime.exec() or Runtime.loadLibrary() call via string concatenation or format operation."
