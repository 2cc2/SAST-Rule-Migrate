Rule Content:
/**
 * @kind problem
 * @id no-string-eqeq
 * @severity warning
 * @tags correctness
 * @help-url https://stackoverflow.com/questions/513832/how-do-i-compare-strings-in-java
 */

import java
import semmle.code.java.dataflow.FlowSources

class StringCompareByRef extends DataFlow::Configuration {
  StringCompareByRef() { this = "StringCompareByRef" }

  override predicate isSource(DataFlow::Node source) {
    exists(BinaryExpr be |
      be.getOperator() = BinaryOperator.EQ and
      be.getLeftOperand().getType().(RefType).hasQualifiedName("java.lang", "String") and
      be.getRightOperand().getType().(RefType).hasQualifiedName("java.lang", "String") and
      source.asExpr() = be
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(BinaryExpr be |
      be.getOperator() = BinaryOperator.EQ and
      sink.asExpr() = be
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, StringCompareByRef cfg
where cfg.hasFlow(source, sink)
select sink, 
  "Strings should not be compared with '=='. This is a reference comparison operator. Use '.equals()' instead."
