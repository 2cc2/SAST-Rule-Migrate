/**
 * @name OGNL Injection
 * @description Detects potential OGNL injection vulnerabilities when expressions are built with dynamic values
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision high
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class OgnlInput extends TaintTracking::Source {
  OgnlInput() {
    exists(Method m, Parameter p |
      m.getAParameter() = p and
      not p.getAnAccess().getArgument().toString().regexpMatch("\".*\"")
    )
    or
    exists(LocalVariableDecl lvd |
      exists(lvd.getAnAccess()) and
      not lvd.getAnAccess().getArgument().toString().regexpMatch("\".*\"")
    )
  }
}

class OgnlSink extends DataFlow::Node {
  OgnlSink() {
    // OgnlReflectionProvider/ReflectionProvider methods
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("", "OgnlReflectionProvider") or
       ma.getMethod().getDeclaringType().hasQualifiedName("", "ReflectionProvider")) and
      ma.getMethod().getName().matches("getGetMethod|getSetMethod|getField|setProperties|setProperty|getValue|setValue") and
      this.asExpr() = ma.getAnArgument()
    )
    or
    // TextParseUtil methods
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("", "TextParseUtil") and
      ma.getMethod().getName().matches("translateVariables|translateVariablesCollection|shallBeIncluded|commaDelimitedStringToSet") and
      this.asExpr() = ma.getAnArgument()
    )
    or
    // TextParser/OgnlTextParser methods
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("", "TextParser") or
       ma.getMethod().getDeclaringType().hasQualifiedName("", "OgnlTextParser")) and
      ma.getMethod().getName() = "evaluate" and
      this.asExpr() = ma.getAnArgument()
    )
    or
    // OgnlUtil methods
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("", "OgnlUtil") and
      ma.getMethod().getName().matches("setProperties|setProperty|getValue|setValue|callMethod|compile") and
      this.asExpr() = ma.getAnArgument()
    )
    or
    // StrutsUtil/VelocityStrutsUtil methods
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("", "StrutsUtil") or
       ma.getMethod().getDeclaringType().hasQualifiedName("", "VelocityStrutsUtil")) and
      ma.getMethod().getName().matches("evaluate|isTrue|findString|findValue|getText|translateVariables|makeSelectList") and
      this.asExpr() = ma.getAnArgument()
    )
    or
    // ValueStack methods
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("", "ValueStack") and
      ma.getMethod().getName().matches("findString|findValue|setValue|setParameter") and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

class OgnlTaintTrackingConfig extends TaintTracking::Configuration {
  OgnlTaintTrackingConfig() { this = "OgnlTaintTrackingConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof OgnlInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof OgnlSink }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral sl | node.asExpr() = sl)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, OgnlTaintTrackingConfig config
where config.hasFlowPath(source, sink)
select sink, "Potential OGNL injection vulnerability detected", source, sink,
  "Untrusted user input flows into OGNL evaluation"
