/**
 * @name OGNL Injection
 * @description Detects potential OGNL injection vulnerabilities when expressions are built with dynamic values
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision high
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class OgnlInput extends RemoteFlowSource {
  OgnlInput() {
    exists(Parameter p | p = this.asParameter()) and
    not exists(p.getValue().toStringLiteral())
    or
    exists(LocalVariable l | l = this.asLocalVariable()) and
    not exists(l.getInitializer().toStringLiteral())
  }
}

class OgnlSink extends MethodAccess {
  OgnlSink() {
    // OgnlReflectionProvider/ReflectionProvider methods
    (this.getCallee().getDeclaringType().hasQualifiedName("", "OgnlReflectionProvider") or
     this.getCallee().getDeclaringType().hasQualifiedName("", "ReflectionProvider")) and
    this.getCallee().getName().matches("getGetMethod|getSetMethod|getField|setProperties|setProperty|getValue|setValue")
    or
    // TextParseUtil methods
    this.getCallee().getDeclaringType().hasQualifiedName("", "TextParseUtil") and
    this.getCallee().getName().matches("translateVariables|translateVariablesCollection|shallBeIncluded|commaDelimitedStringToSet")
    or
    // TextParser/OgnlTextParser methods
    (this.getCallee().getDeclaringType().hasQualifiedName("", "TextParser") or
     this.getCallee().getDeclaringType().hasQualifiedName("", "OgnlTextParser")) and
    this.getCallee().getName() = "evaluate"
    or
    // OgnlUtil methods
    this.getCallee().getDeclaringType().hasQualifiedName("", "OgnlUtil") and
    this.getCallee().getName().matches("setProperties|setProperty|getValue|setValue|callMethod|compile")
    or
    // StrutsUtil/VelocityStrutsUtil methods
    (this.getCallee().getDeclaringType().hasQualifiedName("", "StrutsUtil") or
     this.getCallee().getDeclaringType().hasQualifiedName("", "VelocityStrutsUtil")) and
    this.getCallee().getName().matches("evaluate|isTrue|findString|findValue|getText|translateVariables|makeSelectList")
    or
    // ValueStack methods
    this.getCallee().getDeclaringType().hasQualifiedName("", "ValueStack") and
    this.getCallee().getName().matches("findString|findValue|setValue|setParameter")
  }
}

class OgnlTaintTrackingConfig extends TaintTracking::Configuration {
  OgnlTaintTrackingConfig() { this = "OgnlTaintTrackingConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof OgnlInput }

  override predicate isSink(DataFlow::Node sink) {
    exists(OgnlSink ognlSink | sink.asExpr() = ognlSink.getAnArgument())
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node.getType() instanceof StringType and
    exists(StringLiteral sl | node.asExpr() = sl)
  }
}

from OgnlTaintTrackingConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential OGNL injection vulnerability detected", source, sink,
  "Untrusted user input flows into OGNL evaluation"
