        ma.getMethod().getName().matches("setProperties|setProperty|getValue|setValue|callMethod|compile") or
        // StrutsUtil/VelocityStrutsUtil methods
        (ma.getMethod().getDeclaringType().hasQualifiedName("", "StrutsUtil") or
         ma.getMethod().getDeclaringType().hasQualifiedName("", "VelocityStrutsUtil")) and
        ma.getMethod().getName().matches("evaluate|isTrue|findString|findValue|getText|translateVariables|makeSelectList") or
        // ValueStack methods
        ma.getMethod().getDeclaringType().hasQualifiedName("", "ValueStack") and
        ma.getMethod().getName().matches("findString|findValue|setValue|setParameter")
      ) and
      arg = ma.getAnArgument() and
      this.asExpr() = arg
    )
  }
}

class OgnlTaintTrackingConfig extends TaintTracking::Configuration {
  OgnlTaintTrackingConfig() { this = "OgnlTaintTrackingConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof OgnlInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof OgnlSink }

  override predicate isSanitizer(DataFlow::Node node) {
    node.asExpr() instanceof StringLiteral
  }
}

