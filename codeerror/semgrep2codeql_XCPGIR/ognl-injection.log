        m.getDeclaringType().hasQualifiedName("ognl", "OgnlUtil") or
        m.getDeclaringType().hasQualifiedName("ognl", "VelocityStrutsUtil") or
        m.getDeclaringType().hasQualifiedName("ognl", "StrutsUtil") or
        m.getDeclaringType().hasQualifiedName("ognl", "OgnlTool") or
        m.getDeclaringType().hasQualifiedName("ognl", "ValueStack")
      ) and
      m.hasName([
        "getGetMethod", "getSetMethod", "getField", "setProperties", "setProperty",
        "getValue", "setValue", "translateVariables", "translateVariablesCollection",
