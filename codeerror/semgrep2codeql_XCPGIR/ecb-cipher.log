Rule Content:
/**
 * @name ECB Cipher Vulnerability
 * @description Detects usage of cipher in ECB mode which is insecure.
 * @kind problem
 * @id java/ecb-cipher
 * @severity Warning
 * @tags security
 *       crypto
 */

import java

predicate isECBCipher(MethodAccess cipherGetInstance) {
  exists(string algorithmName |
    cipherGetInstance.getMethod().hasQualifiedName("javax.crypto.Cipher", "getInstance") and
    algorithmName = cipherGetInstance.getArgument(0).(Literal).getValue() and
    algorithmName.regexpMatches(".*ECB.*")
  )
}

from MethodAccess cipherGetInstance
where isECBCipher(cipherGetInstance)
select cipherGetInstance, "Cipher in ECB mode is detected. ECB mode produces the same output for the same input each time which allows an attacker to intercept and replay the data. Further, ECB mode does not provide any integrity checking."
