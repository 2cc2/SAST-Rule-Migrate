where config.hasFlow(source, sink) and
      not exists(FilenameUtilsSanitizer fus |
        DataFlow::flowPath(source, fus, sink)
      )
select sink, 
  "Potential path traversal from JAX-RS @PathParam to File constructor. $@",
  source, "User input from here",
  sink, "File operation here"
