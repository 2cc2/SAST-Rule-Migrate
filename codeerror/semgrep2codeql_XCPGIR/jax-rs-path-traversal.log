Rule Content:
/**
 * @name JAX-RS Path Traversal
 * @description Detected a potential path traversal. A malicious actor could control the location 
 * of this file, to include going backwards in the directory with '../'. 
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/jax-rs-path-traversal
 * @tags security
 *       external/cwe/cwe-22
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.security.PathTraversal

class JaxRsPathParamSource extends RemoteFlowSource {
  JaxRsPathParamSource() {
    exists(MethodParameter p |
      p.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "PathParam") and
      this.asParameter() = p
    )
  }
}

class PathTraversalSink extends DataFlow::Node {
  PathTraversalSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.io", "File") and
      this.asExpr() = cc.getAnArgument()
    )
  }
}

class FilenameUtilsSanitizer extends DataFlow::Node {
  FilenameUtilsSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.apache.commons.io", "FilenameUtils", "getName") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

predicate isTaintedPath(DataFlow::Node source, DataFlow::Node sink) {
  exists(DataFlow::PathNode src, DataFlow::PathNode snk |
    src.getNode() = source and
    snk.getNode() = sink and
    taintTracking(src, snk).getAPath() and
    not exists(DataFlow::PathNode sanitizedNode |
      sanitizedNode.getNode().(FilenameUtilsSanitizer) and
      taintTracking(src, sanitizedNode).getAPath()
    )
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  isTaintedPath(source.getNode(), sink.getNode()) and
  source.getNode() instanceof JaxRsPathParamSource and
  sink.getNode() instanceof PathTraversalSink
select sink, "Potential path traversal vulnerability from JAX-RS PathParam parameter", source,
  "User-controlled path parameter flows to File constructor"
