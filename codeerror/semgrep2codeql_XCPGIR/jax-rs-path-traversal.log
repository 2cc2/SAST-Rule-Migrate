Rule Content:
/**
 * @name JAX-RS Path Traversal
 * @description Detected a potential path traversal. A malicious actor could control the location 
 *              of this file, to include going backwards in the directory with '../'. To address 
 *              this, ensure that user-controlled variables in file paths are sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jax-rs-path-traversal
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jaxrs.JaxRs

class PathParamSource extends MethodAccess {
  PathParamSource() {
    exists(JaxRsPathParamAnnotation anno |
      this.getMethod().getAParameter() = anno.getAnnotatedElement()
    )
  }
}

class FileSink extends MethodAccess {
  FileSink() {
    this.getMethod().getName() = "<init>" and
    this.getMethod().getDeclaringType().hasQualifiedName("java.io", "File") and
    this.getArgument(0).getType() instanceof TypeString
  }
}

class FilenameUtilsSanitizer extends MethodAccess {
  FilenameUtilsSanitizer() {
    this.getMethod().getName() = "getName" and
    this.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils")
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "JAX-RS Path Traversal" }

  override predicate isSource(DataFlow::Node source) {
    exists(PathParamSource ps |
      source.asExpr() = ps.getMethod().getAParameter()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(FileSink fs | sink.asExpr() = fs.getArgument(0))
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(FilenameUtilsSanitizer fus | node.asExpr() = fus)
  }

  override predicate isBarrier(DataFlow::Node node) {
    exists(ReturnStmt ret | node.asExpr() = ret)
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential path traversal from JAX-RS @PathParam to File constructor. $@",
  source.getNode(), "User input from here",
  sink.getNode(), "File operation here"
