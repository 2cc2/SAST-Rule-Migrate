/**
 * @name JAX-RS Path Traversal
 * @description Detected a potential path traversal. A malicious actor
 * could control the location of this file, to include going backwards
 * in the directory with '../'. To address this, ensure that user-controlled
 * variables in file paths are sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id jax-rs-path-traversal
 * @tags security
 *       external/cwe/cwe-22
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class JaxRsPathParamSource extends DataFlow::Node {
  JaxRsPathParamSource() {
    exists(Parameter p |
      p.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "PathParam") and
      this.asParameter() = p
    )
  }
}

class FileConstructorSink extends DataFlow::Node {
  FileConstructorSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.io", "File") and
      this.asExpr() = cc.getAnArgument()
    )
  }
}

class FilenameUtilsSanitizer extends TaintTracking::AdditionalTaintStep {
  FilenameUtilsSanitizer() {
    exists(Call call |
      call.getCalledMethod().hasQualifiedName("org.apache.commons.io", "FilenameUtils", "getName") and
      this = call.getArgument(0)
    )
  }

  override predicate isSanitizing(DataFlow::Node node) {
    this.asExpr() = node.asExpr()
  }
}

class JaxRsPathTraversalConfig extends TaintTracking::Configuration {
  JaxRsPathTraversalConfig() { this = "JaxRsPathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof JaxRsPathParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileConstructorSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.(FilenameUtilsSanitizer).getANode()
  }
}

from DataFlow::Node source, DataFlow::Node sink, JaxRsPathTraversalConfig config
where
  config.hasFlow(source, sink)
select sink, "Potential path traversal vulnerability from JAX-RS PathParam parameter", source,
  "User-controlled path parameter flows to File constructor without sanitization"
