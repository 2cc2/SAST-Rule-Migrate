Rule Content:
/**
 * @name JAX-RS Path Traversal
 * @description Detected a potential path traversal vulnerability where a malicious actor 
 * could control file paths via PathParam values. Ensure user-controlled variables 
 * in file paths are sanitized using methods like FilenameUtils.getName().
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/jax-rs-path-traversal
 * @tags security
 *       external/cwe/cwe-22
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class JaxRsPathParamSource extends DataFlow::Node {
  JaxRsPathParamSource() {
    exists(Method m, Parameter p |
      p.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "PathParam") and
      this.asParameter() = p
    )
  }
}

class FileConstructorSink extends DataFlow::Node {
  FileConstructorSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.io", "File") and
      this.asExpr() = cc.getAnArgument()
    )
  }
}

class FilenameUtilsSanitizer extends DataFlow::BarrierGuard {
  FilenameUtilsSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.apache.commons.io", "FilenameUtils", "getName") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class JaxRsPathTraversalConfig extends TaintTracking::Configuration {
  JaxRsPathTraversalConfig() { this = "JaxRsPathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof JaxRsPathParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileConstructorSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FilenameUtilsSanitizer
  }
}

from DataFlow::Node source, DataFlow::Node sink, JaxRsPathTraversalConfig config
where
  config.hasFlow(source, sink)
select sink, "Potential path traversal vulnerability from JAX-RS PathParam parameter", source,
  "User-controlled path parameter flows to File constructor without sanitization"
