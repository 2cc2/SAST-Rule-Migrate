/**
 * @name JAX-RS Path Traversal
 * @description Detected a potential path traversal. A malicious actor could control the location 
 *              of this file, to include going backwards in the directory with '../'. To address 
 *              this, ensure that user-controlled variables in file paths are sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jax-rs-path-traversal
 */
import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jaxrs.JaxRs

class PathParamSource extends DataFlow::Node {
  PathParamSource() {
    exists(Parameter p | 
      p.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "PathParam") and
      this.asParameter() = p
    )
  }
}

class FileSink extends DataFlow::Node {
  FileSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.io", "File") and
      this.asExpr() = cc.getArgument(0)
    )
  }
}

class FilenameUtilsSanitizer extends DataFlow::Node {
  FilenameUtilsSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.apache.commons.io", "FilenameUtils", "getName") and
      this.asExpr() = ma
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "JAX-RS Path Traversal" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof PathParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof FilenameUtilsSanitizer
  }

  override predicate isAlternativeSanitizer(DataFlow::Node node) {
    exists(FilenameUtilsSanitizer fus | fus = node)
  }
}

