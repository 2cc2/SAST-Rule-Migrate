/**
 * @id spring-csrf-disabled
 * @name CSRF Protection Disabled
 * @description CSRF protection is disabled for this configuration. This is a security risk.
 * @kind problem
 * @severity warning
 * @tags security
 */

import java
import semmle.code.java.frameworks.spring.Spring

class CSRFDisabled extends MethodCall {
  CSRFDisabled() {
    this.getTarget().getName() = "disable" and
    this.getTarget().getDeclaringType*().getQualifiedName().matches("%.csrf.%")
  }
}

from CSRFDisabled csrf
select csrf, "CSRF protection is disabled for this configuration. This is a security risk."
