Rule Content:
/**
 * @name JWT decode without verify
 * @description Detected the decoding of a JWT token without a verify step. JWT tokens must be verified
 *              before use, otherwise the token's integrity is unknown.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @id java/jwt-decode-without-verify
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.JWT

class JWTDecodeWithoutVerifyConfig extends TaintTracking::Configuration {
  JWTDecodeWithoutVerifyConfig() { this = "JWTDecodeWithoutVerifyConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "decode" and
      ma.getMethod().getDeclaringType().hasQualifiedName("com.auth0.jwt", "JWT") and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("com.auth0.jwt", "JWT") and
      sink.asExpr() = ma
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "verify" and
      node.asExpr() = ma
    )
  }
}

from JWTDecodeWithoutVerifyConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "JWT tokens must be verified before use, otherwise the token's integrity is unknown. " +
  "Call '.verify()' before using the token.", source.getNode(), "JWT decode without verify"
