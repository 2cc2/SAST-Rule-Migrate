/**
 * @name Use of MD5 DigestUtils
 * @description Detected MD5 hash algorithm which is considered insecure. MD5 is not collision resistant 
 * and is therefore not suitable as a cryptographic signature. Use HMAC instead.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-md5-digest-utils
 * @tags security
 *       correctness
 */

import java

predicate isMd5DigestUtilsCall(MethodAccess ma) {
  ma.getMethod().getName() = "digest" and
  ma.getQualifier().getType().hasName("DigestUtils") and
  ma.getQualifier().getCompileTimeType().getASourceSupertype*().hasQualifiedName("org.apache.commons.codec.digest", "DigestUtils") and
  ma.getMethodCallInfo().getArgument(0).(MethodAccess).getMethod().getName() = "getMd5Digest"
}

from MethodAccess ma
where isMd5DigestUtilsCall(ma)
select ma, "Detected MD5 hash algorithm which is considered insecure. MD5 is not collision resistant and is therefore not suitable as a cryptographic signature. Use HMAC instead."
