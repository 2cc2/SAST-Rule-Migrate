Rule Content:
/**
 * @id documentbuilderfactory-disallow-doctype-decl-false
 * @name DocumentBuilderFactory XML External Entity Vulnerability
 * @description Detects when DocumentBuilderFactory allows DOCTYPE declarations without proper XXE protections
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.security.XMLParsers

class DocumentBuilderFactoryXXE extends DataFlow::Configuration {
  DocumentBuilderFactoryXXE() { this = "DocumentBuilderFactoryXXE" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess call |
      call.getMethod().getName() = "setFeature" and
      call.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
      source.asExpr() = call.getArgument(0) and
      call.getArgument(1).(StringLiteral).getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
      call.getArgument(2).(BooleanLiteral).getValue() = false
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess call |
      call.getMethod().getName() = "setFeature" and
      call.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
      sanitizer.asExpr() = call.getArgument(0) and
      regexpMatch("http://xml.org/sax/features/external-(general|parameter)-entities", 
        call.getArgument(1).(StringLiteral).getValue()) and
      call.getArgument(2).(BooleanLiteral).getValue() = false
    )
    or
    exists(MethodAccess call |
      call.getMethod().getName() = "setAttribute" and
      call.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
      sanitizer.asExpr() = call.getArgument(0) and
      call.getArgument(1).(StringLiteral).getValue() = "javax.xml.XMLConstants.ACCESS_EXTERNAL_DTD" and
      call.getArgument(2).(StringLiteral).getValue() = ""
    )
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier.getParent() instanceof ReturnStmt
  }
}

from DocumentBuilderFactoryXXE config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode().getEnclosingCallable(), source, sink, 
  "Vulnerable XML configuration allowing XXE attacks detected. " +
  "Disable DOCTYPE declarations or properly configure protections against external entities."
