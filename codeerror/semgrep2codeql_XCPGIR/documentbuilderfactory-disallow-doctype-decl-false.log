/**
 * @name DocumentBuilderFactory disallow-doctype-decl false
 * @description DOCTYPE declarations are enabled for XML processor. Without prohibiting external entity declarations,
 *              this is vulnerable to XML external entity attacks.
 * @kind path-problem
 * @problem.severity error
 * @id java/documentbuilderfactory-disallow-doctype-decl-false
 */

import java
import semmle.code.java.security.XMLInjection
import DataFlow::PathGraph

class UnsafeDBFConfig extends DataFlow::Node {
  UnsafeDBFConfig() {
    exists(Method m, MethodAccess ma |
      m.hasName("setFeature") and
      ma.getMethod() = m and
      ma.getArgument(0).toString() = "\"http://apache.org/xml/features/disallow-doctype-decl\"" and
      ma.getArgument(1).toString() = "\"false\"" and
      this.asExpr() = ma
    )
  }
}

class EntitySanitizer extends DataFlow::Node {
  EntitySanitizer() {
    exists(Method m, MethodAccess ma |
      m.hasName("setFeature") and
      ma.getMethod() = m and
      (
        ma.getArgument(0).toString() = "\"http://xml.org/sax/features/external-general-entities\"" or
        ma.getArgument(0).toString() = "\"http://xml.org/sax/features/external-parameter-entities\""
      ) and
      ma.getArgument(1).toString() = "\"false\"" and
      this.asExpr() = ma
    )
  }
}

class ConfigFlowConfiguration extends TaintTracking::Configuration {
  ConfigFlowConfiguration() { this = "UnsafeXMLProcessorConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeDBFConfig
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof EntitySanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // AST propagation within method scope
    succ.asExpr().getParent*() = pred.asExpr()
  }
}

from ConfigFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlow(source, sink) and
      not exists(EntitySanitizer sanitizer |
        cfg.hasFlow(source, sanitizer.getNode())
      )
select sink, "Vulnerable XML processor configuration detected", source, sink,
  "Unsafe DocumentBuilderFactory configuration: $@", source.getNode(), "source here"
