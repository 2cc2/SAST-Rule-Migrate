/**
 * @id documentbuilderfactory-disallow-doctype-decl-false
 * @name DocumentBuilderFactory XML External Entity Vulnerability
 * @description Detects when DocumentBuilderFactory allows DOCTYPE declarations without proper XXE protections
 * @kind path-problem
 * @problem.severity error
 */
import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat

class DocumentBuilderFactoryXXE extends TaintTracking::Configuration {
  DocumentBuilderFactoryXXE() { this = "DocumentBuilderFactoryXXE" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, MethodAccess call |
      m.hasName("setFeature") and
      m.getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
      call.getMethod() = m and
      source.asExpr() = call.getArgument(0) and
      call.getArgument(1).(StringLiteral).getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
      call.getArgument(2).(BooleanLiteral).getValue() = false
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Method m, MethodAccess call |
      m.hasName("setFeature") and
      m.getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
      call.getMethod() = m and
      sanitizer.asExpr() = call.getArgument(0) and
      (
        call.getArgument(1).(StringLiteral).getValue().matches("http://xml.org/sax/features/external-general-entities") or
        call.getArgument(1).(StringLiteral).getValue().matches("http://xml.org/sax/features/external-parameter-entities")
      ) and
      call.getArgument(2).(BooleanLiteral).getValue() = false
    )
    or
    exists(Method m, MethodAccess call |
      m.hasName("setAttribute") and
      m.getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
      call.getMethod() = m and
      sanitizer.asExpr() = call.getArgument(0) and
      call.getArgument(1).(StringLiteral).getValue() = "javax.xml.XMLConstants.ACCESS_EXTERNAL_DTD" and
      call.getArgument(2).(StringLiteral).getValue() = ""
    )
  }

  override predicate isBarrier(DataFlow::Node node) {
    exists(ReturnStmt ret | node.asExpr() = ret.getExpr())
  }
}

