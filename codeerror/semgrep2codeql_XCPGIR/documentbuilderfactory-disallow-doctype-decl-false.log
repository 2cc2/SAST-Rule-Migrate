Rule Content:
/**
 * @name DocumentBuilderFactory disallow-doctype-decl false
 * @description DOCTYPE declarations are enabled for XML processor. Without prohibiting 
 *              external entity declarations, this is vulnerable to XML external entity attacks.
 * @kind path-problem
 * @problem.severity error
 * @id java/documentbuilderfactory-disallow-doctype-decl-false
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class UnsafeDBFConfig extends DataFlow::Node {
  UnsafeDBFConfig() {
    exists(Method m, Call c |
      m.hasName("setFeature") and
      c.getCallee() = m and
      c.getArgument(0).toString() = "\"http://apache.org/xml/features/disallow-doctype-decl\"" and
      c.getArgument(1).toString() = "\"false\"" and
      this.asExpr() = c
    )
  }
}

class EntitySanitizer extends DataFlow::Node {
  EntitySanitizer() {
    exists(Method m, Call c |
      m.hasName("setFeature") and
      c.getCallee() = m and
      (
        c.getArgument(0).toString() = "\"http://xml.org/sax/features/external-general-entities\"" or
        c.getArgument(0).toString() = "\"http://xml.org/sax/features/external-parameter-entities\""
      ) and
      c.getArgument(1).toString() = "\"false\"" and
      this.asExpr() = c
    )
  }
}

class ConfigFlowConfiguration extends TaintTracking::Configuration {
  ConfigFlowConfiguration() { this = "UnsafeXMLProcessorConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeDBFConfig
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof EntitySanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // AST propagation within method scope
    any(Method method).getABodyInScope() and
    succ.asExpr().getParent*() = pred.asExpr()
  }
}

from ConfigFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlow(source, sink)
select sink, "Vulnerable XML processor configuration detected", 
  source, sink, "Unsafe DocumentBuilderFactory configuration"
