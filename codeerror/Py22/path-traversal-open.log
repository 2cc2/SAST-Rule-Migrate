Rule Content:
/**
 * @name Path Traversal via open() with Request Data
 * @description Detects when request data flows into open() calls without validation,
 *              which could lead to path traversal attacks.
 * @kind path-problem
 * @severity error
 * @problem.severity error
 * @precision high
 * @id python/path-traversal-open
 */

import python
import semmle.python.security.TaintTracking as TaintTracking
import semmle.python.web.flask.Request as FlaskRequest
import semmle.python.Concepts as Concepts

class RouteVarSource extends TaintTracking::Source {
  RouteVarSource() {
    exists(string varName |
      varName.regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this.asParameter().getName() = varName
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    source.asParameter() = any(RouteVarSource r | r.asParameter())
  }
}

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() {
    exists(FlaskRequest::RequestFieldAccess field |
      field.getMethodName().matches("%get%") or
      field.getMethodName().matches("%[]%") and
      this.asExpr().(FlaskRequest::RequestFieldAccess) = field
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    source.asExpr() = any(FlaskRequestSource f | f.asExpr())
  }
}

class FileOpenSink extends TaintTracking::Sink {
  FileOpenSink() {
    exists(Call call |
      call.getFunc().(Name).getId() = "open" and
      call.getFunc().getEnclosingScope().isRoot() and
      this.asExpr() = call.getArg(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(FileOpenSink f | f.asExpr() = sink.asExpr())
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteVarSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    // No sanitizers in this rule
    none()
  }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is " +
  "validated or sanitized, otherwise it could result in path traversal attacks."
