/**
 * @name Path traversal in open() call
 * @desc Found request data in a call to 'open'. Ensure the request data is validated.
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.web.Flask
import semmle.python.Concepts
import DataFlow::PathGraph
import DataFlow
import TaintTracking

class RouteVariableSource extends DataFlow::Node {
  RouteVariableSource() {
    exists(string name |
      name.regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this = DataFlow::parameterNode(_, name)
    )
  }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "request" and
      ma.getQualifier().getType().getName() = "flask" and
      (
        ma.getMethod().getName() = "get" or
        ma.getMethod().getName() = "__getitem__" or
        ma.getMethod().isUnknown()
      ) and
      this = ma.getArgument(_)
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(Call call |
      call.getFunc().(Name).getId() = "open" and
      call.getFunc().getLocationInfoFile().getBaseName() = "builtins" and
      this = call.getArg(0)
    )
  }
}

class PathTraversalConfiguration extends TaintTracking::Configuration {
  PathTraversalConfiguration() { this = "PathTraversalInOpen" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteVariableSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }
}

from PathTraversalConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized."
