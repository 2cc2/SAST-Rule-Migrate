Rule Content:
/**
 * @name Path Traversal in Open Call
 * @description Detects use of request data in calls to 'open' without proper validation,
 *              which could lead to path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/path-traversal-open
 * @tags security
 *       external/cwe/cwe-22
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Flask

class RouteVariableSource extends TaintSource::Range {
  RouteVariableSource() {
    exists(ParameterNode param |
      param.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this = param.asSource()
    )
  }
}

class FlaskRequestSource extends TaintSource::Range {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getTarget().(Method).getDeclaringType().hasQualifiedName("flask", "request") and
      call.getMethodName().matches(["get", "[]", "%"]) and
      this = call.asSource()
    )
  }
}

class FileOpenSink extends TaintSink::Range {
  FileOpenSink() {
    exists(MethodCall call |
      call.getTarget().(Method).getDeclaringType().getName() = "builtins" and
      call.getMethodName() = "open" and
      this = call.getArgument(0).asSink()
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(TaintSource::Range source) {
    source instanceof RouteVariableSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(TaintSink::Range sink) {
    sink instanceof FileOpenSink
  }
}

from PathTraversalConfig config, TaintSource::Range source, TaintSink::Range sink
where config.hasFlow(source, sink)
select sink, 
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks.",
  source, sink
