/**
 * @name Path Traversal in open() call
 * @description Detects request data in calls to open() without proper validation
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id py/path-traversal-open
 */

import python
import DataFlow
import DataFlow::PathGraph
import python.web.flask.Request

class RouteVarSource extends DataFlow::SourceNode {
  RouteVarSource() {
    exists(Parameter p |
      p.hasName("$ROUTEVAR") or p.hasName("$INTERM")
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    source.asParameter().hasName("$ROUTEVAR") or
    source.asParameter().hasName("$INTERM")
  }
}

class FlaskRequestSource extends DataFlow::SourceNode {
  FlaskRequestSource() {
    exists(RequestFieldAccess req |
      req.getFieldName().matches("get") or
      req.getFieldName().matches("%") or 
      req.getFieldName().regexpMatch("\\$W")
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    source instanceof RequestFieldAccess and
    (
      source.getFieldName().matches("get") or
      source.getFieldName().matches("%") or
      source.getFieldName().regexpMatch("\\$W")
    )
  }
}

class FileOpenSink extends DataFlow::SinkNode {
  FileOpenSink() {
    exists(Call call |
      call.getFunc().getName() = "open" and
      this.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getFunc().getName() = "open" and
      sink.asExpr() = call.getArgument(0)
    )
  }
}

class PathTraversalConfig extends DataFlow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteVarSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // No sanitizers in original rule
    none()
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(), 
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
