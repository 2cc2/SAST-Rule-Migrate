Rule Content:
/**
 * @name Path traversal in open() call
 * @description Detects when request data is used unsafely in open() calls
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import dataflow
import semmle.python.Strings
import python.Security.PyRequests

class RouteVarSource extends dataflow::Source {
  RouteVarSource() {
    exists(string name, string value |
      this.asParameter().getName() = name and
      name.regexpMatches("\\$ROUTEVAR|\\$INTERM") and
      this.asExpr() = value
    )
  }

  override string getSourceType() { result = "Route variable" }
}

class FlaskRequestSource extends dataflow::Source {
  FlaskRequestSource() {
    exists(string method, string value |
      this.asExpr().(RequestFieldAccess).getTarget().toString() = "flask.request" and
      method = this.asExpr().(RequestFieldAccess).getFieldName() and
      method = ["get", "[]", "_"].getAny() and
      this.asExpr() = value
    )
  }

  override string getSourceType() { result = "Flask request data" }
}

class FileOpenSink extends dataflow::Sink {
  FileOpenSink() {
    exists(FunctionCall call |
      call.getFunc().(Name).getId() = "open" and
      this.asExpr() = call.getArg(0)
    )
  }

  override string getSinkType() { result = "open() call" }
}

class PathTraversalConfig extends dataflow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(dataflow::Source source) {
    source instanceof RouteVarSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(dataflow::Sink sink) {
    sink instanceof FileOpenSink
  }

  override predicate isSanitizer(dataflow::Sanitizer sanitizer) { none() }
}

from PathTraversalConfig cfg, dataflow::PathNode source, dataflow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks.",
  source, sink, "Unsafe path construction"
