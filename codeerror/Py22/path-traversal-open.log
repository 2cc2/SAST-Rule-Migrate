Rule Content:
/**
 * @name Path Traversal via open() with request data
 * @description Detects when request data flows to open() calls without sanitization,
 *              which could lead to path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.Flask
import DataFlow::PathGraph

class RouteVarSource extends DataFlow::Source {
  RouteVarSource() {
    exists(Parameter p |
      p.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      result = p
    )
  }
}

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(Call call, MethodAccess ma |
      ma.getAPackageName() = "flask" and
      ma.getATypeName() = "request" and
      ma.getAMethodName().matches("%") and
      call.getTarget() = ma and
      ma.getAMethodName().matches("get|\\[\\]|%") and
      result = call
    )
  }
}

class FileOpenSink extends DataFlow::Sink {
  FileOpenSink() {
    exists(Call call |
      call.getTarget().getName() = "open" and
      call.getTarget().getAPackageName() = "builtins" and
      result = call.getArgument(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof RouteVarSource or source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof FileOpenSink
  }

  override predicate isSanitizer(DataFlow::Sanitizer sanitizer) {
    none()
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
