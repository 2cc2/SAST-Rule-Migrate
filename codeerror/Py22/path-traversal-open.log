/**
 * @name Path traversal in file open
 * @description Detects unsanitized request data used in file open operations
 * @kind path-problem
 * @severity error
 * @id py/path-traversal-open
 */
import python
import semmle.code.python.dataflow.new.DataFlow
import DataFlow::PathGraph
import python.Strings
import python.security.PyRequests

class RouteVarSource extends DataFlow::Node {
  RouteVarSource() {
    exists(Parameter p |
      p = this.asParameter() and
      p.getName().matches("%ROUTEVAR%|%INTERM%")
    )
  }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Request req |
      req = this.asSource() and
      req.getField("get").asSource() = this or
      req.getField("args").asSource() = this or
      req.getField("[]").asSource() = this
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(FunctionCall fc |
      fc = this.asExpr() and
      fc.getTarget().getName() = "open" and
      fc.getArgument(0) = this
    )
  }
}

class PathTraversalConfig extends DataFlow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteVarSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, PathTraversalConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
