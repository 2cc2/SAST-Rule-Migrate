/**
 * @name Path Traversal in open() call
 * @description Found request data in a call to 'open'. Ensure the request data is validated or sanitized.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id py/path-traversal-open
 */

import python
import DataFlow::PathGraph
import python.web.flask.Flask

class PathTraversalConfig extends DataFlow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Route parameters as source
    exists(Parameter p |
      (p.getName().matches("%ROUTEVAR%") or p.getName().matches("%INTERM%")) and
      source.asParameter() = p
    )
    or
    // Flask request access as source
    exists(Call c, string methodName |
      c.getTarget().getPackage().getName() = "flask" and
      c.getTarget().getType().getName() = "request" and
      methodName = c.getTarget().getName() and
      methodName.matches("%get%") and
      source.asExpr() = c
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call c |
      c.getTarget().getType().getName() = "builtins" and
      c.getTarget().getName() = "open" and
      sink.asExpr() = c.getArg(0)
    )
  }
}

from PathTraversalConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
