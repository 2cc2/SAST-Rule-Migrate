/**
 * @name Path traversal via open()
 * @description Detect path traversal vulnerabilities where user-controlled data flows into open() calls
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import semmle.python.web.Flask
import DataFlow::PathGraph

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      p.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      source.asParameter() = p
    )
    or
    exists(Flask::RequestCall c |
      c.getMethodName().matches(["get", "[]", "%"]) and
      source.asExpr() = c
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getTarget().getName() = "open" and
      call.getTarget().getLocationInfoFile().getBaseName() = "builtins" and
      sink.asExpr() = call.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizingNode) {
    none()
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks.",
  source, sink, "Potential path traversal vulnerability"
