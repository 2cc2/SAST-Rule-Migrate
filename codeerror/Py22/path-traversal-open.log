Rule Content:
/**
 * @name Path Traversal in open()
 * @description Detects path traversal vulnerabilities caused by using request data in file open operations
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import DataFlow
import DataFlow::PathGraph
import semmle.python.web.flask.Request

class RouteVarSource extends DataFlow::Node {
  RouteVarSource() {
    exists(Parameter p |
      p = this.asParameter() and
      p.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM")
    )
  }

  override predicate isSource() { this instanceof TaintTracking::TaintSource }

  override DataFlow::Node asCfgNode() { this.asCfgNode() }
  override string getLocation() { this.getLocation() }
  override BasicBlock getBasicBlock() { this.getBasicBlock() }
  override string toString() { this.toString() }
  override AstNode getScope() { this.getScope() }
  override Variable asVariable() { this.asVariable() }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(DataFlow::CallNode call |
      call = this.asCall() and
      (
        call.getTarget().getPackage() = "flask" and
        call.getTarget().getType() = "request" and
        call.getTarget().getMethod() instanceof AnyMethod
      )
    )
  }

  override predicate isSource() { this instanceof TaintTracking::TaintSource }

  override DataFlow::Node asCfgNode() { this.asCfgNode() }
  override string getLocation() { this.getLocation() }
  override BasicBlock getBasicBlock() { this.getBasicBlock() }
  override string toString() { this.toString() }
  override AstNode getScope() { this.getScope() }
  override Variable asVariable() { this.asVariable() }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(DataFlow::CallNode call |
      call = this.asCall() and
      call.getTarget().getType() = "builtins" and
      call.getTarget().getMethod() = "open" and
      this = call.getArgument(0)
    )
  }

  override predicate isSink() { this instanceof TaintTracking::TaintSink }

  override DataFlow::Node asCfgNode() { this.asCfgNode() }
  override string getLocation() { this.getLocation() }
  override BasicBlock getBasicBlock() { this.getBasicBlock() }
  override string toString() { this.toString() }
  override AstNode getScope() { this.getScope() }
  override Variable asVariable() { this.asVariable() }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof RouteVarSource or source instanceof FlaskRequestSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) { sink instanceof OpenSink }

  override int explorationLimit() { result = 6 }
}

from PathTraversalConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
