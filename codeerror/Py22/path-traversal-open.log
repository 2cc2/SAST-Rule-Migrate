Rule Content:
/**
 * @name Path traversal in open() call
 * @description Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.Flask

class RouteVarSource extends DataFlow::Node::Range {
  RouteVarSource() {
    exists(string name |
      name.regexpMatch(".*ROUTEVAR.*|.*INTERM.*") and
      (
        // Matches Flask route parameters
        exists(FunctionNode fn | fn = self.asExpr() and fn.isParameter()) or
        // Matches route variables in Flask route decorators
        exists(FunctionNode routeFn | routeFn.getADecorator().getACall().getMemberName() = "route" |
          self.asExpr() = routeFn.getADecorator().getACall().getAnArgument().toString()
        )
      )
    )
  }
}

class FlaskRequestSource extends DataFlow::Node::Range {
  FlaskRequestSource() {
    exists(MethodCallNode call |
      call.getTarget().getPackage().getName() = "flask" and
      call.getTarget().getName() = "request" and
      (
        call.getMethodName() = "get" or
        call.getMethodName().matches("%") or
        exists(IndexNode index | index = call)
      ) and
      self.asExpr() = call
    )
  }
}

class OpenSink extends DataFlow::Node::Range {
  OpenSink() {
    exists(MethodCallNode call |
      call.getTarget().getName() = "open" and
      call.getTarget().getPackage().getName() = "builtins" and
      self.asExpr() = call.getAnArgument(0)
    )
  }
}

class PathTraversalConfiguration extends TaintTracking::Configuration {
  PathTraversalConfiguration() { this = "PathTraversalConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteVarSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // Propagation through arguments to parameters
    exists(FunctionNode fn, int argPos |
      pred.asExpr() = fn.getAnArgument(argPos) and
      succ.asExpr() = fn.getParameter(argPos)
    ) or
    // Propagation through assignments
    exists(AssignmentNode assign |
      pred.asExpr() = assign.getRhs() and
      succ.asExpr() = assign.getLhs()
    )
  }
}

from PathTraversalConfiguration config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
