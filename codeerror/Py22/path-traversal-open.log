Rule Content:
/**
 * @name Path Traversal in open() call
 * @description Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id path-traversal-open
 */

import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask
import semmle.python.dataflow.DataFlow

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(flask::Request::getAttrRead(ctx, attrName, source) |
      attrName.toString().regexpMatch("\\$ROUTEVAR|\\$INTERM")
    )
    or
    exists(flask::Request::requestCall(m) |
      m.getMethodName().regexpMatch("get|\\[\\]")
      and
      source.asExpr() = m
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DataFlow::CallNode call |
      call.getTarget().getName() = "open"
      and
      sink.asExpr() = call.getArgument(0)
    )
  }
}

from PathTraversalConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized to prevent path traversal attacks."
