/**
 * @name Path traversal in open() call
 * @description Detects unsanitized user input reaching file open operations
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import DataFlow
import semmle.python.dataflow.TaintTracking

class RouteVarSource extends DataFlow::Node::Range {
  RouteVarSource() {
    exists(ParameterNode p |
      this = p.getAnAccess() and
      p.getName().regexpMatch("/\\$ROUTEVAR|\\$INTERM/")
    )
  }
}

class FlaskRequestSource extends DataFlow::Node::Range {
  FlaskRequestSource() {
    exists(CallNode call |
      call.getTarget().getName() = "request" and
      call.getTarget().getAPackage() = "flask" and
      this = call.getAnArgument(0) and
      call.getAPIMethodName() in ["get", "[]", "value"]
    )
  }
}

class OpenSink extends DataFlow::Node::Range {
  OpenSink() {
    exists(CallNode call |
      call.getTarget().getName() = "open" and
      call.getTarget().getAPackage() = "builtins" and
      this = call.getAnArgument(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteVarSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
