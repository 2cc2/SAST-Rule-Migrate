Rule Content:
/**
 * @name Path Traversal in open()
 * @description Found request data in a call to 'open'. Ensure the request data is validated 
 *              or sanitized, otherwise it could result in path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import semmle.python.web.Flask
import semmle.python.Concepts
import DataFlow::PathGraph

class RouteVarSource extends DataFlow::ParameterNode {
  RouteVarSource() { 
    getName().regexpMatch(".*ROUTEVAR.*|.*INTERM.*")
  }

  override string toString() { result = "Route variable source" }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("flask", "request") and
      ma.getMethod().getName().matches("get%") or
      ma.getMethod().getName() = "[]"
    )
  }

  override string toString() { result = "Flask request source" }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("builtins") and
      ma.getMethod().getName() = "open"
    )
  }

  override string toString() { result = "File open sink" }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteVarSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Potential path traversal vulnerability from $@ to $@.",
  source, source.toString(),
  sink, sink.toString()
