Rule Content:
/**
 * @name Path Traversal in open() call
 * @description Found request data in a call to 'open'. Ensure the request data is validated or sanitized, 
 *              otherwise it could result in path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id path-traversal-open
 */

import python
import python.dataflow.TaintTracking
import python.web.flask
import DataFlow

class RouteVarSource extends TaintTracking::Source {
  RouteVarSource() {
    exists(DataFlow::ParameterNode p |
      p.getType().hasName("$ROUTEVAR") or p.getType().hasName("$INTERM")
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(DataFlow::ParameterNode p |
      p.getType().hasName("$ROUTEVAR") or p.getType().hasName("$INTERM") and
      source = p.asSource()
    )
  }
}

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getQualifiedName().matches("flask.request%") and
      ma.getMethod().getName().matches("get") or
      ma.getMethod().getName().matches("[]")
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getQualifiedName().matches("flask.request%") and
      (ma.getMethod().getName().matches("get") or
       ma.getMethod().getName().matches("[]")) and
      source = ma.asSource()
    )
  }
}

class FileOpenSink extends TaintTracking::Sink {
  FileOpenSink() {
    exists(Call call |
      call.getCallee().hasQualifiedName("builtins.open")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCallee().hasQualifiedName("builtins.open") and
      sink = call.getArgument(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteVarSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }
}

from PathTraversalConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select source, sink, 
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, "
  "otherwise it could result in path traversal attacks."
