/**
 * @name Path traversal in open() call
 * @description Detects path traversal vulnerabilities when request data flows directly to open() call
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import python.web.Flask
import DataFlow::PathGraph
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import TaintTracking::Configuration

private class RouteVarSource extends DataFlow::Node {
  RouteVarSource() {
    exists(Python::Parameter p |
      p.getParameterName().matches("\$ROUTEVAR|\$INTERM") and
      this.asParameter() = p
    )
  }
}

private class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Flask::RequestAccess r |
      r.getMethodName() in ["get", "[]", "values"] and
      results = r.getMember() and
      this.asExpr() = results
    )
  }
}

private class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(python.MethodAccess ma |
      ma.getMethod().getName() = "open" and
      ma.getCallee().getType().hasName("builtins") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { super("PathTraversalConfig") }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteVarSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where
  config.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
