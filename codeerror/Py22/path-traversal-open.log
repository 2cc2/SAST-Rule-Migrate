Rule Content:
/**
 * @name Path Traversal in Open
 * @description Detects potential path traversal vulnerabilities when request data flows into open() calls.
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Requests
import DataFlow::PathGraph

class RouteVarSource extends DataFlow::Node {
  RouteVarSource() {
    exists(string name |
      name.regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this = DataFlow::parameterNode(_).asOutput()
    )
  }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall mc |
      mc.getTarget().getPackage() = "flask" and
      mc.getTarget().getType() = "request" and
      mc.getMethodName().matches(["get", "%"]) and
      this = mc.getReturn()
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(MethodCall mc |
      mc.getTarget().isBuiltin() and
      mc.getMethodName() = "open" and
      this = mc.getArgument(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteVarSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }
}

from PathTraversalConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
