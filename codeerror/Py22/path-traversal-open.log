Rule Content:
import python
import python.web.Flask
import DataFlow::PathGraph

class PathTraversalOpen extends TaintTracking::Configuration {
  PathTraversalOpen() { this = "PathTraversalOpen" }

  override predicate isSource(TaintTracking::TaintSource source) {
    (
      exists(Parameter param |
        param.getAnAccess().getName() regexpMatches("\$ROUTEVAR|\$INTERM")
        and
        source.asExpr() = param
      )
    )
    or
    (
      exists(Call call, string methodName |
        call.getTarget().getPackage().getId() = "flask"
        and
        call.getTarget().getTypeName() = "request"
        and
        methodName = call.getTarget().getMethodName()
        and
        (methodName = "get" or methodName.matches("%"))
        and
        source.asExpr() = call
      )
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(Call call |
      call.getTarget().getTypeName() = "builtins"
      and
      call.getTarget().getMethodName() = "open"
      and
      sink.asExpr() = call.getArgument(0)
    )
  }
}

from PathTraversalOpen pt, TaintTracking::TaintSource source, TaintTracking::TaintSink sink
where pt.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
