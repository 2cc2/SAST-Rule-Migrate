/**
 * @name Path Traversal in open() call
 * @description Detects path traversal vulnerabilities when request data flows into open() calls
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id path-traversal-open
 */

import semmle.python.dataflow.DataFlow
import semmle.python.web.flask.Flask

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Flask request sources (request.get(), request[] etc)
    exists(Flask::RequestCall c |
      (c.getMethodName() = "get" or c.getQualifier().toString() = "[]") and
      source.asExpr() = c
    )
    or
    // Route variables ($ROUTEVAR, $INTERM)
    exists(Python::Parameter p |
      p.getName().regexpMatches("\\$ROUTEVAR|\\$INTERM") and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Python::Call c |
      c.getCallee().hasQualifiedName("builtins", "open") and
      sink.asExpr() = c.getArgument(0)
    )
  }
}

from PathTraversalConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink,
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
