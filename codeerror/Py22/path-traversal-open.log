Rule Content:
/**
 * @name Path traversal in open() call
 * @description Detects when request data flows into open() call without sanitization
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call call |
      call.getCallee().getValue().(Value::Module).getName() = "flask" and
      call.getCallee().getValue().(Value::Module).getMember("request").getMethod().getName() = "request" and
      call.getCallee().getValue().(Value::Module).getMember("request").getMethod().getAParameter().getId().matches("get|[]") and
      this.asExpr() = call
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Function::Parameter param |
      param.getName().matches("ROUTEVAR|INTERM") and
      this.asExpr() = param.getAnAccess()
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(Call call |
      call.getCallee().getName() = "open" and
      call.getCallee().getValue().(Value::Builtin).getType() = "builtins" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
