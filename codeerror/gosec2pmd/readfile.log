package com.example.pmdrules;

import net.sourceforge.pmd.RuleContext;
import net.sourceforge.pmd.lang.ast.Node;
import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.symbols.JVariableSymbol;
import net.sourceforge.pmd.lang.symboltable.NameOccurrence;
import java.util.HashMap;
import java.util.Map;

public class PotentialFileInclusionRule extends AbstractJavaRule {

    private static final String[] PATH_JOIN_METHODS = {
        "path.filepath.Join",
        "path.Join"
    };

    private static final String[] CLEAN_METHODS = {
        "path.filepath.Clean",
        "path.filepath.Rel",
        "path.filepath.EvalSymlinks"
    };

    private static final String[] TARGET_METHODS = {
        "io.ioutil.ReadFile",
        "os.ReadFile",
        "os.Open",
        "os.OpenFile",
        "os.Create"
    };

    private final Map<Node, Node> cleanedVariables = new HashMap<>();

    public PotentialFileInclusionRule() {
        addRuleChainVisit(ASTMethodCall.class);
    }

    @Override
    public Object visit(ASTMethodCall node, RuleContext ctx) {
        if (isCleanMethod(node)) {
            trackCleanMethod(node);
            return super.visit(node, ctx);
        }

        if (isTargetMethod(node)) {
            checkFileInclusionVulnerability(node, ctx);
        }

        return super.visit(node, ctx);
    }

    private boolean isCleanMethod(ASTMethodCall node) {
        String methodName = getFullMethodName(node);
        for (String cleanMethod : CLEAN_METHODS) {
            if (cleanMethod.equals(methodName)) {
                return true;
            }
        }
        return false;
    }

    private boolean isTargetMethod(ASTMethodCall node) {
        String methodName = getFullMethodName(node);
        for (String targetMethod : TARGET_METHODS) {
            if (targetMethod.equals(methodName)) {
                return true;
            }
        }
        return false;
    }

    private boolean isJoinMethod(ASTMethodCall node) {
        String methodName = getFullMethodName(node);
        for (String joinMethod : PATH_JOIN_METHODS) {
            if (joinMethod.equals(methodName)) {
                return true;
            }
        }
        return false;
    }

    private String getFullMethodName(ASTMethodCall node) {
        ASTPrimaryExpression primaryExpr = node.getFirstParentOfType(ASTPrimaryExpression.class);
        if (primaryExpr != null) {
            return primaryExpr.getImage();
        }
        return "";
    }

    private void trackCleanMethod(ASTMethodCall node) {
        if (node.getArguments().size() > 0) {
            Node arg = node.getArguments().get(0);
            if (arg instanceof ASTVariableAccess) {
                ASTVariableAccess varAccess = (ASTVariableAccess) arg;
                JVariableSymbol symbol = varAccess.getSymbol();
                if (symbol != null) {
                    cleanedVariables.put(symbol.getDeclaringNode(), node);
                }
            }
        }
    }

    private void checkFileInclusionVulnerability(ASTMethodCall node, RuleContext ctx) {
        for (Node arg : node.getArguments()) {
            if (arg instanceof ASTMethodCall) {
                ASTMethodCall callExpr = (ASTMethodCall) arg;
                if (isJoinMethod(callExpr) && hasUnresolvedVariables(callExpr)) {
                    reportViolation(node, ctx);
                    return;
                }
            } else if (arg instanceof ASTBinaryExpression) {
                if (hasUnresolvedVariables((ASTBinaryExpression) arg)) {
                    reportViolation(node, ctx);
                    return;
                }
            } else if (arg instanceof ASTVariableAccess) {
                ASTVariableAccess varAccess = (ASTVariableAccess) arg;
                if (isUnresolvedVariable(varAccess) && !isCleanedVariable(varAccess)) {
                    reportViolation(node, ctx);
                    return;
                }
            }
        }
    }

    private boolean hasUnresolvedVariables(ASTMethodCall node) {
        for (Node arg : node.getArguments()) {
            if (arg instanceof ASTBinaryExpression) {
                if (hasUnresolvedVariables((ASTBinaryExpression) arg)) {
                    return true;
                }
            } else if (arg instanceof ASTVariableAccess) {
                if (isUnresolvedVariable((ASTVariableAccess) arg)) {
                    return true;
                }
            }
        }
        return false;
    }

    private boolean hasUnresolvedVariables(ASTBinaryExpression expr) {
        for (NameOccurrence occ : expr.getSymbol().getNameOccurrences()) {
            if (isUnresolvedVariable(occ.getLocation())) {
                return true;
            }
        }
        return false;
    }

    private boolean isUnresolvedVariable(Node node) {
        if (node instanceof ASTVariableAccess) {
            ASTVariableAccess varAccess = (ASTVariableAccess) node;
            return !varAccess.getSymbol().isResolved();
        }
        return false;
    }

    private boolean isCleanedVariable(ASTVariableAccess varAccess) {
        return cleanedVariables.containsKey(varAccess.getSymbol().getDeclaringNode());
    }

    private void reportViolation(Node node, RuleContext ctx) {
        ctx.getReport().addRuleViolation(createRuleViolation(
            ctx, node, "Potential file inclusion via variable"
        ));
    }
}
