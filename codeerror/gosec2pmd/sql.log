package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;
import java.util.regex.Pattern;

public class SqlInjectionRule extends AbstractJavaRule {
    private static final Pattern SQL_PATTERN = Pattern.compile("(?i)(SELECT|DELETE|INSERT|UPDATE|INTO|FROM|WHERE)( |\\n|\\r|\\t)");
    private static final Pattern FORMAT_PATTERN = Pattern.compile("%[^bdoxXfFp]");
    
    @Override
    public Object visit(ASTMethodCall methodCall, Object data) {
        checkSqlConcatenation(methodCall, data);
        checkSqlFormatting(methodCall, data);
        return super.visit(methodCall, data);
    }
    
    private void checkSqlConcatenation(ASTMethodCall methodCall, Object data) {
        String methodName = methodCall.getMethodName();
        String className = getClassName(methodCall);
        
        if (isSqlMethod(className, methodName)) {
            ASTExpression arg = getSqlArgument(methodCall);
            if (arg != null && isStringConcatenation(arg)) {
                if (containsSqlPattern(arg.getImage())) {
                    addViolation(data, methodCall, "SQL string concatenation vulnerability found");
                }
            }
        }
    }
    
    private void checkSqlFormatting(ASTMethodCall methodCall, Object data) {
        if (isFormatMethod(methodCall)) {
            ASTExpression formatArg = getFormatArgument(methodCall);
            if (formatArg != null && 
                (containsSqlPattern(formatArg.getImage()) || containsFormatVulnerability(formatArg.getImage()))) {
                addViolation(data, methodCall, "SQL string formatting vulnerability found");
            }
        }
    }
    
    private boolean isSqlMethod(String className, String methodName) {
        return ("database.sql.DB".equals(className) || "database.sql.Tx".equals(className)) &&
               ("Exec".equals(methodName) || "ExecContext".equals(methodName) || 
                "Query".equals(methodName) || "QueryContext".equals(methodName) ||
                "QueryRow".equals(methodName) || "QueryRowContext".equals(methodName) ||
                "Prepare".equals(methodName) || "PrepareContext".equals(methodName));
    }
    
    private boolean isFormatMethod(ASTMethodCall methodCall) {
        return "Sprint".equals(methodCall.getMethodName()) || 
               "Sprintf".equals(methodCall.getMethodName()) ||
               "Sprintln".equals(methodCall.getMethodName()) ||
               "Fprintf".equals(methodCall.getMethodName());
    }
    
    private ASTExpression getSqlArgument(ASTMethodCall methodCall) {
        return methodCall.getArguments().size() > 0 ? methodCall.getArguments().get(0) : null;
    }
    
    private ASTExpression getFormatArgument(ASTMethodCall methodCall) {
        int argIndex = "Fprintf".equals(methodCall.getMethodName()) ? 1 : 0;
        return methodCall.getArguments().size() > argIndex ? methodCall.getArguments().get(argIndex) : null;
    }
    
    private boolean isStringConcatenation(ASTExpression expr) {
        return expr instanceof ASTBinaryExpression && 
               ((ASTBinaryExpression)expr).getOperator() == BinaryOperator.PLUS;
    }
    
    private boolean containsSqlPattern(String str) {
        return str != null && SQL_PATTERN.matcher(str).find();
    }
    
    private boolean containsFormatVulnerability(String str) {
        return str != null && FORMAT_PATTERN.matcher(str).find();
    }
    
    private String getClassName(ASTMethodCall methodCall) {
        if (methodCall.getQualifier() instanceof ASTName) {
            return ((ASTName)methodCall.getQualifier()).getImage();
        }
        return null;
    }
}
