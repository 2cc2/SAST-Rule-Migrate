package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.*;
import net.sourceforge.pmd.*;

public class InsecureTlsConfigRule extends AbstractJavaRule {
    private long minVersion = 0x0304; // TLS 1.3
    private long maxVersion = 0x0304; // TLS 1.3
    private String[] goodCiphers = {
        "TLS_AES_128_GCM_SHA256",
        "TLS_AES_256_GCM_SHA384",
        "TLS_CHACHA20_POLY1305_SHA256"
    };
    
    public InsecureTlsConfigRule() {
        addRuleChainVisit(ASTVariableDeclarator.class);
        addRuleChainVisit(ASTAssignmentOperator.class);
    }

    @Override
    public Object visit(ASTVariableDeclarator node, Object data) {
        if (isTlsConfigType(node)) {
            ASTInitializer initializer = node.getInitializer();
            if (initializer != null) {
                checkTlsConfig(initializer, data);
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTAssignmentOperator node, Object data) {
        if (node.jjtGetParent() instanceof ASTStatement 
            && isTlsConfigExpression(node.getLeftOperand())) {
            checkTlsConfig(node.getRightOperand(), data);
        }
        return super.visit(node, data);
    }

    private boolean isTlsConfigType(ASTVariableDeclarator node) {
        return node.getTypeNode().getTypeImage() != null 
            && node.getTypeNode().getTypeImage().equals("Config");
    }

    private boolean isTlsConfigExpression(ASTExpression node) {
        if (node instanceof ASTPrimaryExpression) {
            ASTPrimaryPrefix prefix = ((ASTPrimaryExpression) node).getFirstDescendantOfType(ASTPrimaryPrefix.class);
            return prefix != null && prefix.jjtGetNumChildren() > 0 
                && prefix.jjtGetChild(0) instanceof ASTName 
                && ((ASTName)prefix.jjtGetChild(0)).getImage().endsWith(".tlsConfig");
        }
        return false;
    }

    private void checkTlsConfig(ASTInitializer initializer, Object data) {
        if (initializer.jjtGetNumChildren() > 0 
            && initializer.jjtGetChild(0) instanceof ASTExpression 
            && ((ASTExpression)initializer.jjtGetChild(0)).jjtGetNumChildren() > 0 
            && ((ASTExpression)initializer.jjtGetChild(0)).jjtGetChild(0) instanceof ASTPrimaryExpression) {
            ASTPrimaryExpression expr = (ASTPrimaryExpression) ((ASTExpression)initializer.jjtGetChild(0)).jjtGetChild(0);
            processConfiguration(expr, data);
        }
    }

    private void processConfiguration(ASTPrimaryExpression expr, Object data) {
        // Implementation for checking TLS configuration
        // This would include checks for:
        // - InsecureSkipVerify
        // - PreferServerCipherSuites
        // - MinVersion/MaxVersion
        // - CipherSuites
        // Similar logic to the original Go rule but in Java syntax
    }

    private boolean isGoodCipher(String cipher) {
        for (String good : goodCiphers) {
            if (good.equals(cipher)) {
                return true;
            }
        }
        return false;
    }

    private long mapVersion(String version) {
        switch (version) {
            case "TLSv1.3": return 0x0304;
            case "TLSv1.2": return 0x0303;
            case "TLSv1.1": return 0x0302;
            case "TLSv1": return 0x0301;
            default: return 0;
        }
    }
}
