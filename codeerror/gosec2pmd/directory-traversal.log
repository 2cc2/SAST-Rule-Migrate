package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.*;
import net.sourceforge.pmd.properties.*;
import java.util.regex.Pattern;
import java.util.regex.Matcher;

public class DirectoryTraversalRule extends AbstractJavaRule {
    private static final String DEFAULT_PATTERN = "http\\.Dir\\(\"\\/\"\\)|http\\.Dir\\('\\/'\\)";
    private Pattern pattern;

    public DirectoryTraversalRule() {
        definePropertyDescriptor(PropertyFactory.regexProperty("pattern")
            .desc("Pattern to detect directory traversal vulnerabilities")
            .defaultValue(DEFAULT_PATTERN)
            .build());
    }

    @Override
    public Object visit(ASTCallExpression node, Object data) {
        pattern = Pattern.compile(getProperty(PropertyDescriptorField.PATTERN));
        
        for (ASTExpression arg : node.findChildrenOfType(ASTExpression.class)) {
            if (arg instanceof ASTLiteral) {
                ASTLiteral literal = (ASTLiteral)arg;
                ASTPrimaryExpression fun = node.getFirstParentOfType(ASTPrimaryExpression.class);
                if (fun != null) {
                    ASTPrimaryPrefix prefix = fun.getFirstDescendantOfType(ASTPrimaryPrefix.class);
                    if (prefix != null) {
                        String methodCall = prefix.getImage() + "." + node.getMethodName() + "(" + literal.getValue() + ")";
                        Matcher matcher = pattern.matcher(methodCall);
                        if (matcher.matches()) {
                            addViolation(data, node, "Potential directory traversal vulnerability");
                        }
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
