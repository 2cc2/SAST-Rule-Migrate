    @Override
    public Object visit(ASTMethodCall node, Object data) {
        RuleContext ctx = (RuleContext) data;
        
        if (isTargetMethodCall(node)) {
            for (ASTExpression arg : node.getArguments()) {
                if (hasUnsafeType(arg)) {
                    addViolation(ctx, node, "File traversal when extracting zip/tar archive");
                    break;
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isTargetMethodCall(ASTMethodCall node) {
        String methodName = node.getMethodName();
        ASTClassOrInterfaceType qualifier = node.getQualifier();
        
        for (String[] method : TARGET_METHODS) {
            if (TypeTestUtil.isA(method[0], qualifier) 
                && methodName.equals(method[1])) {
                return true;
            }
        }
        return false;
    }

    private boolean hasUnsafeType(ASTExpression expr) {
        if (expr instanceof ASTName) {
            ASTName name = (ASTName) expr;
            return TARGET_ARG_TYPES.stream()
                   .anyMatch(type -> TypeTestUtil.isA(type, name));
        }
        return false;
    }
}
