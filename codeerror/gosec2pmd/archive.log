package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.*;
import net.sourceforge.pmd.lang.java.types.TypeTestUtil;
import java.util.Arrays;
import java.util.List;

public class ArchiveTraversalRule extends AbstractJavaRule {
    private static final List<String> TARGET_ARG_TYPES = Arrays.asList(
        "archive.zip.File",
        "archive.tar.Header"
    );
    
    private static final List<String[]> TARGET_METHODS = Arrays.asList(
        new String[]{"path.filepath", "Join"},
        new String[]{"path", "Join"}
    );

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        // Check if method call matches our target methods
        if (isTargetMethodCall(node)) {
            // Check each argument for unsafe types
            for (ASTExpression arg : node.getArguments()) {
                if (hasUnsafeType(arg)) {
                    addViolation(data, node, "File traversal when extracting zip/tar archive");
                    break;
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isTargetMethodCall(ASTMethodCall node) {
        for (String[] method : TARGET_METHODS) {
            String className = method[0];
            String methodName = method[1];
            
            if (TypeTestUtil.isA(className, node.getQualifier())
                && node.getMethodName().equals(methodName)) {
                return true;
            }
        }
        return false;
    }

    private boolean hasUnsafeType(ASTExpression expr) {
        // Handle selector expressions (e.g. file.Name)
        if (expr instanceof ASTPrimaryExpression) {
            ASTPrimaryExpression primary = (ASTPrimaryExpression) expr;
            if (primary.getNumChildren() > 0 && primary.getChild(0) instanceof ASTPrimaryPrefix) {
                ASTPrimaryPrefix prefix = (ASTPrimaryPrefix) primary.getChild(0);
                if (prefix.getNumChildren() > 0 && prefix.getChild(0) instanceof ASTName) {
                    ASTName name = (ASTName) prefix.getChild(0);
                    for (String type : TARGET_ARG_TYPES) {
                        if (TypeTestUtil.isA(type, name)) {
                            return true;
                        }
                    }
                }
            }
        }
        // Handle variable references
        else if (expr instanceof ASTName) {
            ASTName name = (ASTName) expr;
            for (String type : TARGET_ARG_TYPES) {
                if (TypeTestUtil.isA(type, name)) {
                    return true;
                }
            }
        }
        return false;
    }
}
