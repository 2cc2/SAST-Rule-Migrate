Rule Content:
【修改策略】
1. 移除全部Unicode特殊字符
2. 重构弱加密检测逻辑，使用静态分析方法替代运行时类加载
3. 修复方法签名和返回值问题
4. 完善if-else语句结构
5. 补齐所有必要的语法元素

# 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.*;
import net.sourceforge.pmd.*;

public class UsesWeakCryptographyHashRule extends AbstractJavaRule {

    private static final String[] MD5_METHODS = {"New", "Sum"};
    private static final String[] SHA1_METHODS = {"New", "Sum"};

    public UsesWeakCryptographyHashRule() {
        setProperty(PropertyDescriptor.severity, Severity.MEDIUM);
        setMessage("Use of weak cryptographic primitive");
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String packageName = getPackageName(node);
        if (packageName != null) {
            if (packageName.equals("java.security.MessageDigest")) {
                checkDigestMethods(node, data);
            } else {
                checkForWeakCrypto(node, data, "md5", MD5_METHODS);
                checkForWeakCrypto(node, data, "sha1", SHA1_METHODS);
            }
        }
        return super.visit(node, data);
    }

    private void checkDigestMethods(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        if ("getInstance".equals(methodName)) {
            ASTLiteral literal = node.getFirstDescendantOfType(ASTLiteral.class);
            if (literal != null) {
                String algorithm = literal.getImage().replaceAll("\"", "");
                if ("MD5".equals(algorithm) || "SHA1".equals(algorithm)) {
                    addViolation(data, node);
                }
            }
        }
    }

    private String getPackageName(ASTMethodCall node) {
        ASTName name = node.getFirstChildOfType(ASTName.class);
        return name == null ? null : name.getImage();
    }

    private void checkForWeakCrypto(ASTMethodCall node, Object data, 
                                  String algo, String[] methods) {
        String methodName = node.getMethodName();
        for (String method : methods) {
            if (method.equals(methodName)) {
                addViolation(data, node);
                break;
            }
        }
    }
}
