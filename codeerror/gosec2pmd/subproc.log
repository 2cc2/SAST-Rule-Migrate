package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.ast.Node;
import java.util.Arrays;
import java.util.List;

public class SubprocessCommandInjectionRule extends AbstractJavaRule {
    private static final List<String> UNSAFE_METHODS = Arrays.asList(
        "Command",
        "CommandContext",
        "Exec",
        "ForkExec",
        "StartProcess"
    );
    
    private static final List<String> UNSAFE_CLASSES = Arrays.asList(
        "java.lang.Runtime",
        "java.lang.ProcessBuilder",
        "java.lang.Process",
        "java.lang.UNIXProcess",
        // Add other relevant Java process-related classes
    );

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        String className = getClassName(node);
        
        if (isUnsafeMethod(methodName, className)) {
            List<ASTArgumentList> arguments = node.findDescendantsOfType(ASTArgumentList.class);
            for (ASTArgumentList argList : arguments) {
                for (int i = 0; i < argList.jjtGetNumChildren(); i++) {
                    Node arg = argList.jjtGetChild(i);
                    if (isTaintedArgument(arg)) {
                        addViolation(data, node, "Subprocess launched with potential tainted input or command arguments");
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isUnsafeMethod(String methodName, String className) {
        return UNSAFE_METHODS.contains(methodName) && 
               (className.contains("Process") || 
                className.contains("Runtime") || 
                className.contains("UNIXProcess"));
    }

    private boolean isTaintedArgument(Node arg) {
        // Check if argument is a variable
        if (arg instanceof ASTPrimaryExpression) {
            ASTPrimaryExpression primaryExpr = (ASTPrimaryExpression)arg;
            if (primaryExpr.jjtGetNumChildren() > 0) {
                Node firstChild = primaryExpr.jjtGetChild(0);
                if (firstChild instanceof ASTVariableAccess) {
                    return true;
                }
            }
        }
        // Check if argument is a method call
        else if (arg instanceof ASTMethodCall) {
            return true;
        }
        // Check if argument is array access
        else if (arg instanceof ASTArrayAccess) {
            return true;
        }
        return false;
    }

    private String getClassName(ASTMethodCall node) {
        if (node.jjtGetParent() instanceof ASTPrimaryExpression) {
            ASTPrimaryExpression primaryExpr = (ASTPrimaryExpression)node.jjtGetParent();
            if (primaryExpr.jjtGetNumChildren() > 0) {
                Node firstChild = primaryExpr.jjtGetChild(0);
                if (firstChild instanceof ASTPrimaryPrefix) {
                    return firstChild.getImage();
                }
            }
        }
        return "";
    }
}
