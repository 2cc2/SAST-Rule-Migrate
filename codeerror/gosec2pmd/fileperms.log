package com.example.pmdrules;

import net.sourceforge.pmd.*;
import net.sourceforge.pmd.lang.java.ast.*;
import net.sourceforge.pmd.lang.java.rule.*;
import net.sourceforge.pmd.properties.*;

import java.util.*;

public class FilePermissionRule extends AbstractJavaRule {
    private static final IntegerProperty MODE_PROPERTY = IntegerProperty.named("fileMode")
            .desc("Maximum allowed file permission mode (octal)")
            .defaultValue(0600)
            .build();

    private static final StringListProperty PACKAGES_PROPERTY = StringListProperty.named("packages")
            .desc("Packages to check for file operations")
            .defaultValues("io.ioutil", "os")
            .delim(',')
            .build();

    private static final StringListProperty CALLS_PROPERTY = StringListProperty.named("calls")
            .desc("Method calls to check")
            .defaultValues("WriteFile", "OpenFile", "Chmod", "Mkdir", "MkdirAll", "Create")
            .delim(',')
            .build();

    private int mode;
    private Set<String> packages;
    private Set<String> calls;

    public FilePermissionRule() {
        definePropertyDescriptor(MODE_PROPERTY);
        definePropertyDescriptor(PACKAGES_PROPERTY);
        definePropertyDescriptor(CALLS_PROPERTY);
    }

    @Override
    public Object visit(ASTCompilationUnit node, Object data) {
        mode = getProperty(MODE_PROPERTY);
        packages = new HashSet<>(Arrays.asList(getProperty(PACKAGES_PROPERTY)));
        calls = new HashSet<>(Arrays.asList(getProperty(CALLS_PROPERTY)));

        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        String packageName = getPackageName(node);

        if (packageName != null && packages.contains(packageName) && calls.contains(methodName)) {
            if (methodName.equals("Create") && !modeIsSubset(0666, mode)) {
                addViolation(data, node, "os.Create used with default permissions 0666");
            } else if (node.getArguments().size() > 0) {
                ASTArgument modeArg = node.getArguments().get(node.getArguments().size() - 1);
                Integer permissionMode = getModeValue(modeArg);
                
                if (permissionMode != null && !modeIsSubset(permissionMode, mode)
                        || isOsPerm(modeArg)) {
                    addViolation(data, node, "File permissions are more permissive than " + mode);
                }
            }
        }

        return super.visit(node, data);
    }

    private String getPackageName(ASTMethodCall node) {
        try {
            ASTPrimaryExpression pe = (ASTPrimaryExpression) node.jjtGetParent();
            ASTPrimaryPrefix pp = pe.getFirstDescendantOfType(ASTPrimaryPrefix.class);
            ASTName name = pp.getFirstDescendantOfType(ASTName.class);
            return name.getImage().split("\\.")[0];
        } catch (Exception e) {
            return null;
        }
    }

    private Integer getModeValue(ASTArgument arg) {
        if (arg.jjtGetChild(0) instanceof ASTLiteral) {
            ASTLiteral literal = (ASTLiteral) arg.jjtGetChild(0);
            return Integer.parseInt(literal.getImage());
        }
        return null;
    }

    private boolean modeIsSubset(int subset, int superset) {
        return (subset | superset) == superset;
    }

    private boolean isOsPerm(ASTArgument arg) {
        if (arg.jjtGetChild(0) instanceof ASTFieldAccess) {
            ASTFieldAccess fa = (ASTFieldAccess) arg.jjtGetChild(0);
            return "os".equals(fa.getChild(0).getImage()) 
                    && "ModePerm".equals(fa.getChild(1).getImage());
        }
        return false;
    }
}
