package com.example.pmdrules;

import net.sourceforge.pmd.RuleContext;
import net.sourceforge.pmd.lang.ast.Node;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

public class SSHHostKeyRule extends AbstractJavaRule {
    private static final String TARGET_PACKAGE = "golang.org.x.crypto.ssh";
    private static final String[] TARGET_METHODS = {"InsecureIgnoreHostKey"};

    public SSHHostKeyRule() {
        setMessage("Use of ssh InsecureIgnoreHostKey should be audited");
        setSeverity(SeverityRule.MEDIUM);
        setPriority(Priority.HIGH);
    }

    @Override
    public Object visit(ASTMethodCall node, RuleContext ctx) {
        Node nameNode = node.getFirstChildOfType(ASTName.class);
        if (nameNode != null) {
            String methodCall = nameNode.getImage();
            String packageName = getPackageName(nameNode);

            if (packageName != null && packageName.equals(TARGET_PACKAGE)) {
                for (String targetMethod : TARGET_METHODS) {
                    if (methodCall.equals(targetMethod)) {
                        addViolation(ctx, node);
                    }
                }
            }
        }
        return super.visit(node, ctx);
    }

    private String getPackageName(Node node) {
        if (node != null) {
            String image = node.getImage();
            int lastDot = image.lastIndexOf('.');
            if (lastDot > 0) {
                return image.substring(0, lastDot);
            }
        }
        return null;
    }
}
