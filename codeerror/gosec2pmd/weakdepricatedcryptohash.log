package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTCallExpression;
import net.sourceforge.pmd.lang.java.ast.ASTName;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.RuleContext;
import java.util.HashMap;

public class UsesWeakDeprecatedCryptographyHashRule extends AbstractJavaRule {
    private final HashMap<String, String[]> blocklist = new HashMap<>();

    public UsesWeakDeprecatedCryptographyHashRule() {
        blocklist.put("golang.org.x.crypto.md4", new String[]{"New"});
        blocklist.put("golang.org.x.crypto.ripemd160", new String[]{"New"});
        setProperty(PropertyDescriptor.SEVERITY, 4); // Medium severity
        setMessage("Use of deprecated weak cryptographic primitive");
    }

    @Override
    public Object visit(ASTCallExpression node, Object data) {
        for (String pkg : blocklist.keySet()) {
            ASTName name = node.getFirstChildOfType(ASTName.class);
            if (name != null && name.getImage().startsWith(pkg)) {
                String[] funcs = blocklist.get(pkg);
                for (String func : funcs) {
                    if (node.getImage().endsWith(func)) {
                        addViolation(data, node);
                        return super.visit(node, data);
                    }
                }
            }
        }
        return super.visit(node, data);
    }
}
