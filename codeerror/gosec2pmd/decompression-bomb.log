package com.example.pmdrules;

import net.sourceforge.pmd.RuleContext;
import net.sourceforge.pmd.lang.java.ast.ASTAssignStmt;
import net.sourceforge.pmd.lang.java.ast.ASTCallExpression;
import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTId;
import net.sourceforge.pmd.lang.java.ast.AbstractJavaNode;
import net.sourceforge.pmd.lang.java.ast.JavaNode;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

import java.util.HashMap;
import java.util.HashSet;
import java.util.Map;
import java.util.Set;

public class DecompressionBombCheckRule extends AbstractJavaRule {
    private static final Set<String> READER_METHODS = new HashSet<String>() {{
        add("compress.gzip.NewReader");
        add("compress.zlib.NewReader");
        add("compress.zlib.NewReaderDict");
        add("compress.bzip2.NewReader");
        add("compress.flate.NewReader");
        add("compress.flate.NewReaderDict");
        add("compress.lzw.NewReader");
        add("archive.tar.NewReader");
        add("archive.zip.NewReader");
        add("archive.zip.File.Open");
    }};

    private static final Set<String> COPY_METHODS = new HashSet<String>() {{
        add("io.Copy");
        add("io.CopyBuffer");
    }};

    private Map<Object, Object> readerVarObj;

    public DecompressionBombCheckRule() {
        readerVarObj = new HashMap<>();
    }

    @Override
    public Object visit(ASTAssignStmt node, Object data) {
        RuleContext ctx = (RuleContext) data;
        for (ASTExpression expr : node.findChildrenOfType(ASTExpression.class)) {
            if (expr instanceof ASTCallExpression) {
                ASTCallExpression callExpr = (ASTCallExpression) expr;
                if (isReaderCall(callExpr)) {
                    ASTId id = node.getFirstDescendantOfType(ASTId.class);
                    if (id != null && !"_".equals(id.getImage())) {
                        readerVarObj.put(id.getBinding(), null);
                    }
                }
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTCallExpression node, Object data) {
        RuleContext ctx = (RuleContext) data;
        if (isCopyCall(node)) {
            ASTExpression arg = node.getArgument(1);
            if (arg instanceof ASTId) {
                ASTId id = (ASTId) arg;
                if (readerVarObj.containsKey(id.getBinding())) {
                    addViolation(ctx, node, "Potential DoS vulnerability via decompression bomb");
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isReaderCall(ASTCallExpression node) {
        String methodCall = getFullyQualifiedMethodName(node);
        return READER_METHODS.contains(methodCall);
    }

    private boolean isCopyCall(ASTCallExpression node) {
        String methodCall = getFullyQualifiedMethodName(node);
        return COPY_METHODS.contains(methodCall);
    }

    private String getFullyQualifiedMethodName(ASTCallExpression node) {
        String packageName = node.getChild(0).getImage();
        String methodName = node.getChild(1).getImage();
        return packageName + "." + methodName;
    }
}
