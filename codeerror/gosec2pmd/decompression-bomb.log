# 转换后的 PMD 规则
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclarator;
import net.sourceforge.pmd.lang.java.ast.ASTVariableDeclaratorId;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;

import java.util.HashMap;
import java.util.HashSet;
import java.util.Map;
import java.util.Set;

public class DecompressionBombCheckRule extends AbstractJavaRule {
    private static final Set<String> READER_METHODS = new HashSet<>();
    private static final Set<String> COPY_METHODS = new HashSet<>();
    
    static {
        READER_METHODS.add("NewReader");
        READER_METHODS.add("NewReaderDict");
        READER_METHODS.add("Open");
        
        COPY_METHODS.add("Copy");
        COPY_METHODS.add("CopyBuffer");
    }

    private Map<String, Object> readerVarObj = new HashMap<>();

    @Override
    public Object visit(ASTVariableDeclarator node, Object data) {
        ASTExpression init = node.getInitializer();
        if (init instanceof ASTMethodCall) {
            ASTMethodCall call = (ASTMethodCall) init;
            if (isReaderCall(call)) {
                ASTVariableDeclaratorId id = node.getVarId();
                if (id != null && !"_".equals(id.getName())) {
                    readerVarObj.put(id.getName(), null);
                }
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        if (isCopyCall(node)) {
            ASTExpression arg = node.getArgument(1);
            if (arg instanceof ASTVariableDeclaratorId) {
                ASTVariableDeclaratorId id = (ASTVariableDeclaratorId) arg;
                if (readerVarObj.containsKey(id.getName())) {
                    addViolation(data, node, "Potential DoS vulnerability via decompression bomb");
                }
            }
        }
        return super.visit(node, data);
    }

    private boolean isReaderCall(ASTMethodCall node) {
        return READER_METHODS.contains(node.getMethodName());
    }

    private boolean isCopyCall(ASTMethodCall node) {
        return COPY_METHODS.contains(node.getMethodName());
    }
}
