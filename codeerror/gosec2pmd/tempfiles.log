package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTExpression;
import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import net.sourceforge.pmd.lang.java.ast.ASTLiteral;
import net.sourceforge.pmd.lang.java.ast.ASTBinaryExpression;
import java.util.regex.Pattern;

public class BadTempFileRule extends AbstractJavaRule {
    private static final Pattern TEMP_PATH_PATTERN = Pattern.compile("^(/(usr|var))?/tmp(/.*)?$");
    
    private static final String[] WRITE_METHODS = {
        "io.ioutil.WriteFile",
        "os.Create",
        "os.WriteFile"
    };
    
    private static final String[] TEMP_DIR_METHODS = {
        "os.TempDir"
    };
    
    private static final String[] PATH_JOIN_METHODS = {
        "path.Join",
        "path.filepath.Join"
    };

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        String image = node.getImage();
        
        // Check if method call matches known write methods
        for (String writeMethod : WRITE_METHODS) {
            String[] parts = writeMethod.split("\\.");
            if (image.endsWith(parts[0]) && methodName.equals(parts[1])) {
                // Check first argument for temp directory patterns
                if (node.getArguments().size() > 0) {
                    ASTExpression firstArg = node.getArguments().get(0);
                    if (checkTempDirArg(firstArg)) {
                        addViolation(data, node);
                    }
                }
            }
        }
        
        return super.visit(node, data);
    }
    
    private boolean checkTempDirArg(ASTExpression expr) {
        // Check for string literals
        if (expr instanceof ASTLiteral) {
            ASTLiteral literal = (ASTLiteral)expr;
            if (literal.isStringLiteral()) {
                String strValue = literal.getImage().replace("\"", "");
                return TEMP_PATH_PATTERN.matcher(strValue).matches();
            }
        }
        
        // Check for temp directory method calls
        if (expr instanceof ASTMethodCall) {
            ASTMethodCall methodCall = (ASTMethodCall)expr;
            for (String tempMethod : TEMP_DIR_METHODS) {
                String[] parts = tempMethod.split("\\.");
                if (methodCall.getImage().endsWith(parts[0]) &&
                    methodCall.getMethodName().equals(parts[1])) {
                    return true;
                }
            }
        }
        
        // Check for binary expressions
        if (expr instanceof ASTBinaryExpression) {
            ASTBinaryExpression binary = (ASTBinaryExpression)expr;
            return checkTempDirArg(binary.getLeftOperand()) || 
                   checkTempDirArg(binary.getRightOperand());
        }
        
        // Check for nested path join calls
        if (expr instanceof ASTMethodCall) {
            ASTMethodCall methodCall = (ASTMethodCall)expr;
            for (String joinMethod : PATH_JOIN_METHODS) {
                String[] parts = joinMethod.split("\\.");
                if (methodCall.getImage().endsWith(parts[0]) &&
                    methodCall.getMethodName().equals(parts[1]) &&
                    methodCall.getArguments().size() > 0) {
                    return checkTempDirArg(methodCall.getArguments().get(0));
                }
            }
        }
        
        return false;
    }
}
