为解决WeakCryptographyEncryptionRule中的错误，按以下步骤修改：

1. 更新AST节点引用：
   - 将ASTNameExpr改为ASTMethodCall
   - 添加ASTImportDeclaration检查支持

2. 修正包路径匹配：
   - 使用完整包路径前缀匹配
   - 添加对方法调用的精确检查

3. 更新规则实现：
   - 使用现代PMD API报告违规
   - 添加对多种调用形式的支持

# 修改后的规则代码
package com.example.pmdrules;

import net.sourceforge.pmd.lang.java.ast.ASTMethodCall;
import net.sourceforge.pmd.lang.java.ast.ASTImportDeclaration;
import net.sourceforge.pmd.lang.java.rule.AbstractJavaRule;
import java.util.HashMap;
import java.util.Map;

public class WeakCryptographyEncryptionRule extends AbstractJavaRule {
    private static final Map<String, String[]> BLOCKLIST = new HashMap<>();

    static {
        BLOCKLIST.put("crypto.des", new String[]{"NewCipher", "NewTripleDESCipher"});
        BLOCKLIST.put("crypto.rc4", new String[]{"NewCipher"});
    }

    public WeakCryptographyEncryptionRule() {
        setMessage("Use of weak cryptographic primitive");
    }

    @Override
    public Object visit(ASTMethodCall node, Object data) {
        String methodName = node.getMethodName();
        String className = node.getQualifier() != null ? node.getQualifier().toString() : "";
        
        for (Map.Entry<String, String[]> entry : BLOCKLIST.entrySet()) {
            String pkg = entry.getKey();
            for (String func : entry.getValue()) {
                if ((className.startsWith(pkg) || className.equals(pkg)) 
                    && methodName.equals(func)) {
                    addViolation(data, node);
                    break;
                }
            }
        }
        return super.visit(node, data);
    }

    @Override
    public Object visit(ASTImportDeclaration node, Object data) {
        String imported = node.getImportedName();
        for (String pkg : BLOCKLIST.keySet()) {
            if (imported.startsWith(pkg)) {
                addViolation(data, node);
                break;
            }
        }
        return super.visit(node, data);
    }
}
