package rules

import (
	"go/ast"
	"go/types"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type sqlInjection struct {
	issue.MetaData
	dbCalls   gosec.CallList
	sourceTypes []string
}

func (s *sqlInjection) ID() string {
	return s.MetaData.ID
}

func (s *sqlInjection) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	if node := s.dbCalls.ContainsPkgCallExpr(n, c, false); node != nil {
		if len(node.Args) > 0 {
			arg := node.Args[0]
			var argType types.Type
			
			if ident, ok := arg.(*ast.Ident); ok {
				if ident.Obj != nil {
					decl := ident.Obj.Decl
					if assign, ok := decl.(*ast.AssignStmt); ok {
						for _, expr := range assign.Rhs {
							if call, ok := expr.(*ast.CallExpr); ok {
								fn := c.Info.TypeOf(call.Fun)
								if fn != nil && fn.String() == "github.com/aws/aws-lambda-go/lambda.Start" {
									return c.NewIssue(n, s.ID(), s.What, s.Severity, s.Confidence), nil
								}
							}
						}
					}
				}
			}
		}
	}
	return nil, nil
}

func NewSqlInjection(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	calls := gosec.NewCallList()
	calls.Add("database/sql", "Exec")
	calls.Add("database/sql", "ExecContext")
	calls.Add("database/sql", "Query")
	calls.Add("database/sql", "QueryContext")
	calls.Add("database/sql", "QueryRow")
	calls.Add("database/sql", "QueryRowContext")
	
	return &sqlInjection{
		dbCalls: calls,
		sourceTypes: []string{},
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.Medium,
			Confidence: issue.Medium,
			What:       "Detected SQL statement that is tainted by event object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized. In order to prevent SQL injection, use parameterized queries or prepared statements instead. References: https://pkg.go.dev/database/sql#DB.Query",
		},
	}, []ast.Node{(*ast.CallExpr)(nil)}
}
