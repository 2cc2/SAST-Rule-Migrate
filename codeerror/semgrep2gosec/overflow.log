package rules

import (
	"go/ast"
	"go/types"
	"strconv"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type integerOverflow struct {
	issue.MetaData
	callList gosec.CallList
	bitSize  int
}

func (i *integerOverflow) ID() string {
	return i.MetaData.ID
}

func (i *integerOverflow) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	if node := i.callList.ContainsPkgCallExpr(n, c, false); node != nil {
		if len(node.Args) > 0 {
			if lit, ok := node.Args[0].(*ast.BasicLit); ok {
				if lit.Kind == token.STRING {
					strVal := lit.Value
					if strVal[0] == '"' && strVal[len(strVal)-1] == '"' {
						strVal = strVal[1 : len(strVal)-1]
					}
					num, err := strconv.ParseInt(strVal, 10, 64)
					if err != nil {
						return nil, nil
					}

					var overflow bool
					if i.bitSize == 16 {
						overflow = num > 32767 || num < -32768
					} else if i.bitSize == 32 {
						overflow = num > 2147483647 || num < -2147483648
					}

					if overflow {
						return c.NewIssue(n, i.ID(), i.What, i.Severity, i.Confidence), nil
					}
				}
			}
		}
	}
	return nil, nil
}

func NewIntegerOverflow(id string, bitSize int, what string) (gosec.Rule, []ast.Node) {
	callList := gosec.NewCallList()
	callList.Add("strconv", "Atoi")
	return &integerOverflow{
		callList: callList,
		bitSize:  bitSize,
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.Medium,
			Confidence: issue.High,
			What:       what,
		},
	}, []ast.Node{(*ast.CallExpr)(nil), (*ast.CallExpr)(nil)}
}

func NewIntegerOverflowInt16(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	return NewIntegerOverflow(
		id,
		16,
		"Detected conversion of the result of a strconv.Atoi command to an int16. This could lead to an integer overflow which could possibly result in unexpected behavior and even privilege escalation. Instead, use strconv.ParseInt",
	)
}

func NewIntegerOverflowInt32(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	return NewIntegerOverflow(
		id,
		32,
		"Detected conversion of the result of a strconv.Atoi command to an int32. This could lead to an integer overflow which could possibly result in unexpected behavior and even privilege escalation. Instead, use strconv.ParseInt",
	)
}
