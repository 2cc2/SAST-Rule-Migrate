package rules

import (
	"go/ast"
	"go/types"
	"strconv"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type intOverflow struct {
	issue.MetaData
	targetType string
	maxValue   int64
	minValue   int64
	calls      gosec.CallList
}

func (i *intOverflow) ID() string {
	return i.MetaData.ID
}

func (i *intOverflow) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	if callExpr := i.calls.ContainsPkgCallExpr(n, c, false); callExpr != nil {
		if _, ok := callExpr.Fun.(*ast.SelectorExpr); ok {
			if len(callExpr.Args) > 0 {
				if basicLit, ok := callExpr.Args[0].(*ast.BasicLit); ok {
					val, err := strconv.ParseInt(basicLit.Value, 10, 64)
					if err != nil {
						return nil, nil
					}
					if val > i.maxValue || val < i.minValue {
						return c.NewIssue(n, i.ID(), i.What, i.Severity, i.Confidence), nil
					}
				}
			}
		}
	}

	if node, ok := n.(*ast.CallExpr); ok {
		if ident, ok := node.Fun.(*ast.Ident); ok && ident.Name == i.targetType {
			if len(node.Args) > 0 {
				if ident, ok := node.Args[0].(*ast.Ident); ok {
					if assign := c.Info.ObjectOf(ident).Decl; assign != nil {
						if assignStmt, ok := assign.(*ast.AssignStmt); ok {
							if callExpr, ok := assignStmt.Rhs[0].(*ast.CallExpr); ok {
								if selExpr, ok := callExpr.Fun.(*ast.SelectorExpr); ok {
									if pkgIdent, ok := selExpr.X.(*ast.Ident); ok && pkgIdent.Name == "strconv" && selExpr.Sel.Name == "Atoi" {
										return c.NewIssue(n, i.ID(), i.What, i.Severity, i.Confidence), nil
									}
								}
							}
						}
					}
				}
			}
		}
	}
	return nil, nil
}

func NewIntOverflow(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	var targetType string
	var maxValue, minValue int64

	switch id {
	case "integer-overflow-int16":
		targetType = "int16"
		maxValue = 32767
		minValue = -32768
	case "integer-overflow-int32":
		targetType = "int32"
		maxValue = 2147483647
		minValue = -2147483648
	}

	calls := gosec.NewCallList()
	calls.Add("strconv", "Atoi")

	return &intOverflow{
		calls:      calls,
		targetType: targetType,
		maxValue:   maxValue,
		minValue:   minValue,
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.Medium,
			Confidence: issue.High,
			What:       "Detected conversion of strconv.Atoi result to " + targetType + " which could lead to integer overflow. Use strconv.ParseInt instead.",
		},
	}, []ast.Node{(*ast.CallExpr)(nil), (*ast.BasicLit)(nil)}
}
