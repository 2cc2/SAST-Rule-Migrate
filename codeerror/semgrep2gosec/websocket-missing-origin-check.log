package rules

import (
	"go/ast"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type websocketOriginCheckRule struct {
	issue.MetaData
}

func (r *websocketOriginCheckRule) ID() string {
	return r.MetaData.ID
}

func (r *websocketOriginCheckRule) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	// 检查是否调用Upgrade方法
	callExpr, ok := n.(*ast.CallExpr)
	if !ok {
		return nil, nil
	}

	// 检查是否为websocket.Upgrader的Upgrade方法
	selector, ok := callExpr.Fun.(*ast.SelectorExpr)
	if !ok {
		return nil, nil
	}

	if ident, ok := selector.X.(*ast.Ident); !ok || ident.Name != "Upgrader" {
		return nil, nil
	}

	if selector.Sel.Name != "Upgrade" {
		return nil, nil
	}

	// 检查是否有CheckOrigin设置
	for _, f := range c.PkgInfo.Pkg.Files {
		ast.Inspect(f, func(node ast.Node) bool {
			// 检查Upgrader结构体中是否有CheckOrigin字段
			if compLit, ok := node.(*ast.CompositeLit); ok {
				if typeIdent, ok := compLit.Type.(*ast.Ident); ok && typeIdent.Name == "Upgrader" {
					for _, elt := range compLit.Elts {
						if kv, ok := elt.(*ast.KeyValueExpr); ok {
							if ident, ok := kv.Key.(*ast.Ident); ok && ident.Name == "CheckOrigin" {
