package rules

import (
	"go/ast"
	"go/types"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type websocketOriginCheck struct {
	issue.MetaData
	upgraderCall gosec.CallList
	assignCheck  gosec.CallList
}

func (w *websocketOriginCheck) ID() string {
	return w.MetaData.ID
}

func (w *websocketOriginCheck) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	if _, ok := n.(*ast.ImportSpec); ok {
		return nil, nil
	}

	if assign, ok := n.(*ast.AssignStmt); ok {
		for _, expr := range assign.Lhs {
			if selector, ok := expr.(*ast.SelectorExpr); ok {
				if sel, ok := selector.X.(*ast.Ident); ok {
					if w.upgraderCall.Contains(sel.Name+".CheckOrigin", c) == nil {
						return c.NewIssue(n, w.ID(), w.What, w.Severity, w.Confidence), nil
					}
				}
			}
		}
	}

	if node := w.upgraderCall.ContainsPkgCallExpr(n, c, false); node != nil {
		hasCheckOrigin := checksForOriginCheck(node, c)

		if !hasCheckOrigin {
			return c.NewIssue(n, w.ID(), w.What, w.Severity, w.Confidence), nil
		}
	}
	return nil, nil
}

func checksForOriginCheck(node ast.Node, c *gosec.Context) bool {
	if compLit, ok := node.(*ast.CompositeLit); ok {
		for _, elt := range compLit.Elts {
			if kv, ok := elt.(*ast.KeyValueExpr); ok {
				if ident, ok := kv.Key.(*ast.Ident); ok && ident.Name == "CheckOrigin" {
					return true
				}
			}
		}
	}
	return false
}

func NewWebsocketOriginCheck(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	upgraderCall := gosec.NewCallList()
	upgraderCall.Add("github.com/gorilla/websocket", "Upgrader.Upgrade")

	return &websocketOriginCheck{
		upgraderCall: upgraderCall,
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.Medium,
			Confidence: issue.Medium,
			What:       "Potential CSRF vulnerability in websocket upgrade - missing Origin header check",
		},
	}, []ast.Node{(*ast.CallExpr)(nil), (*ast.AssignStmt)(nil)}
}
