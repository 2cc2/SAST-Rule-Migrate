package rules

import (
	"go/ast"
	"strings"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type handlerAssignmentRule struct {
	issue.MetaData
}

func (r *handlerAssignmentRule) ID() string {
	return r.MetaData.ID
}

func (r *handlerAssignmentRule) Match(n ast.Node, ctx *gosec.Context) (*issue.Issue, error) {
	if funcDecl, ok := n.(*ast.FuncDecl); ok {
		// Check if it's a HTTP handler function
		for _, param := range funcDecl.Type.Params.List {
			if starExpr, ok := param.Type.(*ast.StarExpr); ok {
				if ident, ok := starExpr.X.(*ast.Ident); ok && ident.Name == "Request" {
					// Look for suspicious assignments
					for _, stmt := range funcDecl.Body.List {
						if assignStmt, ok := stmt.(*ast.AssignStmt); ok {
							for i, rhs := range assignStmt.Rhs {
								if ident, ok := rhs.(*ast.Ident); ok && ident.Name == "R" {
									lhs := assignStmt.Lhs[i]
									if lhsIdent, ok := lhs.(*ast.Ident); ok {
										// Check if the variable was previously assigned from store.Get()
										for _, prevStmt := range funcDecl.Body.List {
											if prevAssign, ok := prevStmt.(*ast.AssignStmt); ok {
												if callExpr, ok := prevAssign.Rhs[0].(*ast.CallExpr); ok {
													if selector, ok := callExpr.Fun.(*ast.SelectorExpr); ok {
														if selector.Sel.Name == "Get" && strings.Contains(ctx.ToString(selector.X), "store") {
															return ctx.NewIssue(n, r.ID(), r.What, r.Severity, r.Confidence), nil
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
	return nil, nil
}

func NewHandlerAssignmentRule(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	return &handlerAssignmentRule{
		MetaData: issue.MetaData{
			ID:         id,
			What:       "Variable is assigned from two different sources ('store.Get()' and 'http.Request'). Make sure this is intended, as this could cause logic bugs if they are treated as the same object.",
			Severity:   issue.Medium,
			Confidence: issue.Medium,
			Cwe:        issue.GetCweByID("289"),
		},
	}, []ast.Node{(*ast.FuncDecl)(nil)}
}
