            package rules

import (
	"go/ast"
	"strings"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type newFuncRule struct {
	issue.MetaData
}

func (r *newFuncRule) ID() string {
	return r.MetaData.ID
}

func (r *newFuncRule) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	// 目标是匹配函数定义
	if fn, ok := n.(*ast.FuncDecl); ok {
		if fn.Name != nil && strings.HasPrefix(fn.Name.Name, "New") {
			return c.NewIssue(n, r.ID(), r.What, r.Severity, r.Confidence), nil
		}
	}
	return nil, nil
}

func NewFuncStartsWithnew(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	return &newFuncRule{
		MetaData: issue.MetaData{
			ID:         id,
			What:       "Function name starts with 'New', may indicate factory pattern.",
			Severity:   issue.Low,
			Confidence: issue.Medium,
		},
	}, []ast.Node{(*ast.FuncDecl)(nil)}
}
