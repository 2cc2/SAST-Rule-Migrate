package rules

import (
	"go/ast"
	"go/types"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type hardcodedJWTKey struct {
	issue.MetaData
	byteCalls    gosec.CallList
	signingCalls gosec.CallList
}

func (h *hardcodedJWTKey) ID() string {
	return h.MetaData.ID
}

func (h *hardcodedJWTKey) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	// Check for byte slice with hardcoded string
	if node := h.byteCalls.ContainsPkgCallExpr(n, c, false); node != nil {
		// Check if this value is used in SignedString
		for _, arg := range node.Args {
			if basicLit, ok := arg.(*ast.BasicLit); ok && basicLit.Kind == token.STRING {
				if parent := c.GetParent(); parent != nil {
					if callExpr, ok := parent.(*ast.CallExpr); ok {
						if h.signingCalls.ContainsPkgCallExpr(callExpr, c, false) != nil {
							return c.NewIssue(n, h.ID(), "Hard-coded JWT key detected: "+h.What, h.Severity, h.Confidence), nil
						}
					}
				}
			}
		}
	}
	return nil, nil
}

// NewHardcodedJWTKey detects hardcoded credentials used in JWT signing operations
func NewHardcodedJWTKey(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	byteCalls := gosec.NewCallList()
	byteCalls.Add("", "[]byte")

	signingCalls := gosec.NewCallList()
	signingCalls.Add("github.com/dgrijalva/jwt-go", "Token.SignedString")

	return &hardcodedJWTKey{
		byteCalls:    byteCalls,
		signingCalls: signingCalls,
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.Medium,
			Confidence: issue.High,
			What:       "Hard-coded JWT keys are insecure as they risk secrets being leaked. Use environment variables or secure vaults instead. CWE-798: Use of Hard-coded Credentials. OWASP A07:2021 - Identification and Authentication Failures",
		},
	}, []ast.Node{(*ast.CallExpr)(nil)}
}
