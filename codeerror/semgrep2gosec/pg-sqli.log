package rules

import (
	"go/ast"
	"go/token"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type pgSQLi struct {
	issue.MetaData
	dbMethods gosec.CallList
	pgConnect gosec.CallList
}

func isStringLiteral(n ast.Node) bool {
	if basicLit, ok := n.(*ast.BasicLit); ok {
		return basicLit.Kind == token.STRING
	}
	return false
}

func (p *pgSQLi) isConcatWithNonLiteral(n ast.Node) bool {
	if assign, ok := n.(*ast.AssignStmt); ok {
		if len(assign.Rhs) == 1 {
			switch rhs := assign.Rhs[0].(type) {
			case *ast.BinaryExpr:
				return !isStringLiteral(rhs.X) || !isStringLiteral(rhs.Y)
			case *ast.CallExpr:
				if sel, ok := rhs.Fun.(*ast.SelectorExpr); ok {
					if sel.Sel.Name == "Sprintf" {
						return true
					}
				}
			}
		}
	}
	return false
}

func (p *pgSQLi) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	if node := p.dbMethods.ContainsPkgCallExpr(n, c, false); node != nil {
		if _, ok := node.Fun.(*ast.SelectorExpr); ok {
			for _, arg := range node.Args {
				switch expr := arg.(type) {
				case *ast.BinaryExpr:
					if !isStringLiteral(expr.X) || !isStringLiteral(expr.Y) {
						return c.NewIssue(n, p.MetaData.ID, p.What, p.Severity, p.Confidence), nil
					}
				case *ast.CallExpr:
					if selExpr, ok := expr.Fun.(*ast.SelectorExpr); ok &&
						selExpr.Sel.Name == "Sprintf" {
						return c.NewIssue(n, p.MetaData.ID, p.What, p.Severity, p.Confidence), nil
					}
				}
			}
		}
	}
	return nil, nil
}

func NewPgSQLi(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	dbMethods := gosec.NewCallList()
	dbMethods.Add("github.com/go-pg/pg/v10", "Exec")
	dbMethods.Add("github.com/go-pg/pg/v10", "ExecContext")
	dbMethods.Add("github.com/go-pg/pg/v10", "ExecOne")
	dbMethods.Add("github.com/go-pg/pg/v10", "ExecOneContext")
	dbMethods.Add("github.com/go-pg/pg/v10", "Query")
	dbMethods.Add("github.com/go-pg/pg/v10", "QueryOne")
	dbMethods.Add("github.com/go-pg/pg/v10", "QueryContext")
	dbMethods.Add("github.com/go-pg/pg/v10", "QueryOneContext")

	pgConnect := gosec.NewCallList()
	pgConnect.Add("github.com/go-pg/pg/v10", "Connect")

	return &pgSQLi{
		dbMethods: dbMethods,
		pgConnect: pgConnect,
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.High,
			Confidence: issue.Low,
			What:       "Potential SQL injection via string concatenation in go-pg query. Use parameterized queries instead. CWE-89, OWASP A01/A03",
		},
	}, []ast.Node{(*ast.CallExpr)(nil), (*ast.AssignStmt)(nil)}
}
