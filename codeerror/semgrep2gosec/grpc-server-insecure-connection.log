package rules

import (
	"go/ast"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type insecureGRPCServer struct {
	issue.MetaData
	serverCalls gosec.CallList
	credsCalls  gosec.CallList
}

func (i *insecureGRPCServer) ID() string {
	return i.MetaData.ID
}

func (i *insecureGRPCServer) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	// Check for insecure NewServer calls
	if node := i.serverCalls.ContainsPkgCallExpr(n, c, false); node != nil {
		// Check if NewServer has options but no Creds
		if len(node.Args) > 0 {
			hasCreds := false
			for _, arg := range node.Args {
				if i.credsCalls.Contains(arg, c) != nil {
					hasCreds = true
					break
				}
			}
			if !hasCreds {
				return c.NewIssue(n, i.ID(), i.What, i.Severity, i.Confidence), nil
			}
		} else {
			// Empty constructor case
			return c.NewIssue(n, i.ID(), i.What, i.Severity, i.Confidence), nil
		}
	}
	return nil, nil
}

func NewInsecureGRPCServer(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	serverCalls := gosec.NewCallList()
	serverCalls.Add("google.golang.org/grpc", "NewServer")

	credsCalls := gosec.NewCallList()
	credsCalls.Add("google.golang.org/grpc", "Creds")

	return &insecureGRPCServer{
		serverCalls: serverCalls,
		credsCalls:  credsCalls,
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.High,
			Confidence: issue.High,
			What: "Found an insecure gRPC server without 'grpc.Creds()' or options with credentials. " +
				"This allows for a connection without encryption. Include credentials derived from " +
				"an SSL certificate to create a secure gRPC connection. CWE-300: Channel Accessible by Non-Endpoint",
		},
	}, []ast.Node{(*ast.CallExpr)(nil)}
}
