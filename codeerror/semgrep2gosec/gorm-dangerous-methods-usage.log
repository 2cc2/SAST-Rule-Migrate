Rule Content:
package rules

import (
	"go/ast"
	"regexp"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type gormDangerousMethod struct {
	issue.MetaData
	gormCalls gosec.CallList
	dangerous *regexp.Regexp
	request   *regexp.Regexp
}

func (g *gormDangerousMethod) ID() string {
	return g.MetaData.ID
}

func (g *gormDangerousMethod) Match(n ast.Node, ctx *gosec.Context) (*issue.Issue, error) {
	// Check if node is a method call on gorm.DB
	if node := g.gormCalls.ContainsPkgCallExpr(n, ctx, false); node != nil {
		// Get method name
		methodName, ok := node.(*ast.CallExpr).Fun.(*ast.SelectorExpr).Sel.Name
		if !ok {
			return nil, nil
		}

		// Check if method is dangerous
		if g.dangerous.MatchString(methodName) {
			// Check arguments
			for _, arg := range node.(*ast.CallExpr).Args {
				// Match argument is from request
				if ident, ok := arg.(*ast.Ident); ok {
					if ident.Obj != nil {
						if assign, ok := ident.Obj.Decl.(*ast.AssignStmt); ok {
							if selector, ok := assign.Rhs[0].(*ast.SelectorExpr); ok {
								if id, ok := selector.X.(*ast.Ident); ok {
									typeInfo := ctx.Info.TypeOf(id)
									if typeInfo != nil && g.request.MatchString(typeInfo.String()) {
										return ctx.NewIssue(n, g.ID(), g.What, g.Severity, g.Confidence), nil
									}
								}
							}
						}
					}

					// Check selector expressions
					if selector, ok := arg.(*ast.SelectorExpr); ok {
						typeInfo := ctx.Info.TypeOf(selector.X)
						if typeInfo != nil && g.request.MatchString(typeInfo.String()) {
							return ctx.NewIssue(n, g.ID(), g.What, g.Severity, g.Confidence), nil
						}
					}
				}
			}
		}
	}
	return nil, nil
}

func NewGormDangerousMethod(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	gormCalls := gosec.NewCallList()
	gormCalls.Add("gorm.io/gorm", "DB")

	return &gormDangerousMethod{
		gormCalls: gormCalls,
		dangerous: regexp.MustCompile(`^(Order|Exec|Raw|Group|Having|Distinct|Select|Pluck)$`),
		request:   regexp.MustCompile(`^(http\.Request|\*http\.Request)$`),
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.Medium,
			Confidence: issue.High,
			What: "Detected usage of dangerous GORM method which does not escape inputs. " +
				"If the argument is user-controlled, this can lead to SQL injection. " +
				"When using these methods, do not trust user-submitted data and only allow approved input.",
			Cwe: issue.GetCweByID("89"),
		},
	}, []ast.Node{(*ast.CallExpr)(nil)}
}
