package rules

import (
	"go/ast"
	"go/types"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type gormDangerousMethod struct {
	issue.MetaData
	gormCalls gosec.CallList
	methods   []string
}

func (g *gormDangerousMethod) ID() string {
	return g.MetaData.ID
}

func (g *gormDangerousMethod) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	if node := g.gormCalls.ContainsPkgCallExpr(n, c, false); node != nil {
		if ident, ok := node.Fun.(*ast.SelectorExpr); ok {
			methodName := ident.Sel.Name
			for _, m := range g.methods {
				if methodName == m {
					for _, arg := range node.Args {
						if callExpr, ok := arg.(*ast.CallExpr); ok {
							if selector, ok := callExpr.Fun.(*ast.SelectorExpr); ok {
								if selector.Sel.Name == "Atoi" {
									continue
								}
							}
						}
						return c.NewIssue(n, g.ID(), g.What, g.Severity, g.Confidence), nil
					}
				}
			}
		}
	}
	return nil, nil
}

func NewGormDangerousMethod(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	calls := gosec.NewCallList()
	calls.Add("gorm.io/gorm", "Order")
	calls.Add("gorm.io/gorm", "Exec")
	calls.Add("gorm.io/gorm", "Raw")
	calls.Add("gorm.io/gorm", "Group")
	calls.Add("gorm.io/gorm", "Having")
	calls.Add("gorm.io/gorm", "Distinct")
	calls.Add("gorm.io/gorm", "Select")
	calls.Add("gorm.io/gorm", "Pluck")
	
	return &gormDangerousMethod{
		gormCalls: calls,
		methods:   []string{"Order", "Exec", "Raw", "Group", "Having", "Distinct", "Select", "Pluck"},
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.Medium,
			Confidence: issue.High,
			What:       "Detected usage of dangerous method which does not escape inputs. If the argument is user-controlled, this can lead to SQL injection.",
			MetaData: issue.MetaData{
				Cwe:    "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')",
				Owasp:  "A01:2017 - Injection, A03:2021 - Injection",
				References: []string{
					"https://gorm.io/docs/security.html#SQL-injection-Methods",
					"https://cheatsheetseries.owasp.org/cheatsheets/SQL_Injection_Prevention_Cheat_Sheet.html",
				},
			},
		},
	}, []ast.Node{(*ast.CallExpr)(nil)}
}
