package rules

import (
	"go/ast"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type jwtNoneAlg struct {
	issue.MetaData
	jwtImports gosec.CallList
	noneSigns  gosec.CallList
}

func (n *jwtNoneAlg) ID() string {
	return n.MetaData.ID
}

func (n *jwtNoneAlg) Match(nod ast.Node, ctx *gosec.Context) (*issue.Issue, error) {
	// Check for JWT imports
	if imported, _, _ := ctx.Imported.GetImport("github.com/dgrijalva/jwt-go", "jwt"); imported {
		if node := n.noneSigns.ContainsPkgCallExpr(nod, ctx, false); node != nil {
			return ctx.NewIssue(nod, n.ID(), n.What, n.Severity, n.Confidence), nil
		}
	}
	if imported, _, _ := ctx.Imported.GetImport("github.com/golang-jwt/jwt", "jwt"); imported {
		if node := n.noneSigns.ContainsPkgCallExpr(nod, ctx, false); node != nil {
			return ctx.NewIssue(nod, n.ID(), n.What, n.Severity, n.Confidence), nil
		}
	}
	return nil, nil
}

func NewJWTNoneAlgorithm(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	noneSigns := gosec.NewCallList()
	noneSigns.Add("github.com/dgrijalva/jwt-go", "SigningMethodNone")
	noneSigns.Add("github.com/dgrijalva/jwt-go", "UnsafeAllowNoneSignatureType")
	noneSigns.Add("github.com/golang-jwt/jwt", "SigningMethodNone")
	noneSigns.Add("github.com/golang-jwt/jwt", "UnsafeAllowNoneSignatureType")

	return &jwtNoneAlg{
		jwtImports: gosec.NewCallList(),
		noneSigns:  noneSigns,
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.High,
			Confidence: issue.High,
			What:       "Detected use of the 'none' algorithm in a JWT token. The 'none' algorithm assumes the integrity of the token has already been verified. This would allow a malicious actor to forge a JWT token that will automatically be verified. Do not explicitly use the 'none' algorithm. Instead, use an algorithm such as 'HS256'. CWE: CWE-327, OWASP: A03:2017, A02:2021",
		},
	}, []ast.Node{(*ast.CallExpr)(nil)}
}
