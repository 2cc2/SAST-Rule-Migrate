package rules

import (
	"go/ast"
	"go/types"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type xssResponseWriterPrintf struct {
	issue.MetaData
	responseWriter gosec.CallList
	printf         gosec.CallList
	urlQuery       gosec.CallList
}

func (x *xssResponseWriterPrintf) ID() string {
	return x.MetaData.ID
}

func (x *xssResponseWriterPrintf) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	// Check for ResponseWriter.Write with fmt.Printf inside
	if node := x.printf.ContainsPkgCallExpr(n, c, false); node != nil {
		// Find parent ResponseWriter.Write call
		if funcDecl, ok := c.ParentStack[len(c.ParentStack)-1].(*ast.FuncDecl); ok {
			for _, field := range funcDecl.Type.Params.List {
				if sel, ok := field.Type.(*ast.SelectorExpr); ok {
					if ident, ok := sel.X.(*ast.Ident); ok && ident.Name == "http" && sel.Sel.Name == "ResponseWriter" {
						return c.NewIssue(n, x.ID(), x.What, x.Severity, x.Confidence), nil
					}
				}
			}
		}

		// Check if any argument comes from URL query params
		for _, arg := range node.Args {
			if ident, ok := arg.(*ast.Ident); ok {
				// Check if the variable comes from URL.Query()
				if ident.Obj != nil && ident.Obj.Kind == ast.Var {
					if assign, ok := ident.Obj.Decl.(*ast.AssignStmt); ok {
						for _, rhs := range assign.Rhs {
							if callExpr, ok := rhs.(*ast.CallExpr); ok {
								if x.urlQuery.ContainsPkgCallExpr(callExpr, c, false) != nil {
									return c.NewIssue(n, x.ID(), x.What, x.Severity, x.Confidence), nil
								}
							}
						}
					}
				}
			}
		}
	}
	return nil, nil
}

func NewXSSResponseWriterPrintf(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	printf := gosec.NewCallList()
	printf.Add("fmt", "Printf")
	printf.Add("fmt", "Sprintf")
	printf.Add("fmt", "Fprintf")

	urlQuery := gosec.NewCallList()
	urlQuery.Add("net/url", "Values")

	return &xssResponseWriterPrintf{
		printf:   printf,
		urlQuery: urlQuery,
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.Medium,
			Confidence: issue.Medium,
			What: "Found data going from url query parameters into formatted data written to ResponseWriter. " +
				"This could be XSS and should not be done. If you must do this, ensure your data is sanitized or escaped. " +
				"CWE-79: Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting') " +
				"OWASP A07:2017 - Cross-Site Scripting (XSS) " +
				"A03:2021 - Injection",
		},
	}, []ast.Node{(*ast.CallExpr)(nil)}
}
