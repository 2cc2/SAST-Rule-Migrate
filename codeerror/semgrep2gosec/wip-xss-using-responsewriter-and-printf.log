package rules

import (
	"go/ast"
	"go/types"

	"github.com/securego/gosec/v2"
	"github.com/securego/gosec/v2/issue"
)

type xssResponseWriter struct {
	issue.MetaData
	queryCalls  gosec.CallList
	writeCalls  gosec.CallList
	printfCalls gosec.CallList
}

func (x *xssResponseWriter) ID() string {
	return x.MetaData.ID
}

func (x *xssResponseWriter) Match(n ast.Node, c *gosec.Context) (*issue.Issue, error) {
	// Check for patterns where URL query params are directly written via fmt.Printf
	switch node := n.(type) {
	case *ast.CallExpr:
		// Check if it's a ResponseWriter.Write call
		if x.writeCalls.ContainsPkgCallExpr(node, c, false) != nil {
			// Check if the argument is a fmt.Printf call
			if arg, ok := node.Args[0].(*ast.CallExpr); ok {
				if x.printfCalls.ContainsPkgCallExpr(arg, c, false) != nil {
					// Check if any printf arguments come from URL.Query()
					for _, printfArg := range arg.Args[1:] {
						if x.isQueryData(printfArg, c) {
							return c.NewIssue(n, x.ID(), x.What, x.Severity, x.Confidence), nil
						}
					}
				}
			}
		}
	}
	return nil, nil
}

func (x *xssResponseWriter) isQueryData(n ast.Node, c *gosec.Context) bool {
	// Check if the node is ultimately derived from r.URL.Query()
	switch expr := n.(type) {
	case *ast.Ident:
		if expr.Obj != nil {
			if assign, ok := expr.Obj.Decl.(*ast.AssignStmt); ok {
				for _, rhs := range assign.Rhs {
					if x.isQueryCall(rhs, c) {
						return true
					}
				}
			}
		}
	case *ast.IndexExpr:
		return x.isQueryData(expr.X, c)
	case *ast.CallExpr:
		return x.isQueryCall(expr, c)
	}
	return false
}

func (x *xssResponseWriter) isQueryCall(n ast.Node, c *gosec.Context) bool {
	if call, ok := n.(*ast.CallExpr); ok {
		if selExpr, ok := call.Fun.(*ast.SelectorExpr); ok {
			if x.queryCalls.Contains(call, c, false) != nil {
				return true
			}
			// Handle r.URL.Query() pattern
			if selExpr.Sel != nil && selExpr.Sel.Name == "Query" {
				if selX, ok := selExpr.X.(*ast.SelectorExpr); ok {
					if selX.Sel != nil && selX.Sel.Name == "URL" {
						return true
					}
				}
			}
		}
	}
	return false
}

func NewXSSResponseWriter(id string, _ gosec.Config) (gosec.Rule, []ast.Node) {
	queryCalls := gosec.NewCallList()
	writeCalls := gosec.NewCallList()
	writeCalls.Add("net/http", "ResponseWriter.Write")
	printfCalls := gosec.NewCallList()
	printfCalls.Add("fmt", "Printf")
	printfCalls.Add("fmt", "Sprintf")
	printfCalls.Add("fmt", "Fprintf")

	return &xssResponseWriter{
		queryCalls:  queryCalls,
		writeCalls:  writeCalls,
		printfCalls: printfCalls,
		MetaData: issue.MetaData{
			ID:         id,
			Severity:   issue.Medium,
			Confidence: issue.Medium,
			What: "Found data going from url query parameters into formatted data written to ResponseWriter. " +
				"This could be XSS and should not be done. If you must do this, ensure your data is sanitized or escaped. " +
				"CWE: CWE-79: Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting'). " +
				"OWASP: A07:2017 - Cross-Site Scripting (XSS), A03:2021 - Injection",
		},
	}, []ast.Node{(*ast.CallExpr)(nil)}
}
