# 修改策略：
# 1. 识别到错误是由于metavariable的patterns结构不符合Semgrep的schema要求
# 2. 原规则中的pattern-either应直接位于metavariables.patterns下，而非嵌套在另一个patterns层中
# 3. 需要将patterns层级简化，把pattern-either提升到顶层
# 4. 保持原有功能和检测逻辑不变，只是调整结构

rules:
  - id: insecure-tls-config
    message: Insecure TLS configuration detected
    languages: [go]
    severity: WARNING
    patterns:
      - pattern: |
          &tls.Config{
            MinVersion: $VERSION,
            ...
          }
        metavariables:
          - metavariable: $VERSION
            patterns:
              - pattern-either:
                - pattern: "0x0301"
                - pattern: "0x0302"
                - pattern: "0x0303"

      - not:
          pattern: |
            &tls.Config{
              CipherSuites: []uint16{
                $CIPHER,
                ...
              },
              ...
            }
          metavariables:
            - metavariable: $CIPHER
              patterns:
