Rule content: rules:
  - id: potential-file-inclusion-via-variable
    message: Potential file inclusion via variable
    languages:
      - go
    severity: WARNING
    patterns:
      - pattern-either:
          - pattern: |
              $FUNC(..., path/filepath.Join($...), ...)
          - pattern: |
              $FUNC(..., path.Join($...), ...)
          - pattern: |
              $FUNC(..., $X + $Y, ...)
          - pattern: |
              $FUNC(..., $VAR, ...)
              $NOT_VAR = path/filepath.Clean($VAR)
          - pattern: |
              $FUNC(..., $VAR, ...)
              $NOT_VAR = path/filepath.Rel($VAR)
          - pattern: |
              $FUNC(..., $VAR, ...)
              $NOT_VAR = path/filepath.EvalSymlinks($VAR)
    fix-regex:
      regex: (os|io/ioutil)\.(ReadFile|Open|OpenFile|Create)
      replacement: safe_$1.$2
    metadata:
      category: security
      confidence: HIGH
      references:
        - https://securego.io/docs/rules/g304.html
