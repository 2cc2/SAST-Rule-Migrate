Rule Content:
/**
 * @name Path traversal in open() call
 * @description Found request data in a call to 'open'. Ensure the request data is validated or sanitized.
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import DataFlow::PathGraph
import Python::web::Flask
import DataFlow::TaintTracking

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getTarget().hasQualifiedName("flask.request", "*") and
      ma = this.asExpr()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  string paramName;

  RouteParamSource() {
    exists(Parameter p |
      p = this.asParameter() and
      paramName = p.getName()
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(Call call |
      call.getTarget().hasQualifiedName("builtins", "open") and
      call.getArgument(0) = this.asExpr()
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2) or
    TaintTracking::parameterTaintStep(node1, node2)
  }
}

from PathTraversalConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found request data in a call to 'open'. This could lead to path traversal."
