/**
 * @name Path Traversal in open() call
 * @description Detects unsanitized request data used in 'open()' calls which may lead to path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import semmle.python.security.RequestTaint
import semmle.python.Concepts
import DataFlow::PathGraph

class FlaskRequestSource extends RemoteFlowSource::Range {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getMethod().(NamedEntity).getName() = "request" and
      exists(call.getQualifier().getMember()) |
      call.getMethod().getName().matches("get|__getitem__|__call__")
    )
  }
}

class RouteParamSource extends RemoteFlowSource::Range {
  RouteParamSource() {
    exists(FunctionDef fd, Parameter p |
      p = fd.getAParameter() and
      p.getName().matches("%ROUTEVAR%")
    )
  }
}

class UnsafeOpenSink extends DataFlow::Node {
  UnsafeOpenSink() {
    exists(MethodCall openCall |
      openCall.getMethod().getName() = "open" and
      openCall.getMethod().(NamedEntity).getScope().getName() = "builtins" and
      this.asExpr() = openCall.getArgument(0)
    )
  }
}

from FlaskRequestSource source, UnsafeOpenSink sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where sourceNode.getNode() = source and
  sinkNode.getNode() = sink and
  DataFlow::localFlow(sourceNode, sinkNode)
select sinkNode, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
