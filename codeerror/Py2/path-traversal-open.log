Rule Content:
/**
 * @name Path traversal in open call
 * @kind path-problem
 * @problem.severity error
 * @description Detects when request data flows unsafely into an open() call,
 *              which could lead to path traversal attacks.
 * @id python/path-traversal-open
 */

import python
import DataFlow::PathGraph
import semmle.python.web.Flask

class FlaskRequestSource extends DataFlow::SourceNode {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["get", "__getitem__", "__call__"]) and
      matches(ma.getReceiver().getType().toString(), "flask.*request")
    )
  }
}

class RouteParamSource extends DataFlow::SourceNode {
  RouteParamSource() {
    exists(MethodParameter mp |
      regexpMatches(mp.getName(), ".*ROUTEVAR.*")
    )
  }
}

class OpenSink extends DataFlow::SinkNode {
  OpenSink() {
    exists(Call c |
      c.getTarget().hasName("open") and
      this.asExpr() = c.getArgument(0)
    )
  }
}

class PathTraversalConfig extends DataFlow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::SourceNode source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::SinkNode sink) {
    sink instanceof OpenSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, PathTraversalConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential path traversal vulnerability: $@ flows to $@",
  source.getNode(), "user input",
  sink.getNode(), "'open()' call"
