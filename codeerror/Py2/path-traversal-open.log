Rule Content:
/**
 * @name Path Traversal in open()
 * @description Detects path traversal vulnerabilities when untrusted data flows into open() calls.
 * @kind path-problem
 * @problem.severity error
 * @id py/flask-request-open-path-traversal
 */

import python
import DataFlow::PathGraph
import DataFlow::PathNode

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(GlobalVarRef gvr |
      gvr.getTarget().hasName("request") and
      gvr.getLocation().getFile().getRelativeLocation().matches("%flask%")
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p | 
      p.getName().matches("%ROUTEVAR%")
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(Call call |
      call.getTarget().getName() = "open" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, PathTraversalConfig config
where config.hasFlowPath(source, sink)
select sink, source, sink, 
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
