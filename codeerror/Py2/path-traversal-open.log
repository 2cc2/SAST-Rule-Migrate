Rule Content:
/**
 * @name Path traversal in file.open
 * @description Detects path traversal vulnerability when tainted data flows into open() call
 * @id path-traversal-open
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-022
 */

import python
import semmle.python.web.flask.Api
import semmle.python.security.dataflow.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::SourceNode {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("flask\\.request\\..*") and
      this.asSource() = ma
    )
  }

  override predicate isSourceOf(TaintKind kind) {
    kind = TaintKind::pathTraversal()
  }
}

class RouteParamSource extends DataFlow::SourceNode {
  string routeParamName;

  RouteParamSource() {
    exists(Function::Parameter p |
      p.hasName(this.routeParamName) and
      this.asSource() = p.getAnAccess()
    )
  }

  override predicate isSourceOf(TaintKind kind) {
    kind = TaintKind::pathTraversal()
  }
}

class OpenSink extends DataFlow::SinkNode {
  OpenSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().getName() = "open" and
      call.getTarget().getFile().getBaseName() = "builtins.py" and
      this.asSink() = call.getArgument(0)
    )
  }

  override predicate isSinkFor(TaintKind kind) {
    kind = TaintKind::pathTraversal()
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  string routeParamName;

  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::SourceNode source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource and source.routeParamName = this.routeParamName
  }

  override predicate isSink(DataFlow::SinkNode sink) {
    sink instanceof OpenSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2) or
    exists(Function::Parameter p |
      node1.asParameter() = p and
      node2 = p.getAnAccess()
    )
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data " +
  "is validated or sanitized, otherwise it could result in path traversal attacks."
