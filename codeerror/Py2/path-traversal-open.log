import semmle.python.dataflow.DataFlow
import semmle.python.ApiGraphs
import semmle.python.Builtins
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Node::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask", "request") and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node::Parameter {
  string routeVar;

  RouteParamSource() {
    this.getParameter().hasName(routeVar) and
    exists(Function f | f.getAParameter() = this.getParameter())
  }
}

class FileOpenSink extends DataFlow::Node::Range {
  FileOpenSink() {
    exists(Call call |
      call.getTarget().hasQualifiedName("builtins", "open") and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PathTraversalConfig extends DataFlow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    exists(RouteParamSource rps | source.asParameter() = rps)
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::ArgumentNode arg, DataFlow::ParameterNode param |
      DataFlow::FlowBetweenNodes::flowEdge(arg, param) and
      node1.asExpr() = arg and
      node2.asParameter() = param
    )
    or
    exists(DataFlow::ArgumentNode arg, DataFlow::LocalVariableNode local |
      DataFlow::assignmentNode(local, arg) and
      node1.asExpr() = arg and
      node2.asLocal() = local
    )
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
