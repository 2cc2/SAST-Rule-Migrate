Rule Content:
/**
 * @name Path Traversal in open() call
 * @description Detects path traversal vulnerabilities when user-controlled data flows into open() calls
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = ["get", "__getitem__", "__call__"] and
      ma.getQualifier().(Attribute).getObject().(Name).getId() = "flask" and
      ma.getQualifier().(Attribute).getAttr() = "request" and
      this.asSource() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Source {
  RouteParamSource() {
    exists(MethodParameter mp |
      mp.getType().getName().matches(".*ROUTEVAR.*") and
      this.asSource() = mp
    )
  }
}

class OpenSink extends DataFlow::Sink {
  OpenSink() {
    exists(Call call |
      call.getCalleeName() = "open" and
      call.getQualifier() = none and // Ensure it's builtin open()
      this.asSink() = call.getArgument(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalInOpenCall" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof OpenSink
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found request data in a call to 'open'. Ensure the request data is " +
"validated or sanitized, otherwise it could result in path traversal attacks."
