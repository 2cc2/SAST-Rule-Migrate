Rule Content:
/**
 * @name Path Traversal in open() call
 * @description Detects potential path traversal vulnerabilities when Flask request data
 *              is used in a call to open() without proper validation.
 * @kind taint
 * @problem.severity error
 * @id path-traversal-open
 */

import python
import semmle.python.security.RequestTaint
import semmle.python.security.TaintTracking
import semmle.python.web.Flask

class FlaskRequestSource extends TaintSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().(FunctionValue).getName().matches("flask%.request%.") and
      ma = this.asExpr()
    )
  }
}

class RouteParamSource extends TaintSource::Range {
  string routeVar;

  RouteParamSource() {
    exists(Parameter p |
      p = this.asParameter() and
      routeVar = p.getName()
    )
  }
}

class FileOpenSink extends TaintSink::Range {
  FileOpenSink() {
    exists(FunctionValue f, Call c |
      f.getName() = "open" and
      c.getFunc() = f and
      c.getArg(0) = this.asExpr()
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "FilePathTraversal" }

  override predicate isSource(TaintSource::Range source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(TaintSink::Range sink) {
    sink instanceof FileOpenSink
  }

  override predicate isAdditionalTaintStep(TaintTracking::Edge edge) {
    // Propagate taint through argument to parameter
    exists(ParameterNode pn, ArgumentNode an |
      edge.getNode1() = an and
      edge.getNode2() = pn
    ) or
    // Propagate taint through argument to local variable
    exists(ArgumentNode an, LocalVariableNode lvn |
      edge.getNode1() = an and
      edge.getNode2() = lvn
    )
  }
}

from Config cfg, TaintSource::Range source, TaintSink::Range sink
where cfg.hasFlow(source, sink)
select sink, 
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks.",
  source, "User-provided value flows to filesystem operation."
