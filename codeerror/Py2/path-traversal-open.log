/**
 * @name Path Traversal in open() call
 * @description Detects user-controlled data (from Flask request or route parameters) flowing into
 *              unsafe file open operations, potentially leading to path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id py/path-traversal-open
 * @tags security
 *       external/cwe/cwe-022
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.web.Flask
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(DataFlow::CallNode call |
      call = API::moduleImport("flask").getMember("request").getACall()
      and
      (
        call.getMethodName() = "get" or
        call.getMethodName() = "__getitem__" or
        call.getMethodName() = "__call__"
      )
      and
      result = call
    )
  }
}

class RouteParamSource extends DataFlow::ParameterNode {
  RouteParamSource() {
    this.getAnnotatedName().regexpMatch(".*ROUTEVAR.*")
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(DataFlow::CallNode call |
      call = API::builtin("open").getACall()
      and
      result = call.getArg(0)
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "PathTraversalOpenConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2) or
    TaintTracking::parameterToArgumentTaint(node1, node2)
  }
}

from DataFlow::Node source, DataFlow::Node sink, Config config
where config.hasFlow(source, sink)
select sink, source, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
