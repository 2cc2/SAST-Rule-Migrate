Rule Content:
/**
 * @name Path traversal in file open operation
 * @description Detects path traversal vulnerabilities when user-controllable data flows into file open operations
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-022
 *       external/cwe/cwe-073
 */

import python
import semmle.python.web.flask.Requests
import semmle.python.security.dataflow.RemoteFlowSources
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName().matches("flask.request%") and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  string routeVar;

  RouteParamSource() {
    exists(Function::Parameter p |
      p.getAnArgument().getName() = routeVar and
      this.asParameter() = p
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(Call call |
      call.getFunc().getName() = "open" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PathTraversalConfig extends DataFlow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // No sanitizers in original rule
    none()
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
