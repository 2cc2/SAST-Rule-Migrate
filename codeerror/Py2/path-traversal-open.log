Rule Content:
/**
 * @name Path Traversal via Unsafe Open
 * @description Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks.
 * @kind problem
 * @problem.severity error
 * @precision high
 * @id py/path-traversal-open
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.FlaskRequest
import semmle.python.web.flask.RouteParams

class FlaskRequestSource extends RemoteFlowSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["get", "__getitem__", "__call__"] and
      ma.getReceiver().getType().hasQualifiedName("flask", "request")
      and this = ma
    )
  }
}

class RouteParamSource extends RemoteFlowSource::Range {
  RouteParamSource() {
    exists(MethodParameter p |
      p.getName().matches("%ROUTEVAR%") and
      this = p
    )
  }
}

class UnsafeOpenSink extends DataFlow::Node {
  UnsafeOpenSink() {
    exists(Call call |
      call.callsBuiltin("open") and
      this = call.getArgument(0)
    )
  }
}

configure[any](

  // Sources configurations
  RemoteFlowSource::Configuration conf =
    RemoteFlowSource::Configuration.empty().
    addSource(FlaskRequestSource).
    addSource(RouteParamSource).
    addSink(UnsafeOpenSink),

  // Sanitizers (none in this case)
  convert(conf).getDefaultReportConfiguration()
)
