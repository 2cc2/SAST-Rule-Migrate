Rule Content:
/**
 * @name Path traversal in open()
 * @description Detects path traversal vulnerabilities when user-controlled input is passed to file open() calls
 * @kind path-problem
 * @problem.severity warning
 * @id py/path-traversal-open
 */

import python
import semmle.python.web.Flask
import DataFlow
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(PyMethodAccess ma |
      ma.getCallee().(PyFunctionValue).getName() in ["get", "__getitem__", "__call__"] and
      ma.getReceiver().getType().getName() = "request" and
      this.asExpr() = ma.getArg(0)
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(PyParameter p |
      regexpMatches(p.getName(), ".*ROUTEVAR.*") and
      this.asParameter() = p
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(PyCall call |
      call.getCallee().(PyFunctionValue).getName() = "open" and
      call.getCallee().getType().getName() = "builtins" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PathTraversalConfig extends DataFlow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }

  override predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagate taint through argument -> parameter flows
    exists(PyParameter p, PyArgument a |
      node1.asParameter() = p and
      node2.asArgument() = a and
      a.bindsToParameter(p)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, PathTraversalConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found request data in call to 'open' ($@). " +
  "Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks.",
  source.getNode(), "User input"
