/**
 * @name Path Traversal in open()
 * @description Detects unsanitized request data used in file open operations
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName() = "flask.request.get" or
      ma.getMethod().getQualifiedName() = "flask.request.__getitem__" or
      ma.getMethod().getQualifiedName() = "flask.request.__call__" |
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      p.getParameterName().matches(".*ROUTEVAR.*") |
      this.asParameter() = p
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(Call call |
      call.getTarget().getName() = "open" and
      call.getTarget().getQualifiedName() = "builtins.open" |
      this.asExpr() = call.getArgument(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagation from argument to parameter
    exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
      param.asParameter() = arg.getCallable().getParameter(arg.getPosition()) and
      node1.asExpr() = arg.getExpr() and
      node2.asExpr() = param.getAnAccess()
    )
  }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
