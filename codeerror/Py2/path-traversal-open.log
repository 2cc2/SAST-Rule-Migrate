Rule Content:
/**
 * @name Path Traversal in open()
 * @description Detects path traversal vulnerabilities when user-controlled data flows to open() calls
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.RemoteFlowSource
import semmle.python.Concepts

class FlaskRequestSource extends RemoteFlowSource {
  FlaskRequestSource() {
    exists(API::Node request |
      request = API::moduleImport("flask").getMember("request").getAValue() and
      this.asSource() = request
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(string name | 
      name = this.asParameter().getName() and
      name.regexpMatch(".*ROUTEVAR.*")
    )
  }
}

class UnsafeOpenSink extends DataFlow::Node {
  UnsafeOpenSink() {
    exists(API::Node openCall |
      openCall = API::builtin("open") and
      this.asSource() = openCall.getACall().getArgument(0)
    )
  }
}

class PathTraversalConfig extends DataFlow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeOpenSink
  }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Potential path traversal vulnerability: user-controlled data flows to open() call.", source,
  "User input comes from here"
