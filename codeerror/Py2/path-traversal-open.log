/**
 * @id path-traversal-open
 * @kind path-problem
 * @severity error
 * @problem.severity error
 * @tags security
 * @precision high
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.Flask
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName().matches("flask\\.request\\..*") and
      ma = this.asExpr()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p | p = this.asParameter())
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(Call call |
      call.getCalleeName() = "open" and
      call.getArgument(0) = this.asExpr()
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "PathTraversalOpen" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }
}

