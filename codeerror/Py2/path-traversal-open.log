Rule Content:
/**
 * @name Path Traversal via Flask Request
 * @description Detects when Flask request data is passed to 'open()' without sanitization,
 *              potentially leading to path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Flask

class FlaskRequestSource extends TaintSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("flask", "request") and
      this.asExpr() = ma
    )
  }

  override predicate isSourceOf(TaintKind kind) { kind = TaintKind::PathTraversal() }
}

class RouteParamSource extends TaintSource::Range {
  string paramName;

  RouteParamSource() {
    exists(Parameter p |
      paramName = p.getName() and
      this.asExpr() = p.getAnAccess()
    )
  }

  override predicate isSourceOf(TaintKind kind) { kind = TaintKind::PathTraversal() }
}

class OpenSink extends TaintSink::Range {
  OpenSink() {
    exists(FunctionCall fc |
      fc.getTarget().hasQualifiedName("builtins", "open") and
      fc.getArgument(0) = this.asExpr()
    )
  }

  override predicate isSinkFor(TaintKind kind) { kind = TaintKind::PathTraversal() }
}

predicate isAdditionalTaintStep(TaintKind kind, DataFlow::Node pred, DataFlow::Node succ) {
  exists(Parameter pt, Argument arg, LocalScopeVariable local |
    (
      arg = pred.asExpr() and pt = succ.asParameter() and
      DataFlow::parameterNode(pt) = succ and
      arg.getCall().getArgumentPosition(arg) = pt.getIndex()
    )
    or
    (
      arg = pred.asExpr() and local = succ.asVariable() and
      arg.getEnclosingStatement().(AssignStmt).getDest().getVariable() = local
    )
  )
}

from FlaskRequestSource source, OpenSink sink
where TaintTracking::localTaint(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
