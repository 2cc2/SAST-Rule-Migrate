/**
 * @name Path Traversal in File Open
 * @description Detects path traversal vulnerabilities when request data is passed to file open operations
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/path-traversal-open
 * @tags security
 *       external/cwe/cwe-22
 */

import python
import dataflow
import dataflow.tainttracking
import semmle.python.web.flask.Flask

class FlaskRequestSource extends dataflow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getCallee().(Attribute).getObject().(Name).getId() = "flask" and
      ma.getCallee().(Attribute).getAttr() = "request" and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends dataflow::Node {
  RouteParamSource() {
    exists(Parameter p |
      this.asParameter() = p and
      p.getScope().(Function).getAnAttribute().(Decorator).getExpr().toString() = "route"
    )
  }
}

class FileOpenSink extends dataflow::Node {
  FileOpenSink() {
    exists(Call call |
      call.getCallee().getQualifiedName() = "builtins.open" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PathTraversalConfig extends dataflow::TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(dataflow::Node source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(dataflow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isAdditionalTaintStep(dataflow::Node node1, dataflow::Node node2) {
    dataflow::localTaintStep(node1, node2) or
    dataflow::parameterTaintStep(node1, node2)
  }
}

from PathTraversalConfig ptc, dataflow::Node source, dataflow::Node sink
where ptc.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
