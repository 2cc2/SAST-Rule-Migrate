import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph
import TaintTracking

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getFunc().(Named).getName() = "request" and
      ma.getFunc().(Attribute).getObject().(Named).getName() = "flask" and
      (ma.getMethodName() = "get" or ma.getMethodName() = "__getitem__" or ma.getMethodName() = "__call__") and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function::Parameter p |
      p.getName().regexpMatch(".*ROUTEVAR.*") and
      this.asParameter() = p
    )
  }
}

class UnsafeOpenSink extends DataFlow::Node {
  UnsafeOpenSink() {
    exists(Call call |
      call.getFunc().(Named).getName() = "open" and
      call.getFunc().getFile().getAbsolutePath().matches("%/builtins.py") and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeOpenSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::ArgumentNode arg, DataFlow::ParameterNode param |
      arg.getCallable() = param.getFunction() and
      arg.getIndex() = param.getIndex() and
      node1.asExpr() = arg.getExpr() and
      node2.asParameter() = param.getAParameterAccess()
    )
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source,
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
