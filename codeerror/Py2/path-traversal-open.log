Rule Content:
/**
 * @name Path Traversal in File Open
 * @description Detects possible path traversal vulnerability when request data is used in 'open' calls
 * @kind path-problem
 * @severity Error
 * @id python/path-traversal-open
 */

import python
import semmle.python.security.RequestForgery
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Flask

class FlaskRequestSource extends TaintSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName().regexpMatch("flask\\.request\\..*") and
      this = ma
    )
  }

  override string getSourceType() { "user-provided value" }
}

class RouteParamSource extends TaintSource::Range {
  string routeVarName;

  RouteParamSource() {
    exists(Parameter p |
      this = p.getAnArg() and
      routeVarName = p.getName()
    )
  }

  override string getSourceType() { "route parameter" }
}

class FileOpenSink extends TaintSink::Range {
  FileOpenSink() {
    exists(Call call, Name name |
      call.getFunc() = name and
      name.getId() = "open" and
      name.getQualifier().getType() = builtins() and
      this = call.getArg(0)
    )
  }

  override string getSinkType() { "file open operation" }
}

module TaintConfig implements TaintTracking::Configuration {
  override predicate isSource(TaintSource::Range source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(TaintSink::Range sink) {
    sink instanceof FileOpenSink
  }

  override predicate isSanitizer(TaintSanitizer::Range sanitizer) {
    none()
  }
}

from TaintConfig config, TaintSource::Range source, TaintSink::Range sink
where config.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, " +
  "otherwise it could result in path traversal attacks."
