Rule Content:
/**
 * @name Command injection through formatted Runtime call
 * @description Detects potentially unsafe formatted string inputs to java.lang.Runtime calls
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-formatted-runtime-call
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class ServletRequestGetParameter extends Method {
  ServletRequestGetParameter() {
    this.getDeclaringType() instanceof TypeServletReq and
    this.hasName("getParameter")
  }
}

predicate isRuntimeExec(Method m) {
  m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
  m.hasName("exec")
}

predicate isRuntimeLoadLibrary(Method m) {
  m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
  m.hasName("loadLibrary")
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(MethodAccess ma |
      ma.getMethod() instanceof ServletRequestGetParameter and
      this.asExpr() = ma
    )
  }
}

class RuntimeExecSink extends DataFlow::Node {
  RuntimeExecSink() {
    exists(MethodAccess ma |
      isRuntimeExec(ma.getMethod()) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class RuntimeLoadLibrarySink extends DataFlow::Node {
  RuntimeLoadLibrarySink() {
    exists(MethodAccess ma |
      isRuntimeLoadLibrary(ma.getMethod()) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RuntimeExecSink or
    sink instanceof RuntimeLoadLibrarySink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node.getType() instanceof StringLiteralType
  }
}

from CommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "A formatted or concatenated string was detected as input to a java.lang.Runtime call. " +
  "This is dangerous if a variable is controlled by user input and could result in command injection."
