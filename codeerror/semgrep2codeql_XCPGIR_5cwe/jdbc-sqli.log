Rule Content:
/**
 * @name JDBC SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jdbc.Jdbc

class SqlStringFormatSource extends DataFlow::ExprNode {
  SqlStringFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "format" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma
    )
  }
}

class SqlStringConcatSource extends DataFlow::ExprNode {
  SqlStringConcatSource() {
    exists(AddExpr add |
      add.getLeftOperand().getType() instanceof TypeString and
      this.asExpr() = add
    )
  }
}

class SqlExecutionSink extends DataFlow::ExprNode {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      ma.getMethod().getName() in ["executeQuery", "execute", "executeUpdate",
                                  "executeLargeUpdate", "addBatch", "nativeSQL"] and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma
    )
  }
}

class SqlStringLiteralBarrier extends DataFlow::Node {
  SqlStringLiteralBarrier() {
    exists(Literal l |
      l.isStringLiteral() and
      not l.toString().matches("\"%+\"") and
      this.asExpr() = l
    )
  }
}

class SqlStringFlowConfig extends TaintTracking::Configuration {
  SqlStringFlowConfig() { this = "SqlStringFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlStringFormatSource or
    source instanceof SqlStringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof PreparedStatementSanitizer
  }

  override predicate isBarrier(DataFlow::Node node) {
    node instanceof SqlStringLiteralBarrier
  }
}

from SqlStringFlowConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Possible SQL injection from string formatting/concat to SQL execution"
