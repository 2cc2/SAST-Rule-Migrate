Rule Content:
/**
 * @name JDBC SQL Injection Vulnerability
 * @description Detects SQL injection vulnerabilities caused by string concatenation
 *              or formatted strings in SQL statements.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatCall or
    exists(AssignmentExpr assign |
      assign.getRight().toString().regexpMatch(".*\\+.*") and
      assign.getLeft().toString().matches("String \\$SQL") and
      source.asExpr() = assign.getRight()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      ma.getMethod().getName().matches("executeQuery|execute|executeUpdate|executeLargeUpdate|addBatch|nativeSQL") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      ma.getMethod().getName() = "prepareStatement" and
      sanitizer.asExpr() = ma
    )
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    exists(StringLiteral sl |
      sl.getStringValue().regexpMatch("^SELECT.*$") and
      barrier.asExpr() = sl
    )
  }
}

from SqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "SQL injection vulnerability detected. Use prepared statements instead of string concatenation or formatted strings."
