import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringExtensions

class SqlStringFormatSource extends DataFlow::Node {
  SqlStringFormatSource() {
    exists(Method m, MethodAccess ma |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class SqlStringConcatSource extends DataFlow::Node {
  SqlStringConcatSource() {
    exists(Expr add |
      add instanceof AddExpr and
      add.getType().hasName("String") and
      this.asExpr() = add
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(Method m, MethodAccess ma |
      m.getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      m.getName() in ["executeQuery", "execute", "executeUpdate", 
                     "executeLargeUpdate", "addBatch", "nativeSQL"] and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(0)
    )
