/**
 * @name JDBC SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized. Use prepared
 *              statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormatting

class SQLStringFormatSource extends DataFlow::Node {
  SQLStringFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasName("String") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SQLStringConcatSource extends DataFlow::Node {
  SQLStringConcatSource() {
    exists(AssignmentExpr assign |
      assign.getDest().toString().matches("String\\s+\\$SQL\\s*") and
      assign.getRightOperand().toString().matches(".+\\+.+") and
      this.asExpr() = assign.getRightOperand()
    )
  }
}

class SQLExecutionSink extends DataFlow::Node {
  SQLExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["executeQuery", "execute", "executeUpdate",
                                  "executeLargeUpdate", "addBatch", "nativeSQL"] and
      ma.getMethod().getDeclaringType().hasName("Statement") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SQLInjectionConfiguration extends TaintTracking::Configuration {
  SQLInjectionConfiguration() { this = "SQLInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SQLStringFormatSource or
    source instanceof SQLStringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    // No sanitizers in original rule
    none()
  }
}

