Rule Content:
/**
 * @name JDBC SQL Injection Vulnerability
 * @description Detects SQL injection vulnerabilities caused by string concatenation
 *              or formatted strings in SQL statements.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-089
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat
import semmle.code.java.security.QueryInjection
import DataFlow::PathGraph

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma | 
      ma.getMethod().hasQualifiedName("java.lang.String", "format") and
      source.asExpr() = ma
    )
    or
    exists(AssignExpr assign |
      assign.getRight().toString().regexpMatch(".*\\+.*") and
      assign.getLeft().toString().matches("String \\$SQL") and
      source.asExpr() = assign.getRight()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method method, Call call |
      method.getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      method.getName() in ["executeQuery", "execute", "executeUpdate", "executeLargeUpdate", "addBatch", "nativeSQL"] and
      call = method.getACall() and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Method method, Call call |
      method.getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      method.getName() = "prepareStatement" and
      call = method.getACall() and
      sanitizer.asExpr() = call
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    node1.asExpr().(Call).getAnArgument() = node2.asExpr()
  }
}

from SqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "SQL injection vulnerability detected. Use prepared statements instead of string concatenation or formatted strings."
