Rule Content:
/**
 * @name JDBC SQL Injection Vulnerability
 * @description Detects SQL injection vulnerabilities caused by string concatenation
 *              or formatted strings in SQL statements.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-089
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String") and
      call.getCallee().getName() = "format" and
      source.asExpr() = call
    )
    or
    exists(AssignExpr assign, Variable v |
      assign.getRValue().toString().regexpMatch(".*\\+.*") and
      v = assign.getDest() and
      v.getName() = "SQL" and
      v.getType().getName() = "String" and
      source.asExpr() = assign.getRValue()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      call.getCallee().getName().matches("executeQuery|execute|executeUpdate|executeLargeUpdate|addBatch|nativeSQL") and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getCallee().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      call.getCallee().getName() = "prepareStatement" and
      sanitizer.asExpr() = call
    )
  }

  override predicate isBarrier(DataFlow::Node node) {
    node.getType() instanceof StringType and
    node.asExpr().toString().matches("\"SELECT%\"") 
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Call call |
      call = node1.asExpr() and
      node2.asExpr() = call.getAnArgument()
    )
  }
}

