/**
 * @name JDBC SQL Injection Vulnerability
 * @description Detects SQL injection vulnerabilities caused by string concatenation
 *              or formatted strings in SQL statements.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-089
 */
import java
import semmle.code.java.dataflow.FlowSources
import DataFlow::PathGraph

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getMethod().getName() = "format" and
      source.asExpr() = ma
    )
    or
    exists(Expr assign, Expr right, Variable v |
      assign instanceof AssignmentExpr and
      right = assign.(AssignmentExpr).getRValue() and
      right.toString().regexpMatch(".*\\+.*") and
      v = assign.(AssignmentExpr).getDest() and
      v.getName() = "SQL" and
      v.getType().toString() = "String" and
      source.asExpr() = right
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      ma.getMethod().getName().matches("executeQuery|execute|executeUpdate|executeLargeUpdate|addBatch|nativeSQL") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      ma.getMethod().getName() = "prepareStatement" and
      sanitizer.asExpr() = ma
    )
  }

  override predicate isBarrier(DataFlow::Node node) {
    node.asExpr() instanceof StringLiteral and
    node.asExpr().toString().regexpMatch("^\"SELECT.*\"$")
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Call call |
      call = node1.asExpr() and
      node2.asExpr() = call.getAnArgument()
    )
  }
}

