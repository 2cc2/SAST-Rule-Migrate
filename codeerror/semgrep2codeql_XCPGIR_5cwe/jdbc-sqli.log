/**
 * @name JDBC SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormatting

class SqlStringFormatSource extends DataFlow::Node {
  SqlStringFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma
    )
  }
}

class SqlStringConcatSource extends DataFlow::Node {
  SqlStringConcatSource() {
    // Simple pattern for string concatenation with variables
    exists(AddExpr add |
      add.getLeftOperand().getType() instanceof StringType and
      this.asExpr() = add
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      ma.getMethod().getName() in ["executeQuery", "execute", "executeUpdate", 
                                  "executeLargeUpdate", "addBatch", "nativeSQL"] and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("prepareStatement") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma
    )
  }
}

class SqlStringFormatConfig extends TaintTracking::Configuration {
  SqlStringFormatConfig() { this = "SqlStringFormatConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SqlStringFormatSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecutionSink }

  override predicate isSanitizer(DataFlow::Node node) { node instanceof PreparedStatementSanitizer }
}

class SqlStringConcatConfig extends TaintTracking::Configuration {
  SqlStringConcatConfig() { this = "SqlStringConcatConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SqlStringConcatSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecutionSink }

  override predicate isSanitizer(DataFlow::Node node) { node instanceof PreparedStatementSanitizer }
}

