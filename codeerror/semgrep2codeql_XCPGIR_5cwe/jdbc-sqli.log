class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(Method m, MethodAccess ma |
      m.hasName("prepareStatement") and
      m.getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class SqlStringLiteralBarrier extends DataFlow::Node {
  SqlStringLiteralBarrier() {
    exists(Literal l |
      l.isStringLiteral() and
      not l.getStringValue().matches("%\\w+%") and
      this.asExpr() = l
    )
  }
}

class SqlStringFormatConfig extends TaintTracking::Configuration {
  SqlStringFormatConfig() { this = "SqlStringFormatConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SqlStringFormatSource }

