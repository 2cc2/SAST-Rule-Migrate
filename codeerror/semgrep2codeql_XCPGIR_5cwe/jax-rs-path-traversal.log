/**
 * @name JAX-RS Path Traversal
 * @description Detected a potential path traversal. A malicious actor could control the location of this file, to include going backwards in the directory with '../'. To address this, ensure that user-controlled variables in file paths are sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jax-rs-path-traversal
 * @tags security
 *       external/jax-rs
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jaxrs.JaxRs

class PathParamSource extends DataFlow::Node {
  PathParamSource() {
    exists(MethodParameter p |
      p.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "PathParam") or
      p.getAnAnnotation().getType().getName() = "PathParam" |
      this.asParameter() = p
    )
  }
}

class FileSink extends DataFlow::Node {
  FileSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.io", "File") and
      cc.getArgument(1) = this.asExpr()
    )
  }
}

class FilenameUtilsSanitizer extends DataFlow::Node {
  FilenameUtilsSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.apache.commons.io", "FilenameUtils", "getName") and
      this.asExpr() = ma
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof PathParamSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FilenameUtilsSanitizer
  }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Potential path traversal vulnerability via @PathParam used in File constructor", 
  source, "User-provided path parameter", sink, "File constructor with potentially unsafe path"
