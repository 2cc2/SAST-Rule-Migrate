}

class JaxRsPathTraversalConfiguration extends TaintTracking::Configuration {
  JaxRsPathTraversalConfiguration() {
    this = "JAX-RS Path Traversal Configuration"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof JaxRsPathParamSource
