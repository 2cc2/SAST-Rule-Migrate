/**
 * @name Dangerous Groovy Shell Execution
 * @description Detects dynamic Groovy shell execution vulnerable to code injection
 * @kind path-problem
 * @problem.severity warning
 * @id java/dangerous-groovy-shell
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class GroovyShellConfig extends TaintTracking::Configuration {
  GroovyShellConfig() { 
    this = "GroovyShellConfig" 
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p) or
    exists(StringLiteral l | source.asExpr() = l and l.getValue() != "")
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Call c |
      (
        m.hasName("evaluate") or
        m.hasName("parse") or 
        m.hasName("parseClass")
      ) and
      (
        m.getDeclaringType().hasQualifiedName("groovy.lang", "GroovyShell") or
        m.getDeclaringType().hasQualifiedName("groovy.lang", "GroovyClassLoader")
      ) and
      c.getMethod() = m and
      sink.asExpr() = c.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, GroovyShellConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Dynamic Groovy shell execution detected. Verify source of input values to prevent code injection."
