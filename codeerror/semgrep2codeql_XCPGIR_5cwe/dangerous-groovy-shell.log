/**
 * @name Dangerous Groovy Shell Execution
 * @description Detects dynamic Groovy shell execution where user input flows into evaluation methods
 * @kind path-problem
 * @problem.severity warning
 * @id java/dangerous-groovy-shell
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.security.QuerySanitizers

class GroovyShellExec extends DataFlow::Configuration {
  GroovyShellExec() { this = "GroovyShellExec" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p) or
    exists(StringLiteral lit | source.asExpr() = lit and lit.getText() != "\"\"")
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method method, MethodAccess call |
      method.getName() matches ["parse", "evaluate", "parseClass"] and
      (
        method.getDeclaringType().hasQualifiedName("groovy.lang", "GroovyShell") or
        method.getDeclaringType().hasQualifiedName("groovy.lang", "GroovyClassLoader")
      ) and
      call.getMethod() = method and
      sink.asExpr() = call.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, GroovyShellExec config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Dynamic Groovy shell execution detected. Verify source of input values to prevent code injection."
