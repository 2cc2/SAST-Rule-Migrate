Rule Content:
/**
 * @name Dangerous Groovy Shell Execution
 * @description Detects dynamic Groovy shell execution where user input flows into evaluation methods
 * @kind path-problem
 * @problem.severity warning
 * @id java/dangerous-groovy-shell
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Groovy
import DataFlow::PathGraph

class GroovyShellConfig extends TaintTracking::Configuration {
  GroovyShellConfig() { this = "GroovyShellConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      source.asParameter() = p
    )
    or
    exists(Literal l |
      source.asExpr() = l and
      l.getStringValue() != "" and
      l.getStringValue() != null
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (
        ma.getMethod().hasName(["parse", "evaluate", "parseClass"]) and
        (
          ma.getMethod().getDeclaringType().hasQualifiedName("groovy.lang", "GroovyShell") or
          ma.getMethod().getDeclaringType().hasQualifiedName("groovy.lang", "GroovyClassLoader")
        ) and
        sink.asExpr() = ma.getArgument(0)
      )
    )
  }
}

from GroovyShellConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Dynamic Groovy shell execution detected. Verify source of input values to prevent code injection."
