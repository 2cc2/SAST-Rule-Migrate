/**
 * @name Tainted SQL String
 * @description User data flows into this manually-constructed SQL string. User data can be safely
 *              inserted into SQL strings using prepared statements or an object-relational mapper (ORM).
 *              Manually-constructed SQL strings is a possible indicator of SQL injection, which could
 *              let an attacker steal or manipulate data from the database.
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-564
 * @id java/tainted-sql-string
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController
import DataFlow::PathGraph

predicate isUserInput(DataFlow::Node node) {
  exists(Parameter p | 
    node.asParameter() = p and
    (p.getCallable().hasAnnotation("org.springframework.web.bind.annotation.RequestBody") or
     p.getCallable().hasAnnotation("org.springframework.web.bind.annotation.PathVariable") or
     p.getCallable().hasAnnotation("org.springframework.web.bind.annotation.RequestParam") or
     p.getCallable().hasAnnotation("org.springframework.web.bind.annotation.RequestHeader") or
     p.getCallable().hasAnnotation("org.springframework.web.bind.annotation.CookieValue")) and
    not p.getType() instanceof PrimitiveType
  )
}

predicate isSqlConcat(DataFlow::Node node) {
  exists(MethodAccess ma | node.asExpr() = ma |
    // String concatenation patterns
    (ma.getMethod().getName() = "concat" and
     ma.getQualifier().toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%"))
    or
    (exists(BinaryExpr be | be = node.asExpr() |
       be.getOperator() instanceof Add and
       (be.getLeftOperand().toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%") or
        be.getRightOperand().toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%"))
     ))
    or
    (exists(AssignExpr ae | ae = node.asExpr() |
       ae.getDest().toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%")
     ))
    or
    (ma.getMethod().hasName("format") and
     ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
     ma.getArgument(0).toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%"))
  )
}

predicate isSafeLogging(DataFlow::Node node) {
  exists(MethodAccess ma | node.asExpr() = ma |
    ma.getMethod().getName().matches("%info%|%warn%|%warning%|%debug%|%debugging%|%error%")
  )
}

predicate isExceptionBarrier(DataFlow::Node node) {
  exists(ClassInstanceExpr cie | node.asExpr() = cie |
    cie.getConstructedType().hasQualifiedName("java.lang", "Exception")
  )
  or
  exists(ThrowStmt ts | node.asExpr() = ts.getExpr())
}

class TaintedSQLStringConfig extends TaintTracking::Configuration {
  TaintedSQLStringConfig() { this = "TaintedSQLStringConfig" }

  override predicate isSource(DataFlow::Node source) { isUserInput(source) }

  override predicate isSink(DataFlow::Node sink) { isSqlConcat(sink) }

  override predicate isSanitizer(DataFlow::Node node) { isSafeLogging(node) }

  override predicate isBarrier(DataFlow::Node node) { isExceptionBarrier(node) }
}

