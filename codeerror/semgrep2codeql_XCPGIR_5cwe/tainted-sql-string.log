Rule Content:
/**
 * @name Tainted SQL String
 * @description User data flows into this manually-constructed SQL string. User data can be safely
 *              inserted into SQL strings using prepared statements or an object-relational mapper (ORM).
 *              Manually-constructed SQL strings is a possible indicator of SQL injection, which could
 *              let an attacker steal or manipulate data from the database.
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-564
 * @id java/tainted-sql-string
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController
import DataFlow::PathGraph

predicate isUserInput(Expr expr) {
  exists(MethodAccess mc | expr = mc |
    (mc.getMethod().hasAnnotationType("RequestBody") or
     mc.getMethod().hasAnnotationType("PathVariable") or
     mc.getMethod().hasAnnotationType("RequestParam") or
     mc.getMethod().hasAnnotationType("RequestHeader") or
     mc.getMethod().hasAnnotationType("CookieValue"))
    and
    not expr.getType() instanceof PrimitiveType
  )
}

predicate isSqlConcat(Expr expr) {
  // $SQL + ...
  exists(BinaryAdd ba | expr = ba |
    ba.getLeftOperand().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
  )
  or
  // $SQL.concat(...)
  exists(MethodAccess mc | expr = mc |
    mc.getMethod().getName() = "concat" and
    mc.getQualifier().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
  )
  or
  // new StringBuilder($SQL)
  exists(ClassInstanceExpr cie | expr = cie |
    cie.getConstructedType().hasQualifiedName("java.lang", "StringBuilder") and
    cie.getAnArgument().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
  )
  or
  // $VAR += ...
  exists(AssignExpr ae | expr = ae |
    ae.getOperator() = AssignAdd and
    ae.getLeftOperand().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
  )
  or
  // String.format($SQL, ...)
  exists(MethodAccess mc | expr = mc |
    mc.getMethod().hasName("format") and
    mc.getMethod().getDeclaringType() instanceof TypeString and
    mc.getAnArgument().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
  )
}

predicate isSafeLogging(DataFlow::Node node) {
  exists(MethodAccess ma | ma = node.asExpr() |
    ma.getMethod().getName() matches "info|warn|warning|debug|debugging|error"
  )
}

predicate isExceptionBarrier(DataFlow::Node node) {
  exists(Expr e | e = node.asExpr() |
    e instanceof ClassInstanceExpr and
