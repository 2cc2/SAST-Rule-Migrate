import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class SpringSource extends DataFlow::Node {
  SpringSource() {
    exists(Parameter p |
      p.getType().getName().matches("%") and
      not p.getType().getName().matches("^(Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean)$") and
      exists(p.getAnAnnotation() |
        _.getType().getName().matches("RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue")
      ) and
      this.asParameter() = p
    )
  }
}

class SqlConcatSink extends DataFlow::Node {
  SqlConcatSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "concat" and
      this.asExpr() = ma
    )
  }
}

class SqlFormatSink extends DataFlow::Node {
  SqlFormatSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "format" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getArgument(0).toString().matches("(?i)(select|delete|insert|create|update|alter|drop)%") and
      this.asExpr() = ma
    )
  }
}

class SqlBuilderSink extends DataFlow::Node {
  SqlBuilderSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "append" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder") and
      exists(ConstructorCall cc |
        cc.getConstructedType().hasQualifiedName("java.lang", "StringBuilder") and
        cc.getAnArgument().toString().matches("\".*\"") and
        ma.getQualifier() = cc
      ) and
      this.asExpr() = ma
    )
  }
}

class PreparedStatementSanitizer extends TaintTracking::Sanitizer {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma
    )
  }
}

class LoggingBarrier extends TaintTracking::Barrier {
  LoggingBarrier() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("info|warn|warning|debug|debugging|error") and
      this.asExpr() = ma
    )
  }
}

class ExceptionBarrier extends TaintTracking::Barrier {
  ExceptionBarrier() {
    exists(ClassInstanceExpr cie |
      cie.getConstructedType() instanceof TypeException and
      this.asExpr() = cie
    )
  }
}

class TaintedSqlFlowConfig extends TaintTracking::Configuration {
  TaintedSqlFlowConfig() { this = "TaintedSqlFlowConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SpringSource }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlConcatSink or
    sink instanceof SqlFormatSink or
    sink instanceof SqlBuilderSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof LoggingBarrier or
    barrier instanceof ExceptionBarrier
  }
}

