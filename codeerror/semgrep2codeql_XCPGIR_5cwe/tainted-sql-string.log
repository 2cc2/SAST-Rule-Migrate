/**
 * @name Tainted SQL String
 * @description User data flows into this manually-constructed SQL string. User data can be safely
 *              inserted into SQL strings using prepared statements or an object-relational mapper (ORM).
 *              Manually-constructed SQL strings is a possible indicator of SQL injection, which could
 *              let an attacker steal or manipulate data from the database.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController
import DataFlow::PathGraph

predicate isUserInput(DataFlow::Node source) {
  exists(Method m, Parameter p |
    p.getAnAnnotation().getType().getName().matches("%(RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue)%") and
    not p.getType() instanceof PrimitiveType and
    not p.getType() instanceof BoxedType and
    source.asParameter() = p
  )
}

predicate isSqlConcat(DataFlow::Node sink) {
  exists(BinaryExpr be | 
    (be.getOp() instanceof Add or be.getOp() instanceof PlusAssign) and
    be.getRightOperand().getType() instanceof TypeString and
    sink.asExpr() = be and
    be.toString().matches("%(?i)(select|delete|insert|create|update|alter|drop)\\b%")
  )
  or
  exists(MethodAccess ma |
    (ma.getMethod().getName() = "concat" or ma.getMethod().getName() = "append") and
    ma.getQualifier().getType() instanceof TypeString and
    sink.asExpr() = ma and
    ma.toString().matches("%(?i)(select|delete|insert|create|update|alter|drop)\\b%")
  )
  or
  exists(MethodAccess ma |
    ma.getMethod().getName() = "format" and
    sink.asExpr() = ma and
    ma.toString().matches("%(?i)(select|delete|insert|create|update|alter|drop)\\b%")
  )
}

predicate isLogging(Expr e) {
  exists(MethodAccess ma |
    ma.getMethod().getName().matches("%(println|info|warn|warning|debug|debugging|error)%") and
    (
      ma.getQualifier().toString() = "System.out" or
      ma.getMethod().getDeclaringType().getName().matches("%LOG%")
    ) and
    e = ma
  )
}

class TaintedSqlConfig extends TaintTracking::Configuration {
  TaintedSqlConfig() { this = "TaintedSqlConfig" }

  override predicate isSource(DataFlow::Node source) { isUserInput(source) }

  override predicate isSink(DataFlow::Node sink) { isSqlConcat(sink) }

  override predicate isBarrier(DataFlow::Node node) {
    isLogging(node.asExpr())
  }
}

