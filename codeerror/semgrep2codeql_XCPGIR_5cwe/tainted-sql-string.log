/**
 * @name Tainted SQL String
 * @description User data flows into manually-constructed SQL string. User data can be safely inserted into 
 *              SQL strings using prepared statements or an object-relational mapper (ORM). Manually-constructed 
 *              SQL strings is a possible indicator of SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @precision medium
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01
 *       external/owasp/a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringRequest
import semmle.code.java.StringOperations

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Method m, Parameter p |
      p = m.getAParameter() and
      this.asParameter() = p and
      (
        p.getAnAnnotation().getType().getName().matches("RequestBody") or
        p.getAnAnnotation().getType().getName().matches("PathVariable") or
        p.getAnAnnotation().getType().getName().matches("RequestParam") or
        p.getAnAnnotation().getType().getName().matches("RequestHeader") or
        p.getAnAnnotation().getType().getName().matches("CookieValue")
      ) and
      not (
        p.getType().getName().matches("Integer") or
        p.getType().getName().matches("Long") or
        p.getType().getName().matches("Float") or
        p.getType().getName().matches("Double") or
        p.getType().getName().matches("Boolean")
      )
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(Expr expr |
      (
        exists(BinaryExpr b |
          b.getLeftOperand() instanceof StringLiteral and
          b.getRightOperand().getLocation().getFile() = expr.getLocation().getFile() and
          b.getOperator() = "+"
        ) or
        exists(MethodAccess ma |
          ma.getMethod().getName() = "concat" and
          ma.getQualifier() instanceof StringLiteral
        ) or
        exists(MethodAccess ma |
          ma.getMethod().getName() = "append" and
          ma.getQualifier().getType().getName() = "StringBuilder"
        ) or
        exists(MethodAccess ma |
          ma.getMethod().getName() = "format" and
          ma.getQualifier() instanceof StringLiteral
        )
      ) and
      exists(StringLiteral sl |
        sl.getValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b")
      ) and
      not isInsideLoggingCall(expr)
    )
  }

  private predicate isInsideLoggingCall(Expr expr) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("info|warn|warning|debug|debugging|error")
    )
  }
}

class SqlTaintConfig extends TaintTracking::Configuration {
  SqlTaintConfig() { this = "SqlTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getQualifier().getType().hasQualifiedName("java.sql", "Connection")
    )
  }
}

