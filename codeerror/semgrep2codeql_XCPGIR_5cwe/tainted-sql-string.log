Rule Content:
/**
 * @name Tainted SQL string
 * @description User data flows into this manually-constructed SQL string. User data can be safely inserted into SQL strings using prepared statements or an object-relational mapper (ORM).
 * @id java/tainted-sql-string
 * @kind path-problem
 * @severity error
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController
import semmle.code.java.StringFormat

class WebInputSource extends RemoteFlowSource::Range {
  WebInputSource() {
    exists(MethodParameter p |
      p.getType().hasName("String") and
      p.getAnAnnotation().getType().getName().matches("%RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue%")
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(Call c |
      (
        c.getMethod().getName() = "concat" or
        c.getMethod().getName() = "append" or
        c.getMethod().getName() = "format"
      ) and
      this.asExpr() = c
    ) or
    exists(BinaryOperationExpr boe |
      boe.getOperator() = "+=" and
      this.asExpr() = boe
    ) or
    exists(Literal l |
      l.getStringValue().matches("%(?i)(select|delete|insert|create|update|alter|drop)\\b%") and
      this.asExpr() = l
    )
  }
}

class LoggingSanitizer extends Sanitizer {
  LoggingSanitizer() {
    exists(Call c |
      c.getMethod().getName().matches("%println|info|warn|warning|debug|debugging|error%") and
      this.asExpr() = c
    )
  }
}

class ExceptionBarrier extends Barrier {
  ExceptionBarrier() {
    exists(Call c |
      c.getMethod().getDeclaringType() instanceof Exception and
      this.asExpr() = c
    )
  }
}

predicate isFlow(DataFlow::Node source, DataFlow::Node sink) {
  exists(TaintFlow config |
    config.hasFlowPath(source, sink) and
    not config.getSanitizer() instanceof LoggingSanitizer and
    not config.getBarrier() instanceof ExceptionBarrier
  )
}

from DataFlow::Node source, DataFlow::Node sink
where
  source instanceof WebInputSource and
  sink instanceof SqlSink and
  isFlow(source, sink)
select sink, "User data flows into this manually-constructed SQL string.", source,
  "User input flows into SQL string here: $@", source, "user input"
