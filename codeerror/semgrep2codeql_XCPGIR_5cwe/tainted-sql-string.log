where cfg.hasFlowPath(source, sink)
select sink, 
  "User data flows into this manually-constructed SQL string. Possible SQL injection vulnerability.",
  source, sink,
  "User input from $@ flows into SQL string construction here.",
  source.getNode(), source.toString()
