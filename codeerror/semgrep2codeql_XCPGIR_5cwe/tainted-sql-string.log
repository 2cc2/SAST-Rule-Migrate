/**
 * @name Tainted SQL string
 * @description User data flows into this manually-constructed SQL string. User data can be safely inserted into SQL strings using prepared statements or an object-relational mapper (ORM).
 * @id java/tainted-sql-string
 * @kind path-problem
 * @severity error
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController
import semmle.code.java.StringFormat

class WebInputSource extends TaintTracking::Source {
  WebInputSource() {
    exists(Method m, Parameter p |
      p.getType().hasName("String") and
      (p.getAnAnnotation().getType().getName().matches("RequestBody") or
       p.getAnAnnotation().getType().getName().matches("PathVariable") or
       p.getAnAnnotation().getType().getName().matches("RequestParam") or
       p.getAnAnnotation().getType().getName().matches("RequestHeader") or
       p.getAnAnnotation().getType().getName().matches("CookieValue")) and
      this.asParameter() = p
    )
  }
}

class SqlSink extends TaintTracking::Sink {
  SqlSink() {
    exists(MethodAccess ma |
      (ma.getMethod().hasName("concat") or
       ma.getMethod().hasName("append") or
       ma.getMethod().hasName("format")) and
      this.asExpr() = ma
    ) or
    exists(AssignmentOperation ao |
      ao.getOperator() = "+=" and
      this.asExpr() = ao
    ) or
    exists(StringLiteral sl |
      sl.getValue().matches("%(?i)(select|delete|insert|create|update|alter|drop)\\b%") and
      this.asExpr() = sl
    )
  }
}

class LoggingSanitizer extends TaintTracking::Sanitizer {
  LoggingSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%println|info|warn|warning|debug|debugging|error%") and
      this.asExpr() = ma
    )
  }
}

class ExceptionBarrier extends TaintTracking::Barrier {
  ExceptionBarrier() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType() instanceof TypeException and
      this.asExpr() = ma
    )
  }
}

module TaintFlowConfig implements TaintTracking::Configuration {
  override predicate isSource(DataFlow::Node source) { source instanceof WebInputSource }
  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }
  override predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof LoggingSanitizer }
  override predicate isBarrier(DataFlow::Node barrier) { barrier instanceof ExceptionBarrier }
}

from DataFlow::Node source, DataFlow::Node sink
where exists(TaintFlowConfig conf |
  conf.hasFlow(source, sink)
)
select sink, "User data flows into this manually-constructed SQL string.", source,
  "User input flows into SQL string here: $@", source, "user input"
