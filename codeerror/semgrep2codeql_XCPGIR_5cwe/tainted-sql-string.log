import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringManipulation
import semmle.code.java.frameworks.Spring

private class RequestParamSource extends DataFlow::Node {
  RequestParamSource() {
    exists(Method m, Parameter p, Annotation a |
      p = m.getAParameter() and
      a = p.getAnAnnotation() and
      (
        a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestBody") or
        a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable") or
