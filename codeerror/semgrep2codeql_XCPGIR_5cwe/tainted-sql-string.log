Rule Content:
/**
 * @id tainted-sql-string
 * @severity ERROR
 * @name Tainted SQL String
 * @description User data flows into this manually-constructed SQL string. User data can be safely inserted into SQL strings using prepared statements or an object-relational mapper (ORM).
 *              Manually-constructed SQL strings is a possible indicator of SQL injection, which could let an attacker steal or manipulate data from the database.
 *              Instead, use prepared statements (`connection.PreparedStatement`) or a safe library.
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodParameter p |
      source.asParameter() = p and
      isSpringSourceParameter(p) and
      not isPrimitiveType(p.getType())
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma, Callable c |
      ma.getMethod() = c and
      (
        // String.concat
        (c.getName() = "concat" and c.getDeclaringType().hasQualifiedName("java.lang", "String") and sink.asExpr() = ma.getArgument(0)) or
        // String.format
        (c.getName() = "format" and c.getDeclaringType().hasQualifiedName("java.lang", "String") and sink.asExpr() = ma.getArgument(0)) or
        // StringBuilder.append
        (c.getName() = "append" and c.getDeclaringType().hasQualifiedName("java.lang", "StringBuilder") and sink.asExpr() = ma.getArgument(0))
      )
    )
  }
}

private predicate isSpringSourceParameter(MethodParameter p) {
  exists(Annotation a | 
    a = p.getAnAnnotation() and
    (
      a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestBody") or
      a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable") or
      a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestParam") or
      a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestHeader") or
      a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "CookieValue")
    )
  )
}

private predicate isPrimitiveType(Type t) {
  t instanceof PrimitiveType or
  t.hasName("Integer") or
  t.hasName("Long") or
  t.hasName("Float") or
  t.hasName("Double") or
  t.hasName("Char") or
  t.hasName("Boolean") or
  t.hasName("int") or
  t.hasName("long") or
  t.hasName("float") or
  t.hasName("double") or
  t.hasName("char") or
  t.hasName("boolean")
}

