/**
 * @name Tainted SQL string
 * @description User data flows into this manually-constructed SQL string. User data can be safely inserted into SQL strings using prepared statements or an object-relational mapper (ORM).
 * @id java/tainted-sql-string
 * @kind path-problem
 * @severity error
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController
import semmle.code.java.StringFormat

class WebInputSource extends DataFlow::Node {
  WebInputSource() {
    exists(Parameter p |
      p.getType().hasName("String") and
      p.getAnAnnotation().getType().getName().matches("(RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue)") and
      this.asParameter() = p
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(Method m, Call c |
      (
        m.hasName("concat") or
        m.hasName("append") or
        m.hasName("format")
      ) and
      c.getMethod() = m and
      this.asExpr() = c
    ) or
    exists(AssignOperation ao |
      ao.getOperator().toString() = "+=" and
      this.asExpr() = ao
    ) or
    exists(StringLiteral sl |
      sl.getValue().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      this.asExpr() = sl
    )
  }
}

class LoggingSanitizer extends DataFlow::Node {
  LoggingSanitizer() {
    exists(Method m, Call c |
      m.getName().matches("println|info|warn|warning|debug|debugging|error") and
      c.getMethod() = m and
      this.asExpr() = c
    )
  }
}

class ExceptionBarrier extends DataFlow::Node {
  ExceptionBarrier() {
    exists(Method m, Call c |
      m.getDeclaringType() instanceof TypeException and
      c.getMethod() = m and
      this.asExpr() = c
    )
  }
}

class TaintedSQLConfig extends TaintTracking::Configuration {
  TaintedSQLConfig() { this = "TaintedSQLConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof WebInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof LoggingSanitizer
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof ExceptionBarrier
  }
}

