      concat.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = concat and
      matches(concat.getQualifier().toString(), "%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%")
    )
    or
    // String.format()
    exists(MethodAccess format |
      format.getMethod().getName() = "format" and
      format.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = format and
      matches(format.getQualifier().toString(), "%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%")
    )
    or
    // StringBuilder.append()
    exists(MethodAccess append |
      append.getMethod().getName() = "append" and
      append.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.lang", "AbstractStringBuilder") and
      this.asExpr() = append and
      not append.getCaller() instanceof LoggingMethod and
      matches(append.getQualifier().toString(), "%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%")
    )
  }
}

