Rule Content:
/**
 * @name Tainted SQL String
 * @description User data flows into this manually-constructed SQL string. 
 * User data can be safely inserted into SQL strings using prepared statements 
 * or an object-relational mapper (ORM). Manually-constructed SQL strings is 
 * a possible indicator of SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-sql-string
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.String Manipulation

class RequestParamSource extends DataFlow::Node {
  RequestParamSource() {
    exists(Method m, Parameter p |
      p = m.getAParameter() and
      (
        exists(Annotation a | 
          a = p.getAnAnnotation() and
          (
            a.getType().toString() = "RequestBody" or
            a.getType().toString() = "PathVariable" or
            a.getType().toString() = "RequestParam" or
            a.getType().toString() = "RequestHeader" or
            a.getType().toString() = "CookieValue"
          )
        )
      ) and
      not p.getType() instanceof PrimitiveType and
      this.asParameter() = p
    )
  }
}

class SqlStringSink extends DataFlow::Node {
  SqlStringSink() {
    // String concatenation
    exists(BinaryExpr binExpr |
      binExpr instanceof AddExpr and
      this.asExpr() = binExpr and
      (
        binExpr.getLeftOperand().toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%") or
        binExpr.getRightOperand().toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%")
      )
    )
    or
    // String.concat()
    exists(MethodAccess ma |
      ma.getMethod().getName() = "concat" and
      this.asExpr() = ma and
      ma.getQualifier().toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%")
    )
    or
    // String.format()
    exists(MethodAccess fmt |
      fmt.getMethod().getName() = "format" and
      this.asExpr() = fmt and
      fmt.getQualifier().toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%")
    )
    or
    // StringBuilder.append()
    exists(MethodAccess append |
      append.getMethod().getName() = "append" and
      this.asExpr() = append and
      exists(FieldInstruction fi |
        fi.getField().getName() = "LOG" and
        append.getQualifier().toString().matches("%select%|%delete%|%insert%|%create%|%update%|%alter%|%drop%")
      )
    )
  }
}

class TaintedSqlConfig extends TaintTracking::Configuration {
  TaintedSqlConfig() { this = "TaintedSqlConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof RequestParamSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlStringSink
  }
}

