 *              SQL strings using prepared statements or an object-relational mapper (ORM). Manually-constructed 
 *              SQL strings is a possible indicator of SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @precision medium
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01
 *       external/owasp/a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.TaintTracking::AdditionalTaintStep
import semmle.code.java.StringOps

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Method m, Parameter p |
      p = m.getAParameter() and
      this.asParameter() = p and
      (
        p.getAnAnnotation().getType().getNameMatches("RequestBody") or
        p.getAnAnnotation().getType().getNameMatches("PathVariable") or
        p.getAnAnnotation().getType().getNameMatches("RequestParam") or
        p.getAnAnnotation().getType().getNameMatches("RequestHeader") or
        p.getAnAnnotation().getType().getNameMatches("CookieValue")
      ) and
      not (
        p.getType().getNameMatches("Integer") or
        p.getType().getNameMatches("Long") or
        p.getType().getNameMatches("Float") or
        p.getType().getNameMatches("Double") or
        p.getType().getNameMatches("Boolean")
      )
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      (
        (ma.getMethod().getName() = "concat" and ma.getQualifier() instanceof StringLiteral) or
        (ma.getMethod().getName() = "format" and ma.getQualifier() instanceof StringLiteral) or
        exists(BinaryOperation bop |
          bop.getLeftOperand() instanceof StringLiteral and
          bop.getRightOperand() = ma and
          bop.getOperator() = "+"
        ) or
        (ma.getMethod().getName() = "append" and ma.getQualifier().getType().getName() = "StringBuilder")
      ) and
      exists(StringLiteral sl |
        sl.getValue().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
        (
          sl = ma.getQualifier() or
          exists(Expr e | e = ma.getAnArgument() and sl = e)
        )
      ) and
      not isInsideLoggingCall(ma)
    )
  }

  private predicate isInsideLoggingCall(Expr expr) {
    exists(MethodAccess ma |
      ma = expr.getEnclosingCallable().findEnclosingCall() and
      ma.getMethod().getName().matches("info|warn|warning|debug|debugging|error")
    )
  }
}

class SqlTaintConfig extends TaintTracking::Configuration {
  SqlTaintConfig() { this = "SqlTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma = node.asExpr() and
      ma.getMethod().getName() = "prepareStatement" and
      ma.getQualifier().getType().hasQualifiedName("java.sql", "Connection")
    )
  }
}

