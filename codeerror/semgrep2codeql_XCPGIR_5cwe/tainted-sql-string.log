Rule Content:
/**
 * @name Tainted SQL String
 * @description User data flows into this manually-constructed SQL string. User data can be 
 * safely inserted into SQL strings using prepared statements or an object-relational mapper (ORM).
 * Manually-constructed SQL strings is a possible indicator of SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-sql-string
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat
import semmle.code.java.StringConcat
import semmle.code.java.StringOperation
import semmle.code.java.frameworks.spring.SpringRequestMapping
import DataFlow::PathGraph

class RequestParamSource extends RemoteFlowSource::Range {
  RequestParamSource() {
    exists(Method m, Parameter p | 
      p = m.getAParameter() and
      (
        m.hasAnnotation("org.springframework.web.bind.annotation.RequestMapping") or
        p.hasAnnotation("org.springframework.web.bind.annotation.RequestParam") or
        p.hasAnnotation("org.springframework.web.bind.annotation.PathVariable") or
        p.hasAnnotation("org.springframework.web.bind.annotation.RequestHeader") or
        p.hasAnnotation("org.springframework.web.bind.annotation.CookieValue")
      ) and
      not p.getType() instanceof PrimitiveType
    )
  }
}

class SqlStringSink extends DataFlow::Node {
  SqlStringSink() {
    // String concatenation
    exists(StringConcatExpr concat | 
      this.asExpr() = concat and
      concat.getRightOperand().getType() instanceof ReferenceType and
      concat.getLeftOperand().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
    )
    or
    // String.concat()
    exists(MethodAccess ma | 
      this.asExpr() = ma and
      ma.getMethod().getName() = "concat" and
      ma.getQualifier().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
    )
    or
    // String.format()
    exists(MethodAccess fmt | 
      this.asExpr() = fmt and
      fmt.getMethod().getName() = "format" and
      fmt.getQualifier().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
    )
    or
    // StringBuilder.append()
    exists(MethodAccess append | 
      this.asExpr() = append and
      append.getMethod().getName() = "append" and
      append.getQualifier().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
    )
  }
}

module TaintConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { source instanceof RequestParamSource }
  predicate isSink(DataFlow::Node sink) { sink instanceof SqlStringSink }
}

module TaintedSqlFlow = TaintFlow::Make<TaintConfig>;

from DataFlow::PathNode source, DataFlow::PathNode sink
where TaintedSqlFlow.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User data flows into this manually-constructed SQL string without using prepared statements."
