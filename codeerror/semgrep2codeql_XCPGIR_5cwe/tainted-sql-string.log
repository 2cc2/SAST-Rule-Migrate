  message: "User data flows into this manually-constructed SQL string. User data can be safely inserted into SQL strings using prepared statements or an object-relational mapper (ORM). Manually-constructed SQL strings is a possible indicator of SQL injection."
  metadata:
    cwe: ["CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"]
    owasp: ["A01:2017 - Injection", "A03:2021 - Injection"]
    references: ["https://docs.oracle.com/javase/7/docs/api/java/sql/PreparedStatement.html"]
    technology: ["spring"]
    likelihood: HIGH
    impact: MEDIUM
    confidence: MEDIUM

scope:
  languages: [java]
  frameworks: ["spring"]

sources:
  - id: USER_INPUT
    match:
      node: PARAM
      where:
        - op: regex
          left: annotation
          right: "(RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue)"
        - op: not_regex
          left: typeFullName
          right: "^java\.lang\.(Integer|Long|Float|Double|Boolean)"

sinks:
  - id: SQL_CONCAT
    match:
      node: CALL
      where:
        - pattern-either:
            - pattern: "$SQLSTR + ..."
            - pattern: "$SQLSTR.concat(...)"
            - pattern: "StringBuilder.append(...)"
            - pattern: "String.format($SQLSTR, ...)"
        - op: regex
          left: $SQLSTR
          right: "(?i)(select|delete|insert|create|update|alter|drop)\\b"
        - pattern-not-inside: ["LOGGING_CALL", "EXCEPTION"]

sanitizers:
  - id: PREPARED_STATEMENT
    match:
      node: CALL
      api: {type: "java.sql.Connection", method: "prepareStatement"}
    effect: neutralize

barriers:
  - id: LOGGING_CALL
    match:
      node: CALL
      where:
        - op: regex
          left: methodFullName
          right: ".*\.(info|warn|warning|debug|debugging|error)"
    effect: stop

propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
  - id: STRING_OPS
    edge: [arg->receiver, arg->return]
    kind: taint
    where:
      - op: regex
        left: methodFullName
        right: "java\.lang\.String\.(concat|format|\\+)"

flows:
  - source: USER_INPUT
    sink: SQL_CONCAT
    through: [ARG_TO_PARAM*, STRING_OPS*]
    constraints:
      path:
        must_not: ["PREPARED_STATEMENT"]

report:
  message: "User data flows into SQL string construction without proper sanitization"
  locations: ["source", "sink"]
  evidence:
    capture:
      - {source: "param", sink: "sql_expr"}

tests:
  positive:
    - "String query = \"SELECT * FROM users WHERE name = '\" + userInput + \"'\";"
  negative:
    - "PreparedStatement stmt = conn.prepareStatement(\"SELECT * FROM users WHERE name = ?\");"
```
