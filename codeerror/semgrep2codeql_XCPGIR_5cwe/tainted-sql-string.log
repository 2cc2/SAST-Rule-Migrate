Rule Content:
/**
 * @name Tainted SQL String
 * @description User data flows into this manually-constructed SQL string. User data can be safely
 *              inserted into SQL strings using prepared statements or an object-relational mapper (ORM).
 *              Manually-constructed SQL strings is a possible indicator of SQL injection, which could
 *              let an attacker steal or manipulate data from the database.
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-564
 * @id java/tainted-sql-string
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController
import DataFlow::PathGraph

predicate isUserInput(Expr expr) {
  exists(Parameter p | expr = p.getAnAccess() |
    (p.getCallable().hasAnnotation("RequestBody") or
     p.getCallable().hasAnnotation("PathVariable") or
     p.getCallable().hasAnnotation("RequestParam") or
     p.getCallable().hasAnnotation("RequestHeader") or
     p.getCallable().hasAnnotation("CookieValue"))
    and
    not expr.getType() instanceof PrimitiveType
  )
}

predicate isSqlConcat(Expr expr) {
  // $SQL + ...
  exists(BinaryExpr be | expr = be |
    be.getOperator() = BinaryOperator.PLUS and
    be.getLeftOperand().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
  )
  or
  // $SQL.concat(...)
  exists(MethodAccess ma | expr = ma |
    ma.getMethod().getName() = "concat" and
    ma.getQualifier().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
  )
  or
  // new StringBuilder($SQL)
  exists(ConstructorCall cc | expr = cc |
    cc.getConstructedType().hasQualifiedName("java.lang", "StringBuilder") and
    exists(cc.getAnArgument().toString() | matches("(?i)(select|delete|insert|create|update|alter|drop)\\b"))
  )
  or
  // $VAR += ...
  exists(AssignOperation ao | expr = ao |
    ao.getOperator() = AssignOperator.PLUS and
    ao.getLeftOperand().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b")
  )
  or
  // String.format($SQL, ...)
  exists(MethodAccess ma | expr = ma |
    ma.getMethod().hasName("format") and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
    exists(ma.getAnArgument().toString() | matches("(?i)(select|delete|insert|create|update|alter|drop)\\b"))
  )
}

predicate isSafeLogging(DataFlow::Node node) {
  exists(MethodAccess ma | node.asExpr() = ma |
    ma.getMethod().getName().matches("info|warn|warning|debug|debugging|error")
  )
}

predicate isExceptionBarrier(DataFlow::Node node) {
  exists(ClassInstanceExpr cie | node.asExpr() = cie |
    cie.getConstructedType().hasQualifiedName("java.lang", "Exception")
  )
  or
  exists(ThrowStmt ts | node.asExpr() = ts.getExpr())
}

class TaintedSQLStringConfig extends TaintTracking::Configuration {
  TaintedSQLStringConfig() { this = "TaintedSQLStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Expr e | e = source.asExpr() | isUserInput(e))
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Expr e | e = sink.asExpr() | isSqlConcat(e))
  }

  override predicate isSanitizer(DataFlow::Node node) {
    isSafeLogging(node)
  }

  override predicate isBarrier(DataFlow::Node node) {
    isExceptionBarrier(node)
  }
}

from TaintedSQLStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection from user input to manual SQL string construction", 
  source, source.toString() + " to " + sink.toString()
