/**
 * @name Tainted SQL string
 * @description User data flows into this manually-constructed SQL string...
 * @id java/tainted-sql-string
 * @kind path-problem
 * @severity error
 * @tags security
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController
import semmle.code.java.StringFormat

class WebInputSource extends DataFlow::Node {
  WebInputSource() {
    exists(Parameter p |
      p.getType().hasName("String") and
      p.getAnAnnotation().getType().getName().regexpMatch("(RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue)") and
      this.asParameter() = p
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().hasName("concat") or
        ma.getMethod().hasName("append") or 
        ma.getMethod().hasName("format")
      ) and
      this.asExpr() = ma
    ) or
    exists(AddAssignExpr aae |
      this.asExpr() = aae
    ) or
    exists(StringLiteral sl |
      sl.getValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      this.asExpr() = sl
    )
  }
}

class LoggingSanitizer extends DataFlow::Node {
  LoggingSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName().regexpMatch("println|info|warn|warning|debug|debugging|error") and
      this.asExpr() = ma
    )
  }
}

class ExceptionBarrier extends DataFlow::BarrierGuard {
  ExceptionBarrier() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType() instanceof TypeException
    )
  }
}

class TaintedSQLConfig extends TaintTracking::Configuration {
  override predicate isSource(DataFlow::Node source) { source instanceof WebInputSource }
  
  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }
  
  override predicate isSanitizer(DataFlow::Node node) { 
    node instanceof LoggingSanitizer
  }
  
  override predicate isBarrier(DataFlow::BarrierGuard barrier) {
    barrier instanceof ExceptionBarrier
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSQLConfig config
where config.hasFlowPath(source, sink)
select sink, "User data flows into this manually-constructed SQL string", source,
  "User input flows into SQL string here: $@", source, "user input"
