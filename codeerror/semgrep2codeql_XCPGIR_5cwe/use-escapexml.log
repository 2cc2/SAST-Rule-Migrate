/**
 * @name Use of unescaped Expression Language segments
 * @description Detects Expression Language segments without XML escaping before output,
 *              which could lead to cross-site scripting vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/use-escapexml
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringLiterals

class UnescapedELSource extends StringLiteral {
  UnescapedELSource() {
    this.getValue().matches("\\$\\{(?!.*escapeXml).*\\}")
  }
}

class JspPrintSink extends DataFlow::Node {
  JspPrintSink() {
    exists(Method m | 
      m.hasName("print") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.jsp", "JspWriter") and
      this.asExpr() = m.getACall().getArgument(0)
    )
  }
}

class EscapeXmlSanitizer extends DataFlow::Node {
  EscapeXmlSanitizer() {
    exists(Method m | 
      m.hasName("escapeXml") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.jsp.jstl.core.fn", "") and
      this.asExpr() = m.getACall()
    )
  }
}

class UnsafeELToJspPrintFlow extends TaintTracking::Configuration {
  UnsafeELToJspPrintFlow() {
    this = "Unsafe EL to JspWriter.print flow"
  }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof UnescapedELSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JspPrintSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof EscapeXmlSanitizer
  }
}

