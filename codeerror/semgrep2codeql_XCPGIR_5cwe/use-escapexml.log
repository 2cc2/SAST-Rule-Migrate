/**
 * @name Unescaped Expression Language segments
 * @description Detects Expression Language segments without XML escaping before output,
 *              which could lead to cross-site scripting vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/use-escapexml
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import DataFlow::PathGraph

class UnescapedELSource extends StringLiteral {
  UnescapedELSource() {
    this.getText().regexpMatches("\\$\\{(?!.*escapeXml).*\\}")
  }
}

class JspPrintCall extends MethodAccess {
  JspPrintCall() {
    this.getMethod().hasName("print") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp", "JspWriter")
  }
}

class EscapeXmlCall extends MethodAccess {
  EscapeXmlCall() {
    this.getMethod().hasName("escapeXml") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp.jstl.core.fn", "")
  }
}

class JspPrintSink extends DataFlow::Node {
  JspPrintSink() {
    exists(JspPrintCall jpc |
      this.asExpr() = jpc.getArgument(0)
    )
  }
}

class UnescapedELToJspPrintFlow extends DataFlow::Configuration {
  UnescapedELToJspPrintFlow() {
    this = "Unescaped EL to JspWriter.print flow"
  }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof UnescapedELSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(JspPrintSink jps | sink.asExpr() = jps)
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(EscapeXmlCall esc | node.asExpr() = esc)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, UnescapedELToJspPrintFlow conf
where conf.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(),
  "Unescaped Expression Language segment detected. Potential XSS vulnerability.",
  source.getNode(), "this EL expression is not properly escaped"
