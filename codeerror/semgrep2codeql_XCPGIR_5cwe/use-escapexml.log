Rule Content:
/**
 * @name Use of unescaped Expression Language segments
 * @description Detects Expression Language segments without XML escaping before output,
 *              which could lead to cross-site scripting vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/use-escapexml
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.JSP
import semmle.code.java.StringLiterals

class UnescapedELSource extends Literal {
  UnescapedELSource() {
    this.getText().regexpMatch("\\$\\{(?!.*escapeXml).*\\}")
  }
}

class EscapingSanitizer extends MethodAccess {
  EscapingSanitizer() {
    this.getMethod().hasName("escapeXml") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp.jstl.core.fn", "")
  }
}

class JspPrintSink extends DataFlow::Node {
  JspPrintSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("print") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp", "JspWriter") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class UnescapedELToJspPrintConfig extends TaintTracking::Configuration {
  UnescapedELToJspPrintConfig() {
    this = "Unescaped EL to JspWriter.print flow"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(UnescapedELSource el | source.asExpr() = el)
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JspPrintSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(EscapingSanitizer esc | sanitizer.asExpr() = esc)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, UnescapedELToJspPrintConfig conf
where conf.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(),
  "Unescaped Expression Language segment detected. Potential XSS vulnerability.",
  source.getNode(), "this EL expression is not properly escaped"
