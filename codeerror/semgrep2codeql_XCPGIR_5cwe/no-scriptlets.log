Rule Content:
/**
 * @name JSP Scriptlet Detection
 * @description Detects the use of JSP scriptlets which are considered bad practice.
 * @kind path-problem
 * @problem.severity warning
 * @id java/no-scriptlets
 * @tags security
 */

import java
import semmle.code.jsp.JSP

predicate isScriptlet(Expr expr) {
  exists(JspScriptlet scriptlet |
    exists(JspScriptletTag tag |
      tag.getElement().getText().regexpMatch("<%[^@].*") and
      scriptlet = tag.getScriptlet() and
      scriptlet.getExpression() = expr
    )
  )
}

predicate usesJspWriterPrint(Call call) {
  exists(MethodAccess ma |
    ma = call and
    ma.getMethod().getName() = "print" and
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp", "JspWriter")
  )
}

from Expr scriptletExpr, Call printCall
where
  isScriptlet(scriptletExpr) and
  usesJspWriterPrint(printCall)
select scriptletExpr, "JSP scriptlet detected. Scriptlets are difficult to use securely and are considered bad practice. Instead, consider migrating to JSF or using the Expression Language '${...}' with the escapeXml function in your JSP files."
