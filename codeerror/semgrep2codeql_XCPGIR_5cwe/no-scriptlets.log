Rule Content:
/**
 * @name JSP Scriptlet Detection
 * @description Detects the use of JSP scriptlets which are considered bad practice.
 * @kind path-problem
 * @problem.severity warning
 * @id java/no-scriptlets
 * @tags security
 * @precision high
 */

import java
import semmle.code.java.dataflow.DataFlow

predicate isScriptlet(Expr expr) {
  exists(StringLiteral literal |
    expr = literal and
    literal.getValue().regexpMatch("<%[^@].*")
  )
}

predicate isJspWriterPrintCall(Expr expr) {
  exists(MethodAccess ma |
    expr = ma and
    ma.getMethod().getName() = "print" and
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp", "JspWriter")
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  isScriptlet(source.asExpr()) and
  isJspWriterPrintCall(sink.asExpr()) and
  DataFlow::localFlow(source, sink)
select sink.asExpr(), "JSP scriptlet detected. Scriptlets are difficult to use securely and are considered bad practice. Consider migrating to JSF or using Expression Language '${...}' with escapeXml function in your JSP files.",
  source.asExpr(), sink.asExpr(), "Scriptlet flows to JspWriter.print call"
