Rule Content:
/**
 * @name Formatted SQL String
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized. Use prepared 
 *              statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 * @id java/formatted-sql-string
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import DataFlow::PathGraph

class HttpServletRequestSource extends RemoteFlowSource::Range {
  HttpServletRequestSource() {
    exists(Method m | m.getName().matches("%HttpServletRequest%") | this.asExpr() = any(RemoteFlowInput input).getInput())
  }
}

class StringConcatenation extends DataFlow::Node {
  StringConcatenation() {
    exists(MethodAccess ma | 
      (ma.getMethod().getName().matches("format|concat|join") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) |
      this.asExpr() = ma
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("execute|executeQuery|createQuery|query|addBatch|nativeSQL|create|prepare") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement")) and
      not ma.getArgument(0).toString().matches(".*TABLE *$|.*TABLE %s$") |
      this.asExpr() = ma
    )
  }
}

class StringBuilderPropagation extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma | 
      ma.getMethod().getName() = "append" and
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder") or
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuffer")) and
      pred.asExpr() = ma.getReceiver() and
      succ.asExpr() = ma
    )
  }
}

class CriteriaBuilderSanitizer extends TaintTracking::Sanitizer {
  override predicate sanitizes(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.persistence.criteria", "CriteriaBuilder") |
      node.asExpr() = ma
    )
  }
}

class FormattedSqlStringConfig extends TaintTracking::Configuration {
  FormattedSqlStringConfig() { this = "FormattedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpServletRequestSource or
    source instanceof StringConcatenation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof CriteriaBuilderSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    pred instanceof StringBuilderPropagation
  }
}

from FormattedSqlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input reaches SQL execution without sanitization. Consider using prepared statements."
