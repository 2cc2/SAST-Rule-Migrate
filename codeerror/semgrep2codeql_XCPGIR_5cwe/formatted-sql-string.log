Rule Content:
/**
 * @name Formatted SQL String
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized. Use prepared 
 *              statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 * @id java/formatted-sql-string
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpServletRequestSource extends DataFlow::Node {
  HttpServletRequestSource() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") |
      this.asParameter() = m.getAParameter()
    )
  }
}

class StringConcatenation extends DataFlow::Node {
  StringConcatenation() {
    exists(Method m | 
      (m.getName().matches("format|concat|join") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String")) |
      this.asExpr() = m.getACallToThisMethod()
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(Method m |
      m.getName().matches("execute|executeQuery|createQuery|query|addBatch|nativeSQL|create|prepare") and
      m.getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      not m.getACallToThisMethod().getArgument(0).toString().matches(".*TABLE *$|.*TABLE %s$") |
      this.asExpr() = m.getACallToThisMethod()
    )
  }
}

class StringBuilderPropagation extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Method m | 
      m.getName() = "append" and
      (m.getDeclaringType().hasQualifiedName("java.lang", "StringBuilder") or
      m.getDeclaringType().hasQualifiedName("java.lang", "StringBuffer")) |
      pred.asExpr() = m.getACallToThisMethod().getQualifier() and
      succ.asExpr() = m.getACallToThisMethod()
    )
  }
}

class FormattedSqlStringConfig extends TaintTracking::Configuration {
  FormattedSqlStringConfig() { this = "FormattedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpServletRequestSource or
    source instanceof StringConcatenation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("javax.persistence.criteria", "CriteriaBuilder") |
      node.asExpr() = m.getACallToThisMethod()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringBuilderPropagation sbp | sbp.step(pred, succ))
  }
}

