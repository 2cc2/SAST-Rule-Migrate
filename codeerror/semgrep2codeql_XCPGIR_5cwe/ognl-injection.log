/**
 * @name OGNL Injection
 * @id java/ognl-injection
 * @description Detects potential OGNL injection vulnerabilities where untrusted input
 *              flows into OGNL expression evaluation
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class OgnlInjectionConfig extends TaintTracking::Configuration {
  OgnlInjectionConfig() { this = "OGNLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | 
      source.asParameter() = p and 
      p.getType() instanceof TypeString
    )
    or
    exists(Field f | 
      source.asExpr() = f.getAnAccess() and
      f.getType() instanceof TypeString
    )
    or
    exists(LocalVariableDecl lvd |
      source.asExpr() = lvd.getVariable().getAnAccess() and
      lvd.getType() instanceof TypeString
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, MethodAccess ma |
      ma.getMethod() = m and
      (
        m.getDeclaringType().getQualifiedName().matches("ognl%") or
        m.getDeclaringType().getQualifiedName().matches("com.opensymphony.xwork2.util%")
      ) and
      m.getName().matches(
        "getGetMethod|getSetMethod|getField|setProperties|setProperty|getValue|setValue|" +
        "translateVariables|translateVariablesCollection|shallBeIncluded|" +
        "commaDelimitedStringToSet|evaluate|callMethod|compile|isTrue|findString|" +
        "findValue|getText|makeSelectList|setParameter"
      ) and
      (
        sink.asExpr() = ma.getArgument(0) or
        sink.asExpr() = ma.getArgument(1)
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral sl | node.asExpr() = sl)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, OgnlInjectionConfig conf
where conf.hasFlowPath(source, sink)
select sink, source, sink, "Potential OGNL injection vulnerability from $@ to $@",
  source, "source", sink, "sink"
