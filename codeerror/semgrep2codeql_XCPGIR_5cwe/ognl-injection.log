/**
 * @name OGNL Injection Vulnerability
 * @description Detects potential OGNL expression injection vulnerabilities where user input flows into OGNL evaluation methods
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 */

import java
import semmle.code.java.dataflow.DataFlow

class OgnlInjectionConfig extends DataFlow::Configuration {
  OgnlInjectionConfig() { this = "OgnlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      source.asParameter() = p and
      not(p.getDefaultValue() instanceof StringLiteral and
          p.getDefaultValue().toString() = "\"...\"")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().getQualifiedName() matches "^(ognl|struts)\.(OgnlReflectionProvider|ReflectionProvider|TextParseUtil|TextParser|OgnlTextParser|OgnlUtil|VelocityStrutsUtil|StrutsUtil|OgnlTool|ValueStack)$" and
      ma.getMethod().getName() in [
        "getGetMethod", "getSetMethod", "getField", "setProperties", "setProperty",
        "getValue", "setValue", "translateVariables", "translateVariablesCollection",
        "shallBeIncluded", "commaDelimitedStringToSet", "evaluate", "callMethod",
        "compile", "isTrue", "findString", "findValue", "getText", "makeSelectList",
        "setParameter"
      ] and
      sink.asExpr() = ma.getArgument(0)
    )
  }
}

