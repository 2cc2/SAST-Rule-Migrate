 * @description Detects potential OGNL injection through dynamic input
 * @kind path-problem
 * @id java/ognl-injection
 * @problem.severity warning
 * @security-severity 8.8
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.ognl.OgnlMethods

class OgnlInjectionConfig extends TaintTracking::Configuration {
  OgnlInjectionConfig() { this = "OgnlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodParameter p |
      source.asParameter() = p and
      not p.getType().(PrimitiveType).hasName("string") and
      not p.getInitializer().isCompileTimeConstant()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().getQualifiedName().matches(
        "OgnlReflectionProvider|ReflectionProvider|TextParseUtil|TextParser|OgnlTextParser|" +
        "OgnlUtil|VelocityStrutsUtil|StrutsUtil|OgnlTool|ValueStack"
      ) and
      ma.getMethod().getName().matches(
        "getGetMethod|getSetMethod|getField|setProperties|setProperty|getValue|" +
        "setValue|translateVariables|translateVariablesCollection|shallBeIncluded|" +
        "commaDelimitedStringToSet|evaluate|callMethod|compile|isTrue|findString|" +
        "findValue|getText|makeSelectList|setParameter"
      ) and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal l | sanitizer.asExpr() = l and l.isCompileTimeConstant())
  }
}

