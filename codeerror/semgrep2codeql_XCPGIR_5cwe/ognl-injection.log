/**
 * @name OGNL Injection
 * @id java/ognl-injection
 * @kind path-problem
 * @problem.severity warning
 * @description Detects potential OGNL injection vulnerabilities where untrusted input
 *              flows into OGNL expression evaluation.
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.ognl.Ognl
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class OgnlInjectionConfig extends TaintTracking::Configuration {
  OgnlInjectionConfig() { this = "OGNL Injection" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p and p.getType().hasName("String")) or
    exists(Field f | source.asField() = f and f.getType().hasName("String")) or
    exists(LocalVariableDecl v | source.asLocalVariable() = v and v.getType().hasName("String"))
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (
        ma.getMethod().getDeclaringType().getQualifiedName().matches("ognl|com.opensymphony.xwork2.util") and
        ma.getMethod().getName().matches(
          "getGetMethod|getSetMethod|getField|setProperties|setProperty|getValue|setValue|" +
          "translateVariables|translateVariablesCollection|shallBeIncluded|commaDelimitedStringToSet|" +
          "evaluate|callMethod|compile|isTrue|findString|findValue|getText|makeSelectList|setParameter"
        ) and
        (
          sink.asExpr() = ma.getArgument(0) or
          sink.asExpr() = ma.getArgument(1)
        )
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node.getType() instanceof StringType and
    exists(StringLiteral sl | node.asExpr() = sl)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, OgnlInjectionConfig conf
where conf.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential OGNL injection vulnerability detected"
