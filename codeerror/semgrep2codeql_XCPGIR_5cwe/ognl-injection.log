/**
 * @name OGNL Injection Vulnerability
 * @description Detects potential OGNL expression injection vulnerabilities where user input flows into OGNL evaluation methods
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Struts
import semmle.code.java.security.OGNL

class OgnlInjectionConfig extends TaintTracking::Configuration {
  OgnlInjectionConfig() { this = "OgnlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      source.asParameter() = p and
      // Skip literal string "..."
      not(p.getDefaultValue().toString() = "\"...\"")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma, Method m |
      ma.getMethod() = m and
      (
        m.getDeclaringType().hasQualifiedName(["ognl", "struts"], ["OgnlReflectionProvider", "ReflectionProvider", "TextParseUtil", 
          "TextParser", "OgnlTextParser", "OgnlUtil", "VelocityStrutsUtil", "StrutsUtil", "OgnlTool", "ValueStack"]) and
        m.hasName(["getGetMethod", "getSetMethod", "getField", "setProperties", "setProperty", "getValue", 
          "setValue", "translateVariables", "translateVariablesCollection", "shallBeIncluded", 
          "commaDelimitedStringToSet", "evaluate", "callMethod", "compile", "isTrue", "findString", 
          "findValue", "getText", "makeSelectList", "setParameter"])
      ) and
      sink.asExpr() = ma.getArgument(0)
    )
  }
}

