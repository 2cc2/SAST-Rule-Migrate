/**
 * @name OGNL Injection
 * @id ognl-injection
 * @kind path-problem
 * @problem.severity warning
 * @description Detect potential OGNL injection vulnerabilities where untrusted input
 *              flows into OGNL expression evaluation.
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class OgnlInjectionConfig extends TaintTracking::Configuration {
  OgnlInjectionConfig() { this = "OGNL Injection" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p and p.getType().hasName("String")) or
    exists(Field f | source.asExpr() instanceof FieldAccess and 
           source.asExpr().(FieldAccess).getField() = f and 
           f.getType().hasName("String")) or
    exists(LocalVariableDecl v | source.asExpr() instanceof LocalVariableAccess and
           source.asExpr().(LocalVariableAccess).getLocalVariable() = v and
           v.getType().hasName("String"))
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Expr arg |
      m.getDeclaringType().getQualifiedName().matches("ognl%|com.opensymphony.xwork2.util%") and
      m.getName().matches(
        "getGetMethod|getSetMethod|getField|setProperties|setProperty|getValue|setValue|" +
        "translateVariables|translateVariablesCollection|shallBeIncluded|" +
        "commaDelimitedStringToSet|evaluate|callMethod|compile|isTrue|" +
        "findString|findValue|getText|makeSelectList|setParameter"
      ) and
      (
        sink.asExpr() = m.getACall().getArgument(0) or
        sink.asExpr() = m.getACall().getArgument(1)
      ) and
      arg = sink.asExpr()
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral sl | node.asExpr() = sl)
  }
}

