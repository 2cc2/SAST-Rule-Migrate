Rule Content:
/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Struts
import DataFlow::PathGraph

class OgnlInjectionConfiguration extends TaintTracking::Configuration {
  OgnlInjectionConfiguration() { this = "OgnlInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, Parameter p |
      ma.getArgument(0) = source.asExpr() and
      p = ma.getCaller() and
      not source.asExpr().(StringLiteral).getText().regexpMatch("^\"[^\"]*\"$")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      // OgnlReflectionProvider sinks
      (ma.getMethod().getDeclaringType().hasQualifiedName("ognl", "OgnlReflectionProvider") and
       ma.getMethod().getName().matches("getGetMethod|getSetMethod|getField|setProperties|setProperty|getValue|setValue") and
       ma.getArgument(1) = sink.asExpr())
      or
      // ReflectionProvider sinks
      (ma.getMethod().getDeclaringType().hasQualifiedName("ognl", "ReflectionProvider") and
       ma.getMethod().getName().matches("getGetMethod|getSetMethod|getField|setProperties|setProperty|getValue|setValue") and
       ma.getArgument(1) = sink.asExpr())
      or
      // TextParseUtil sinks
      (ma.getMethod().getDeclaringType().hasQualifiedName("ognl", "TextParseUtil") and
       ma.getMethod().getName().matches("translateVariables|translateVariablesCollection|shallBeIncluded|commaDelimitedStringToSet") and
       ma.getArgument(0) = sink.asExpr())
      or
      // OgnlUtil sinks
      (ma.getMethod().getDeclaringType().hasQualifiedName("ognl", "OgnlUtil") and
       ma.getMethod().getName().matches("setProperties|setProperty|getValue|setValue|callMethod|compile") and
       ma.getArgument(0) = sink.asExpr())
      or
      // StrutsUtil sinks
      (ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.struts2.util", "StrutsUtil") and
       ma.getMethod().getName().matches("isTrue|findString|findValue|getText|translateVariables|makeSelectList") and
       ma.getArgument(0) = sink.asExpr())
    )
  }
}

from OgnlInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "Potential OGNL injection found from $@ to $@", source, sink
