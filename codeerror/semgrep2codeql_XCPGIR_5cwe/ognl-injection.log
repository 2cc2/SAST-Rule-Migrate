xcpgir_version: "1.0"
rule:
  id: "ognl-injection"
  kind: taint
  severity: WARNING
  message: "A expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."
scope:
  languages: [java]
  frameworks: ["ognl", "struts"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: UNTRUSTED_INPUT
    match:
      node: PARAM | FIELD | LOCAL
      type:
        name: "java.lang.String"

sinks:
  - id: OGNL_INJECTION
    match:
      node: CALL
      api:
        package: "ognl|com.opensymphony.xwork2.util"
        type: "OgnlReflectionProvider|ReflectionProvider|TextParseUtil|OgnlUtil|StrutsUtil|ValueStack"
        method: "getGetMethod|getSetMethod|getField|setProperties|setProperty|getValue|setValue|translateVariables|translateVariablesCollection|shallBeIncluded|commaDelimitedStringToSet|evaluate|callMethod|compile|isTrue|findString|findValue|getText|makeSelectList|setParameter"
      arg_index: [0, 1]

sanitizers:
  - id: STRING_LITERAL
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: '^".*"$'
    effect: neutralize

barriers: []

propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
  - id: FIELD_STORE
    edge: field-store
    kind: taint
  - id: FIELD_LOAD
    edge: field-load
    kind: taint

flows:
  - source: UNTRUSTED_INPUT
    sink: OGNL_INJECTION
    through: [ARG_TO_PARAM*, FIELD_STORE*, FIELD_LOAD*]
    constraints:
      path:
        must_not: [STRING_LITERAL]

report:
  message: "Potential OGNL injection vulnerability detected"
  locations: ["source", "sink", "path"]
  evidence: 
    capture: 
      - argument: 0
      - argument: 1

tests:
  positive:
    - "ognlUtil.getValue(userInput, context);"
    - "textParser.evaluate(param);"
  negative:
    - "ognlUtil.getValue(\"safe_literal\", context);"
    - "textParser.evaluate(\"safe_string\");"
