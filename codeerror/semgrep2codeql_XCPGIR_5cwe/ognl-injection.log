/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should 
 *              be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind taint
 * @severity Warning
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat

class OgnlReflectionProvider extends RefType {
  OgnlReflectionProvider() {
    this.hasQualifiedName("org.apache.commons.ognl", "OgnlReflectionProvider") 
    or
    this.hasQualifiedName("org.apache.commons.ognl", "ReflectionProvider")
  }
}

class TextParseUtil extends RefType {
  TextParseUtil() {
    this.hasQualifiedName("org.apache.commons.ognl", "TextParseUtil")
  }
}

class OgnlSink extends DataFlow::Node {
  OgnlSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType() instanceof OgnlReflectionProvider and
       ma.getMethod().getName() in ["getGetMethod", "getSetMethod", "getField", "setProperties", "setProperty", "getValue", "setValue"] and
       this.asExpr() = ma.getArgument(1))
      or
      (ma.getMethod().getDeclaringType() instanceof TextParseUtil and
       ma.getMethod().getName() in ["translateVariables", "translateVariablesCollection", "shallBeIncluded", "commaDelimitedStringToSet"] and
       this.asExpr() = ma.getArgument(0))
    )
  }
}

class OgnlTaintTrackingConfig extends TaintTracking::Configuration {
  OgnlTaintTrackingConfig() { this = "OgnlTaintTrackingConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p and source.asParameter().getType() instanceof TypeString)
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OgnlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sanitizer.asExpr() = sl)
  }
}

