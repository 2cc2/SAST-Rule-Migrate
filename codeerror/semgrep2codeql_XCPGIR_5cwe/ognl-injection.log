/**
 * @name OGNL Injection Vulnerability
 * @description Detects potential OGNL expression injection vulnerabilities where user input flows into OGNL evaluation methods
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 */

import java
import semmle.code.java.dataflow.TaintTracking

class OgnlInjectionConfig extends TaintTracking::Configuration {
  OgnlInjectionConfig() { this = "OgnlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      source.asParameter() = p and
      not exists(p.getAnAccess().getArgument() |
        toString() = "\"...\""
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call c, Method m |
      c.getTarget() = m and
      (m.getDeclaringType().hasQualifiedName("ognl", _) or 
       m.getDeclaringType().hasQualifiedName("struts", _)) and
      m.getDeclaringType().getName() in [
        "OgnlReflectionProvider", "ReflectionProvider", "TextParseUtil", 
        "TextParser", "OgnlTextParser", "OgnlUtil", "VelocityStrutsUtil",
        "StrutsUtil", "OgnlTool", "ValueStack"
      ] and
      m.getName() in [
        "getGetMethod", "getSetMethod", "getField", "setProperties", "setProperty",
        "getValue", "setValue", "translateVariables", "translateVariablesCollection",
        "shallBeIncluded", "commaDelimitedStringToSet", "evaluate", "callMethod",
        "compile", "isTrue", "findString", "findValue", "getText", "makeSelectList",
        "setParameter"
      ] and
      sink.asExpr() = c.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, OgnlInjectionConfig config
where config.hasFlowPath(source, sink)
select sink, "Potential OGNL injection vulnerability detected", source, sink,
  "User input flows into OGNL evaluation method $@", source.getNode(), "user input here",
  sink.getNode(), "OGNL evaluation here"
