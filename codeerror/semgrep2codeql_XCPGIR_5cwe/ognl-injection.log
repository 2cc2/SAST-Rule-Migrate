    this.hasQualifiedName("org.apache.commons.ognl", "OgnlReflectionProvider")
  }
}

class ReflectionProvider extends RefType {
  ReflectionProvider() {
    this.hasQualifiedName("org.apache.commons.ognl", "ReflectionProvider")
  }
}

class TextParseUtil extends RefType {
  TextParseUtil() {
    this.hasQualifiedName("org.apache.commons.ognl", "TextParseUtil")
  }
}

class OgnlSink extends DataFlow::Node {
  OgnlSink() {
    exists(Method m, MethodAccess ma |
      ((m.getDeclaringType() instanceof OgnlReflectionProvider or
        m.getDeclaringType() instanceof ReflectionProvider) and
       m.getName() in ["getGetMethod", "getSetMethod", "getField", "setProperties", "setProperty", "getValue", "setValue"] and
       ma.getMethod() = m and
       this.asExpr() = ma.getArgument(1))
      or
      (m.getDeclaringType() instanceof TextParseUtil and
       m.getName() in ["translateVariables", "translateVariablesCollection", "shallBeIncluded", "commaDelimitedStringToSet"] and
       ma.getMethod() = m and
       this.asExpr() = ma.getArgument(0))
    )
  }
}

class DynamicInputSource extends DataFlow::Node {
  DynamicInputSource() {
    exists(Parameter p | this.asParameter() = p and p.getType() instanceof TypeString)
  }
}

class StringLiteralSanitizer extends DataFlow::Node {
  StringLiteralSanitizer() {
    exists(StringLiteral sl | this.asExpr() = sl)
  }
}

class OgnlTaintTrackingConfig extends TaintTracking::Configuration {
  OgnlTaintTrackingConfig() { this = "OgnlTaintTrackingConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OgnlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StringLiteralSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, OgnlTaintTrackingConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential OGNL injection detected: $@ called with dynamic input",
  sink.getNode(),
  sink.getNode().(DataFlow::MethodCallNode).getMethod().getName()
