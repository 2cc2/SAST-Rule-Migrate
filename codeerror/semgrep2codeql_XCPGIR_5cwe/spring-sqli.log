Rule Content:
/**
 * @name Spring SQL Injection
 * @description Detected a string argument from a public method contract in a raw SQL statement.
 *              This could lead to SQL injection if variables are not properly sanitized. 
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @id java/spring-sqli
 * @security-severity 8.8
 * @tags security
 */

import java
import semmle.code.java.dataflow.TaintTracking
import Semmle.SQLInjection

class StringPublicParameter extends TaintTracking::Source {
  StringPublicParameter() {
    exists(Method m, Parameter p | 
      m.isPublic() and 
      p = m.getAParameter() and 
      p.getType() instanceof StringType
    )
    and
    this.asParameter() = m.getAParameter()
  }

  override string getSourceType() { "Public string method parameter" }
}

class SpringSqlSink extends TaintTracking::Sink {
  SpringSqlSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", 
          "PreparedStatementCreatorFactory") and
        ma.getMethod().hasName("<init>") and
        ma.getArgument(0) = this.asExpr()
      )
      or
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", 
          "JdbcTemplate") and
        ma.getArgument(0) = this.asExpr()
      )
      or
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", 
          "NamedParameterBatchUpdateUtils") and
        ma.getArgument(0) = this.asExpr()
      )
    )
  }

  override string getSinkType() { "Spring SQL execution method" }
}

class SpringSqlConfiguration extends TaintTracking::Configuration {
  SpringSqlConfiguration() { this = "SpringSqlConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof StringPublicParameter }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SpringSqlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(ConstructorCall cc | 
      cc.getConstructedType() instanceof StringType and 
      cc = sanitizer.asExpr()
    )
  }
}

from SpringSqlConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Potential SQL injection from public string parameter to Spring SQL execution method",
  source, sink,
  "Untrusted input flows to SQL execution point without proper sanitization"
