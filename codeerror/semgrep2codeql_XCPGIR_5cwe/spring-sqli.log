/**
 * @name Spring SQL Injection 
 * @description Detected a string argument from a public method contract in a raw SQL statement.
 *              This could lead to SQL injection if variables are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @id java/spring-sqli
 * @security-severity 8.8
 * @tags security
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Spring

class PublicStringParameter extends DataFlow::Expr {
  PublicStringParameter() {
    exists(Method m, Parameter p |
      m.isPublic() and
      p = m.getAParameter() and
      p.getType().getName() = "String"
    |
      this = p.getAnAccess()
    )
  }
}

class SpringSqlSink extends DataFlow::Expr {
  SpringSqlSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", 
          "PreparedStatementCreatorFactory") and
        ma.getMethod().isConstructor() and
        ma.getArgument(0) = this
      )
      or
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", 
          "JdbcTemplate") and
        ma.getArgument(0) = this
      )
      or
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", 
          "NamedParameterBatchUpdateUtils") and
        ma.getArgument(0) = this
      )
    )
  }
}

class StringSanitizer extends TaintTracking::Sanitizer {
  StringSanitizer() {
    exists(ConstructorCall cc |
      cc.getConstructedType().getName() = "String" and
      cc = this.getExpr()
    )
  }
}

class SpringSqlConfig extends TaintTracking::Configuration {
  SpringSqlConfig() { this = "Spring SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof PublicStringParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asExpr() instanceof SpringSqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SpringSqlConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential SQL injection from public string parameter to Spring SQL execution method",
  source.getNode(), sink.getNode(),
  "Untrusted input flows to SQL execution point without proper sanitization"
