Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 * if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class DynamicSqlSource extends DataFlow::Node {
  DynamicSqlSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "format" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma = this.asExpr()
    ) or
    exists(LocalVariableDecl lvd |
      lvd.getType().hasQualifiedName("java.lang", "String") and
      (
        exists(OperatorAssignment oa |
          oa.getOp() = "+" and
          oa.getVariable().getAnAccess() = this.asExpr() and
          oa.getVariable().getVariable() = lvd.getVariable()
        )
        or
        exists(MethodAccess ma |
          ma.getMethod().getName() = "format" and
          ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
          lvd.getVariable().getAnAccess() = this.asExpr()
        )
      )
    )
  }
}

class JdoSink extends DataFlow::Node {
  JdoSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName() matches "setFilter|setGrouping" and
        ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "Query")
      )
      or
      (
        ma.getMethod().getName() = "newQuery" and
        ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager")
      )
    ) and
    ma.getArgument(0) = this.asExpr()
  }
}

class JdoSqlInjectionConfig extends TaintTracking::Configuration {
  JdoSqlInjectionConfig() { this = "JdoSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof DynamicSqlSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof JdoSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sl = sanitizer.asExpr())
  }
}

from JdoSqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected a formatted string in a SQL statement. This could lead to SQL injection. Use prepared statements instead."
