 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.security.TaintTracking
import semmle.code.java.StringFormat

class JdoSqlSource extends DataFlow::Expr {
  JdoSqlSource() {
    // String.format() calls
    exists(Method m |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      this = m.getACall()
    )
    or
    // String SQL = ... patterns
    exists(Variable v |
      this = v.getAnAccess() and
      v.getType().hasName("String") and
      v.getName().matches("%SQL%")
    )
  }
}

class JdoSink extends DataFlow::Expr {
  JdoSink() {
    exists(Method m |
      (
        (m.hasName("setFilter") or m.hasName("setGrouping")) and
        m.getDeclaringType().hasQualifiedName("javax.jdo", "Query")
      )
      or
      (
        m.hasName("newQuery") and
        m.getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager")
      )
      and
      this = m.getACall().getArgument(0)
    )
  }
}

class JdoSanitizer extends DataFlow::Expr {
  JdoSanitizer() {
    this instanceof StringLiteral and
    this.getStringValue().regexpMatch("^\"[^\"]+\"\\s*\\+\\s*\"[^\"]+\"$")
  }
}

class JdoTaintConfig extends TaintTracking::Configuration {
  JdoTaintConfig() { this = "JDO SQL Injection" }

  override predicate isSource(DataFlow::Node source) { source.asExpr() instanceof JdoSqlSource }

  override predicate isSink(DataFlow::Node sink) { sink.asExpr() instanceof JdoSink }

  override predicate isSanitizer(DataFlow::Node node) { node.asExpr() instanceof JdoSanitizer }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Expr e |
      e = pred.asExpr() and
      e.isAdd() and
      succ.asExpr() = e
    )
  }
}

