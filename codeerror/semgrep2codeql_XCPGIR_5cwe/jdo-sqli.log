Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @severity Warning
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jdo.Jdo
import semmle.code.java.StringFormat

class JdoSqlInjectionConfig extends TaintTracking::Configuration {
  JdoSqlInjectionConfig() { this = "JdoSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      source.asExpr() = ma.getArgument(0)
    )
    or
    exists(Assignment a |
      a.getRValue().toString().regexpMatch(".*\\+.*") and
      source.asExpr() = a.getRValue()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(JDO::QuerySetFilterCall call | sink.asExpr() = call.getFilterArgument())
    or
    exists(JDO::QuerySetGroupingCall call | sink.asExpr() = call.getGroupingArgument())
    or
    exists(JDO::PersistenceManagerNewQueryCall call | sink.asExpr() = call.getQueryArgument())
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral and
    sanitizer.asExpr().toString().regexpMatch("\".*\"\\s*\\+\\s*\".*\"")
  }
}

