Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.JDO

class JdoSqlInjectionConfig extends TaintTracking::Configuration {
  JdoSqlInjectionConfig() { this = "JdoSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    // String.format() calls
    exists(Method m |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      exists(Call call | 
        call.getCallee() = m and
        source.asExpr() = call.getArgument(0)
      )
    )
    or
    // String concatenation patterns
    exists(BinaryExpr binExpr |
      binExpr.getOperator().toString() = "+" and
      source.asExpr() = binExpr
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // javax.jdo.Query.setFilter() or setGrouping()
    exists(Method m |
      (m.hasName("setFilter") or m.hasName("setGrouping")) and
      m.getDeclaringType().hasQualifiedName("javax.jdo", "Query") and
      exists(Call call |
        call.getCallee() = m and
        sink.asExpr() = call.getArgument(0)
      )
    )
    or
    // javax.jdo.PersistenceManager.newQuery()
    exists(Method m |
      m.hasName("newQuery") and
      m.getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager") and
      exists(Call call |
        call.getCallee() = m and
        sink.asExpr() = call.getArgument(1)
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Static SQL string concatenation like "..." + "..."
    exists(BinaryExpr concat |
      concat.getOperator().toString() = "+" and
      concat.getLeftOperand() instanceof StringLiteral and
      concat.getRightOperand() instanceof StringLiteral and
      sanitizer.asExpr() = concat
    )
  }
}

