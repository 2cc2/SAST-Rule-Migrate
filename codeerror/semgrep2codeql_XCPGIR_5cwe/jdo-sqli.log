Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @severity Warning
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class JdoSqlInjectionConfig extends TaintTracking::Configuration {
  JdoSqlInjectionConfig() { this = "JdoSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    // String.format() calls
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      source.asExpr() = ma.getArgument(0)
    )
    or
    // String concatenation pattern
    exists(AssignmentExpr assign |
      assign.getRightOperand().toString().regexpMatch(".*\\+.*") and
      source.asExpr() = assign.getRightOperand()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // javax.jdo.Query.setFilter() or setGrouping()
    exists(MethodAccess ma |
      (ma.getMethod().hasName("setFilter") or ma.getMethod().hasName("setGrouping")) and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "Query") and
      sink.asExpr() = ma.getArgument(0)
    )
    or
    // javax.jdo.PersistenceManager.newQuery()
    exists(MethodAccess ma |
      ma.getMethod().hasName("newQuery") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager") and
      sink.asExpr() = ma.getArgument(1)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Static SQL string concatenation like "..." + "..."
    sanitizer.asExpr().(StringLiteral).getValue().regexpMatch("\".*\"\\s*\\+\\s*\".*\"")
  }
}

from JdoSqlInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "User-controlled SQL string reaches JDO query execution"
