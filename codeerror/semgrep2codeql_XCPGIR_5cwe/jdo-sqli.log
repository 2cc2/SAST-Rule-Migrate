Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.StringFormat
import semmle.code.java.security.QueryInjection
import DataFlow::PathGraph

class JdoQueryConfig extends TaintTracking::Configuration {
  JdoQueryConfig() { this = "JDOQueryInjection" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      // String.format() call
      (ma.getMethod().hasName("format") and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) or
      // String concatenation pattern matching
      exists(Variable v | source.asExpr() = v.getAnAccess() and 
        v.getType().hasName("String") and v.getName().matches("SQL"))
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (ma.getMethod().hasName("setFilter") or ma.getMethod().hasName("setGrouping")) and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "Query") and
      sink.asExpr() = ma.getArgument(0)
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("newQuery") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager") and
      sink.asExpr() = ma.getArgument(1)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    // Constant string literals are considered safe
    exists(StringLiteral sl | node.asExpr() = sl and sl.getStringConstantValue().regexpMatch("^\"[^\"]+\"\\s*\\+\\s*\"[^\"]+\"$"))
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // Propagate taint through string concatenation and method calls
    any(Method m).propagatesTaint(pred, succ, _)
    or
    exists(StringConcatenationOperation sco | 
      sco.getAnOperand() = pred.asExpr() and sco = succ.asExpr()
    )
  }
}

from JdoQueryConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "User-provided SQL string reaches JDO query execution without proper sanitization"
