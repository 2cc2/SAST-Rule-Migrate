Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 * if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class DynamicSqlSource extends DataFlow::Node {
  DynamicSqlSource() {
    exists(Method m | 
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = m.getACall()
    ) or
    exists(Variable v |
      v.getType().hasQualifiedName("java.lang", "String") and
      (
        exists(BinaryExpr be |
          be.getOperator().toString() = "+" and
          this.asExpr() = be
        )
        or
        exists(MethodAccess ma |
          ma.getMethod().getName() = "format" and
          ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
          this.asExpr() = ma
        )
      )
    )
  }
}

class JdoSink extends DataFlow::Node {
  JdoSink() {
    exists(MethodAccess ma |
      (
        (ma.getMethod().getName() = "setFilter" or ma.getMethod().getName() = "setGrouping") and
        ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "Query") and
        this.asExpr() = ma.getArgument(0)
      )
      or
      (
        ma.getMethod().getName() = "newQuery" and
        ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager") and
        this.asExpr() = ma.getArgument(1)
      )
    )
  }
}

class JdoSqlInjectionConfig extends TaintTracking::Configuration {
  JdoSqlInjectionConfig() { this = "JdoSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof DynamicSqlSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof JdoSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal l | sanitizer.asExpr() = l)
  }
}

