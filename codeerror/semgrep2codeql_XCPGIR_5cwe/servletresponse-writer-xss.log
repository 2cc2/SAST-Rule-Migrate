Rule Content:
/**
 * @name ServletResponse writer XSS
 * @description Cross-site scripting detected in HttpServletResponse writer.
 *              User input was detected going directly from the HttpServletRequest into output.
 *              Ensure your data is properly encoded using org.owasp.encoder.Encode.forHtml.
 * @kind path-problem
 * @problem.severity error
 * @id java/servletresponse-writer-xss
 * @tags security
 *       external/cwe/cwe-079
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Servlets
import semmle.code.java.security.XSS
import DataFlow::PathGraph

class ServletResponseWriterXssConfig extends TaintTracking::Configuration {
  ServletResponseWriterXssConfig() { this = "ServletResponseWriterXssConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("javax.servlet.http.HttpServletRequest", "getParameter") and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma, MethodAccess writeCall |
      ma.getMethod().hasQualifiedName("javax.servlet.http.HttpServletResponse", "getWriter") and
      writeCall.getMethod().getName() = "write" and
      DataFlow::localExprFlow(ma, writeCall.getQualifier()) and
      sink.asExpr() = writeCall.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.owasp.encoder", "Encode", "forHtml") and
      sanitizer.asExpr() = ma
    )
  }
}

from ServletResponseWriterXssConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Cross-site scripting detected in HttpServletResponse writer with user input from $@.",
  source, source.toString()
