Rule Content:
/**
 * @name Use JSTL escaping
 * @description Detected an Expression Language segment in a tag that does not escape output.
 * @kind problem
 * @problem.severity warning
 * @id java/use-jstl-escaping
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.jsp.dataflow.JSPDataFlow

predicate isUnescapedELExpr(Expr e) {
  e instanceof Literal and
  e.getText().regexpMatch("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>")
}

predicate isJSTLOutTag(Expr e) {
  e instanceof Literal and
  e.getText().regexpMatch("<[A-Za-z0-9]+:out.*?>")
}

class UnescapedExpression extends DataFlow::Node {
  UnescapedExpression() {
    isUnescapedELExpr(this.asExpr())
  }
}

class JSTLOutTag extends DataFlow::Node {
  JSTLOutTag() {
    isJSTLOutTag(this.asExpr())
  }
}

from DataFlow::Node source, DataFlow::Node sink
where
  exists(DataFlow::PathNode p | p.asSource(source) and p.asSink(sink)) and
  source instanceof UnescapedExpression and
  exists(Method m | 
    m.getName() = "doTag" and 
    m.getDeclaringType().hasQualifiedName("javax.servlet.jsp.tagext", "SimpleTag") and
    sink.asExpr().getParent*(MethodAccess ma | ma.getMethod() = m)
  ) and
  not exists(JSTLOutTag sanitizer |
    sanitizer.getParent*() = source.getParent*()
  )
select source, "Unescaped Expression Language segment detected. Use JSTL 'out' tag to prevent XSS."
