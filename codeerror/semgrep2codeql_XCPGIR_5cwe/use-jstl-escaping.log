 * @description Detected an Expression Language segment in a tag that does not escape output.
 * @kind problem
 * @problem.severity warning
 * @id java/use-jstl-escaping
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.StringLiteral
import semmle.code.java.frameworks.JSP

predicate isUnescapedELExpr(StringLiteral lit) {
  lit.getValue().regexpMatch("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>")
}

predicate isJSTLOutTag(StringLiteral lit) {
  lit.getValue().regexpMatch("<[A-Za-z0-9]+:out.*?>")
}

from StringLiteral source, MethodAccess sink
where
  // Find unescaped EL expressions
  isUnescapedELExpr(source) and
  // Find JSP output sinks (SimpleTag.doTag() calls)
  sink.getMethod().getName() = "doTag" and
  sink.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp.tagext", "SimpleTag") and
  // Ensure there's no JSTL out tag between source and sink
  not exists(StringLiteral sanitizer |
    sanitizer.getParent+() = source.getParent+() and
    isJSTLOutTag(sanitizer)
  )
select source, "Unescaped Expression Language segment detected. Use JSTL 'out' tag to prevent XSS."
