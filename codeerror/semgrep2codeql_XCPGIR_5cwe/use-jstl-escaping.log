Rule Content:
/**
 * @name Use JSTL escaping
 * @description Detected an Expression Language segment in a tag that does not escape output.
 *              This is dangerous because if any data in this expression can be controlled externally,
 *              it is a cross-site scripting vulnerability. Instead, use the 'out' tag from the
 *              JSTL taglib to escape this expression.
 * @kind problem
 * @problem.severity warning
 * @precision high
 * @id java/jsp/use-jstl-escaping
 * @tags security
 *       xss
 */

import java
import semmle.code.java.StringFormat
import semmle.code.jsp.Jsp

predicate hasUnescapedExpression(Expr expr) {
  exists(string s |
    expr.toString() = s and
    regexpMatch(/<(?![A-Za-z0-9]+:out).*?\$\{.*?\}.*>/, s)
  )
}

predicate isUsingJstlOut(Expr expr) {
  exists(string s |
    expr.toString() = s and
    regexpMatch(/<[A-Za-z0-9]+:out.*>/, s)
  )
}

from Expr expr
where hasUnescapedExpression(expr)
and not exists(Expr parentExpr |
  parentExpr.getParent()* = expr and
  isUsingJstlOut(parentExpr)
)
select expr, "Detected an Expression Language segment in a tag that does not escape output."
