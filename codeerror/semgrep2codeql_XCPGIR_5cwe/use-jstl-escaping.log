/**
 * @name Use JSTL Escaping
 * @kind problem
 * @problem.severity warning
 * @precision high
 * @tags security
 *       external/cwe/cwe-079
 */
import java
import Xml

// Match unsafe JSP expressions with ${...} not using out tag
predicate unsafeJspExpression(XmlElementLiteral e) {
  exists(RegexMatching r |
    regexpMatch(r, ".*\\$\\{.*\\}.*", e.getValue().replaceAll("\\s", "")) and
    not regexpMatch(r, "<[A-Za-z0-9]+:out.*", e.getValue().replaceAll("\\s", "")) and
    not e.getValue().matches("<[A-Za-z0-9]+:out.*\\$\\{.*\\}.*")
  )
}

// Match safe expressions using JSTL out tag
predicate safeJstlOutTag(XmlElementLiteral e) {
  exists(RegexMatching r |
    regexpMatch(r, "<[A-Za-z0-9]+:out.*", e.getValue().replaceAll("\\s", "")) and
    regexpMatch(r, ".*\\$\\{.*\\}.*", e.getValue().replaceAll("\\s", ""))
  )
}

from XmlElementLiteral e
where 
  unsafeJspExpression(e) and
  not exists(safeJstlOutTag(e))
select e, "Unsafe JSP expression detected. Use JSTL out tag for proper escaping."
