rule:
  id: "use-jstl-escaping"
  kind: "pattern"
  severity: "WARNING"
  message: "Detected an Expression Language segment in a tag that does not escape output. This is dangerous because if any data in this expression can be controlled externally, it is a cross-site scripting vulnerability. Instead, use the 'out' tag from the JSTL taglib to escape this expression."
scope:
  languages: ["*"]  
  frameworks: ["jsp"]
  env: { os: ["*"], shell: ["*"] }
sources:
  - id: "EL_EXPRESSION"
    match:
      node: "LITERAL"
      where:
        - op: "regex"
          left: "value"
          right: "<(?![A-Za-z0-9]+:out).*?\$\{.*?\}.*>"
sinks:
  - id: "UNESCAPED_OUTPUT"
    match:
      node: "CALL"
      where:
        - op: "regex"
          left: "code"
          right: "<(?![A-Za-z0-9]+:out).*?\$\{.*?\}.*>"
sanitizers:
  - id: "JSTL_OUT_TAG"
    match:
      node: "LITERAL"
      where:
        - op: "regex"
          left: "value"
          right: "<[A-Za-z0-9]+:out.*>"
    effect: "neutralize"
flows:
  - source: "EL_EXPRESSION"
    sink: "UNESCAPED_OUTPUT"
    constraints:
      path:
        must_not: ["JSTL_OUT_TAG"]
report:
  message: "Detected an Expression Language segment in a tag that does not escape output."
  locations: ["sink"]
  evidence:
    capture: []
tests:
  positive:
    - "<c:set var=\"test\" value=\"${param.test}\"/>"
  negative:
    - "<c:out value=\"${param.test}\"/>"
