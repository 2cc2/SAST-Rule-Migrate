/**
 * @name Use JSTL escaping
 * @description Detected an Expression Language segment in a tag that does not escape output.
 * @kind problem
 * @problem.severity warning
 * @id java/use-jstl-escaping
 * @tags security
 *       xss
 */

import java
import jsp

// Define the pattern for unsafe Expression Language segments
predicate isUnsafeElTag(Element element) {
  exists(TextNode text |
    text.getValue().regexpMatches("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>") and
    text.getParentElement() = element
  )
}

from Element el
where
  isUnsafeElTag(el)
select el, "Detected an Expression Language segment in a tag that does not escape output. This is dangerous because if any data in this expression can be controlled externally, it is a cross-site scripting vulnerability. Instead, use the 'out' tag from the JSTL taglib to escape this expression."
