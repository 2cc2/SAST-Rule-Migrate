/**
 * @name Use JSTL escaping
 * @description Detected an Expression Language segment in a tag that does not escape output.
 * @kind problem
 * @problem.severity warning
 * @id java/use-jstl-escaping
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.jsp.JSP

predicate isUnescapedELExpr(Literal l) {
  l.getText().regexpMatch("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>")
}

predicate isJSTLOutTag(Literal l) {
  l.getText().regexpMatch("<[A-Za-z0-9]+:out.*?>")
}

from SimpleTag st, Literal unescapedEL
where
  // Find SimpleTag implementations
  st.getMethod().getName() = "doTag" and
  // Find literal containing unescaped EL expression
  exists(unescapedEL.getParent*() | unescapedEL = st.getAMethodBody().getExpr().getAChild*().(Literal)) and
  isUnescapedELExpr(unescapedEL) and
  // Check there's no JSTL out tag in the flow
  not exists(Literal outTag |
    outTag.getParent*() = unescapedEL.getParent*() and
    isJSTLOutTag(outTag)
  )
select unescapedEL, "Unescaped Expression Language segment detected. Use JSTL 'out' tag to prevent XSS."
