Rule Content:
/**
 * @name Use JSTL escaping
 * @description Detected an Expression Language segment in a tag that does not escape output.
 *              This is dangerous because if any data in this expression can be controlled externally,
 *              it is a cross-site scripting vulnerability. Instead, use the 'out' tag from the
 *              JSTL taglib to escape this expression.
 * @kind problem
 * @problem.severity warning
 * @precision high
 * @id java/jsp/use-jstl-escaping
 * @tags security
 *       xss
 */

import java
import java.regex.Matcher
import java.regex.Pattern
import java.xml.parsers.DocumentBuilderFactory
import javax.xml.xpath.XPathFactory
import DataFlow::PathGraph

class JstlTag extends XmlElement {
  JstlTag() {
    this.getName().matches("([a-zA-Z0-9]+:out).*")
  }
}

class UnescapedElExpr extends Expr {
  UnescapedElExpr() {
    this.toString().matches("<(?![a-zA-Z0-9]+:out).*?\\$\\{.*?\\}.*>") and
    not exists(JstlTag outTag |
      outTag.getParent() = this and
      outTag.toString().matches("<[a-zA-Z0-9]+:out.*>")
    )
  }
}

from UnescapedElExpr expr
select expr, "Detected an Expression Language segment in a tag that does not escape output."
