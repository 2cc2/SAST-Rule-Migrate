Rule Content:
/**
 * @name Use JSTL escaping
 * @description Detected an Expression Language segment in a tag that does not escape output.
 * @kind path-problem
 * @problem.severity warning
 * @id java/use-jstl-escaping
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import DataFlow::PathGraph

predicate isUnescapedELExpr(Expr e) {
  e instanceof Literal and
  e.getText().regexpMatch("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>")
}

predicate isJSTLOutTag(Expr e) {
  e instanceof Literal and
  e.getText().regexpMatch("<[A-Za-z0-9]+:out.*?>")
}

class UnescapedExpression extends DataFlow::Node {
  UnescapedExpression() { isUnescapedELExpr(this.asExpr()) }
}

class JSTLOutTag extends DataFlow::Node {
  JSTLOutTag() { isJSTLOutTag(this.asExpr()) }
}

class XssSink extends DataFlow::Node {
  XssSink() {
    exists(Method m |
      m.getName() = "doTag" and
      m.getDeclaringType().hasQualifiedName("javax.servlet.jsp.tagext", "SimpleTag") and
      this.asExpr() = m.getACall().getAnArgument()
    )
  }
}

predicate taintFlow(DataFlow::PathNode source, DataFlow::PathNode sink) {
  exists(DataFlow::PathNode p | 
    source.getNode() instanceof UnescapedExpression and
    sink.getNode() instanceof XssSink and
    p.hasFlowPath(source, sink)
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where 
  taintFlow(source, sink) and
  not exists(DataFlow::PathNode sanitizer |
    sanitizer.getNode() instanceof JSTLOutTag and
    exists(DataFlow::PathNode p | p.hasFlowPath(source, sanitizer))
  )
select sink, source, sink,
  "Unescaped Expression Language segment detected. Use JSTL 'out' tag to prevent XSS."
