/**
 * @name Tainted SQL from HTTP request
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sql-from-http-request
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import semmle.code.java.frameworks.Spring

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(Method m, Call call |
      m.getDeclaringType().getASupertype*()
        .hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      m.getName().matches("getInputStream|getParameter|getParameterMap|getParameterValues|" +
        "getReader|getCookies|getHeader|getHeaderNames|getHeaders|getPart|getParts|getQueryString") and
      call.getCallee() = m and
      this.asExpr() = call
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(Call call |
      (
        call.getCallee().getDeclaringType().hasQualifiedName("java.sql", "Statement") or
        (call.getCallee().getDeclaringType().hasQualifiedName("javax.sql", "DataSource") and
         call.getCallee().getName().matches("query|execute|executeUpdate|batchUpdate")) or
        (call.getCallee().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
         call.getCallee().getName() = "batchUpdate") or
        (
          call.getCallee().getName().matches("execute|query|executeUpdate|batchUpdate") and
          call.getArgument(0).toString().matches("(?i)(^SELECT.*|^INSERT.*|^UPDATE.*)")
        )
      ) and
      this.asExpr() = call
    )
  }
}

class TaintedSQLFromHTTPRequestConfig extends TaintTracking::Configuration {
  TaintedSQLFromHTTPRequestConfig() { this = "TaintedSQLFromHTTPRequestConfig" }
  
  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }
  
  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }
}

