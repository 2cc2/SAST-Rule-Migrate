Rule Content:
/**
 * @name Tainted SQL from HTTP request
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement.
 *              This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sql-from-http-request
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import semmle.code.java.frameworks.Spring

class ServletRequestSource extends RemoteFlowSource::Range, DataFlow::Node {
  ServletRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getInputStream") or
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getParameter") or
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getParameterMap") or
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getParameterValues") or
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getReader") or
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getCookies") or
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getHeader") or
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getHeaderNames") or
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getHeaders") or
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getPart") or
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getParts") or
      ma.getMethod().hasQualifiedName("javax.servlet", "ServletRequest", "getQueryString") |
      this.asNode() = ma
    )
  }
}

class SQLSink extends DataFlow::Node {
  SQLSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().hasQualifiedName("java.sql", "Statement", "execute") or
        ma.getMethod().hasQualifiedName("java.sql", "Statement", "query") or
        ma.getMethod().hasQualifiedName("java.sql", "Statement", "executeUpdate") or
        ma.getMethod().hasQualifiedName("java.sql", "Statement", "batchUpdate") |
        this.asNode() = ma.getArgument(0)
      )
      or
      (
        ma.getMethod().hasQualifiedName("java.sql", "Connection", "prepareStatement") |
        this.asNode() = ma.getAnArgument()
      )
      or
      (
        ma.getMethod().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate", "queryForObject") or
        ma.getMethod().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate", "queryForMap") or
        ma.getMethod().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate", "batchUpdate") |
        this.asNode() = ma.getAnArgument()
      )
    )
  }
}

class TaintedSQLFromHttpRequestConfiguration extends TaintTracking::Configuration {
  TaintedSQLFromHttpRequestConfiguration() { this = "TaintedSQLFromHttpRequest" }

  override predicate isSource(DataFlow::Node source) { any(ServletRequestSource s).flowsTo(source) }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SQLSink }
}

