Rule Content:
/**
 * @name Tainted SQL from HTTP request
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement.
 *              This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sql-from-http-request
 * @tags security
 *       external/cwe/cwe-089
 *       external/java-servlets
 *       external/java-spring
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

predicate isHttpRequestSource(DataFlow::Node source) {
  exists(Method m, Call call |
    (m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") or
     m.getDeclaringType().hasQualifiedName("javax.servlet", "ServletRequest")) and
    (m.hasName("getParameter") or 
     m.hasName("getParameterMap") or 
     m.hasName("getParameterValues") or 
     m.hasName("getCookies") or 
     m.hasName("getHeader") or 
     m.hasName("getHeaders") or 
     m.hasName("getQueryString")) and
    call.getCallee() = m and
    source.asExpr() = call
  )
}

predicate isSqlSink(DataFlow::Node sink) {
  exists(Call call |
    (call.getCallee().getDeclaringType().hasQualifiedName("java.sql", "Statement") or
     call.getCallee().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
     call.getCallee().getDeclaringType().hasQualifiedName("java.sql", "CallableStatement")) and
    (call.getCallee().hasName("execute") or
     call.getCallee().hasName("executeQuery") or
     call.getCallee().hasName("executeUpdate") or
     call.getCallee().hasName("batchUpdate")) and
    sink.asExpr() = call
  ) or
  exists(Call call |
    call.getCallee().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
    (call.getCallee().hasName("queryForObject") or
     call.getCallee().hasName("queryForMap") or
     call.getCallee().hasName("batchUpdate")) and
    sink.asExpr() = call
  ) or
  exists(AssignExpr assign |
    assign.getRight().toString().matches(".*prepareStatement.*") and
    sink.asExpr() = assign.getRight()
  )
}

class TaintedSqlFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedSqlFromHttpRequestConfig() { this = "TaintedSqlFromHttpRequestConfig" }
  
  override predicate isSource(DataFlow::Node source) { isHttpRequestSource(source) }
  
  override predicate isSink(DataFlow::Node sink) { isSqlSink(sink) }
}

from TaintedSqlFromHttpRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "User input from HTTP request reaches SQL execution without sanitization"
