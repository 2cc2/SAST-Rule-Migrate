Rule Content:
/**
 * @name Tainted SQl from HTTP request
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement. 
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sql-from-http-request
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import semmle.code.java.frameworks.Spring
import semmle.code.java.SqlQueries

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(MethodAccess ma | 
      ma.getMethod().getDeclaringType() instanceof HttpServletRequestType and
      ma.getMethod().getName().matches("getInputStream|getParameter|getParameterMap|getParameterValues|getReader|getCookies|getHeader|getHeaderNames|getHeaders|getPart|getParts|getQueryString") and
      this.asExpr() = ma
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getDeclaringType() instanceof StatementType or
        (ma.getMethod().getDeclaringType() instanceof DataSourceType and
         ma.getMethod().getName().matches("query|execute|executeUpdate|batchUpdate")) or
        (ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
         ma.getMethod().getName() = "batchUpdate") or
        (
          ma.getMethod().getName().matches("execute|query|executeUpdate|batchUpdate") and
          ma.getArgument(0).toString().matches("(?i)(^SELECT.*|^INSERT.*|^UPDATE.*)")
        )
      ) and
      this.asExpr() = ma
    )
  }
}

class TaintedSQLFromHTTPRequestConfig extends TaintTracking::Configuration {
  TaintedSQLFromHTTPRequestConfig() { this = "TaintedSQLFromHTTPRequestConfig" }
  
  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }
  
  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from TaintedSQLFromHTTPRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input from HTTP request reaches SQL execution without sanitization",
  source, sink,
  "$@ flows to $@ without sanitization", source, sink
