        ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") or
        (ma.getMethod().getDeclaringType().hasQualifiedName("javax.sql", "DataSource") and
         ma.getMethod().getName().matches("query|execute|executeUpdate|batchUpdate")) or
        (ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
         ma.getMethod().getName() = "batchUpdate") or
        (
          ma.getMethod().getName().matches("execute|query|executeUpdate|batchUpdate") and
          ma.getArgument(0).toString().matches("(?i)(^SELECT.*|^INSERT.*|^UPDATE.*)")
        )
      ) and
      this.asExpr() = ma
    )
  }
}

