Rule Content:
/**
 * @name JDBC SQL Injection via String Concatenation
 * @description Detects potential JDBC injection when concatenating or formatting strings
 *              that flow into JdbcTemplate query methods
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class StringConcatSource extends DataFlow::CallNode {
  StringConcatSource() {
    exists(Method m | 
      m.hasName("concat", "format", "valueOf") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.getTarget() = m      
    )
  }
}

class StringBuilderAppendSource extends DataFlow::Expr {
  StringBuilderAppendSource() {
    exists(Method m |
      m.hasName("append") and
      m.getDeclaringType().hasQualifiedName("java.lang", "StringBuilder") and
      this = m.getACall().getArgument(0)
    )
  }
}

class JdbcTemplateSink extends DataFlow::CallNode {
  JdbcTemplateSink() {
    exists(Method m |
      m.hasName("queryForObject", "queryForList", "update", "execute", "insert") and
      m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      this.getTarget() = m
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "JDBC SQL Injection via String Concatenation" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringConcatSource or
    source instanceof StringBuilderAppendSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JdbcTemplateSink 
  }

  override predicate isAdditionalTaintStep(DataFlow::Node src, DataFlow::Node dest) {
    // Handle string concatenation and assignment propagation
    exists(MethodAccess ma | 
      (ma.getMethod().hasName("concat", "format", "valueOf") or
       ma.getMethod().getName() = "append" and ma.getQualifier().getType().hasQualifiedName("java.lang", "StringBuilder")
      ) and
      src.asExpr() = ma.getAnArgument() and
      dest.asExpr() = ma
    )
    or
    exists(Assignment assign | 
      // Simple assignment propagation
      dest.asExpr() = assign.getDest() and
      src.asExpr() = assign.getSource()
    )
  }
}

from TaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Possible JDBC injection detected. Use the parameterized query feature available in queryForObject instead of concatenating or formatting strings",
  source, sink,
  "User input flows into JDBC query via string concatenation"
