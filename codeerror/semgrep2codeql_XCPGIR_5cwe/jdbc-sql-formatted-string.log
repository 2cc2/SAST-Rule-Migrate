Rule Content:
/**
 * @name JDBC SQL Formatted String Injection
 * @description Possible JDBC injection detected. Use the parameterized query feature available 
 *              in queryForObject instead of concatenating or formatting strings
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Spring.SpringJdbc

class UserInput extends TaintTracking::Source {
  UserInput() {
    exists(Parameter p | this.asParameter() = p | not p.getType().hasQSName("java.lang", "String"))
    or
    exists(Field f | this.asField() = f | not f.getType().hasQSName("java.lang", "String"))
    or
    exists(LocalVariableDecl lvd | this.asLocalVariable() = lvd.getVariable() | 
      not lvd.getVariable().getType().hasQSName("java.lang", "String"))
  }
}

class JdbcSink extends DataFlow::Node {
  JdbcSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      ma.getMethod().getName() in [
        "queryForObject", "queryForList", "update", "execute", "insert"
      ] and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class StringFormatSanitizer extends TaintTracking::Sanitizer {
  StringFormatSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.lang", "String", "format") and
      this.asExpr() = ma
    )
  }
}

class ParameterizedQuerySanitizer extends TaintTracking::Sanitizer {
  ParameterizedQuerySanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      ma.getMethod().getName() in [
        "queryForObject", "queryForList", "update", "execute", "insert"
      ] and
      exists(NewExpr ne |
        ne.getType().hasQualifiedName("java.sql", "PreparedStatement") and
        ne.getAnArgument() = ma.getArgument(0)
      )
    )
  }
}

module TaintFlowConfig implements TaintTracking::Config {
  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }
  override predicate isSink(DataFlow::Node sink) { sink instanceof JdbcSink }
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StringFormatSanitizer or sanitizer instanceof ParameterizedQuerySanitizer
  }
}

