/**
 * @name JDBC SQL Injection via String Concatenation
 * @description Detects potential JDBC injection when concatenating or formatting strings
 *              that flow into JdbcTemplate query methods
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(Method m |
      this.asExpr().(Call).getCallee() = m and
      m.hasName("concat", "format", "valueOf") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String")
    )
  }
}

class StringBuilderAppendSource extends DataFlow::Node {
  StringBuilderAppendSource() {
    exists(Call c |
      this.asExpr() = c.getArgument(0) and
      c.getCallee().hasName("append") and
      c.getQualifier().getType().hasQualifiedName("java.lang", "StringBuilder")
    )
  }
}

class JdbcTemplateSink extends DataFlow::Node {
  JdbcTemplateSink() {
    exists(Call c |
      this.asExpr() = c.getArgument(0) and
      c.getCallee().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      c.getCallee().hasName("queryForObject", "queryForList", "update", "execute", "insert")
    )
  }
}

class JdbcTaintConfig extends TaintTracking::Configuration {
  JdbcTaintConfig() { this = "JDBC SQL Injection via String Concatenation" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringConcatSource or
    source instanceof StringBuilderAppendSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JdbcTemplateSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node src, DataFlow::Node dest) {
    exists(Call c |
      (c.getCallee().hasName("concat", "format", "valueOf") or
       (c.getCallee().hasName("append") and 
        c.getQualifier().getType().hasQualifiedName("java.lang", "StringBuilder"))
      ) and
      src.asExpr() = c.getAnArgument() and
      dest.asExpr() = c
    )
    or
    exists(Expr assign |
      dest.asExpr() = assign.getAChild*() and
      src.asExpr() = assign.getAChild*()
    )
  }
}

