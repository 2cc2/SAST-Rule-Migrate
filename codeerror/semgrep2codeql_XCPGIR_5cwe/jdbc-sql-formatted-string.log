/**
 * @name JDBC SQL Injection via String Concatenation
 * @description Detects potential JDBC injection when concatenating or formatting strings
 *              that flow into JdbcTemplate query methods
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["concat", "format", "valueOf"]) and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma
    )
  }
}

class StringBuilderAppendSource extends DataFlow::Node {
  StringBuilderAppendSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("append") and
      ma.getQualifier().getType().hasQualifiedName("java.lang", "StringBuilder") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class JdbcTemplateSink extends DataFlow::Node {
  JdbcTemplateSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["queryForObject", "queryForList", "update", "execute", "insert"]) and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "JDBC SQL Injection via String Concatenation" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringConcatSource or
    source instanceof StringBuilderAppendSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JdbcTemplateSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node src, DataFlow::Node dest) {
    exists(MethodAccess ma |
      (ma.getMethod().hasName(["concat", "format", "valueOf"]) or
       ma.getMethod().hasName("append") and 
       ma.getQualifier().getType().hasQualifiedName("java.lang", "StringBuilder")
      ) and
      src.asExpr() = ma.getAnArgument() and
      dest.asExpr() = ma
    )
    or
    exists(AssignExpr assign |
      dest.asExpr() = assign.getDest() and
      src.asExpr() = assign.getSource()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig config
where config.hasFlowPath(source, sink)
select sink, 
  "Possible JDBC injection detected. Use the parameterized query feature available in queryForObject instead of concatenating or formatting strings",
  source, sink,
  "User input flows into JDBC query via string concatenation"
