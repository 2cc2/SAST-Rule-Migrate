/**
 * @name JDBC SQL Formatted String Injection
 * @description Detects possible JDBC injection when using string formatting/concatentation
 *              instead of parameterized queries with JdbcTemplate methods.
 * @kind problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */
 
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.JdbcTemplate

class StringFormatMethod extends Method {
  StringFormatMethod() {
    this.getDeclaringType().hasQualifiedName("java.lang", "String") and
    this.hasName("format")
  }
}

class StringConcatOperation extends BinaryOperation {
  StringConcatOperation() {
    this.getOperator() = "+" and
    this.getLeftOperand().getType() instanceof TypeString and
    this.getRightOperand().getType() instanceof TypeString
  }
}

class JdbcTaintConfig extends TaintTracking::Configuration {
  JdbcTaintConfig() { this = "JdbcTaintConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, StringFormatMethod fm |
      ma.getMethod() = fm and
      source.asExpr() = ma
    )
    or
    exists(StringConcatOperation sco |
      source.asExpr() = sco
    )
  }
  
  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      isJdbcTemplateMethod(ma.getMethod()) and
      sink.asExpr() = ma.getArgument(0)
    )
  }
  
  private predicate isJdbcTemplateMethod(Method m) {
    m.hasName(["queryForObject", "update", "execute", "insert"]) and
    m.getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
  }
}

