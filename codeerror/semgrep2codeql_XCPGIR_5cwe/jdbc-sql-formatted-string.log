/**
 * @name JDBC SQL Formatted String Injection
 * @description Detects possible JDBC injection when using string formatting/concatenation
 *              instead of parameterized queries with JdbcTemplate methods.
 * @kind path-problem
 * @problem.severity warning
 * @id jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.security.SqlInjection
import DataFlow::PathGraph

class StringFormatCall extends Call {
  StringFormatCall() {
    this.getCallee().hasName("format") and
    this.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String")
  }
}

class StringAddition extends AddExpr {
  StringAddition() {
    this.getLeftOperand().getType() instanceof TypeString and
    this.getRightOperand().getType() instanceof TypeString
  }
}

class JdbcQuerySink extends Call {
  JdbcQuerySink() {
    this.getCallee().hasName(["queryForObject", "update", "execute", "insert"]) and
    this.getCallee().getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
  }
}

module TaintConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    exists(StringFormatCall fc | source.asExpr() = fc) or
    exists(StringAddition sa | source.asExpr() = sa)
  }

  predicate isSink(DataFlow::Node sink) {
    exists(JdbcQuerySink qs | sink.asExpr() = qs.getArgument(0))
  }
}

