/**
 * @name JDBC SQL Formatted String Injection
 * @description Possible JDBC injection detected. Use the parameterized query feature available
 *              in queryForObject instead of concatenating or formatting strings.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.spring.JdbcTemplate

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(Parameter p | this.asParameter() = p | not p.getType().hasName("String"))
    or
    exists(Field f | this.asField() = f | not f.getType().hasName("String"))
    or
    exists(LocalVariable v | this.asLocalVariable() = v | not v.getType().hasName("String"))
  }
}

class JdbcSink extends DataFlow::Node {
  JdbcSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType() instanceof JdbcTemplate and
      ma.getMethod().getName() in ["queryForObject", "queryForList", "update", "execute", "insert"] and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class StringFormatSanitizer extends DataFlow::BarrierGuard {
  StringFormatSanitizer() {
    exists(DataFlow::Node node | 
      exists(StringFormatCall sfc | node.asExpr() = sfc) and
      this = node
    )
  }
}

class ParameterizedQuerySanitizer extends DataFlow::BarrierGuard {
  ParameterizedQuerySanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType() instanceof JdbcTemplate and
      ma.getMethod().getName() in ["queryForObject", "queryForList", "update", "execute", "insert"] and
      exists(NewObject no |
        no.getType().hasName("PreparedStatement") and
        no.getAnArgument() = ma.getArgument(0)
      ) and
      this.asExpr() = ma
    )
  }
}

class JdbcConfig extends DataFlow::Configuration {
  JdbcConfig() { this = "JdbcConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof JdbcSink }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof StringFormatSanitizer or barrier instanceof ParameterizedQuerySanitizer
  }
}

