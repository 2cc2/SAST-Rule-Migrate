Rule Content:
/**
 * @name JDBC SQL Formatted String Injection
 * @description Possible JDBC injection detected. Use the parameterized query feature available 
 *              in queryForObject instead of concatenating or formatting strings.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Spring.SpringJdbc
import DataFlow::PathGraph

predicate isStringConcat(Expr expr) {
  exists(MethodAccess ma | 
    ma.getMethod().getName() = "concat" and
    ma.getMethod().getDeclaringType() instanceof TypeString and
    expr = ma
  )
  or
  exists(BinaryExpr be | 
    be.getOp() = "+" and
    expr = be
  )
}

class StringFormatCall extends MethodAccess {
  StringFormatCall() {
    this.getMethod().getName() = "format" and
    this.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")
  }
}

class JdbcSink extends MethodAccess {
  JdbcSink() {
    this.getMethod().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate", 
      ["queryForObject", "queryForList", "update", "execute", "insert"]) and
    not exists(JdbcSink safeCall | safeCall = this |
      exists(ParameterizedQuerySanitizer pq | pq.isParameterizedQueryCall(this))
    )
  }
}

class ParameterizedQuerySanitizer extends MethodAccess {
  ParameterizedQuerySanitizer() {
    this.getMethod().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate", 
      ["queryForObject", "queryForList", "update", "execute", "insert"]) and
    this.isParameterizedQueryCall()
  }
  
  predicate isParameterizedQueryCall(MethodAccess ma) {
    exists(ObjectCreation oc | 
      oc.getType().getName() = "PreparedStatement" and
      ma.getArgument(0).getType().getName() = "String" and
      oc.getAnArgument() = ma.getArgument(0)
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p | this.asParameter() = p and not p.getType().hasName("String"))
    or
    exists(Field f | this.asField() = f and not f.getType().hasName("String"))
    or
    exists(LocalVariable v | this.asLocalVariable() = v and not v.getType().hasName("String"))
  }
}

predicate taintPath(DataFlow::Node source, DataFlow::Node sink) {
  exists(DataFlow::PathNode path |
    path.getSource() = source and
    path.getSink() = sink and
    not exists(StringFormatCall sfc | sfc = path.getNode())
  )
}

predicate isJDBCInjection(DataFlow::PathNode path) {
  exists(JdbcSink sink, UserInputSource source |
    sink.asExpr() = path.getSink().asExpr() and
    source.asExpr() = path.getSource().asExpr() and
    taintPath(source, path.getSink())
  )
}

from DataFlow::PathNode path
where isJDBCInjection(path)
select path, "Possible JDBC injection detected. Use the parameterized query feature instead of concatenating or formatting strings."
