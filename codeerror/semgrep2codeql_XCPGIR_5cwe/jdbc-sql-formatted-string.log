sources:
  - id: USER_INPUT
    match:
      node: PARAM | FIELD | LOCAL
      where:
        - op: neq
          left: type.name
          right: "java.lang.String"

sinks:
  - id: JDBC_EXEC
    match:
      node: CALL
      api: 
        type: org.springframework.jdbc.core.JdbcTemplate
        method: 
          - queryForObject
          - queryForList
          - update
          - execute
          - insert
      
propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint
  
sanitizers:
  - id: PARAMETERIZED_QUERY
    match: 
      node: CALL
      api: 
        type: org.springframework.jdbc.core.JdbcTemplate
        method: 
