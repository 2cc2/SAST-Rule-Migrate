Rule Content:
/**
 * @name JDBC SQL Formatted String Injection
 * @description Possible JDBC injection detected. Use the parameterized query feature available
 *              in queryForObject instead of concatenating or formatting strings.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.spring.SpringJdbc

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(Parameter p | 
      this.asParameter() = p and 
      not p.getType().hasName("String")
    )
    or
    exists(Field f | 
      this.asField() = f and 
      not f.getType().hasName("String")
    )
    or
    exists(LocalVariable v | 
      this.asLocalVariable() = v and 
      not v.getType().hasName("String")
    )
  }
}

class JdbcSink extends DataFlow::Node {
  JdbcSink() {
    exists(Method m | 
      m.getDeclaringType() instanceof SpringJdbc::JdbcTemplate and
      m.hasName(["queryForObject", "queryForList", "update", "execute", "insert"]) and
      this.asExpr() = m.getACall().getArgument(0)
    )
  }
}

class StringFormatSanitizer extends DataFlow::BarrierGuard {
  StringFormatSanitizer() {
    exists(Method m | 
      m.hasQualifiedName("java.lang", "String", "format") and
      this.asExpr() = m.getACall()
    )
  }
}

class ParameterizedQuerySanitizer extends DataFlow::BarrierGuard {
  ParameterizedQuerySanitizer() {
    exists(Method m | 
      m.getDeclaringType() instanceof SpringJdbc::JdbcTemplate and
      m.hasName(["queryForObject", "queryForList", "update", "execute", "insert"]) and
      exists(Constructor c |
        c.getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
        c.getACall().getAnArgument() = m.getACall().getArgument(0)
      ) and
      this.asExpr() = m.getACall()
    )
  }
}

class JdbcInjectionConfig extends DataFlow::Configuration {
  JdbcInjectionConfig() { this = "JdbcInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof JdbcSink }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof StringFormatSanitizer or
    barrier instanceof ParameterizedQuerySanitizer
  }
}

from JdbcInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
