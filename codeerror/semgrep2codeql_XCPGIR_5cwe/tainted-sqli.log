Rule Content:
/**
 * @name Tainted SQL Injection in AWS Lambda
 * @description Detects SQL statements that are tainted by user input from Lambda events,
 *              which could lead to SQL injection if variables are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sqli-lambda
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Parameter p |
      (
        p.getType().hasName("InputStream") and
        p.getType().getQualifiedName() = "java.io.InputStream"
        or
        p.getName().matches("%EVENT%")
        or
        p.getType().getName() = "TYPE"
      ) and
      this.asParameter() = p
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(Method m, MethodAccess ma |
      (
        m.hasName("execute") and
        m.getDeclaringType().hasQualifiedName("java.sql", "Statement")
        or
        m.hasName("executeQuery") and
        m.getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement")
        or
        m.hasName("queryForObject") and
        m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
      ) and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(
        m.hasName("queryForObject") ? 1 : 0 |
        m.hasName("execute") ? 0 : 0 |
        m.hasName("executeQuery") ? 0 : _
      )
    )
  }
}

class TaintedSqlQueryConfig extends TaintTracking::Configuration {
  TaintedSqlQueryConfig() { this = "Tainted Sql Query Config" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Method m, MethodAccess ma |
      m.hasName("setString") and
      m.getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      ma.getMethod() = m and
      sanitizer.asExpr() = ma
    )
  }
}

