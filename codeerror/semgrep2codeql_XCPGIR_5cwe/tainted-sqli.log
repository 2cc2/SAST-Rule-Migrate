Rule Content:
/**
 * @name Tainted SQL Injection in AWS Lambda
 * @description Detects SQL statements that are tainted by user input from Lambda events,
 *              which could lead to SQL injection if variables are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sqli-lambda
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

predicate isLambdaEventSource(DataFlow::Node source) {
  exists(Parameter p |
    (p.getType().(RefType).getQualifiedName() = "java.io.InputStream" or
     p.getType().(RefType).getQualifiedName().regexpMatch(".*EVENT.*")) and
    source.asParameter() = p
  )
}

predicate isSqlExecutionSink(DataFlow::Node sink) {
  exists(Method m, MethodAccess ma |
    (
      (m.hasName("execute") and m.getDeclaringType().hasQualifiedName("java.sql", "Statement")) or
      (m.hasName("executeQuery") and m.getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement")) or
      (m.hasName("queryForObject") and m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate"))
    ) and
    ma.getMethod() = m and
    sink.asExpr() = ma.getArgument(if m.hasName("queryForObject") then 1 else 0)
  )
}

class TaintedSqlQueryConfig extends TaintTracking::Configuration {
  TaintedSqlQueryConfig() { this = "TaintedSqlQueryConfig" }

  override predicate isSource(DataFlow::Node source) {
    isLambdaEventSource(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    isSqlExecutionSink(sink)
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Method m, MethodAccess ma |
      m.hasName("setString") and
      m.getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      ma.getMethod() = m and
      sanitizer.asExpr() = ma
    )
  }
}

