Rule Content:
/**
 * @name Tainted SQL Injection in AWS Lambda
 * @description Detects SQL statements that are tainted by user input from Lambda events,
 *              which could lead to SQL injection if variables are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sqli-lambda
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringJdbc

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(MethodParameter p |
      p.getType().(RefType).getQualifiedName() in ["java.io.InputStream", "TYPE"] and
      p.getName().matches("%EVENT%") and
      this.asParameter() = p
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName() = "execute" and
        ma.getMethod().getDeclaringType().getQualifiedName() = "java.sql.Statement"
        or
        ma.getMethod().getName() = "executeQuery" and
        ma.getMethod().getDeclaringType().getQualifiedName() = "java.sql.PreparedStatement"
        or
        ma.getMethod().getName() = "queryForObject" and
        ma.getMethod().getDeclaringType().getQualifiedName() = "org.springframework.jdbc.core.JdbcTemplate"
      ) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class TaintedSqlQueryConfiguration extends TaintTracking::Configuration {
  TaintedSqlQueryConfiguration() { this = "TaintedSqlQueryConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaEventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecutionSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "setString" and
      ma.getMethod().getDeclaringType().getQualifiedNameMatches("java.sql.PreparedStatement") and
      sanitizer.asExpr() = ma
    )
  }
}

