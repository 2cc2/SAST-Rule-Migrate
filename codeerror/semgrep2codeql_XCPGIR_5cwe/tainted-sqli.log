Rule Content:
/**
 * @name Tainted SQL Injection in AWS Lambda
 * @description Detected SQL statement that is tainted by user input. This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sqli
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.AWSLambda

class LambdaInput extends DataFlow::Node {
  LambdaInput() {
    exists(Method m, Parameter p |
      (m.hasName("handleRequest") and
       (m.getParameter(0) = p or m.getParameter(1) = p) and
       p.getType().toString().matches("%InputStream%|%Event%"))
      or
      (p.getCallable().getDeclaringType().getASupertype*().hasQualifiedName("com.amazonaws.services.lambda.runtime", 
                                                                          "RequestHandler") and
       m.getParameter(0) = p)
      |
      this.asParameter() = p
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      (ma.getMethod().hasName("execute") and
       ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Statement")) or
      (ma.getMethod().hasName("executeQuery") and
       ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Statement")) or
      (ma.getMethod().getName().matches("queryFor%") and
       ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate"))
      |
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "PreparedStatement") and
      ma.getMethod().getName().matches("set%") and
      this.asExpr() = ma
    )
  }
}

class TaintedSqlQueryConfiguration extends TaintTracking::Configuration {
  TaintedSqlQueryConfiguration() { this = "TaintedSqlQueryConfiguration" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaInput
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

