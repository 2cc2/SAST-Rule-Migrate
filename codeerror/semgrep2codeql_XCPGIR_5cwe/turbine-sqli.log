/**
 * @id turbine-sqli
 * @name Turbine SQL Injection Vulnerability
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.0
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "format" and
      mc.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = mc.getArgument(0)
    )
  }
}

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(AddExpr add |
      add.getOperandType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = add.getLeftOperand()
    )
  }
}

class VariableAssignmentSource extends DataFlow::Node {
  VariableAssignmentSource() {
    exists(AssignStmt assign, AddExpr add |
      add.getOperandType().hasQualifiedName("java.lang", "String") and
      assign.getRValue() = add and
      this.asExpr() = assign.getLValue()
    )
    or
