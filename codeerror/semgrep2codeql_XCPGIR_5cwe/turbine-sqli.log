/**
 * @name Turbine SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/turbine-sqli
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormatExtensions

class TurbineSqlConfig extends TaintTracking::Configuration {
  TurbineSqlConfig() { this = "TurbineSqlConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Source 1: String.format() with SQL pattern
    exists(Method m, MethodAccess ma |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getMethod() = m and
      source.asExpr() = ma.getArgument(0)
    )
    or
    // Source 2: SQL string concatenation
    exists(LocalVariableDecl lvd, BinaryExpr bin, Expr rhs |
      lvd.getType().hasName("String") and
      exists(lvd.getAnAssignedValue()) and
      bin.getOperator() = "+" and
      bin.getAnOperand().toString().matches("%SQL%") and
      rhs = lvd.getAnAssignedValue() and
      source.asExpr() = rhs
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, MethodAccess ma |
      m.hasName("executeQuery") and
      (
        m.getDeclaringType().hasName("BasePeer") or
        m.getDeclaringType().hasName("GroupPeer")
      ) and
      ma.getMethod() = m and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Static SQL queries are safe
    exists(string query |
      query.toLowerCase().matches("select%") or
      query.toLowerCase().matches("insert%") or
      query.toLowerCase().matches("update%") or
      query.toLowerCase().matches("delete%") and
      sanitizer.asExpr().(StringLiteral).getValue() = query
    )
    or
    // PreparedStatement.executeQuery() is safe
    exists(Method m, MethodAccess ma |
      m.hasName("executeQuery") and
      m.getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      ma.getMethod() = m and
      sanitizer.asExpr() = ma.getArgument(0)
    )
  }
}

from TurbineSqlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection from dynamic SQL construction to query execution.", source, sink,
  "This SQL query contains user-provided input that may not be properly sanitized."
