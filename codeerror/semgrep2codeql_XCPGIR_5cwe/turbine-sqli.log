Rule Content:
/**
 * @name Turbine SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 * @id java/turbine-sqli
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringTemplate

class SqlFormatSource extends DataFlow::ExprNode {
  SqlFormatSource() { 
    exists(Method m, Call ma |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getCallee() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SqlConcatSource extends DataFlow::ExprNode {
  SqlConcatSource() { 
    exists(LocalVariableDecl lvd, BinaryExpr be |
      lvd.getType().hasName("String") and
      lvd.getName().matches("%SQL%") and
      exists(LocalScopeVariable lsv | lsv.getDeclaration() = lvd |
        this.asExpr() = lsv.getAnAssignedValue()
      ) and
      be instanceof AddExpr
    )
  }
}

class ExecutePeerQuery extends DataFlow::Callable {
  ExecutePeerQuery() {
    this.getDeclaringType().hasName("BasePeer") or
    this.getDeclaringType().hasName("GroupPeer")
  }
}

class SqlExecuteSink extends DataFlow::ExprNode {
  SqlExecuteSink() {
    exists(Call call |
      call.getCallee() instanceof ExecutePeerQuery and
      call.getCallee().hasName("executeQuery") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class SanitizedSql extends DataFlow::ExprNode {
  SanitizedSql() {
    exists(StringLiteral sl |
      sl.getValue().regexpMatch("^(SELECT|INSERT|UPDATE|DELETE).*") and
      this.asExpr() = sl
    )
    or
    exists(MethodAccess ma |
      ma.getCallee().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      ma.getCallee().hasName("executeQuery") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class TurbineSqlConfig extends TaintTracking::Configuration {
  TurbineSqlConfig() { this = "TurbineSqlConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof SqlFormatSource or 
    source instanceof SqlConcatSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof SqlExecuteSink 
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SanitizedSql
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TurbineSqlConfig cfg
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Potential SQL injection from dynamic SQL construction to query execution"
