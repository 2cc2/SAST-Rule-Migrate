Rule Content:
/**
 * @id turbine-sqli
 * @name Turbine SQL Injection Vulnerability
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the 
 *              SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.0
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class SqlStringConcatSource extends DataFlow::Node {
  SqlStringConcatSource() {
    exists(MethodAccess ma |
      (ma.getMethod().hasName("format") and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) or
      (ma.getMethod().hasName("+") and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String"))
      |
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SqlVariableSource extends DataFlow::Node {
  SqlVariableSource() {
    exists(AssignExpr assign |
      exists(MethodAccess ma |
        (ma.getMethod().hasName("format") and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) or
        (ma.getMethod().hasName("+") and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String"))
        |
        assign.getRValue() = ma
      )
      |
      this.asExpr() = assign.getLValue()
    )
  }
}

class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() {
    exists(MethodAccess ma |
      (ma.getMethod().hasName("executeQuery") and 
       (ma.getMethod().getDeclaringType().getName().matches("BasePeer") or 
        ma.getMethod().getDeclaringType().getName().matches("GroupPeer")))
      and
      not ma.getArgument(0).(StringLiteral).getValue().regexpMatch("^\"\\..*\" \\+ \".*\"$")
      |
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class TurbineSqliConfiguration extends TaintTracking::Configuration {
  TurbineSqliConfiguration() { this = "TurbineSqliConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlStringConcatSource or source instanceof SqlVariableSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteSink
  }
}

from TurbineSqliConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "Potential SQL injection due to unsanitized string concatenation in SQL query"
