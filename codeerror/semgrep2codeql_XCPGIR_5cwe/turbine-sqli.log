/**
 * @id turbine-sqli
 * @name Turbine SQL Injection Vulnerability
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.0
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodCall mc |
      mc.getCallee().getName() = "format" and
      mc.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = mc.getArgument(0)
    )
  }
}

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(BinaryExpr be |
      be.getOperator() = "+" and
      be.getLeftOperand().getType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = be.getLeftOperand()
    )
  }
}

class VariableAssignmentSource extends DataFlow::Node {
  VariableAssignmentSource() {
    exists(AssignExpr assign, BinaryExpr be |
      be.getOperator() = "+" and
      be.getLeftOperand().getType().hasQualifiedName("java.lang", "String") and
      assign.getRhs() = be and
      this.asExpr() = assign.getLhs()
    )
    or
    exists(AssignExpr assign, MethodCall mc |
      mc.getCallee().getName() = "format" and
      mc.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String") and
      assign.getRhs() = mc and
      this.asExpr() = assign.getLhs()
    )
  }
}

class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() {
    exists(MethodCall mc |
      (mc.getCallee().getName() = "executeQuery" and
       (mc.getCallee().getDeclaringType().getName() = "BasePeer" or
        mc.getCallee().getDeclaringType().getName() = "GroupPeer")) and
      not mc.getArgument(0).toString().regexpMatch("^\"\\..*\" \\+ \".*\"$") and
      this.asExpr() = mc.getArgument(0)
    )
  }
}

class TurbineSqliConfig extends TaintTracking::Configuration {
  TurbineSqliConfig() { this = "TurbineSqliConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource or
    source instanceof VariableAssignmentSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteSink
  }
}

