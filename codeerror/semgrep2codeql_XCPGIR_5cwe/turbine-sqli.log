Rule Content:
/**
 * @name Turbine SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 * @id java/turbine-sqli
 */

import java
import DataFlow::PathGraph

class SqlFormatSource extends DataFlow::Node {
  SqlFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "format" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SqlConcatSource extends DataFlow::Node {
  SqlConcatSource() {
    exists(LocalVariableDecl lvd, BinaryExpr be |
      lvd.getType().hasName("String") and
      lvd.getName().matches("%SQL%") and
      exists(lvd.getAnAssignedValue()) and
      be instanceof AddExpr and
      this.asExpr() = lvd.getAnAssignedValue()
    )
  }
}

class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasName("BasePeer") or
       ma.getMethod().getDeclaringType().hasName("GroupPeer")) and
      ma.getMethod().getName() = "executeQuery" and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SanitizedSql extends DataFlow::Node {
  SanitizedSql() {
    exists(StringLiteral sl |
      sl.getValue().matches("^SELECT|INSERT|UPDATE|DELETE") and
      this.asExpr() = sl
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      ma.getMethod().getName() = "executeQuery" and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

predicate isSqlSource(DataFlow::Node source) {
  source instanceof SqlFormatSource or source instanceof SqlConcatSource
}

predicate isSqlSink(DataFlow::Node sink) {
  sink instanceof SqlExecuteSink
}

predicate isSqlSanitizer(DataFlow::Node sanitizer) {
  sanitizer instanceof SanitizedSql
}

module TurbineSqlFlow implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { isSqlSource(source) }
  predicate isSink(DataFlow::Node sink) { isSqlSink(sink) }
  predicate isSanitizer(DataFlow::Node sanitizer) { isSqlSanitizer(sanitizer) }
}

module TurbineSqlConfig = DataFlow::Global<TurbineSqlFlow>;

from DataFlow::PathNode source, DataFlow::PathNode sink
where TurbineSqlConfig::flowPath(source, sink)
select sink.getNode(), source, sink,
  "Potential SQL injection from dynamic SQL construction to query execution."
