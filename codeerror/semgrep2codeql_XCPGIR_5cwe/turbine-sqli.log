/**
 * @id turbine-sqli
 * @name Turbine SQL Injection Vulnerability
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the 
 *              SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.0
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class SqlStringConcatenation extends DataFlow::ExprNode {
  SqlStringConcatenation() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "format" and 
       ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) or
      (ma.getMethod().getName() = "+" and 
       ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String"))
    |
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SqlVariableAssignment extends DataFlow::Node {
  SqlVariableAssignment() {
    exists(Assignment assign, MethodAccess ma |
      (ma.getMethod().getName() = "format" and 
       ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) or
      (ma.getMethod().getName() = "+" and 
       ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String"))
    |
      assign.getRValue() = ma and
      this.asExpr() = assign.getLValue()
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "executeQuery" and 
       (ma.getMethod().getDeclaringType().getName() = "BasePeer" or 
        ma.getMethod().getDeclaringType().getName() = "GroupPeer"))
    |
      not ma.getArgument(0).toString().regexpMatch("^\"\\..*\" \\+ \".*\"$") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class TurbineSqlInjectionConfig extends TaintTracking::Configuration {
  TurbineSqlInjectionConfig() { this = "TurbineSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlStringConcatenation or source instanceof SqlVariableAssignment
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }
}

