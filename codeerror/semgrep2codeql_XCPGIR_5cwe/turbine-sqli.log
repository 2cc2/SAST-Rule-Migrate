Rule Content:
/**
 * @name Turbine SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized. 
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/turbine-sqli
 */
        
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.Concat
        
class TurbineSqlConfig extends TaintTracking::Configuration {
  TurbineSqlConfig() { this = "TurbineSqlConfig" }
    
  override predicate isSource(DataFlow::Node source) {
    // Source 1: String.format() with SQL pattern
    exists(MethodAccess ma | 
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasName("String") and
      source.asExpr() = ma.getArgument(0)
    )
    or
    // Source 2: SQL string concatenation
    exists(LocalVariableDecl lvd, BinaryExpr bin |
      lvd.getType() instanceof TypeString and
      bin.getLeftOperand().toString().matches("%SQL%") and
      source.asExpr() = lvd.getAnAssignedValue()
    )
  }
    
  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "executeQuery" and
      (
        ma.getMethod().getDeclaringType().hasName("BasePeer") or
        ma.getMethod().getDeclaringType().hasName("GroupPeer")
      ) and
      sink.asExpr() = ma.getArgument(0)
    )
  }
    
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Static SQL queries are safe
    exists(StringLiteral sl |
      sl.getValue().matches("SELECT%") or
      sl.getValue().matches("INSERT%") or
      sl.getValue().matches("UPDATE%") or
      sl.getValue().matches("DELETE%") and
      sanitizer.asExpr() = sl
    )
    or
    // PreparedStatement.executeQuery() is safe
    exists(MethodAccess ma |
      ma.getMethod().getName() = "executeQuery" and
      ma.getMethod().getDeclaringType().hasName("PreparedStatement") and
      sanitizer.asExpr() = ma.getArgument(0)
    )
  }
}
        
from TurbineSqlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Potential SQL injection from dynamic SQL construction to query execution."
