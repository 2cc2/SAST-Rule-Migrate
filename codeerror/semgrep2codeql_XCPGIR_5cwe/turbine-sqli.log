Rule Content:
/**
 * @name turbine-sqli
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables 
 *              in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/turbine-sqli
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormatting
import semmle.code.java.frameworks.internal.TurbineModels

class FormatStringSource extends TaintTracking::Source {
  FormatStringSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasName("String") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class StringConcatSource extends TaintTracking::Source {
  StringConcatSource() {
    exists(Assignment assign |
      assign.getDest().getType() instanceof TypeString and
      assign.getSource().toString() = /String.*=.*\+.*/ and
      this.asExpr() = assign.getSource()
    )
  }
}

class SqlSink extends TaintTracking::Sink {
  SqlSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().getName().matches("BasePeer") or
       ma.getMethod().getDeclaringType().getName().matches("GroupPeer")) and
      ma.getMethod().hasName("executeQuery") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class ConstantStringSanitizer extends TaintTracking::Sanitizer {
  ConstantStringSanitizer() {
    this.asExpr() instanceof StringLiteral or
    this.asExpr().toString() = /^"[^"]+"+[^"]+"$/
  }
}

class TurbineSQLIRules extends TaintTracking::Configuration {
  TurbineSQLIRules() { this = "Turbine SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FormatStringSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ConstantStringSanitizer
  }
}

from TurbineSQLIRules cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization", 
  source, sink,
  "Potential SQL injection vulnerability"
