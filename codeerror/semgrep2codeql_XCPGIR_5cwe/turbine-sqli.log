/**
 * @name turbine-sqli
 * @description Detects formatted strings in SQL statements that could lead to SQL injection
 * @kind path-problem
 * @problem.severity warning
 * @id java/turbine-sqli
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringUtil

class TurbineSQLIConfig extends TaintTracking::Configuration {
  TurbineSQLIConfig() { 
    this = "Turbine SQL Injection Configuration" 
  }

  override predicate isSource(DataFlow::Node source) {
    // String.format() source
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      source.asExpr() = ma.getArgument(0)
    )
    or
    // String concatenation source
    exists(Assignment assign |
      assign.getDest().getType() instanceof TypeString and
      exists(MethodAccess concat | concat = assign.getSource() |
        concat.getMethod().getName() = "concat" and 
        concat.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().getName() = "BasePeer" or
       ma.getMethod().getDeclaringType().getName() = "GroupPeer") and
      ma.getMethod().hasName("executeQuery") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral
  }
}

