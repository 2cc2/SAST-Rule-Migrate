/**
 * @id turbine-sqli
 * @name Turbine SQL Injection Vulnerability
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the
 *              SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.0
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class SqlStringConcatenation extends DataFlow::ExprNode {
  SqlStringConcatenation() {
    exists(Method m, MethodAccess ma |
      (m.hasName("format") and 
       m.getDeclaringType().hasQualifiedName("java.lang", "String")) or
      (m.hasName("+") and 
       m.getDeclaringType().hasQualifiedName("java.lang", "String"))
      and
      ma.getMethod() = m
    |
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SqlVariableAssignment extends DataFlow::ExprNode {
  SqlVariableAssignment() {
    exists(AssignExpr assign, Method m, MethodAccess ma |
      (m.hasName("format") and 
       m.getDeclaringType().hasQualifiedName("java.lang", "String")) or
      (m.hasName("+") and 
       m.getDeclaringType().hasQualifiedName("java.lang", "String"))
      and
      ma.getMethod() = m and
      assign.getRightOperand() = ma and
      this.asExpr() = assign.getLeftOperand()
    )
  }
}

class SqlExecutionSink extends DataFlow::ExprNode {
  SqlExecutionSink() {
    exists(Method m, MethodAccess ma |
      m.hasName("executeQuery") and 
      (m.getDeclaringType().getName() = "BasePeer" or 
       m.getDeclaringType().getName() = "GroupPeer")
      and
      ma.getMethod() = m and
      not ma.getArgument(0).toString().regexpMatch("^\"\\..*\" \\+ \".*\"$")
    |
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class TurbineSqlInjectionConfig extends TaintTracking::Configuration {
  TurbineSqlInjectionConfig() { this = "TurbineSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlStringConcatenation or source instanceof SqlVariableAssignment
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }
}

