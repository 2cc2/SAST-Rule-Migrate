Rule Content:
/**
 * @name Turbine SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 * @id java/turbine-sqli
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Turbine
import DataFlow::PathGraph

class SqlFormatSource extends DataFlow::ExprNode {
  SqlFormatSource() {
    exists(MethodAccess ma |
      ma.getCallee().hasName("format") and
      ma.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SqlConcatSource extends DataFlow::ExprNode {
  SqlConcatSource() {
    exists(LocalVariableDecl lvd, BinaryExpr be |
      lvd.getType().hasName("String") and
      lvd.getName().matches("%SQL%") and
      exists(lvd.getVariable().getAnAssignedValue()) and
      be instanceof AddExpr and
      this.asExpr() = lvd.getVariable().getAnAssignedValue()
    )
  }
}

class SqlExecuteSink extends DataFlow::ExprNode {
  SqlExecuteSink() {
    exists(MethodAccess ma |
      (ma.getCallee().getDeclaringType().hasName("BasePeer") or
       ma.getCallee().getDeclaringType().hasName("GroupPeer")) and
      ma.getCallee().hasName("executeQuery") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SanitizedSql extends DataFlow::ExprNode {
  SanitizedSql() {
    exists(StringLiteral sl |
      sl.getValue().regexpMatch("^(SELECT|INSERT|UPDATE|DELETE).*") and
      this.asExpr() = sl
    )
    or
    exists(MethodAccess ma |
      ma.getCallee().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") and
      ma.getCallee().hasName("executeQuery") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

predicate isSqlSource(DataFlow::Node source) {
  source instanceof SqlFormatSource or source instanceof SqlConcatSource
}

predicate isSqlSink(DataFlow::Node sink) {
  sink instanceof SqlExecuteSink
}

predicate isSqlSanitizer(DataFlow::Node sanitizer) {
  sanitizer instanceof SanitizedSql
}

class TurbineSqlFlowConfiguration extends DataFlow::Configuration {
  TurbineSqlFlowConfiguration() { this = "TurbineSqlFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) { isSqlSource(source) }

  override predicate isSink(DataFlow::Node sink) { isSqlSink(sink) }

  override predicate isSanitizer(DataFlow::Node san) { isSqlSanitizer(san) }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where any(TurbineSqlFlowConfiguration cfg).hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Potential SQL injection from dynamic SQL construction to query execution"
