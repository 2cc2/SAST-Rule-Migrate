/**
 * @name turbine-sqli
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables
 *              in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/turbine-sqli
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormatting
import semmle.code.java.frameworks.Turbine

class FormatStringSource extends DataFlow::Expr {
  FormatStringSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this = ma.getArgument(0)
    )
  }
}

class StringConcatSource extends DataFlow::Expr {
  StringConcatSource() {
    exists(AssignmentExpr assign |
      assign.getDest().getType() instanceof TypeString and
      RegexPatternMatch.match(/String.*=.*\+.*/, assign.getSource().toString()) and
      this = assign.getSource()
    )
  }
}

class SqlSink extends DataFlow::Expr {
  SqlSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().getName().matches("BasePeer") or
       ma.getMethod().getDeclaringType().getName().matches("GroupPeer")) and
      ma.getMethod().hasName("executeQuery") and
      this = ma.getArgument(0)
    )
  }
}

class TurbineSQLIConfig extends TaintTracking::Configuration {
  TurbineSQLIConfig() { this = "Turbine SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof FormatStringSource or
    source.asExpr() instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asExpr() instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral
  }
}

from TurbineSQLIConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(),
  "User input reaches SQL execution without sanitization",
  source.getNode(), sink.getNode(),
  "Potential SQL injection vulnerability"
