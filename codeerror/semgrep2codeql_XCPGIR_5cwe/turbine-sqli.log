scope:
  languages: [java]
  frameworks: [turbine]

sources:
  - id: DYNAMIC_SQL
    match:
      node: CALL
      api: { type: java.lang,String, method: format }
      arg_index: 0
  - id: CONCAT_SQL
    match:
      node: ASSIGNMENT
      where:
        - op: regex
          left: value
          right: "String \\$SQL = \\$X \\+ \\$Y"

sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: { type: [BasePeer, GroupPeer], method: executeQuery }
      arg_index: 0

sanitizers:
  - id: STATIC_SQL
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "^\"SELECT|INSERT|UPDATE|DELETE"

barriers:
  - id: SAFE_SQL
    match:
      node: CALL
      api: { type: java.sql.PreparedStatement, method: executeQuery }

propagations:
  - id: SQL_TO_EXEC
    edge: arg->param
    kind: taint

flows:
  - source: DYNAMIC_SQL
    sink: SQL_EXEC
    through: [SQL_TO_EXEC*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(\"[A-Za-z0-9 ]+\")" } ]
  - source: CONCAT_SQL
    sink: SQL_EXEC
    through: [SQL_TO_EXEC*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(\"[A-Za-z0-9 ]+\")" } ]

report:
  locations: ["source", "sink", "path"]
  evidence:
    capture:
      - argument: 0
tests:
  positive:
    - "BasePeer.executeQuery(String.format(\"SELECT * FROM users WHERE name='%s'\", input))"
    - "String sql = \"SELECT * FROM \" + table; GroupPeer.executeQuery(sql)"
  negative:
    - "BasePeer.executeQuery(\"SELECT * FROM users\")"
    - "String sql = \"SELECT * FROM admins\"; GroupPeer.executeQuery(sql)"
