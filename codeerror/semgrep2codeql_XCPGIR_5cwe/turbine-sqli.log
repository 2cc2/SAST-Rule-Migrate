/**
 * @name turbine-sqli
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables
 *              in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/turbine-sqli
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringUtil

class TurbineSQLIConfiguration extends TaintTracking::Configuration {
  TurbineSQLIConfiguration() { this = "Turbine SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      source.asExpr() = ma.getArgument(0)
    )
    or
    exists(Assignment assign |
      assign.getDest().getType() instanceof TypeString and
      exists(MethodAccess ma | ma = assign.getSource() |
        ma.getMethod().getName() = "concat" and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().getName() = "BasePeer" or
       ma.getMethod().getDeclaringType().getName() = "GroupPeer") and
      ma.getMethod().hasName("executeQuery") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral
  }
}

