Rule Content:
/**
 * @name Hibernate SQL Injection
 * @kind problem
 * @id java/hibernate-sqli
 * @severity Warning
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables 
 *              in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Hibernate
import semmle.code.java.StringFormat

class HibernateSqlInjectionConfig extends TaintTracking::Configuration {
  HibernateSqlInjectionConfig() { this = "HibernateSqlInjectionConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    // Source: String concatenation for SQL queries
    exists(AssignmentExpr assign | 
      assign.getTarget().getName().matches("%SQL%") and
      assign.getSource().getType() instanceof StringType and
      assign.getSource().toString().matches("%+%") and
      source.asExpr() = assign.getSource()
    )
    or
    // Source: String.format calls
    exists(MethodAccess ma | 
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // Sink: Hibernate's sqlRestriction method
    exists(MethodAccess ma | 
      (
        ma.getMethod().hasName("sqlRestriction") and
        ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate.criterion", "Restrictions")
      )
      and sink.asExpr() = ma.getArgument(0)
    )
    or
    // Sink: Hibernate's createQuery/createSQLQuery methods
    exists(MethodAccess ma | 
      (
        ma.getMethod().hasName(["createQuery", "createSQLQuery"]) and
        ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate", "Session")
      )
      and sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Safe string literal concatenation
    exists(AssignmentExpr assign |
      assign.getTarget().getName().matches("%SQL%") and
      assign.getSource().toString().matches("\"%\" + \"%\"") and
      sanitizer.asExpr() = assign.getSource()
    )
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    // Barrier: Return statements stop flow
    exists(ReturnStmt ret | barrier.asStmt() = ret)
  }
}

from HibernateSqlInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization. $@ flows from $@ to $@.",
  source.getNode(), "source location",
  sink.getNode(), "sink location"
