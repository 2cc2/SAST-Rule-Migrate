class SessionMethodSink extends TaintTracking::Sink {
  SessionMethodSink() {
    exists(Method m |
      (m.hasName("createQuery") or m.hasName("createSQLQuery")) and
      m.getDeclaringType().hasQualifiedName("org.hibernate", "Session") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
  }
}

class HibernateSqliConfig extends TaintTracking::Configuration {
  HibernateSqliConfig() { this = "Hibernate SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlRestrictionSink or
    sink instanceof SessionMethodSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AddExpr add |
      exists(add.getAnOperand() | this instanceof StringLiteral) and
      sanitizer.asExpr() = add
    )
  }
}

