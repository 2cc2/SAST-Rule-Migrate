/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 * if variables in the SQL statement are not properly sanitized. Use prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Hibernate
import DataFlow::PathGraph

class StringFormatSource extends DataFlow::ExprNode {
  StringFormatSource() {
    exists(Method m | 
      m.hasQualifiedName("java.lang.String", "format") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
  }
}

class StringConcatSource extends DataFlow::ExprNode {
  StringConcatSource() {
    exists(Variable v, AddExpr add |
      v.getType().hasName("String") and
      v.getAnAssignedValue() = add and
      exists(add.getAnOperand() | not this instanceof StringLiteral) and
      this.asExpr() = v.getAnAccess()
    )
  }
}

class SqlRestrictionSink extends DataFlow::ExprNode {
  SqlRestrictionSink() {
    exists(Method m |
      m.hasQualifiedName("org.hibernate.criterion.Restrictions", "sqlRestriction") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
  }
}

class SessionMethodSink extends DataFlow::ExprNode {
  SessionMethodSink() {
    exists(Method m |
      (m.hasName("createQuery") or m.hasName("createSQLQuery")) and
      m.getDeclaringType().hasQualifiedName("org.hibernate", "Session") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
  }
}

class HibernateSqliConfiguration extends TaintTracking::Configuration {
  HibernateSqliConfiguration() { this = "Hibernate SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlRestrictionSink or
    sink instanceof SessionMethodSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AddExpr add |
      add.getAnOperand() instanceof StringLiteral and
      sanitizer.asExpr() = add
    )
  }
}

