Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables 
 *              in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Hibernate
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "format" and
      ma.getMethod().getDeclaringType() instanceof TypeString and
      this.asExpr() = ma.getArgument(0)
    ) or
    exists(AssignExpr ae |
      ae.getRight().toString().regexpMatch("String.*\\+.*") and
      this.asExpr() = ae.getRight()
    )
  }
}

class HibernateSink extends DataFlow::Node {
  HibernateSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName() = "sqlRestriction" and
        ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate.criterion", "Restrictions")
      ) or
      (
        ma.getMethod().getName().matches("%createQuery%") and
        ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate", "Session")
      )
    ) and
    this.asExpr() = ma.getArgument(0)
  }
}

class SafeStringConcatSanitizer extends DataFlow::BarrierGuard {
  SafeStringConcatSanitizer() {
    exists(AssignExpr ae |
      ae.getRight().toString().regexpMatch("String.*\".*\"\\+\".*\"") and
      this.asExpr() = ae.getRight()
    )
  }
}

class HibernateSQLiConfig extends TaintTracking::Configuration {
  HibernateSQLiConfig() { this = "HibernateSQLiConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HibernateSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeStringConcatSanitizer
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier.getNode() instanceof ReturnStmt
  }
}

from HibernateSQLiConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "Potential SQL injection via string concatenation/formatter in Hibernate", 
  source.getNode(), "Unsafe SQL string construction here", sink.getNode(), "SQL execution here"
