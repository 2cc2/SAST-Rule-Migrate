Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detects potential SQL injection vulnerabilities when using String concatenation/formats 
 *              with Hibernate's SQL query methods.
 * @kind problem
 * @problem.severity warning
 * @precision high
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.Hibernate.HibernateQueries

class DynamicStringFormat extends DataFlow::Node {
  DynamicStringFormat() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getCaller() = this.asExpr()
    )
    or
    exists(LocalVariableDecl lvd, Expr concat |
      concat instanceof AddExpr and
      this.asExpr() = lvd.getVariable().getAnAccess() and
      lvd.getInitializer() = concat
    )
  }
}

class SqlSanitizer extends DataFlow::Node {
  SqlSanitizer() {
    this.asExpr() instanceof StringLiteral
  }
}

class HibernateSink extends DataFlow::Node {
  HibernateSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().hasName("sqlRestriction") and
        ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate.criterion", "Restrictions") and
        ma.getArgument(0) = this.asExpr()
      )
      or
      (
        (ma.getMethod().hasName("createQuery") or ma.getMethod().hasName("createSQLQuery")) and
        ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate", "Session") and
        ma.getArgument(0) = this.asExpr()
      )
    )
  }
}

class HibernateSqlInjectionConfig extends TaintTracking::Configuration {
  HibernateSqlInjectionConfig() { this = "Hibernate Sql Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicStringFormat
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HibernateSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SqlSanitizer
  }

  override predicate isSanitizerGuard(DataFlow::Node node) { none() }
}

from HibernateSqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "Potentially unsafe SQL query constructed with string formatting. " +
  "Use prepared statements instead to prevent SQL injection.", source.getNode(),
  "Dynamic SQL string flows to Hibernate query here."
