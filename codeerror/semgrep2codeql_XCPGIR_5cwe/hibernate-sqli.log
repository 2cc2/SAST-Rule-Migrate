      )
      or
      (
        (ma.getMethod().getName() = "createQuery" or ma.getMethod().getName() = "createSQLQuery") and
        ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate", "Session")
      )
      and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SafeStringConcatSanitizer extends TaintTracking::Sanitizer {
  override predicate sanitizes(DataFlow::Node node) {
    exists(Expr e |
      e.toString().regexpMatch("String.*\".*\"\\+\".*\"") and
      node.asExpr() = e
    )
  }
}

class HibernateSQLiConfig extends TaintTracking::Configuration {
  HibernateSQLiConfig() { this = "HibernateSQLiConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HibernateSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeStringConcatSanitizer
  }

  override predicate isBarrier(DataFlow::Node node) {
    node.asExpr() instanceof ReturnStmt
  }
