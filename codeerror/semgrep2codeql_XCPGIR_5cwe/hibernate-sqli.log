    )
  }
}

class HibernateSqliConfig extends TaintTracking::Configuration {
  HibernateSqliConfig() { this = "Hibernate SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlRestrictionSink or
    sink instanceof SessionMethodSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AddExpr add |
      add.getAnOperand() instanceof StringLiteral and
      sanitizer.asExpr() = add
    )
  }
}

