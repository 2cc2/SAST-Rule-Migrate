Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Hibernate

class DynamicSqlSource extends DataFlow::Node {
  DynamicSqlSource() {
    exists(Method m | 
      (m.getDeclaringType().hasQualifiedName("java.lang", "String") and
       m.getName().matches("format%")) and
      this.asExpr() = m.getACall().getArgument(0)
    )
    or
    exists(LocalVariableDecl lvd |
      lvd.getType().hasName("String") and
      lvd.getName().matches("%SQL%") and
      this.asExpr() = lvd.getInitializer() and
      not lvd.getInitializer() instanceof StringLiteral
    )
  }
}

class MethodParamSource extends DataFlow::Node {
  MethodParamSource() {
    exists(Method m, Parameter p |
      p.getType().hasName("String") and
      p.getName().matches("%SQL%") and
      m.getAParameter() = p and
      this.asParameter() = p
    )
  }
}

class SqlRestrictionSink extends DataFlow::Node {
  SqlRestrictionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate.criterion", "Restrictions") and
      ma.getMethod().getName() = "sqlRestriction" and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SessionMethodSink extends DataFlow::Node {
  SessionMethodSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "createQuery" or
       ma.getMethod().getName() = "createSQLQuery") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class LiteralConcatSanitizer extends TaintTracking::Sanitizer {
  LiteralConcatSanitizer() {
    exists(StringLiteral sl1, StringLiteral sl2 |
      this.asExpr() instanceof BinaryAdd and
      this.asExpr().getLeftOperand() = sl1 and
      this.asExpr().getRightOperand() = sl2
    )
  }
}

class HibernateSqliFlowConfig extends TaintTracking::Configuration {
  HibernateSqliFlowConfig() { this = "HibernateSqliFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicSqlSource or source instanceof MethodParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlRestrictionSink or sink instanceof SessionMethodSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof LiteralConcatSanitizer
  }
}

from HibernateSqliFlowConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Detected a formatted string in a SQL statement. This could lead to SQL injection if " +
  "variables in the SQL statement are not properly sanitized. Use prepared statements instead."
