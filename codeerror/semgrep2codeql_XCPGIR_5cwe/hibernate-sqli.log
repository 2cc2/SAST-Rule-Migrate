Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables
 *              in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Hibernate
import semmle.code.java.StringConcatenation
import DataFlow::PathGraph

class StringFormatSource extends DataFlow::ExprNode {
  StringFormatSource() {
    exists(Method m | 
      m.hasName("format") and
      m.getDeclaringType() instanceof TypeString and
      this.asExpr() = m.getACall().getArgument(0)
    ) or
    exists(Expr e |
      e.toString().regexpMatch("String.*\\+.*") and
      this.asExpr() = e
    )
  }
}

class HibernateSink extends DataFlow::ExprNode {
  HibernateSink() {
    exists(Method m |
      (
        m.hasName("sqlRestriction") and
        m.getDeclaringType().hasQualifiedName("org.hibernate.criterion", "Restrictions")
      ) or
      (
        (m.hasName("createQuery") or m.hasName("createSQLQuery")) and
        m.getDeclaringType().hasQualifiedName("org.hibernate", "Session")
      )
    ) and
    this.asExpr() = m.getACall().getArgument(0)
  }
}

class SafeStringConcatSanitizer extends TaintTracking::Sanitizer {
  override predicate sanitizes(TaintTracking::SanitizerState state, Expr e) {
    exists(Assignment a |
      a.getRValue().toString().regexpMatch("String.*\".*\"\\+\".*\"") and
      e = a.getRValue()
    )
  }
}

class HibernateSQLiConfig extends TaintTracking::Configuration {
  HibernateSQLiConfig() { this = "HibernateSQLiConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HibernateSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeStringConcatSanitizer
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier.getNode() instanceof ReturnStmt
  }
}

from HibernateSQLiConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential SQL injection via string concatenation/formatter in Hibernate", 
  source, "Unsafe SQL string construction here", sink, "SQL execution here"
