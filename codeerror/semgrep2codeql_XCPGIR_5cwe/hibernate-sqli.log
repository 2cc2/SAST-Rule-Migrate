Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 * if variables in the SQL statement are not properly sanitized. Use prepared statements.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.Hibernate

class StringFormatSource extends DataFlow::ExprNode {
  StringFormatSource() {
    exists(Method m | 
      m.hasQualifiedName("java.lang.String", "format") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
  }
}

class StringConcatSource extends DataFlow::ExprNode {
  StringConcatSource() {
    exists(Variable v, AssignExpr assign |
      v.getType().hasName("String") and
      assign.getDest() = v and
      assign.getSource().(AddExpr).getAnOperand() instanceof Variable and
      this.asExpr() = v.getAnAccess()
    )
  }
}

class SqlRestrictionSink extends DataFlow::ExprNode {
  SqlRestrictionSink() {
    exists(Method m |
      m.hasQualifiedName("org.hibernate.criterion.Restrictions", "sqlRestriction") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
  }
}

class SessionMethodSink extends DataFlow::ExprNode {
  SessionMethodSink() {
    exists(Method m |
      (m.hasName("createQuery") or m.hasName("createSQLQuery")) and
      m.getDeclaringType().hasQualifiedName("org.hibernate", "Session") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
  }
}

class HibernateSqliConfig extends TaintTracking::Configuration {
  HibernateSqliConfig() { this = "Hibernate SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlRestrictionSink or
    sink instanceof SessionMethodSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AddExpr add |
      add.getAnOperand() instanceof StringLiteral and
      sanitizer.asExpr() = add
    )
  }
}

from HibernateSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected a formatted string in a SQL statement. This could lead to SQL injection."
