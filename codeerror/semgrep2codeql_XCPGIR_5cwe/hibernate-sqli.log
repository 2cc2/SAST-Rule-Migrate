Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 * if variables in the SQL statement are not properly sanitized. Use prepared statements.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Hibernate

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.lang.String", "format") and
      this.asExpr() = ma
    )
  }
}

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(Variable v |
      v.getType().hasName("String") and
      this.asExpr() = v.getAnAssignedValue() and
      exists(AddExpr add | add = v.getAnAssignedValue() | not add.getRightOperand().isStringLiteral())
    )
  }
}

class SqlRestrictionSink extends DataFlow::Node {
  SqlRestrictionSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.hibernate.criterion.Restrictions", "sqlRestriction") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SessionMethodSink extends DataFlow::Node {
  SessionMethodSink() {
    exists(MethodAccess ma |
      (ma.getMethod().hasName("createQuery") or ma.getMethod().hasName("createSQLQuery")) and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate", "Session") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class HibernateSqliConfig extends TaintTracking::Configuration {
  HibernateSqliConfig() { this = "HibernateSqliConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlRestrictionSink or
    sink instanceof SessionMethodSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AddExpr add |
      add.getRightOperand().isStringLiteral() and
      sanitizer.asExpr() = add
    )
  }
}

from HibernateSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected a formatted string in a SQL statement. This could lead to SQL injection."
