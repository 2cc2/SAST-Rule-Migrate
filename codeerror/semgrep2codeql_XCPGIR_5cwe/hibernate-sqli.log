  id: hibernate-sqli
  kind: taint
  severity: WARNING
  message: "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead."
scope:
  languages: [java]
  frameworks: ["hibernate"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: DYNAMIC_SQL
    match:
      node: ASSIGNMENT
      where:
        - op: regex
          left: value
          right: "String\\s+\\$SQL\\s*=\\s*\\$X\\s*\\+\\s*\\$Y"
        - op: regex
          left: value
          right: "String\\s+\\$SQL\\s*=\\s*String\\.format\\(.*\\)"
    - id: METHOD_PARAM_SQL
      match:
        node: METHOD_PARAMETER_IN
        where:
          - op: regex
            left: typeFullName
            right: "java\\.lang\\.String"
          - op: regex
            left: name
            right: "\\$SQL"

sinks:
  - id: SQL_RESTRICTION
    match:
      node: CALL
      api: { type: org.hibernate.criterion.Restrictions, method: sqlRestriction }
      arg_index: 0
    - id: SESSION_METHOD
      match:
        node: CALL
        api: { method: "(createQuery|createSQLQuery)" }
        arg_index: 0

propagations:
  - id: ASSIGN_TO_CALL
    edge: arg->param
    kind: taint
  - id: PARAM_TO_CALL
    edge: arg->param
    kind: taint

sanitizers:
  - id: LITERAL_CONCAT
    match:
      node: CALL
      where:
        - op: regex
          left: code
          right: 'String\\s+\\$SQL\\s*=\\s*".*"\\s*\\+\\s*".*"'

flows:
  - source: DYNAMIC_SQL
    sink: SQL_RESTRICTION
    through: [ASSIGN_TO_CALL]
    constraints:
      path:
        must_not: [ { pattern: "ASSIGNMENT(String $SQL = \"...\" + \"...\")" } ]
  - source: METHOD_PARAM_SQL
    sink: SESSION_METHOD
    through: [PARAM_TO_CALL]
    constraints:
      path:
        must_not: [ { pattern: "CALL($SESSION.$METHOD(\"...\" + \"...\",...))" } ]

report:
  message: "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use prepared statements instead."
  locations: ["source","sink","path"]
  evidence: { capture: [{ argument: 0 }] }
```
