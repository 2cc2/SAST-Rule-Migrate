      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
  }
}

class StringConcatSource extends TaintTracking::Source {
  StringConcatSource() {
    exists(Variable v, AssignExpr assign |
      v.getType().hasName("String") and
      assign.getDest() = v and
      exists(AddExpr add | assign.getSource() = add) and
      this.asExpr() = v.getAnAccess()
    )
  }
}

class SqlRestrictionSink extends TaintTracking::Sink {
  SqlRestrictionSink() {
    exists(Method m |
      m.hasQualifiedName("org.hibernate.criterion.Restrictions", "sqlRestriction") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
