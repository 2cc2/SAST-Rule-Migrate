/**
 * @name Insecure XSSRequestWrapper Implementation
 * @description Detects insecure implementation of XSSRequestWrapper with vulnerable script removal
 * @kind path-problem
 * @problem.severity warning
 * @id java/xssrequestwrapper-is-insecure
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class XSSRequestWrapperType extends RefType {
  XSSRequestWrapperType() {
    this.hasQualifiedName("", "XSSRequestWrapper") and
    this.getASupertype*() instanceof TypeHttpServletRequestWrapper
  }
}

class InsecureScriptRemoval extends MethodAccess {
  InsecureScriptRemoval() {
    exists(Method m |
      m = this.getMethod() and
      m.getName() = "compile" and
      m.getDeclaringType().hasQualifiedName("java.util.regex", "Pattern") and
      this.getArgument(0).(Literal).getStringValue() = "(?i)</script>" and
      exists(MethodAccess replaceAll |
        replaceAll.getMethod().getName() = "replaceAll" and
        replaceAll.getQualifier().getSourceDeclaration() = this and
        replaceAll.getArgument(0).(Literal).getStringValue() = ""
      )
    )
  }
}

class XSSRequestWrapperConfig extends TaintTracking::Configuration {
  XSSRequestWrapperConfig() { this = "XSSRequestWrapperConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(XSSRequestWrapperType t | source.asExpr() = t.getASupertype*())
    or
    exists(InsecureScriptRemoval isr | source.asExpr() = isr)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ServletRequest::GetParameterMethodAccess gp |
      sink.asExpr() = gp.getAnArgument()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, XSSRequestWrapperConfig conf
where conf.hasFlowPath(source, sink)
select sink, "Insecure XSS filtering detected in XSSRequestWrapper implementation", source,
  "Potential XSS vulnerability due to insecure script removal"
