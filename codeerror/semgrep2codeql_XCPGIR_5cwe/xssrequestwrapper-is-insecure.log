/**
 * @name Insecure XSSRequestWrapper Implementation
 * @description Detects insecure implementation of XSSRequestWrapper with vulnerable script removal
 * @kind path-problem
 * @problem.severity warning
 * @id java/xssrequestwrapper-is-insecure
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.Servlets

class XSSRequestWrapper extends RefType {
  XSSRequestWrapper() {
    this.getQualifiedName().matches("%XSSRequestWrapper") and
    this.getASupertype().hasQualifiedName("javax.servlet.http", "HttpServletRequestWrapper")
  }
}

class InsecureScriptRemoval extends Expr {
  InsecureScriptRemoval() {
    exists(Method compileMethod, MethodAccess compileCall |
      compileMethod.hasQualifiedName("java.util.regex", "Pattern", "compile") and
      compileCall.getMethod() = compileMethod and
      exists(StringLiteral pattern |
        pattern = compileCall.getArgument(0) and
        pattern.getValue().toLowerCase() = "</script>"
      ) and
      exists(Method replaceAllMethod, MethodAccess replaceAllCall |
        replaceAllMethod.hasQualifiedName("java.lang", "String", "replaceAll") and
        replaceAllCall.getMethod() = replaceAllMethod and
        replaceAllCall.getQualifier().(Call).getCallee() = compileCall.getEnclosingCallable() and
        exists(StringLiteral replacement |
          replacement = replaceAllCall.getArgument(0) and
          replacement.getValue() = ""
        )
      )
    )
  }
}

class XSSRequestWrapperConfig extends DataFlow::Configuration {
  XSSRequestWrapperConfig() { this = "XSSRequestWrapperConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(XSSRequestWrapper wrapper | source.asType() = wrapper)
    or
    exists(InsecureScriptRemoval isr | source.asExpr() = isr)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method getParamMethod, Call getParamCall |
      getParamMethod.hasQualifiedName("javax.servlet.http", "HttpServletRequest", "getParameter") and
      getParamCall.getCallee() = getParamMethod and
      sink.asExpr() = getParamCall
    )
  }
}

