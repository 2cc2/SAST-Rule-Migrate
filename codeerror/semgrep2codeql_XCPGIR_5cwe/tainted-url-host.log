Rule Content:
/**
 * @name Tainted URL host (SSRF risk)
 * @description User data flows into the host portion of a manually-constructed URL.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @id java/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringFrameworks

class SpringRequestInput extends RemoteUserInput {
  SpringRequestInput() {
    exists(Method m, Parameter p |
      p.getAnAnnotation().toString().matches("%(RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue|ModelAttribute)%") and
      not p.getType().toString().matches("%^(Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean)%") and
      this.asParameter() = p
    )
  }
}

class URLConstructorCall extends DataFlow::Node {
  URLConstructorCall() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.net", "URL") and
      cc.getArgument(0) = this.asExpr()
    )
  }
}

class StringConcatWithProtocol extends DataFlow::Node {
  StringConcatWithProtocol() {
    exists(StringLiteral sl, Expr concat |
      sl.getValue().matches("%^http(s?)://%") and
      (concat.(AddExpr).getRightOperand() = this.asExpr() or
       concat.(AddExpr).getLeftOperand() = this.asExpr()) and
      concat.getEnclosingCallable() = this.asExpr().getEnclosingCallable()
    )
  }
}

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SpringRequestInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof URLConstructorCall or
    sink instanceof StringConcatWithProtocol
  }
}

from TaintedUrlHostConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User data flows into the host portion of a manually-constructed URL (SSRF risk)"
