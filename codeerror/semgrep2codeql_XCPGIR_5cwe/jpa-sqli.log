Rule Content:
/**
 * @name JPA SQL Injection Vulnerability
 * @description Detects formatted strings or concatenated strings used in JPA SQL queries without proper sanitization,
 *              which could lead to SQL injection. Recommends using prepared statements instead.
 * @id java/jpa-sqli
 * @kind path-problem
 * @security-severity 8.8
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.JPA

class StringFormatMethod extends Method {
  StringFormatMethod() {
    this.getDeclaringType().hasQualifiedName("java.lang", "String") and
    this.hasName("format")
  }
}

class ConcatenatedSqlAssignment extends Assignment {
  ConcatenatedSqlAssignment() {
    exists(Method m, Variable v |
      this.getDest().getVariable() = v and
      v.getName() = "SQL" and
      this.getSource().toString().matches("%.*\\+.*") and
      v.getType().toString() = "String"
    )
  }
}

class JpaQueryCreation extends MethodAccess {
  JpaQueryCreation() {
    this.getMethod().hasName(["createQuery", "createNativeQuery"]) and
    this.getMethod().getDeclaringType().getASourceSupertype*().hasQualifiedName("javax.persistence", "EntityManager")
  }
}

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(StringFormatMethod format |
      source.asExpr() = format.getACall()
    ) or
    exists(ConcatenatedSqlAssignment assign |
      source.asExpr() = assign.getSource()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(JpaQueryCreation query |
      sink.asExpr() = query.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral
  }
}

from SqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User input reaches JPA SQL execution without sanitization. $@ flows from here to $@.",
  source.getNode(), "Potential SQL injection source",
  sink.getNode(), "JPA query execution"
