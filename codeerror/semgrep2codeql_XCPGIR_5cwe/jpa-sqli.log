Rule Content:
/**
 * @name JPA SQL Injection Vulnerability
 * @description Detects formatted strings or concatenated strings used in JPA SQL queries 
 *              without proper sanitization leading to SQL injection.
 * @id java/jpa-sqli
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.JPA
import semmle.code.java.StringFormat

class StringConcatenatedSql extends DataFlow::ExprNode {
  StringConcatenatedSql() {
    exists(Assignment assign |
      assign.getDest().toString().matches("(?i)SQL") and
      assign.getSource().(AddExpr).getAnOperand().getType() instanceof StringType and
      this.asExpr() = assign.getSource()
    )
  }
}

class JpaQueryExecution extends DataFlow::Node {
  JpaQueryExecution() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("createQuery|createNativeQuery") and
      ma.getMethod().getDeclaringType() instanceof JPAClass and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class JpaSqlInjectionConfig extends TaintTracking::Configuration {
  JpaSqlInjectionConfig() { this = "JpaSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr().(MethodAccess).getMethod() instanceof StringFormatMethod or
    source instanceof StringConcatenatedSql
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JpaQueryExecution
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral
  }
}

from JpaSqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "User input reaches JPA SQL query without sanitization", source, sink,
  "$@ flows from here to $@.", source.getNode(), "Potential SQL injection source",
  sink.getNode(), "JPA query execution"
================================================================================
