Rule Content:
/**
 * @name JPA SQL Injection Vulnerability
 * @description Detects formatted strings or concatenated strings used in JPA SQL queries without proper sanitization,
 *              which could lead to SQL injection. Recommends using prepared statements instead.
 * @id java/jpa-sqli
 * @kind path-problem
 * @severity warning
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semanticdb.DataFlow
import DataFlow::PathGraph

class StringFormatCall extends DataFlow::CallNode {
  StringFormatCall() {
    exists(Method m | 
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.getTarget() = m
    )
  }
}

class SqlStringAssignment extends DataFlow::Node {
  SqlStringAssignment() {
    exists(AssignExpr assign |
      assign.getRightOperand() = this.asExpr() and
      assign.getLeftOperand().getType().hasName("String") and
      assign.getLeftOperand().toString().matches("SQL")
    )
  }
}

class JpaQueryExecution extends DataFlow::CallNode {
  JpaQueryExecution() {
    exists(Method m |
      m.hasName(["createQuery", "createNativeQuery"]) and
      m.getDeclaringType().hasQualifiedName("javax.persistence", "EntityManager") and
      this.getTarget() = m
    )
  }
}

class SqlInjectionFlow extends DataFlow::Configuration {
  SqlInjectionFlow() { this = "SqlInjectionFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatCall or
    exists(SqlStringAssignment sqlSource |
      source = sqlSource and
      not sqlSource.asExpr() instanceof StringLiteral
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(JpaQueryExecution query |
      sink.asExpr() = query.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral
  }
}

from SqlInjectionFlow flow, DataFlow::PathNode source, DataFlow::PathNode sink
where flow.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User input reaches JPA SQL execution without sanitization. $@ flows from here to $@.",
  source.getNode(), "Potential SQL injection source",
  sink.getNode(), "JPA query execution"
