/**
 * @id autoescape-disabled
 * @kind problem
 * @severity warning
 * @tags security
 * @precision high
 * @description Detected an element with disabled HTML escaping. If external data can reach this, 
 *   this is a cross-site scripting (XSS) vulnerability.
 */
import java
import semmle.code.xml.XMLElement
import semmle.code.regex.Regexp

from XMLElement element, RegexMatch match
where 
  match.getRegexpStr() = ".*escape.*?=.*?false.*" and
  element.getAttributeValue(match.getMatchedText()) != ""
select element,
  "Detected an element with disabled HTML escaping. If external data can reach this, this is a cross-site scripting (XSS) vulnerability.",
  element.getLocation(),
  "Disabled HTML escaping pattern found: " + match.getMatchedText()
