Rule Content:
/**
 * @name Vert.x SQL Injection
 * @description Detects formatted strings in SQL statements which could lead to SQL injection
 * @kind path-problem
 * @problem.severity warning
 * @id vertx-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class VertxSqlClient extends RefType {
  VertxSqlClient() {
    this.hasQualifiedName("io.vertx.sqlclient", "SqlClient")
  }
}

class StringFormatMethod extends Method {
  StringFormatMethod() {
    this.getDeclaringType().hasQualifiedName("java.lang", "String") and
    this.hasName("format")
  }
}

class PrepareStatementMethod extends Method {
  PrepareStatementMethod() {
    this.getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Connection") and
    this.hasName("prepareStatement")
  }
}

class VertxSqlQueryCall extends DataFlow::CallNode {
  VertxSqlQueryCall() {
    exists(Method m | 
      m.getDeclaringType() instanceof VertxSqlClient and
      (m.hasName("query") or m.hasName("preparedQuery") or m.hasName("prepare")) and
      this.getTarget() = m and
      this.getArgument(0).getType() instanceof StringType
    )
  }
}

class UnsafeSqlFormat extends DataFlow::Node {
  UnsafeSqlFormat() {
    exists(Call call |
      call.getTarget() instanceof StringFormatMethod and
      this.asExpr() = call
    )
  }
}

class UnsafeStringConcat extends DataFlow::Node {
  UnsafeStringConcat() {
    exists(Assignment assign |
      exists(AddExpr add | assign.getRValue() = add) and
      assign.getLValue().getType().hasName("String") and
      this.asExpr() = assign.getRValue()
    )
  }
}

class TaintTrackingConfig extends TaintTracking::Configuration {
  TaintTrackingConfig() { this = "VertxSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeSqlFormat or
    source instanceof UnsafeStringConcat
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof VertxSqlQueryCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getTarget() instanceof PrepareStatementMethod and
      sanitizer.asExpr() = call
    )
  }
}

from TaintTrackingConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink  
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization. Potential SQL injection vulnerability.",
  source, sink,
  "Untrusted data flows to SQL query here"
