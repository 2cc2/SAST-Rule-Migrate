/**
 * @name Vert.x SQL Injection
 * @description Detects formatted strings in SQL statements which could lead to SQL injection
 * @kind path-problem
 * @problem.severity warning
 * @id vertx-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class VertxSqlClient extends RefType {
  VertxSqlClient() {
    this.hasQualifiedName("io.vertx.sqlclient", "SqlClient")
  }
}

class StringFormatCall extends DataFlow::Node {
  StringFormatCall() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma
    )
  }
}

class StringConcatAssignment extends DataFlow::Node {
  StringConcatAssignment() {
    exists(AddExpr add |
      add.getLeftOperand().getType().hasName("java.lang.String") and
      this.asExpr() = add
    )
  }
}

class VertxSqlQuerySink extends DataFlow::Node {
  VertxSqlQuerySink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType() instanceof VertxSqlClient and
      (ma.getMethod().hasName("query") or 
       ma.getMethod().hasName("preparedQuery") or 
       ma.getMethod().hasName("prepare")) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("prepareStatement") and
      exists(ma.getMethod().getDeclaringType().getASupertype*() | 
        this.hasQualifiedName("java.sql", "Connection")
      ) and
      this.asExpr() = ma
    )
  }
}

class VertxSqlInjectionConfig extends TaintTracking::Configuration {
  VertxSqlInjectionConfig() { this = "VertxSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatCall or
    source instanceof StringConcatAssignment
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof VertxSqlQuerySink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof PreparedStatementSanitizer
  }
}

from VertxSqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization. Potential SQL injection vulnerability.",
  source, sink,
  "Untrusted data flows to SQL query here"
