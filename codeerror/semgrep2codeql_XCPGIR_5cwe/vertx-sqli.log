Rule Content:
/**
 * @name Vert.x SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/vertx-sqli
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class StringFormatSource extends DataFlow::Expr {
  StringFormatSource() {
    exists(Method m | 
      m.hasQualifiedName("java.lang", "String", "format") and
      this.asExpr() = m.getACall().getArgument(0)
    )
  }
}

class UnsafeStringConcatSource extends DataFlow::Expr {
  UnsafeStringConcatSource() {
    exists(MethodAccess ma |
      not ma.getArgument(0).toString().matches("%.+\"\\s*\\+\\s*\".+%") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class VertxSqlSink extends DataFlow::Expr {
  VertxSqlSink() {
    exists(Method m |
      m.getName().matches("query|preparedQuery|prepare") and
      m.getDeclaringType().getASupertype*().getQualifiedName().matches("io.vertx.%") and
      this.asExpr() = m.getACall().getArgument(0)
    )
  }
}

class SqlSanitizer extends DataFlow::Node {
  SqlSanitizer() {
    exists(Method m |
      m.hasQualifiedName("java.sql", "Connection", "prepareStatement") and
      this.asExpr() = m.getACall()
    )
  }
}

class VertxSqlInjectionConfig extends TaintTracking::Configuration {
  VertxSqlInjectionConfig() { this = "VertxSqlInjectionConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or source instanceof UnsafeStringConcatSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof VertxSqlSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SqlSanitizer
  }
}

from VertxSqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User input reaches SQL execution without sanitization"
