 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat

class VertxSqlClient extends RefType {
  VertxSqlClient() {
    this.hasQualifiedName("io.vertx.sqlclient", "SqlClient")
  }
}

class UnsafeStringFormatSource extends DataFlow::Node {
  UnsafeStringFormatSource() {
    exists(Method m | 
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = any(Expr e | e = any(Call c | c.getCallee() = m)).getAChildExpr()
    )
  }
}

class UnsafeStringConcatSource extends DataFlow::Node {
  UnsafeStringConcatSource() {
    exists(AddExpr add |
      add.getLeftOperand().getType().hasName("java.lang.String") and
      this.asExpr() = add
    )
  }
}

class VertxSqlQuerySink extends DataFlow::Node {
  VertxSqlQuerySink() {
    exists(Method m |
      m.getDeclaringType() instanceof VertxSqlClient and
      (m.hasName("query") or m.hasName("preparedQuery") or m.hasName("prepare")) and
      this.asExpr() = any(Call c | c.getCallee() = m).getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(Method m |
      m.hasName("prepareStatement") and
      m.getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = any(Call c | c.getCallee() = m)
    )
  }
}

class TaintTrackingConfig extends TaintTracking::Configuration {
  TaintTrackingConfig() { this = "VertxSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeStringFormatSource or
    source instanceof UnsafeStringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof VertxSqlQuerySink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof PreparedStatementSanitizer
  }
}

