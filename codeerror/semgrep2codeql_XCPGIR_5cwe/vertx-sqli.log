Rule Content:
/**
 * @name Vert.x SQL Injection
 * @description Detects formatted strings in SQL statements which could lead to SQL injection
 * @kind path-problem
 * @problem.severity warning
 * @id vertx-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat

class VertxSqlClient extends RefType {
  VertxSqlClient() {
    this.hasQualifiedName("io.vertx.sqlclient", "SqlClient")
  }
}

class VertxSqlQueryCall extends DataFlow::Node {
  VertxSqlQueryCall() {
    exists(Method m | 
      m.getDeclaringType() instanceof VertxSqlClient and
      (m.hasName("query") or m.hasName("preparedQuery") or m.hasName("prepare")) and
      this.asExpr() = any(Call c | c.getMethod() = m).getArgument(0)
    )
  }
}

class UnsafeSqlFormat extends DataFlow::Node {
  UnsafeSqlFormat() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "format" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma
    )
  }
}

class UnsafeStringConcat extends DataFlow::Node {
  UnsafeStringConcat() {
    exists(AddExpr add |
      add.getLeftOperand().getType().hasName("string") and
      this.asExpr() = add
    )
  }
}

class PreparedStatementCall extends DataFlow::Node {
  PreparedStatementCall() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma
    )
  }
}

class TaintTrackingConfig extends TaintTracking::Configuration {
  TaintTrackingConfig() { this = "VertxSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeSqlFormat or
    source instanceof UnsafeStringConcat
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof VertxSqlQueryCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementCall
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintTrackingConfig config
where config.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization. Potential SQL injection vulnerability.",
  source, sink,
  "Untrusted data flows to SQL query here"
