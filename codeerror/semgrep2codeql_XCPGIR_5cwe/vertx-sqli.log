/**
 * @name Vert.x SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables 
 *              in the SQL statement are not properly sanitized. Use prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/vertx-sqli
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class VertxSqlInjectionConfig extends TaintTracking::Configuration {
  VertxSqlInjectionConfig() { this = "VertxSqlInjectionConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.lang", "String", "format") or
      not ma.getArgument(0).getStringValue().matches("%...\"\\s*\\+\\s*\"...%")
    |
      source.asExpr() = ma.getArgument(0)
    )
  }
  
  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("query|preparedQuery|prepare") and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("io.vertx", "SqlClient")
    |
      sink.asExpr() = ma.getArgument(0)
    )
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection")
    |
      sanitizer.asExpr() = ma
    )
  }
}

