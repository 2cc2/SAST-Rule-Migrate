/**
 * @name Seam Log Injection
 * @description Seam Logging API supports expression language which can lead to 
 *              unwanted code execution when dynamic values are used in log messages.
 * @kind path-problem
 * @problem.severity error
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.StringTemplate
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class SeamLogCall extends Call {
  SeamLogCall() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      (m.getName() = "debug" or 
       m.getName() = "error" or 
       m.getName() = "fatal" or 
       m.getName() = "info" or 
       m.getName() = "trace" or 
       m.getName() = "warn") and
      this.getCallee() = m
    )
  }
}

class DynamicStringConcatExpr extends Expr {
  DynamicStringConcatExpr() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("concat") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      (this = ma.getReceiver() and not this.isConstant())
    )
  }
}

class LogInjectionConfig extends TaintTracking::Configuration {
  LogInjectionConfig() { this = "SeamLogInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof DynamicStringConcatExpr
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SeamLogCall slc | sink.asExpr() = slc.getArgument(0))
  }
}

from LogInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential Seam Log Injection detected. User-controlled data flows into log message " +
  "which supports expression language evaluation.",
  source.getNode(), source.toString(),
  sink.getNode(), sink.toString()
