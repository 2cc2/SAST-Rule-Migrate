/**
 * @name Seam Log Injection
 * @description Detects expression language injection in JBoss Seam logging API
 * @kind path-problem
 * @problem.severity error
 * @id seam-log-injection
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class SeamLogInjectionConfig extends TaintTracking::Configuration {
  SeamLogInjectionConfig() { this = "SeamLogInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, MethodAccess ma |
      m.hasName(["debug", "error", "fatal", "info", "trace", "warn"]) and
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      ma.getMethod() = m and
      source.asExpr() = ma.getArgument(0) and
      not ma.getArgument(0).(Literal).hasText()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, MethodAccess ma |
      m.hasName(["debug", "error", "fatal", "info", "trace", "warn"]) and
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      ma.getMethod() = m and
      sink.asExpr() = ma.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SeamLogInjectionConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(),
  "Potential Seam log expression language injection from $@ to $@.", 
  source.getNode(), sink.getNode(),
  "Unsanitized user input in JBoss Seam logging API that may lead to code execution."
