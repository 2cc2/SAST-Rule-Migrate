Rule Content:
/**
 * @name Seam Log Injection
 * @description Detects expression language injection in JBoss Seam logging API
 * @kind path-problem
 * @problem.severity error
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class SeamLogConfig extends TaintTracking::Configuration {
  SeamLogConfig() { this = "SeamLogConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Call ma |
      m.hasName(["debug", "error", "fatal", "info", "trace", "warn"]) and
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      ma.getCallee() = m and
      source.asExpr() = ma.getArgument(0) and
      not exists(ma.getArgument(0).getStringValue())
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Call ma |
      m.hasName(["debug", "error", "fatal", "info", "trace", "warn"]) and
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      ma.getCallee() = m and
      sink.asExpr() = ma.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SeamLogConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(),
  "Potential Seam log expression language injection from $@.",
  source.getNode(), sink.getNode(),
  "Unsanitized user input in JBoss Seam logging API that may lead to code execution."
