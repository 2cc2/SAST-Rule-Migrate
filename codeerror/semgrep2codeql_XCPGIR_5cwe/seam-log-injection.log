/**
 * @name Seam Log Injection
 * @description Detects expression language injection in JBoss Seam logging API
 * @kind problem
 * @problem.severity error
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Seam

class SeamLogInjectionConfig extends TaintTracking::Configuration {
  SeamLogInjectionConfig() { this = "SeamLogInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["debug", "error", "fatal", "info", "trace", "warn"]) and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      source.asExpr() = ma.getArgument(0) and
      not ma.getArgument(0).isConstant()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["debug", "error", "fatal", "info", "trace", "warn"]) and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      sink.asExpr() = ma.getReceiver()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SeamLogInjectionConfig config
where config.hasFlowPath(source, sink)
select sink, 
  "Potential Seam log expression language injection from $@ to $@.", source, sink,
  "Unsanitized user input in JBoss Seam logging API that may lead to code execution.",
  source.getNode(), "This input originates from here"
