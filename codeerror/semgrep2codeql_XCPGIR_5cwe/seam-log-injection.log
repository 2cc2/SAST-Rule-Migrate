/**
 * @name Seam Log Injection
 * @description Seam Logging API supports expression language which can lead to unwanted code execution
 *              when dynamic values are used in log messages.
 * @kind problem
 * @problem.severity error
 * @id java/seam-log-injection
 * @precision high
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.seam.SeamLogging

class SeamLogCall extends MethodAccess {
  SeamLogCall() {
    exists(Method m |
      m.getDeclaringType().getQualifiedName() = "org.jboss.seam.log.Log" and
      m.getName() matches "debug|error|fatal|info|trace|warn" and
      this.getMethod() = m
    )
  }
}

class DynamicStringConcat extends MethodAccess {
  DynamicStringConcat() {
    this.getMethod().getName() = "concat" and
    this.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
    // Match any receiver value (dynamic)
    exists(Expr receiver | receiver = this.getQualifier() | not receiver.isConstant())
  }
}

class LogInjectionConfig extends TaintTracking::Configuration {
  LogInjectionConfig() { this = "SeamLogInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() = any(DynamicStringConcat dsc).getAnArgument()
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SeamLogCall slc |
      sink.asExpr() = slc.getArgument(0)
    )
  }
}

from LogInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential Seam Log Injection detected. User-controlled data flows into log message " +
  "which supports expression language evaluation.", 
  sink.getNode(),
  "User input comes from here",
  source.getNode(),
  "Flow through string concatenation"
