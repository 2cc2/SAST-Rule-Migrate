Rule Content:
/**
 * @name Command injection in ProcessBuilder
 * @description Detects potentially unsafe ProcessBuilder initialization or command calls
 * where user input could lead to command injection.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.8
 * @precision high
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormatChecking

class ProcessBuilderInjectionConfig extends TaintTracking::Configuration {
  ProcessBuilderInjectionConfig() { this = "ProcessBuilderInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getParameter") and
      source.asExpr() = ma.getAnArgument()
    )
    or
    exists(LocalVariableDecl lvd |
      not lvd.getInitializer().exists() and
      source.asVariable() = lvd.getVariable()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (
        // ProcessBuilder constructor
        (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        ma.getMethod().isConstructor() and
        sink.asExpr() = ma.getArgument(0))
        or
        // ProcessBuilder.command() method
        (ma.getMethod().hasName("command") and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        sink.asExpr() = ma.getArgument(0))
      )
      and
      not isSafeArgument(ma.getArgument(0))
    )
  }

  predicate isSafeArgument(Expr arg) {
    exists(StringLiteral sl | sl = arg)
    or
    exists(ArrayCreationInit aci |
      aci = arg and
      forall(Expr element | element = aci.getAnInit() | element instanceof StringLiteral)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral sl | sl = node.asExpr())
    or
    exists(ArrayCreationInit aci |
      aci = node.asExpr() and
      forall(Expr element | element = aci.getAnInit() | element instanceof StringLiteral)
    )
  }

  override predicate isBarrier(DataFlow::Node node) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("exit") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "System") and
      node.asExpr() = ma
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ProcessBuilderInjectionConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Command injection vulnerability detected in ProcessBuilder usage"
