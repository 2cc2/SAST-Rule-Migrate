/**
 * @name Command injection via ProcessBuilder
 * @description Detects user-controlled input flowing into ProcessBuilder calls,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow

class ProcessBuilderConfig extends TaintTracking::Configuration {
  ProcessBuilderConfig() { 
    this = "ProcessBuilder command injection" 
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Callable c | 
      m.hasName(["getParameter", "getHeader", "getQueryString"]) and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      c.getSourceDeclaration() = m and
      source.asExpr() = any(Call call | call.getCallee() = c)
    )
    or
    exists(Expr e |
      not e instanceof StringLiteral and
      not isSanitized(e) and
      source.asExpr() = e
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // ProcessBuilder constructor
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = cc.getArgument(0)
    )
    or
    // ProcessBuilder.command() method
    exists(MethodAccess ma |
      ma.getMethod().hasName("command") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = ma.getArgument(0)
    )
    or
    // Shell command pattern detection
    exists(MethodAccess ma |
      ma.getMethod().hasName("command") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getArgument(0).toString().regexpMatch(".*(sh|bash|ksh|csh|tcsh|zsh|cmd).*") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  predicate isSanitized(Expr e) {
    e instanceof StringLiteral
    or
    exists(ArrayCreation ac |
      ac = e and
      forall(Expr init | ac.getAnInitializer() = init | init instanceof StringLiteral)
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("asList") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.util", "Arrays") and
      forall(Expr arg | ma.getAnArgument() = arg | arg instanceof StringLiteral)
    )
  }
}

