Rule Content:
/**
 * @name Command injection via ProcessBuilder
 * @description Detects user-controlled input flowing into ProcessBuilder constructor or command() method,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.Concepts

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, Method m |
      (ma.getMethod() = m and m.hasName("getParameter") and m.getDeclaringType().hasName(["HttpServletRequest"]))
      or
      exists(Parameter p | source.asParameter() = p and not p.getAnAssignedValue().(Literal).getText().regexpMatch("\"[^\"]+\""))
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc, Constructor c |
      cc.getConstructor() = c and
      c.getDeclaringType().hasName("ProcessBuilder") and
      sink.asExpr() = cc.getArgument(0)
    )
    or
    exists(MethodAccess ma, Method m |
      ma.getMethod() = m and
      m.hasName("command") and
      m.getDeclaringType().hasName("ProcessBuilder") and
      sink.asExpr() = ma.getArgument(0)
    )
    or
    exists(ConstructorCall cc |
      cc.getConstructor().getDeclaringType().hasName("ProcessBuilder") and
      (
        (cc.getArgument(0).getConstantValue().toString() = "cmd" and cc.getArgument(1).getConstantValue().toString() = "/c")
        or
        cc.getArgument(0).getConstantValue().toString().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$") and
        cc.getArgument(1).getConstantValue().toString() = "-c"
      ) and
      sink.asExpr() = cc.getArgument(2)
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasName("ProcessBuilder") and
      ma.getMethod().hasName("command") and
      (
        (ma.getArgument(0).getConstantValue().toString() = "cmd" and ma.getArgument(1).getConstantValue().toString() = "/c")
        or
        ma.getArgument(0).getConstantValue().toString().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$") and
        ma.getArgument(1).getConstantValue().toString() = "-c"
      ) and
      sink.asExpr() = ma.getArgument(2)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node.getType() instanceof PrimitiveType
    or
    exists(Literal l | node.asExpr() = l and l.getText().regexpMatch("\"[^\"]+\""))
  }
}

from CommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User input reaches ProcessBuilder execution without sanitization. Command injection may occur."
