Rule Content:
/**
 * @name Command injection in ProcessBuilder
 * @description Detects potentially unsafe ProcessBuilder initialization or command calls
 * where user input could lead to command injection.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.8
 * @precision high
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.security.CommandInjection

class ProcessBuilderUsage extends DataFlow::Configuration {
  ProcessBuilderUsage() { this = "ProcessBuilderCommandInjection" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method method, Call call |
      method.hasName("getParameter") and
      call.getMethod() = method and
      source.asExpr() = call.getAnArgument()
    )
    or
    exists(LocalVariableDecl lvd | not lvd.getInit().exists() | source.asVariable() = lvd.getVariable())
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = cc.getAnArgument()
    )
    or
    exists(Method method, MethodAccess ma |
      method.hasName("command") and
      method.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getMethod() = method and
      sink.asExpr() = ma.getAnArgument()
    )
    and not isSafeArgument(sink.asExpr())
  }

  predicate isSafeArgument(Expr arg) {
    exists(StringLiteral sl | sl = arg)
    or
    exists(ArrayInit ai |
      ai = arg and
      forall(Expr e | e = ai.getAnInit() | e instanceof StringLiteral)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral sl | node.asExpr() = sl)
    or
    exists(ArrayInit ai |
      node.asExpr() = ai and
      forall(Expr e | e = ai.getAnInit() | e instanceof StringLiteral)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ProcessBuilderUsage config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Command injection vulnerability detected in ProcessBuilder usage"
