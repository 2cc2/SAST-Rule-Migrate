scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell, cmd] }

sources:
  - id: USER_INPUT
    match:
      node: PARAM | LOCAL
      where:
        - op: neq
          left: "$init"
          right: true
  - id: STRING_CONSTRUCTOR
