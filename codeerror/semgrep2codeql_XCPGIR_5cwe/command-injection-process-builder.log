Rule Content:
/**
 * @name Command Injection via ProcessBuilder
 * @description Detects potential command injection vulnerabilities when tainted input is passed to ProcessBuilder
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ProcessBuilderConfig extends TaintTracking::Configuration {
  ProcessBuilderConfig() { this = "ProcessBuilderCommandInjection" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, Method m, Parameter p |
      (ma.getMethod() = m and m.getAParameter() = p and
      (source.asParameter() = p or source.asLocal() = p.getVariable() or source.asField() = ma.getQualifier()))
      and not source.asExpr().(Literal).getValue() = ""
    )
    or
    exists(Field f, FieldAccess fa |
      fa.getField() = f and source.asField() = f and
      not source.asExpr().(Literal).getValue() = ""
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc, Constructor c |
      cc.getConstructor() = c and
      c.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      (sink.asExpr() = cc.getAnArgument() or sink.asExpr() = cc.getAnArgument())
    )
    or
    exists(MethodCall mc, Method m |
      mc.getMethod() = m and
      m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      m.getName() = "command" and
      sink.asExpr() = mc.getAnArgument()
    )
    or
    exists(ConstructorCall cc, Constructor c, string shell |
      cc.getConstructor() = c and
      c.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      cc.getArgument(0).toString() = shell and
      (shell = "sh" or shell = "bash" or shell = "ksh" or shell = "csh" or 
       shell = "tcsh" or shell = "zsh" or shell = "cmd") and
      (cc.getArgument(1).toString() = "-c" or cc.getArgument(1).toString() = "/c") and
      sink.asExpr() = cc.getAnArgument()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal lit |
      sanitizer.asExpr() = lit and
      lit.getValue().regexpMatch("^\"[^\"]+u003d[^\"]*\"$")
    )
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier.asExpr() instanceof ReturnStmt
  }
}

