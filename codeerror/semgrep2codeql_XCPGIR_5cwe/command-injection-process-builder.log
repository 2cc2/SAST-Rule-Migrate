Rule Content:
/**
 * @name Command Injection via ProcessBuilder
 * @description Detects potential command injection vulnerabilities when tainted input is passed to ProcessBuilder
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ProcessBuilderConfig extends TaintTracking::Configuration {
  ProcessBuilderConfig() { this = "ProcessBuilderCommandInjection" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, Method m, Parameter p |
      ma.getMethod() = m and 
      m.getAParameter() = p and
      (
        source.asParameter() = p or
        source.asExpr() = p.getVariable().getAnAccess()
      )
      and 
      not exists(source.asExpr().(Literal))
    )
    or
    exists(Field f |
      source.asExpr() = f.getAnAccess() and
      not exists(source.asExpr().(Literal))
    )
    or
    exists(LocalVariableDecl lvd |
      source.asExpr() = lvd.getVariable().getAnAccess() and
      not exists(source.asExpr().(Literal))
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructor().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = cc.getAnArgument()
    )
    or
    exists(MethodCall mc |
      mc.getMethod().hasName("command") and
      mc.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = mc.getAnArgument()
    )
    or
    exists(ConstructorCall cc, string shellCmd |
      cc.getConstructor().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      cc.getArgument(0).toString() = shellCmd and
      shellCmd in ["sh", "bash", "ksh", "csh", "tcsh", "zsh", "cmd"] and
      (cc.getArgument(1).toString() = "-c" or cc.getArgument(1).toString() = "/c") and
      sink.asExpr() = cc.getAnArgument()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal lit |
      sanitizer.asExpr() = lit and
      lit.getValue().regexpMatch("^\"[^\"]+u003d[^\"]*\"$")
    )
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    exists(ReturnStmt ret | barrier.asExpr() = ret)
  }
}

from ProcessBuilderConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential command injection via ProcessBuilder"
