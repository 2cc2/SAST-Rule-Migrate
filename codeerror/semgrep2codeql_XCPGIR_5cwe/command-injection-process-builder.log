Rule Content:
/**
 * @name Command Injection in ProcessBuilder
 * @description Detects when user input reaches ProcessBuilder execution without sanitization,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ProcessBuilderCommandInjectionConfig extends TaintTracking::Configuration {
  ProcessBuilderCommandInjectionConfig() { this = "ProcessBuilderCommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    // User input sources including parameters, fields and local variables
    source instanceof RemoteFlowSource
  }

  override predicate isSink(DataFlow::Node sink) {
    // Sink 1: ProcessBuilder constructor with potentially unsafe arguments
    exists(MethodAccess ma |
      ma.getMethod().getName() = "<init>" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getArgument(0) = sink.asExpr() and
      not ma.getArgument(0).(StringLiteral).getValue().regexpMatch("\".*\"")
    )
    or
    // Sink 2: ProcessBuilder.command() method with potentially unsafe arguments
    exists(MethodAccess ma |
      ma.getMethod().getName() = "command" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getArgument(0) = sink.asExpr() and
      not ma.getArgument(0).(StringLiteral).getValue().regexpMatch("\".*\"")
    )
    or
    // Sink 3: Shell command execution pattern ("cmd", "/c") with unsafe arguments
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "<init>" or ma.getMethod().getName() = "command") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      exists(ma.getArgument(0).(StringLiteral) arg0, ma.getArgument(1).(StringLiteral) arg1 |
        arg0.getValue() = "cmd" and
        arg1.getValue() = "/c" and
        ma.getArgument(2) = sink.asExpr()
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    // String literals are considered safe
    node.asExpr() instanceof StringLiteral
  }
}

from ProcessBuilderCommandInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User input reaches ProcessBuilder execution without sanitization. $@.",
  source.getNode(), "User input flows here",
  sink.getNode(), "Potentially unsafe ProcessBuilder call"
