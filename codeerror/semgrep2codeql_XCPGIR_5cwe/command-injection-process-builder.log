/**
 * @name Command Injection in ProcessBuilder
 * @description Detects when user input reaches ProcessBuilder execution without sanitization,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ProcessBuilderCommandInjectionConfig extends TaintTracking::Configuration {
  ProcessBuilderCommandInjectionConfig() { this = "ProcessBuilderCommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p) or
    exists(Field f | source.asField() = f) or
    exists(LocalVariableDecl v | source.asLocalVar() = v)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Expr arg |
      (m.getName() = ["<init>", "command"] and
      m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      arg = sink.asExpr() and
      (
        // Sink 1: Non-literal string argument to ProcessBuilder
        (arg = m.getACall().getArgument(0) and not arg instanceof StringLiteral) or
        // Sink 2: Shell command pattern ("cmd", "/c") with third argument being user input
        exists(m.getACall().getArgument(1) arg1 |
          m.getACall().getArgument(0).(StringLiteral).getValue() = "cmd" and
          arg1.(StringLiteral).getValue() = "/c" and
          arg = m.getACall().getArgument(2)
        )
      ))
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node.asExpr() instanceof StringLiteral
  }
}

