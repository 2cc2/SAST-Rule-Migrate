import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Literal l |
      l.getType().hasName("String") and
      l.getStringValue() != "..." and
      this.asExpr() = l and
      not l.getEnclosingCallable().getDeclaringType().hasQualifiedName("java.lang", "Arrays")
    )
    or
    exists(Parameter p | 
      p.getType().hasName("String") and
      this.asParameter() = p
    )
  }
}

class ProcessBuilderInitializerSink extends DataFlow::Node {
  ProcessBuilderInitializerSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("<init>") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class ProcessBuilderCommandSink extends DataFlow::Node {
  ProcessBuilderCommandSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("command") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class CmdInjectionConfig extends TaintTracking::Configuration {
  CmdInjectionConfig() { this = "CommandInjectionProcessBuilder" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ProcessBuilderInitializerSink or
    sink instanceof ProcessBuilderCommandSink
  }
}

from DataFlow::Node source, DataFlow::Node sink, CmdInjectionConfig config
where config.hasFlow(source, sink)
select sink, "Potentially unsafe command execution from user-controlled source $@", source,
