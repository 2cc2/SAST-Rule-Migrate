Rule Content:
/**
 * @name Command Injection in ProcessBuilder
 * @id command-injection-process-builder
 * @kind path-problem
 * @problem.severity error
 * @description Detects cases where user-controlled input is passed to ProcessBuilder
 *              without proper sanitization, potentially leading to command injection.
 * @kind path-problem
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class ProcessBuilderConstructor extends DataFlow::CallNode {
  ProcessBuilderConstructor() {
    exists(Method m | 
      m = this.getTarget() and
      m.hasName("<init>") and
      m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
    )
  }
}

class ProcessBuilderCommand extends DataFlow::CallNode {
  ProcessBuilderCommand() {
    exists(Method m | 
      m = this.getTarget() and
      m.hasName("command") and
      m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(PrimaryExpr pe | 
      pe.getType().hasName("String") and
      not pe.getStringValue().regexpMatch("\\.\\.\\.") and
      exists(Method m |
        not m.getQualifiedName() = "java.lang.Arrays.asList" and
        pe.(Literal).getEnclosingCallable() = m
      ) and
      this.asExpr() = pe
    ) or
    exists(Parameter p | p.getType().hasName("String"))
  }
}

class UnsafeProcessBuilderSink extends DataFlow::Node {
  UnsafeProcessBuilderSink() {
    exists(ProcessBuilderConstructor pb | pb.getArgument(0) = this.asExpr()) or
    exists(ProcessBuilderCommand pb | pb.getArgument(0) = this.asExpr())
  }
}

class TaintTrackingConfig extends TaintTracking::Configuration {
  TaintTrackingConfig() { this = "CommandInjectionProcessBuilder" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeProcessBuilderSink
  }
}

from DataFlow::Node source, DataFlow::Node sink, TaintTrackingConfig config
where config.hasFlow(source, sink)
select sink, "Potentially unsafe command execution from user-controlled source", source, 
  "This ProcessBuilder command may include user-controlled input, which could lead to command injection."
