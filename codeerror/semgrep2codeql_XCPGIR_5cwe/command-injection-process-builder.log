/**
 * @name Command injection via ProcessBuilder
 * @description Detects user-controlled input flowing into ProcessBuilder constructor or command() method,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking2
import semmle.code.java.frameworks.Servlets

class CommandInjectionConfig extends TaintTracking2::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource
    or
    exists(Parameter p | 
      source.asParameter() = p and
      not exists(p.getAnAssignedValue() | 
        this.isSanitizer(_)
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructor().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      (
        sink.asExpr() = cc.getArgument(0)
        or
        (
          (cc.getArgument(0).getStringValue() = "cmd" and cc.getArgument(1).getStringValue() = "/c")
          or
          (cc.getArgument(0).getStringValue().matches("^(sh|bash|ksh|csh|tcsh|zsh)$") and
          cc.getArgument(1).getStringValue() = "-c")
        ) and
        sink.asExpr() = cc.getArgument(2)
      )
    )
    or
    exists(MethodCall mc |
      mc.getMethod().getName() = "command" and
      mc.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      (
        sink.asExpr() = mc.getArgument(0)
        or
        (
          (mc.getArgument(0).getStringValue() = "cmd" and mc.getArgument(1).getStringValue() = "/c")
          or
          (mc.getArgument(0).getStringValue().matches("^(sh|bash|ksh|csh|tcsh|zsh)$") and
          mc.getArgument(1).getStringValue() = "-c")
        ) and
        sink.asExpr() = mc.getArgument(2)
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Expr e | 
      node.asExpr() = e and 
      e instanceof StringLiteral and
      e.getStringValue().matches("\"[^\"]+\"")
    )
  }
}

