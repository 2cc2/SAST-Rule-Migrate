Rule Content:
/**
 * @name Command injection via ProcessBuilder
 * @description Detects user-controlled input flowing into ProcessBuilder constructor or command() method,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import DataFlow::PathGraph

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource or
    exists(Parameter p | source.asParameter() = p and not exists(p.getAnAssignedValue()))
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructor().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      (
        sink.asExpr() = cc.getArgument(0)
        or
        (
          (cc.getArgument(0)._toStringConstantValue() = "cmd" and cc.getArgument(1)._toStringConstantValue() = "/c")
          or
          cc.getArgument(0)._toStringConstantValue().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$") and
          cc.getArgument(1)._toStringConstantValue() = "-c"
        ) and
        sink.asExpr() = cc.getArgument(2)
      )
    )
    or
    exists(MethodCall mc |
      mc.getMethod().getName() = "command" and
      mc.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      (
        sink.asExpr() = mc.getArgument(0)
        or
        (
          (mc.getArgument(0)._toStringConstantValue() = "cmd" and mc.getArgument(1)._toStringConstantValue() = "/c")
          or
          mc.getArgument(0)._toStringConstantValue().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$") and
          mc.getArgument(1)._toStringConstantValue() = "-c"
        ) and
        sink.asExpr() = mc.getArgument(2)
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof Literal and node.toString().regexpMatch("\"[^\"]+\"")
  }
}

from CommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "User input reaches ProcessBuilder execution without sanitization. Command injection may occur."
