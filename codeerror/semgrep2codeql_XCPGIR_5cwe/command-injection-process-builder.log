/**
 * @name Command injection in ProcessBuilder call
 * @description Detects cases where user-controlled input reaches ProcessBuilder constructor or command method
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow

class ProcessBuilderCommandInjectionConfig extends TaintTracking::Configuration {
  ProcessBuilderCommandInjectionConfig() { this = "ProcessBuilderCommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method method, MethodAccess ma |
      method.hasName("getParameter") and
      ma.getMethod() = method and
      source.asExpr() = ma
    )
    or
    exists(Parameter p | source.asParameter() = p)
    or
    exists(Variable v, Expr init |
      source.asExpr() = v.getAnAccess() and
      init = v.getInitializer() and
      not exists(init.getStringValue())
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = cc.getArgument(0)
    )
    or
    exists(Method method, Call call |
      method.hasName("command") and
      method.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      call.getCallee() = method and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sanitizer.asExpr() = sl)
  }
}

from ProcessBuilderCommandInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink,
  "Command injection detected in ProcessBuilder call. User-controlled input reaches command execution.",
  source, "User input originates here", source.getNode().toString(),
  sink, "ProcessBuilder command execution", sink.getNode().toString()
