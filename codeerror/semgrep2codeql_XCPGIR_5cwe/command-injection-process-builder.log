Rule Content:
/**
 * @name Command injection via ProcessBuilder
 * @description Detects user-controlled input flowing into ProcessBuilder commands,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class ProcessBuilderCommandInjection extends TaintTracking::Configuration {
  ProcessBuilderCommandInjection() {
    this = "ProcessBuilder command injection"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod() instanceof HttpServletRequestGetParameterMethod or
      ma.getMethod() instanceof HttpServletRequestGetHeaderMethod or
      ma.getMethod() instanceof HttpServletRequestGetQueryStringMethod or
      ma.getMethod() instanceof HttpServletRequestGetParameterValuesMethod
      and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // Detect ProcessBuilder constructor with string argument
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      cc.getArgument(0) = sink.asExpr()
    )
    or
    // Detect ProcessBuilder.command() calls
    exists(MethodAccess ma |
      ma.getMethod().hasName("command") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getArgument(0) = sink.asExpr()
    )
    or
    // Detect shell command patterns
    exists(Expr e |
      e = sink.asExpr() and
      (
        exists(MethodAccess ma |
          (ma.getMethod().hasName("command") or
           ma instanceof ConstructorCall) and
          ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
          (
            e.toString().matches("%sh%") or
            e.toString().matches("%bash%") or
            e.toString().matches("%cmd%") or
            e.toString().matches("%/c%") or
            e.toString().matches("%-c%")
          )
        )
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Expr e |
      e = sanitizer.asExpr() and
      (
        exists(StringLiteral s | s = e) or
        exists(ArrayCreation ac |
          ac = e and
          forall(Expr elem | ac.getAnInitializer().getAChild() = elem | elem instanceof StringLiteral)
        ) or
        exists(MethodAccess ma |
          ma.getMethod().hasName("asList") and
          ma.getMethod().getDeclaringType().hasQualifiedName("java.util", "Arrays") and
          forall(Expr arg | ma.getAnArgument() = arg | arg instanceof StringLiteral)
        )
      )
    )
  }
}

