Rule Content:
/**
 * @name Command injection in ProcessBuilder call
 * @description Detects cases where user-controlled input reaches ProcessBuilder constructor or command method
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import DataFlow::PathGraph

class ProcessBuilderCommandInjectionConfig extends TaintTracking::Configuration {
  ProcessBuilderCommandInjectionConfig() { this = "ProcessBuilderCommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma | 
      ma.getMethod().hasName("getParameter") and
      source.asExpr() = ma.getAnArgument()
    )
    or
    exists(Parameter p | source.asParameter() = p)
    or
    exists(Variable v, Expr e |
      source.asExpr() = v.getAnAccess() and
      e = v.getInitializer() and
      not e.isConstant()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc | 
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = cc.getArgument(0)
    )
    or
    exists(Method m |
      m.hasName("command") and
      m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = m.getACall().getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr().(StringLiteral).hasValue()
  }
}

from ProcessBuilderCommandInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Command injection detected in ProcessBuilder call. User-controlled input reaches command execution.",
  source, "User input originates here", source.getNode().getLocation(),
  sink, "ProcessBuilder command execution", sink.getNode().getLocation()
