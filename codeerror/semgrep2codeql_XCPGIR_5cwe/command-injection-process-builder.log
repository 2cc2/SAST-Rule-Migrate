      node: CALL
      api: { signature: ["String(...)"] }

sinks:
  - id: PROCESS_BUILDER_INIT
    match:
      node: CALL
      api: { type: java.lang.ProcessBuilder, method: "<init>" }
      arg_index: 0
  - id: PROCESS_BUILDER_COMMAND
    match:
      node: CALL
      api: { type: java.lang.ProcessBuilder, method: command }
      arg_index: 0
  - id: SHELL_COMMAND
    match:
      node: CALL
      api: { type: java.lang.ProcessBuilder, method: "*" }
      where:
        - op: regex
          left: arg[0].value
          right: "(sh|bash|ksh|csh|tcsh|zsh|cmd)"
        - op: regex
          left: arg[1].value
          right: "(-c|/c)"

sanitizers:
  - id: SAFE_STRING_LITERAL
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "^\"[^\"]*\"$"
    effect: neutralize
  - id: SAFE_ARRAY_LITERAL
    match:
      node: CALL
      api: { signature: ["Arrays.asList(...)", "new String[]{...}"] }
      where:
        - op: regex
          left: arg[*].value
          right: "^\"[^\"]*\"$"

barriers:
  - id: SYSTEM_EXIT
    match: { node: CALL, api: { method: "System.exit" } }
    effect: stop

propagations:
  - id: METHOD_PARAM_PROP
    edge: param->arg
    kind: taint
  - id: ASSIGNMENT_PROP
    edge: assign->value
    kind: taint
  - id: RETURN_PROP
    edge: return->call
    kind: taint

flows:
  - source: USER_INPUT
    sink: PROCESS_BUILDER_INIT
    through: [METHOD_PARAM_PROP*, ASSIGNMENT_PROP*]
    constraints:
      path:
        must_not: [ { node: SAFE_STRING_LITERAL }, { node: SAFE_ARRAY_LITERAL } ]
  - source: USER_INPUT
    sink: PROCESS_BUILDER_COMMAND
    through: [METHOD_PARAM_PROP*, ASSIGNMENT_PROP*]
    constraints:
