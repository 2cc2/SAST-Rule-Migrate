xcpgir_version: "1.0"
rule:
  id: "command-injection-process-builder"
  kind: taint
  severity: ERROR
  message: "A formatted or concatenated string was detected as input to a ProcessBuilder call. This is dangerous if a variable is controlled by user input and could result in a command injection."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: USER_INPUT
    match:
      node: PARAM | LOCAL | FIELD
      where:
        - op: neq
          left: value
          right: ""
  
sinks:
  - id: PROCESS_BUILDER_INIT
    match:
      node: CALL
      api: { type: java.lang.ProcessBuilder, method: <init> }
      arg_index: 0
  - id: PROCESS_BUILDER_CMD
    match:
      node: CALL
      api: { type: java.lang.ProcessBuilder, method: command }
      arg_index: 0
  - id: SHELL_PROCESS_BUILDER
    match:
      node: CALL
      api: { type: java.lang.ProcessBuilder, method: <init> | command }
      where:
        - op: regex
          left: arg[0].value
          right: "^(sh|bash|ksh|csh|tcsh|zsh)$"
        - op: eq
          left: arg[1].value
          right: "-c"
  - id: CMD_PROCESS_BUILDER
    match:
      node: CALL
      api: { type: java.lang.ProcessBuilder, method: <init> | command }
      where:
        - op: eq
          left: arg[0].value
          right: "cmd"
        - op: eq
          left: arg[1].value
          right: "/c"

sanitizers:
  - id: SAFE_STRING_LITERAL
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "\"[^\"]+\""
    effect: neutralize

barriers:
  - id: RETURN_STOP
    match: { node: RETURN }
    effect: stop

propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
  - id: ASSIGN_PROPAGATE
    edge: assignment
    kind: taint

flows:
  - source: USER_INPUT
    sink: PROCESS_BUILDER_INIT
    through: [ARG_TO_PARAM*, ASSIGN_PROPAGATE*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(\"[^\"]+\")" } ]
        
  - source: USER_INPUT
    sink: PROCESS_BUILDER_CMD
    through: [ARG_TO_PARAM*, ASSIGN_PROPAGATE*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(\"[^\"]+\")" } ]
        
  - source: USER_INPUT
    sink: SHELL_PROCESS_BUILDER
    through: [ARG_TO_PARAM*, ASSIGN_PROPAGATE*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(\"[^\"]+\")" } ]
        
  - source: USER_INPUT
    sink: CMD_PROCESS_BUILDER
    through: [ARG_TO_PARAM*, ASSIGN_PROPAGATE*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(\"[^\"]+\")" } ]

report:
  message: "User input reaches ProcessBuilder execution without sanitization"
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "new ProcessBuilder(userControlledInput);"
    - "pb.command(userControlledInput);"
    - "new ProcessBuilder(\"bash\", \"-c\", userControlledInput);"
  negative:
    - "new ProcessBuilder(\"safe_command\");"
    - "pb.command(\"fixed_command\");"
