Rule Content:
/**
 * @name Command injection via ProcessBuilder
 * @description Detects user-controlled input flowing into ProcessBuilder calls,
 *              which could lead to command injection vulnerabilities.
 * @kind problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @security-severity 8.8
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.security.ProcessCommands

class ProcessBuilderCmdInjection extends TaintTracking::Configuration {
  ProcessBuilderCmdInjection() { this = "ProcessBuilder command injection" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      // User input sources
      (ma.getMethod() instanceof HttpServletRequestGetParameter or
       ma.getMethod() instanceof HttpServletRequestGetHeader or
       ma.getMethod() instanceof HttpServletRequestGetQueryString) and
      source.asExpr() = ma
    )
    or
    exists(LocalVariable v |
      v.getType() instanceof StringType and
      not v.getInitializer().getValue().(Literal).getValue() instanceof String and
      not variableIsSanitized(v) and
      source.asVariable() = v
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      cc.getArgument(0) = sink.asExpr()
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("command") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getArgument(0) = sink.asExpr()
    )
  }

  override predicate isShellCommand(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      analyzeShellCommandPattern(cc.getArgument(0).toString())
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("command") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      analyzeShellCommandPattern(ma.getArgument(0).toString())
    )
  }

  private predicate analyzeShellCommandPattern(string cmd) {
    cmd.matches("%sh%|%bash%|%ksh%|%csh%|%tcsh%|%zsh%|%cmd%") and
    cmd.matches("%-c%|%/c%")
  }

  private predicate variableIsSanitized(Variable v) {
    exists(Expr init |
      init = v.getInitializer() and
      (
        init instanceof StringLiteral or
        (init instanceof ArrayCreation and all(ArrayCreation.getInitializer().getValue() instanceof StringLiteral)) or
        (init instanceof MethodAccess and init.toString().matches("%Arrays.asList%") and all(MethodAccess.getArgument() instanceof StringLiteral))
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Expr e |
      e = sanitizer.asExpr() and
      (
        e instanceof StringLiteral or
        (e instanceof ArrayCreation and all(ArrayCreation.getInitializer().getValue() instanceof StringLiteral)) or
        (e instanceof MethodAccess and e.toString().matches("%Arrays.asList%") and all(MethodAccess.getArgument() instanceof StringLiteral))
      )
    )
  }
}

