Rule Content:
/**
 * @name Command injection in ProcessBuilder
 * @description Detects dangerous ProcessBuilder calls where user input
 *              may flow into command execution without sanitization
 * @id command-injection-process-builder
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-077
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class ProcessBuilderConfig extends TaintTracking::Configuration {
  ProcessBuilderConfig() { this = "ProcessBuilderConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, Parameter p | 
      ma.getMethod() instanceof RemoteFlowSource and
      source.asParameter() = p and
      ma.getAnArgument() = p
    )
    or
    exists(FieldAccess fa |
      source.asExpr() = fa and
      exists(RemoteFlowSource rfs | rfs.flowsTo(fa))
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral sl | node.asExpr() = sl)
    or
    exists(ArrayCreationExpr ace | 
      node.asExpr() = ace and
      ace.getInitializer().getExpr(0) instanceof StringLiteral
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("asList") and
      ma.getMethod().getDeclaringType().hasName("Arrays") and
      node.asExpr() = ma and
      ma.getArgument(0) instanceof StringLiteral
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      (
        sink.asExpr() = cc.getArgument(0)
        or
        (
          cc.getArgument(0).toString().matches("/(sh|bash|ksh|csh|tcsh|zsh)/") and
          cc.getArgument(1).toString() = "-c" and
          sink.asExpr() = cc.getAnyArgument()
        )
        or
        (
          cc.getArgument(0).toString() = "cmd" and
          cc.getArgument(1).toString() = "/c" and
          sink.asExpr() = cc.getAnyArgument()
        )
      )
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("command") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = ma.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ProcessBuilderConfig conf
where conf.hasFlowPath(source, sink)
