    impact: HIGH
    confidence: LOW

scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: VARIABLE_CMD
    match:
      node: IDENTIFIER
      where:
