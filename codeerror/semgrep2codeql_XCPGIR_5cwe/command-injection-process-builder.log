/**
 * @name Command Injection in ProcessBuilder
 * @description Detects when formatted or concatenated strings are used as input to ProcessBuilder,
 *              which could lead to command injection if the input is user-controlled.
 * @kind path-problem
 * @problem.severity error
 * @precision medium
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat

class ProcessBuilderConstructor extends Constructor {
  ProcessBuilderConstructor() {
    this.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
  }
}

class ProcessBuilderCommand extends Method {
  ProcessBuilderCommand() {
    this.hasName("command") and
    this.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
  }
}

class CommandVariable extends Variable {
  CommandVariable() {
    this.getName().regexpMatch("CMD|ARG")
  }
}

class SafeStringLiteral extends StringLiteral {
  SafeStringLiteral() {
    this.getValue().regexpMatch("^\"[^\"]+\"$")
  }
}

class CommandInjectionConfig extends DataFlow::Configuration {
  CommandInjectionConfig() {
    this = "CommandInjectionConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(CommandVariable cv | source.asExpr() = cv.getAnAccess())
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructor() instanceof ProcessBuilderConstructor and
      sink.asExpr() = cc.getArgument(0)
    )
    or
    exists(MethodCall mc |
      mc.getMethod() instanceof ProcessBuilderCommand and
      sink.asExpr() = mc.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SafeStringLiteral sl | sanitizer.asExpr() = sl)
  }
}

