Rule Content:
/**
 * @name Command injection via ProcessBuilder
 * @description Detects user-controlled input flowing into ProcessBuilder calls,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id command-injection-process-builder
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.Security

class ProcessBuilderConfig extends TaintTracking::Configuration {
  ProcessBuilderConfig() { 
    this = "ProcessBuilder command injection" 
  }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      // User input sources
      (ma.getMethod() instanceof HttpServletRequest::getParameter or
       ma.getMethod() instanceof HttpServletRequest::getHeader or
       ma.getMethod() instanceof HttpServletRequest::getQueryString) and
      source.asExpr() = ma
    )
    or
    exists(VariableAccess va |
      va.getVariable().getType() instanceof TypeString and
      not va.getVariable().getInitializer() instanceof Literal and
      not isSanitized(va.getVariable()) and
      source.asExpr() = va
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = cc.getArgument(0)
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("command") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = ma.getArgument(0)
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("command") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getArgument(0).toString().regexpMatch(".*(sh|bash|ksh|csh|tcsh|zsh|cmd).*") and
      ma.getArgument(1).toString().regexpMatch(".*(\\\\-c|\\\\/c).*") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  predicate isSanitized(Variable v) {
    exists(Expr init |
      init = v.getInitializer() and
      (
        init instanceof Literal or
        (init instanceof ArrayInit and
         forall(Expr e | init.getAChild() = e | e instanceof Literal)) or
        (init.instanceof(MethodAccess) and
         init.getMethod().getName() = "asList" and
         init.getMethod().getDeclaringType().hasQualifiedName("java.util", "Arrays") and
         forall(Expr arg | init.getAnArgument() = arg | arg instanceof Literal))
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Expr e |
      e = sanitizer.asExpr() and
      (
        e instanceof Literal or
        (e instanceof ArrayInit and
         forall(Expr child | e.getAChild() = child | child instanceof Literal)) or
        (e instanceof MethodAccess and
         e.getMethod().getName() = "asList" and
         e.getMethod().getDeclaringType().hasQualifiedName("java.util", "Arrays") and
         forall(Expr arg | e.getAnArgument() = arg | arg instanceof Literal))
      )
    )
  }
}

