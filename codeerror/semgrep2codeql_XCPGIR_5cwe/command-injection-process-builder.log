Rule Content:
/**
 * @name Command Injection in ProcessBuilder
 * @description Detects when formatted or concatenated strings are used as input to ProcessBuilder,
 *              which could lead to command injection if the input is user-controlled.
 * @kind path-problem
 * @problem.severity error
 * @precision medium
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import DataFlow::PathGraph

class ProcessBuilderConstructorCall extends MethodAccess {
  ProcessBuilderConstructorCall() {
    this.getCallee().hasName("<init>") and
    this.getCallee().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
  }
}

class ProcessBuilderCommandCall extends MethodAccess {
  ProcessBuilderCommandCall() {
    this.getCallee().hasName("command") and
    this.getCallee().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
  }
}

class CommandInjectionConfiguration extends TaintTracking::Configuration {
  CommandInjectionConfiguration() {
    this = "CommandInjectionConfiguration"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Field f |
      f.hasName(/CMD|ARG/) and
      source.asExpr() = f.getAnAccess()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ProcessBuilderConstructorCall call |
      sink.asExpr() = call.getArgument(0)
    )
    or
    exists(ProcessBuilderCommandCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral lit |
      sanitizer.asExpr() = lit and
      not lit.getStringValue().regexpMatch(".*[\\\\$&`'\"|<>].*")
    )
  }
}

from CommandInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink, "Formatted or concatenated string used in ProcessBuilder call. May be vulnerable to command injection."
