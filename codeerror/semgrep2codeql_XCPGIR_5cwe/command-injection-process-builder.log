Rule Content:
/**
 * @name Command injection in ProcessBuilder call
 * @description Detects cases where a formatted or concatenated string is used as input to a ProcessBuilder call,
 *              which could lead to command injection if the variable is user-controlled.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.security.ProcessCreation
import DataFlow::PathGraph

class ProcessBuilderCommandInjectionFlow extends TaintTracking::Configuration {
  ProcessBuilderCommandInjectionFlow() { this = "ProcessBuilderCommandInjectionFlow" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma | 
      ma.getMethod().hasName("getParameter") and
      source.asExpr() = ma.getAnArgument() and
      not ma.getAnArgument().isConstant()
    )
    or
    exists(LocalVariableScope lvs |
      source.asExpr() = lvs.getVariable().getAnAccess() and
      not lvs.getVariable().getInitializer().isConstant()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc | 
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = cc.getArgument(0)
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("command") and
      ma.getQualifier().getType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ProcessBuilderCommandInjectionFlow pbConfig
where pbConfig.hasFlowPath(source, sink)
select sink,
  "Command injection detected in ProcessBuilder call. User-controlled input reaches command execution.",
  source, "User input originates here", source.getNode().getLocation(),
  sink, "ProcessBuilder command execution", sink.getNode().getLocation()
