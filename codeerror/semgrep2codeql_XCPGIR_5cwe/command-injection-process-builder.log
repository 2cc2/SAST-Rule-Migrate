/**
 * @name Command Injection via ProcessBuilder
 * @description Detects potential command injection vulnerabilities when tainted input is passed to ProcessBuilder
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import DataFlow::PathGraph

class ProcessBuilderConfig extends TaintTracking::Configuration {
  ProcessBuilderConfig() { this = "ProcessBuilderCommandInjection" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p) and
    not exists(source.asExpr().(Literal))
    or
    exists(Field f | source.asExpr() = f.getAnAccess()) and
    not exists(source.asExpr().(Literal))
    or
    exists(LocalVariable v | source.asExpr() = v.getAnAccess()) and
    not exists(source.asExpr().(Literal))
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(NewExpr ne |
      ne.getConstruction().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = ne.getAnArgument()
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName("command") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.asExpr() = ma.getAnArgument()
    )
    or
    exists(NewExpr ne, string shellCmd |
      ne.getConstruction().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ne.getArgument(0).toString() = shellCmd and
      shellCmd in ["sh", "bash", "ksh", "csh", "tcsh", "zsh", "cmd"] and
      (ne.getArgument(1).toString() = "-c" or ne.getArgument(1).toString() = "/c") and
      sink.asExpr() = ne.getAnArgument()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal lit |
      sanitizer.asExpr() = lit and
      lit.getValue().regexpMatch("^\"[^\"]+u003d[^\"]*\"$")
    )
  }

  override predicate isBarrier(DataFlow::Node node) {
    exists(ReturnStmt ret | node.asExpr() = ret.getExpr())
  }
}

