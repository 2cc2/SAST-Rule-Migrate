       call.getCallee().getName() = "clean" or
       call.getCallee().getName() = "sanitize") and
      (call.getCallee().getDeclaringType().hasQualifiedName("org.apache.commons.lang", "StringEscapeUtils") or
       call.getCallee().getDeclaringType().hasQualifiedName("org.springframework.web.util", "HtmlUtils") or
       call.getCallee().getDeclaringType().hasQualifiedName("org.owasp.esapi", "ESAPI") or
       call.getCallee().getDeclaringType().hasQualifiedName("org.owasp.encoder", "Encode") or
       call.getCallee().getDeclaringType().hasQualifiedName("org.jsoup", "JSoup")) and
      this.asExpr() = call
    )
  }
}

class NoDirectResponseWriterFlowConfig extends TaintTracking::Configuration {
  NoDirectResponseWriterFlowConfig() { this = "NoDirectResponseWriterFlowConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof ServletRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof DirectResponseWriterSink }

