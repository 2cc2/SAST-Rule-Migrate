  id: "no-direct-response-writer"
  kind: taint
  severity: WARNING
  message: "Detected a request with potential user-input going into a OutputStream or Writer object. This bypasses any view or template environments, including HTML escaping, which may expose this application to cross-site scripting (XSS) vulnerabilities."
scope:
  languages: [java]
  frameworks: ["servlets"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: "USER_INPUT"
    match:
      node: CALL
      api:
        type: "javax.servlet.ServletRequest | javax.servlet.http.HttpServletRequest"
        method: "getInputStream|getParameter|getParameterMap|getParameterValues|getReader|getCookies|getHeader|getHeaderNames|getHeaders|getPart|getParts|getQueryString"

sinks:
  - id: "DIRECT_OUTPUT"
    match:
      node: CALL
      api:
        type: "javax.servlet.http.HttpServletResponse | java.io.PrintWriter | javax.servlet.ServletOutputStream | java.io.OutputStream"
        method: "write|print|println|append"

sanitizers:
  - id: "HTML_ESCAPE"
    match:
      node: CALL
      api:
        type: "org.apache.commons.lang.StringEscapeUtils | org.springframework.web.util.HtmlUtils | org.owasp.esapi.ESAPI | com.thoughtworks.xstream.core.util.Encode | org.owasp.validator.html.PolicyFactory | org.owasp.validator.html.AntiSamy | org.jsoup.Jsoup"
        method: "escapeHtml|htmlEscape|encodeForHTML|forHtml|sanitize|scan|clean"
    effect: neutralize
    scope: { sinks: [DIRECT_OUTPUT] }

propagations:
  - id: "ARG_PARAM"
    edge: arg->param
    kind: taint
  - id: "METHOD_RETURN"
    edge: return
    kind: taint

flows:
  - source: USER_INPUT
    sink: DIRECT_OUTPUT
    through: [ARG_PARAM*, METHOD_RETURN*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(org.apache.commons.lang.StringEscapeUtils.escapeHtml)" },
                   { pattern: "CALL(org.springframework.web.util.HtmlUtils.htmlEscape)" },
                   { pattern: "CALL(org.owasp.esapi.ESAPI.encoder().encodeForHTML)" },
                   { pattern: "CALL(Encode.forHtml)" },
                   { pattern: "CALL(PolicyFactory.sanitize)" },
                   { pattern: "CALL(AntiSamy.scan)" },
                   { pattern: "CALL(JSoup.clean)" } ]

report:
  message: "Potentially unsafe user input reaches direct output writer without HTML escaping"
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "response.getWriter().print(request.getParameter(\"input\"));"
  negative:
    - "response.getWriter().print(ESAPI.encoder().encodeForHTML(request.getParameter(\"input\")));"
