      (call.getCallee().getDeclaringType().hasQualifiedName("javax.servlet", "ServletResponse") or
       call.getCallee().getDeclaringType().hasQualifiedName("java.io", "PrintWriter") or
       call.getCallee().getDeclaringType().hasQualifiedName("javax.servlet", "ServletOutputStream") or
       call.getCallee().getDeclaringType().hasQualifiedName("java.io", "OutputStream")) and
      this.asExpr() = call
    )
  }
}

class HtmlSanitizer extends DataFlow::Node {
  HtmlSanitizer() {
    exists(Call call |
      (call.getCallee().getName() = "escapeHtml" or
