Rule Content:
/**
 * @name No direct response writer
 * @description Detected a request with potential user-input going into a OutputStream or Writer object. 
 *              This bypasses any view or template environments, including HTML escaping, which may 
 *              expose this application to cross-site scripting (XSS) vulnerabilities.
 * @kind problem
 * @problem.severity warning
 * @id java/no-direct-response-writer
 * @tags security
 *       xss
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.servlet.ServletRequest
import semmle.code.java.servlet.HttpServletResponse
import semmle.code.java.StringManipulation

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(MethodAccess m |
      m.getMethod().hasQualifiedName("javax.servlet.ServletRequest",
        ["getInputStream", "getParameter", "getParameterMap", "getParameterValues", 
         "getReader", "getCookies", "getHeader", "getHeaderNames", 
         "getHeaders", "getPart", "getParts", "getQueryString"]) and
      this.asExpr() = m
    )
  }
}

class XssSink extends DataFlow::Node {
  XssSink() {
    exists(MethodAccess m |
      (m.getMethod().hasQualifiedName("javax.servlet.http.HttpServletResponse", "getWriter") or
       m.getMethod().hasQualifiedName("java.io.PrintWriter", "write") or
       m.getMethod().hasQualifiedName("javax.servlet.ServletOutputStream", "write") or
       m.getMethod().hasQualifiedName("java.io.OutputStream", "write")) and
      this.asExpr() = m.getReceiver()
    )
  }
}

class HtmlSanitizer extends DataFlow::Node {
  HtmlSanitizer() {
    exists(MethodAccess m |
      (m.getMethod().hasQualifiedName("org.owasp.esapi.ESAPI", "encodeForHTML") or
       m.getMethod().hasQualifiedName("org.apache.commons.lang.StringEscapeUtils", "escapeHtml") or
       m.getMethod().hasQualifiedName("org.springframework.web.util.HtmlUtils", "htmlEscape") or
       m.getMethod().hasName(["forHtml", "sanitize", "scan", "clean"])) and
      this.asExpr() = m
    )
  }
}

predicate isSanitized(DataFlow::Node node) {
  exists(HtmlSanitizer sanitizer | sanitizer.flowsTo(node))
}

class XssTaintConfig extends TaintTracking::Configuration {
  XssTaintConfig() { this = "XssTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof XssSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof HtmlSanitizer
  }
}

from XssTaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches response writer without HTML escaping: $@",
  source.getNode(),
  "User input source"
