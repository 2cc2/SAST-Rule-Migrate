flows:
  - source: HTTP_REQUEST_INPUT
    sink: DIRECT_RESPONSE_WRITER
    through: [ARG_TO_RETURN*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(org.apache.commons.lang.StringEscapeUtils.escapeHtml)" }, 
