 * @description Detected a request with potential user-input going into a OutputStream or Writer object.
 *              This bypasses any view or template environments, including HTML escaping, which may 
 *              expose this application to cross-site scripting (XSS) vulnerabilities.
 * @id no-direct-response-writer
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletRequestSource extends DataFlow::ExprNode {
  ServletRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("getParameter%|getReader|getCookies|getHeader%|getPart%|getQueryString") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet", "ServletRequest") and
      this.asExpr() = ma
    )
  }
}

class DirectResponseWriterSink extends DataFlow::ExprNode {
  DirectResponseWriterSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("print|write|println") and
       (ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet", "ServletResponse") or
        ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "PrintWriter") or
        ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet", "ServletOutputStream") or
        ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "OutputStream")))
      and
      this.asExpr() = ma
    )
  }
}

class HtmlSanitizer extends TaintTracking::Sanitizer {
  HtmlSanitizer() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("escapeHtml|htmlEscape|encodeForHTML|clean|sanitize") and
       (ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.lang", "StringEscapeUtils") or
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.web.util", "HtmlUtils") or
        ma.getMethod().getDeclaringType().hasQualifiedName("org.owasp.esapi", "ESAPI") or
        ma.getMethod().getDeclaringType().hasQualifiedName("org.owasp.encoder", "Encode") or
        ma.getMethod().getDeclaringType().hasQualifiedName("org.jsoup", "JSoup")))
      and
      this.asExpr() = ma
    )
  }
}

class NoDirectResponseWriterFlowConfig extends TaintTracking::Configuration {
  NoDirectResponseWriterFlowConfig() { this = "NoDirectResponseWriterFlowConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof ServletRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof DirectResponseWriterSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof HtmlSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    any(Method m | pred.asParameter() = m.getAParameter() and succ.asExpr() = m.getReturn())
  }
}

