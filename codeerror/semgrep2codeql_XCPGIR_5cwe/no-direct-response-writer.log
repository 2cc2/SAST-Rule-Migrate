  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "response.getWriter().print(request.getParameter(\"input\"));"
  negative:
    - "response.getWriter().print(ESAPI.encoder().encodeForHTML(request.getParameter(\"input\")));"
