Rule Content:
/**
 * @name NoDirectResponseWriter
 * @description Detected a request with potential user-input going into a OutputStream or Writer object.
 *              This bypasses any view or template environments, including HTML escaping,
 *              which may expose this application to cross-site scripting (XSS) vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-079
 *       framework/servlets
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletSource extends RemoteFlowSource {
  ServletSource() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType() instanceof TypeServletRequest or
       ma.getMethod().getDeclaringType() instanceof TypeHttpServletRequest) and
      ma.getMethod().getName() in [
        "getInputStream", "getParameter", "getParameterMap", "getParameterValues",
        "getReader", "getCookies", "getHeader", "getHeaderNames", "getHeaders",
        "getPart", "getParts", "getQueryString"
      ] and
      this.asExpr() = ma
    )
  }
}

class ServletSink extends DataFlow::Node {
  ServletSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType() instanceof TypeHttpServletResponse or
       ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "PrintWriter") or
       ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet", "ServletOutputStream") or
       ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "OutputStream")) and
      ma.getMethod().getName() in ["write", "print", "println", "append"] and
      this.asExpr() = ma
    )
  }
}

class HtmlSanitizer extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.lang", "StringEscapeUtils") and
       ma.getMethod().getName() = "escapeHtml")
      or
      (ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.web.util", "HtmlUtils") and
       ma.getMethod().getName() = "htmlEscape")
      or
      (ma.getMethod().getDeclaringType().hasQualifiedName("org.owasp.esapi", "ESAPI") and
       ma.getMethod().getName() = "encodeForHTML")
      or
      (ma.getMethod().getDeclaringType().hasQualifiedName("com.thoughtworks.xstream.core.util", "Encode") and
       ma.getMethod().getName() = "forHtml")
      or
      (ma.getMethod().getDeclaringType().hasQualifiedName("org.owasp.validator.html", "PolicyFactory") and
       ma.getMethod().getName() = "sanitize")
      or
      (ma.getMethod().getDeclaringType().hasQualifiedName("org.owasp.validator.html", "AntiSamy") and
       ma.getMethod().getName() = "scan")
      or
      (ma.getMethod().getDeclaringType().hasQualifiedName("org.jsoup", "Jsoup") and
       ma.getMethod().getName() = "clean") and
      pred.asExpr() = ma.getArgument(0) and
      succ.asExpr() = ma
    )
  }
}

class ServletTaintConfig extends TaintTracking::Configuration {
  ServletTaintConfig() {
    this = "ServletInputToOutputTaintConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ServletSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof HtmlSanitizer
  }
}

from ServletTaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "Potentially unsafe user input reaches direct output writer without HTML escaping",
  source.getNode(), "User input $@ originates here",
  sink.getNode(), "Output written here"
