Rule Content:
/**
 * @name No direct response writer
 * @description Detected a request with potential user-input going into a OutputStream or Writer object.
 *              This bypasses any view or template environments, including HTML escaping, which may
 *              expose this application to cross-site scripting (XSS) vulnerabilities.
 * @id no-direct-response-writer
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletRequestSource extends DataFlow::ExprNode {
  ServletRequestSource() {
    exists(Method m |
      (m.getName().matches("getParameter%") or 
       m.getName().matches("getReader") or
       m.getName().matches("getCookies") or
       m.getName().matches("getHeader%") or
       m.getName().matches("getPart%") or
       m.getName().matches("getQueryString")) and
      m.getDeclaringType().hasQualifiedName("javax.servlet", "ServletRequest") and
      this.asExpr() = m.getACall()
    )
  }
}

class DirectResponseWriterSink extends DataFlow::ExprNode {
  DirectResponseWriterSink() {
    exists(Method m |
      (m.getName().matches("print") or
       m.getName().matches("write") or
       m.getName().matches("println")) and
      (m.getDeclaringType().hasQualifiedName("javax.servlet", "ServletResponse") or
       m.getDeclaringType().hasQualifiedName("java.io", "PrintWriter") or
       m.getDeclaringType().hasQualifiedName("javax.servlet", "ServletOutputStream") or
       m.getDeclaringType().hasQualifiedName("java.io", "OutputStream")) and
      this.asExpr() = m.getACall()
    )
  }
}

class HtmlSanitizer extends DataFlow::Node {
  HtmlSanitizer() {
    exists(Method m |
      (m.getName().matches("escapeHtml") or
       m.getName().matches("htmlEscape") or
       m.getName().matches("encodeForHTML") or
