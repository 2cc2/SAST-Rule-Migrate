Rule Content:
/**
 * @name NoDirectResponseWriter
 * @description Detected a request with potential user-input going into a OutputStream or Writer object.
 *              This bypasses any view or template environments, including HTML escaping,
 *              which may expose this application to cross-site scripting (XSS) vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-079
 *       framework/servlets
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletSource extends DataFlow::Node {
  ServletSource() {
    exists(Method m, MethodAccess ma |
      (m.hasQualifiedName("javax.servlet.ServletRequest", _) or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", _)) and
      m.getName() in ["getInputStream", "getParameter", "getParameterMap", "getParameterValues",
                    "getReader", "getCookies", "getHeader", "getHeaderNames", "getHeaders",
                    "getPart", "getParts", "getQueryString"] and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class ServletSink extends DataFlow::Node {
  ServletSink() {
    exists(Method m, MethodAccess ma |
      (m.hasQualifiedName("javax.servlet.http.HttpServletResponse", _) or
       m.hasQualifiedName("java.io.PrintWriter", _) or
       m.hasQualifiedName("javax.servlet.ServletOutputStream", _) or
       m.hasQualifiedName("java.io.OutputStream", _)) and
      m.getName() in ["write", "print", "println", "append"] and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class HtmlSanitizer extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node from, DataFlow::Node to) {
    exists(Method m, MethodAccess ma |
      (m.hasQualifiedName("org.apache.commons.lang.StringEscapeUtils", "escapeHtml") or
       m.hasQualifiedName("org.springframework.web.util.HtmlUtils", "htmlEscape") or
       m.hasQualifiedName("org.owasp.esapi.ESAPI", "encodeForHTML") or
       m.hasQualifiedName("com.thoughtworks.xstream.core.util.Encode", "forHtml") or
       m.hasQualifiedName("org.owasp.validator.html.PolicyFactory", "sanitize") or
       m.hasQualifiedName("org.owasp.validator.html.AntiSamy", "scan") or
       m.hasQualifiedName("org.jsoup.Jsoup", "clean")) and
      ma.getMethod() = m and
      from.asExpr() = ma and
      to.asExpr() = ma.getArgument(0)
    )
  }
}

class ServletTaintConfig extends TaintTracking::Configuration {
  ServletTaintConfig() {
    this = "ServletInputToOutputTaintConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ServletSink
  }
}

from ServletTaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "Potentially unsafe user input reaches direct output writer without HTML escaping",
  source.getNode(), "User input $@ originates here", sink.getNode(), "Output written here"
