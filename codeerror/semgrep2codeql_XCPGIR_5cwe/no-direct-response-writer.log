Rule Content:
/**
 * @name NoDirectResponseWriter
 * @description Detected potentially unsafe user input going directly to output writer
 *              without proper HTML escaping, which may lead to XSS vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-079
 *       framework/servlets
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletSource extends RemoteFlowSource {
  ServletSource() {
    exists(Method m, CallableAccess ca |
      (m.getDeclaringType().hasQualifiedName("javax.servlet", "ServletRequest") or
       m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")) and
      m.getName() in [
        "getInputStream", "getParameter", "getParameterMap", "getParameterValues",
        "getReader", "getCookies", "getHeader", "getHeaderNames", "getHeaders",
        "getPart", "getParts", "getQueryString"
      ] and
      ca.getCallee() = m and
      this.asExpr() = ca
    )
  }
}

class ServletSink extends DataFlow::Node {
  ServletSink() {
    exists(Method m, CallableAccess ca |
      (m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") or
       m.getDeclaringType().hasQualifiedName("java.io", "PrintWriter") or
       m.getDeclaringType().hasQualifiedName("javax.servlet", "ServletOutputStream") or
       m.getDeclaringType().hasQualifiedName("java.io", "OutputStream")) and
      m.getName() in ["write", "print", "println", "append"] and
      ca.getCallee() = m and
      this.asExpr() = ca
    )
  }
}

class HtmlSanitizer extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Method m, CallableAccess ca |
      (m.getDeclaringType().hasQualifiedName("org.apache.commons.lang", "StringEscapeUtils") and m.getName() = "escapeHtml") or
      (m.getDeclaringType().hasQualifiedName("org.springframework.web.util", "HtmlUtils") and m.getName() = "htmlEscape") or
      (m.getDeclaringType().hasQualifiedName("org.owasp.esapi", "ESAPI") and m.getName() = "encodeForHTML") or
      (m.getDeclaringType().hasQualifiedName("com.thoughtworks.xstream.core.util", "Encode") and m.getName() = "forHtml") or
      (m.getDeclaringType().hasQualifiedName("org.owasp.validator.html", "PolicyFactory") and m.getName() = "sanitize") or
      (m.getDeclaringType().hasQualifiedName("org.owasp.validator.html", "AntiSamy") and m.getName() = "scan") or
      (m.getDeclaringType().hasQualifiedName("org.jsoup", "Jsoup") and m.getName() = "clean") and
      ca.getCallee() = m and
      pred.asExpr() = ca.getArgument(0) and
      succ.asExpr() = ca
    )
  }
}

class ServletTaintConfig extends TaintTracking::Configuration {
  ServletTaintConfig() {
    this = "ServletInputToOutputTaintConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ServletSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof HtmlSanitizer
  }
}

from ServletTaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "Potentially unsafe user input reaches direct output writer without HTML escaping",
  source.getNode(), "User input $@ originates here",
  sink.getNode(), "Output written here"
