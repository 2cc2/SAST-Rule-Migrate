```yaml
xcpgir_version: "1.0"
rule:
  id: script-engine-injection
  kind: taint
  severity: WARNING
  message: "Detected potential code injection using ScriptEngine. Ensure user-controlled data cannot enter '.eval()', otherwise, this is a code injection vulnerability."

scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: USER_INPUT
    match:
      node: METHOD_PARAMETER_IN

sinks:
  - id: SCRIPT_EVAL
    match:
      node: CALL
      api: { type: javax.script.ScriptEngine, method: eval }
      arg_index: 0

sanitizers:
  - id: STRING_LITERAL
    match:
      node: LITERAL
      type: { name: "java.lang.String" }
    effect: neutralize

barriers:
  - id: RETURN_STOP
    match: { node: RETURN }
    effect: stop

propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint

flows:
  - source: USER_INPUT
    sink: SCRIPT_EVAL
    through: [ARG_TO_PARAM*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(java.lang.String)" } ]

report:
  message: "User input reaches ScriptEngine.eval() without sanitization"
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "engine.eval(userInput);"
  negative:
    - 'engine.eval("safeScript");'
    - 'String script = "safeScript"; engine.eval(script);'
```
