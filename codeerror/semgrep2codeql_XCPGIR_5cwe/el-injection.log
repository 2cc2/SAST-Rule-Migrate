/**
 * @name EL Injection
 * @description Detects Expression Language injection vulnerabilities where dynamic input
 *              flows into EL expression evaluation methods without proper sanitization.
 * @kind path-problem
 * @problem.severity warning
 * @id java/el-injection
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class ElInjectionConfig extends TaintTracking::Configuration {
  ElInjectionConfig() { this = "ElInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p and p.getType().hasName("String")) or
    exists(LocalVariableDecl lv | source.asVariable() = lv.getVariable() and lv.getType().hasName("String"))
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Call call |
      (
        (m.hasName("createValueExpression") and
         m.getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
         call.getCallee() = m and
         sink.asExpr() = call.getArgument(1)) or
        (m.hasName("createMethodExpression") and
         m.getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
         call.getCallee() = m and
         sink.asExpr() = call.getArgument(1)) or
        (m.hasName("buildConstraintViolationWithTemplate") and
         call.getCallee() = m and
         sink.asExpr() = call.getArgument(0))
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral sl | node.asExpr() = sl) or
    exists(AssignExpr ae | node.asExpr() = ae.getRhs() and ae.getRhs() instanceof StringLiteral)
  }
}

from ElInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential Expression Language Injection vulnerability", source, sink,
  "An expression is built with dynamic value $@. The source should be verified to avoid unfiltered values in code evaluation.",
  source.getNode(), "this user input"
