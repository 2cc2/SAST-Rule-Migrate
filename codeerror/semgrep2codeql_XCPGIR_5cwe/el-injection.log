Rule Content:
/** 
 * @name EL Injection
 * @description Detects Expression Language injection vulnerabilities where dynamic input
 *              flows into EL expression evaluation methods without proper sanitization.
 * @kind path-problem
 * @problem.severity warning
 * @id java/el-injection
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ExpressionFactoryConfig extends TaintTracking::Configuration {
  ExpressionFactoryConfig() { this = "ExpressionFactoryConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p, LocalVariableDecl lv |
      (m.getAParameter() = p and source.asParameter() = p) or
      (lv.getAnAccess() = source.asExpr() and lv.getType() instanceof TypeString)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (
        // Check for createValueExpression calls
        (ma.getMethod().getName() = "createValueExpression" and
         ma.getMethod().getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
         sink.asExpr() = ma.getArgument(1)) or
        // Check for createMethodExpression calls
        (ma.getMethod().getName() = "createMethodExpression" and
         ma.getMethod().getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
         sink.asExpr() = ma.getArgument(1)) or
        // Check for buildConstraintViolationWithTemplate calls
        (ma.getMethod().getName() = "buildConstraintViolationWithTemplate" and
         sink.asExpr() = ma.getArgument(0))
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sanitizer.asExpr() = sl)
      or
    exists(AssignmentExpr ae | sanitizer.asExpr() = ae.getRight() and ae.getRight() instanceof StringLiteral)
  }
}

from ExpressionFactoryConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential Expression Language Injection vulnerability", source, sink,
  "An expression is built with a dynamic value $@. The source should be verified to avoid unfiltered values in code evaluation.",
  source.getNode(), "this user input"
