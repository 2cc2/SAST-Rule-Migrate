/**
 * @name EL Injection
 * @description Detects Expression Language injection vulnerabilities where dynamic input
 *              flows into EL expression evaluation methods without proper sanitization.
 * @kind path-problem
 * @problem.severity warning
 * @id java/el-injection
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Hibernate

class ElInjectionConfig extends TaintTracking::Configuration {
  ElInjectionConfig() { this = "ElInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p and p.getType().hasName("String")) or
    exists(LocalVariableDecl lv | source.asExpr() = lv.getAnAccess() and lv.getType().hasName("String"))
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method ma, Call call |
      (
        (ma.getName() = "createValueExpression" and
         ma.getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
         call.getCallee() = ma and
         sink.asExpr() = call.getArgument(1)) or
        (ma.getName() = "createMethodExpression" and
         ma.getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
         call.getCallee() = ma and
         sink.asExpr() = call.getArgument(1)) or
        (ma.getName() = "buildConstraintViolationWithTemplate" and
         call.getCallee() = ma and
         sink.asExpr() = call.getArgument(0))
