  message: "An expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."
scope:
  languages: [java]
  frameworks: ["*"]

sources:
  - id: DYNAMIC_INPUT
    match:
      node: PARAM | LOCAL
      type:
        name: "java.lang.String"

sinks:
  - id: EL_EXPRESSION
    match:
      node: CALL
      api: { type: "javax.el.ExpressionFactory", method: "createValueExpression" }
      arg_index: 1
  - id: METHOD_EXPRESSION
    match:
      node: CALL
      api: { type: "javax.el.ExpressionFactory", method: "createMethodExpression" }
      arg_index: 1
  - id: CONSTRAINT_TEMPLATE
    match:
      node: CALL
      api: { method: "buildConstraintViolationWithTemplate" }
      arg_index: 0

sanitizers:
  - id: LITERAL_STR
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: '^".*"$'
    effect: neutralize

barriers:
  - id: SAFE_ASSIGNMENT
    match:
      node: ASSIGNMENT
      where:
        - op: eq
          left: "rhs.value"
          right: '^".*"$'
    effect: stop

propagations:
  - id: PARAM_TO_ARG
    edge: arg->param
    kind: taint
  - id: LOCAL_TO_ARG
    edge: local->arg
    kind: taint

flows:
  - source: DYNAMIC_INPUT
    sink: EL_EXPRESSION
    through: [PARAM_TO_ARG*, LOCAL_TO_ARG*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL" }, { pattern: "ASSIGNMENT(rhs=LITERAL)" } ]
  - source: DYNAMIC_INPUT
    sink: METHOD_EXPRESSION
    through: [PARAM_TO_ARG*, LOCAL_TO_ARG*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL" }, { pattern: "ASSIGNMENT(rhs=LITERAL)" } ]
  - source: DYNAMIC_INPUT
    sink: CONSTRAINT_TEMPLATE
    through: [PARAM_TO_ARG*]

report:
  message: "Potential Expression Language Injection vulnerability"
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "factory.createValueExpression(context, userInput, Object.class);"
    - "factory.createMethodExpression(context, request.getParameter(\"expr\"), Object.class, new Class[0]);"
  negative:
    - "factory.createValueExpression(context, \"staticValue\", Object.class);"
    - "String safeExpr = \"safe\"; factory.createMethodExpression(context, safeExpr, Object.class, new Class[0]);"
```
