/**
 * @name EL Injection
 * @description Detects Expression Language injection vulnerabilities where dynamic input
 *              flows into EL expression evaluation methods without proper sanitization.
 * @kind path-problem
 * @problem.severity warning
 * @id java/el-injection
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ElInjectionConfig extends TaintTracking::Configuration {
  ElInjectionConfig() { this = "ElInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p and p.getType().hasName("String")) or
    exists(LocalVariableDecl lv | source.asVariable() = lv and lv.getType().hasName("String"))
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, MethodAccess ma |
      (
        (m.hasName("createValueExpression") and
         m.getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
         ma.getMethod() = m and
         sink.asExpr() = ma.getArgument(1)) or
        (m.hasName("createMethodExpression") and
         m.getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
         ma.getMethod() = m and
         sink.asExpr() = ma.getArgument(1)) or
        (m.hasName("buildConstraintViolationWithTemplate") and
         ma.getMethod() = m and
         sink.asExpr() = ma.getArgument(0))
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sanitizer.asExpr() = sl) or
    exists(InfixExpr ie | 
      ie.getOperator() = "=" and
      sanitizer.asExpr() = ie.getRightOperand() and
      ie.getRightOperand() instanceof StringLiteral
    )
  }
}

