              ((super.$METHOD($ARGS)) || (super.$METHOD(...)))
    - pattern-not: |
        @$ANN $MODIFIERS $RETURNTYPE $METHOD(...) { ... }
    - metavariable-regex:
        metavariable: $ANN
        regex: "(?!Override$).*"
    - pattern-not: final $RETURNTYPE $METHOD(...) {...}
    - pattern-not: native $RETURNTYPE $METHOD(...) {...}
    - pattern-not: synchronized $RETURNTYPE $METHOD(...) {...}
