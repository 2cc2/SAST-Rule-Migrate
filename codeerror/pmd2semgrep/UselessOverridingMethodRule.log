rules:
- id: useless-overriding-method
  patterns:
    - pattern: |
        @$ANN $MODIFIERS $RETURNTYPE $METHOD(...) {
          $STATEMENT;
        }
    - metavariable-pattern:
        metavariable: $STATEMENT
        patterns:
          - pattern-either:
              - pattern: return super.$METHOD(...);
