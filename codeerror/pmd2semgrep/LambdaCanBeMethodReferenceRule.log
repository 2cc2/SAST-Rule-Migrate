rules:
- id: lambda-can-be-method-reference
  message: >
    This lambda expression can be replaced with a method reference.
    Consider using $OBJ::$METHOD
  languages:
    - java
  severity: WARNING
  options:
    # Needed for lambda expression matching
    generic_ast: true
  patterns:
    - pattern: |
        ($PARAMS) -> {
          return $OBJ.$METHOD(...);
        }
    - pattern: |
        ($PARAMS) -> $OBJ.$METHOD(...)
    - focus-metavariable: $OBJ
    - metavariable-pattern:
        metavariable: $PARAMS
        patterns:
          - patterns:
              - pattern: $X
              - pattern: $X,$Y,...,$Z
    - metavariable-pattern:
        metavariable: $METHOD
        patterns:
          - pattern: $M(...)
          - pattern: $M($P)
  fix-regex:
    regex: '(.*)->\s*(.*)\.(.*)\(.*\)'
    replacement: '\1::\3'
