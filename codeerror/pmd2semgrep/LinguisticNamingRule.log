rules:
- id: linguistic-naming
  patterns:
  - pattern: |
      $TYPE $VAR = ...;
  - pattern: |
      $TYPE $FIELD;
  - pattern: |
      $RETURN $METHOD(...) { ... }
  message: Linguistics Antipattern - The naming suggests a boolean or transform method but the type doesn't match
  languages: [java]
  severity: WARNING
  metadata:
    category: style
    subcategory:
    - naming
    cwe:
    - 'CWE-1099: Inconsistent Naming Conventions'
    confidence: MEDIUM
    likelihood: HIGH
    impact: LOW
    owasp:
    - A3:2021-Injection
    references:
    - https://pmd.github.io/pmd-6.55.0/pmd_rules_java_codestyle.html#linguisticnaming

# Boolean method check
- id: boolean-method-naming
  patterns:
  - pattern: |
      public $RETURN $METHOD(...) { 
        ...
      }
  - metavariable-regex:
      metavariable: $METHOD
      regex: "^(is|has|can|have|will|should)([A-Z].*)?"
  - pattern-not: |
      public boolean $METHOD(...) { 
        ...
      }
  message: Linguistics Antipattern - The method '$METHOD' suggests it returns boolean but doesn't
  languages: [java]
  severity: WARNING

# Transform method check    
- id: transform-method-naming
  patterns:
  - pattern: |
      public void $METHOD(...) { 
        ...
      }
  - metavariable-regex:
      metavariable: $METHOD
      regex: "^(to|as)([A-Z].*)?"
  message: Linguistics Antipattern - The method '$METHOD' suggests it should transform/convert but returns void
  languages: [java]
  severity: WARNING

# Getter check
- id: getter-naming
  patterns:
  - pattern: |
      public void get$METHOD(...) { 
        ...
      }
  message: Linguistics Antipattern - The getter method 'get$METHOD' should not return void
  languages: [java]
  severity: WARNING

# Setter check
- id: setter-naming
  patterns:
  - pattern: |
      public $NOT_VOID set$METHOD(...) { 
        ...
      }
  - pattern-not: void
  - metavariable-comparison:
      metavariable: $NOT_VOID
      comparison: $NOT_VOID != $CLASS_NAME
  message: Linguistics Antipattern - The setter method 'set$METHOD' should return void or the enclosing class type
  languages: [java]
  severity: WARNING

# Boolean field check  
- id: boolean-field-naming
  patterns:
  - pattern: |
      $NOT_BOOLEAN $FIELD;
  - metavariable-regex:
      metavariable: $FIELD
      regex: "^(is|has|can|have|will|should)([A-Z].*)?"
  - pattern-not: |
      boolean $FIELD;
  - pattern-not: |
      private Boolean $FIELD;
  message: Linguistics Antipattern - The field '$FIELD' suggests it's boolean but is '$NOT_BOOLEAN'
  languages: [java]
  severity: WARNING
