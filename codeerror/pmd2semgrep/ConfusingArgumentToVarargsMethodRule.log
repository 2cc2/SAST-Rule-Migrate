rules:
- id: confusing-varargs-method-call
  patterns:
  - pattern-inside: |
      $CLASS.$METHOD(...$ARGS)
  - focus-metavariable: $ARGS[-1]
  - pattern-not: (..., ($T) $ARGS[-1], ...)
  - pattern-not: (..., new $TYPE[] {...}, ...)
  - pattern-either:
    - pattern: |
        $ARGS[-1].getTypeMirror().isSubtypeOf($COMPONENT)
    - pattern: |
        $ARGS[-1] instanceof ASTArrayAllocation && $ARGS[-1].getArrayInitializer() != null
  message: >
    Unclear if a varargs or non-varargs call is intended. Cast to %s or %s[],
    or pass varargs parameters separately to clarify intent.
  fix: |
    // Cast to appropriate type or use explicit array creation
  languages:
  - java
  severity: WARNING
  metadata:
