rules:
- id: unnecessary-cast
  message: Unnecessary cast detected. The operand is already a subtype of the context type or can be converted to it implicitly.
  languages:
  - java
  severity: WARNING
  patterns:
  - pattern: |
      (CAST_EXPRESSION $T $OPERAND)
  - metavariable-pattern:
      metavariable: $OPERAND
      patterns:
      - pattern-not: "null"
  - metavariable-pattern:
      metavariable: $OPERAND
      patterns:
      - pattern-not: "(LAMBDA_EXPRESSION ...)"
      - pattern-not: "(METHOD_REFERENCE ...)"
  - pattern-inside: |
      $CONTEXT
  - metavariable-comparison:
      metavariable: $OPERAND.getTypeMirror()
      comparison: $OPERAND.getTypeMirror().isSubtypeOf($T.getTypeMirror())
  - pattern-not: |
      (CAST_EXPRESSION $T (PRIMITIVE_TYPE $TYPE))
      where:
        - $TYPE.isBottom() == false
  metadata:
    category: style
    subcategory:
    - unnecessary-code
    cwe:
    - 'CWE-563: Assignment to Variable without Use'
    confidence: MEDIUM
    likelihood: HIGH
    impact: LOW
