rules:
- id: use-utility-class
  message: This utility class has a non-private constructor
  patterns:
    - pattern: |
        class $CLASS {
          ...
          $CONSTRUCTOR(...) { ... }
          ...
        }
    - pattern-not: interface $INTERFACE
    - pattern-not: abstract class $ABSTRACT_CLASS
    - pattern-not: class $CLASS extends $PARENT
    - pattern-not: class $CLASS implements $INTERFACE
    - pattern-not: |
        @lombok.experimental.UtilityClass
        class $CLASS
    - pattern-not: |
        @org.junit.runner.RunWith
        class $CLASS
    - pattern-not: |
        class $CLASS {
          static $FIELD = ...;
          ...
        }
    - pattern-not: |
        class $CLASS {
          static $RETURN $METHOD(...) { ... }
          ...
        }
    - pattern-not: private $CONSTRUCTOR(...) { ... }
    - pattern-not: |
        @lombok.NoArgsConstructor(access=lombok.AccessLevel.PRIVATE)
