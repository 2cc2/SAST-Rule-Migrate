/**
 * @name SQLAlchemy SQL Injection from event parameter
 * @description Detects SQL injection vulnerability when user-controlled 'event' object flows into
 *              SQLAlchemy Cursor.execute() without proper sanitization.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class EventSource extends TaintTracking::TaintSource {
  EventSource() {
    exists(Function f, Parameter p |
      f.getName().matches("%HANDLER%") and
      p = f.getAParameter() and
      p.getName() = "event" and
      this = p.getAnAccess()
    )
  }
}

class SQLExecuteSink extends TaintTracking::TaintSink {
  SQLExecuteSink() {
    exists(MethodCall call |
      call.getMethodName() = "execute" and
      call.getReceiver().getType().hasQualifiedName("sqlalchemy.engine", "Cursor") and
      this = call.getArgument(0)
    )
  }
}

class EventToSQLFlowConfiguration extends TaintTracking::Configuration {
  EventToSQLFlowConfiguration() { 
    this = "EventToSQLFlowConfiguration" 
  }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof EventSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SQLExecuteSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    none()
  }
}

from EventToSQLFlowConfiguration cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink,
  "User input from 'event' parameter reaches SQL execution without sanitization. $@ flows here and is used in a SQL query.",
  source, source.toString(),
  "Potential SQL injection via event parameter"
