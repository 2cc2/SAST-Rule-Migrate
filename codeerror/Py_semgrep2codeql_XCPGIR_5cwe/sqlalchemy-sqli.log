flows:
  - source: EVENT_OBJECT
    sink: SQL_EXEC
    through: [ARG_PARAM*]
    constraints:
      path:
        must: [ { pattern: "CALL(sqlalchemy.engine.Cursor.execute)" } ]
report:
  message: "User input from event object reaches SQL execution without sanitization"
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "cursor.execute(event.query)"
  negative:
    - "cursor.execute('SELECT * FROM projects WHERE status = ?', 'active')"
