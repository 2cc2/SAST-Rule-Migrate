Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Detects SQL injection vulnerability when user-controlled 'event' object flows into
 *              SQLAlchemy Cursor.execute() without proper sanitization.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class EventParameter extends DataFlow::Node {
  EventParameter() {
    exists(FunctionValue fn, string name |
      fn.getAParameter() = this and
      name = this.getName() and
      name = "event" and
      exists(FunctionValue handler |
        handler.getName().matches("%HANDLER") and
        handler.hasName() and
        fn = handler
      )
    )
  }
}

class CursorExecuteCall extends DataFlow::Node {
  CursorExecuteCall() {
    exists(MethodCallExpr call, ClassType cursorType |
      call.getMethodName() = "execute" and
      call.getReceiver().getType() = cursorType and
      cursorType.getASourceDeclaration().getFile().getAbsolutePath().matches("%sqlalchemy/engine/Cursor%") and
      this = call.getArg(0)
    )
  }
}

class EventToSQLConfiguration extends TaintTracking::Configuration {
  EventToSQLConfiguration() { this = "EventToSQLConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventParameter }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CursorExecuteCall }
}

from EventToSQLConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization. $@ flows here and is used in a SQL query.",
  source, source.toString(),
  "User input from 'event' parameter"
