Rule Content:
/**
 * @name SQLAlchemy SQL Injection from event parameter
 * @description Detects SQL injection vulnerability when user-controlled 'event' object flows into
 *              SQLAlchemy Cursor.execute() without proper sanitization.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class EventParameter extends DataFlow::Node {
  EventParameter() {
    exists(Function f, Parameter p |
      f.getName().matches("%HANDLER%") and
      p = f.getParameter(0) and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class SqlCursorExecuteSink extends DataFlow::Node {
  SqlCursorExecuteSink() {
    exists(Call call, Name cursor |
      call.getCalleeName() = "execute" and
      cursor = call.getReceiver() and
      cursor.getType().hasQualifiedName("sqlalchemy.engine", "Cursor") and
      this = call.getArgument(0)
    )
  }
}

class EventToSqlTaintConfig extends TaintTracking::Configuration {
  EventToSqlTaintConfig() { this = "EventToSqlTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlCursorExecuteSink
  }
}

from EventToSqlTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input from 'event' parameter reaches SQL execution without sanitization. $@ flows here and is used in a SQL query.",
  source, source.toString(),
  "Potential SQL injection via event parameter"
