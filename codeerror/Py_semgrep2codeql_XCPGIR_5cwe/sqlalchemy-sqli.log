/**
 * @name SQL Injection via event object in SQLAlchemy
 * @description Detected SQL statement that is tainted by `event` object.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts

class EventSource extends DataFlow::Node {
  EventSource() {
    exists(Parameter p |
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() {
    exists(Method m, DataFlow::CallNode call |
      m.hasName("execute") and
      m.getDeclaringType().getQualifiedName().matches("sqlalchemy.engine.%") and
      call.getTarget() = m and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class SqlalchemySqliConfig extends TaintTracking::Configuration {
  SqlalchemySqliConfig() { this = "SqlalchemySqliConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecuteSink }
}

from SqlalchemySqliConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "User input from event object reaches SQL execution without sanitization",
  source, sink, "Potential SQL injection vulnerability"
