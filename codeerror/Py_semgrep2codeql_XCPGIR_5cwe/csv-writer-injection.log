  CSVWriterTrackingConfig() { this = "CSVWriterTrackingConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof FlaskSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CSVWriterSink }
