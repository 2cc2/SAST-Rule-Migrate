```yaml
xcpgir_version: "1.0"
rule:
  id: csv-writer-injection
  kind: taint
  severity: ERROR
  message: "Detected user input into a generated CSV file using the built-in `csv` module. If user data is used to generate the data in this file, it is possible that an attacker could inject a formula when the CSV is imported into a spreadsheet application that runs an attacker script, which could steal data from the importing user or, at worst, install malware on the user's computer."
scope:
  languages: [python]
  frameworks: [flask]
sources:
  - id: FLASK_USER_INPUT
    match:
      node: CALL
      api: { package: flask, type: request, method: form|args|values|cookies|stream|headers|data|full_path|url|json|get_json|view_args }
  - id: ROUTE_PARAM
    match:
      node: METHOD_PARAMETER_IN
      where:
        - op: inside
          left: METHOD
          right: PATTERN("@APP.route(...) def $FUNC(..., $ROUTEVAR, ...)")
sinks:
  - id: CSV_WRITER
    match:
      node: CALL
      api: { package: csv, method: writerow|writerows|writeheader }
      arg_index: 0
propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
flows:
  - source: FLASK_USER_INPUT
    sink: CSV_WRITER
    through: [ARG_TO_PARAM*]
  - source: ROUTE_PARAM
    sink: CSV_WRITER
    through: [ARG_TO_PARAM*]
report:
  message: "Potential CSV injection vulnerability detected. Consider using `defusedcsv` module instead."
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "@app.route('/') def index(param): csv.writerow(param)"
  negative:
    - "@app.route('/') def index(): csv.writerow('safe')"
```
