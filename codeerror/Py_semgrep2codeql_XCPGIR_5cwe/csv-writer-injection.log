Rule Content:
/*
 * @name CSV Injection Vulnerability
 * @description Detection rule for CSV injection vulnerabilities
 * @kind path-problem  
 * @id csv-writer-injection
 * @tags security
 * @precision high
 * @severity error
 * @problem.severity error
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.Flask
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

private class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(Call call |
      call.getFunc().getQualifiedName().matches("flask.request.%") and
      (
        call.getFunc().getName() = "form" or
        call.getFunc().getName() = "args" or
        call.getFunc().getName() = "values" or
        call.getFunc().getName() = "cookies" or
        call.getFunc().getName() = "stream" or
        call.getFunc().getName() = "headers" or
        call.getFunc().getName() = "data" or
        call.getFunc().getName() = "full_path" or
        call.getFunc().getName() = "url" or
        call.getFunc().getName() = "json" or
        call.getFunc().getName() = "get_json" or
        call.getFunc().getName() = "view_args"
      ) and
      this = call.getArg(0)
    )
  }
}

private class RouteParamSource extends DataFlow::Node {
  RouteParamSource() { 
    exists(Function f, Parameter p |
      f.getADecorator().getValue().toString() = "route" and
      p = f.getParameter(_) and
      this = DataFlow::parameterNode(p)
    )
  }
}

private class CsvWriterSink extends DataFlow::Node {
  CsvWriterSink() {
    exists(Call call |
      call.getFunc().getQualifiedName().matches("csv.writer.%") and
      (
        call.getFunc().getName() = "writerow" or
        call.getFunc().getName() = "writerows" or  
        call.getFunc().getName() = "writeheader"
      ) and
      this = call.getArg(0)
    )
  }
}

private class CsvInjectionConfig extends TaintTracking::Configuration {
  CsvInjectionConfig() { this = "CSV Injection Configuration" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof FlaskUserInput or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CsvWriterSink
  }
}

from CsvInjectionConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Potential CSV injection vulnerability from user input to CSV writer. Consider using 'defusedcsv' module.",
  source, "User input source",
  sink, "CSV writer sink"
