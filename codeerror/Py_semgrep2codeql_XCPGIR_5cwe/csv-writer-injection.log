Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detects user input into a generated CSV file using the built-in `csv` module.
 *              This could lead to formula injection when the CSV is imported into a spreadsheet application.
 * @kind path-problem
 * @problem.severity error
 * @id python/csv-writer-injection
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.web.flask.Flask
import DataFlow::PathGraph

class FlaskSource extends DataFlow::Node {
  FlaskSource() {
    exists(DataFlow::CallNode call |
      call.getTarget().getName() in [
        "form.get", "form.__getitem__", "args.get", "args.__getitem__",
        "values.get", "values.__getitem__", "cookies.get", "cookies.__getitem__",
        "headers.get", "headers.__getitem__", "view_args.get", "view_args.__getitem__"
      ] and
      call.getImportedModule().getName() = "flask.request" and
      this = call.getValue()
    )
    or
    exists(Function::Parameter param |
      param.getFunction().getADecorator().getName() = "route" and
      this = param.getAnAccess()
    )
  }
}

class CSVWriterSink extends DataFlow::Node {
  CSVWriterSink() {
    exists(DataFlow::CallNode call |
      (call.getTarget().getName() = "writerow" or
       call.getTarget().getName() = "writerows" or
       call.getTarget().getName() = "writeheader") and
      call.getImportedModule().getName().matches("%csv%") and
      this = call.getAnArgument()
    )
  }
}

class CSVWriterTrackingConfig extends TaintTracking::Configuration {
  CSVWriterTrackingConfig() { this = "CSVWriterTrackingConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof FlaskSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CSVWriterSink }
}

