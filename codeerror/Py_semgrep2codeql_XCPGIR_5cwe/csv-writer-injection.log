/**
 * @id csv-writer-injection
 * @kind path-problem
 * @severity error
 * @problem.severity error
 * @name CSV Injection Vulnerability
 * @description Detected user input into a generated CSV file using the built-in `csv` module. If user data is used to generate
 *   the data in this file, it is possible that an attacker could inject a formula when the CSV is imported into a
 *   spreadsheet application that runs an attacker script, which could steal data from the importing user or, at worst,
 *   install malware on the user's computer.
 * @tags security
 *       external/cwe/cwe-1236
 */

import python
import semmle.python.security.TaintTracking
import python.flask
import semmle.code.cpp.dataflow.DataFlow

class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(Call ma |
      ma.getTarget().getQualifiedName().matches("flask.request.%") and
      (
        ma.getTarget().getName() = "form" or
        ma.getTarget().getName() = "args" or
        ma.getTarget().getName() = "values" or
        ma.getTarget().getName() = "cookies" or
        ma.getTarget().getName() = "stream" or
        ma.getTarget().getName() = "headers" or
        ma.getTarget().getName() = "data" or
        ma.getTarget().getName() = "full_path" or
        ma.getTarget().getName() = "url" or
        ma.getTarget().getName() = "json" or
        ma.getTarget().getName() = "get_json" or
        ma.getTarget().getName() = "view_args"
      ) and
      this = ma.getArg(0)
    )
  }

  override predicate asCfgNode() { none() }
  override ControlFlow::Node getBasicBlock() { none() }
  override string toString() { result = "FlaskUserInput" }
  override ControlFlow::Scope getScope() { none() }
  override predicate asVariable() { none() }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getDecorator().getValue().getQualifiedName().matches("flask.Flask.route") and
      p = f.getParameter() and
      this = DataFlow::parameterNode(p)
    )
  }

  override predicate asCfgNode() { none() }
  override ControlFlow::Node getBasicBlock() { none() }
  override string toString() { result = "RouteParamSource" }
  override ControlFlow::Scope getScope() { none() }
  override predicate asVariable() { none() }
}

class CsvWriterSink extends DataFlow::Node {
  CsvWriterSink() {
    exists(Call ma |
      ma.getTarget().getQualifiedName().matches("csv.writer.%") and
      (
        ma.getTarget().getName() = "writerow" or
        ma.getTarget().getName() = "writerows" or
        ma.getTarget().getName() = "writeheader"
      ) and
      this = ma.getArg(0)
    )
  }

  override predicate asCfgNode() { none() }
  override ControlFlow::Node getBasicBlock() { none() }
  override string toString() { result = "CsvWriterSink" }
  override ControlFlow::Scope getScope() { none() }
  override predicate asVariable() { none() }
}

predicate isTaintedFlow(DataFlow::Node source, DataFlow::Node sink) {
  TaintTracking::localTaintStep(source, sink, _)
}

from DataFlow::Node source, DataFlow::Node sink, string sourceType
where
  (
    exists(FlaskUserInput fli | source = fli) or
    exists(RouteParamSource rps | source = rps)
  ) and
  exists(CsvWriterSink cws | sink = cws) and
  isTaintedFlow(source, sink) and
  (
    if exists(FlaskUserInput fli | source = fli)
    then sourceType = "Flask user input"
    else if exists(RouteParamSource rps | source = rps)
    then sourceType = "Route parameter"
    else sourceType = "Unknown"
  )
select sink, source, sink,
  "Potential CSV injection vulnerability detected from " + sourceType + ". Consider using `defusedcsv` module instead.",
  source, "User input flows to CSV writer here"
