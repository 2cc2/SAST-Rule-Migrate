Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detects user input into a generated CSV file using the built-in `csv` module.
 *              This could lead to formula injection when the CSV is imported into a spreadsheet application.
 * @kind path-problem
 * @problem.severity error
 * @id python/csv-writer-injection
 */

import python
import semmle.python.security.dataflow.Flask
import semmle.python.security.dataflow.new.DataFlow
import semmle.python.Modules.csv_module.CSVWriter

class FlaskSource extends RemoteFlowSource::Range {
  FlaskSource() {
    exists(string methodName |
      methodName =
        ["form.get", "form.__getitem__", "args.get", "args.__getitem__",
         "values.get", "values.__getitem__", "cookies.get", "cookies.__getitem__",
         "headers.get", "headers.__getitem__", "view_args.get", "view_args.__getitem__"] |
      this.asExpr() = any(DataFlow::CallNode call |
        call.getMethodName() = methodName and
        call.getReceiver().(DataFlow::GetAttrNode).getReceiver() =
          any(DataFlow::CallNode flaskReq |
            flaskReq.getMethodName() = "request" and
            flaskReq.getReceiver().(DataFlow::ModuleImportNode).getName().matches("%flask%")
          )
      ).getResult()
    )
    or
    exists(RoutePattern route |
      this.asParameter() = route.getParameter()
    )
  }
}

class CSVWriterSink extends DataFlow::Node {
  CSVWriterSink() {
    exists(DataFlow::CallNode call |
      call.getReceiver().(DataFlow::GetAttrNode).getReceiver().(DataFlow::LocalVariableNode).getType() =
        CSVWriter::writer().getType() and
      ["writerow", "writerows", "writeheader"].indexOf(call.getMethodName()) >= 0 and
      this = call.getArgument(0)
    )
  }
}

class CSVWriterInjectionFlowConfig extends TaintTracking::Configuration {
  CSVWriterInjectionFlowConfig() { this = "CSVWriterInjectionFlow" }

  override predicate isSource(DataFlow::Node source) { source instanceof FlaskSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CSVWriterSink }
}

from CSVWriterInjectionFlowConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(),
  "User input reaches CSV write operation without sanitization, potential formula injection vulnerability.",
  source.getNode(), "Source of user input",
  sink.getNode(), "Sink CSV write operation"
