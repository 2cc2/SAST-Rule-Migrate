Rule Content:
/**
 * @id csv-writer-injection
 * @kind path-problem
 * @severity error
 * @problem.severity error
 * @name CSV Injection Vulnerability
 * @description Detected user input into a generated CSV file using the built-in `csv` module. If user data is used to generate
 *   the data in this file, it is possible that an attacker could inject a formula when the CSV is imported into a
 *   spreadsheet application that runs an attacker script, which could steal data from the importing user or, at worst,
 *   install malware on the user's computer.
 * @tags security
 *       external/cwe/cwe-1236
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Flask
import DataFlow::PathGraph

class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(MethodAccess ma |
      ma.getMethod().(PythonFunctionValue).getQualifiedName().matches("flask.request.%") and
      (
        ma.getMethod().getName() = "form" or
        ma.getMethod().getName() = "args" or
        ma.getMethod().getName() = "values" or
        ma.getMethod().getName() = "cookies" or
        ma.getMethod().getName() = "stream" or
        ma.getMethod().getName() = "headers" or
        ma.getMethod().getName() = "data" or
        ma.getMethod().getName() = "full_path" or
        ma.getMethod().getName() = "url" or
        ma.getMethod().getName() = "json" or
        ma.getMethod().getName() = "get_json" or
        ma.getMethod().getName() = "view_args"
      ) and
      this = ma.getAnArg()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getADecorator().getAValue().getQualifiedName().matches("flask.Flask.route") and
      p = f.getAParameter() and
      this = p
    )
  }
}

class CsvWriterSink extends DataFlow::Node {
  CsvWriterSink() {
    exists(MethodAccess ma |
      ma.getMethod().(PythonFunctionValue).getQualifiedName().matches("csv.writer.%") and
      (
        ma.getMethod().getName() = "writerow" or
        ma.getMethod().getName() = "writerows" or
        ma.getMethod().getName() = "writeheader"
      ) and
      this = ma.getAnArg(0)
    )
  }
}

predicate isTaintedFlow(DataFlow::Node source, DataFlow::Node sink) {
  TaintTracking::localTaint(source, sink, _)
}

from DataFlow::PathNode source, DataFlow::PathNode sink, string sourceType
where
  (
    exists(FlaskUserInput fli | source.asNode() = fli) or
    exists(RouteParamSource rps | source.asNode() = rps)
  ) and
  exists(CsvWriterSink cws | sink.asNode() = cws) and
  isTaintedFlow(source.asNode(), sink.asNode()) and
  (
    if exists(FlaskUserInput fli | source.asNode() = fli)
    then sourceType = "Flask user input"
    else if exists(RouteParamSource rps | source.asNode() = rps)
    then sourceType = "Route parameter"
    else sourceType = "Unknown"
  )
select sink, source, sink,
  "Potential CSV injection vulnerability detected from " + sourceType + ". Consider using `defusedcsv` module instead.",
  source.asNode(), "User input flows to CSV writer here"
