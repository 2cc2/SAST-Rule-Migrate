Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detects user input into a generated CSV file using the built-in `csv` module.
 *              This could lead to formula injection when the CSV is imported into a spreadsheet application.
 * @kind path-problem
 * @problem.severity error
 * @id python/csv-writer-injection
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.web.flask.Request
import semmle.python.Concepts

class FlaskDataSource extends DataFlow::Node {
  FlaskDataSource() {
    exists(MethodCall call |
      call.getMethodName() in [
        "form.get", "form.__getitem__", "args.get", "args.__getitem__",
        "values.get", "values.__getitem__", "cookies.get", "cookies.__getitem__",
        "headers.get", "headers.__getitem__", "view_args.get", "view_args.__getitem__"
      ] and
      call.getQualifier().getType().getName() = "flask.request" and
      this.asExpr() = call
    )
    or
    exists(FunctionParam param |
      param.getFunction().getADecorator().toString() = "route" and
      this.asExpr() = param
    )
  }
}

class CSVWriterSink extends DataFlow::Node {
  CSVWriterSink() {
    exists(MethodCall call |
      (call.getMethodName() = "writerow" or
       call.getMethodName() = "writerows" or
       call.getMethodName() = "writeheader") and
      call.getQualifier().getType().toString().matches("%csv%") and
      this.asExpr() = call.getAnArgument()
    )
  }
}

class CSVInjectionConfiguration extends TaintTracking::Configuration {
  CSVInjectionConfiguration() { this = "CSV injection configuration" }

  override predicate isSource(DataFlow::Node source) { source instanceof FlaskDataSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CSVWriterSink }
}

from CSVInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source,
  "User input reaches CSV write operation without sanitization, potential formula injection vulnerability.",
  source.getNode(), "Source of user input",
  sink.getNode(), "Sink CSV write operation"
