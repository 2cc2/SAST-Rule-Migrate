Rule Content:
/**
 * @id csv-writer-injection
 * @kind path-problem
 * @severity error
 * @problem.severity error
 * @name CSV Injection Vulnerability
 * @description Detected user input into a generated CSV file using the built-in `csv` module. If user data is used to generate
 *   the data in this file, it is possible that an attacker could inject a formula when the CSV is imported into a
 *   spreadsheet application that runs an attacker script, which could steal data from the importing user or, at worst,
 *   install malware on the user's computer.
 * @tags security
 *       external/cwe/cwe-1236
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName().matches("flask.request.%") and
      (
        ma.getMethod().getName() = "form" or
        ma.getMethod().getName() = "args" or
        ma.getMethod().getName() = "values" or
        ma.getMethod().getName() = "cookies" or
        ma.getMethod().getName() = "stream" or
        ma.getMethod().getName() = "headers" or
        ma.getMethod().getName() = "data" or
        ma.getMethod().getName() = "full_path" or
        ma.getMethod().getName() = "url" or
        ma.getMethod().getName() = "json" or
        ma.getMethod().getName() = "get_json" or
        ma.getMethod().getName() = "view_args"
      ) and
      this = ma.getAnArg()
    )
  }

  override predicate isSource() { this instanceof FlaskUserInput }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getADecorator().getValue().getQualifiedName().matches("flask.Flask.route") and
      p = f.getAParameter() and
      this = DataFlow::parameterNode(p)
    )
  }

  override predicate isSource() { this instanceof RouteParamSource }
}

class CsvWriterSink extends DataFlow::Node {
  CsvWriterSink() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName().matches("csv.writer.%") and
      (
        ma.getMethod().getName() = "writerow" or
        ma.getMethod().getName() = "writerows" or
        ma.getMethod().getName() = "writeheader"
      ) and
      this = ma.getAnArg(0)
    )
  }

  override predicate isSink() { this instanceof CsvWriterSink }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "CSV Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskUserInput or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CsvWriterSink
  }
}

from Config cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential CSV injection vulnerability detected. Consider using `defusedcsv` module instead.",
  source, "User input flows to CSV writer here"
