Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement
 * @kind path-problem
 * @problem.severity warning  
 * @id py/asyncpg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class AsyncpgConnection extends Value::Constituent {
  AsyncpgConnection() { 
    exists(Import mi | 
      mi.getName() = "asyncpg" and
      mi.getImportedElement().(Value).getMember("Connection") = result
    )
  }
}

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(DataFlow::Node node, Name name |
      node = result and
      node.asExpr().(Variable).getName() = name and
      name.matches("%USERINPUT%")
    )
  }
}

class SqlExecution extends DataFlow::Node {
  SqlExecution() {
    exists(MethodCallExpr mc, Name methodName |
      mc.getMethodName() = methodName and
      methodName.getId() in ["fetch", "fetchrow", "fetchval", "execute",
                           "executemany", "prepare", "cursor", "copy_from_query"] and
      mc.getReceiver().getType() instanceof AsyncpgConnection and
      result = mc.getArgument(0)
    )
  }
}

class StringConcatenation extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node node1, DataFlow::Node node2) {
    exists(BinaryExpr be |
      be.getOperator() = "+" and
      (node1.asExpr() = be.getLeftOperand() or node1.asExpr() = be.getRightOperand()) and
      node2.asExpr() = be
    )
  }
}

class CustomTaintConfig extends TaintTracking::Configuration {
  CustomTaintConfig() { this = "asyncpg_sqli_config" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }
  
  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecution }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodCallExpr mc, Name methodName |
      mc.getMethodName() = methodName and
      methodName.getId() = "prepare" and
      mc.getReceiver().getType() instanceof AsyncpgConnection and
      sanitizer = mc.getArgument(0)
    )
  }

  override predicate additionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(StringConcatenation sc | sc.step(node1, node2))
  }
}

from CustomTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches SQL execution without sanitization",
  source.getNode(), "Source of user input",
  sink.getNode(), "SQL execution point"
