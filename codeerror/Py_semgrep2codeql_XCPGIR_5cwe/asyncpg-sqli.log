Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id py/asyncpg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class AsyncpgConnection extends API::Node {
  AsyncpgConnection() { 
    exists(API::ModuleImport mi | 
      mi.getImportedName() = "asyncpg" and
      mi.getMember("Connection").getReturn().(Value) = result
    )
  }
}

class UserInput extends TaintTracking::Source {
  UserInput() {
    exists(Variable v | 
      v.getName().matches("%USERINPUT%") and
      result = v
    )
  }
  
  override predicate isSourceOf(TaintKind kind) { kind = TaintKind::sql() }
}

class SqlExecution extends TaintTracking::Sink {
  SqlExecution() {
    exists(MethodCall mc | 
      mc.getMethod().getName() in [
        "fetch", "fetchrow", "fetchval", "execute", 
        "executemany", "prepare", "cursor", "copy_from_query"
      ] and
      mc.getReceiver().getType() instanceof AsyncpgConnection and
      result = mc.getArgument(0)
    )
  }
  
  override predicate sinks(TaintKind taint) { taint = TaintKind::sql() }
}

class PrepareSanitizer extends TaintTracking::Sanitizer {
  PrepareSanitizer() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "prepare" and
      mc.getReceiver().getType() instanceof AsyncpgConnection and
      result = mc.getArgument(0)
    )
  }
}

class StringConcatenation extends TaintTracking::AdditionalTaintStep {
  override predicate step(TaintTracking::TaintStep step) {
    exists(BinaryExpr be |
      be.getOperator() = "+" and
      (
        (step.getPrevNode() = be.getLeftOperand() and step.getNextNode() = be) or
        (step.getPrevNode() = be.getRightOperand() and step.getNextNode() = be)
      ) and
      not be.getLeftOperand() instanceof StringLiteral and
      not be.getRightOperand() instanceof StringLiteral
    )
  }
}

override predicate isPotentialSqlInjection(TaintTracking::Configuration config) {
  config instanceof TaintTracking::GlobalConfiguration and
  exists(UserInput ui, SqlExecution se |
    config.hasFlow(ui, se) and
    not exists(PrepareSanitizer ps | ps = se)
  )
}

from UserInput input, SqlExecution sql, PathGraph pg
where pg.hasFlowPath(input, sql)
select sql, 
  "User input reaches SQL execution without sanitization",
  input, "Source of user input",
  sql, "SQL execution point"
