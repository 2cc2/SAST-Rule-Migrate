Rule Content:
/**
 * @name asyncpg SQL Injection
 * @description Detected string concatenation with a non-literal variable in asyncpg SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.dataflow.new.PathGraph
import semmle.python.web.Asyncpg
import semmle.python.Concepts

class NonLiteralUserInput extends DataFlow::Node {
  NonLiteralUserInput() {
    not exists(python::StringLiteral l | l = this.asExpr()) and
    exists(DataFlow::ParameterNode p | p.asExpr() = this.asExpr())
  }
}

class AsyncpgQueryExecution extends DataFlow::Node {
  AsyncpgQueryExecution() {
    exists(DataFlow::MethodCallNode mc |
      mc.asExpr() = this.asExpr() and
      mc.getMethodName() in ["fetch", "fetchrow", "fetchval", "execute", "executemany", "prepare", "cursor", "copy_from_query"] and
      mc.getACallee().getType().getName() = "Connection"
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "AsyncpgSQLiTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof NonLiteralUserInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof AsyncpgQueryExecution and
    exists(DataFlow::MethodCallNode mc |
      mc.asExpr() = sink.asExpr() and
      mc.getArgument(0) = sink.asExpr().getAnAccess()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(DataFlow::MethodCallNode mc |
      mc.asExpr() = sanitizer.asExpr() and
      (mc.getMethodName() = "prepare" or
      (mc.getMethodName() = "execute" and mc.getArgument(0).isLiteral()))
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User input reaches SQL execution without sanitization, potential SQL injection"
