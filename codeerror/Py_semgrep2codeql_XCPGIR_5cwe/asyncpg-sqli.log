Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement
 * @kind path-problem
 * @problem.severity warning
 * @id py/asyncpg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class AsyncpgConnection extends API::Module::Member {
  AsyncpgConnection() {
    exists(API::BuiltinModule asyncpg | 
      asyncpg.getName() = "asyncpg" and
      asyncpg.getMember("Connection") = result
    )
  }
}

class UserInput extends TaintTracking::Source {
  UserInput() {
    exists(Variable v |
      v.getName().getId() matches "%USERINPUT%" and
      result = DataFlow::exprNode(v)
    )
  }
  
  override predicate isSourceOf(TaintKind kind) { kind = "SqlInjection" }
}

class SqlExecution extends TaintTracking::Sink {
  SqlExecution() {
    exists(MethodCall mc |
      mc.getMethodName() in ["fetch", "fetchrow", "fetchval", "execute",
                           "executemany", "prepare", "cursor", "copy_from_query"] and
      mc.getReceiver().(Variable).getType() instanceof AsyncpgConnection and
      result = DataFlow::exprNode(mc.getArgument(0))
    )
  }
  
  override predicate sinks(TaintKind taint) { taint = "SqlInjection" }
}

class StringConcatenation extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node node1, DataFlow::Node node2) {
    exists(BinaryOperation bo |
      bo.getOperator() = "+" and
      (node1.asExpr() = bo.getLeftOperand() or node1.asExpr() = bo.getRightOperand()) and
      node2.asExpr() = bo
    )
  }
}

class CustomTaintConfig extends TaintTracking::Configuration {
  CustomTaintConfig() { this = "asyncpg_sqli_config" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof UserInput
  }
  
  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof SqlExecution 
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodCall mc |
      mc.getMethodName() = "prepare" and
      mc.getReceiver().(Variable).getType() instanceof AsyncpgConnection and
      sanitizer = DataFlow::exprNode(mc.getArgument(0))
    )
  }

  override predicate additionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(StringConcatenation sc | sc.step(node1, node2))
  }
}

from CustomTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization",
  source, "Source of user input",
  sink, "SQL execution point"
