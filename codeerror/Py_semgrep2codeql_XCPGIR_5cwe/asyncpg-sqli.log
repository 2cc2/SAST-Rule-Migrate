Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id py/asyncpg-sqli
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.ApiGraphs

class AsyncpgConnection extends DataFlow::TrackableValue {
  AsyncpgConnection() { 
    exists(string moduleName | 
      this = API::moduleImport("asyncpg").getMember("Connection").getReturn() and
      globalValue(moduleName) = this
    )
  }
}

class UserInput extends DataFlow::Node {
  UserInput() {
    this.asRegexpMatch(".*USERINPUT.*")
  }
}

class SqlExecution extends DataFlow::Node {
  SqlExecution() {
    exists(MethodCall mc | 
      mc.getMethodName() in [
        "fetch", "fetchrow", "fetchval", "execute", 
        "executemany", "prepare", "cursor", "copy_from_query"
      ] and
      mc.getReceiver().(DataFlow::CallNode).getType().(AsyncpgConnection) and
      this = mc.getArg(0)
    )
  }
}

class StringConcatenation extends DataFlow::Node::BarrierGuard {
  override predicate isBarrier(DataFlow::Node node) {
    exists(OperatorCall oc |
      oc.getOp() = "+" and
      (
        node = oc.getLeftOperand() or
        node = oc.getRightOperand()
      ) and
      not oc.getLeftOperand().(Literal).getStringValue() and
      not oc.getRightOperand().(Literal).getStringValue()
    )
  }
}

class PrepareSanitizer extends DataFlow::Node::BarrierGuard {
  override predicate isBarrier(DataFlow::Node node) {
    exists(MethodCall mc |
      mc.getMethodName() = "prepare" and
      mc.getReceiver().(DataFlow::CallNode).getType().(AsyncpgConnection) and
      node = mc.getArg(0)
    )
  }
}

query predicate isSqliFlow(DataFlow::Node source, DataFlow::Node sink) {
  exists(DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode |
    sourceNode.asSource() = source and
    sinkNode.asSink() = sink and
    DataFlow::localFlowPath(sourceNode, sinkNode) and
    not exists(PrepareSanitizer ps |
      ps.flowFrom(sourceNode)
    )
  )
}

from UserInput input, SqlExecution sql
where isSqliFlow(input, sql)
select sql, 
  "User input reaches SQL execution without sanitization", 
  input, "Source of user input", 
  sql, "SQL execution point"
