/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 * @problem.severity warning
 * @id py/asyncpg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class AsyncpgConnection extends TaintTracking::Source {
  AsyncpgConnection() {
    exists(API::ModuleImport mi | 
      mi.getImportedName() = "asyncpg" and
      mi.getMember("Connection").getReturn().(Value) = this
    )
  }
}

class UserInput extends TaintTracking::Source {
  UserInput() {
    this.asVariable().getName().matches("%USERINPUT%")
  }

  override predicate isSource() { this = result }
  override string toString() { result = "User Input" }
}

class SqlExecution extends TaintTracking::Sink {
  SqlExecution() {
    exists(Method m | 
      m.hasName(["fetch", "fetchrow", "fetchval", "execute", 
        "executemany", "prepare", "cursor", "copy_from_query"]) and
      m.getDeclaringType().(Class).getASupertype().hasQualifiedName("asyncpg", "Connection") and
      this.asExpr() = m.getACall().getArgument(0)
    )
  }

  override predicate isSink() { this = result }
  override string toString() { result = "SQL Execution" }
}

class CustomTaintConfig extends TaintTracking::Configuration {
  CustomTaintConfig() { this = "asyncpg_sqli_config" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof UserInput
  }

