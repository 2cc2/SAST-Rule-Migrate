rule:
  id: asyncpg-sqli
  kind: taint
  severity: WARNING
  message: "Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
scope:
  languages: [python]
  frameworks: [asyncpg]
  
sources:
  - id: USER_INPUT
    match:
      node: LITERAL | IDENTIFIER
      where:
        - op: regex
          left: name
          right: ".*USERINPUT.*"

sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: { type: asyncpg.Connection, method: "(fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery)" }
      arg_index: 0

sanitizers:
  - id: PARAMETERIZED_QUERY
    match:
      node: CALL
      api: { type: asyncpg.Connection, method: "prepare" }
    effect: neutralize

barriers:
  - id: LITERAL_CONCAT
    match:
      node: CALL
      where:
        - op: eq
          left: code
          right: '"..." + "..."'
    effect: stop

propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint

flows:
  - source: USER_INPUT
    sink: SQL_EXEC
    through: [STRING_CONCAT*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(asyncpg.Connection.prepare)" } ]

report:
  message: "User input reaches SQL execution without sanitization"
  locations: ["source","sink","path"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "conn.execute('SELECT * FROM table WHERE id = ' + user_input)"
  negative:
    - "conn.execute('SELECT * FROM table WHERE id = ?', user_input)"
