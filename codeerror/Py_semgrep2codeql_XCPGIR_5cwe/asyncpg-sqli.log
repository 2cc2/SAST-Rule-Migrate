    effect:
      scope:
        sinks: [SQL_EXEC]
barriers: []
propagations:
  - id: CONCAT_PROPAGATION
    edge: arg->param
    kind: taint
flows:
  - source: USER_INPUT
    sink: SQL_EXEC
    through: [CONCAT_PROPAGATION*]
    constraints:
      path:
        must_not:
          - pattern: "METHOD(prepare)"
          - pattern: "CALL(execute) AND ARG(0) = LITERAL"
report:
  message: "User input reaches SQL execution without sanitization"
  locations: ["source","sink","path"]
  evidence:
    capture:
      - argument: 0
tests:
  positive:
    - "await conn.execute('SELECT * FROM users WHERE name = ' + user_input)"
  negative:
    - "await conn.execute('SELECT * FROM users WHERE name = $1', user_input)"
