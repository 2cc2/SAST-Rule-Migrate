 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.LocalFlowGraph

predicate isDynamicUrl(Expr arg) {
  exists(DataFlow::Node source |
    LocalFlowGraph::FlowStep(DataFlow::exprNode(arg), source) and
    not source.asExpr().toString() instanceof StringLiteral
  )
}

from Call call, Expr argument
where
  (
    // urllib.urlopen or urllib.request.urlopen
    (call.getFunction().getName() = "urlopen" and call.getChildren()[0].getType().getName() = "urllib") or
    // urllib.urlretrieve or urllib.request.urlretrieve
    (call.getFunction().getName() = "urlretrieve" and call.getChildren()[0].getType().getName() = "urllib") or
    // opener.open or opener.retrieve
    (call.getFunction().getName().regex(".*open.*") or call.getFunction().getName().regex(".*retrieve.*"))
