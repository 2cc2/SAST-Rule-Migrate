Rule Content:
/**
 * @name Dynamic urllib Use Detected
 * @description Detected a dynamic value being used with urllib. 
 * urllib supports 'file://' schemes, so a dynamic value controlled by 
 * a malicious actor may allow them to read arbitrary files.
 * @kind path-problem
 * @problem.severity warning
 * @id python/dynamic-urllib-use
 * @tags security
 *       external/cwe/cwe-200
 */

import python
import semmle.python.security.DangerousFunctions
import DataFlow::PathGraph

class UrlLibCall extends DataFlow::Node {
  UrlLibCall() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("urllib", "request") and
      (
        ma.getMethod().hasName(["urlopen", "urlretrieve", "open", "retrieve"]) or
        ma.getMethod().getName().matches("%open%") or
        ma.getMethod().getName().matches("%retrieve%")
      ) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

predicate isSafeUrlConstruction(DataFlow::Node node) {
  exists(Call call | 
    call.getTarget().getQualifiedName().matches("urllib%") or
    call.getTarget().getQualifiedName().matches("urllib.request%") or
    exists(Assignment assign | assign.getRValue() = node.asExpr())
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where 
  DataFlow::flowPath(source, sink) and
  exists(UrlLibCall urllib | urllib = sink.getNode()) and
  not isSafeUrlConstruction(source.getNode())
select sink, "Detected a dynamic value being used with urllib which may allow arbitrary file reads.", 
  source, "User controllable input flows to urllib call"
