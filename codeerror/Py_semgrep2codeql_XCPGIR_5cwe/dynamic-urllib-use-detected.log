Rule Content:
/**
 * @name Dynamic urllib Use Detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes, 
 *              so a dynamic value controlled by a malicious actor may allow them to read arbitrary files.
 * @id python/dynamic-urllib-use-detected
 * @kind problem
 * @problem.severity warning
 * @tags security
 *       extern/python/urllib
 */

import python
import semmle.python.security.UrlAccess

predicate isDynamicUrl(Expr arg) {
  exists(DataFlow::Node source |
    DataFlow::localFlow(DataFlow::exprNode(arg), source) and
    not source.asExpr() instanceof StringLiteral
  )
}

from Call call, string methodName, Expr argument
where
  (
    // urllib.urlopen or urllib.request.urlopen
    (call.getMemberName() = "urlopen" and call.getReceiver().getType().getName() = "urllib") or
    // urllib.urlretrieve or urllib.request.urlretrieve
    (call.getMemberName() = "urlretrieve" and call.getReceiver().getType().getName() = "urllib") or
    // opener.open or opener.retrieve
    (call.getMemberName().matches("%open%") or call.getMemberName().matches("%retrieve%"))
  ) and
  argument = call.getArg(0) and
  isDynamicUrl(argument)
select call, 
  "Detected a dynamic value being used with urllib. urllib supports 'file://' schemes, " +
  "so a dynamic value controlled by a malicious actor may allow them to read arbitrary files. " +
  "Audit uses of urllib calls to ensure user data cannot control the URLs, " +
  "or consider using the 'requests' library instead."
