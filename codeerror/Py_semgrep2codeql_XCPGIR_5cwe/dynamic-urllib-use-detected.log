 * @tags security
 *       external/cwe/cwe-200
 */

import python
import semmle.python.dataflow.new.DataFlow

class UrllibCall extends DataFlow::Node {
  UrllibCall() {
    exists(Call call |
      call.getCallee().getQualifiedName().matches("urllib.request.%") and
      call.getCallee().getName().matches("urlopen|urlretrieve|open|retrieve") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

predicate isSafeUrlConstruction(DataFlow::Node node) {
  exists(Call call |
    call.getCallee().getQualifiedName().matches("urllib.request.%") or
    exists(Assign assign | assign.getValue() = node.asExpr())
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  DataFlow::pathGraph(source, sink) and
  exists(UrllibCall urllib | urllib = sink.getNode()) and
  not isSafeUrlConstruction(source.getNode())
select sink, "Detected a dynamic value being used with urllib which may allow arbitrary file reads.", 
  source, "User controllable input flows to urllib call"
