            @$APP.route(...)
            def $FUNC(..., $ROUTEVAR, ...):
              ...

sinks:
  - id: SQL_CONCAT
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "\s*(?i)(select|delete|insert|create|update|alter|drop)\b.*"
        - op: or
          conditions:
            - op: has-parent
              left: "$SQLSTR" + ...
            - op: has-parent
              left: "$SQLSTR" % ...
            - op: has-parent
              left: "$SQLSTR".format(...)
            - op: has-parent
              left: f"$SQLSTR{...}..."

propagations:
  - id: STRING_OPERATION
    edge: arg->param
    kind: taint

flows:
  - source: USER_INPUT
    sink: SQL_CONCAT
    through: [STRING_OPERATION*]

report:
  message: "User input reaches SQL string construction without sanitization"
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }
