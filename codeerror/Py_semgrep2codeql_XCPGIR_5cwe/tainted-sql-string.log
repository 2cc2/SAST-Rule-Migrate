/**
 * @name Tainted SQL string construction
 * @description Detected user input used to manually construct a SQL string. This could result in SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/tainted-sql-string
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Request
import DataFlow::PathGraph

class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(Call call |
      call.getFunc().toString().matches("flask.request%") and
      this.asExpr() = call
    )
  }
}

class SqlStringConcatSink extends DataFlow::Node {
  SqlStringConcatSink() {
    // String concatenation with +
    exists(Add add |
      add.getLeft().getStringValue().matches("%SQLSTR%") and
      this.asExpr() = add
    )
    or
    // String formatting with %
    exists(BinOp mod |
      mod.getOp() = "%" and
      mod.getLeft().getStringValue().matches("%SQLSTR%") and
      this.asExpr() = mod
    )
    or
    // String .format()
    exists(Call formatCall |
      formatCall.getFunc().getName() = "format" and
      formatCall.getFunc().getQualifier().getStringValue().matches("%SQLSTR%") and
      this.asExpr() = formatCall.getFunc().getQualifier()
    )
    or
    // F-strings
    exists(FString fstr |
      fstr.getStringValue().matches("%SQLSTR%") and
      this.asExpr() = fstr
    )
  }
}

class TaintedSQLStringConfig extends TaintTracking::Configuration {
  TaintedSQLStringConfig() { this = "TaintedSQLStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskUserInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlStringConcatSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof Return
  }
}

