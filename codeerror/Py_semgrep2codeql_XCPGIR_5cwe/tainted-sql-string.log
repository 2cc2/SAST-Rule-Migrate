Rule Content:
/**
 * @name Tainted SQL string construction
 * @description Detected user input used to manually construct a SQL string. This could result in SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @id python/tainted-sql-string
 */

import python
import DataFlow::PathGraph
import semmle.python.web.flask.Request

class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(CallNode call |
      call.getTarget().getQualifiedName().matches("flask\.request\..*") and
      this.asExpr() = call
    )
  }
}

class SqlStringConcatSink extends DataFlow::Node {
  SqlStringConcatSink() {
    // Match string concatenation with +
    exists(BinaryExpr bin |
      bin.getOperator() = "+" and
      bin.getLeft().getStringValue().regexpMatch(".*SQLSTR.*") and
      this.asExpr() = bin
    )
    or
    // Match string formatting with %
    exists(BinaryExpr bin |
      bin.getOperator() = "%" and
      bin.getLeft().getStringValue().regexpMatch(".*SQLSTR.*") and
      this.asExpr() = bin
    )
    or
    // Match string formatting with .format()
    exists(CallNode call |
      call.getTarget().getName() = "format" and
      call.getQualifier().getStringValue().regexpMatch(".*SQLSTR.*") and
      this.asExpr() = call.getQualifier()
    )
    or
    // Match f-strings
    exists(InterpolatedString str |
      str.getStringValue().regexpMatch(".*SQLSTR.*") and
      this.asExpr() = str
    )
  }
}

class TaintedSQLStringConfig extends TaintTracking::Configuration {
  TaintedSQLStringConfig() { this = "TaintedSQLStringConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof FlaskUserInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlStringConcatSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(ReturnStmt ret | sanitizer.asExpr() = ret)
  }
}

from TaintedSQLStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "User input reaches SQL string construction without parameterization", source, sink,
  "User-provided value from $@ flows into SQL string construction.", source, "here"
