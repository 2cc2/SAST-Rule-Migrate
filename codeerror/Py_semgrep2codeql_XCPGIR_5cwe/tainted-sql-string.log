Rule Content:
/**
 * @name Tainted SQL string construction
 * @description Detected user input used to manually construct a SQL string. This could result in SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/tainted-sql-string
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.FlaskRequest
import DataFlow::PathGraph

class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName().matches("flask\.request\..*") and
      ma = this.asExpr()
    )
  }
}

class SqlStringConcatSink extends DataFlow::Node {
  SqlStringConcatSink() {
    exists(string str |
      str = this.asExpr().(StringLiteral).getText() and
      str.matches(".*(\\$SQLSTR\\+)|(\\$SQLSTR%)|(\\$SQLSTR\\.format)|(f\\$SQLSTR\\{).*")
    )
    or
    exists(MethodCall mc |
      mc.getMethod().getName() matches "format" and
      this.asExpr() = mc.getQualifier()
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TaintedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskUserInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlStringConcatSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof Return
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "User input reaches SQL string construction without parameterization", source, sink,
  "User-provided value from $@ flows into SQL string construction.", source, "here"
