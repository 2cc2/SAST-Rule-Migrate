Rule Content:
/**
 * @name Tainted SQL String Construction
 * @description Detects user input used to manually construct a SQL string, which could potentially lead to SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @id python/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import DataFlow::PathGraph
import python.web.flask
import HttpRequest::Request
import TaintTracking::TaintTracking

class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(CallExpr call |
      call.getFunc().(NameExpr).getId() = "request" and
      call.getFunc().getReceiverType().getName() = "Flask" and
      this = call.getArg()
    ) or
    exists(FunctionDef route, Parameter p |
      exists(Decorator d |
        d.getExpr().(NameExpr).getId().matches("@.*\\.route") and
        d.getParent() = route
      ) and
      p = route.getAParameter() and
      this = p
    )
  }
}

class StringOperation extends DataFlow::Node {
  StringOperation() {
    exists(DataFlow::Node base, DataFlow::Node arg |
      exists(BinaryExpr add |
        add.getOp() = "+" and
        add.getLeft() = base and
        add.getRight() = arg and
        this = add
      ) or
      exists(BinaryExpr mod |
        mod.getOp() = "%" and
        mod.getLeft() = base and
        mod.getRight() = arg and
        this = mod
      ) or
      exists(CallExpr format |
        format.getFunc().(MemberExpr).getMemberName() = "format" and
        format.getFunc().getReceiver() = base and
        arg = format.getArg() and
        this = format
      ) or
      exists(FormattedValue fv |
        fv.getParent() = base and
        arg = fv.getValue() and
        this = fv.getParent()
      )
    )
  }
}

class SqlStringConstruction extends DataFlow::Node {
  SqlStringConstruction() {
    exists(Str lit |
      lit.getValue().regexpMatch("(?i)\\b(select|delete|insert|create|update|alter|drop)\\b") and
      exists(StringOperation strOp | strOp.asExpr() = lit.getParent() and this = strOp)
    )
  }
}

class TaintedSqlStringFlowConfiguration extends TaintTracking::Configuration {
  TaintedSqlStringFlowConfiguration() { 
    this = "Tainted SQL Injection Check" 
  }

  override predicate isSource(DataFlow::Node source) { source instanceof FlaskUserInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlStringConstruction }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringOperation strOp |
      pred = strOp.getAnOperand() and succ = strOp
    )
  }
}

from TaintedSqlStringFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL string construction without sanitization, which could lead to SQL injection.",
  source, source.toString(), sink, sink.toString()
