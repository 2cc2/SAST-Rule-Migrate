Rule Content:
/**
 * @name Tainted SQL String Construction
 * @description Detects user input used to manually construct a SQL string, which could potentially lead to SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @id python/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.web.flask
import semmle.python.web.HttpRequest

class FlaskUserInput extends Dataflow::Node {
  FlaskUserInput() {
    exists(MethodAccess ma | 
      ma.getMethod().getAPIName() = "request" and
      ma.getReceiver().getType().getName() = "flask" and
      result = ma.getAnArgument()
    ) or
    exists(FunctionValue route, Parameter p |
      route.getLocation().getFile().getRelativePath().regexpMatch("@.*\.route") and
      p = route.getAParameter() and
      result.asParameter() = p
    )
  }
}

class StringOperation extends Dataflow::Node {
  StringOperation() {
    exists(Dataflow::Node base, Dataflow::Node arg |
      exists(AdditionExpr add | add.getLeftOperand() = base and add.getRightOperand() = arg and result = add) or
      exists(ModuloExpr mod | mod.getLeftOperand() = base and mod.getRightOperand() = arg and result = mod) or
      exists(MethodCall format | 
        format.getMethod().getName() = "format" and 
        format.getQualifier() = base and 
        arg = format.getAnArgument() and
        result = format
      ) or
      exists(FormatString fs | 
        fs.getBaseString() = base and
        arg = fs.getAnInsertion() and
        result = fs
      )
    )
  }
}

class SqlStringConstruction extends Dataflow::Node {
  SqlStringConstruction() {
    exists(LiteralNode lit |
      lit.getStringValue().regexpMatch("(?i)\\b(select|delete|insert|create|update|alter|drop)\\b") and
      exists(Dataflow::Node parentNode | 
        parentNode = lit.getParent() and
        parentNode instanceof StringOperation and
        result = parentNode
      )
    )
  }
}

class TaintedSqlStringConfiguration extends TaintTracking::Configuration {
  TaintedSqlStringConfiguration() { this = "TaintedSQLString" }

  override predicate isSource(Dataflow::Node source) { source instanceof FlaskUserInput }

  override predicate isSink(Dataflow::Node sink) { sink instanceof SqlStringConstruction }

  override predicate isAdditionalTaintStep(Dataflow::Node pred, Dataflow::Node succ) {
    exists(StringOperation strOp |
      pred = strOp.getAOperand() and succ = strOp
    )
  }
}

from TaintedSqlStringConfiguration cfg, Dataflow::PathNode source, Dataflow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL string construction without sanitization, which could lead to SQL injection.",
  source.getNode(), "User input from here", sink.getNode(), "Used in SQL string construction here"
