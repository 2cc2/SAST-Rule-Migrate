```yaml
xcpgir_version: "1.0"
rule:
  id: python.tainted-sql-string
  kind: taint
  severity: ERROR
  message: "Detected user input used to manually construct a SQL string. This could result in SQL injection."
  scope:
    languages: [python]
    frameworks: [flask, sqlalchemy]
    env: { os: [linux, windows], shell: [bash, sh] }

sources:
  - id: USER_INPUT
    match:
      node: CALL
      where:
        - op: regex
          left: methodFullName
          right: "flask\.request\..*"
      # OR route parameter patterns would need complex matching not fully expressible here

sinks:
  - id: SQL_STRING_CONCAT
    match:
      node: CALL | LITERAL
      where:
        - op: regex
          left: code
          right: "(\"\\$SQLSTR\" \\+)|(\"\\$SQLSTR\" %)|(\"\\$SQLSTR\"\.format)|(f\"\\$SQLSTR\{)"

propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint

barriers:
  - id: RETURN_STOP
    match: { node: RETURN }
    effect: stop

flows:
  - source: USER_INPUT
    sink: SQL_STRING_CONCAT
    through: [STRING_CONCAT*]
    
report:
  message: "User input reaches SQL string construction without parameterization"
  locations: ["source", "sink"]
  evidence: { capture: [{ node: "sink" }] }

tests:
  positive:
    - "query = \"SELECT * FROM users WHERE name = '\" + request.args.get('name') + \"'\""
  negative:
    - "query = \"SELECT * FROM users WHERE name = ?\""
```
