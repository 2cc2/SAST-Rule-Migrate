Rule Content:
/**
 * @name Tainted SQL string construction
 * @description Detected user input used to manually construct a SQL string. This could result in SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/tainted-sql-string
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

private class FlaskSourceCandidate extends DataFlow::Node {
  FlaskSourceCandidate() {
    exists(FunctionCall call |
      call.getTarget().toString().matches("flask.request%") and
      this.asExpr() = call
    )
  }
}

private class StringConcatCandidate extends DataFlow::Node {
  StringConcatCandidate() {
    exists(BinaryOperation bin |
      bin.getOperator() = "+" and
      bin.getLeftOperand().getStringValue().matches("SQLSTR") and
      this.asExpr() = bin
    )
    or
    exists(BinaryOperation bin |
      bin.getOperator() = "%" and
      bin.getLeftOperand().getStringValue().matches("SQLSTR") and
      this.asExpr() = bin
    )
    or
    exists(FunctionCall call |
      call.getTarget().getName() = "format" and
      call.getQualifier().getStringValue().matches("SQLSTR") and
      this.asExpr() = call.getQualifier()
    )
    or
    exists(InterpolatedString str |
      str.getStringValue().matches("SQLSTR") and
      this.asExpr() = str
    )
  }
}

class FlaskUserInput extends TaintTracking::TaintSource {
  FlaskUserInput() { this.asExpr() instanceof FlaskSourceCandidate }
  
  override string getSourceType() { result = "Flask user input" }
}

class SqlStringConcatSink extends TaintTracking::TaintSink {
  SqlStringConcatSink() { this.asExpr() instanceof StringConcatCandidate }
  
  override string getSinkType() { result = "SQL string concatenation" }
}

class TaintedSQLStringConfig extends TaintTracking::Configuration {
  TaintedSQLStringConfig() { this = "TaintedSQLStringConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskUserInput
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SqlStringConcatSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer.asExpr() instanceof ReturnStmt
  }
}

from TaintedSQLStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "User input reaches SQL string construction without parameterization", source, sink,
  "User-provided value from $@ flows into SQL string construction.", source, "here"
================================================================================
