Rule Content:
/**
 * @name aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg Python SQL statement.
 * @id python/aiopg-sqli
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class AiopgCursorExecute extends DataFlow::Node {
  AiopgCursorExecute() {
    exists(DataFlow::Method m, DataFlow::Class c |
      m.getName() = "execute" and
      m.getDeclaringClass() = c and
      c.getName() = "Cursor" and
      c.getFile().getBaseName() = "aiopg" and
      this.(DataFlow::CallNode).getMethod() = m
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Name n |
      n.getId().matches("%USERINPUT%") and
      this.asExpr() = n
    )
  }

  override predicate asCfgNode() { none() }
  override DataFlow::Location getLocation() { result = this.asExpr().getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override DataFlow::Scope getScope() { result = this.asExpr().getScope() }
  override predicate asVariable() { none() }
}

class StringConcatConfig extends TaintTracking::Configuration {
  StringConcatConfig() { this = "StringConcatConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof AiopgCursorExecute
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::BinaryExpr bin |
      bin.getOperator() = "+" and
      (bin.getLeftOperand().getType().getName() = "str" or
       bin.getRightOperand().getType().getName() = "str") and
      (pred.asExpr() = bin.getLeftOperand() and succ.asExpr() = bin) or
      (pred.asExpr() = bin.getRightOperand() and succ.asExpr() = bin)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral lit |
      node.asExpr() = lit and
      lit.getValue().matches("^SELECT %s|^INSERT %s|^UPDATE %s")
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, StringConcatConfig config
where config.hasFlowPath(source, sink)
select sink, "User input reaches SQL execution without parameterized query", source, sink,
  "Potential SQL injection through string concatenation in aiopg.execute() call"
