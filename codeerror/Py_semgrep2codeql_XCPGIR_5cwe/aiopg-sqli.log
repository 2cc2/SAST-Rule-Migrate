  evidence: 
    capture: 
      - { argument: 0 }
      - { variable: "$QUERY" }

tests:
  positive:
    - "cursor.execute('SELECT * FROM table WHERE id = ' + user_input)"
  negative:
    - "cursor.execute('SELECT * FROM table WHERE id = %s', (user_input,))"
