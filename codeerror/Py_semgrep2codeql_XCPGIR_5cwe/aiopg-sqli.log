    match:
      node: "CALL"
      api: { type: "aiopg.Cursor", method: "execute" }
      where:
        - op: "regex"
          left: "arg[0].value"
          right: "^SELECT %s|^INSERT %s|^UPDATE %s"

propagations:
  - id: "STRING_CONCAT"
    edge: "arg->param"
    kind: "taint"
    where:
      - op: "in"
        left: "typeFullName"
