```yaml
xcpgir_version: "1.0"
rule:
  id: "aiopg-sqli"
  kind: "taint"
  severity: "WARNING"
  message: "Detected string concatenation with a non-literal variable in an aiopg Python SQL statement. This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
scope:
  languages: ["python"]
  frameworks: ["aiopg"]
  env: { os: ["*"], shell: ["*"] }

sources:
  - id: "USER_INPUT"
    match:
      node: "IDENTIFIER"
      where:
        - op: "regex"
          left: "name"
          right: ".*USERINPUT.*"

sinks:
  - id: "SQL_EXEC"
    match:
      node: "CALL"
      api: { type: "aiopg.Cursor", method: "execute" }
      arg_index: 0

sanitizers:
  - id: "PARAMETERIZED_QUERY"
    match:
      node: "CALL"
      api: { type: "aiopg.Cursor", method: "execute" }
      where:
        - op: "regex"
          left: "arg[0].value"
          right: "^SELECT %s|^INSERT %s|^UPDATE %s"

propagations:
  - id: "STRING_CONCAT"
    edge: "arg->param"
    kind: "taint"
    where:
      - op: "in"
        left: "typeFullName"
        right: ["str", "unicode"]

flows:
  - source: "USER_INPUT"
    sink: "SQL_EXEC"
    through: ["STRING_CONCAT*"]
    constraints:
      path:
        must_not: 
          - { pattern: "CALL(aiopg.Cursor.execute) WITH ARG(0) LITERAL" }

report:
  message: "User input reaches SQL execution without parameterized query"
  locations: ["source", "sink", "path"]
  evidence: 
    capture: 
      - { argument: 0 }
      - { variable: "$QUERY" }

tests:
  positive:
    - "cursor.execute('SELECT * FROM table WHERE id = ' + user_input)"
  negative:
    - "cursor.execute('SELECT * FROM table WHERE id = %s', (user_input,))"
