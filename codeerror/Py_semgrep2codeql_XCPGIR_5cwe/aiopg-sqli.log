Rule Content:
/**
 * @name aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg Python SQL statement.
 * @id python/aiopg-sqli
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.BasicApi

class AiopgCursorExecute extends DataFlow::CallNode {
  AiopgCursorExecute() {
    exists(Method m, Class c |
      m.getName() = "execute" and
      m.getDeclaringClass() = c and
      c.getName() = "Cursor" and
      c.getModule().getName() = "aiopg" and
      this.getTarget() = m
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Name n |
      n.getId().matches("%USERINPUT%") and
      this.asExpr() = n
    )
  }
}

class StringConcatPropagation extends TaintTracking::AdditionalTaintStep {
  override step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::BinaryExpr bin |
      bin.getOp() = "+" and
      (
        bin.getLeftOperand().getType().getName() in ["str", "unicode"] or
        bin.getRightOperand().getType().getName() in ["str", "unicode"]
      ) and
      (pred.asExpr() = bin.getLeftOperand() and succ.asExpr() = bin) or
      (pred.asExpr() = bin.getRightOperand() and succ.asExpr() = bin)
    )
  }
}

class SafeParameterizedQuerySanitizer extends DataFlow::Node {
  SafeParameterizedQuerySanitizer() {
    exists(AiopgCursorExecute call, StringLiteral lit |
      call.getArgument(0) = lit and
      lit.getValue().matches("^SELECT %s|^INSERT %s|^UPDATE %s")
    )
  }
}

query predicate isUserInputReachingSQLExecution(
  DataFlow::Node source, DataFlow::Node sink
) {
  exists(UserInputSource src, AiopgCursorExecute snk |
    src = source and
    snk = sink and
    not exists(SafeParameterizedQuerySanitizer sanitizer |
      sanitizer = sink
    )
  )
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where
  isUserInputReachingSQLExecution(source.getNode(), sink.getNode()) and
  TaintTracking::localTaint(DataFlow::exprNode(source), DataFlow::exprNode(sink), cfg)
select sink, "User input reaches SQL execution without parameterized query", source, sink,
  "Potential SQL injection through string concatenation in aiopg.execute() call"
