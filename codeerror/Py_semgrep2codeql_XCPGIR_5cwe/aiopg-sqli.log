Rule Content:
/**
 * @name aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/aiopg-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class AiopgCursorExecuteCall extends DataFlow::CallNode {
  AiopgCursorExecuteCall() {
    exists(MethodValue meth |
      meth = this.getMethod() and
      meth.getName() = "execute" and
      meth.getDeclaringType().getQualifiedName() = "aiopg.Cursor"
    )
  }

  int getQueryArg() { result = 0 }
  int getParamsArg() { result = 1 }
}

predicate isUserInput(DataFlow::Node node) {
  exists(string name |
    name = node.asExpr().(Name).getId() and
    regexpMatch(".*USERINPUT.*|.*X.*|.*Y.*", name)
  )
}

class SqlInjectionConfiguration extends TaintTracking::Configuration {
  SqlInjectionConfiguration() { this = "AiopgSQLInjection" }

  override predicate isSource(DataFlow::Node source) {
    isUserInput(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(AiopgCursorExecuteCall call |
      call.getQueryArg() = sink.asDefiningArgument().getParameterPosition() and
      sink.asDefiningArgument().getCall() = call
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(AiopgCursorExecuteCall call |
      call.getParamsArg() = node.asDefiningArgument().getParameterPosition() and
      node.asDefiningArgument().getCall() = call
    )
  }

  override predicate isAdditionalFlowStep(DataFlow::Node nodeFrom, DataFlow::Node nodeTo) {
    exists(string formatOp |
      formatOp = "%" or formatOp = "+" or formatOp = "format" |
      exists(DataFlow::BinaryExpr bin |
        bin.getOperator() = formatOp and
        (bin.getLeftOperand() = nodeFrom.asExpr() and bin.getRightOperand() = nodeTo.asExpr() or
         bin.getRightOperand() = nodeFrom.asExpr() and bin.getLeftOperand() = nodeTo.asExpr())
      ) or
      exists(DataFlow::CallNode call |
        call.getTarget().getName() = "format" and
        (
          nodeFrom.asExpr() = call.getArg(formatOp) and nodeTo.asExpr() = call.getReceiver() or
          nodeFrom.asExpr() = call.getReceiver() and nodeTo.asExpr() = call.getArg(formatOp)
        )
      )
    )
  }
}

from SqlInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential SQL injection via string concatenation in aiopg SQL statement", source, sink,
  "User input $@ flows into SQL query here and is not properly sanitized.", source.getNode(), source.toString()
