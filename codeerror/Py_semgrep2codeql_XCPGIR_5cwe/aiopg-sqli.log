```yaml
xcpgir_version: "1.0"
rule:
  id: "aiopg-sqli"
  kind: taint
  severity: WARNING
  message: "Detected string concatenation with a non-literal variable in an aiopg Python SQL statement. This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
scope:
  languages: [python]
  frameworks: ["aiopg"]

sources:
  - id: USER_INPUT
    match:
      node: IDENTIFIER
      where:
        - op: regex
          left: name
          right: ".*USERINPUT.*|.*X.*|.*Y.*"

sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: { method: "execute" }
      type: "Cursor"
      arg_index: 0

sanitizers:
  - id: PARAMETRIZED_QUERY
    match:
      node: CALL
      api: { method: "execute" }
      arg_index: 1
    effect: neutralize
    scope: { sinks: [SQL_EXEC] }

barriers:
  - id: RETURN_STOP
    match: { node: RETURN }
    effect: stop

propagations:
  - id: STR_CONCAT
    edge: arg->arg
    kind: taint
  - id: STR_FORMAT
    edge: arg->arg
    kind: taint

flows:
  - source: USER_INPUT
    sink: SQL_EXEC
    through: [STR_CONCAT*, STR_FORMAT*]
    constraints:
      path:
        must_not:
          - { pattern: "CALL(Cursor.execute) WITH_ARG(1)" }

report:
  message: "Potential SQL injection via string concatenation in aiopg SQL statement"
  locations: ["source", "sink", "path"]
  evidence:
    capture:
      - { argument: 0 }

tests:
  positive:
    - "cur.execute('SELECT * FROM table WHERE id = ' + user_input)"
    - "cur.execute(f'SELECT * FROM table WHERE id = {user_input}')"
  negative:
    - "cur.execute('SELECT * FROM table WHERE id = %s', (user_input,))"
