            - pattern: flask.make_response("...", ...)
            - pattern: 'flask.make_response({"...": "..."}, ...)'
            - pattern: flask.make_response(flask.redirect(...), ...)
            - pattern: flask.make_response(flask.render_template(...), ...)
            - pattern: flask.make_response(flask.jsonify(...), ...)
            - pattern: flask.make_response(json.dumps(...), ...)

sinks:
  - id: XSS_SINK
    match:
      node: CALL
      api: { package: flask, method: make_response }
      arg_index: 0

sanitizers:
  - id: SAFE_RENDER
    match:
      node: CALL
      api: { package: flask, method: render_template }
    effect: neutralize
  - id: SAFE_JSON
    match:
      node: CALL
      api: { package: flask, method: jsonify }
    effect: neutralize

propagations:
  - id: ARG_TO_RESPONSE
    edge: arg->param
    kind: taint

flows:
  - source: UNTRUSTED_CONTENT
    sink: XSS_SINK
    through: [ARG_TO_RESPONSE]
    constraints:
      path:
        must_not:
          - pattern: "CALL(flask.render_template)"
          - pattern: "CALL(flask.jsonify)"
          - pattern: "CALL(json.dumps)"

report:
  locations: ["source", "sink"]
  evidence:
    capture: [{ argument: 0 }]
```
