import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class FlaskMakeResponseCall extends DataFlow::CallNode {
  FlaskMakeResponseCall() {
    this.getTarget().getName() = "make_response" and
    (
      this.getTarget().getQualifier().getName() = "flask" or
      this.getTarget().getQualifier().getName() = "Flask"
    )
  }
}

class SafeRenderCall extends DataFlow::CallNode {
  SafeRenderCall() {
    this.getTarget().getName() = "render_template" and
    (
      this.getTarget().getQualifier().getName() = "flask" or
      this.getTarget().getQualifier().getName() = "Flask"
    )
  }
}

class SafeJsonCall extends DataFlow::CallNode {
  SafeJsonCall() {
    (
      (this.getTarget().getName() = "jsonify" and
       (this.getTarget().getQualifier().getName() = "flask" or
        this.getTarget().getQualifier().getName() = "Flask")
      ) or
      (this.getTarget().getName() = "dumps" and
       this.getTarget().getQualifier().getName() = "json")
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "make-response-with-unknown-content" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(FlaskMakeResponseCall call |
      source.asExpr() = call.getArgument(0) and
      not exists(SafeRenderCall safe | safe.(DataFlow::ExprNode) = call.getArgument(0).getAChildExpr*()) and
      not exists(SafeJsonCall safe | safe.(DataFlow::ExprNode) = call.getArgument(0).getAChildExpr*())
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(FlaskMakeResponseCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SafeRenderCall call | sanitizer.asExpr() = call) or
    exists(SafeJsonCall call | sanitizer.asExpr() = call)
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
