      this.getTarget().getName() = "jsonify"
    )
  }
}

class UnsafeMakeResponse extends FunctionCall {
  UnsafeMakeResponse() {
    exists(Module m |
      isFlaskImport(m) and
      this.getTarget().getName() = "make_response" and
      not (
        this.getAnArg() instanceof SafeTemplate or
        this.getAnArg() instanceof SafeJsonify
