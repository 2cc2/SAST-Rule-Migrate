Rule Content:
/**
 * @name make-response-with-unknown-content
 * @description Be careful with `flask.make_response()`. If this response is rendered onto a webpage,
 * this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()`
 * will not autoescape HTML. If you are rendering HTML, write your HTML in a template
 * file and use `flask.render_template()` which will take care of escaping.
 * If you are returning data from an API, consider using `flask.jsonify()`.
 * @kind problem
 * @problem.severity warning
 * @id python/xss/flask-make-response
 */

import python
import semmle.python.functions.Calls

predicate isFlaskFunctionCall(Call c, string name) {
  exists(Module m | 
    m.getName() = "flask" and
    c.getTarget().getName() = name
  )
}

class SafeTemplate extends Call {
  SafeTemplate() {
    isFlaskFunctionCall(this, "render_template")
  }
}

class SafeJsonify extends Call {
  SafeJsonify() {
    isFlaskFunctionCall(this, "jsonify")
  }
}

class UnsafeMakeResponse extends Call {
  UnsafeMakeResponse() {
    isFlaskFunctionCall(this, "make_response") and
    not exists(SafeTemplate s | s = this.getArg(0)) and
    not exists(SafeJsonify j | j = this.getArg(0))
  }
}

from UnsafeMakeResponse response
select response, "Potential XSS vulnerability detected when using flask.make_response()", 
  response, "Unsafe response creation without proper escaping"
