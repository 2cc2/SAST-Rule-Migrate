Rule Content:
/**
 * @name make-response-with-unknown-content
 * @description Detects unsafe usage of flask.make_response() that could lead to XSS vulnerabilities
 * @kind path-problem
 * @problem.severity warning
 * @id python/make-response-with-unknown-content
 */

import python
import semantic
import DataFlow
import semmle.python.security.XSS
import semmle.python.ApiGraphs
import semmle.python.web.Flask

class FlaskMakeResponseCall extends API::CallNode {
  FlaskMakeResponseCall() {
    exists(string moduleName, string className | this.getImportedPackageCall(moduleName, className, "make_response") |
      moduleName = "flask" or
      moduleName = "Flask"
    )
  }
}

class SafeContentCall extends API::CallNode {
  SafeContentCall() {
    exists(string moduleName, string className | this.getImportedPackageCall(moduleName, className, funcName) |
      moduleName = "flask" or moduleName = "Flask" or moduleName = "json" |
      funcName = "render_template" or
      funcName = "jsonify" or
      funcName = "dumps"
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "make-response-with-unknown-content" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(FlaskMakeResponseCall call |
      source.asExpr() = call.getArgument(0) and
      not exists(SafeContentCall safeCall |
        call.getArgument(0).getAChildExpr*() = safeCall
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(FlaskMakeResponseCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SafeContentCall call |
      sanitizer.asExpr() = call
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential XSS vulnerability from unsafe content in flask.make_response(). " +
  "Use flask.render_template(), flask.jsonify() or json.dumps() for safe content rendering.", 
  source, sink
