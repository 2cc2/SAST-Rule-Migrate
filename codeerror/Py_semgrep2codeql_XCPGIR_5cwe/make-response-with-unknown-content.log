 * @problem.severity warning
 * @id python/xss/flask-make-response
 */

import python
import DataFlow::PathGraph

predicate isFlaskImport(Module m) {
  m.getName() = "flask"
}

class SafeTemplate extends FunctionCall {
  SafeTemplate() {
    exists(Module m | 
      isFlaskImport(m) and
      this.getTarget().getName() = "render_template"
