    )
  }
}

class SafeRenderCall extends API::CallNode {
  SafeRenderCall() {
    this.getTarget().hasName("render_template") and
    (
      this.getTarget().getQualifier().hasName("flask") or
      this.getTarget().getQualifier().hasName("Flask")
    )
  }
}

class SafeJsonCall extends API::CallNode {
  SafeJsonCall() {
    (
      (this.getTarget().hasName("jsonify") and
       (this.getTarget().getQualifier().hasName("flask") or
        this.getTarget().getQualifier().hasName("Flask"))
      ) or
      (this.getTarget().hasName("dumps") and
       this.getTarget().getQualifier().hasName("json"))
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "make-response-with-unknown-content" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(FlaskMakeResponseCall call |
      source.asExpr() = call.getArgument(0) and
      not call.getArgument(0).getStringValue() and
      not exists(API::CallNode redirect | 
        redirect.getTarget().hasName("redirect") and
        redirect.getQualifier().hasName(["flask", "Flask"]) and
        call.getArgument(0).getAChildExpr*() = redirect
      ) and
      not exists(SafeRenderCall safe | 
        call.getArgument(0).getAChildExpr*() = safe
      ) and
      not exists(SafeJsonCall safe |
        call.getArgument(0).getAChildExpr*() = safe
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(FlaskMakeResponseCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SafeRenderCall call | sanitizer.asExpr() = call) or
    exists(SafeJsonCall call | sanitizer.asExpr() = call)
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential XSS vulnerability from unsafe content in flask.make_response(). " +
  "Use flask.render_template(), flask.jsonify() or json.dumps() for safe content rendering.",
  source, sink
================================================================================
