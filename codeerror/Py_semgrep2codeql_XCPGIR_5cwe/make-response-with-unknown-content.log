Rule Content:
/**
 * @name make-response-with-unknown-content
 * @description Detects unsafe usage of flask.make_response() that could lead to XSS vulnerabilities
 * @kind path-problem
 * @problem.severity warning
 * @id python/make-response-with-unknown-content
 */

import python
import DataFlow
import DataFlow::PathGraph

class FlaskMakeResponseCall extends DataFlow::CallNode {
  FlaskMakeResponseCall() {
    this.getTarget().toString() = "flask.make_response" or
    this.getTarget().toString() = "Flask.make_response"
  }
}

class SafeRenderCall extends DataFlow::CallNode {
  SafeRenderCall() {
    this.getTarget().toString() = "flask.render_template" or
    this.getTarget().toString() = "Flask.render_template"
  }
}

class SafeJsonCall extends DataFlow::CallNode {
  SafeJsonCall() {
    this.getTarget().toString() = "flask.jsonify" or
    this.getTarget().toString() = "Flask.jsonify" or
    this.getTarget().toString() = "json.dumps"
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "make-response-with-unknown-content" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(FlaskMakeResponseCall call |
      source.asExpr() = call.getArgument(0) and
      not exists(SafeRenderCall safeRender |
        call.getArgument(0).getExpr().getAChildExpr*() = safeRender
      ) and
      not exists(SafeJsonCall safeJson |
        call.getArgument(0).getExpr().getAChildExpr*() = safeJson
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(FlaskMakeResponseCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SafeRenderCall call | sanitizer.asExpr() = call) or
    exists(SafeJsonCall call | sanitizer.asExpr() = call)
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential XSS vulnerability from unsafe content in flask.make_response(). " +
  "Use flask.render_template(), flask.jsonify() or json.dumps() for safe content rendering.", 
  source, sink
