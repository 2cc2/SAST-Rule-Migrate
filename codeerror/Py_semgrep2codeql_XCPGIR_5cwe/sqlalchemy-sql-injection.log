Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause SQL injections 
 * if the developer inputs raw SQL into these clauses. Use bindparams to securely bind user-input to SQL statements
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.DataFlow
import DataFlow::PathGraph

private class UserInput extends DataFlow::Node {
  UserInput() {
    exists(DataFlow::ParameterNode p |
      p.asExpr() = this.asExpr() and
      p.getName() != ""
    )
  }
}

private class SqliSink extends DataFlow::Node {
  SqliSink() {
    exists(MethodCall call, string method |
      call.getMethodName() = method and
      method.regexpMatch("(group_by|order_by|distinct|having|filter)") and
      call.getAPackageName() = "sqlalchemy" and
      call.getArgument(0) = this.asExpr() and
      this.asExpr().toString().regexpMatch(".*\\.format\\(.*\\).*")
    )
  }
}

private class Sanitizer extends DataFlow::BarrierGuard {
  Sanitizer() {
    exists(MethodCall call |
      call.getMethodName() = "bindparams" and
      call.getAPackageName() = "sqlalchemy"
    )
  }
}

from UserInput source, SqliSink sink
where DataFlow::localFlow(source, sink) and
  not exists(Sanitizer s | DataFlow::flowsThrough(source, sink, s))
select sink, source, sink,
  "Potential SQL injection in SQLAlchemy query due to unsafe string formatting. Use bindparams instead."
