Rule Content:
/**
 * @name SQLAlchemy SQL Injection in Clauses
 * @description Detects potential SQL injection in SQLAlchemy's distinct, having, group_by, order_by, 
 *              and filter clauses when raw SQL with user input is used without bindparams.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class UserInputSource extends TaintTracking::Source::Range {
  UserInputSource() {
    exists(Expr e |
      e = this.asExpr() and
      e.(Parameter).getValue().matches("^\\$[A-Za-z]")
    )
  }

  override predicate isSourceOf(DataFlow::Node node) { this = node }

  override string getSourceType() { "User input" }
}

class SqlAlchemySink extends TaintTracking::Sink::Range {
  SqlAlchemySink() {
    exists(DataFlow::Call call |
      call.getMethodName() in ["group_by", "order_by", "distinct", "having", "filter"] and
      call.getQualifier().getType().hasQualifiedName("sqlalchemy.orm.query", "Query") and
      exists(DataFlow::Call formatCall |
        formatCall.getMethodName() = "format" and
        formatCall.getQualifier().getType().getName() = "str" and
        not exists(DataFlow::Call bindCall |
          bindCall.getMethodName() = "bindparams" and
          bindCall.getQualifier().getType().getName() = "str"
        ) and
        formatCall = call.getArgument(0)
      ) and
      this = call.getArgument(0)
    )
  }

  override string getSinkType() { "SQL clause sink" }
}

class BindParamsSanitizer extends TaintTracking::Sanitizer::Range {
  BindParamsSanitizer() {
    exists(DataFlow::Call call |
      call.getMethodName() = "bindparams" and
      call.getQualifier().getType().getName() = "str" and
      this = call
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "SqlAlchemyInjection" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlAlchemySink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof BindParamsSanitizer }
}

from Config cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential SQL injection in SQLAlchemy clause: $@", source, sink,
  source, "User input source",
  sink, "SQL clause sink location"
