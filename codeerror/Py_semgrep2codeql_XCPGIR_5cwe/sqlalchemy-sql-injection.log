import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs

predicate isUserInput(DataFlow::Node node) {
  exists(DataFlow::ParameterNode param |
    param.getQualifiedName() != "" and
    node = param
  )
}

predicate isSqlInjectionSink(DataFlow::Node node) {
  exists(MethodCallNode call |
    call.getMethodName().matches("group_by|order_by|distinct|having|filter") and
    call.getAPackageName() = "sqlalchemy" and
    call.getArgument(0).toString().matches(".*\\.format\\(.*\\).*") and
    node = call.getArgument(0)
  )
}

predicate isSafeBinding(DataFlow::Node node) {
  exists(MethodCallNode call |
    call.getMethodName() = "bindparams" and
    call.getAPackageName() = "sqlalchemy" and
    node = call.getArgument(0)
  )
}

from DataFlow::Node source, DataFlow::Node sink
where 
  isUserInput(source) and
  isSqlInjectionSink(sink) and
  TaintTracking::localTaint(source, sink) and
  not isSafeBinding(source)
select sink, source, sink,
  "Potential SQL injection in SQLAlchemy ${sink.getMethodName()} due to unsafe string formatting. Use bindparams instead."
