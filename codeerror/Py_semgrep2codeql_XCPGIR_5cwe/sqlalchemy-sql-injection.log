Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause SQL injections
 * if the developer inputs raw SQL into these clauses. Use bindparams to securely bind user-input to SQL statements.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import DataFlow
import TaintTracking

private class UserInput extends TaintTracking::Source {
  UserInput() {
    exists(DataFlow::ParameterNode p |
      p.getDisplayName() != "" and
      result.asExpr() = p.asExpr()
    )
  }
}

private class SqlInjectionSink extends TaintTracking::Sink {
  SqlInjectionSink() {
    exists(DataFlow::MethodCallNode call |
      call.getMethodName() matches("group_by|order_by|distinct|having|filter") and
      call.getAPackageName() = "sqlalchemy" and
      exists(call.getArgument(0) |
        this.asExpr().toString().matches(".*\\.format\\(.*\\).*")
      )
    )
  }
}

private class SafeBinding extends TaintTracking::Sanitizer {
  SafeBinding() {
    exists(DataFlow::MethodCallNode call |
      call.getMethodName() = "bindparams" and
      call.getAPackageName() = "sqlalchemy"
    )
  }
}

from UserInput source, SqlInjectionSink sink
where TaintTracking::localTaint(source, sink) and
  not exists(SafeBinding s | TaintTracking::barrier(source, sink, s))
select sink, source, sink,
  "Potential SQL injection in SQLAlchemy ${sink.getMethodName()} due to unsafe string formatting. Use bindparams instead."
