Rule Content:
/**
 * @name SQLAlchemy SQL Injection in Clauses
 * @description Detects potential SQL injection in SQLAlchemy's distinct, having, group_by, order_by, 
 *              and filter clauses when raw SQL with user input is used without bindparams.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(string varName |
      // Parameter with variable-like name
      regexpMatches(varName, "^\\$[A-Za-z]") and
      this.asParameter().getName() = varName
    )
  }
}

class SqlAlchemySink extends DataFlow::Node {
  SqlAlchemySink() {
    exists(MethodCall call |
      call.getMethodName() in ["group_by", "order_by", "distinct", "having", "filter"] and
      call.getQualifier().getType().hasQualifiedName("sqlalchemy.orm.query", "Query") and
      // Check for .format without bindparams
      exists(MethodCall formatCall |
        formatCall.getMethodName() = "format" and
        formatCall.getQualifier().getType().getName() = "str" and
        not exists(MethodCall bindCall |
          bindCall.getMethodName() = "bindparams" and
          bindCall.getQualifier().getType().getName() = "str"
        ) and
        formatCall = call.getArgument(0)
      ) and
      this = call.getArgument(0)
    )
  }
}

class BindParamsSanitizer extends DataFlow::BarrierGuard {
  BindParamsSanitizer() {
    exists(MethodCall call |
      call.getMethodName() = "bindparams" and
      call.getQualifier().getType().getName() = "str" and
      this.getANode() = call
    )
  }
}

from UserInputSource source, SqlAlchemySink sink
where TaintTracking::localTaint(source, sink) and
      not exists(BindParamsSanitizer barrier | barrier.blocks(source, sink))
select sink, "Potential SQL injection in SQLAlchemy clause: $" + sink.toString(),
  source, "User input source",
  sink, "SQL clause sink location"
