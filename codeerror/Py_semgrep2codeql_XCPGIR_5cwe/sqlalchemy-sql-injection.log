/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause SQL injections 
 * if the developer inputs raw SQL into these clauses. Use bindparams to securely bind user-input to SQL statements.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs

private class UserInput extends DataFlow::Node {
  UserInput() {
    exists(FunctionValue param | param = this.asParameter() |
      param.getQualifiedName() != "" 
    )
  }
}

private class SqlInjectionSink extends DataFlow::Node {
  SqlInjectionSink() {
    exists(API::Node call |
      call.getTarget().getName().matches("group_by|order_by|distinct|having|filter") and
      call.getTarget().getPackageName() = "sqlalchemy" and
      call.getArgument(0).getExpr().toString().matches(".*\\.format\\(.*\\).*") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

private class SafeBinding extends TaintTracking::FunctionSanitizer {
  SafeBinding() {
    exists(API::Node call |
      call.getTarget().getName() = "bindparams" and
      call.getTarget().getPackageName() = "sqlalchemy" and
      this.asExpr() = call.getArgument(0)
    )
  }
}

from UserInput source, SqlInjectionSink sink
where TaintTracking::globalTaint(source, sink) and
  not exists(SafeBinding s | s.flowsTo(sink))
select sink, source, sink,
  "Potential SQL injection in SQLAlchemy ${sink.getMethodName()} due to unsafe string formatting. Use bindparams instead."
