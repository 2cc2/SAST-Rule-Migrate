Rule Content:
/**
 * @name SQLAlchemy SQL Injection in Clauses
 * @description Detects potential SQL injection in SQLAlchemy's distinct, having, group_by, order_by, 
 *              and filter clauses when raw SQL with user input is used without bindparams.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class UserInputSource extends TaintTracking::Source {
  UserInputSource() {
    exists(Parameter p |
      p = this.asParameter() and
      p.getDefault().toString().matches("^\\$[A-Za-z]")
    )
  }

  override string getSourceType() { result = "User input" }
}

class SqlAlchemySink extends TaintTracking::Sink {
  SqlAlchemySink() {
    exists(CallExpr call |
      call.getMethodName() in ["group_by", "order_by", "distinct", "having", "filter"] and
      call.getQualifier().getType().hasQualifiedName("sqlalchemy.orm.query", "Query") and
      exists(CallExpr formatCall |
        formatCall.getMethodName() = "format" and
        formatCall.getQualifier().getType().getName() = "str" and
        not exists(CallExpr bindCall |
          bindCall.getMethodName() = "bindparams" and
          bindCall.getQualifier().getType().getName() = "str"
        ) and
        formatCall = call.getArgument(0)
      ) and
      this.asExpr() = call.getArgument(0)
    )
  }

  override string getSinkType() { result = "SQL clause sink" }
}

class BindParamsSanitizer extends TaintTracking::Sanitizer {
  BindParamsSanitizer() {
    exists(CallExpr call |
      call.getMethodName() = "bindparams" and
      call.getQualifier().getType().getName() = "str" and
      this.asExpr() = call
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "SqlAlchemyInjection" }

  override predicate isSource(TaintTracking::Source source) { source instanceof UserInputSource }

  override predicate isSink(TaintTracking::Sink sink) { sink instanceof SqlAlchemySink }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof BindParamsSanitizer
  }
}

from Config cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlowFromSourceToSink(source, sink)
select sink, "Potential SQL injection in SQLAlchemy clause: $@", source, sink,
  source, "User input source",
  sink, "SQL clause sink location"
