/**
 * @name SSRF via Flask Request
 * @kind problem
 * @problem.severity error
 * @id python/ssrf-requests
 * @tags security
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.web.flask.Flask
import semmle.python.web.requests

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall mc | 
      mc.getTarget().(NamedMethod).getQualifiedName() = "flask.request.get" and
      this.asExpr() = mc
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p | 
      regexMatches("\\$ROUTEVAR|\\$INTERM", p.getName()) and
      this.asParameter() = p
    )
  }
}

class RequestCallSink extends DataFlow::Node {
  RequestCallSink() {
    exists(PackageExpr pkg, MethodCall mc |
      pkg.getName() = "requests" and
      mc.getCallee().(NamedMethod).getQualifiedName().matches("%") and
      mc.getTarget() = pkg and
      this.asExpr() = mc
    )
  }
}

predicate isFlow(DataFlow::Node source, DataFlow::Node sink) {
  exists(TaintTracking::Configuration cfg |
    cfg.hasFlow(source, sink)
  )
}

from FlaskRequestSource source, RequestCallSink sink, string errorMsg
where isFlow(source, sink)
select sink, errorMsg

from RouteParamSource source, RequestCallSink sink, string errorMsg
where isFlow(source, sink)
select sink, errorMsg

{
  "errorMsg": "User-controlled data reaches HTTP request call without validation. This could lead to a server-side request forgery (SSRF).",
  "description": "Data from request object is passed to a new server-side request.",
  "security-severity": "9.3"
}
