Rule Content:
/**
 * @name SSRF via Flask requests
 * @description User-controlled data reaches server-side request execution
 * @id ssrf-requests
 * @kind path-problem
 * @problem.severity ERROR
 * @tags security
 *       external/cwe/cwe-918
 */

import python
import semmle.python.security.dataflow.ServerSideRequestForgery
import semmle.python.web.Flask
import semmle.python.Requests

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getAPIName().regexpMatch("^(get|__getitem__|__call__)$") and
      ma.getReceiver().getType().hasQualifiedName("flask", "request")
    ) and
    this.asExpr() = any(MethodAccess ma).getQualifier()
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      p.getCallable().getFile().getRelativePath().regexpMatch(".*\.py") and
      p.getName().regexpMatch("$ROUTEVAR")
    ) and
    this.asParameter() = any(Parameter p)
  }
}

class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(MethodAccess ma |
      ma.getMethod().getAPIName() = "$FUNC" and
      ma.getReceiver().getType().hasQualifiedName("requests", _)
    ) and
    this.asExpr() = any(MethodAccess ma).getQualifier()
  }
}

predicate isTaintedFlow(DataFlow::Node source, DataFlow::Node sink) {
  exists(DataFlow::PathNode pn |
    DataFlow::localFlow(source, sink, pn) and
    exists(DataFlow::Edge e | e = pn.getEdge() | 
      e instanceof DataFlow::ArgumentToParameterEdge or
      e instanceof DataFlow::FieldLoadEdge
    )
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where 
  (source.getNode() instanceof FlaskRequestSource or source.getNode() instanceof RouteParamSource) and
  sink.getNode() instanceof RequestsSink and
  isTaintedFlow(source.getNode(), sink.getNode())
select sink.getNode(), 
  "Data from request object is passed to a new server-side request. " +
  "This could lead to a server-side request forgery (SSRF). " +
  "Ensure schemes and hosts are validated against an allowlist.", 
  source.getNode(), sink.getNode()
