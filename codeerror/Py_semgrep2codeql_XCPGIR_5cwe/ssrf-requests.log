Rule Content:
/**
 * @name SSRF via Flask requests
 * @description User-controlled data reaches server-side request execution
 * @id ssrf-requests
 * @kind path-problem
 * @problem.severity ERROR
 * @tags security
 *       external/cwe/cwe-918
 */

import python
import python.dataflow.DataFlow
import python.functions.Function

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall mc |
      mc.getMethodName().regexpMatch("^(get|__getitem__|__call__)$") and
      mc.getReceiver().getType().hasQualifiedName("flask", "request") and
      this = mc.getReceiver()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function::Parameter p |
      p.getFile().getRelativePath().regexpMatch(".*\\.py") and
      p.getName().regexpMatch("[a-zA-Z0-9_]+") and
      this = p
    )
  }
}

class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(MethodCall mc |
      mc.getReceiver().getType().hasQualifiedName("requests", _) and
      this = mc.getArgument(0)
    )
  }
}

class SSRFConfiguration extends DataFlow::Configuration {
  SSRFConfiguration() { this = "SSRFConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RequestsSink
  }

  override predicate isBarrier(DataFlow::Node node) {
    none()
  }
}

from DataFlow::Configuration cfg, DataFlow::Node source, DataFlow::Node sink
where
  cfg instanceof SSRFConfiguration and
  cfg.hasFlow(source, sink)
select sink, 
  "Data from request object is passed to a new server-side request. " +
  "This could lead to a server-side request forgery (SSRF). " +
  "Ensure schemes and hosts are validated against an allowlist.",
  source, sink
