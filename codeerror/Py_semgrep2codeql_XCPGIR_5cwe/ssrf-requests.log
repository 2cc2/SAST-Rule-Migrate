  - source: ROUTE_PARAM
    sink: REQUESTS_CALL
    through: [ASSIGN_PROPAGATION*]

report:
  message: "User-controlled data reaches server-side request execution"
  locations: ["source", "sink"]
  evidence:
    capture:
      - argument: 0
