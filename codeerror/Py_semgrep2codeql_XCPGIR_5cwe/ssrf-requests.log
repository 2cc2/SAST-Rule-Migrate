Rule Content:
/**
 * @name SSRF via Flask Request
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 * @tags security
 * @description Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF).
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getQualifier().toString() = "request" and
      ma.getMethodName() = "get" and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::ParameterNode {
  RouteParamSource() {
    this.getParameter().getName().matches(".*\\$ROUTEVAR.*|.*\\$INTERM.*")
  }
}

class RequestsCallSink extends DataFlow::Node {
  RequestsCallSink() {
    exists(MethodAccess ma |
      ma.getQualifier().toString() = "requests" and
      this.asExpr() = ma
    )
  }
}

class SSRFConfiguration extends TaintTracking::Configuration {
  SSRFConfiguration() { this = "SSRF configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RequestsCallSink
  }
}

from DataFlow::Node source, DataFlow::Node sink, SSRFConfiguration cfg
where cfg.hasFlow(source, sink)
select sink,
  "User-controlled data reaches HTTP request call without validation. Possible SSRF vulnerability.",
  source, "User input source",
  sink, "Potential SSRF sink"
