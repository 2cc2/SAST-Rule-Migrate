Rule Content:
/**
 * @name Command Injection in os.system
 * @description User input reaches os.system call without sanitization
 * @id os-system-injection
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import python.dataflow.DataFlow
import python.web.flask

class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(DataFlow::FunctionCall ma |
      ma.getTarget().getName() = "request" and
      ma.getTarget().getDeclaringType().getName() = "flask" and
      this = ma
    )
  }
}

class RouteParameterInput extends DataFlow::Node {
  RouteParameterInput() {
    exists(DataFlow::ParameterNode p |
      p.getName().regexpMatch(".*ROUTEVAR.*") and
      this = p
    )
  }
}

class OsSystemSink extends DataFlow::Node {
  OsSystemSink() {
    exists(DataFlow::FunctionCall ma |
      ma.getTarget().getName() = "system" and
      ma.getTarget().getDeclaringType().getName() = "os" and
      this = ma.getArgument(0)
    )
  }
}

from
  DataFlow::Node source,
  DataFlow::Node sink
where
  (
    source instanceof FlaskUserInput or
    source instanceof RouteParameterInput
  ) and
  sink instanceof OsSystemSink and
  DataFlow::localFlow(source, sink)
select sink,
  "User data detected in os.system. This could be vulnerable to a command injection and should be avoided. If this must be done, use the 'subprocess' module instead and pass the arguments as a list.",
  source, sink
