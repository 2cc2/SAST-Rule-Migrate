Rule Content:
/**
 * @name os-system-injection
 * @description User data reaches os.system() call, possible command injection
 * @kind path-problem
 * @problem.severity error
 * @id python/os-command-injection
 */

import python
import semmle.python.security.ExternalData
import semmle.python.web.flask.Requests
import DataFlow::PathGraph

class InputSource extends DataFlow::Node {
  InputSource() {
    // Flask request inputs (GET parameters, etc.)
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("get|__getitem__|__call__") and
      ma.getQualifier().getType().hasQualifiedName("flask", "request") and
      this.asExpr() = ma
    ) or
    // Route parameters
    exists(Parameter p | p.getName().regexpMatch("^\\$ROUTEVAR$") and this.asParameter() = p)
  }
}

class OsSystemSink extends DataFlow::Node {
  OsSystemSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "system" and
      ma.getQualifier().getType().hasQualifiedName("os") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class OsCommandInjectionConfig extends TaintTracking::Configuration {
  OsCommandInjectionConfig() { this = "OsCommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof InputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OsSystemSink
  }
}

from OsCommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "User data detected in os.system. This could be vulnerable to a command injection and should be avoided. " +
  "If this must be done, use the 'subprocess' module instead and pass the arguments as a list."
