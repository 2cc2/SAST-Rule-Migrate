Rule Content:
/**
 * @name Command Injection in os.system
 * @description User input reaches os.system call without sanitization
 * @id os-system-injection
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import Flask

class FlaskUserInput extends TaintTracking::Source {
  FlaskUserInput() {
    exists(DataFlow::CallNode ma |
      ma.getTarget().(DataFlow::FunctionNode).getName() = "request" and
      ma.getTarget().(DataFlow::FunctionNode).getDeclaringType().getName() = "flask" and
      this.asSource() = ma.getReturn()
    )
  }
}

class RouteParameterInput extends TaintTracking::Source {
  RouteParameterInput() {
    exists(DataFlow::ParameterNode p |
      p.getName().regexpMatch(".*ROUTEVAR.*") and
      this.asSource() = p
    )
  }
}

class OsSystemSink extends TaintTracking::Sink {
  OsSystemSink() {
    exists(DataFlow::CallNode ma |
      ma.getTarget().getName() = "system" and
      ma.getTarget().getDeclaringType().getName() = "os" and
      this.asSink() = ma.getArgument(0)
    )
  }
}

from
  TaintTracking::Source source,
  TaintTracking::Sink sink,
  DataFlow::Node sourceNode,
  DataFlow::Node sinkNode
where
  (
    source instanceof FlaskUserInput or
    source instanceof RouteParameterInput
  ) and
  sink instanceof OsSystemSink and
  TaintTracking::localTaint(sourceNode, sinkNode)
select sinkNode,
  "User data detected in os.system. This could be vulnerable to a command injection and should be avoided. If this must be done, use the 'subprocess' module instead and pass the arguments as a list.",
  sourceNode, sinkNode
