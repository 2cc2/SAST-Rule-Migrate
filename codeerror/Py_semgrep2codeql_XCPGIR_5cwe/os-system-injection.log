/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection and should be avoided. If this must be done, use the 'subprocess' module instead and pass the arguments as a list.
 * @kind path-problem
 * @problem.severity error
 * @id python/os-command-injection
 */

import python
import python.web.flask.HttpRequest
import DataFlow::PathGraph
import semmle.python.ApiGraphs
import semmle.python.security.dataflow.TaintTracking

class FlaskInputSource extends DataFlow::Node {
  FlaskInputSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["get", "__getitem__", "__call__"]) and
      ma.getQualifier().getType().hasQualifiedName("flask", "request") and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p | p.getAParameter().regexpMatch("^\\$ROUTEVAR$") and this.asParameter() = p)
  }
