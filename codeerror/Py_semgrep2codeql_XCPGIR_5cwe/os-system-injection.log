/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection and should be avoided. If this must be done, use the 'subprocess' module instead and pass the arguments as a list.
 * @kind path-problem
 * @problem.severity error
 * @id python/os-command-injection
 */

import python
import semmle.python.web.flask.Requests
import semmle.python.dataflow.DataFlow
import semmle.python.security.TaintTracking

class FlaskInputSource extends DataFlow::Node {
  FlaskInputSource() {
    exists(Call ma |
      ma.getAttr().hasName(["get", "__getitem__", "__call__"]) and
      ma.getReceiver().getType().hasQualifiedName("flask", "request") and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p | p.getName().regexpMatch("^\\$ROUTEVAR$") and this.asParameter() = p)
  }
}

class OsSystemSink extends DataFlow::Node {
  OsSystemSink() {
    exists(Call ma |
      ma.getAttr().hasName("system") and
      ma.getReceiver().getType().hasQualifiedName("os") and
      this.asExpr() = ma.getArg(0)
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskInputSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OsSystemSink
  }
}

from CommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, "User data reaches os.system() call, possible command injection",
  "User data detected in os.system. This could be vulnerable to a command injection."
