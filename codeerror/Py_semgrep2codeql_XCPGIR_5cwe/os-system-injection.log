Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection and should be avoided. If this must be done, use the 'subprocess' module instead and pass the arguments as a list.
 * @kind path-problem
 * @problem.severity-error
 * @id python/os-command-injection
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.security.TaintTracking
import python.web.flask.Request

class InputSource extends DataFlow::Node {
  InputSource() {
    // Flask request inputs
    exists(DataFlow::CallNode c |
      c.getMethod().hasName(["get", "__getitem__", "__call__"]) and
      c.getReceiver().getType().hasQualifiedName("flask", "request") and
      this.asExpr() = c
    ) or
    // Route parameters
    exists(Parameter p |
      p.getName().regexpMatch("^\\$ROUTEVAR$") and
      this.asParameter() = p
    )
  }

  override predicate asCfgNode() { none() }
  override DataFlow::Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { none() }
  override string toString() { result = this.toString() }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override DataFlow::Variable asVariable() { none() }
}

class OsSystemSink extends DataFlow::Node {
  OsSystemSink() {
    exists(DataFlow::CallNode c |
      c.getMethod().hasName("system") and
      c.getReceiver().getType().hasQualifiedName("os") and
      this.asExpr() = c.getArgument(0)
    )
  }

  override predicate asCfgNode() { none() }
  override DataFlow::Location getLocation() { result = this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { none() }
  override string toString() { result = this.toString() }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override DataFlow::Variable asVariable() { none() }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof InputSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof OsSystemSink
  }
}

from CommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, "User data reaches os.system() call, possible command injection",
  "User data detected in os.system. This could be vulnerable to a command injection."
