Rule Content:
/**
 * @name Command Injection in os.system
 * @description User input reaches os.system call without sanitization
 * @id os-system-injection
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.security.CommandInjection
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.web.Flask

class FlaskUserInput extends RemoteFlowSource::Range {
  FlaskUserInput() {
    exists(MethodAccess ma |
      ma.getMethod().(FunctionValue).getReturnType() instanceof FlaskRequest and
      this.asDefensible().getAParent() = ma
    )
  }
}

class RouteParameterInput extends RemoteFlowSource::Range {
  RouteParameterInput() {
    exists(Parameter p |
      p.getName().matches("%ROUTEVAR%") and
      this.asDefensible() = p
    )
  }
}

class OsSystemSink extends CommandExecution::Range {
  OsSystemSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "system" and
      ma.getMethod().getDeclaringType() = "os" and
      this.asDefensible() = ma.getArgument(0)
    )
  }
}

from
  RemoteFlowSource source, DataFlow::Node sink,
  DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where
  (
    source instanceof FlaskUserInput or
    source instanceof RouteParameterInput    
  ) and
  sink instanceof OsSystemSink and
  DataFlow::localFlowPath(sourceNode, sinkNode)
select sinkNode, sourceNode,
  "User data detected in os.system. This could be vulnerable to a command injection "$
  "and should be avoided. If this must be done, use the 'subprocess' module instead "$
  "and pass the arguments as a list.",
  sourceNode.getNode(), sinkNode.getNode()
