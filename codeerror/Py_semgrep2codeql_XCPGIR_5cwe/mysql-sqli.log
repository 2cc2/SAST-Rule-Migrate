Rule Content:
/**
 * @name MySQL SQL Injection via Lambda Event
 * @description Detects SQL injection from AWS Lambda event parameters to MySQL cursor execution
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id python/mysql-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      // Match handler functions with 'event' parameter
      f.getName().matches("%handler%") and
      p = f.getAParameter() and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class MysqlExecuteSink extends DataFlow::Node {
  MysqlExecuteSink() {
    exists(Call call |
      // Match execute/executemany calls on cursor objects
      (call.getCalleeName() = "execute" or call.getCalleeName() = "executemany") and
      call.getReceiver().getType().getName().matches("%Cursor%") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class EventToSqlFlowConfiguration extends TaintTracking::Configuration {
  EventToSqlFlowConfiguration() {
    this = "Lambda Event to SQL Injection Flow"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MysqlExecuteSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, EventToSqlFlowConfiguration config
where config.hasFlowPath(source, sink)
select sink, 
  "Potential SQL injection: User input from Lambda event reaches SQL execution without sanitization. $@.",
  source, "Source is AWS Lambda event parameter",
  sink, "SQL execution with untrusted input"
