Rule Content:
/**
 * @name MySQL SQL Injection via Lambda Event
 * @description Detects SQL injection from AWS Lambda event parameters to MySQL executions
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id python/mysql-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.web.AwsLambda
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class LambdaEventSource extends TaintTracking::TaintSource {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      f.getName().matches("%handler%") and
      p = f.getParameter(0) and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class MysqlExecuteSink extends TaintTracking::TaintSink {
  MysqlExecuteSink() {
    exists(Call call |
      call.getCallee().getName() in ["execute", "executemany"] and
      call.getReceiver().getType().getName() = "Cursor" and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class EventToSqlFlowConfiguration extends TaintTracking::Configuration {
  EventToSqlFlowConfiguration() { this = "Lambda Event to SQL Injection" }

  override predicate isSource(TaintTracking::TaintSource source) { 
    source instanceof LambdaEventSource 
  }

  override predicate isSink(TaintTracking::TaintSink sink) { 
    sink instanceof MysqlExecuteSink 
  }
}

from DataFlow::Node source, DataFlow::Node sink, EventToSqlFlowConfiguration config
where config.hasFlow(source, sink)
select sink, "Potential SQL injection: User input from Lambda event reaches SQL execution ($@)",
  source, "Source is AWS Lambda event parameter",
  sink, "SQL execution sink"
