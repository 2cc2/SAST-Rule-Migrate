Rule Content:
/**
 * @name MySQL SQLI via Event Object
 * @kind problem
 * @id python/mysql-sqli
 * @severity warning
 * @security-severity 7.5
 * @problem.severity error
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.Concepts
import semmle.python.security.SqlInjection
import semmle.python.web.AwsLambda
import semmle.python.dataflow.TaintTracking

class LambdaEventSource extends DataFlow::CallableNode {
  LambdaEventSource() {
    exists(LambdaFunction f | 
      this = f.getParameter(0) and 
      this.getName() = "event"
    )
  }
}

class MysqlExecuteSink extends DataFlow::Node {
  MysqlExecuteSink() {
    exists(MethodCall call |
      call.getMethodName() = ["execute", "executemany"] and
      call.getReceiver().getType().getName() = "Cursor" and
      this = call.getArgument(0)
    )
  }
}

class EventToSqlFlowConfiguration extends TaintTracking::Configuration {
  EventToSqlFlowConfiguration() {
    this = "Event object to SQL execute flow"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MysqlExecuteSink
  }
}

from EventToSqlFlowConfiguration config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, 
  "User input from event object reaches SQL execution without sanitization",
  source, "Source is event parameter",
  sink, "Potential SQL injection sink"
