Rule Content:
/**
 * @name MySQL SQL Injection from Lambda Event
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable
 *              is user-controlled and not properly sanitized. In order to prevent SQL injection, use parameterized queries
 *              or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/mysql-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.Concepts
import semmle.python.security.SQLInjection
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.RemoteFlowSources
import DataFlow::PathGraph

class LambdaEventHandler extends FunctionValue {
  LambdaEventHandler() {
    exists(string name |
      getName() = name and
      name.matches("%_handler%") and
      getName().toLowerCase().matches("%handler%")
    ) or
    getNumParameter() = 2 and
    this.getAParameter(0).getName() = "event" and
    this.getAParameter(1).getName() = "context"
  }
}

class EventSource extends DataFlow::Node {
  EventSource() {
    exists(FunctionValue f, Parameter p |
      f instanceof LambdaEventHandler and
      p = f.getAParameter(0) and
      this.asParameter() = p
    )
  }
}

class MySqlCursorExecute extends DataFlow::Node {
  MySqlCursorExecute() {
    exists(CallNode call |
      call = this.asExpr() and
      (
        call.getCalleeName() = "execute" or
        call.getCalleeName() = "executemany"
      ) and
      call.getReceiverType().getUnderlyingType().getName() = "Cursor"
    )
  }
}

query predicate edges(DataFlow::Node a, DataFlow::Node b) {
  DataFlow::localFlow(a, b)
}

from EventSource source, MySqlCursorExecute sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where DataFlow::flowPath(sourceNode, sinkNode, source, sink)
select sinkNode, "User input from event object reaches SQL execution without sanitization", sourceNode, sinkNode,
  "Potential SQL injection vulnerability due to unsanitized event input in SQL query"
