Rule Content:
/**
 * @name MySQL SQL Injection via Event Object
 * @description Detects SQL statements that are tainted by AWS Lambda event object
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id python/mysql-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.web.AwsLambda
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class EventSource extends DataFlow::Node {
  EventSource() {
    exists(Function f, Parameter p |
      f.getName().matches("%handler%") and
      p = f.getParameter(0) and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class MysqlExecuteCall extends DataFlow::Node {
  MysqlExecuteCall() {
    exists(Call call |
      call.getCalleeName() in ["execute", "executemany"] and
      call.getReceiver().getType().getName() = "Cursor" and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class EventToSqlConfiguration extends TaintTracking::Configuration {
  EventToSqlConfiguration() { this = "Event to SQL injection configuration" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof MysqlExecuteCall }
}

from EventToSqlConfiguration config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "User input from event object reaches SQL execution without sanitization. $@.",
  source, "Potential user input source",
  sink, "SQL injection sink"
