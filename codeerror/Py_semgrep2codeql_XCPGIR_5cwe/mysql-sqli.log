Rule Content:
/**
 * @name MySQL SQL Injection from Lambda Event
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable
 *              is user-controlled and not properly sanitized. In order to prevent SQL injection, use parameterized queries
 *              or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/mysql-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.Type

class LambdaEventHandler extends FunctionValue {
  LambdaEventHandler() {
    exists(string name |
      getName() = name and
      name.matches("%_handler%") and
      name.toLowerCase().matches("%handler%")
    ) or
    getNumParameters() = 2 and
    getParameter(0).getName() = "event" and
    getParameter(1).getName() = "context"
  }

  override int minParameters() { result = 2 }
  override int maxParameters() { result = 2 }
  override string descriptiveString() { result = "Lambda handler function" }
  override string getQualifiedName() { result = "LambdaHandler" }
  override Type getAnInferredReturnType() { result = any() /* placeholder */ }
  override Type getARaisedType() { result = any() /* placeholder */ }
}

class EventSource extends DataFlow::Node {
  EventSource() {
    exists(FunctionValue f, Parameter p |
      f instanceof LambdaEventHandler and
      p = f.getParameter(0) and
      this = DataFlow::parameterNode(p)
    )
  }
}

class MySqlCursorExecute extends DataFlow::Node {
  MySqlCursorExecute() {
    exists(MethodCall call |
      call = this.asExpr() and
      (
        call.getMethod().getName() = "execute" or
        call.getMethod().getName() = "executemany"
      ) and
      call.getReceiver().getType().getUnderlyingType().getName() = "Cursor"
    )
  }
}

from EventSource source, MySqlCursorExecute sink
where DataFlow::flowPath(source, sink)
select sink, "User input from event object reaches SQL execution without sanitization", source, sink,
  "Potential SQL injection vulnerability due to unsanitized event input in SQL query"
