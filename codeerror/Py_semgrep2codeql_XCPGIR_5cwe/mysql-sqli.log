    match:
      node: CALL
      api: { type: mysql.cursors, method: execute }
      arg_index: 0
    match:
      node: CALL
      api: { type: mysql.cursors, method: executemany }
      arg_index: 0

propagations:
  - id: METHOD_ARG_PROPAGATION
    edge: arg->param
    kind: taint

flows:
  - source: EVENT_PARAM
    sink: SQL_EXEC
    through: [METHOD_ARG_PROPAGATION*]

report:
  message: "User input from event object reaches SQL execution without sanitization"
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "cursor.execute(event['query'])"
  negative:
    - "cursor.execute('SELECT * FROM projects WHERE status = %s', (event['status']))"
