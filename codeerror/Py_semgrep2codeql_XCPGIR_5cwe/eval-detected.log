Rule Content:
/**
 * @name eval-detected
 * @kind problem
 * @id python/eval-detected
 * @severity Warning
 */
import python

from Call call, Expr expr, Value inputValue, Call inputCall
where
  call.getFunc().(Name).getId() = "eval" and
  (
    exists(inputCall.getFunc().(Name).getId() = "input" |
      inputCall = call.getArg(0).getAChild*()
    )
    or
    not (
      exists(Value v | v = call.getArg(0) and v instanceof StrLiteral) 
      or
      exists(FString f | f = call.getArg(0))
    )
  )
and expr = call.getParent()
select call, "Detected the use of eval() with potentially dynamic input. eval() can be dangerous if used to evaluate dynamic content. If this content can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources."
