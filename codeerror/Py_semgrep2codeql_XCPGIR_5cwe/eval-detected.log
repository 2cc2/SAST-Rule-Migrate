/**
 * @name eval-detected
 * @kind problem
 * @id python/eval-detected
 * @description Detects the use of eval() with potentially dynamic input. 
 *   eval() can be dangerous if used to evaluate dynamic content. If this content can 
 *   be input from outside the program, this may be a code injection vulnerability.
 * @severity Warning
 */
import python

from Call call, Value arg
where
  call.getFunc().(Name).getId() = "eval" and
  arg = call.getArg(0) and
  (
    not (arg instanceof StrLiteral)
    and
    not (arg instanceof FString)
    and
    not (
      exists(Call inputCall | 
        inputCall.getFunc().(Name).getId() = "input" and
        inputCall = call.getArg(0).getAChild*()
      )
    )
  )
select call, "Detected the use of eval() with potentially dynamic input. eval() can be dangerous if used to evaluate dynamic content. Ensure evaluated content is not definable by external sources."
