/**
 * @name Unverified SSL context in Paramiko SSHClient.exec_command
 * @description Detects insecure SSHClient.exec_command usage without certificate validation
 * @kind path-problem
 * @problem.severity error
 * @id py/paramiko-exec-command
 * @tags security
 *       external/cwe/cwe-295
 */

import python
import DataFlow::PathGraph

class ParamikoSSHClient extends Class {
  ParamikoSSHClient() {
    exists(Function func |
      func.getName() = "SSHClient" and
      func.getFile().getBaseName() = "client" and
      func.getFile().getParent().getBaseName() = "paramiko"
    )
  }
}

class ExecCommandCall extends DataFlow::Node {
  ExecCommandCall() {
    exists(Method method, FunctionCall fc |
      method.getName() = "exec_command" and
      method.getDeclaringType() instanceof ParamikoSSHClient and
      fc.getTarget() = method and
      this = fc.asExpr()
    )
  }

  string getCommand() {
    result = this.(FunctionCall).getArg(0).getStringValue()
  }
}

predicate isSafeCommand(ExecCommandCall call) {
  call.getCommand().regexpMatch("safe_.*")
}

from ExecCommandCall execCall
where not isSafeCommand(execCall)
select execCall, "Unverified SSL context detected in SSHClient.exec_command usage. " +
  "This will permit insecure connections without verifying SSL certificates. " +
  "Validate commands carefully before execution."
