Rule Content:
/**
 * @name Unverified SSL context in Paramiko SSHClient.exec_command
 * @description Detects insecure SSHClient.exec_command usage without certificate validation
 * @kind path-problem
 * @problem.severity error
 * @id py/paramiko-exec-command
 * @tags security
 *       external/cwe/cwe-295
 */

import python
import semmle.python.security.InsecureFunctionCalls

class ParamikoSSHClient extends Value::Definition {
  ParamikoSSHClient() {
    exists(Import from, string name |
      from.getImportedName(name) = "SSHClient" and
      from.isImportedFrom("paramiko.client")
    )
  }
}

class ExecCommandCall extends API::Call {
  ExecCommandCall() {
    exists(MethodCall mc |
      mc.getMethodName() = "exec_command" and
      mc.getQualifier().getType().getName() = "SSHClient" and
      mc.getQualifier().getType().getSourceDeclaration() instanceof ParamikoSSHClient
    )
  }
}

class SafeExecCommandCall extends ExecCommandCall {
  SafeExecCommandCall() {
    exists(string literal |
      this.getArg(0) = literal and
      literal = "..."
    )
  }
}

from ExecCommandCall execCall
where not exists(SafeExecCommandCall safeExec |
  safeExec = execCall
)
select execCall, "Unverified SSL context detected in SSHClient.exec_command usage. " +
  "This will permit insecure connections without verifying SSL certificates. " +
  "Validate commands carefully before execution."
