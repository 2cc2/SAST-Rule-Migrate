Rule Content:
/**
 * @name Unverified Paramiko SSHClient.exec_command Usage
 * @description Detects potential OS command injection via unverified paramiko SSHClient.exec_command()
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class ParamikoSSHClientCreation extends DataFlow::Node {
  ParamikoSSHClientCreation() {
    exists(Call call |
      call.getCallee().(Class).getQualifiedName() = "paramiko.client.SSHClient" and
      call.getCallee().getName() = "SSHClient" and
      this.asExpr() = call
    )
  }
}

class UnsafeExecCommandCall extends DataFlow::Node {
  string command;

  UnsafeExecCommandCall() {
    exists(Call call |
      call.getCallee().(Class).getQualifiedName() = "paramiko.client.SSHClient" and
      call.getCallee().getName() = "exec_command" and
      not call.getArg(0).getStringValue().matches("\\.\\.\\.") and
      this.asExpr() = call and
      command = call.getArg(0).getStringValue()
    )
  }
}

class ParamikoConfig extends DataFlow::Configuration {
  ParamikoConfig() { this = "ParamikoConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ParamikoSSHClientCreation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeExecCommandCall
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ParamikoConfig config, UnsafeExecCommandCall sinkCall
where
  config.hasFlowPath(source, sink)
select sink, "Potential OS command injection via unverified paramiko SSHClient.exec_command()",
  source, "SSH client created here", sinkCall.command
