 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class ParamikoSSHClientCreation extends DataFlow::Node {
  ParamikoSSHClientCreation() {
    exists(Call call |
      call.getTarget().(Class).getQualifiedName() = "paramiko.client" and
      call.getTarget().getMethod().getName() = "SSHClient" and
      this.asExpr() = call
    )
  }
}

class UnsafeExecCommandCall extends DataFlow::Node {
  string command;

  UnsafeExecCommandCall() {
    exists(Call call |
      call.getTarget().(Class).getQualifiedName() = "paramiko.client.SSHClient" and
      call.getTarget().getMethod().getName() = "exec_command" and
      not call.getArgument(0).getStringValue().matches("\\.\\.\\.") and
      this.asExpr() = call and
      command = call.getArgument(0).getStringValue()
    )
  }
}

class ParamikoTaintConfig extends TaintTracking::Configuration {
  ParamikoTaintConfig() { this = "ParamikoTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ParamikoSSHClientCreation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeExecCommandCall
  }
}

