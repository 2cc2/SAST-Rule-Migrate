import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class ParamikoSSHClientCreation extends DataFlow::Node {
  ParamikoSSHClientCreation() {
    exists(Call call |
      call.getCallee().(Class).getQualifiedName() = "paramiko.client" and
      call.getCallee().getMethod().getName() = "SSHClient" and
      this.asExpr() = call
    )
  }
}

class UnsafeExecCommandCall extends DataFlow::Node {
  string command;

  UnsafeExecCommandCall() {
    exists(Call call |
      call.getCallee().(Class).getQualifiedName() = "paramiko.client.SSHClient" and
      call.getCallee().getMethod().getName() = "exec_command" and
      not call.getArg(0).getStringValue().matches("\\.\\.\\.") and
      this.asExpr() = call and
      command = call.getArg(0).toString()
    )
  }
}

class ParamikoTaintConfig extends TaintTracking::Configuration {
  ParamikoTaintConfig() { this = "ParamikoTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ParamikoSSHClientCreation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeExecCommandCall
  }
}

from DataFlow::Node source, DataFlow::Node sink, ParamikoTaintConfig config,
  UnsafeExecCommandCall sinkCall
where
  config.hasFlow(source, sink)
select sink, "Potential OS command injection via unverified paramiko SSHClient.exec_command()",
  source, "SSH client created here", sinkCall.command
