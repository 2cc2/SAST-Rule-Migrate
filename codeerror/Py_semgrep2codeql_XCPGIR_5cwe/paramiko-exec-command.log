Rule Content:
/**
 * @name Unverified Paramiko SSHClient.exec_command Usage
 * @description Detects potential OS command injection via unverified paramiko SSHClient.exec_command()
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import python
import semmle.python.security.CommandInjection
import semmle.python.ApiGraphs

class ParamikoSSHClientCreation extends Call {
  ParamikoSSHClientCreation() {
    this.getTarget().(Class).getQualifiedName() = "paramiko.client.SSHClient" and
    this.getTarget().(Class).getMethod() = "SSHClient"
  }
}

class UnsafeExecCommandCall extends Call {
  UnsafeExecCommandCall() {
    this.getTarget().(Class).getQualifiedName() = "paramiko.client.SSHClient" and
    this.getTarget().(Class).getMethod() = "exec_command" and
    not this.getArg(0).getValue().toString().matches("\"\"\.\.\.")
  }

  string getCommand() { result = this.getArg(0).getValue().toString() }
}

from ParamikoSSHClientCreation source, UnsafeExecCommandCall sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where 
  DataFlow::localFlow(sourceNode, sinkNode) and
  sourceNode.asExpr() = source and
  sinkNode.asExpr() = sink
select sink, "Potential OS command injection via unverified paramiko SSHClient.exec_command()", 
  source, "SSH client created here", sink.getCommand()
