Rule Content:
/**
 * @name Unverified Paramiko SSHClient.exec_command Usage
 * @description Detects potential OS command injection via unverified paramiko SSHClient.exec_command()
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import python
import DataFlow::PathGraph
import semmle.python.frameworks.paramiko.ParamikoApiGraph

class ParamikoSSHClientCreation extends DataFlow::Node {
  ParamikoSSHClientCreation() {
    exists(MethodCall call |
      call.getMethod().hasQualifiedName("paramiko.client", "SSHClient") and
      this.asExpr() = call
    )
  }
}

class UnsafeExecCommandCall extends DataFlow::Node {
  string command;

  UnsafeExecCommandCall() {
    exists(MethodCall call |
      call.getMethod().hasQualifiedName("paramiko.client.SSHClient", "exec_command") and
      not call.getArgument(0).toString().matches("\\.\\.\\.") and
      this.asExpr() = call and
      command = call.getArgument(0).toString()
    )
  }
}

class ParamikoTaintConfig extends TaintTracking::Configuration {
  ParamikoTaintConfig() { this = "ParamikoTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ParamikoSSHClientCreation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeExecCommandCall
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ParamikoTaintConfig cfg,
  UnsafeExecCommandCall sinkCall
where
  cfg.hasFlowPath(source, sink)
select sink, "Potential OS command injection via unverified paramiko SSHClient.exec_command()",
  source, "SSH client created here", sinkCall.command
