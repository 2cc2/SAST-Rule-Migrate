Rule Content:
/**
 * @name Path Traversal in open() call
 * @description Found request data in a call to 'open'. Ensure the request data is validated
 *              or sanitized, otherwise it could result in path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 * @tags security
 *       external/cwe/cwe-022
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.web.flask.Flask
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName().matches("flask\\.request\\..*") and
      ma = this.asExpr()
    )
  }
}

class FileOpenSink extends DataFlow::Sink {
  FileOpenSink() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName() = "builtins.open" and
      ma = this.asExpr()
    )
  }
}

class PathTraversalConfig extends DataFlow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof FileOpenSink
  }

  override predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    DataFlow::localFlowStep(node1, node2) or
    DataFlow::fieldFlowStep(node1, node2) or
    DataFlow::arrayElementFlowStep(node1, node2)
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found request data in a call to 'open'"
