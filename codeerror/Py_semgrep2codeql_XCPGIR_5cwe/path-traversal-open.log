Rule Content:
/**
 * @name Path Traversal in File Open
 * @description Detects user-controlled input reaching file open operations without sanitization, which could lead to path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 * @tags security
 */

import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.api.security.flask.Request
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(DataFlow::CallNode call | 
      call.getTarget().(Method).getName() = "get" and
      call.getExpr().(Attribute).getObject() instanceof FlaskRequest
    )
  }
}

class FlaskRouteParamSource extends DataFlow::Node {
  FlaskRouteParamSource() {
    exists(FunctionDef route |
      route.getDecorator().(Decorator).getExpr().(Call).getTarget().toString() = "route" and
      this.asParameter() = route.getAParameter()
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(Call call |
      call.getTarget().(Function).getName() = "open" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof FlaskRouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Argument to parameter propagation
    exists(Call call, Parameter p |
      node1.asExpr() = call.getAnArg() and
      node2.asParameter() = p and
      p = call.getTarget().getAParameter()
    ) or
    // Assignment propagation
    exists(Assign assign |
      node1.asExpr() = assign.getRhs() and
      node2.asExpr() = assign.getLhs()
    )
  }
}

from PathTraversalConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "User-controlled input reaches file open operation without sanitization", source, sink,
  "Potential path traversal vulnerability from $@ to $@", source, sink
