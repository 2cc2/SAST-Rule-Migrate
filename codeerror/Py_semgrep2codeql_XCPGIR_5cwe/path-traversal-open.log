import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.request

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() {
    exists(Call ma |
      ma.getFunc().toString().matches("flask\\.request\\..*") and
      this.asExpr() = ma
    )
  }
  
  override predicate isSourceOf(TaintKind kind) { any() }
}

class FileOpenSink extends TaintTracking::Sink {
  FileOpenSink() {
    exists(Call ma |
      ma.getFunc().toString() = "builtins.open" and
      this.asExpr() = ma
    )
  }
  
  override predicate sinks(TaintKind taint) { any() }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof FileOpenSink
  }
}

