Rule Content:
/**
 * @name Path Traversal in File Open
 * @description Detects user-controlled input reaching file open operations without sanitization
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 * @tags security
 * @precision high
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.Flask
import semmle.python.dataflow.DataFlow
import semmle.python.ApiGraphs

class FlaskRequestSource extends TaintTracking::SourceNode {
  FlaskRequestSource() {
    exists(Call call, Name name |
      name.getId() = "get" and
      call.getFunc() = name and
      exists(Attribute attr |
        call.getReceiver() = attr and
        attr.getObject().(Name).getId() = "request" and
        attr.getAttr() = "get"
      )
    )
  }

  override predicate isSource(DataFlow::Node source) { this = source }
}

class FlaskRouteParamSource extends TaintTracking::SourceNode {
  FlaskRouteParamSource() {
    exists(Function route, Parameter param, Call call, Name name |
      name.getId() = "route" and
      call.getFunc() = name and
      call.getReceiver().(Name).getId() = "Flask" and
      route.getADecorator().getExpr() = call and
      param = route.getAParameter()
    )
  }

  override predicate isSource(DataFlow::Node source) { this = source }
}

class FileOpenSink extends TaintTracking::SinkNode {
  FileOpenSink() {
    exists(Call call, Name name |
      name.getId() = "open" and
      call.getFunc() = name and
      this.asExpr() = call.getArg(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) { this = sink }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof FlaskRouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Argument to parameter propagation
    exists(Call call, Parameter param |
      node1.asExpr() = call.getArg(_) and
      exists(Function f | param = f.getAParameter() and call.getFunc() = f.getAName()) and
      node2.asParameter() = param
    )
    or
    // Assignment propagation
    exists(Assign assign |
      node1.asExpr() = assign.getRhs() and
      node2.asExpr() = assign.getLhs()
    )
  }
}

from PathTraversalConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "User-controlled input reaches file open operation without sanitization", source, sink,
  "Potential path traversal vulnerability from $@ to $@", source, sink
