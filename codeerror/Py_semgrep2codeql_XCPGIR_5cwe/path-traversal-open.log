Rule Content:
/**
 * @name Path Traversal in File Open
 * @description Detects user-controlled input reaching file open operations without sanitization
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 * @tags security
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Request
import semmle.python.Concepts
import DataFlow::PathGraph

class FlaskRequestSource extends TaintTracking::Source {
  FlaskRequestSource() {
    exists(Call call |
      call.getFunc().(Function).getName() = "get" and
      call.getFunc().getReceiver() instanceof FlaskRequest
    )
  }

  override predicate isSourceOf(TaintKind kind) { kind = TaintKind::pathInjection() }
}

class FlaskRouteParamSource extends TaintTracking::Source {
  FlaskRouteParamSource() {
    exists(Function route, Parameter param |
      exists(Decorator decorator |
        decorator.getTarget().toString() = "route" and
        decorator.getTarget().getParent() = route
      ) and
      param = route.getAParameter()
    )
  }

  override predicate isSourceOf(TaintKind kind) { kind = TaintKind::pathInjection() }
}

class FileOpenSink extends TaintTracking::Sink {
  FileOpenSink() {
    exists(Call call |
      call.getFunc().(Function).getName() = "open" and
      this.asExpr() = call.getArg(0)
    )
  }

  override predicate sinks(TaintKind taint) { taint = TaintKind::pathInjection() }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof FlaskRouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Argument to parameter propagation
    exists(Call call, Parameter param |
      node1.asExpr() = call.getAnArg() and
      node2.asParameter() = param and
      param = call.getFunc().getAParameter()
    )
    or
    // Assignment propagation
    exists(Assign assign |
      node1.asExpr() = assign.getRhs() and
      node2.asExpr() = assign.getLhs()
    )
  }
}

from PathTraversalConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "User-controlled input reaches file open operation without sanitization", source, sink,
  "Potential path traversal vulnerability from $@ to $@", source, sink
