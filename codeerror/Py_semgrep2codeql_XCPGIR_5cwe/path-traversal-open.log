 * @tags security
 *       external/cwe/cwe-022
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.web.FlaskRequest
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(Call ma |
      ma.getFunc().getQualifiedName().matches("flask\\.request\\..*") and
      this.asExpr() = ma
    )
  }
  
  override predicate isSourceOf(DataFlow::TaintKind kind) { any() }
}

class FileOpenSink extends DataFlow::Sink {
  FileOpenSink() {
    exists(Call ma |
      ma.getFunc().getQualifiedName() = "builtins.open" and
      this.asExpr() = ma
    )
  }
  
  override predicate sinks(DataFlow::TaintKind taint) { any() }
}

class PathTraversalConfig extends DataFlow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof FileOpenSink
  }
}

