/**
 * @name Dangerous Subprocess Use Audit
 * @description Detects subprocess functions without static strings that may be vulnerable to command injection
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-subprocess-use-audit
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class SubprocessCall extends DataFlow::CallNode {
  SubprocessCall() {
    exists(Method method |
      method.getAPackageName() = "subprocess" and
      this.getTarget() = method and
      method.getName() = ["call", "run", "Popen", "check_call", "check_output"]
    )
  }

  Expr getCommand() { result = this.getArg(0) }
}

class DynamicShellSource extends DataFlow::Node {
  DynamicShellSource() {
    exists(SubprocessCall call |
      call.getCommand() = this.asExpr() and
      not (
        this.asExpr() instanceof StringLiteral or
        this.getStringValue() in ["sh", "bash", "ksh", "csh", "tcsh", "zsh"]
      )
    )
  }
}

class PythonShellSource extends DataFlow::Node {
  PythonShellSource() {
    exists(SubprocessCall call |
      call.getCommand() = this.asExpr() and
      this.getStringValue() = "python"
    )
  }
}

class ShellSink extends DataFlow::Node {
  ShellSink() {
    exists(SubprocessCall call | call.getCommand() = this.asExpr())
  }
}

class ShlexSanitizer extends DataFlow::Node {
  ShlexSanitizer() {
    exists(Method method, CallNode call |
      method.getAPackageName() = "shlex" and
      method.getName() = "escape" and
      call.getTarget() = method and
      call.getResult() = this.asExpr()
    )
  }
}

class DangerousSubprocessConfig extends TaintTracking::Configuration {
  DangerousSubprocessConfig() { this = "DangerousSubprocessConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicShellSource or
    source instanceof PythonShellSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ShellSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ShlexSanitizer
  }
}

from DangerousSubprocessConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), "Detected subprocess function without static string that may be vulnerable to command injection",
  source.getNode(), "Potential dangerous shell command $@",
  sink.getNode(), "command injection"
