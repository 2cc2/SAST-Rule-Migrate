Rule Content:
/**
 * @name Dangerous Subprocess Use
 * @description Detects subprocess function calls without static command strings that may be vulnerable to command injection
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/dangerous-subprocess-use-audit
 * @tags security
 *       external/cwe/cwe-078
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.PathGraph
import semmle.python.dataflow.new.TaintTracking

predicate isShellCommand(DataFlow::Node node) {
  exists(string command |
    command = node.asExpr().(StringLiteral).getValue() |
    command.regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)")
  )
}

predicate isPythonCommand(DataFlow::Node node) {
  exists(string command |
    command = node.asExpr().(StringLiteral).getValue() |
    command.regexpMatch("(python)")
  )
}

class SubprocessCall extends DataFlow::Node {
  SubprocessCall() {
    exists(FunctionCall call, Function func |
      call.getTarget() = func and
      func.getQualifiedName().matches("subprocess.%") and
      (
        func.getName().matches("%call%") or
        func.getName().matches("%run%") or
        func.getName().matches("%Popen%")
      ) and
      this = call.getArgument(0)
    )
  }
}

class StaticCommandSanitizer extends DataFlow::Node {
  StaticCommandSanitizer() {
    exists(string value |
      this.asExpr().(StringLiteral).getValue() = value and
      not value.regexpMatch("(sh|bash|ksh|csh|tcsh|zsh|python)")
    )
  }
}

class SafeSubprocessConstructor extends DataFlow::BarrierGuard {
  SafeSubprocessConstructor() {
    exists(FunctionCall call, Function func |
      call.getTarget() = func and
      (
        func.getName() = "CalledProcessError" or
        func.getName() = "SubprocessError"
      )
    )
  }
}

class DangerousSubprocessFlowConfiguration extends TaintTracking::Configuration {
  DangerousSubprocessFlowConfiguration() { this = "DangerousSubprocessFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    isShellCommand(source) or isPythonCommand(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessCall
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof StaticCommandSanitizer
  }

  override predicate isBarrier(DataFlow::Node node) {
    exists(SafeSubprocessConstructor ssc | ssc.isBarrier(node))
  }
}

from DangerousSubprocessFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "Detected subprocess function call without a static string. If this data can be controlled by a malicious actor, " +
  "it may be an instance of command injection. Audit the use of this call to ensure it is not controllable by an " +
  "external resource. You may consider using 'shlex.escape()'.", 
  source.getNode(), sink.getNode(),
  "Potential command injection vulnerability"
