Rule Content:
/**
 * @name Dangerous Subprocess Use Audit
 * @description Detects subprocess functions without static strings that may be vulnerable to command injection
 * @kind taint
 * @severity Error
 * @problem.severity error
 * @id python/dangerous-subprocess-use-audit
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class SubprocessFunction extends DataFlow::CallNode {
  SubprocessFunction() {
    this.getTarget().(DataFlow::MethodValue).getAPackageName() = "subprocess"
  }
}

class DangerousShellSource extends DataFlow::Node {
  DangerousShellSource() {
    exists(SubprocessFunction call |
      call.getArg(0) = this.asExpr() and
      not (
        this.asExpr() instanceof DataFlow::StringLiteral or
        this.asExpr().getStringValue() in ["sh", "bash", "ksh", "csh", "tcsh", "zsh"]
      )
    )
  }
}

class PythonShellSource extends DataFlow::Node {
  PythonShellSource() {
    exists(SubprocessFunction call |
      call.getArg(0) = this.asExpr() and
      this.asExpr().getStringValue() = "python"
    )
  }
}

class DangerousShellSink extends DataFlow::Node {
  DangerousShellSink() {
    exists(SubprocessFunction call | call.getArg(0) = this.asExpr())
  }
}

class ShlexSanitizer extends DataFlow::Node {
  ShlexSanitizer() {
    exists(DataFlow::CallNode call |
      call.getTarget().(DataFlow::MethodValue).getAPackageName() = "shlex" and
      call.getTarget().(DataFlow::MethodValue).getName() = "escape" and
      call.getResult() = this.asExpr()
    )
  }
}

module DangerousSubprocessConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    source instanceof DangerousShellSource or
    source instanceof PythonShellSource
  }

  predicate isSink(DataFlow::Node sink) {
    sink instanceof DangerousShellSink
  }

  predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ShlexSanitizer
  }
}

module DangerousSubprocessFlow = TaintTracking::Global<DangerousSubprocessConfig>;

from DangerousSubprocessFlow::PathNode source, DangerousSubprocessFlow::PathNode sink
where
  DangerousSubprocessFlow::flow(source, sink)
select sink, "Detected subprocess function without static string that may be vulnerable to command injection",
  source, "Potential dangerous shell command"
