Rule Content:
/**
 * @name Dangerous Subprocess Use
 * @description Detects subprocess function calls without static command strings that may be vulnerable to command injection
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/dangerous-subprocess-use-audit
 * @tags security
 *       external/cwe/cwe-078
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import python
import DataFlow::PathGraph
import DataFlow::Call
import TaintTracking::Configuration

predicate isShellCommand(DataFlow::Node node) {
  exists(string command |
    command = node.asSource().asConstantStringLiteral().getLiteral() |
    command.matches("%(sh|bash|ksh|csh|tcsh|zsh)%")
  )
}

predicate isPythonCommand(DataFlow::Node node) {
  exists(string command |
    command = node.asSource().asConstantStringLiteral().getLiteral() |
    command.matches("%(python)%")
  )
}

class SubprocessCall extends DataFlow::Node {
  SubprocessCall() {
    exists(DataFlow::Call call |
      call.getTarget().fromSource() and
      exists(Function func |
        func.getQualifiedName() = "subprocess." + func.getName() and
        (
          func.getName().matches("%call%") or
          func.getName().matches("%run%") or
          func.getName().matches("%Popen%")
        ) and
        this = call.getArgument(0)
      )
    )
  }
}

class StaticCommandSanitizer extends DataFlow::Node {
  StaticCommandSanitizer() {
    exists(string value |
      this.asSource().asConstantStringLiteral().getLiteral() = value and
      not value.matches("%(sh|bash|ksh|csh|tcsh|zsh|python)%")
    )
  }
}

class SafeSubprocessConstructor extends DataFlow::BarrierGuard {
  SafeSubprocessConstructor() {
    exists(DataFlow::Call call |
      call.getTarget().fromSource() and
      (
        call.getTarget().getName() = "CalledProcessError" or
        call.getTarget().getName() = "SubprocessError"
      )
    )
  }
}

class DangerousSubprocessFlowConfiguration extends TaintTracking::Configuration {
  DangerousSubprocessFlowConfiguration() { this = "DangerousSubprocessFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    isShellCommand(source) or isPythonCommand(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticCommandSanitizer
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof SafeSubprocessConstructor
  }
}

