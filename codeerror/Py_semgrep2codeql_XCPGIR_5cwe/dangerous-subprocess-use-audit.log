  - source: PYTHON_SHELL_COMMAND
    sink: SHELL_EXEC
    through: [ARG_TO_ARG*]
    constraints:
      path:
        must_not:
          - pattern: "CALL(shlex.escape)"
report:
  message: "Detected subprocess function without static string that may be vulnerable to command injection"
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "subprocess.call(user_input)"
    - "subprocess.run([shell_input, '-c', dynamic_command])"
  negative:
    - "subprocess.call(['ls'])"
    - "subprocess.run([shlex.escape(user_input)])"
