```yaml
xcpgir_version: "1.0"
rule:
  id: dangerous-subprocess-use-audit
  kind: taint
  severity: ERROR
  message: "Detected subprocess function '$FUNC' without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection. Audit the use of this call to ensure it is not controllable by an external resource. You may consider using 'shlex.escape()'."
scope:
  languages: [python]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources:
  - id: DYNAMIC_SHELL_COMMAND
    match:
      node: CALL
      api: { package: subprocess, method: "$FUNC" }
      where:
        - op: not
          condition:
            op: or
            conditions:
              - op: regex
                left: arg[0].value
                right: "^[\"'].*[\"']$"
              - op: in
                left: arg[0].value
                right: ["sh", "bash", "ksh", "csh", "tcsh", "zsh"]
  - id: PYTHON_SHELL_COMMAND
    match:
      node: CALL
      api: { package: subprocess, method: "$FUNC" }
      where:
        - op: regex
          left: arg[0].value
          right: "^(python)$"
sinks:
  - id: SHELL_EXEC
    match:
      node: CALL
      api: { package: subprocess, method: "$FUNC" }
      arg_index: 0
sanitizers:
  - id: SHLEX_ESCAPE
    match:
      node: CALL
      api: { package: shlex, method: escape }
    effect: neutralize
    scope: { sinks: [SHELL_EXEC] }
propagations:
  - id: ARG_TO_ARG
    edge: arg->arg
    kind: taint
flows:
  - source: DYNAMIC_SHELL_COMMAND
    sink: SHELL_EXEC
    through: [ARG_TO_ARG*]
    constraints:
      path:
        must_not:
          - pattern: "CALL(shlex.escape)"
          - pattern: "CALL(subprocess.CalledProcessError)"
          - pattern: "CALL(subprocess.SubprocessError)"
  - source: PYTHON_SHELL_COMMAND
    sink: SHELL_EXEC
    through: [ARG_TO_ARG*]
    constraints:
      path:
        must_not:
          - pattern: "CALL(shlex.escape)"
report:
  message: "Detected subprocess function without static string that may be vulnerable to command injection"
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "subprocess.call(user_input)"
    - "subprocess.run([shell_input, '-c', dynamic_command])"
  negative:
    - "subprocess.call(['ls'])"
    - "subprocess.run([shlex.escape(user_input)])"
```
