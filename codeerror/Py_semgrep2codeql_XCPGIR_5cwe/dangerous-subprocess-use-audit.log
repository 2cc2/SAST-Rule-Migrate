Rule Content:
/**
 * @name Dangerous Subprocess Use Audit
 * @description Detects subprocess functions without static strings that may be vulnerable to command injection
 * @kind path-problem
 * @problem.severity error 
 * @id python/dangerous-subprocess-use-audit
 */

import python
import semmle.python.dataflow.remote.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

// Define subprocess calls
class SubprocessCall extends DataFlow::CallNode {
  SubprocessCall() {
    this.getTarget().(Function).getQualifiedName().matches("subprocess.%") and
    this.getTarget().getName() in ["call", "run", "Popen", "check_call", "check_output"]
  }

  DataFlow::Node getCommand() { result = this.getArgument(0) }
}

// Sources - unsafe shell commands (dynamic or python interpreter)
class DynamicShellSource extends DataFlow::SourceNode {
  DynamicShellSource() {
    exists(SubprocessCall call |
      call.getCommand() = this and
      not (
        this.asExpr() instanceof Str or
        (this.asExpr() instanceof Str and 
         this.asExpr().getValue() in ["sh", "bash", "ksh", "csh", "tcsh", "zsh"])
      )
    )
  }
}

class PythonShellSource extends DataFlow::SourceNode {
  PythonShellSource() {
    exists(SubprocessCall call |
      call.getCommand() = this and
      this.asExpr() instanceof Str and
      this.asExpr().getValue() = "python"
    )
  }
}

// Sink - subprocess command execution
class ShellSink extends DataFlow::SinkNode {
  ShellSink() {
    exists(SubprocessCall call | call.getCommand() = this)
  }
}

// Sanitizer - shlex.escape()
class ShlexSanitizer extends DataFlow::SanitizerNode {
  ShlexSanitizer() {
    exists(Function esc, Call escapeCall |
      esc.getQualifiedName() = "shlex.escape" and
      escapeCall.getTarget() = esc and
      escapeCall.getResult() = this
    )
  }
}

// Configure data flow
class DangerousSubprocessConfig extends TaintTracking::Configuration {
  DangerousSubprocessConfig() { this = "DangerousSubprocessConfig" }

  override predicate isSource(DataFlow::SourceNode source) {
    source instanceof DynamicShellSource or
    source instanceof PythonShellSource
  }

  override predicate isSink(DataFlow::SinkNode sink) {
    sink instanceof ShellSink
  }

  override predicate isSanitizer(DataFlow::SanitizerNode sanitizer) {
    sanitizer instanceof ShlexSanitizer
  }
}

// Query - find flows from sources to sinks
from DangerousSubprocessConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected subprocess function without static string that may be vulnerable to command injection",
  source, "Potential dangerous shell command $@",
  sink, "command injection"
