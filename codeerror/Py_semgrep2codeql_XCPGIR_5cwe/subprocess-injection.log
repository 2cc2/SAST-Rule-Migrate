      not arg.getStringLiteral().getValue().regexpMatch("\".*\"") and
      not exists(ListLiteral l | arg = l and l.getAnElement().getStringLiteral().getValue().regexpMatch("\".*\""))
    )
  }
}

class SubprocessInjectionConfig extends DataFlow::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjection" }

