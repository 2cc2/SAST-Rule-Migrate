Rule Content:
/**
 * @name Subprocess Injection 
 * @description Detected user input entering a `subprocess` call unsafely.
 *              This could result in a command injection vulnerability allowing
 *              execution of arbitrary commands.
 * @kind path-problem
 * @problem.severity error  
 * @precision high
 * @id python/subprocess-injection
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.web.UsesFlask

class FlaskInputSource extends DataFlow::Node {
  FlaskInputSource() {
    exists(Function f, Call c |
      c.getFunc() = f and
      f.getName() in ["get", "__getitem__", "stream", "data", "full_path", "url", "json", "get_json"] and
      c.getQualifier().toString() = "flask.request" and
      f.getDeclaringScope().toString().regexpMatch("(form|args|values|cookies|headers|view_args)") and
      this.asExpr() = c
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p, Name n |
      f.getName().matches("^route_") and
      p = f.getAParameter() and
      n = p.getAnAccess() and 
      this.asExpr() = n
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(Call c, Expr arg |
      c.getCalleeName().matches("subprocess\\..*") and
      arg = c.getArg(0) and
      this.asExpr() = arg and
      not arg.getStringValue().regexpMatch("\".*\"") and
      not exists(List l | arg = l and l.getAnElement().getStringValue().regexpMatch("\".*\""))
    )
  }
}

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskInputSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }
}

from SubprocessInjectionConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential command injection vulnerability from user input to subprocess call.",
  source, "User input originates here."
