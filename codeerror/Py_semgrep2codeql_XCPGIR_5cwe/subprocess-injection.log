Rule Content:
/**
 * @name Subprocess Injection
 * @description Detected user input entering a `subprocess` call unsafely. 
 *              This could result in a command injection vulnerability.
 * @kind path-problem
 * @problem.severity error
 * @id py/subprocess-injection
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Flask
import semmle.python.Concepts

// Source: Flask input parameters
class FlaskInputSource extends DataFlow::Source {
  FlaskInputSource() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().regexpMatch("flask\\.request\\.(form|args|values|cookies|headers|view_args)\\.get") and
      this.asSource() = call
    )
  }
}

// Source: Route parameters
class RouteParameterSource extends DataFlow::Source {
  RouteParameterSource() {
    exists(Method method, Parameter param |
      method.hasDecoration("flask.Flask.route") and
      param = method.getAParameter() and
      this.asSource() = param
    )
  }
}

// Sink: subprocess call with potential injection
class SubprocessSink extends DataFlow::Sink {
  SubprocessSink() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().matches("subprocess.%") and
      not call.getArgument(0).(StringLiteral).getValue().regexpMatch("^\\[\\\".+\\\",") and
      not call.getArgument(0).(StringLiteral).getValue() = "\"...\"" and
      this.asSink() = call
    )
  }
}

// Sink: shell execution
class ShellSink extends DataFlow::Sink {
  ShellSink() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().matches("subprocess.%") and
      call.getArgument(0).(StringLiteral).getValue().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$") and
      this.asSink() = call
    )
  }
}

// Sanitizer: dictionary key access
class DictKeySanitizer extends DataFlow::Sanitizer {
  DictKeySanitizer() {
    exists(ArrayAccess access |
      access.getParent() instanceof Dict and
      this.asSanitizer() = access
    )
  }
}

// Taint tracking configuration
class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskInputSource or source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof SubprocessSink or sink instanceof ShellSink
  }

  override predicate isSanitizer(DataFlow::Sanitizer sanitizer) {
    sanitizer instanceof DictKeySanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SubprocessInjectionConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  sink.getNode().(CallableAccess).getName() + " call potentially unsafe due to unvalidated user input from $@.",
  source.getNode(), source.getNode().toString()
