Rule Content:
/**
 * @name Subprocess Injection
 * @description Detected user input entering a `subprocess` call unsafely.
 *              This could result in a command injection vulnerability.
 * @kind path-problem
 * @problem.severity error
 * @id py/subprocess-injection
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask
import semmle.python.Concepts

// Source: Flask input parameters
class FlaskInputSource extends TaintTracking::TaintSource {
  FlaskInputSource() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().regexpMatch("flask\\.request\\.(form|args|values|cookies|headers|view_args)\\.get") |
      result = call
    )
  }
}

// Source: Route parameters
class RouteParameterSource extends TaintTracking::TaintSource {
  RouteParameterSource() {
    exists(Method method, Parameter param |
      method.hasDecoration("flask.route") and
      param = method.getParameter(_) and
      result = param
    )
  }
}

// Sink: subprocess call with potential injection
class SubprocessSink extends TaintTracking::TaintSink {
  SubprocessSink() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().matches("subprocess.%") and
      not call.getArgument(0).(StringLiteral).getValue().regexpMatch("^\\[\\\".+\\\",") and
      not call.getArgument(0).(StringLiteral).getValue() = "\"...\"" |
      result = call
    )
  }
}

// Sink: shell execution
class ShellSink extends TaintTracking::TaintSink {
  ShellSink() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().matches("subprocess.%") and
      call.getArgument(0).(StringLiteral).getValue().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$") |
      result = call
    )
  }
}

// Sanitizer: dictionary key access
class DictKeySanitizer extends TaintTracking::Sanitizer {
  DictKeySanitizer() {
    exists(ArrayAccess access |
      access.getParent() instanceof Dict |
      result = access
    )
  }
}

// Taint tracking configuration
class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskInputSource or source instanceof RouteParameterSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SubprocessSink or sink instanceof ShellSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof DictKeySanitizer
  }
}

from TaintTracking::TaintSource source, TaintTracking::TaintSink sink, SubprocessInjectionConfig config
where config.hasFlow(source, sink)
select sink, 
  "Potential command injection vulnerability from user input to subprocess call",
  source, "User input originates from here"
