Rule Content:
/**
 * @name Subprocess Injection
 * @description Detected user input entering a `subprocess` call unsafely.
 *              This could result in a command injection vulnerability.
 * @kind path-problem
 * @problem.severity error
 * @id py/subprocess-injection
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask
import semmle.python.Concepts

// Source: Flask input parameters
class FlaskInputSource extends DataFlow::SourceNode {
  FlaskInputSource() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().regexpMatch("flask\\.request\\.(form|args|values|cookies|headers|view_args)\\.get") and
      this.asSourceNode() = call
    )
  }
}

// Source: Route parameters
class RouteParameterSource extends DataFlow::SourceNode {
  RouteParameterSource() {
    exists(Method method, Parameter param |
      method.getADecoration("flask.route.decorator") and
      param = method.getAParameter() and
      this.asSourceNode() = param
    )
  }
}

// Sink: subprocess call with potential injection
class SubprocessSink extends DataFlow::SinkNode {
  SubprocessSink() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().matches("subprocess.%") and
      not call.getArgument(0).(StringLiteral).getStringValue().regexpMatch("^\\[\\\".+\\\",") and
      not call.getArgument(0).(StringLiteral).getStringValue() = "\"...\"" and
      this.asSinkNode() = call
    )
  }
}

// Sink: shell execution
class ShellSink extends DataFlow::SinkNode {
  ShellSink() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().matches("subprocess.%") and
      call.getArgument(0).(StringLiteral).getStringValue().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$") and
      this.asSinkNode() = call
    )
  }
}

// Sanitizer: dictionary key access
class DictKeySanitizer extends DataFlow::SanitizerNode {
  DictKeySanitizer() {
    exists(ArrayAccess access |
      access.getParent() instanceof Dict and
      this.asSanitizerNode() = access
    )
  }
}

// Taint tracking configuration
class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(DataFlow::SourceNode source) {
    source instanceof FlaskInputSource or source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::SinkNode sink) {
    sink instanceof SubprocessSink or sink instanceof ShellSink
  }

  override predicate isSanitizer(DataFlow::SanitizerNode sanitizer) {
    sanitizer instanceof DictKeySanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SubprocessInjectionConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential command injection vulnerability from user input to subprocess call",
  source.getNode(), "User input originates from here"
