Rule Content:
/**
 * @name Subprocess Injection
 * @description Detected user input entering a `subprocess` call unsafely.
 *              This could result in a command injection vulnerability allowing
 *              execution of arbitrary commands.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/subprocess-injection
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import DataFlow::PathGraph
import python.flask.Requests

class FlaskInputSource extends DataFlow::Node {
  FlaskInputSource() {
    exists(FunctionValue f, Value v |
      f.getAPIName() in [
        "get", "__getitem__", "stream", "data", "full_path", "url", "json", "get_json"
      ] and
      f.getQualifier().toString() = "flask.request" and
      f.getMemberName() in [
        "form.get", "form.__getitem__", "args.get", "args.__getitem__",
        "values.get", "values.__getitem__", "cookies.get", "cookies.__getitem__",
        "headers.get", "headers.__getitem__", "view_args.get", "view_args.__getitem__"
      ] and
      v = f.getAReference() and
      this.asExpr() = v
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getName().matches("^route_") and
      p = f.getParameter(_) and
      this.asExpr() = p.getAnAccess()
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(Call call, Expr arg |
      call.getCalleeName().matches("subprocess.*") and
      arg = call.getArgument(0) and
      this.asExpr() = arg and
      not arg.getStringValue().regexpMatch("\".*\"") and
      not exists(ListLiteral li | arg = li and li.getElement(0).getStringValue().regexpMatch("\".*\""))
    )
  }
}

class SubprocessInjectionConfig extends DataFlow::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskInputSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }
}

from SubprocessInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential command injection vulnerability from user input to subprocess call.", 
  source, "User input originates here."
