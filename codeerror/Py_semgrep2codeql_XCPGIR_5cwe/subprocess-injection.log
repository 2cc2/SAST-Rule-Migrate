import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.web.flask.Request

class FlaskInputSource extends DataFlow::Node {
  FlaskInputSource() {
    exists(Call c |
      c.getReceiver().toString() = "flask.request" and
      c.getMethodName() in ["get", "__getitem__", "stream", "data", "full_path", "url", "json", "get_json"] and
      this.asExpr() = c
