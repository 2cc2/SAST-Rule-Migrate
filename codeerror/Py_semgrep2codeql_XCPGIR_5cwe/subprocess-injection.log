Rule Content:
/**
 * @name Subprocess Injection
 * @description Detected user input entering a `subprocess` call unsafely.
 *              This could result in a command injection vulnerability.
 * @kind path-problem
 * @problem.severity error
 * @id py/subprocess-injection
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask
import semmle.python.Concepts

// Source: Flask input parameters
class FlaskInputSource extends DataFlow::Node {
  FlaskInputSource() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().regexpMatch("flask\\.request\\.(form|args|values|cookies|headers|view_args)\\.get") and
      this = call
    )
  }
}

// Source: Route parameters
class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Function method, Parameter param |
      method.getADecoration("flask.route") and
      param = method.getAParameter() and
      this = param
    )
  }
}

// Sink: subprocess call with potential injection
class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().matches("subprocess.%") and
      not call.getArgument(0).(StringLiteral).getLiteral().regexpMatch("^\\[\\\".+\\\",") and
      not call.getArgument(0).(StringLiteral).getLiteral() = "\"\\...\"" and
      this = call
    )
  }
}

// Sink: shell execution
class ShellSink extends DataFlow::Node {
  ShellSink() {
    exists(MethodCall call |
      call.getMethod().getQualifiedName().matches("subprocess.%") and
      call.getArgument(0).(StringLiteral).getLiteral().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$") and
      this = call
    )
  }
}

// Taint tracking configuration
class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskInputSource or source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink or sink instanceof ShellSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(ArrayAccess access |
      access.getParent() instanceof Dict and
      sanitizer = access
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SubprocessInjectionConfig config
where config.hasFlowPath(source, sink)
select sink,
  "Potential command injection vulnerability from user input to subprocess call",
  source, "User input originates from here"
