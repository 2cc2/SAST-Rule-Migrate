xcpgir_version: "1.0"
rule:
  id: "subprocess-injection"
  kind: taint
  severity: ERROR
  message: "Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability."
scope:
  languages: [python]
  frameworks: [flask]
  env: { os: [linux, windows], shell: [bash, sh, csh, tcsh, zsh] }
sources:
  - id: FLASK_INPUT
    match:
      node: CALL
      api: 
        package: flask.request
        type: flask.request
        method: get
      where:
        - op: regex
          left: methodFullName
          right: "flask\.request\.(form|args|values|cookies|headers|view_args)\.get"
  - id: ROUTE_PARAM
    match:
      node: METHOD_PARAMETER_IN
      where:
        - op: inside
          left: location
          right: "@APP.route(...)"
sinks:
  - id: SUBPROCESS_EXEC
    match:
      node: CALL
      api: 
        package: subprocess
        type: subprocess
        method: "*"
      where:
        - op: not
          condition: 
            op: or
            conditions:
              - op: eq
                left: arguments[0].value
                right: "\"...\""
              - op: regex
                left: arguments[0].value
                right: "^\[\".+\","
  - id: SHELL_EXEC
    match:
      node: CALL
      api: 
        package: subprocess
        type: subprocess
        method: "*"
      where:
        - op: regex
          left: arguments[0].arguments[0].value
          right: "^(sh|bash|ksh|csh|tcsh|zsh)$"
sanitizers:
  - id: SAFE_DICT_KEY
    match: { node: ARRAY_ACCESS, where: { op: eq, left: parent.kind, right: "DICT" } }
    effect: neutralize
propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
barriers: []
flows:
  - source: FLASK_INPUT
    sink: SUBPROCESS_EXEC
    through: [ARG_TO_PARAM*]
  - source: ROUTE_PARAM
    sink: SHELL_EXEC
    through: [ARG_TO_PARAM*]
report:
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: 0 }] }
tests: []
```
