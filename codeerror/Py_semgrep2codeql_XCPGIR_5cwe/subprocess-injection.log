Rule Content:
/**
 * @name Subprocess Injection
 * @description Detected user input entering a `subprocess` call unsafely.
 *              This could result in a command injection vulnerability allowing
 *              execution of arbitrary commands.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/subprocess-injection
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.security.StringTaint
import semmle.python.web.Flask
import semmle.python.Concepts

class FlaskInputSource extends RemoteUserInput::Range {
  FlaskInputSource() {
    exists(MethodAccess ma |
      ma.getMethod().getAPIName() in [
        "get", "__getitem__", "stream", "data", "full_path", "url", "json", "get_json"
      ] and
      ma.getQualifier().toString() = "flask.request" and
      ma.getMethod().getName() in [
        "form.get", "form.__getitem__", "args.get", "args.__getitem__",
        "values.get", "values.__getitem__", "cookies.get", "cookies.__getitem__",
        "headers.get", "headers.__getitem__", "view_args.get", "view_args.__getitem__"
      ]
    )
  }
}

class RouteParamSource extends RemoteUserInput::Range {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getName().matches("^route_") and
      p = f.getAParameter() and
      this = p.getValue()
    )
  }
}

class SubprocessSink extends DataFlow::Node::BarrierGuard {
  override predicate isBarrierGuard(DataFlow::Node node, DataFlow::BarrierKind kind) {
    exists(Call call, Expr arg |
      call.getTarget().getAPIName().matches("subprocess.*") and
      arg = call.getArg(0) and
      arg = node.asExpr() and
      not arg.(StringLiteral).getText().regexpMatch("\".*\"") and
      not exists(ListInit li | arg = li and li.getInitArg(0).(StringLiteral).getText().regexpMatch("\".*\""))
    )
  }
}

class ShellExecSink extends DataFlow::Node {
  ShellExecSink() {
    exists(Call call |
      call.getTarget().getAPIName().matches("subprocess.*") and
      call.getArg(1).getStringValue().matches("^(sh|bash|ksh|csh|tcsh|zsh)$")
    )
  }
}

class InterpreterExecSink extends DataFlow::Node {
  InterpreterExecSink() {
    exists(Call call |
      call.getTarget().getAPIName().matches("subprocess.*") and
      call.getArg(1).getStringValue().matches("^(python|python\\d)$")
    )
  }
}

// Flow configurations
query predicate cmdInjection(DataFlow::Node source, DataFlow::Node sink) {
  exists(SubprocessSink subSink |
    source instanceof FlaskInputSource or
    source instanceof RouteParamSource and
    sink = subSink and
    exists(DataFlow::PathNode path | 
      source.getAFutureStep+(path) and
      path.getNode() = sink
    )
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where cmdInjection(source.getNode(), sink.getNode())
select sink, "Potential command injection vulnerability from user input to subprocess call.", 
  source, "User input originates here."
