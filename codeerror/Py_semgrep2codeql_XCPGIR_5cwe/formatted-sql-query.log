Rule Content:
/**
 * @name Formatted SQL Query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @id formatted-sql-query
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/python
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.api.callgraph.Call
import DataFlow::PathGraph

class FormattedSqlSource extends TaintTracking::Source {
  FormattedSqlSource() {
    exists(Call cmd |
      cmd.getMethodName() = "execute" and
      cmd.getQualifier().getType().getName() = "DB" and
      (
        cmd.getArg(0).getStringValue().regexpMatch(".*(%|format|f\".*\").*") or
        exists(BinaryExpr binOp |
          binOp.getLeftOperand().getStringValue().regexpMatch(".*SELECT.*") and
          binOp.getRightOperand().toString() = this.toString()
        )
      )
    )
  }

  override predicate getAPrimaryQlClass() { result = "FormattedSqlSource" }

  override Node getBasicBlock() { result.getClass() }
  
  override string toString() { result = "Formatted SQL source" }
}

class SqlExecuteSink extends TaintTracking::Sink {
  SqlExecuteSink() {
    exists(Call cmd |
      cmd.getMethodName() = "execute" and
      cmd.getQualifier().getType().getName() = "DB" and
      this.asExpr() = cmd.getArg(0)
    )
  }

  override predicate getAPrimaryQlClass() { result = "SqlExecuteSink" }

  override Node getBasicBlock() { result.getClass() }
  
  override string toString() { result = "SQL execution sink" }
}

class SqlTaintConfig extends TaintTracking::Configuration {
  SqlTaintConfig() { this = "FormattedSqlTaintConfig" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof FormattedSqlSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof SqlExecuteSink
  }
}

from SqlTaintConfig cfg, PathNode source, PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input reaches SQL execution without sanitization. Use parameterized queries instead.",
  source.getNode(), "Formatted SQL source here",
  sink.getNode(), "SQL execution here"
