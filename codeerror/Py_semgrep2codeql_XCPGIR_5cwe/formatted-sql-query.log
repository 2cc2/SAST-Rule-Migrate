/**
 * @id formatted-sql-query
 * @severity warning
 * @message Detected possible formatted SQL query. Use parameterized queries instead.
 * @description Potential SQL injection via formatted string in query execution
 */

import python

predicate isStringFormatCall(Expr call) {
  exists(MethodAccess ma |
    ma = call and
    (
      ma.getMethod().toString().matches(".*%") or
      ma.getMethod().getName() = "format"
    )
  )
  or
  exists(FString fstr | fstr = call)
}

predicate isExecuteCall(Expr call) {
  exists(MethodAccess ma |
    ma = call and
    ma.getMethod().getName() = "execute"
  )
}

from MethodAccess executeCall, DataFlow::Node source, DataFlow::Node sink
where
  isExecuteCall(executeCall) and
  DataFlow::localFlow(source, sink) and
  isStringFormatCall(source.getBasicBlock().getNode()) and
  sink.asExpr() = executeCall.getArgument(0)
select executeCall, "Potential SQL injection via formatted string in query execution"
