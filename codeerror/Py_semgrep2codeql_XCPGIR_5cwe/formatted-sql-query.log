          concat.matches(".*SELECT.*") and
          concat.contains(this.asExpr().getText())
        )
      )
    )
  }
}

class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() {
    exists(Call c |
      c.getTarget().hasName("execute") and
      c.getReceiver().getType().hasName("DB") and
      this.asExpr() = c.getArgument(0)
    )
  }
}

class SqlTaintConfig extends TaintTracking::Configuration {
  SqlTaintConfig() { this = "FormattedSqlTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FormattedSqlSource
  }

