Rule Content:
/**
 * @name Formatted SQL Query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @id formatted-sql-query
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/python
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph


class FormatUsed extends DataFlow::Node {
  FormatUsed() {
    exists(Expr e |
      e.getStringValue().regexpMatch(".*(%|format|f\".*\").*") and
      this = e
    )
  }
}


class SqlSource extends DataFlow::Node {
  SqlSource() {
    exists(Call c |
      c.getFunc().getName() = "execute" and
      c.getReceiver().getType().hasName("DB") and
      this = c.getArg(0)
    )
  }
}


class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() {
    exists(Call c |
      c.getFunc().getName() = "execute" and
      c.getReceiver().getType().hasName("DB") and
      this = c.getArg(0)
    )
  }
}

class SqlTaintConfig extends TaintTracking::Configuration {
  SqlTaintConfig() { this = "SqlTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(FormatUsed fu |
      source = fu and
      exists(SqlSource ss | fu.asExpr() = ss.asExpr())
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
      node1 = arg and
      node2 = param
    )
  }
}

from SqlTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input reaches SQL execution without sanitization. Use parameterized queries instead.",
  source.getNode(), "Formatted SQL source here",
  sink.getNode(), "SQL execution here"
