Rule Content:
/**
 * @name Tainted Code Execution
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate 
 * dynamic content. If this content can be input from outside the program, this may be 
 * a code injection vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-code-exec
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(FunctionValue f, Parameter p |
      f.getAParameter() = p and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class CodeExecSink extends DataFlow::Node {
  CodeExecSink() {
    exists(CallNode call |
      (call.getFunc().(Name).getId() = "eval" or
      call.getFunc().(Name).getId() = "exec") and
      this.asExpr() = call.getArg(0)
    )
  }
}

class TaintedCodeExecConfig extends TaintTracking::Configuration {
  TaintedCodeExecConfig() { this = "TaintedCodeExecConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CodeExecSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(FunctionValue f, Parameter p, Argument arg |
      node1.asArgument() = arg and
      node2.asParameter() = p and
      f.getAParameter() = p and
      arg = f.getACall().getAnArg()
    )
  }
}

from TaintedCodeExecConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, 
  "Potential code injection vulnerability: unsafe use of eval/exec with tainted $@ input.", 
  source.getNode(), "user-provided value"
