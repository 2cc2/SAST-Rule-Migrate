Rule Content:
/**
 * @name Tainted Code Execution
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate
 * dynamic content. If this content can be input from outside the program, this may be
 * a code injection vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-code-exec
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow
import DataFlow::PathGraph

class EventParam extends TaintTracking::TaintSource {
  EventParam() {
    exists(Parameter p |
      this.asParameter() = p and
      p.getName() = "event"
    )
  }

  override predicate isSourceOf(DataFlow::Node node) { this = node }
}

class CodeExecSink extends TaintTracking::TaintSink {
  CodeExecSink() {
    exists(Call call |
      (call.getFunc().(Name).getId() = "eval" or
      call.getFunc().(Name).getId() = "exec") and
      this.asExpr() = call.getArg(0)
    )
  }

  override predicate isSinkOf(DataFlow::Node node) { this = node }
}

class TaintedCodeExecConfiguration extends TaintTracking::Configuration {
  TaintedCodeExecConfiguration() { this = "TaintedCodeExecConfiguration" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof EventParam
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof CodeExecSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Function f, Parameter p, Expr arg |
      node1.asExpr() = arg and
      node2.asParameter() = p and
      f.getParameter(_) = p and
      arg = f.getCall().getArg(_)
    )
  }
}

from TaintedCodeExecConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential code injection vulnerability: unsafe use of eval/exec with tainted $@ input.",
  source.getNode(), "user-provided value"
