Rule Content:
/**
 * @name Tainted code execution via eval/exec
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate
 *              dynamic content. If this content can be input from outside the program,
 *              this may be a code injection vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision medium
 * @tags security
 *       external/cwe/cwe-094
 * @id py/tainted-code-exec
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.TaintTracking::PathGraph

// Source: event parameter in handler functions
class EventSource extends TaintTracking::TaintSource {
  EventSource() {
    exists(Function f |
      f instanceof Function and
      f.getName().matches("%HANDLER%") and
      exists(Parameter p |
        p = f.getAParameter() and
        p.getName() = "event" and
        this.asParameter() = p
      )
    )
  }

  override predicate isSource(DataFlow::Node source) { this = source }

  override DataFlow::Node getSourceNode() { result = this }

  override DataFlow::Content getContent() { result = this }

  override string toString() { result = "Event parameter" }
}

// Sink: eval/exec calls with user-controlled input
class CodeExecutionSink extends TaintTracking::TaintSink, Expr {
  CodeExecutionSink() {
    exists(Call call |
      (call.getFunc().(Name).getId() = "eval" or call.getFunc().(Name).getId() = "exec") and
      this = call.getArg(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) { this = sink }

  override DataFlow::Node getSinkNode() { result = this }

  override string toString() { result = "Dangerous code execution via eval/exec" }
}

// Taint tracking configuration
class TaintedCodeExecConfig extends TaintTracking::Configuration {
  TaintedCodeExecConfig() { this = "TaintedCodeExecConfig" }

  override predicate isSource(TaintTracking::TaintSource source) { source instanceof EventSource }

  override predicate isSink(TaintTracking::TaintSink sink) { sink instanceof CodeExecutionSink }
}

from TaintedCodeExecConfig cfg, TaintTracking::PathNode source, TaintTracking::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, 
  "User input reaches dangerous code execution function ($@).",
  source.getNode(), "User input from event parameter",
  sink.getNode(), "Dangerous code execution via eval/exec"
