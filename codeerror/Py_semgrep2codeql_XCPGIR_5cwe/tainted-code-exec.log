Rule Content:
/**
 * @name Tainted code execution via eval/exec
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate
 *              dynamic content. If this content can be input from outside the program,
 *              this may be a code injection vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision medium
 * @tags security
 *       external/cwe/cwe-094
 * @id py/tainted-code-exec
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import DataFlow::PathGraph

// Source: event parameter in handler functions
class EventSource extends DataFlow::Node {
  EventSource() {
    exists(Function f |
      f.getAPrimaryQlClass() = "Function" and
      f.getName() = "HANDLER" and
      exists(Parameter p |
        p = f.getParameter(0) and
        p.getName() = "event" and
        this.asParameter() = p
      )
    )
  }
}

// Sink: eval/exec calls with user-controlled input
class CodeExecutionSink extends DataFlow::Node {
  CodeExecutionSink() {
    exists(Call call |
      (call.getFunc().(Name).getId() = "eval" or call.getFunc().(Name).getId() = "exec") and
      this = call.getArg(0)
    )
  }
}

// Taint tracking configuration
class TaintedCodeExecConfig extends TaintTracking::Configuration {
  TaintedCodeExecConfig() { this = "TaintedCodeExecConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CodeExecutionSink }
}

from TaintedCodeExecConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input reaches dangerous code execution function ($@).",
  source.getNode(), "User input from event parameter",
  sink.getNode(), "Dangerous code execution via eval/exec"
