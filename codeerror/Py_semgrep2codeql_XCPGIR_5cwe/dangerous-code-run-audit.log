```yaml
xcpgir_version: "1.0"
rule:
  id: dangerous-interactive-code-run-audit
  kind: taint
  severity: WARNING
  message: "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. This is dangerous if external data can reach this function call because it allows a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
scope:
  languages: [python]
  frameworks: ["*"]
sources:
  - id: EXTERNAL_INPUT
    match:
      node: PARAM | RETURN | FIELD
      where:
        - op: neq
          left: value
          right: "..."
sinks:
  - id: INTERACTIVE_CODE_RUN
    match:
      node: CALL
      api:
        type: code.InteractiveConsole | code.InteractiveInterpreter
        method: push | runsource | runcode
      arg_index: 0
sanitizers: []
barriers: []
propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
flows:
  - source: EXTERNAL_INPUT
    sink: INTERACTIVE_CODE_RUN
    through: [ARG_TO_PARAM*]
    constraints:
      path:
        must_not:
          - pattern: "LITERAL(value=\"...\")"
report:
  locations: ["sink"]
  evidence:
    capture:
      - argument: 0
tests:
  positive:
    - "console.push(user_input)"
  negative:
    - "console.push(\"print(1)\")"
```
