Rule Content:
/**
 * @name Dangerous interactive code execution
 * @description Detects dangerous dynamic content in InteractiveConsole/InteractiveInterpreter method calls.
 * @kind path-problem
 * @problem.severity warning
 * @id python/dangerous-interactive-code-run
 * @tags security
 *       external/cwe/cwe-094
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class InteractiveCodeRun extends DataFlow::Node {
  InteractiveCodeRun() {
    exists(Call mc, string methodName |
      mc.getFunc().hasQualifiedName("code", "InteractiveConsole|InteractiveInterpreter") and
      methodName in ["push", "runsource", "runcode"] and
      mc.getFunc().getName() = methodName and
      this = DataFlow::exprNode(mc.getArg(0))
    )
  }
}

class ExternalInput extends DataFlow::Node {
  ExternalInput() {
    exists(Parameter p | this = DataFlow::parameterNode(p)) or
    exists(Return r | this = DataFlow::exprNode(r.getResult())) or
    exists(Attribute f | this = DataFlow::exprNode(f))
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "DangerousInteractiveCodeExecution" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ExternalInput and
    not exists(StringLiteral lit | source.asExpr() = lit and lit.getValue() = "...")
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InteractiveCodeRun
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none }

  override predicate isBarrier(DataFlow::Node barrier) { none }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it " +
  "allows a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
