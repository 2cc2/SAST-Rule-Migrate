/**
 * @name Dangerous Interactive Code Execution
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.
 *              This is dangerous if external data can reach this function call because it
 *              allows a malicious actor to run arbitrary Python code.
 * @kind path-problem
 * @problem.severity warning
 * @id py/dangerous-interactive-code-run
 * @tags security
 *      external/cwe/cwe-95
 *      external/owasp/a03
 */
import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class InteractiveConsoleCall extends DataFlow::CallNode {
  InteractiveConsoleCall() {
    exists(Method method | 
      method.getQualifiedName().matches("code.InteractiveConsole.push") or
      method.getQualifiedName().matches("code.InteractiveConsole.runsource") or
      method.getQualifiedName().matches("code.InteractiveConsole.runcode") or
      method.getQualifiedName().matches("code.InteractiveInterpreter.push") or
      method.getQualifiedName().matches("code.InteractiveInterpreter.runsource") or
      method.getQualifiedName().matches("code.InteractiveInterpreter.runcode") |
      this = method.getACall()
    )
  }
}

class InteractiveConsoleSource extends DataFlow::Node {
  InteractiveConsoleSource() {
    exists(InteractiveConsoleCall call |
      this = call.getArgument(0)
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p | this = p.getAnAccess()) or
    exists(LocalVariable v | this = v.getAnAccess()) or
    exists(Return r | this = r.getAnAccess())
  }
  
  predicate isSafeLiteral() {
    exists(Literal l | this = l and l.getStringValue() = "...")
  }
}

class InteractiveConsoleFlow extends TaintTracking::Configuration {
  InteractiveConsoleFlow() { this = "InteractiveConsoleFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource and
    not source.(UserInputSource).isSafeLiteral()
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InteractiveConsoleSource
  }
}

from DataFlow::Node source, DataFlow::Node sink, InteractiveConsoleFlow flow
where flow.hasFlow(source, sink)
select sink,
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This allows malicious code execution if external data reaches this function call.",
  source, source,
  "User input flows to interactive code execution here"
