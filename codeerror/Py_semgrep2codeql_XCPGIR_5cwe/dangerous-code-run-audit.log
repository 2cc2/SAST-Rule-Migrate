Rule Content:
/**
 * @name Dangerous Interactive Code Execution
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.
 *              This is dangerous if external data can reach this function call because it
 *              allows a malicious actor to run arbitrary Python code.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id py/dangerous-interactive-code-run
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 */
import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class InteractiveConsoleCall extends DataFlow::PathNode {
  InteractiveConsoleCall() {
    exists(string qualifiedName |
      qualifiedName.matches("code.InteractiveConsole.push(%") or
      qualifiedName.matches("code.InteractiveConsole.runsource(%") or
      qualifiedName.matches("code.InteractiveConsole.runcode(%") or
      qualifiedName.matches("code.InteractiveInterpreter.push(%") or
      qualifiedName.matches("code.InteractiveInterpreter.runsource(%") or
      qualifiedName.matches("code.InteractiveInterpreter.runcode(%") |
      this = API::getTopLevelMember(qualifiedName).getACall()
    )
  }
}

class InteractiveConsoleSource extends DataFlow::PathNode {
  InteractiveConsoleSource() {
    exists(InteractiveConsoleCall call |
      this = call.getArgument(0)
    )
  }
}

class UserInputSource extends DataFlow::PathNode {
  UserInputSource() {
    this.asParameter() or
    this.asLocalVariable() or
    this.asReturn()
  }

  predicate isSafeLiteral() {
    exists(string lit | this.asExpr().getStringValue() = lit and lit = "...")
  }
}

class InteractiveConsoleFlow extends TaintTracking::Configuration {
  InteractiveConsoleFlow() { this = "InteractiveConsoleFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource and
    not source.(UserInputSource).isSafeLiteral()
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InteractiveConsoleSource
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, InteractiveConsoleFlow config
where config.hasFlowPath(source, sink)
select sink,
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it " +
  "allows malicious code execution.", source, source.getNode(),
  "User input reaches interactive code execution here"
