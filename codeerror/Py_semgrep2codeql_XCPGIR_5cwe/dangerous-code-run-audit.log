Rule Content:
/**
 * @name Dangerous Interactive Code Execution
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.
 *              This is dangerous if external data can reach this function call because it
 *              allows a malicious actor to run arbitrary Python code.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id py/dangerous-interactive-code-run
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 */
import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.TaintTracking
import semmle.python.dataflow.new.DataFlow

class InteractiveConsoleCall extends DataFlow::Call {
  InteractiveConsoleCall() {
    exists(Function fun, string methodName |
      methodName = fun.getQualifiedName() and
      (
        methodName.matches("code.InteractiveConsole.push") or
        methodName.matches("code.InteractiveConsole.runsource") or
        methodName.matches("code.InteractiveConsole.runcode") or
        methodName.matches("code.InteractiveInterpreter.push") or
        methodName.matches("code.InteractiveInterpreter.runsource") or
        methodName.matches("code.InteractiveInterpreter.runcode")
      ) and
      this = fun.getACall()
    )
  }
}

class InteractiveConsoleSource extends DataFlow::Node {
  InteractiveConsoleSource() {
    exists(InteractiveConsoleCall call |
      this = DataFlow::argumentNode(call, 0)
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p | this = p.getAnAccess()) or
    exists(LocalVariable v | this = v.getAnAccess()) or
    exists(ReturnStmt r | this = r.getExpr())
  }
  
  predicate isSafeLiteral() {
    exists(string lit | this = lit.getLocation().getParent*() and lit = "...")
  }
}

class InteractiveConsoleFlow extends TaintTracking::Configuration {
  InteractiveConsoleFlow() { this = "InteractiveConsoleFlow" }

  override predicate isSource(TaintTracking::Source source) {
    source.getNode() instanceof UserInputSource and
    not source.getNode().(UserInputSource).isSafeLiteral()
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink.getNode() instanceof InteractiveConsoleSource
  }
}

from DataFlow::Node source, DataFlow::Node sink, InteractiveConsoleFlow flow
where flow.hasFlow(source, sink)
select sink,
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This allows malicious code execution if external data reaches this function call.",
  source, source,
  "User input flows to interactive code execution here"
