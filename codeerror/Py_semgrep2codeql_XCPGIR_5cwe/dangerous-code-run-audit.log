Rule Content:
/**
 * @name Dangerous interactive code execution
 * @description Detects dangerous dynamic content in InteractiveConsole/InteractiveInterpreter method calls.
 * @kind path-problem
 * @problem.severity warning
 * @id python/dangerous-interactive-code-run
 * @tags security
 *       external/cwe/cwe-094
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.code.python.dataflow.TaintTracking

class InteractiveCodeRun extends TaintTracking::TaintSink {
  InteractiveCodeRun() {
    exists(Call mc, string methodName |
      mc.getTarget().hasQualifiedName("code", "InteractiveConsole|InteractiveInterpreter") and
      methodName in ["push", "runsource", "runcode"] and
      mc.getMethodName() = methodName and
      this = mc.getArgument(0).asExpr()
    )
  }

  override predicate asCfgNode(ControlFlowNode node) { none }
  override string getLocation() { result = "" }
  override BasicBlock getBasicBlock() { none }
  override string toString() { result = "" }
  override ControlScope getScope() { none }
}

class ExternalInput extends TaintTracking::TaintSource {
  ExternalInput() {
    exists(Parameter p | this = p) or
    exists(Return r | this = DataFlow::exprNode(r.getResult())) or
    exists(Attribute f | this = DataFlow::exprNode(f))
  }

  override predicate asCfgNode(ControlFlowNode node) { none }
  override string getLocation() { result = "" }
  override BasicBlock getBasicBlock() { none }
  override string toString() { result = "" }
  override ControlScope getScope() { none }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "DangerousInteractiveCodeExecution" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof ExternalInput and
    not exists(StringLiteral lit | source.asExpr() = lit and lit.getValue() = "...")
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof InteractiveCodeRun
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) { none }

  override predicate isBarrier(TaintTracking::Barrier barrier) { none }
}

from Config cfg, TaintTracking::SourceNode source, TaintTracking::SinkNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it " +
  "allows a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
