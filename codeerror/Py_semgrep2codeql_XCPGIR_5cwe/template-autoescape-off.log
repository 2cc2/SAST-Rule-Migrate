/**
 * @name Template Autoescape Off
 * @id template-autoescape-off
 * @description Detected a segment of a Flask template where autoescaping is explicitly
 *   disabled with '{% autoescape off %}'. This allows rendering of raw HTML in this
 *   segment. Ensure no user data is rendered here, otherwise this is a cross-site
 *   scripting (XSS) vulnerability, or turn autoescape on.
 * @kind problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-079
 */

import python

predicate isAutoescapeOffCall(Expr arg) {
  exists(string regex |
    regex = "{%\\s*autoescape\\s+false\\s*%}" and
    arg.getValue().regexpMatch(regex)
  )
}

from Call call, Expr arg
where
  isAutoescapeOffCall(arg) and
  call.getArg(0) = arg
select call, "Autoescaping disabled in Flask template - potential XSS risk"
