Rule Content:
/**
 * @name Flask template autoescape off
 * @description Detects Flask templates where autoescaping is explicitly disabled,
 *              which may lead to XSS vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id python/flask/autoescape-off
 * @tags security
 *       external/cwe/cwe-79
 */

import python
import semmle.python.security.XSS
import semmle.python.web.flask.Templating

class AutoescapeOff extends Expr {
  AutoescapeOff() {
    this.getText().regexpMatch("\\{%\\s*autoescape\\s+false\\s*%\\}")
  }
}

from Expr autoescapeOff, Call renderCall, DataFlow::PathNode source, DataFlow::PathNode sink
where
  autoescapeOff instanceof AutoescapeOff and
  renderCall.getTarget().hasQualifiedName("flask.templating", "render_template") and
  DataFlow::localFlow(source, sink) and
  source.asExpr() = autoescapeOff and
  sink.asExpr() = renderCall
select sink, "Autoescaping is disabled in Flask template (" + autoescapeOff.getLocation() + 
             "), which may lead to XSS vulnerability", source, autoescapeOff.toString()
