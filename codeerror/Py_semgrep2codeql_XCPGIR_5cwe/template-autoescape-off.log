Rule Content:
/**
 * @name Flask template autoescape off
 * @description Detects Flask templates where autoescaping is explicitly disabled,
 *              which may lead to XSS vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id python/flask/autoescape-off
 * @tags security
 *       external/cwe/cwe-79
 */

import python
import python.web.flask
import DataFlow::PathGraph

class AutoescapeOff extends string {
  AutoescapeOff() {
    this.regexpMatch("\\{%\\s*autoescape\\s+false\\s*%\\}")
  }
}

class XssConfig extends DataFlow::Configuration {
  XssConfig() { this = "XSS configuration" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof AutoescapeOff
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCalleeName() = "render_template" and
      call.getImportedFrom("flask") and
      sink.asExpr() = call
    )
  }
}

from XssConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Autoescaping is disabled in Flask template (" + source.getLocation() +
             "), which may lead to XSS vulnerability", source, source.toString()
