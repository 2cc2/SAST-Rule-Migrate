  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCalleeName() = "render_template" and
      call.getImportedFrom("flask") and
      sink.asExpr() = call
    )
  }
}

from XssConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Autoescaping is disabled in Flask template (" + source.getLocation() +
             "), which may lead to XSS vulnerability", source, source.toString()
================================================================================
