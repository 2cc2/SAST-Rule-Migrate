 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.frameworks.flask.FlaskTemplates

from TemplateBlock block
where 
  block.getName() = "autoescape" and
  block.getContent().regexpMatch("(?i)false")
select block, "Autoescaping disabled in Flask template - potential XSS risk",
  "This template segment disables autoescaping which may lead to XSS vulnerabilities"
