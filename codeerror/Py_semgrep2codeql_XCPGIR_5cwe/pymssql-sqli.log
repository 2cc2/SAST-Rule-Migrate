Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object.
 *              This could lead to SQL injection if the variable is user-controlled
 *              and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pymssql-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() { this = any(Parameter p | p.getName() = "event") }
  
  override predicate isSource(DataFlow::Node source) {
    source.asParameter().getName() = "event" and
    exists(Function f |
      f.getName().matches("%lambda_handler%") and
      f.getAParameter() = source.asParameter()
    )
  }
}

class PymssqlExecutionSink extends DataFlow::Node {
  PymssqlExecutionSink() {
    exists(MethodCall call |
      call.getMethod().getName() = "execute" and
      call.getQualifier().getType().hasQualifiedName("pymssql", "Cursor") and
      this = call.getArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PymssqlExecutionSink
  }
}

class PymssqlConfig extends TaintTracking::Configuration {
  PymssqlConfig() { this = "pymssql-sqli" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PymssqlExecutionSink
  }
}

from PymssqlConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "User input from Lambda event reaches SQL execution without sanitization",
  source, "This user input originates from Lambda event parameter",
  sink, "This SQL execution might be vulnerable to injection"
