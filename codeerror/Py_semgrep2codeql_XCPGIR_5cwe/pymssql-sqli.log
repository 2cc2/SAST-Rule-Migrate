Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object.
 *              This could lead to SQL injection if the variable is user-controlled
 *              and not properly sanitized.
 * @kind taint
 * @problem.severity warning
 * @id python/pymssql-sqli
 */

import python
import semmle.python.security.strings.SQL
import DataFlow::PathGraph

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      f.getName() = "lambda_handler" and
      p.getName() = "event" and
      p.getFunction() = f and
      this.asParameter() = p
    )
  }
}

class PymssqlExecutionSink extends DataFlow::Node {
  PymssqlExecutionSink() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "execute" and
      mc.getQualifier().getType().hasQualifiedName("pymssql", "Cursor") and
      this.asExpr() = mc.getArgument(0)
    )
  }
}

predicate isSanitized(DataFlow::Node node) {
  // Customize this predicate if specific sanitization patterns should be considered
  false
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(LambdaEventSource lsource |
    source.getNode() = lsource and
    sink.getNode() instanceof PymssqlExecutionSink and
    DataFlow::flowPath(source, sink)
  )
select sink.getNode(), "User input from Lambda event reaches SQL execution without sanitization", source.getNode(),
  "Potential SQL injection from Lambda event parameter to pymssql execution"
