Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the
 * variable is user-controlled and not properly sanitized. In order to prevent SQL injection,
 * use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pymssql-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow
import semmle.python.ApiGraphs
import semmle.python.Concepts

class EventSource extends DataFlow::Node {
  EventSource() {
    exists(Function f, Parameter p |
      p = f.getAParameterNamed("event") and
      this = p
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(Call call |
      call.getTarget().getName() = "execute" and
      call.getTarget().getQualifier().getType().getName() = "Cursor" and
      call.getTarget().getQualifier().getType().getSourceDeclaration().getFile().getBaseName() = "pymssql" and
      this = call.getArgument(0)
    )
  }
}

class ParameterizedQuerySanitizer extends TaintTracking::Sanitizer {
  override predicate isSanitizer(DataFlow::Node node) {
    exists(Call call |
      call.getTarget().getName() = "execute" and
      call.getTarget().getQualifier().getType().getName() = "Cursor" and
      call.getTarget().getQualifier().getType().getSourceDeclaration().getFile().getBaseName() = "pymssql" and
      call.getNumArgument() > 1 and
      node = call.getArgument(0)
    )
  }
}

class PymssqlSqliConfig extends TaintTracking::Configuration {
