import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.pathgraph.DataFlowPathGraph
import semmle.python.ApiGraphs
import semmle.python.Concepts

class EventSource extends DataFlow::Node {
  EventSource() {
    exists(Function f, Parameter p |
      p = f.getParameter(0) and
      p.getName() = "event" and
      this = DataFlow::parameterNode(p)
    )
  }
  
  override ControlFlow::CfgNode asCfgNode() { result = this.asCfgNode() }
  override string toString() { result = "Event parameter" }
  override Location getLocation() { result = this.getLocation() }
  override BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class SqlSink extends DataFlow::Node {
