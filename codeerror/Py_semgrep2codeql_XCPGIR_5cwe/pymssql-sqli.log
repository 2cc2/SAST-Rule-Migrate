Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object.
 *              This could lead to SQL injection if the variable is user-controlled
 *              and not properly sanitized.
 * @kind taint
 * @problem.severity warning
 * @id python/pymssql-sqli
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.ApiGraphs

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      f.getName().matches("%lambda_handler%") and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class PymssqlExecutionSink extends DataFlow::Node {
  PymssqlExecutionSink() {
    exists(Call call | 
      call.getCalleeName() = "execute" and
      call.getQualifier().getType().hasQualifiedName("pymssql", "Cursor") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

module TaintTracking = TaintTracking::global<
  LambdaEventSource, 
  PymssqlExecutionSink
>;

from LambdaEventSource source, PymssqlExecutionSink sink
where TaintTracking::localTaint(source, sink)
select sink, 
  "User input from Lambda event reaches SQL execution without sanitization",
  source, source.getNode().toString(),
  sink, sink.getNode().toString()
