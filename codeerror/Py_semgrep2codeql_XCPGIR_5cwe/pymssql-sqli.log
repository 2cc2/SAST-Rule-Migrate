import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class LambdaEventSource extends TaintTracking::TaintSource {
  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      p.getName() = "event" and
      source.asParameter() = p and
      exists(Function f |
        f.getName().matches("%lambda_handler%") and
        f.getAParameter() = p
      )
    )
  }
}

class PymssqlExecutionSink extends TaintTracking::TaintSink {
  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall call |
      call.getMethod().getName() = "execute" and
      call.getQualifier().getType().hasQualifiedName("pymssql", "Cursor") and
      sink.asExpr() = call.getArgument(0)
    )
  }
}

class PymssqlConfig extends TaintTracking::Configuration {
  PymssqlConfig() { this = "pymssql-sqli" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof PymssqlExecutionSink
  }
}

