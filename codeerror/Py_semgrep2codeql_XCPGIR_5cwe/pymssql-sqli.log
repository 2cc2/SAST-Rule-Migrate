Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object.
 *              This could lead to SQL injection if the variable is user-controlled
 *              and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pymssql-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      f.getName().matches("%lambda_handler%") and
      p.getName() = "event" and
      this = DataFlow::parameterNode(p)
    )
  }
}

class PymssqlExecutionSink extends DataFlow::Node {
  PymssqlExecutionSink() {
    exists(Call call |
      call.getCallee().getName() = "execute" and
      call.getReceiver().getType().hasQualifiedName("pymssql", "Cursor") and
      this = DataFlow::exprNode(call.getArg(0))
    )
  }
}

class PymssqlConfig extends TaintTracking::Configuration {
  PymssqlConfig() { this = "pymssql-sqli" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PymssqlExecutionSink
  }
}

from PymssqlConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(),
  "User input from Lambda event reaches SQL execution without sanitization",
  source.getNode(), "This user input originates from Lambda event parameter",
  sink.getNode(), "This SQL execution might be vulnerable to injection"
