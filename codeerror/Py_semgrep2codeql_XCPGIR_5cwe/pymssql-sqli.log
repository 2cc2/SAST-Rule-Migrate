xcpgir_version: "1.0"
rule:
  id: pymssql-sqli
  kind: taint
  severity: WARNING
  message: >-
    Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the
    variable is user-controlled and not properly sanitized. In order to prevent SQL injection,
    use parameterized queries or prepared statements instead.
    You can use parameterized statements like so:
    `cursor.execute('SELECT * FROM projects WHERE status = %s', 'active')`
scope:
  languages: [python]
  frameworks: ["pymssql", "aws-lambda"]
  env: { os: [linux, windows], shell: [bash, sh] }

sources:
  - id: EVENT_OBJECT
    match:
      node: PARAM
      where:
        - op: eq
          left: name
          right: "event"

sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: { type: "pymssql.Cursor", method: "execute" }
      arg_index: 0

sanitizers:
  - id: PARAMETERIZED_QUERY
    match: { node: CALL, api: { type: "pymssql.Cursor", method: "execute" } }
    effect: neutralize
    scope:
      sinks: [SQL_EXEC]
    where:
      - op: gt
        left: args.length
        right: 1

propagations:
  - id: DATAFLOW
    edge: arg->param
    kind: taint

flows:
  - source: EVENT_OBJECT
    sink: SQL_EXEC
    through: [DATAFLOW*]
    constraints:
      path:
        must: [ { pattern: "CALL(pymssql.Cursor.execute)" } ]
        must_not: [ { pattern: "hasMoreArgumentsThan(1)" } ]

report:
  message: "User input from event object reaches SQL execution without sanitization"
  locations: ["source", "sink", "path"]
  evidence:
    capture: [{ argument: 0 }]

tests:
  positive:
    - cursor.execute(event.query)
  negative:
    - cursor.execute("SELECT * FROM projects WHERE status = %s", "active")
