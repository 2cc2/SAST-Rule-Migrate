Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the
 * variable is user-controlled and not properly sanitized. In order to prevent SQL injection,
 * use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pymssql-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph
import semmle.python.ApiGraphs
import semmle.python.Concepts

class EventSource extends DataFlow::ParameterNode {
  EventSource() {
    exists(Function f |
      this = f.getParameterNamed("event")
    )
  }
  
  override string toString() { result = "Event parameter" }
  override Location getLocation() { result = this.getLocation() }
  override BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(Call call |
      call.getCallee().getName() = "execute" and
      call.getCallee().getQualifier().getType().getName() = "Cursor" and
      call.getCallee().getQualifier().getType().getSourceDeclaration().getFile().getBaseName() = "pymssql" and
      this.asExpr() = call.getArgument(0)
    )
  }
  
  override string toString() { result = "SQL execute call" }
  override Location getLocation() { result = this.getLocation() }
  override BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override DataFlow::Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class ParameterizedQuerySanitizer extends TaintTracking::Sanitizer {
  override predicate isSanitizer(DataFlow::Node node) {
    exists(Call call |
      call.getCallee().getName() = "execute" and
      call.getCallee().getQualifier().getType().getName() = "Cursor" and
      call.getCallee().getQualifier().getType().getSourceDeclaration().getFile().getBaseName() = "pymssql" and
      call.getNumArgument() > 1 and
      node.asExpr() = call.getArgument(0)
    )
  }
}

class PymssqlSqliConfig extends TaintTracking::Configuration {
  PymssqlSqliConfig() { this = "PymssqlSqliConfig" }

  override predicate isSource(TaintTracking::TaintSource source) { 
    source instanceof EventSource 
  }

  override predicate isSink(TaintTracking::TaintSink sink) { 
    sink instanceof SqlSink 
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    TaintTracking::localTaintStep(pred, succ)
  }
}

