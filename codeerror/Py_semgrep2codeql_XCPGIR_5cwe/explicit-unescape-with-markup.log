Rule Content:
/**
 * @name ExplicitUnescapeWithMarkup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits the unescaped data
 *              to include unescaped HTML which could result in cross-site scripting.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @id python/flask/xss-explicit-unescape
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow
import semmle.python.Web

class MarkupUnescapeSource extends DataFlow::Node {
  MarkupUnescapeSource() {
    exists(CallNode call |
      call.getCalleeName() = "unescape" and
      exists(Class cls | 
        cls.getName() = "Markup" and
        call.getReceiver().getType() = cls and
        call.getReceiver().getType().getModule().getName() = "flask"
      )
    )
  }
}

class MarkupConstructorSink extends DataFlow::Node {
  MarkupConstructorSink() {
    exists(ConstructionNode call |
      call.getConstructedType().getName() = "Markup" and
      call.getConstructedType().getModule().getName() = "flask" and
      exists(StringLiteral sl | sl = call.getArgument(0))
    )
  }
}

class MarkupUnescapeConfig extends TaintTracking::Configuration {
  MarkupUnescapeConfig() { 
    this = "MarkupUnescapeConfig" 
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof MarkupUnescapeSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MarkupConstructorSink
  }
}

from MarkupUnescapeConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Unescaped content using 'Markup()' detected. Ensure this data is not externally controlled."
