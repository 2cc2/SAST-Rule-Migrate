Rule Content:
/**
 * @name Explicit unescape with Markup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits the unescaped data to include unescaped HTML which could result in cross-site scripting.
 * @kind path-problem
 * @problem.severity warning
 * @id py/explicit-unescape-with-markup
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Flask
import DataFlow::PathGraph

class MarkupCall extends TaintTracking::Source {
  MarkupCall() {
    exists(Call call |
      call.getTarget().getPackage().getName() = "flask" and
      call.getTarget().getDeclaringType().getName() = "Markup" and
      call.getTarget().getName() = "__init__" and
      this = call
    )
  }
  override predicate isSourceOf(TaintKind kind) { kind instanceof RemoteFlowSource }
  override string toString() { result = "Markup call" }
}

class UnescapeCall extends TaintTracking::Source {
  UnescapeCall() {
    exists(Call call |
      call.getTarget().getPackage().getName() = "flask" and
      call.getTarget().getDeclaringType().getName() = "Markup" and
      call.getTarget().getName() = "unescape" and
      this = call
    )
  }
  override predicate isSourceOf(TaintKind kind) { kind instanceof RemoteFlowSource }
  override string toString() { result = "Unescape call" }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "Explicit unescape with Markup" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof MarkupCall or source instanceof UnescapeCall
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getTarget().getPackage().getName() = "flask" and
      call.getTarget().getDeclaringType().getName() = "Markup" and
      call.getTarget().getName() = "__init__" and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Call call |
      call.getTarget().getPackage().getName() = "flask" and
      call.getTarget().getDeclaringType().getName() = "Markup" and
      (
        call.getTarget().getName() = "__init__" or
        call.getTarget().getName() = "unescape"
      ) and
      node1.asExpr() = call.getArgument(0) and
      node2.asExpr() = call
    )
  }
}

from Config cfg, PathNode source, PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Detected explicitly unescaped content using 'Markup()'. This permits the unescaped data to include unescaped HTML which could result in cross-site scripting.",
  source.getNode(),
  "Potential XSS source"
