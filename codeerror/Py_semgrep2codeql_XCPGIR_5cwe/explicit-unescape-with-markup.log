Rule Content:
/**
 * @name ExplicitUnescapeWithMarkup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits the unescaped data
 *              to include unescaped HTML which could result in cross-site scripting.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @id python/flask/xss-explicit-unescape
 */

import python
import semmle.python.security.XSS
import semmle.python.dataflow.new.TaintTracking
import python.frameworks.flask.FlaskRouting

class MarkupUnescapeSource extends RemoteFlowSource::Range {
  MarkupUnescapeSource() {
    exists(MethodCall call | 
      call.getTarget().getName() = "escape" and
      call.getReceiver().getType().getName() = "Markup" and
      call.getReceiver().getStrictQualifier().getName() = "flask"
    )
  }
}

class MarkupConstructorSink extends TaintSink::Range {
  MarkupConstructorSink() {
    exists(MethodCall call |
      call.getTarget().getName() = "Markup" and
      call.getTarget().getDeclaringType().getName() = "Markup" and
      call.getTarget().getStrictQualifier().getName() = "flask" and
      call.getArg(0) != DataFlow::stringLiteral("")
    )
  }
}

class MarkupUnescapeConfig extends TaintTracking::Configuration {
  MarkupUnescapeConfig() { this = "MarkupUnescapeConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof MarkupUnescapeSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MarkupConstructorSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    none()
  }
}

from MarkupUnescapeConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Unescaped content using 'Markup()' detected. Ensure this data is not externally controlled."
