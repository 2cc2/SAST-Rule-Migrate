/**
 * @name Explicit unescape with Markup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits the unescaped data to include unescaped HTML which could result in cross-site scripting.
 * @kind path-problem
 * @problem.severity warning
 * @id py/explicit-unescape-with-markup
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class MarkupCall extends DataFlow::Node {
  MarkupCall() {
    exists(DataFlow::CallNode call |
      call.getCallee().getPackage().getName() = "flask" and
      call.getCallee().getDeclaringType().getName() = "Markup" and
      call.getCallee().getName() = "__init__" and
      this = call
    )
  }
  override string toString() { result = "Markup call" }
}

class UnescapeCall extends DataFlow::Node {
  UnescapeCall() {
    exists(DataFlow::CallNode call |
      call.getCallee().getPackage().getName() = "flask" and
      call.getCallee().getDeclaringType().getName() = "Markup" and
      call.getCalee().getName() = "unescape" and
      this = call
    )
  }
  override string toString() { result = "Unescape call" }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "Explicit unescape with Markup" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof MarkupCall or source instanceof UnescapeCall
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DataFlow::CallNode call |
      call.getCallee().getPackage().getName() = "flask" and
      call.getCallee().getDeclaringType().getName() = "Markup" and
      call.getCalee().getName() = "__init__" and
      sink = call.getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::CallNode call |
      call.getCallee().getPackage().getName() = "flask" and
      call.getCallee().getDeclaringType().getName() = "Markup" and
      (
        call.getCalee().getName() = "__init__" or
        call.getCalee().getName() = "unescape"
      ) and
      node1 = call.getArgument(0) and
      node2 = call
    )
  }
}

