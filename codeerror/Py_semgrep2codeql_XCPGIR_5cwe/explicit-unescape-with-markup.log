Rule Content:
/**
 * @name Explicit unescape with Markup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits the unescaped data to include unescaped HTML which could result in cross-site scripting.
 * @kind path-problem
 * @problem.severity warning
 * @id py/explicit-unescape-with-markup
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.security.TaintTracking

class MarkupCall extends TaintTracking::Source {
  MarkupCall() {
    exists(Call call |
      call.getCalledFunction().getPackage().getName() = "flask" and
      call.getCalledFunction().getDeclaringType().getName() = "Markup" and
      call.getCalledFunction().getName() = "__init__" and
      this = call
    )
  }

  override predicate isSourceOf(TaintKind kind) { kind instanceof TaintKind }
  override predicate asCfgNode(Function entry) { none() }
  override Location getLocation() { result = this.getLocation() }
  override predicate getBasicBlock() { none() }
  override string toString() { result = "Markup call" }
  override predicate getScope() { result = none() }
  override predicate asVariable() { none() }
}

class UnescapeCall extends TaintTracking::Source {
  UnescapeCall() {
    exists(Call call |
      call.getCalledFunction().getPackage().getName() = "flask" and
      call.getCalledFunction().getDeclaringType().getName() = "Markup" and
      call.getCalledFunction().getName() = "unescape" and
      this = call
    )
  }

  override predicate isSourceOf(TaintKind kind) { kind instanceof TaintKind }
  override predicate asCfgNode(Function entry) { none() }
  override Location getLocation() { result = this.getLocation() }
  override predicate getBasicBlock() { none() }
  override string toString() { result = "Unescape call" }
  override predicate getScope() { result = none() }
  override predicate asVariable() { none() }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "Explicit unescape with Markup" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof MarkupCall or source instanceof UnescapeCall
  }

  override predicate isSink(TaintTracking::Sink sink) {
    exists(Call call |
      call.getCalledFunction().getPackage().getName() = "flask" and
      call.getCalledFunction().getDeclaringType().getName() = "Markup" and
      call.getCalledFunction().getName() = "__init__" and
      sink = call.getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(TaintTracking::TestStep step) {
    exists(Call call |
      call.getCalledFunction().getPackage().getName() = "flask" and
      call.getCalledFunction().getDeclaringType().getName() = "Markup" and
      (
        call.getCalledFunction().getName() = "__init__" or
        call.getCalledFunction().getName() = "unescape"
      ) and
      step.node1() = call.getArgument(0) and
      step.node2() = call
    )
  }
}

from Config cfg, TaintTracking::PathNode source, TaintTracking::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Detected explicitly unescaped content using 'Markup()'. This permits the unescaped data to include unescaped HTML which could result in cross-site scripting.",
  source.getNode(),
  "Potential XSS source"
