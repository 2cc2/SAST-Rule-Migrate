 * @id python/flask/xss-explicit-unescape
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class MarkupUnescapeSource extends DataFlow::Node {
  MarkupUnescapeSource() {
    exists(Call call | 
      call.getTarget().getName() = "unescape" and
      call.getReceiver().getType().getName() = "Markup" and
      call.getReceiver().getStrictQualifier().getName() = "flask"
    )
