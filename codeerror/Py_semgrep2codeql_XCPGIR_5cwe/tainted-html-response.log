Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning  
 * @id python/aws-lambda/tainted-html-response
 * @tags security
 *       external/cwe/cwe-079
 *       external/owasp/a07
 *       external/owasp/a03
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class EventSource extends DataFlow::Node::ParameterNode {
  EventSource() {
    exists(Function f, Parameter p |
      f.getName() = "lambda_handler" and
      p.getFunction() = f and  
      p.getName() = "event" and
      this.getParameter() = p
    )
  }
}

class HtmlResponseSink extends DataFlow::Node::ExprNode {
  HtmlResponseSink() {
    exists(ReturnStmt r |
      r.getValue().toString().regexpMatch("\\{\"headers\": \\{.*\"Content-Type\": \"text/html\".*\\}, \"body\": \\$.+\\}") and
      this.getExpr() = r.getValue()
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TaintedHtmlResponseConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlResponseSink
  }
}

from Config cfg, DataFlow::Node source, DataFlow::Node sink  
where cfg.hasFlow(source, sink)
select sink, source, 
  "Potential XSS vulnerability: User input flows into HTML response. $@ highlights the source of user input.",
  source, "User input from here"
