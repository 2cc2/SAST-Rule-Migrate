Rule Content:
/**
 * @name Tainted HTML Response in AWS Lambda
 * @description Detected user input flowing into an HTML response in AWS Lambda functions.
 *              Manual HTML construction may bypass secure rendering methods, creating XSS
 *              vulnerabilities that could let attackers steal sensitive user data.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-response
 * @tags security
 *      cwe/79
 *      owasp/a07
 *      owasp/a03
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Function f |
      f.getName() = "handler" and
      exists(Parameter p |
        p = f.getAParameter() and
        p.getPosition() = 0 and
        p.getName() = "event" and
        this = DataFlow::parameterNode(p)
      )
    )
  }
}

class HtmlResponseSink extends DataFlow::Node {
  HtmlResponseSink() {
    exists(Dict d |
      d = this.asExpr() and
      exists(Expr headersKey |
        headersKey = d.getAKey() and
        headersKey.getStringValue() = "headers" and
        exists(Dict headersDict |
          headersDict = d.get(headersKey).asDict() and
          exists(Expr contentTypeKey |
            contentTypeKey = headersDict.getAKey() and
            contentTypeKey.getStringValue().toLowerCase() = "content-type" and
            exists(string contentTypeValue |
              contentTypeValue = headersDict.get(contentTypeKey).getStringValue() and
              contentTypeValue.toLowerCase().regexpMatch(".*text/html.*")
            )
          )
        )
      ) and
      exists(Expr bodyKey |
        bodyKey = d.getAKey() and
        bodyKey.getStringValue() = "body" and
        this = DataFlow::exprNode(d.get(bodyKey))
      )
    )
  }
}

class TaintedHtmlFlowConfig extends TaintTracking::Configuration {
  TaintedHtmlFlowConfig() { this = "TaintedHtmlFlowConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaEventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof HtmlResponseSink }
}

from TaintedHtmlFlowConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input flows into HTML response, potentially creating XSS vulnerabilities.",
  source, "User input comes from this event parameter",
  sink, "Ends up in HTML response body"
================================================================================
