  - id: EVENT_PARAM
    match:
      node: PARAM
      where:
        - op: eq
          left: name
          right: event
      pattern-inside: |
        def $HANDLER(event, context):
          ...
sinks:
  - id: HTML_RESPONSE
    match:
      node: LITERAL | IDENTIFIER
      pattern-inside: |
        {..., "headers": {..., "Content-Type": "text/html", ...}, "body": $BODY, ... }
      where:
        - op: eq
          left: $BODY
          right: $BODY
propagations:
  - id: DATA_FLOW
    edge: arg->param
    kind: taint
flows:
  - source: EVENT_PARAM
    sink: HTML_RESPONSE
    through: [DATA_FLOW*]
report:
  locations: ["source", "sink"]
  evidence: {}
metadata:
  cwe: ["CWE-79: Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')"]
  owasp: ["A07:2017 - Cross-Site Scripting (XSS)", "A03:2021 - Injection"]
  category: security
  technology: ["aws-lambda"]
  references: ["https://owasp.org/Top10/A03_2021-Injection"]
  cwe2022-top25: true
  cwe2021-top25: true
  subcategory: ["vuln"]
  likelihood: HIGH
  impact: MEDIUM
  confidence: MEDIUM
```
