Rule Content:
/**
 * @name Tainted HTML Response in AWS Lambda
 * @description Detected user input flowing into an HTML response in AWS Lambda functions.
 *              Manual HTML construction may bypass secure rendering methods, creating XSS 
 *              vulnerabilities that could let attackers steal sensitive user data.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-response
 * @precision medium
 * @tags security
 *       cwe/79
 *       owasp/a07
 *       owasp/a03
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.StringManipulation
import semmle.python.WebAPIs

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Function f |
      f.getName() = "handler" and
      this.asParameter() = f.getAParameter() and
      this.getName() = "event"
    )
  }
}

class HtmlResponseSink extends DataFlow::Node {
  HtmlResponseSink() {
    exists(Dict d, string key, DataFlow::Node body |
      d = this.asExpr().(Dict) and
      key = d.getAKey() and
      key.getText() = "headers" and
      exists(Dict headersDict |
        headersDict = d.get(key).(Dict) and
        exists(string contentTypeKey, string contentTypeValue |
          contentTypeKey = headersDict.getAKey() and
          contentTypeKey.getText().toLowerCase() = "content-type" and
          contentTypeValue = headersDict.get(contentTypeKey).(StringLiteral).getText() and
          contentTypeValue.toLowerCase().matches("%text/html%")
        )
      ) and
      exists(string bodyKey |
        bodyKey = d.getAKey() and
        bodyKey.getText() = "body" and
        body = d.get(bodyKey)
      ) and
      this = body
    )
  }
}

class LambdaEventTaintConfig extends TaintTracking::Configuration {
  LambdaEventTaintConfig() { this = "LambdaEventTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaEventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof HtmlResponseSink }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    TaintTracking::localTaintStep(pred, succ)
  }
}

from LambdaEventTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input flows into HTML response, potentially creating XSS vulnerabilities.", 
  source.getNode(), "User input comes from this event parameter",
  sink.getNode(), "Ends up in HTML response body"
