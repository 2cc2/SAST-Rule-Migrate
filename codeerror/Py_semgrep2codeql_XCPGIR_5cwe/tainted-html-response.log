Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id python/aws-lambda/tainted-html-response
 * @tags security
 *       external/cwe/cwe-079
 *       external/owasp/a07
 *       external/owasp/a03
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class EventSource extends DataFlow::Node {
  EventSource() {
    exists(Parameter p | 
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class HtmlResponseSink extends DataFlow::Node {
  HtmlResponseSink() {
    exists(ReturnStmt ret | 
      ret.getValue().toString().regexpMatch("\\{\"headers\": \\{.*\"Content-Type\": \"text/html\".*\\}, \"body\": \\$.+\\}") and
      this.asExpr() = ret.getValue()
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TaintedHtmlResponseConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlResponseSink
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, 
  "Potential XSS vulnerability: User input flows into HTML response. $@ highlights the source of user input.",
  source.getNode(), "User input from here"
