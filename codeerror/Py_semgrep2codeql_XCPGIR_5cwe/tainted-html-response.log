Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id python/aws-lambda/tainted-html-response
 * @tags security
 *       external/cwe/cwe-079
 *       external/owasp/a07
 *       external/owasp/a03
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class EventSource extends TaintTracking::TaintSource {
  EventSource() {
    exists(Parameter p | 
      p.getName() = "event" and
      this = DataFlow::parameterNode(p)
    )
  }
  
  override predicate isSourceOf(DataFlow::Node node) { this = node }
  
  override predicate hasLocationInfo() { any() }
}

class HtmlResponseSink extends TaintTracking::TaintSink {
  HtmlResponseSink() {
    exists(Return r |
      r.getValueExpr().toString().regexpMatch("\\{\"headers\": \\{.*\"Content-Type\": \"text/html\".*\\}, \"body\": \\$.+\\}") and
      this = DataFlow::exprNode(r.getValueExpr())
    )
  }
  
  override predicate isSinkOf(DataFlow::Node node) { this = node }
  
  override predicate hasLocationInfo() { any() }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TaintedHtmlResponseConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof EventSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof HtmlResponseSink
  }
}

from Config cfg, DataFlow::Node source, DataFlow::Node sink, DataFlow::PathNode sourcePath, DataFlow::PathNode sinkPath
where
  cfg.hasFlowPath(sourcePath, sinkPath) and
  sourcePath.node() = source and
  sinkPath.node() = sink
select sink, source, sinkPath,
  "Potential XSS vulnerability: User input flows into HTML response. $@ highlights the source of user input.",
  sourcePath.node(), "User input from here"
