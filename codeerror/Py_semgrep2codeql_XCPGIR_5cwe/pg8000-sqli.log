import python
import semmle.python.dataflow.FlowSources
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class Pg8000SqlExec extends TaintSink {
  Pg8000SqlExec() {
    exists(MethodCall mc |
      mc.getMethod().getName().matches("run|execute|executemany|prepare") and
      mc.getQualifier().getType().getName() = "pg8000" and
      this.asExpr() = mc.getArgument(0)
    )
  }
}

class Pg8000TaintConfig extends TaintTracking::Configuration {
  Pg8000TaintConfig() { this = "pg8000-sqli" }

  override predicate isSource(DataFlow::Node source) {
