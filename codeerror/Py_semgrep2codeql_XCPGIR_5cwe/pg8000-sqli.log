Rule Content:
/**
 * @name pg8000-sqli
 * @kind path-problem
 * @problem.severity warning
 * @description Detected string concatenation with a non-literal variable in a pg8000
 *              Python SQL statement. This could lead to SQL injection if the variable is user-controlled
 *              and not properly sanitized.
 * @id python/pg8000-sqli
 */

import python
import semmle.python.security.dataflow.Paths
import semmle.python.ApiGraphs
import semmle.python.Concepts

class PG8000Connection extends API::ExternalCallable {
  PG8000Connection() {
    this.getQualifiedName().matches("pg8000.native.Connection.run") or
    this.getQualifiedName().matches("pg8000.native.Connection.execute") or
    this.getQualifiedName().matches("pg8000.native.Connection.executemany") or
    this.getQualifiedName().matches("pg8000.native.Connection.prepare")
  }
}

class UserInputSource extends DataFlow::SourceNode {
  UserInputSource() {
    exists(DataFlow::Literal literal | literal = this.asDefiningNode()) or
    exists(DataFlow::CallNode call | call = this.asDefiningNode())
  }
}

class ConcatTaintStep extends TaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::BinOp op_getitem |
      op_getitem.getOperator() = "+" and
      (pred = op_getitem.getLeftOperand().asDefiningNode() or pred = op_getitem.getRightOperand().asDefiningNode()) and
      succ = op_getitem.asDefiningNode()
    )
  }
}

class TaintConfig extends DataFlow::Configuration {
  TaintConfig() { this = "pg8000-sqli" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall mc |
      sink.asExpr() = mc and
      mc.getMethod() instanceof PG8000Connection and
      sink = mc.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    none()  // No sanitizers defined
  }

  override predicate isBarrier(DataFlow::Node node) {
    none()  // No barriers defined
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where any(TaintConfig t).hasFlow(source, sink)
select sink, "User input reaches SQL execution via string concatenation", source,
  "User input from $@ flows to SQL query", source, "here"
