    exists(MethodCall mc |
      mc.getMethod().getName() = "format" and
      mc.getQualifier() instanceof StringLiteral and
      node.asExpr() = mc
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(BinaryOperation binop |
      (binop.getOperator() = "+" or binop.getOperator() = "+=") and
      (binop.getLeftOperand() = node1.asExpr() and node2.asExpr() = binop or
       binop.getRightOperand() = node1.asExpr() and node2.asExpr() = binop)
    )
    or
    exists(MethodCall mc |
      (mc.getMethod().getName() = "format" or mc.getMethod().getName() = "__mod__") and
      mc.getAnArgument() = node1.asExpr() and
      node2.asExpr() = mc
    )
    or
    exists(FormattedValue fv |
      fv.getValue() = node1.asExpr() and
      node2.asExpr().getParent*() = fv
