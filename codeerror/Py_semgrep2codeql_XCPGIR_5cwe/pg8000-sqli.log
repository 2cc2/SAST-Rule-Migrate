xcpgir_version: "1.0"
rule:
  id: pg8000-sqli
  kind: taint
  severity: WARNING
  message: "Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement. This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
scope:
  languages: [python]
  frameworks: [pg8000]

sources:
  - id: USER_INPUT
    match:
      node: LITERAL | IDENTIFIER
      where:
        - op: neq
          left: isLiteral
          right: true

sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: { type: pg8000, method: "run|execute|executemany|prepare" }
      arg_index: 0

sanitizers:
  - id: SAFE_FORMAT
    match:
      node: CALL
      where:
        - op: eq
          left: methodFullName
          right: "str.format"
        - op: eq
          left: receiver.value
          right: "'...'"
    effect: neutralize

propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint
    where:
      - op: in
        left: operation
        right: ["+", "+=", "format", "%", "f-string"]

flows:
  - source: USER_INPUT
    sink: SQL_EXEC
    through: [STRING_CONCAT*]
    constraints:
      path:
        must_not:
          - pattern: "CALL(str.format)"
          - pattern: "LITERAL('...')"

report:
  message: "User input reaches SQL execution without sanitization"
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "conn.run('SELECT ' + user_input + ' FROM table')"
    - "conn.execute(f'SELECT {user_input} FROM table')"
  negative:
    - "conn.run('SELECT value FROM table', value=myvalue)"
    - "conn.prepare('SELECT (:v) FROM table')"
