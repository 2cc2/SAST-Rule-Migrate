  positive:
    - "conn.run('SELECT ' + user_input + ' FROM table')"
    - "conn.execute(f'SELECT {user_input} FROM table')"
  negative:
    - "conn.run('SELECT value FROM table', value=myvalue)"
    - "conn.prepare('SELECT (:v) FROM table')"
