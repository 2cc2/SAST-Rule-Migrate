Rule Content:
/**
 * @name pg8000-sqli
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pg8000-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class Pg8000SqlExec extends TaintTracking::FunctionModel {
  Pg8000SqlExec() {
    exists(MethodCall mc |
      mc.getMethod().getName().regexpMatches("run|execute|executemany|prepare") and
      mc.getQualifier().getType().toString() = "pg8000" and
      this.flowsToArgument(mc, 0)
    )
  }
}

class UnsafeStringOperation extends TaintTracking::Configuration {
  UnsafeStringOperation() {
    this.hasFlowPath(Source::userInput(), Sink::fromPg8000SqlExec())
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Expr expr |
      expr = source.asExpr() and
      not expr.isConstant() and
      not expr instanceof StringLiteral
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof Pg8000SqlExec
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodCall mc |
      mc.getMethod().getName() = "format" and
      mc.getQualifier() instanceof StringLiteral and
      node.asExpr() = mc
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node src, DataFlow::Node sink) {
    exists(BinaryOperation binop |
      (binop.getOperator() = "+" or binop.getOperator() = "+=") and
      (
        binop.getLeftOperand() = src.asExpr() and
        sink.asExpr() = binop
        or
        binop.getRightOperand() = src.asExpr() and
        sink.asExpr() = binop
      )
    )
    or
    exists(MethodCall mc |
      (mc.getMethod().getName() = "format" or mc.getMethod().getName() = "__mod__") and
      mc.getAnArgument() = src.asExpr() and
      sink.asExpr() = mc
    )
    or
    exists(FormattedValue fv |
      fv.getValue() = src.asExpr() and
      sink.asExpr().getParent*() = fv
    )
  }
}

from UnsafeStringOperation config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(), sink.getNode(),
  "User input reaches SQL execution without sanitization in pg8000 statement"
