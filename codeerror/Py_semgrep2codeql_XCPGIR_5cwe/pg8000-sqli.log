Rule Content:
/**
 * @name pg8000-sqli
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement
 * @kind path-problem
 * @problem.severity warning
 * @id python/pg8000-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class UserInputSource extends TaintTracking::TaintSource {
  override predicate source(DataFlow::Node source) {
    exists(Expr e |
      source.asExpr() = e and
      not e.isConstant() and
      not e instanceof StringLiteral
    )
  }
}

class Pg8000SqlSink extends TaintTracking::TaintSink {
  override predicate sinks(TaintKind kind) {
    exists(MethodCall mc |
      mc.getMethod().getName().matches("run|execute|executemany|prepare") and
      mc.getQualifier().getType().getName() = "pg8000" and
      this.asSourceLocation() = mc.getArgument(0).getSourceLocation()
    )
  }
}

class SafeFormatSanitizer extends TaintTracking::Sanitizer {
  override predicate sanitizer(DataFlow::Node node) {
    exists(MethodCall mc |
      mc.getMethod().getName() = "format" and
      mc.getQualifier() instanceof StringLiteral and
      node.asExpr() = mc
    )
  }
}

class Pg8000TaintConfig extends TaintTracking::Configuration {
  Pg8000TaintConfig() { this = "pg8000-sqli" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }
  override predicate isSink(DataFlow::Node sink) { sink instanceof Pg8000SqlSink }
  override predicate isSanitizer(DataFlow::Node node) { node instanceof SafeFormatSanitizer }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(BinaryOperation binop |
      (binop.getOperator() = "+" or binop.getOperator() = "+=") and
      (binop.getLeftOperand() = node1.asExpr() and node2.asExpr() = binop or
       binop.getRightOperand() = node1.asExpr() and node2.asExpr() = binop)
    )
    or
    exists(MethodCall mc |
      (mc.getMethod().getName() = "format" or mc.getMethod().getName() = "__mod__") and
      mc.getAnArgument() = node1.asExpr() and
      node2.asExpr() = mc
    )
    or
    exists(FormattedValue fv |
      fv.getValue() = node1.asExpr() and
      node2.asExpr().getParent*() = fv
    )
  }
}

from Pg8000TaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "User input reaches pg8000 SQL execution without sanitization. $@ flows to $@",
  source.getNode(), "User input", sink.getNode(), "SQL execution"
