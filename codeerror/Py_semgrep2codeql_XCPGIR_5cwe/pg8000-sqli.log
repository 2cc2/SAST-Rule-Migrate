Rule Content:
/**
 * @name pg8000-sqli
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pg8000-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs

class Pg8000SqlExec extends TaintTracking::SinkModel {
  override predicate isSink(DataFlow::Node sink) {
    exists(Method mc, Call call |
      mc = call.getMethod() and
      (mc.getName() = "run" or mc.getName() = "execute" or 
       mc.getName() = "executemany" or mc.getName() = "prepare") and
      call.getQualifier().getType().getName() = "pg8000" and
      sink.asExpr() = call.getArgument(0)
    )
  }
}

class Pg8000TaintConfig extends TaintTracking::Configuration {
  Pg8000TaintConfig() { this = "pg8000-sqli" }

  override predicate isSource(DataFlow::Node source) {
    exists(Expr e |
      source.asExpr() = e and
      not e.isConstant() and
      not e instanceof StringLiteral
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof Pg8000SqlExec
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodCall mc |
      mc.getMethod().getName() = "format" and
      mc.getQualifier() instanceof StringLiteral and
      node.asExpr() = mc
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(BinaryExpr binop |
      (binop.getOperator() = "+" or binop.getOperator() = "+=") and
      (binop.getLeftOperand() = node1.asExpr() and node2.asExpr() = binop or
       binop.getRightOperand() = node1.asExpr() and node2.asExpr() = binop)
    )
    or
    exists(MethodCall mc |
      (mc.getMethod().getName() = "format" or mc.getMethod().getName() = "__mod__") and
      mc.getAnArgument() = node1.asExpr() and
      node2.asExpr() = mc
    )
    or
    exists(FormattedValue fv |
      fv.getValue() = node1.asExpr() and
      node2.asExpr().getParent*() = fv
    )
  }
}

from Pg8000TaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "User input reaches pg8000 SQL execution without sanitization. $@ flows to $@",
  source.getNode(), "source", sink.getNode(), "sink"
