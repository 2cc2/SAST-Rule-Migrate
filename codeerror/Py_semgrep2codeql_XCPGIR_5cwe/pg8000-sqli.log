  id: pg8000-sqli
  kind: taint
  severity: WARNING
  message: >-
    Detected string concatenation with a non-literal variable in a pg8000
    Python SQL statement. This could lead to SQL injection if the variable is user-controlled
    and not properly sanitized. In order to prevent SQL injection,
    use parameterized queries or prepared statements instead.
scope:
  languages: [python]
  frameworks: [pg8000]
sources:
  - id: USER_INPUT
    match:
      node: LITERAL | CALL
      where:
        - op: regex
          left: value
          right: ".+"
sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: { type: pg8000.native.Connection, method: run | execute | executemany | prepare }
      arg_index: 0
sanitizers: []
barriers: []
propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint
flows:
  - source: USER_INPUT
    sink: SQL_EXEC
    through: [STRING_CONCAT*]
    constraints:
      path:
        must_not:
          - pattern: "LITERAL('...')"
          - pattern: "'...'.format()"
          - pattern: "'...' % ()"
report:
  message: "User input reaches SQL execution via string concatenation"
  locations: ["sink"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "conn.run(\"SELECT \" + user_input + \" FROM table\")"
  negative:
    - "conn.run(\"SELECT :value FROM table\", value=myvalue)"
```
