Rule Content:
/**
 * @name Exec Injection Vulnerability
 * @description Detects user data flowing into exec calls
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id py/exec-injection
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-094
 */

import python
import semmle.python.dataflow.DataFlow
import python.security.dataflow.RemoteFlowSource
import python.regexp.Regexp
import python.web.flask.Request

// Source definitions
predicate isRouteVarSource(DataFlow::Node source) {
  exists(string name |
    source.asParameter().getName() = name and
    Regexp::matches("ROUTEVAR|W", name)
  )
}

predicate isFlaskSource(DataFlow::Node source) {
  exists(Request::getParameter(_, _) param |
    source.asParameter() = param
  )
}

// Sink definition
predicate isExecSink(DataFlow::Node sink) {
  exists(Function builtin, Call call |
    call = sink.asExpr() and
    builtin = call.getFunc() and
    builtin.getName() = "exec" and
    builtin.isBuiltin()
  )
}

class ExecInjectionConfig extends DataFlow::TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    isRouteVarSource(source) or
    isFlaskSource(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    isExecSink(sink)
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    DataFlow::argumentToParameter(node1, node2) or
    DataFlow::fieldReadStep(node1, node2)
  }
}

from ExecInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(),
  "User input reaches exec() call without sanitization. This is dangerous and allows code injection.",
  source.getNode(), sink.getNode(),
  "User input from $@ flows to exec() call here",
  source.getNode(), "user input"
