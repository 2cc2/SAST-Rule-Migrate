Rule Content:
/**
 * @name Exec Injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind taint-problem
 * @problem.severity error
 * @id python/exec-injection
 */

import python
import python.web.flask.Flask
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class FlaskSource extends TaintTracking::TaintSource {
  FlaskSource() {
    exists(RequestParameterAccess rpa |
      this.asExpr() = rpa.getAnAccess() and
      rpa.isUserControlled()
    )
    or
    exists(Expr e | 
      (e instanceof GetAttribute or
       e instanceof DictionaryLookup or
       e instanceof Call) and
      e = this.asExpr() and
      isFlaskRequestSource(e)
    )
  }
}

private predicate isFlaskRequestSource(Expr e) {
  exists(Call call |
    call.getFunc().getName() = "request" and
    call.getFunc().getQualifier().toString() = "flask" and
    (
      (call.getMethodName() = "get" and e = call.getArg(0))
      or
      (call.getMethodName() = "__getitem__" and e = call.getArg(0))
      or
      (call.getMethodName() = "__call__" and e = call)
    )
  )
}

class ExecSink extends TaintTracking::TaintSink {
  ExecSink() {
    exists(Call call |
      call.getFunc().(Name).getId() = "exec" and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(TaintTracking::TaintSource source) { source instanceof FlaskSource }

  override predicate isSink(TaintTracking::TaintSink sink) { sink instanceof ExecSink }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) { none() }
}

from ExecInjectionConfig config, TaintTracking::PathNode source, TaintTracking::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches exec() call without sanitization. $@ flows from $@.",
  source.getNode(),
  "source",
  sink.getNode(),
  "sink"
