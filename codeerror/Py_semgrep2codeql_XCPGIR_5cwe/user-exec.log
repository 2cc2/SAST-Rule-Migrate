/**
 * @name Exec Injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/exec-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow
import semmle.python.Concepts
import semmle.python.WebFramework

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f |
      f.getADecorator().toString() = "route" and
      exists(Parameter p |
        this.asParameter() = p and
        p.getFunction() = f
      )
    )
  }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(CallNode cn |
      cn.getTarget().toString() = "flask.request" and
      (
        cn.getMethodName() = "get" or
        cn.getMethodName() = "__getitem__" or
        cn.getMethodName() = "__call__"
      ) and
      this.asExpr() = cn.getArgument(0)
    )
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(CallNode cn |
      cn.getTarget().toString() = "exec" and
      this.asExpr() = cn.getArgument(0)
    )
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteParamSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecSink
  }
}

from ExecInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches exec() call without sanitization. $@ flows from $@.",
  source.getNode(),
  "source",
  sink.getNode(),
  "sink"
