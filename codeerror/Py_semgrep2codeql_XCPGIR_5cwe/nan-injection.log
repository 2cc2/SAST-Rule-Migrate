Rule Content:
/**
 * @name NaN Injection in Type Casting
 * @description Detects user input flowing directly into bool(), float(), or complex() typecast,
 *              which could allow injecting NaN values.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/nan-injection
 * @tags security
 *       external/cwe/cwe-20
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.frameworks.flask.Request

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(RequestCall call |
      call.getMethod().hasName("get") and
      call.getMethod().getDeclaringType().hasName("request") and
      this.asExpr() = call
    )
  }
}

class UnsafeCastSink extends DataFlow::Node {
  UnsafeCastSink() {
    exists(MethodCall call |
      call.getMethodName() in ["bool", "float", "complex"] and
      call.getDeclaringType().hasName("builtins") and
      this.asExpr() = call
    )
  }
}

