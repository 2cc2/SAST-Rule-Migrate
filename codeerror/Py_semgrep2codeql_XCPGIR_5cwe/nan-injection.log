/**
 * @name NaN Injection Vulnerability
 * @description Detects user input going directly into typecast for bool(), float(), or complex()
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 * @tags security
 *       external/cwe/cwe-20
 */

import python
import semmle.python.web.flask.Requests
import semmle.python.web.flask.Routes
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Builtins
import semmle.python.dataflow.new.PathGraph

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    // Flask request get() method
    exists(DataFlow::MethodCallNode mc |
      mc.getMethod().getName() = "get" and
      exists(mc.getReceiver().getType() as receiverType |
        receiverType.hasQualifiedName("flask", "Request")
      ) and
      this.asExpr() = mc
    )
    or
    // Flask request __getitem__ method
    exists(DataFlow::MethodCallNode mc |
      mc.getMethod().getName() = "__getitem__" and
      exists(mc.getReceiver().getType() as receiverType |
        receiverType.hasQualifiedName("flask", "Request")
      ) and
      this.asExpr() = mc
    )
    or
    // Flask route parameter
    exists(Function f, Parameter p |
      exists(DecoratorExpr decorator |
        decorator.getFunction() = f and
        exists(CallExpr call |
          call = decorator.getExpr() and
          call.getCallee().(Name).getId() = "route"
        )
      ) and
      this.asExpr() = p
    )
  }
}

class UnsafeTypecastSink extends DataFlow::Node {
  UnsafeTypecastSink() {
    exists(CallExpr call |
      (
        call.getCallee().(Name).getId() = "float" or
        call.getCallee().(Name).getId() = "bool" or
        call.getCallee().(Name).getId() = "complex"
      ) and
      this.asExpr() = call.getArg(0)
    )
  }
}

class NumericCheckSanitizer extends DataFlow::Node {
  NumericCheckSanitizer() {
    exists(MethodCallNode mc |
      mc.getMethod().getName() = "isnumeric" and
      exists(mc.getReceiver().getType() as receiverType |
        receiverType.hasQualifiedName("builtins", "str")
      ) and
      this.asExpr() = mc.getParent()*
    )
  }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { 
    this = "NanInjection" 
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeTypecastSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof NumericCheckSanitizer
  }
}

from NanInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "Potential NaN injection from user input to unsafe type cast", source, sink,
  "User input $" + source.toString() + "$ flows to potentially unsafe type cast here"
