xcpgir_version: "1.0"
rule:
  id: "nan-injection"
  kind: taint
  severity: ERROR
  message: "Found user input going directly into typecast for bool(), float(), or complex(). This allows an attacker to inject Python's not-a-number (NaN) into the typecast resulting in undefined behavior."
scope:
  languages: [python]
  frameworks: ["flask"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources:
  - id: USER_INPUT
    match:
      node: CALL
      api: { type: flask.request, method: get }
    match:
      node: CALL
      api: { type: flask.request, method: __getitem__ }
    match:
      node: PARAM
      where:
        - op: inside
          left: AST
          right: |
            @$APP.route(...)
            def $FUNC(..., $ROUTEVAR, ...):
              ...
sinks:
  - id: TYPECAST
    match:
      node: CALL
      api: { type: builtins, method: float }
    match:
      node: CALL
      api: { type: builtins, method: bool }
    match:
      node: CALL
      api: { type: builtins, method: complex }
propagations:
  - id: ARG_PARAM
    edge: arg->param
    kind: taint
sanitizers:
  - id: ANY_CALL
    match: { node: CALL }
    effect: neutralize
flows:
  - source: USER_INPUT
    sink: TYPECAST
    through: [ARG_PARAM*]
    constraints:
      path:
        must_not: [{ pattern: "CALL(builtins.str.isnumeric)" }]
report:
  message: "User input reaches unsafe typecast allowing NaN injection"
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "float(request.args.get('value'))"
  negative:
    - "float(request.args.get('value') if not value.lower() == 'nan' else 0)"
