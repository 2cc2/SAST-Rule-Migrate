import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs

class FlaskRequestSource extends DataFlow::SourceNode {
  FlaskRequestSource() {
    exists(Callable m, DataFlow::CallNode call |
      m.hasName("get") and
