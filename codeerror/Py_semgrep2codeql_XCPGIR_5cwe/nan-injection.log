/**
 * @name NaN Injection Vulnerability
 * @description Detects user input going directly into typecast for bool(), float(), or complex()
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 * @tags security
 *       external/cwe/cwe-20
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.Builtins
import semmle.python.flask.FlaskRoutes
import DataFlow::PathGraph

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    // Flask request get() method
    exists(MethodCallNode mc |
      mc.getMethodName() = "get" and
      mc.getReceiver().getType().hasQualifiedName("flask", "Request") and
      this.asExpr() = mc
    )
    or
    // Flask request __getitem__ method
    exists(MethodCallNode mc |
      mc.getMethodName() = "__getitem__" and
      mc.getReceiver().getType().hasQualifiedName("flask", "Request") and
      this.asExpr() = mc
