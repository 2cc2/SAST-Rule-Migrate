/**
 * @name NaN Injection in Type Casting
 * @description Detects user input flowing directly into bool(), float(), or complex() typecast,
 *              which could allow injecting NaN values.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/nan-injection
 * @tags security
 *       external/cwe/cwe-20
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Callable c |
      c.hasName("get") and
      c.getDeclaringType().hasName("request") and
      this.asParameter() = c.getACall()
    )
  }

  override DataFlow::Node asCfgNode() { this }
  override Location getLocation() { this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { none() }
  override string toString() { "Flask request.get() source" }
  override DataFlow::Scope getScope() { moduleScope() }
  override DataFlow::Variable asVariable() { none() }
}

class UnsafeCastSink extends DataFlow::Node {
  UnsafeCastSink() {
    exists(Callable c |
      c.getName() in ["bool", "float", "complex"] and
      c.getDeclaringType().hasName("builtins") and
      this.asParameter() = c.getACall()
    )
  }

  override DataFlow::Node asCfgNode() { this }
  override Location getLocation() { this.getLocation() }
  override DataFlow::BasicBlock getBasicBlock() { none() }
  override string toString() { "Unsafe type cast sink" }
  override DataFlow::Scope getScope() { moduleScope() }
  override DataFlow::Variable asVariable() { none() }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeCastSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Call c | node.asParameter() = c)
  }
}

from NanInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input reaches unsafe type casting without NaN validation"
