}

class UnsafeCastSink extends DataFlow::Node {
  UnsafeCastSink() {
    exists(DataFlow::CallNode call |
      call.getCallee().getName() in ["bool", "float", "complex"] and
      call.getCallee().getDeclaringType().hasName("builtins") and
      this.asExpr() = call
    )
  }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeCastSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(DataFlow::CallNode call | node.asExpr() = call)
  }
}

