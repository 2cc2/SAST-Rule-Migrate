Rule Content:
/** 
 * @name NaN Injection in Type Casting
 * @description Detects user input flowing directly into bool(), float(), or complex() typecast,
 *              which could allow injecting NaN values.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id python/nan-injection
 * @tags security
 *       external/cwe/cwe-20
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs

class FlaskRequestSource extends RemoteFlowSource::Range {
  FlaskRequestSource() {
    exists(Method m, MethodCall call |
      m.hasName("get") and
      m.getDeclaringType().hasName("request") and
      call.getMethod() = m and
      call = this.asExpr()
    )
  }

  override string getSourceType() { result = "User input from Flask request" }
}

class UnsafeCastSink extends DataFlow::Node {
  UnsafeCastSink() {
    exists(MethodCall call |
      call.getMethod().getName() in ["bool", "float", "complex"] and
      call.getMethod().getDeclaringType().hasName("builtins") and
      this.asExpr() = call
    )
  }
}

predicate isSanitizer(DataFlow::Node node) {
  exists(MethodCall call | node.asExpr() = call)
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeCastSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    isSanitizer(node)
  }
}

from NanInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input reaches unsafe type casting without NaN validation"
