Rule Content:
/**
 * @name NaN Injection Vulnerability
 * @description Detects user input going directly into typecast for bool(), float(), or complex()
 * @kind taint
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.security.TaintTracking
import Python::Builtins
import Python::API::Flask
import DataFlow

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    // Flask request get() method
    exists(Call call |
      call.getFunc().(FunctionValue).getDecl().hasGlobalName("request") and
      call.getFunc().(FunctionValue).getDecl().getType().hasQualifiedName("flask", "request") and
      call.getFunc().(FunctionValue).getDecl().getName() = "get" and
      this.asExpr() = call     
    )
    or
    // Flask request __getitem__ method
    exists(Call call |
      call.getFunc().(FunctionValue).getDecl().hasGlobalName("request") and
      call.getFunc().(FunctionValue).getDecl().getType().hasQualifiedName("flask", "request") and
      call.getFunc().(FunctionValue).getDecl().getName() = "__getitem__" and
      this.asExpr() = call
    )
    or
    // Flask route parameter
    exists(Function f, Parameter p |
      exists(RouteAnnotation r | r = f.getDecorator("route")) and
      p = f.getAParameter() and
      this.asExpr() = p
    )
  }
}

class UnsafeTypecastSink extends DataFlow::Node {
  UnsafeTypecastSink() {
    exists(Call c |
      (c.getFunc().(Builtins::float) or 
       c.getFunc().(Builtins::bool) or 
       c.getFunc().(Builtins::complex)) and
      this.asExpr() = c.getArg(0)
    )
  }
}

class SafeTypecastSanitizer extends DataFlow::Node {
  SafeTypecastSanitizer() {
    exists(MethodCall mc |
      mc.getFunc().(Builtins::str__isnumeric) and
      this.asExpr() = mc.getParent()+
    )
  }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjection" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof UnsafeTypecastSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeTypecastSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagate taint through argument to parameter
    exists(Parameter p, DataFlow::ArgumentToParameter ap |
      ap.convertsArgumentToParameter(node1.asExpr(), p) and
      node2.asExpr() = p
    )
  }
}

from NanInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input reaches unsafe typecast allowing NaN injection", source.getNode(),
  "user input flows here"
