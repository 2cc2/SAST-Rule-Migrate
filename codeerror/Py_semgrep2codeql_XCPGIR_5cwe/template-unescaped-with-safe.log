/**
 * @name TemplateUnescapedWithSafe
 * @description Detects Flask template segments where autoescaping is disabled with '|safe' filter
 * @id template-unescaped-with-safe
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import python.frameworks.flask
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.TaintTracking

class TemplateSafeFilter extends Expr {
  TemplateSafeFilter() {
    this.toString().regexpMatches("\\{\\{.*?\\|\\s*safe(\\s*}})?")
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TemplateUnescapedWithSafeConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(TemplateSafeFilter tf | source.asExpr() = tf)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getTarget().getName() = "render_template" and
      exists(ImportOrFromModule f |
        f.getSource().getName() = "flask" and
        call.getTarget().getQualifiedName() = "flask.render_template"
      ) and
      sink.asExpr() = call.getArg(0)
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected a segment of a Flask template where autoescaping is explicitly disabled with '| safe' filter. This allows rendering of raw HTML in this segment. Ensure no user data is rendered here, otherwise this is a cross-site scripting (XSS) vulnerability. $@",
  source, source.getNode(),
  "User-provided data flows through this sensitive location"
