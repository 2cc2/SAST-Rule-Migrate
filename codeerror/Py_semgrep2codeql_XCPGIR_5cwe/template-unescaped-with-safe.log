Rule Content:
/**
 * @name Template unescaped with safe filter
 * @description Detects Flask templates where autoescaping is explicitly disabled with '|safe' filter,
 *              which could lead to Cross-Site Scripting (XSS) vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id py/flask/unsafe-template-filter
 * @tags security
 *       external/cwe/cwe-79
 *       external/owasp/a07
 *       external/owasp/a03
 */
import python
import semmle.python.frameworks.flask.FlaskTemplates

predicate isUnsafeTemplateFilter(string templateContent) {
  regexMatches("\\{\\{.*?\\|\\s*safe(\\s*}})?", templateContent)
}

from FlaskTemplateString template, string filterUsage
where
  isUnsafeTemplateFilter(template.getText()) and
  filterUsage = template.getText()
select filterUsage,
  "Unsafe template filter '|safe' detected in Flask template. This disables autoescaping and could lead to XSS " +
  "if user-controlled data is rendered. See: " +
  "https://flask.palletsprojects.com/en/1.1.x/security/#cross-site-scripting-xss"
