/**
 * @name TemplateUnescapedWithSafe
 * @description Detects Flask template segments where autoescaping is disabled with '|safe' filter.
 * @id template-unescaped-with-safe
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.frameworks.flask.Flask
import semmle.python.web.Templating
import DataFlow::PathGraph

class TemplateSafeFilter extends Expr {
  TemplateSafeFilter() {
    this.regexpMatches("\\{\\{.*?\\|\\s*safe(\\s*}})?")
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TemplateUnescapedWithSafeConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(TemplateSafeFilter tf | source.asExpr() = tf)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall mc |
      mc.getMethod().hasName("render_template") and
      mc.getMethod().getDeclaringType().hasQualifiedName("flask", "Flask") and
      sink.asExpr() = mc.getAnArgument()
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected a segment of a Flask template where autoescaping is explicitly disabled with '| safe' filter. $@",
  source, source.getNode(),
  "User-provided data flows through this sensitive location"
