import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import DataFlow::PathGraph

class Jinja2EnvironmentCreation extends API::CallNode {
  Jinja2EnvironmentCreation() {
    exists(API::Node::module jinja2 |
      this.getReceiver() = jinja2.getMember("Environment").getACall() and
      jinja2.getName() = "jinja2"
    )
  }
}

class Jinja2TemplateRender extends API::CallNode {
  Jinja2TemplateRender() {
    exists(API::Node::module jinja2 |
      this.getReceiver() = jinja2.getMember("render").getACall() and
      exists(API::Node::class template | template.getName() = "Template" |
        this.getReceiver().getName() = template.getName()
      ) and
      jinja2.getName() = "jinja2"
