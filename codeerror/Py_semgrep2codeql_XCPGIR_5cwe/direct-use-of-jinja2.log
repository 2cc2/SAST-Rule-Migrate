Rule Content:
/**
 * @name Direct use of jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping
 *              which opens up the application to cross-site scripting (XSS) vulnerabilities.
 *              Prefer using the Flask method 'render_template()' and templates with a '.html'
 *              extension in order to prevent XSS.
 * @kind path-problem
 * @problem.severity warning
 * @id python/direct-use-of-jinja2
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class Jinja2Environment extends TaintTracking::DataFlow::Node {
  Jinja2Environment() {
    exists(DataFlow::CallNode call |
      call.getTarget().hasQualifiedName("jinja2", "Environment") and
      this = call
    )
  }

  override predicate asCfgNode() { this = result }
  override DataFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override Function getScope() { result = this.asExpr().getScope() }
}

class Jinja2TemplateRender extends TaintTracking::DataFlow::Node {
  Jinja2TemplateRender() {
    exists(DataFlow::CallNode call |
      call.getTarget().hasQualifiedName("jinja2", "Template.render") and
      this = call
    )
  }

  override predicate asCfgNode() { this = result }
  override DataFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override Function getScope() { result = this.asExpr().getScope() }
}

class TemplateRender extends TaintTracking::DataFlow::Node {
  TemplateRender() {
    exists(MethodCall mc |
      mc.getCallee().toString().matches("%Template.render") and
      this = mc
    )
  }

  override predicate asCfgNode() { this = result }
  override DataFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override Function getScope() { result = this.asExpr().getScope() }
}

class XSSSink extends TaintTracking::DataFlow::Node {
  XSSSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().hasQualifiedName("jinja2", "Template.render") and
      this = call
    )
  }

  override predicate asCfgNode() { this = result }
  override DataFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override Function getScope() { result = this.asExpr().getScope() }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "DirectUseOfJinja2" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof Jinja2Environment or
    source instanceof Jinja2TemplateRender or
    source instanceof TemplateRender
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof XSSSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodCall ma |
      ma.getCallee().hasName("render") and
      pred = ma.getAnArgument() and
      succ = ma
    )
  }
}

