 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import DataFlow::PathGraph

class Jinja2EnvironmentCreation extends API::CallNode {
  Jinja2EnvironmentCreation() {
    exists(API::Node::module jinja2 |
      getReceiver() = jinja2.getMember("Environment").getACall() and
      jinja2.getName() = "jinja2"
    )
  }
}

class Jinja2TemplateRender extends API::CallNode {
  Jinja2TemplateRender() {
    exists(API::Node::module jinja2 |
      getReceiver() = jinja2.getMember("render").getACall() and
      exists(API::Node::class template | template.getName() = "Template" |
        getReceiver().getName() = template.getName()
      ) and
      jinja2.getName() = "jinja2"
    )
  }
}

class Jinja2EnvGetTemplate extends API::CallNode {
  Jinja2EnvGetTemplate() {
    exists(API::Node::module jinja2 |
      getReceiver() = jinja2.getMember("get_template").getACall() and
      exists(API::Node::class env | env.getName() = "Environment" |
        getReceiver().getName() = env.getName()
      ) and
      jinja2.getName() = "jinja2"
    )
  }
}

class XssSink extends API::CallNode {
  XssSink() { this instanceof Jinja2TemplateRender }
}

module PotentialXssFlows implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    exists(Jinja2EnvironmentCreation j | source.asExpr() = j.getACall())
    or
    exists(Jinja2TemplateRender j | source.asExpr() = j.getACall())
    or
    exists(Jinja2EnvGetTemplate j | source.asExpr() = j.getACall())
  }

  predicate isSink(DataFlow::Node sink) {
    exists(XssSink x | sink.asExpr() = x.getACall())
  }

  predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    none()
  }
}

