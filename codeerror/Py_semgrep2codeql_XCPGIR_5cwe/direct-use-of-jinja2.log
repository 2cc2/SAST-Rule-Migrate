Rule Content:
/**
 * @name Direct use of jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping
 *              which opens up the application to cross-site scripting (XSS) vulnerabilities.
 *              Prefer using the Flask method 'render_template()' and templates with a '.html'
 *              extension in order to prevent XSS.
 * @kind path-problem
 * @problem.severity warning
 * @id python/direct-use-of-jinja2
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class Jinja2Environment extends DataFlow::Node {
  Jinja2Environment() {
    exists(API::Call call |
      call.getTarget().(API::Node).getAPIName() = "Environment" and
      call.getTarget().(API::Node).getPackageName() = "jinja2" and
      this.asExpr() = call
    )
  }
}

class Jinja2TemplateRender extends DataFlow::Node {
  Jinja2TemplateRender() {
    exists(API::Call call |
      call.getTarget().(API::Node).getAPIName() = "render" and
      call.getTarget().(API::Node).getPackageName() = "jinja2" and
      call.getTarget().(API::Node).getTypeName() = "Template" and
      this.asExpr() = call
    )
  }
}

class TemplateRender extends DataFlow::Node {
  TemplateRender() {
    exists(Method m, Call call |
      call.getCallee() = m and
      m.getQualifiedName().matches("%Template.render") and
      this.asExpr() = call
    )
  }
}

class XSSSink extends DataFlow::Node {
  XSSSink() {
    exists(API::Call call |
      call.getTarget().(API::Node).getAPIName() = "render" and
      call.getTarget().(API::Node).getPackageName() = "jinja2" and
      call.getTarget().(API::Node).getTypeName() = "Template" and
      this.asExpr() = call
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "DirectUseOfJinja2" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof Jinja2Environment or
    source instanceof Jinja2TemplateRender or
    source instanceof TemplateRender
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof XSSSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("render") and
      pred.asExpr() = ma.getAnArgument() and
      succ.asExpr() = ma
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Direct use of jinja2 detected, potential XSS vulnerability"
