Rule Content:
/**
 * @name Direct use of jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping which opens up the application to cross-site scripting (XSS) vulnerabilities. Prefer using the Flask method 'render_template()' and templates with a '.html' extension in order to prevent XSS.
 * @kind path-problem
 * @problem.severity warning
 * @id py/direct-use-of-jinja2
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import DataFlow::PathGraph

class Jinja2EnvironmentCreation extends API::CallNode {
  Jinja2EnvironmentCreation() {
    exists(API::Module jinja2 |
      this.getTarget() = jinja2.getMember("Environment").getACall() and
      jinja2.getName() = "jinja2"
    )
  }
}

class Jinja2TemplateRender extends API::CallNode {
  Jinja2TemplateRender() {
    exists(API::Module jinja2 |
      this.getTarget() = jinja2.getMember("render").getACall() and
      exists(API::Class template | template.getName() = "Template" |
        this.getTarget().hasQualifiedName(template)
      ) and
      jinja2.getName() = "jinja2"
    )
  }
}

class Jinja2EnvGetTemplate extends API::CallNode {
  Jinja2EnvGetTemplate() {
    exists(API::Module jinja2 |
      this.getTarget() = jinja2.getMember("get_template").getACall() and
      exists(API::Class env | env.getName() = "Environment" |
        this.getTarget().hasQualifiedName(env)
      ) and
      jinja2.getName() = "jinja2"
    )
  }
}

class XssSink extends API::CallNode {
  XssSink() { this instanceof Jinja2TemplateRender }
}

class SafeFlaskRender extends API::CallNode {
  SafeFlaskRender() {
    this.getTarget().hasQualifiedName(API::Module::find("flask"), "render_template")
  }
}

module PotentialXssFlows implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    exists(Jinja2EnvironmentCreation j | source.asExpr() = j.getAPythonCall())
    or
    exists(Jinja2TemplateRender j | source.asExpr() = j.getAPythonCall())
    or
    exists(Jinja2EnvGetTemplate j | source.asExpr() = j.getAPythonCall())
  }

  predicate isSink(DataFlow::Node sink) {
    exists(XssSink x | sink.asExpr() = x.getAPythonCall())
  }

  predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SafeFlaskRender safe | sanitizer.asExpr() = safe.getAPythonCall())
  }

  predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Add any additional flow steps if needed
    false
  }
}

module XssFlow = DataFlow::Global<PotentialXssFlows>;

from XssFlow::PathNode source, XssFlow::PathNode sink, string description
where
  XssFlow::flowPath(source, sink)
select sink, "Direct use of jinja2 detected, potential XSS vulnerability", source,
  "Potential XSS vulnerability due to direct use of jinja2"
