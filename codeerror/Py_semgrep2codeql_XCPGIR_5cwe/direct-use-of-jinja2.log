Rule Content:
/**
 * @name Direct use of jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping
 *              which opens up the application to cross-site scripting (XSS) vulnerabilities.
 *              Prefer using the Flask method 'render_template()' and templates with a '.html'
 *              extension in order to prevent XSS.
 * @kind path-problem
 * @problem.severity warning
 * @id python/direct-use-of-jinja2
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class Jinja2Environment extends DataFlow::Node {
  Jinja2Environment() {
    exists(Call call |
      call.getTarget().hasQualifiedName("jinja2", "Environment") and
      this.asExpr() = call
    )
  }
}

class Jinja2TemplateRender extends DataFlow::Node {
  Jinja2TemplateRender() {
    exists(Call call |
      call.getTarget().hasQualifiedName("jinja2", "Template.render") and
      this.asExpr() = call
    )
  }
}

class TemplateRender extends DataFlow::Node {
  TemplateRender() {
    exists(Call call |
      call.getCallee().toString().matches("%Template.render") and
      this.asExpr() = call
    )
  }
}

class XSSSink extends DataFlow::Node {
  XSSSink() {
    exists(Call call |
      call.getTarget().hasQualifiedName("jinja2", "Template.render") and
      this.asExpr() = call
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "DirectUseOfJinja2" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof Jinja2Environment or
    source instanceof Jinja2TemplateRender or
    source instanceof TemplateRender
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof XSSSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Call ma |
      ma.getCallee().hasName("render") and
      pred.asExpr() = ma.getAnArgument() and
      succ.asExpr() = ma
    )
  }
}

