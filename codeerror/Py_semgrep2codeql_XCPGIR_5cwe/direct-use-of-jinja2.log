/**
 * @name Direct use of jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping which opens up the application to cross-site scripting (XSS) vulnerabilities. Prefer using the Flask method 'render_template()' and templates with a '.html' extension in order to prevent XSS.
 * @kind path-problem
 * @problem.severity warning
 * @id py/direct-use-of-jinja2
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking

class Jinja2EnvironmentCreation extends API::CallNode {
  Jinja2EnvironmentCreation() {
    this.getTarget().(API::Node).hasQualifiedName("jinja2", "Environment")
  }
}

class Jinja2TemplateRender extends API::CallNode {
  Jinja2TemplateRender() {
    exists(API::ImportModule jinja2 | 
      this.getTarget() = jinja2.getMember("Template").getMember("render").getACall() and
      jinja2.getName() = "jinja2"
    )
  }
}

class Jinja2EnvGetTemplate extends API::CallNode {
  Jinja2EnvGetTemplate() {
    exists(API::ImportModule jinja2 | 
      this.getTarget() = jinja2.getMember("Environment").getMember("get_template").getACall() and
      jinja2.getName() = "jinja2"
    )
  }
}

class XssSink extends API::CallNode {
  XssSink() { 
    this instanceof Jinja2TemplateRender 
  }
}

class PotentialXssFlowConfiguration extends TaintTracking::Configuration {
  PotentialXssFlowConfiguration() { this = "PotentialXssFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof Jinja2EnvironmentCreation or
    source.asExpr() instanceof Jinja2TemplateRender or
    source.asExpr() instanceof Jinja2EnvGetTemplate
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asExpr() instanceof XssSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from DataFlow::Node source, DataFlow::Node sink, PotentialXssFlowConfiguration config
where config.hasFlow(source, sink)
select sink, "Direct use of jinja2 detected, potential XSS vulnerability", source,
  "Potential XSS vulnerability due to direct use of jinja2"
