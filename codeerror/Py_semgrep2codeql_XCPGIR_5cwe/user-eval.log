/**
 * @name Eval Injection
 * @description Detects user-supplied data flowing into eval() calls
 * @id eval-injection
 * @kind path-problem
 * @problem.severity ERROR
 * @tags security
 *       external/cwe/cwe-094
 *       external/cwe/cwe-095
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Request

abstract class UserInputSource extends TaintTracking::TaintSource {
  UserInputSource() { 
    this instanceof FlaskRequestParam or 
    this instanceof RouteParam
  }
}

private class FlaskRequestParam extends TaintTracking::TaintSource {
  FlaskRequestParam() {
    exists(DataFlow::CallNode call |
      call.getCallee().getName() = "get" and
      call.getCallee().getQualifiedName() = "flask.request.get" and
      this.asExpr() = call
    )
  }
}

private class RouteParam extends TaintTracking::TaintSource {
  RouteParam() {
    exists(Function::Parameter param |
      param.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this.asExpr() = param
    )
  }
}

class EvalSink extends TaintTracking::TaintSink {
  EvalSink() {
    exists(DataFlow::CallNode call |
      call.getCallee().getName() = "eval" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(TaintTracking::TaintSource source) { 
    source instanceof UserInputSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) { 
    sink instanceof EvalSink
  }
}

