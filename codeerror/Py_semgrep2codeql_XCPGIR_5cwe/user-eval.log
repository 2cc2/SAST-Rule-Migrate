/**
 * @name Python Eval Injection
 * @description Detects user data flowing into eval. This is code injection and should be avoided.
 * @id python.eval-injection
 * @kind path-problem
 * @problem.severity error
 */

import python
import python.flask
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class EvalSink extends TaintTracking::TaintSink {
  EvalSink() {
    exists(Call call |
      call.getCalleeName() = "eval" and
      this = call.getArg(0)
    )
  }
  
  override predicate isSource(DataFlow::Node source) { none() }
  override predicate isSink(DataFlow::Node sink) { this = sink }
  override predicate isBarrier(DataFlow::Node barrier) { none() }
}

class FlaskRequestSource extends TaintTracking::TaintSource {
  FlaskRequestSource() {
    exists(Import imp |
      imp.getImportedName() = "flask" and
      (
        exists(Call call, Name name |
          call.getCallee() = name and
          name.getId() = "request" and
          (name.getQualifierName() = "flask") and
          (call.getCalleeName() = "get" or call.getCalleeName() = "__getitem__" or call.getCalleeName() = "__call__") and
          this = call
        )
      )
    )
  }
  
  override predicate isSource(DataFlow::Node source) { this = source }
  override predicate isSink(DataFlow::Node sink) { none() }
  override predicate isBarrier(DataFlow::Node barrier) { none() }
}

class RouteParamSource extends TaintTracking::TaintSource {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().regexpMatch("^ROUTEVAR$|^W$") and
      this = p
    )
  }
  
  override predicate isSource(DataFlow::Node source) { this = source }
  override predicate isSink(DataFlow::Node sink) { none() }
  override predicate isBarrier(DataFlow::Node barrier) { none() }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "PythonEvalInjection" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof EvalSink
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input reaches eval execution without sanitization. $@ flows to $@.", 
  source.getNode(), "User input source", sink.getNode(), "eval sink"
