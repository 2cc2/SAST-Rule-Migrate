/**
 * @name Python Eval Injection
 * @description Detects user data flowing into eval. This is code injection and should be avoided.
 * @id python.eval-injection
 * @kind path-problem
 * @problem.severity error
 */

import python
import semmle.python.security.TaintTracking
import DataFlow

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(Call call |
      call.getCalleeName() = "eval" and
      this.asExpr() = call.getArg(0)
    )
  }

  override string toString() { result = "eval call" }
  override predicate asCfgNode() { this instanceof Expr }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() } 
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { none() }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Import imp |
      imp.getImportedModule() = "flask" and
      (
        exists(Call call, Name name |
          call.getCallee() = name and
          name.getId() = "request" and
          (name.getNamespace() = "flask" or name.getNamespace().getNamespace() = "flask") and
          (call.getCalleeName() = "get" or call.getCalleeName() = "__getitem__" or call.getCalleeName() = "__call__") and
          this.asExpr() = call
        )
      )
    )
  }

  override string toString() { result = "flask request" }
  override predicate asCfgNode() { this instanceof Expr }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override Scope getScope() { result = this.asExpr().getScope() }
  override Variable asVariable() { none() }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().regexpMatch("^ROUTEVAR$|^W$") and
      this.asParameter() = p
    )
  }

  override string toString() { result = "route parameter" }
  override predicate asCfgNode() { this instanceof Parameter }
  override Location getLocation() { result = this.asParameter().getLocation() }
  override BasicBlock getBasicBlock() { result = this.asParameter().getBasicBlock() }
  override Scope getScope() { result = this.asParameter().getScope() }
  override Variable asVariable() { result = this.asParameter().getVariable() }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "PythonEvalInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User input reaches eval execution without sanitization. $@ flows to $@.", 
  source.getNode(), "User input source", sink.getNode(), "eval sink"
