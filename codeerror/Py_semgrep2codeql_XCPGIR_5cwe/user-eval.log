Rule Content:
/**
 * @name Eval Injection
 * @description Detects user-supplied data flowing into eval() calls
 * @id eval-injection
 * @kind path-problem
 * @problem.severity ERROR
 * @tags security
 *       external/cwe/cwe-094
 *       external/cwe/cwe-095
 */

import python
import DataFlow::TaintTracking
import python.web.flask.Request

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    // Flask request parameters as source
    exists(DataFlow::CallNode call |
      call.getCallee().(HasQualifiedNameType).getQualifiedName() = "flask.request.get" and 
      this.asExpr() = call
    ) or
    // Route parameters as source
    exists(DataFlow::ParameterNode param |
      param.getAnUntypedAnnotation().getValue().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this.asExpr() = param
    )
  }

  override string getSourceType() { result = "User input" }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(DataFlow::CallNode call |
      call.getCallee().(HasQualifiedNameType).getQualifiedName() = "eval" and
      this.asExpr() = call.getArg(0)
    )
  }

  override string getSinkType() { result = "eval call" }
}

class AssignmentStep extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::AssignNode assign |
      assign.getTarget() = succ.asExpr() and
      assign.getValue() = pred.asExpr()
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof EvalSink }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(AssignmentStep step | step.step(pred, succ))
  }
}

from EvalInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "User input reaches eval execution without sanitization", 
  source, sink,
  source.getNode().asExpr().getLocation().getFile().getBaseName() + 
  ":" + source.getNode().asExpr().getLocation().getStartLine() + 
  ", to " + 
  sink.getNode().asExpr().getLocation().getFile().getBaseName() + 
  ":" + sink.getNode().asExpr().getLocation().getStartLine()
