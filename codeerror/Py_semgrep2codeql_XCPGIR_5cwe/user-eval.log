  languages: [python]
  frameworks: [flask]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }
sources:
  - id: ROUTE_PARAM
    match:
      node: PARAM
      where:
        - op: regex
          left: name
          right: "^ROUTEVAR$|^W$"
  - id: FLASK_REQUEST
    match:
      node: CALL
      api: { package: flask.request, method: get|__getitem__|__call__ }
sinks:
  - id: EVAL_CALL
    match:
      node: CALL
      api: { method: eval }
      arg_index: 0
propagations:
  - id: PARAM_TO_ARG
    edge: arg->param
    kind: taint
  - id: ASSIGN_TO_VAR
    edge: assignment
    kind: taint
flows:
  - source: ROUTE_PARAM
    sink: EVAL_CALL
    through: [PARAM_TO_ARG*, ASSIGN_TO_VAR*]
  - source: FLASK_REQUEST
    sink: EVAL_CALL
    through: [PARAM_TO_ARG*, ASSIGN_TO_VAR*]
report:
  message: "User input reaches eval execution without sanitization"
  locations: ["source", "sink", "path"]
  evidence:
    capture:
      - { argument: 0 }
