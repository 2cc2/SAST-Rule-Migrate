where config.hasFlowPath(source, sink)
select sink, 
  "User input reaches eval execution without sanitization",
  source, sink,
  "From " + source.getNode().getLocation().getFile().getBaseName() + 
  ":" + source.getNode().getLocation().getStartLine() + 
  " to " + 
  sink.getNode().getLocation().getFile().getBaseName() + 
  ":" + sink.getNode().getLocation().getStartLine()
