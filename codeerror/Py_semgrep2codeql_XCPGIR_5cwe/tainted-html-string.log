 *              This could create a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-string
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import python.Concepts.Parameter

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Parameter p | 
      p.getName() = "event" and 
      this.asParameter() = p
    )
  }
}

class HtmlStringConstruction extends DataFlow::Node {
  HtmlStringConstruction() {
    exists(MethodCall call |
      (call.getMethodName() = "format" and this = call.getAnArgument()) or
      (this.asExpr().(StringLiteral).getValue().regexpMatch("%\\%.*|\\+.*|f\".*\\{.*\\}.*"))
    )
  }
}

class TaintedHtmlStringConfig extends TaintTracking::Configuration {
  TaintedHtmlStringConfig() { this = "TaintedHtmlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlStringConstruction
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }

  override predicate isBarrier(DataFlow::Node barrier) {
    // Exclude flows through print statements
    exists(MethodCall call |
      call.getMethodName() = "print" and
      barrier.asExpr() = call
    )
  }
}

from TaintedHtmlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches HTML string construction without sanitization",
  source.getNode(), 
  "User input from Lambda event parameter",
  sink.getNode(), 
  "HTML string construction"
