Rule Content:
/**
 * @name Tainted HTML String Construction
 * @description Detected user input flowing into a manually constructed HTML string.
 *              This could create a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-string
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class LambdaEventSource extends TaintTracking::Source {
  LambdaEventSource() {
    exists(Function f, Parameter p |
      f.getParameter(0) = p and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }

  override string toString() { result = "Lambda event parameter source" }
}

class HtmlStringConstruction extends TaintTracking::Sink {
  HtmlStringConstruction() {
    exists(Call call, Expr str |
      (call.getMethodName() = "format" and
       this.asExpr() = call.getAnArgument()) or
      (str.(StringLiteral).getValue().regexpMatch("%\\%.*|\\+.*|f\".*\\{.*\\}.*") and
       this.asExpr() = str)
    )
  }

  override string toString() { result = "HTML string construction sink" }
}

class TaintedHtmlStringConfig extends TaintTracking::Configuration {
  TaintedHtmlStringConfig() { this = "TaintedHtmlStringConfig" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof HtmlStringConstruction
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) { none() }

  override predicate isBarrier(TaintTracking::Barrier barrier) {
    exists(Call call |
      call.getMethodName() = "print" and
      barrier.asExpr() = call
    )
  }
}

from TaintedHtmlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(),
  "User input reaches HTML string construction without sanitization",
  source.getNode(), "User input from Lambda event parameter",
  sink.getNode(), "HTML string construction"
================================================================================
