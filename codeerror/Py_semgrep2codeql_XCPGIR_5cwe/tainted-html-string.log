Rule Content:
/**
 * @name Tainted HTML String
 * @description Detected user input flowing into a manually constructed HTML string.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-html-string
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.StringFormat
import DataFlow::PathGraph

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(MethodParameter p |
      p.getPosition() = 0 and
      p.getName() = "event" and
      p.getScope().getFile().getRelativePath().regexpMatch(".*lambda.*") |
      this.asParameter() = p
    )
  }
}

class UnsafeHtmlConstructionCall extends DataFlow::Node {
  UnsafeHtmlConstructionCall() {
    exists(Call call |
      call.getTarget().toString().regexpMatch("(?:%|format|\\+|f)") and
      call.getAnArgument().toString().regexpMatch(".*<\\w+") and
      this.asExpr() = call
    )
  }

  or

  exists(Assignment a |
    a.getAnRValue().toString().regexpMatch("\"" + ".*<\\w+" + "\"") and
    this.asExpr() = a
  )
}

class UnsafeHtmlConstructionReturn extends DataFlow::Node {
  UnsafeHtmlConstructionReturn() {
    exists(ReturnStmt ret |
      ret.getExpr().toString().regexpMatch(".*<\\w+") and
      this.asExpr() = ret
    )
  }
}

class SafeHtmlPrint extends DataFlow::Node {
  SafeHtmlPrint() {
    exists(Call call |
      call.getTarget().getName() = "print" and
      this.asExpr() = call
    )
  }
}

class TaintedHtmlStringFlowConfiguration extends TaintTracking::Configuration {
  TaintedHtmlStringFlowConfiguration() { this = "TaintedHtmlStringFlow" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeHtmlConstructionCall or
    sink instanceof UnsafeHtmlConstructionReturn
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeHtmlPrint
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringFormatOperation op |
      op.getAnOperand() = pred.asExpr() and
      op.getResult() = succ.asExpr()
    )
  }
}

from TaintedHtmlStringFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User input flows into unsafe HTML construction. You may be accidentally bypassing " +
  "secure methods of rendering HTML. Check that the HTML is rendered safely or use templates instead."
