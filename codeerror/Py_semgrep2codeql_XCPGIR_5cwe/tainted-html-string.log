```yaml
xcpgir_version: "1.0"
rule:
  id: tainted-html-string
  kind: taint
  severity: WARNING
  message: >-
    Detected user input flowing into a manually constructed HTML string. You may be accidentally bypassing
    secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability,
    which could let attackers steal sensitive user data. To be sure this is safe, check that the HTML is rendered
    safely. Otherwise, use templates which will safely render HTML instead.
scope:
  languages: [python]
  frameworks: [aws-lambda]

sources:
  - id: USER_INPUT
    match:
      node: METHOD_PARAMETER_IN
      where:
        - op: eq
          left: name
          right: "event"

sinks:
  - id: UNSAFE_HTML_CONSTRUCTION
    match:
      node: CALL
      where:
        - op: regex
          left: code
          right: '"(?:%|format|\+|f)".*<\w+'
      or:
        - node: ASSIGNMENT
          where:
            - op: regex
              left: code
              right: '\w+\s*=\s*".*<\w+"'
        - node: CALL
          where:
            - op: regex
              left: code
              right: '\w+\s*(?:%|format|\+)'

sanitizers:
  - id: SAFE_PRINT
    match: { node: CALL, api: { method: print } }
    effect: neutralize

barriers:
  - id: RETURN_STOP
    match: { node: RETURN }
    effect: stop

propagations:
  - id: STRING_OPS
    edge: arg->param
    kind: taint

flows:
  - source: USER_INPUT
    sink: UNSAFE_HTML_CONSTRUCTION
    through: [STRING_OPS*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(print)" } ]

report:
  message: "User input flows into unsafe HTML construction"
  locations: ["source","sink","path"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "html = f'<div>{event}</div>'"
    - "html = '<div>%s</div>' % event"
  negative:
    - "print(f'<div>{event}</div>')"
```
