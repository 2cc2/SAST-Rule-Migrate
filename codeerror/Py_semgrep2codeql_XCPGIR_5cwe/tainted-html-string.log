Rule Content:
/**
 * @name Tainted HTML String
 * @description Detected user input flowing into a manually constructed HTML string.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-html-string
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.ApiGraphs  
import semmle.python.dataflow.new.TaintTracking
import semmle.python.dataflow.new.DataFlow::PathGraph

class UserInput extends TaintTracking::Source {
  UserInput() {
    exists(Parameter p |
      p.getParameterNumber() = 0 and
      p.getName() = "event" and
      exists(Function f | p.getEnclosingFunction() = f |
        f.getFile().getRelativePath().regexpMatch(".*lambda.*")
      ) and
      this.asParameter() = p
    )
  }
}

class UnsafeHtmlConstructionCall extends TaintTracking::Sink {
  UnsafeHtmlConstructionCall() {
    exists(Call call |
      (
        call.getCalleeName() = "format" or
        call.getCalleeName() = "%" or  
        call.getParent() instanceof StringExpr and 
        call.getParent().(StringExpr).usesFString()
      ) and
      call.getArgument(0).toString().regexpMatch(".*<\\w+") and
      this.asExpr() = call
    ) or
    exists(Assign a |
      a.getRValue().toString().regexpMatch(".*<\\w+") and
      this.asExpr() = a
    )
  }
}

class SafeHtmlPrint extends TaintTracking::Sanitizer {
  SafeHtmlPrint() {
    exists(Call call |
      call.getCalleeName() = "print" and
      this.asExpr() = call
    )
  }
}

class TaintedHtmlStringFlowConfiguration extends TaintTracking::Configuration {
  TaintedHtmlStringFlowConfiguration() { this = "TaintedHtmlStringFlow" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof UserInput
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof UnsafeHtmlConstructionCall
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof SafeHtmlPrint
  }
}

from TaintedHtmlStringFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User input flows into unsafe HTML construction. You may be accidentally bypassing " +
  "secure methods of rendering HTML. Check that the HTML is rendered safely or use templates instead."
