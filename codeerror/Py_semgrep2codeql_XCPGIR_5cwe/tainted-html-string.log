/**
 * @name Tainted HTML String
 * @description Detected user input flowing into a manually constructed HTML string.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-html-string
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.new.DataFlow
import semmle.python.strings.StringFormat

class UserInput extends DataFlow::ParameterNode {
  UserInput() {
    exists(Parameter p |
      p.getPosition() = 0 and
      p.getName() = "event" and
      p.getFunction().getFile().getRelativePath().regexpMatch(".*lambda.*") |
      this = p
    )
  }
}

class UnsafeHtmlConstructionCall extends DataFlow::ExprNode {
  UnsafeHtmlConstructionCall() {
    exists(Call call |
      (
        call.getFunc().getName() = "format" or
        call.getFunc().getName() = "%" or
        exists(StringExpr str | str = call.getParent() | str.usesFString())
      )
      and
      call.getArg(0).toString().regexpMatch(".*<\\w+") 
      and this = call
    )
    or
    exists(Assign a |
      a.getExpr().toString().regexpMatch("\".*<\\w+\"") 
      and this = a
    )
  }
}

class SafeHtmlPrint extends DataFlow::ExprNode {
  SafeHtmlPrint() {
    exists(Call call |
      call.getFunc().getName() = "print" 
      and this = call
    )
  }
}

class TaintedHtmlStringFlowConfiguration extends TaintTracking::Configuration {
  TaintedHtmlStringFlowConfiguration() { this = "TaintedHtmlStringFlow" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof UserInput 
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeHtmlConstructionCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeHtmlPrint
  }
}

from TaintedHtmlStringFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User input flows into unsafe HTML construction. You may be accidentally bypassing " +
  "secure methods of rendering HTML. Check that the HTML is rendered safely or use templates instead."
