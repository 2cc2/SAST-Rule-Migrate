Rule Content:
/**
 * @name Tainted HTML String
 * @description Detected user input flowing into a manually constructed HTML string.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-html-string
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.ApiGraphs
import semmle.python.StringFormat
import DataFlow::PathGraph
import semmle.python.dataflow.new.TaintTracking

class UserInput extends TaintTracking::TaintSource {
  UserInput() {
    exists(Parameter p |
      p.getPosition() = 0 and
      p.getName() = "event" and
      p.getScope().getFile().getRelativePath().regexpMatch(".*lambda.*") |
      this.asParameter() = p
    )
  }

  override predicate isSource(DataFlow::Node source) { this = source }
}

class UnsafeHtmlConstructionCall extends TaintTracking::TaintSink {
  UnsafeHtmlConstructionCall() {
    exists(Call call |
      call.getCallee().toString().regexpMatch("(?:%|format|\\+|f)") and
      call.getArgument(0).toString().regexpMatch(".*<\\w+") and
      this.asExpr() = call
    )
    or
    exists(Assign a |
      a.getRValue().toString().regexpMatch("\"" + ".*<\\w+" + "\"") and
      this.asExpr() = a
    )
  }

  override predicate isSink(DataFlow::Node sink) { this = sink }
}

class UnsafeHtmlConstructionReturn extends TaintTracking::TaintSink {
  UnsafeHtmlConstructionReturn() {
    exists(Return ret |
      ret.getResult().toString().regexpMatch(".*<\\w+") and
      this.asExpr() = ret
    )
  }
}

class SafeHtmlPrint extends TaintTracking::Sanitizer {
  SafeHtmlPrint() {
    exists(Call call |
      call.getCallee().getName() = "print" and
      this.asExpr() = call
    )
  }
}

class TaintedHtmlStringFlowConfiguration extends TaintTracking::Configuration {
  TaintedHtmlStringFlowConfiguration() { this = "TaintedHtmlStringFlow" }

  override predicate isSource(TaintTracking::TaintSource source) { 
    source instanceof UserInput 
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof UnsafeHtmlConstructionCall or
    sink instanceof UnsafeHtmlConstructionReturn
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof SafeHtmlPrint
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringFormat::FormatOperation op |
      op.getAnOperand() = pred.asExpr() and
      op.getResult() = succ.asExpr()
    )
  }
}

from TaintedHtmlStringFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User input flows into unsafe HTML construction. You may be accidentally bypassing " +
  "secure methods of rendering HTML. Check that the HTML is rendered safely or use templates instead."
