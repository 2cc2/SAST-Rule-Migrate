/**
 * @name Unquoted Template Attribute Variable in Flask
 * @description Detects unquoted template variables used as HTML attributes which may lead to XSS
 * @kind path-problem
 * @problem.severity warning
 * @id python/xss/unquoted-template-attr
 * @tags security
 *       external/cwe/cwe-79
 *       external/owasp/a07
 *       external/owasp/a03
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.web.flask.FlaskRequest
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(CallNode call |
      call.getTarget().(FunctionValue).getQualifiedName().matches("flask.request.%") and
      (call.getMethodName() = "get" or call.getMethodName() = "__getitem__") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class TemplateLiteralSink extends DataFlow::Node {
  TemplateLiteralSink() {
    exists(LiteralNode lit | 
      lit.getStringValue().regexpMatches("=\\{\\{.+?\\}\\}") and
      not lit.getStringValue().regexpMatches("=\\\\\".*\\{\\{.+?\\}\\}.*\\\\\"") and
      this.asExpr() = lit
    )
  }
}

class UnquotedTemplateXSSConfig extends TaintTracking::Configuration {
  UnquotedTemplateXSSConfig() { this = "UnquotedTemplateXSSConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof FlaskRequestSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof TemplateLiteralSink 
  }
}

from UnquotedTemplateXSSConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Unquoted template variable detected in attribute. Potential XSS vulnerability. " +
  "If unquoted, a malicious actor could inject custom JavaScript handlers. To fix this, add quotes around the template expression.",
  source, sink.toString(),
  "This user input flows into an unquoted template attribute which could allow XSS injection."
