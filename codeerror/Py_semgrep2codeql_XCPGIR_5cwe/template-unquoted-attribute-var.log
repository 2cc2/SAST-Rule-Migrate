Rule Content:
/**
 * @name TemplateUnquotedAttributeVar
 * @description Detected a unquoted template variable as an attribute. If unquoted,
 *              a malicious actor could inject custom JavaScript handlers.
 * @kind path-problem
 * @problem.severity warning
 * @id python/template-unquoted-attribute-var
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Requests
import DataFlow::PathGraph

class Config extends TaintTracking::Configuration {
  Config() { this = "TemplateUnquotedAttributeVar" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(MethodCallNode call |
      call.getMethod().getQualifiedName() = "request.get" and
      source.asExpr() = call
    )
  }
  
  override predicate isSink(DataFlow::Node sink) {
    exists(Literal lit |
      lit.getStringValue().regexpMatch("=\\{\\{.*\\}\\}") and
      sink.asExpr() = lit
    )
  }
  
  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected a unquoted template variable as an attribute. Add quotes around the template expression."
