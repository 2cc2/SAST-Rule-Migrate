Rule Content:
/**
 * @name Unquoted Template Attribute Variable in Flask
 * @description Detects unquoted template variables used as HTML attributes which may lead to XSS
 * @kind path-problem
 * @problem.severity warning
 * @id python/xss/unquoted-template-attr
 * @tags security
 *       external/cwe/cwe-79
 *       external/owasp/a07
 *       external/owasp/a03
 */

import python
import semmle.python.web.HttpServerRequest
import semmle.python.web.Request
import DataFlow::PathGraph
import semmle.python.dataflow.new.DataFlow

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getTarget().(FunctionValue).getQualifiedName().matches("flask.Request.%") and
      (
        call.getMethodName() = "get" or
        call.getMethodName() = "__getitem__"
      ) and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class TemplateLiteralSink extends DataFlow::Node {
  TemplateLiteralSink() {
    exists(MethodCall call, string format |
      format = call.getTarget().toString() and
      format.regexpMatch(".*=\\{\\{.+?\\}\\}.*") and
      not format.regexpMatch(".*=\\\\\".*\\{\\{.+?\\}\\}.*\\\\\".*") and
      this.asExpr() = call
    )
  }
}

class UnquotedTemplateXSSFlow extends TaintTracking::Configuration {
  UnquotedTemplateXSSFlow() { this = "UnquotedTemplateXSSFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TemplateLiteralSink
  }
}

from UnquotedTemplateXSSFlow flow, DataFlow::PathNode source, DataFlow::PathNode sink
where flow.hasFlowPath(source, sink)
select sink.getNode(), 
  "Unquoted template variable detected in attribute. Potential XSS vulnerability. " +
  "User input flows into an unquoted template attribute which could allow XSS injection.",
  source.getNode(), "Source of user input",
  sink.getNode(), "Unquoted template attribute usage"
