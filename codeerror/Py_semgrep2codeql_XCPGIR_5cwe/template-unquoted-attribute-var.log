/***********************************************************************
* Unquoted Template Attribute Variable XSS Detection
* 
* Detects when Flask template variables are used unquoted as HTML attributes,
* which could allow XSS injection if user-controlled input is passed to them.
***********************************************************************/
import python
import html
import semmle.python.web.flask.FlaskRequest
import semmle.python.web.flask.RequestArgs
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCallNode call |
      call.getTarget().(FunctionValue).getUnderlyingType().hasQualifiedName("flask", "Request") and
      (
        call.getMethodName() = "get" or
        call.getMethodName() = "__getitem__"
      ) and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class TemplateLiteralSink extends DataFlow::Node {
  TemplateLiteralSink() {
    exists(html::Attribute attr |
      attr.getValue().regexpMatch("=\\{\\{.+?\\}\\}") and
      not attr.getValue().regexpMatch("=\\\\\".*\\{\\{.+?\\}\\}.*\\\\\"") and
      this.asExpr() = attr.getValue()
    )
  }
}

class UnquotedTemplateXSSConfig extends TaintTracking::Configuration {
  UnquotedTemplateXSSConfig() { this = "UnquotedTemplateXSSConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TemplateLiteralSink
  }
}

from UnquotedTemplateXSSConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Unquoted template variable detected in attribute. Potential XSS vulnerability.",
  source, sink,
  "Untrusted input flows into unquoted template attribute, which could allow XSS injection."
