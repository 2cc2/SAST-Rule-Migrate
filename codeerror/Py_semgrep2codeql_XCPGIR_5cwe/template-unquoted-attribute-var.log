```yaml
xcpgir_version: "1.0"
rule:
  id: template-unquoted-attribute-var
  kind: hybrid
  severity: WARNING
  message: "Detected a unquoted template variable as an attribute. If unquoted, a malicious actor could inject custom JavaScript handlers. To fix this, add quotes around the template expression."
  metadata:
    cwe: ["CWE-79: Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')"]
    owasp: ["A07:2017 - Cross-Site Scripting (XSS)", "A03:2021 - Injection"]

scope:
  languages: [python, html]
  frameworks: ["flask"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: UNTRUSTED_INPUT
    match:
      node: CALL
      api: { type: flask.request, method: get }
      arg_index: 0
    tags: [xss]
  
  - id: UNTRUSTED_INPUT_ARRAY
    match:
      node: CALL
      api: { type: flask.request, method: __getitem__ }
      arg_index: 0
    tags: [xss]

sinks:
  - id: UNQUOTED_ATTR
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "=\\{\\{\\$.*\\}\\}"
    tags: [xss]

propagations:
  - id: REQUEST_TO_TEMPLATE
    edge: arg->param
    kind: taint

sanitizers:
  - id: QUOTED_TEMPLATE
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "=\\\"\\{\\{\\$.*\\}\\}\\\""
    effect: neutralize

flows:
  - source: UNTRUSTED_INPUT
    sink: UNQUOTED_ATTR
    through: [REQUEST_TO_TEMPLATE*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(=\"{{$.*}}\")" } ]

report:
  locations: ["source", "sink"]
  message: "Unquoted template variable detected in attribute. Potential XSS vulnerability."
  evidence:
    capture:
      - { argument: 0 }

tests:
  positive:
    - "<div class={{ request.args.get('name') }}></div>"
  negative:
    - "<div class=\"{{ request.args.get('name') }}\"></div>"
```
