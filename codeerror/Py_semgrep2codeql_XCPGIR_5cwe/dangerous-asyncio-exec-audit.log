Rule Content:
/**
 * @name Dangerous Asyncio Exec Audit
 * @description Detected subprocess function without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection.
 * @kind taint-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 * @tags security
 *       external/cwe/cwe-078
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.Strings

class DangerousAsyncioExecConfiguration extends TaintTracking::Configuration {
  DangerousAsyncioExecConfiguration() { this = "DangerousAsyncioExecConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p and p.getType().(ClassType).getName() = "str" |
      source.asParameter() = p)
    or
    exists(ReturnStmt r | source.asReturn() = r and r.getType().(ClassType).getName() = "str" |
      source.asReturn() = r)
    or
    exists(Field f | source.asField() = f and f.getType().(ClassType).getName() = "str" |
      source.asField() = f)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall mc |
      mc.getMethodName() = "subprocess_exec" and
      mc.getQualifier().getType().(ClassType).getName() = "asyncio.loop" and
      (sink.asExpr() = mc.getArgument(1) or sink.asExpr() = mc.getArgument(2)))
    or
    exists(MethodCall mc |
      mc.getMethodName() = "subprocess_exec" and
      mc.getQualifier().getType().(ClassType).getName() = "asyncio.loop" and
      (exists(StringLiteral s | mc.getArgument(1).asExpr() = s |
        s.getValue().regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/") and
        sink.asExpr() = mc.getArgument(1))))
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral lit | sanitizer.asExpr() = lit)
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodCall mc |
      mc.getMethodName() = "escape" and
      mc.getQualifier().getType().(ClassType).getName() = "shlex" and
      node.asExpr() = mc.getArgument(0))
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Parameter p, Argument a |
      pred.asExpr() = a.getExpr() and
      succ.asParameter() = p and
      a = p.getAnArg())
  }
}

from DangerousAsyncioExecConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
