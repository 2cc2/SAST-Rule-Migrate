/**
 * @name Dangerous asyncio subprocess_exec without static string
 * @description Detected subprocess function without a static string. If this data can be controlled by
 *              a malicious actor, it may be an instance of command injection. Audit the use of this call
 *              to ensure it is not controllable by an external resource.
 * @kind path-problem
 * @problem.severity error
 * @id pyr/dangerous-asyncio-exec-audit
 * @tags security
 *       external/cwe/cwe-078
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import python
import semmle.python.TaintTracking
import semmle.python.DataFlow
import DataFlow::PathGraph

class DangerousAsyncioExec extends TaintTracking::Configuration {
  DangerousAsyncioExec() { this = "Dangerous asyncio subprocess_exec usage" }

  override predicate isSource(TaintTracking::Source source) {
    exists(Call call, Expr arg |
      call.getCallee().getName() = "subprocess_exec" and
      call.getReceiver().getType().hasQualifiedName("asyncio.loop") and
      arg = call.getArgument(1) and
      not exists(StringLiteral s | s = arg) and
      not exists(List l | l = arg) and
      source.asSource() = arg
    )
  }

  override predicate isSink(TaintTracking::Sink sink) {
    exists(Call call, Expr arg1, Expr arg2 |
      call.getCallee().getName() = "subprocess_exec" and
      call.getReceiver().getType().hasQualifiedName("asyncio.loop") and
      arg1 = call.getArgument(1) and
      arg2 = call.getArgument(2) and
      exists(StringLiteral shell | shell = arg1 |
        shell.getLiteralString().matches("%sh%") or
        shell.getLiteralString().matches("%bash%") or
        shell.getLiteralString().matches("%ksh%") or
        shell.getLiteralString().matches("%csh%") or
        shell.getLiteralString().matches("%tcsh%") or
        shell.getLiteralString().matches("%zsh%")
      ) and
      exists(StringLiteral flag | flag = arg2 |
        flag.getLiteralString() = "-c"
      ) and
      sink.asSink() = call
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(Call call |
      call.getCallee().getName() = "escape" and
      call.getReceiver().getType().hasQualifiedName("shlex") and
      sanitizer.asSanitizer() = call
    )
  }
}

