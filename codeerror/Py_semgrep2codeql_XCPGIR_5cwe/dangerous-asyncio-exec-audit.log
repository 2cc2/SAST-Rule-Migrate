xcpgir_version: "1.0"
rule:
  id: dangerous-asyncio-exec-audit
  kind: taint
  severity: ERROR
  message: "Detected subprocess function without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection."
scope:
  languages: [python]
  frameworks: ["*"]
  env: { os: [linux, windows], shell: [bash, sh, ksh, csh, tcsh, zsh, powershell] }

sources:
  - id: UNTRUSTED_INPUT
    match:
      node: PARAM | RETURN | FIELD
      type: { name: "str", match: exact }
  
sinks:
  - id: DANGEROUS_EXEC
    match:
      node: CALL
      api: { type: asyncio.loop, method: subprocess_exec }
      arg_index: [1, 2]
  - id: SHELL_EXEC
    match:
      node: CALL
      api: { type: asyncio.loop, method: subprocess_exec }
      where:
        - op: regex
          left: arg[1].value
          right: "/(sh|bash|ksh|csh|tcsh|zsh)/"

sanitizers:
  - id: STATIC_STRING
    match:
      node: LITERAL
      where:
        - op: eq
          left: is_static
          right: true
    effect: neutralize

barriers:
  - id: SHELL_ESCAPE
    match:
      node: CALL
      api: { type: shlex, method: escape }
    effect: neutralize

propagations:
  - id: ARG_TO_ARG
    edge: arg->param
    kind: taint

flows:
  - source: UNTRUSTED_INPUT
    sink: DANGEROUS_EXEC
    through: [ARG_TO_ARG*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(is_static=true)" } ]
  - source: UNTRUSTED_INPUT
    sink: SHELL_EXEC
    through: [ARG_TO_ARG*]

report:
  message: "Detected subprocess function '$LOOP.subprocess_exec' without a static string. Audit the use of this call to ensure it is not controllable by an external resource. You may consider using 'shlex.escape()'."
  locations: ["source", "sink", "path"]
  metadata:
    owasp:
      - "A01:2017 - Injection"
      - "A03:2021 - Injection"
    cwe: "CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"
    references:
      - "https://docs.python.org/3/library/shlex.html"
```
