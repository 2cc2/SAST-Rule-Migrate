Rule Content:
/**
 * @name Dangerous asyncio subprocess_exec without static string
 * @description Detected subprocess function without a static string. If this data can be controlled by
 *              a malicious actor, it may be an instance of command injection. Audit the use of this call
 *              to ensure it is not controllable by an external resource.
 * @kind path-problem
 * @problem.severity error
 * @id pyr/dangerous-asyncio-exec-audite
 * @tags security
 *       external/cwe/cwe-078
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.dataflow.new.DataFlow
import DataFlow::PathGraph

class DangerousAsyncioExec extends TaintTracking::Configuration {
  DangerousAsyncioExec() { this = "Dangerous asyncio subprocess_exec usage" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call, Expr arg |
      call.getCalleeName() = "subprocess_exec" and
      call.getReceiver().getType().hasQualifiedName("asyncio.loop") and
      arg = call.getArgument(1) and
      not arg instanceof StringLiteral and
      not arg instanceof List and
      source.asExpr() = arg
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(CCall call, Expr arg1, Expr arg2 |
      call.getCalleeName() = "subprocess_exec" and
      call.getReceiver().getType().hasQualifiedName("asyncio.loop") and
      arg1 = call.getArgument(1) and
      arg2 = call.getArgument(2) and
      arg1 instanceof StringLiteral and
      (
        arg1.toString().matches(".*sh.*") or
        arg1.toString().matches(".*bash.*") or
        arg1.toString().matches(".*ksh.*") or
        arg1.toString().matches(".*csh.*") or
        arg1.toString().matches(".*tcsh.*") or
        arg1.toString().matches(".*zsh.*")
      ) and
      arg2 instanceof StringLiteral and
      arg2.toString() = "-c" and
      sink.asExpr() = call
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getCalleeName() = "escape" and
      call.getReceiver().getType().hasQualifiedName("shlex") and
      sanitizer.asExpr() = call
    )
  }
}

from DangerousAsyncioExec config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Detected potentially unsafe subprocess call with dynamic command. " +
  "Audit the use of this call to ensure it is not controllable by an external " +
  "resource. Consider using shlex.escape()."
================================================================================
