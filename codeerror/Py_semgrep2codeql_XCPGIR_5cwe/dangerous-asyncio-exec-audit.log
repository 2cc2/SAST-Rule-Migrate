        - op: neq
          left: arg[1].value
          right: "..."
        - op: neq
          left: arg[1].value
          right: ["...", ...]

sinks:
  - id: SHELL_COMMAND
    match:
      node: CALL
      api: { type: asyncio.loop, method: subprocess_exec }
      where:
        - op: regex
          left: arg[1].value
          right: "/(sh|bash|ksh|csh|tcsh|zsh)/"
        - op: eq
          left: arg[2].value
          right: "-c"

sanitizers:
  - id: SHLEX_ESCAPE
    match: { node: CALL, api: { type: shlex, method: escape } }
    effect: neutralize

flows:
  - source: DYNAMIC_COMMAND
    sink: SHELL_COMMAND
    constraints:
      path:
        must_not: [ { pattern: "CALL(shlex.escape)" } ]

report:
  message: "Detected potentially unsafe subprocess call with dynamic command"
  locations: ["sink"]
  evidence: { capture: [{ argument: 1 }] }

metadata:
  owasp: ["A01:2017 - Injection", "A03:2021 - Injection"]
  cwe: ["CWE-78: Improper Neutralization of Special Elements used in an OS Command"]
  references:
    - "https://docs.python.org/3/library/asyncio-eventloop.html#asyncio.loop.subprocess_exec"
    - "https://docs.python.org/3/library/shlex.html"
    - "https://semgrep.dev/docs/cheat-sheets/python-command-injection/"
