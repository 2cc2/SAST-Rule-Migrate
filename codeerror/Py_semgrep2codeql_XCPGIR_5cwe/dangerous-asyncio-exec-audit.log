import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class DangerousAsyncioExecConfig extends TaintTracking::Configuration {
  DangerousAsyncioExecConfig() { this = "DangerousAsyncioExecConfig" }

  override predicate isSource(TaintTracking::Source source) {
    exists(Parameter p |
      source.asParameter() = p and
      p.getType().getName() = "str" and
      not exists(StringLiteral sl | source.asExpr() = sl)
    )
    or
    exists(Function f, ReturnStmt ret |
      source.asReturn(ret) and
      ret.getEnclosingFunction() = f and
      f.getType().getName() = "str"
    )
    or
    exists(Field f |
      source.asField(f) and
      f.getType().getName() = "str"
    )
  }

  override predicate isSink(TaintTracking::Sink sink) {
    exists(MethodCall call, Method m |
      call.getMethod() = m and
      m.hasName("subprocess_exec") and
      m.getDeclaringType().hasQualifiedName("asyncio.loop") and
      (
        sink.asExpr() = call.getArgument(1) or
        sink.asExpr() = call.getArgument(2) or
        exists(StringLiteral shell |
          call.getArgument(1).getValue().regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/")
        )
      )
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(StringLiteral lit | sanitizer.asExpr() = lit)
    or
    exists(MethodCall mc, Method m |
      mc.getMethod() = m and
      m.hasName("escape") and
      m.getDeclaringType().hasQualifiedName("shlex") and
      sanitizer.asExpr() = mc.getAnArgument()
    )
  }
}

