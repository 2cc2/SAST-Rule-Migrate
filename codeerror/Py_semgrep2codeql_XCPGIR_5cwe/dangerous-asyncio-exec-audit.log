Rule Content:
/**
 * @name Dangerous Asyncio Exec Audit
 * @description Detected subprocess function without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 * @tags security
 *       external/cwe/cwe-078
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class DangerousAsyncioExecConfig extends TaintTracking::Configuration {
  DangerousAsyncioExecConfig() { this = "DangerousAsyncioExecConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | 
      source.asParameter() = p and 
      p.getType().getName() = "str" and
      not exists(StringLiteral sl | source.asExpr() = sl)
    )
    or
    exists(FunctionReturn ret |
      source.asDef() = ret.getReturn() and
      ret.getType().getName() = "str"
    )
    or
    exists(Field f |
      source.asField() = f and
      f.getType().getName() = "str"
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(API::CallNode call |
      call.getMethod().hasName("subprocess_exec") and
      call.getMethod().getDeclaringType().hasQualifiedName("asyncio.loop") and
      (
        sink.asExpr() = call.getArgument(1) or
        sink.asExpr() = call.getArgument(2) or
        exists(StringLiteral shell |
          call.getArgument(1).getValue().regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/")
        )
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral lit | sanitizer.asExpr() = lit)
    or
    exists(API::CallNode mc |
      mc.getMethod().hasName("escape") and
      mc.getQualifier().getType().hasQualifiedName("shlex") and
      sanitizer.asExpr() = mc.getAnArgument()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(API::CallNode call, Argument arg, Parameter param |
      node1.asExpr() = call.getAnArgument() and
      node2.asParameter() = param and
      arg = call.getAnArgument() and
      param = arg.getParameter()
    )
  }
}

from DangerousAsyncioExecConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
