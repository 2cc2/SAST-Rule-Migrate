/**
 * @name Dangerous Asyncio Exec Audit
 * @description Detected subprocess function without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection.
 * @kind taint-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 * @tags security
 *       external/cwe/cwe-078
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class DangerousAsyncioExecConfiguration extends TaintTracking::Configuration {
  DangerousAsyncioExecConfiguration() { this = "DangerousAsyncioExecConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | 
      source.asParameter() = p and 
      exists(p.getType() | 
        this = "str" and
        not exists(StringLiteral lit | source.asExpr() = lit)
      )
    )
    or
    exists(FunctionReturn ret |
      source = ret.getReturn() and
      exists(ret.getType() | this = "str")
    )
    or
    exists(Field f |
      source.asField() = f and
      exists(f.getType() | this = "str")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method method, DataFlow::CallNode call |
      method.hasName("subprocess_exec") and
      method.getDeclaringType().hasQualifiedName("asyncio.loop") and
      call = sink.getCall() and
      (
        call.getArgument(1) = sink.asExpr() or
        call.getArgument(2) = sink.asExpr() or
        exists(StringLiteral shell |
          call.getArgument(1).getValueText().matches("%sh%") or
          call.getArgument(1).getValueText().matches("%bash%") or
          call.getArgument(1).getValueText().matches("%ksh%") or
          call.getArgument(1).getValueText().matches("%csh%") or
          call.getArgument(1).getValueText().matches("%tcsh%") or
          call.getArgument(1).getValueText().matches("%zsh%") 
        )
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral lit | sanitizer.asExpr() = lit)
    or
    exists(MethodCall mc |
      mc.getMethod().hasName("escape") and
      mc.getQualifier().getType().hasQualifiedName("shlex") and
      sanitizer.asExpr() = mc.getAnArgument()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::CallNode call, Argument arg, Parameter param |
      node1.asExpr() = call.getAnArgument() and
      node2.asParameter() = param and
      arg = call.getAnArgument() and
      param = arg.getParameter()
    )
  }
}

from DangerousAsyncioExecConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
