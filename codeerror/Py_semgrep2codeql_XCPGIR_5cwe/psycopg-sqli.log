Rule Content:
# 转换后的 Codeql 规则
/**
 * @name psycopg-sqli
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/psycopg2-sqli
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.Concepts
import DataFlow::PathGraph

class Psycopg2Cursor extends DataFlow::Node {
  Psycopg2Cursor() {
    exists(FunctionValue func, Call c |
      func.getName() in ["execute", "executemany", "mogrify"] and
      c.getFunc() = func and
      func.getDeclaringType().getName() = "Cursor" and
      func.getDeclaringType().getASourceFile().getRelativePath().matches("psycopg2/%") and
      this = c.getArg(1)
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Expr e |
      (e instanceof Name or e instanceof Call or e instanceof Parameter) and
      not e.isConstant() and
      this = e
    )
  }
  
  override predicate isSource() { true }
}

class StringConcat extends DataFlow::Node {
  StringConcat() {
    exists(BinaryExpr b |
      b.getOp().toString() = "+" and
      (this = b.getLeft() or this = b.getRight())
    )
    or
    exists(Call c |
      c.getFunc().(Name).getId() = "format" and
      this = c.getArg(_)
    )
  }
  
  override predicate isBarrier() { false }
}

class SafeQueryPattern extends DataFlow::Node {
  SafeQueryPattern() {
    exists(Call c |
      c.getFunc().(Name).getId() = "SQL" and
      c.getFunc().getDeclaringType().getName() = "SQL" and
      c.getFunc().getDeclaringType().getASourceFile().getRelativePath().matches("psycopg2/sql/%") and
      this = c.getArg(_)
    )
    or
    exists(StringLiteral s |
      s.getValue().regexpMatch("%[sdf]") and
      this = s
    )
  }
  
  override predicate isSanitizer() { true }
}

query predicate edges(DataFlow::Node source, DataFlow::Node sink) {
  exists(StringConcat sc | DataFlow::localFlow(source, sc) and DataFlow::localFlow(sc, sink))
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  sink.getNode() instanceof Psycopg2Cursor and
  edges(source.getNode(), sink.getNode()) and
  not exists(SafeQueryPattern safe | DataFlow::localFlow(source.getNode(), safe))
select sink, source,
  "Possible SQL injection via string concatenation in psycopg2 query",
  source, "Source"
================================================================================
