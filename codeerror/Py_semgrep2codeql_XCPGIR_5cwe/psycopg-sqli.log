/**
 * @id psycopg-sqli
 * @kind path-problem
 * @severity WARNING
 * @name Psycopg2 SQL Injection
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @tags security, external/cwe/cwe-089
 * @precision high
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class Psycopg2SqlInjection extends TaintTracking::Configuration {
  Psycopg2SqlInjection() {
    this = "Psycopg2 SQL Injection"
  }

  override predicate isSource(TaintTracking::TaintSource source) {
    // USER_INPUT source: non-literal expressions
    not source.getExpr().isConstant()
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    // SQL_EXECUTION sink: psycopg2 cursor execution methods
    exists(Call call |
      call.getMethodName().matches("%execute%") or
      call.getMethodName() = "mogrify" and
      exists(DataFlow::ModuleImport mi |
        mi.getName() = "psycopg2" and
        mi.getImportExpr().getType().getName() = "Cursor"
      ) and
      sink.getExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    // Exclude cases using proper parameterization or SQL construction
    exists(Call call |
      call.getMethodName() = "replace" and
      sanitizer.getExpr() = call
    ) or
    exists(Import imp |
      imp.getImportedName() = "SQL" and
      imp.getModuleName() = "psycopg2.sql"
    )
  }

  override predicate isAdditionalTaintStep(TaintTracking::TaintSource node1, TaintTracking::TaintSink node2) {
    // CONCAT_PROPAGATION: taint propagation through string operations
    TaintTracking::localTaintStep(node1, node2)
  }
}

