Rule Content:
/**
 * @name psycopg-sqli
 * @description Detects string concatenation with non-literal variables in psycopg2 SQL statements,
 *              which could lead to SQL injection if the variable is user-controlled.
 * @kind path-problem
 * @problem.severity warning
 * @id py/psycopg2-sqli
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.Concepts
import DataFlow::PathGraph

class Psycopg2Call extends DataFlow::Node {
  Psycopg2Call() {
    exists(FunctionValue func, Call c |
      func.hasName(["execute", "executemany", "mogrify"]) and
      c.getFunc() = func and
      func.getDeclaringType().hasQualifiedName("psycopg2", "Cursor") and
      this.asExpr() = c.getArg(1)
    )
  }
}

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(Expr e |
      (e instanceof Name or e instanceof Call or e instanceof Parameter) and
      not e.isConstant() and
      this.asExpr() = e
    )
  }
  
  override predicate isSource() { true }
}

class StringConcatenation extends DataFlow::Node {
  StringConcatenation() {
    exists(BinaryExpr b |
      b.getOp() = "+" and
      (this.asExpr() = b.getLeft() or this.asExpr() = b.getRight())
    )
    or
    exists(Call c |
      c.getFunc().(Name).getId() = "format" and
      this.asExpr() = c.getArg(_)
    )
  }
}

class SafeQuery extends DataFlow::Node {
  SafeQuery() {
    exists(Call c |
      c.getFunc().(Name).getId() = "SQL" and
      c.getDecorator().getDeclaringType().hasQualifiedName("psycopg2.sql", "SQL") and
      this.asExpr() = c.getArg(_)
    )
    or
    exists(StringLiteral s |
      s.getStringValue().regexpMatch("%[sdf]") and
      this.asExpr() = s
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(UserInput input | 
    exists(StringConcatenation concat |
      DataFlow::localFlow(input, concat) and
      DataFlow::localFlow(concat, sink.getNode())
    )
  ) and
  sink.getNode() instanceof Psycopg2Call and
  not exists(SafeQuery safe | DataFlow::localFlow(source.getNode(), safe))
select sink, source,
  "Possible SQL injection via string concatenation in psycopg2 query",
  source, "Source"
