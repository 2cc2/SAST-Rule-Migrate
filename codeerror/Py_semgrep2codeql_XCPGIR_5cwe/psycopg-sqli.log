Rule Content:
/**
 * @id psycopg-sqli
 * @kind path-problem
 * @severity WARNING
 * @name Psycopg2 SQL Injection
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @tags security, external/cwe/cwe-089
 * @precision high
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class Psycopg2SqlInjection extends TaintTracking::Configuration {
  Psycopg2SqlInjection() {
    this = "Psycopg2 SQL Injection"
  }

  override predicate isSource(DataFlow::Node source) {
    // USER_INPUT source: non-literal expressions
    not source.asExpr().isConstant()
  }

  override predicate isSink(DataFlow::Node sink) {
    // SQL_EXECUTION sink: psycopg2 cursor execution methods
    exists(Call call |
      call.getCalleeName().matches("%execute%") or
      call.getCalleeName() = "mogrify" and
      exists(ModuleImport mi |
        mi.getName() = "psycopg2" 
      ) and
      sink.asExpr() = call.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    // Exclude cases using proper parameterization or SQL construction
    exists(Call call |
      call.getCalleeName() = "replace" and
      node.asExpr() = call
    ) or
    exists(Import imp |
      imp.getImportedName() = "SQL" and
      imp.getModule().getName() = "psycopg2.sql"
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // CONCAT_PROPAGATION: taint propagation through string operations
    TaintTracking::localTaintStep(node1, node2)
  }
}

from Psycopg2SqlInjection config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches SQL execution without proper sanitization", source.getNode(),
  sink.getNode(), "Potential SQL injection vulnerability"
