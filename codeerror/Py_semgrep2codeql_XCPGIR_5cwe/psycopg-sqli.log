Rule Content:
/**
 * @name psycopg-sqli
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/psycopg2-sqli
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.Concepts

class Psycopg2Cursor extends Call {
  Psycopg2Cursor() {
    exists(Method m, Value receiver |
      m.hasName(["execute", "executemany", "mogrify"]) and
      this.getTarget() = m and
      receiver.getType().hasQualifiedName("psycopg2", "Cursor") and
      this.getReceiver() = receiver
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(VariableAccess va |
      va = this.asExpr() and
      not va.getVariable().isLiteral()
    )
    or
    exists(Parameter p |
      p = this.asParameter() and
      not p.getDefault().isLiteral()
    )
    or
    exists(Call c |
      c = this.asExpr() and
      not c.isLiteral()
    )
  }
}

class StringConcat extends DataFlow::Node {
  StringConcat() {
    exists(Expr lhs, Expr rhs |
      (this.asExpr() = lhs or this.asExpr() = rhs) and
      exists(BinaryOperation binop |
        binop.getOperator() = "+" and
        binop.getLeftOperand() = lhs and
        binop.getRightOperand() = rhs
      )
    )
    or
    exists(Call c |
      c.getTarget().getName() = "format" and
      this.asExpr() = c.getAnArgument()
    )
    or
    exists(FString f |
      this.asExpr() = f and
      exists(Interpolation i | i.getValue() = this.asExpr())
    )
  }
}

class SafeQueryPattern extends DataFlow::Node {
  SafeQueryPattern() {
    exists(Call c |
      c.getTarget().getName() = "SQL" and
      c.getTarget().getDeclaringType().hasQualifiedName("psycopg2.sql", "SQL") and
      this.asExpr() = c.getAnArgument()
    )
    or
    exists(StringLiteral l |
      l.getValue().regexpMatch("%[sdf]") and
      this.asExpr() = l
    )
  }
}

query predicate edges(DataFlow::Node source, DataFlow::Node sink) {
  exists(StringConcat sc | DataFlow::localFlow(source, sc) and DataFlow::localFlow(sc, sink))
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(Psycopg2Cursor pc | sink.getNode() = pc and sink.asDef() = pc.getArgument(1)) and
  edges(source.getNode(), sink.getNode()) and
  not exists(SafeQueryPattern sqp | DataFlow::localFlow(source.getNode(), sqp))
select sink, source,
  "Possible SQL injection via string concatenation in psycopg2 query",
  source, sink
