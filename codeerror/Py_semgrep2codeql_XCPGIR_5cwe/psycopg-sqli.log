Rule Content:
/**
 * @name psycopg-sqli
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/psycopg2-sqli
 */

import python
import semmle.python.security.injection.SQL
import semmle.python.Concepts
import DataFlow::PathGraph

class Psycopg2Cursor extends Call {
  Psycopg2Cursor() {
    exists(Value receiver |
      this.getTarget().getName() in ["execute", "executemany", "mogrify"] and
      receiver.getType().getQualifiedName() = "psycopg2.Cursor" and
      receiver = this.getReceiver()
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(LocalVariableAccess va |
      va = this.asExpr() and
      not va.getNode().isLiteral()
    )
    or
    exists(Parameter p |
      p = this.asParameter() and
      not p.getDefaultValue().isLiteral()
    )
    or
    exists(Call c |
      c = this.asExpr() and
      not c.getNode().isLiteral()
    )
  }
}

class StringConcat extends DataFlow::Node {
  StringConcat() {
    exists(BinaryOperation binop |
      binop.getOperator() = "+" and
      (binop.getLeftOperand() = this.asExpr() or binop.getRightOperand() = this.asExpr())
    )
    or
    exists(Call c |
      c.getTarget().getName() = "format" and
      this.asExpr() = c.getAnArgument()
    )
  }
}

class SafeQueryPattern extends DataFlow::Node {
  SafeQueryPattern() {
    exists(Call c |
      c.getTarget().getName() = "SQL" and
      c.getNode().getQualifiedName() = "psycopg2.sql.SQL" and
      c.getAnArgument() = this.asExpr()
    )
    or
    exists(Literal l |
      l.getValue().matches("%s") and
      l = this.asExpr()
    )
  }
}

query predicate edges(DataFlow::Node source, DataFlow::Node sink) {
  exists(StringConcat sc | DataFlow::localFlow(source, sc) and DataFlow::localFlow(sc, sink))
}

from UserInputSource source, DataFlow::Node sink, PathNode sourceNode, PathNode sinkNode
where 
  exists(Psycopg2Cursor pc | sinkNode.asNode() = pc and sink = pc.getArgument(1)) and
  edges(source, sink) and
  not exists(SafeQueryPattern sqp | DataFlow::localFlow(source, sqp))
select sinkNode, sourceNode, 
  "Possible SQL injection via string concatenation in psycopg2 query", sourceNode, sinkNode
