```yaml
xcpgir_version: "1.0"
rule:
  id: psycopg-sqli
  kind: taint
  severity: WARNING
  message: "Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement. This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
scope:
  languages: [python]
  frameworks: ["psycopg2"]
sources:
  - id: USER_INPUT
    match:
      node: LOCAL | PARAM | CALL
      where:
        - op: neq
          left: isLiteral
          right: true
sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: { type: psycopg2.Cursor, method: execute }
      arg_index: 1
    match:
      node: CALL
      api: { type: psycopg2.Cursor, method: executemany }
      arg_index: 1
    match:
      node: CALL
      api: { type: psycopg2.Cursor, method: mogrify }
      arg_index: 1
sanitizers:
  - id: PARAMETERIZED_QUERY
    match:
      node: CALL
      where:
        - op: regex
          left: code
          right: "%[sdf]|format\(|f'.*\{\}.*'"
barriers: []
propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint
flows:
  - source: USER_INPUT
    sink: SQL_EXEC
    through: [STRING_CONCAT*]
    constraints:
      path:
        must_not:
          - pattern: "CALL(psycopg2.sql.SQL)"
          - pattern: "LITERAL(%s)"
report:
  message: "Possible SQL injection via string concatenation in psycopg2 query"
  locations: ["source", "sink"]
  evidence:
    capture:
      - argument: 1
tests:
  positive:
    - "cur.execute('SELECT * FROM table WHERE id = ' + user_input)"
  negative:
    - "cur.execute('SELECT * FROM table WHERE id = %s', (user_input,))"
```
