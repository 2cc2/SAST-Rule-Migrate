Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 *              This could allow SSRF (Server-Side Request Forgery) vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import python
import semmle.python.web.flask
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.PathGraph
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call ma |
      ma.getCallee().getName() = "get" and
      ma.getReceiver().getType().toString() = "flask.Request.args"
      and
      this = ma
    ) or
    exists(Function f, Parameter p |
      p = f.getAParameter() and
      exists(f.getAValue() | hasQualifiedName("flask", "route"))
      and
      this = p
    )
  }
  
  override predicate asCfgNode() { result = this.getLocation().getCfgNode() }
  override predicate getLocation() { result = this.getLocation() }
  override predicate getBasicBlock() { result = this.getBasicBlock() }
  override predicate toString() { result = this.toString() }
  override predicate getScope() { result = this.getScope() }
  override predicate asVariable() { result = this.asVariable() }
}

class UrlFormatSink extends DataFlow::Node {
  UrlFormatSink() {
    exists(StringLiteral str |
      str.getStringValue().regexpMatch(".*://$") and
      exists(str.getParent() | 
        (result.toString() = "%s" or result.toString() = "%r")
      )
      and
      this = str
    )
  }
  
  override predicate asCfgNode() { result = this.getLocation().getCfgNode() }
  override predicate getLocation() { result = this.getLocation() }
  override predicate getBasicBlock() { result = this.getBasicBlock() }
  override predicate toString() { result = this.toString() }
  override predicate getScope() { result = this.getScope() }
  override predicate asVariable() { result = this.asVariable() }
}

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrlFormatSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StrFormatOperation fmt |
      fmt.getAnOperand() = pred and
      succ = fmt
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedUrlHostConfig cfg
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
       "User data flows into the host portion of this manually-constructed URL.", 
       source.getNode(), 
       "Potentially tainted data originates here"
