Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 *              This could allow SSRF (Server-Side Request Forgery) vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import python
import semmle.python.web.flask.Request
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call ma |
      exists(FunctionValue fv |
        fv = ma.getCalleeValue() and
        fv.getName() = "get" and
        ma.getReceiver().getType().getName() = "Request.args"
      ) and
      this.asExpr() = ma
    ) or
    exists(Function f, Parameter p |
      p = f.getParameter(_) and
      exists(f.getADecorator() |
        getValue().getQualifiedName() = "flask.route"
      ) and
      this.asParameter() = p
    )
  }
  
  override predicate hasLocationInfo() { result = true }
  override string getAPrimaryQlClass() { result = "Source" }
}

class UrlFormatSink extends DataFlow::Node {
  UrlFormatSink() {
    exists(StringLiteral str |
      str.getValue().matches("%.*://$") and
      exists(Call c |
        c = str.getParent+() and
        (c.getArgument(0).toString() = "%s" or c.getArgument(0).toString() = "%r")
      ) and
      this.asExpr() = str
    )
  }
  
  override predicate hasLocationInfo() { result = true }
  override string getAPrimaryQlClass() { result = "Sink" }
}

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrlFormatSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Python::StringFormatOperation fmt |
      fmt.getAnOperand() = pred and
      succ.asExpr() = fmt
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedUrlHostConfig cfg
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
       "User data flows into the host portion of this manually-constructed URL.", 
       source.getNode(), 
       "Potentially tainted data originates here"
