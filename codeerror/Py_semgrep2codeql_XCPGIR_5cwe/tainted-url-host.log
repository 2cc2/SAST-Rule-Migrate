import python
import python.frameworks.flask
import python.StringManipulation
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call ma |
      ma.getFunc().hasName(["get_data", "args", "form", "values", "json"]) and
      ma.getQualifier().(Name).getId() = "request" and
      ma.getQualifier().getParentScope() instanceof flask.Request
    |
      this.asParameterNode() = ma.getAnArg() or
      this.asExpr() = ma
    )
  }

  override predicate asCfgNode() { none() }
  override DataFlow::Node getLocation() { result = this }
  override predicate getBasicBlock() { none() }
  override string toString() { result = "flask request source" }
  override ControlFlow::Scope getScope() { none() }
  override Variable asVariable() { none() }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getADecorator().getAValue().toString().matches("%route%") and
      p = f.getAParameter() and
      this.asParameterNode() = p
    )
  }

  override predicate asCfgNode() { none() }
  override DataFlow::Node getLocation() { result = this }
  override predicate getBasicBlock() { none() }
