```yaml
xcpgir_version: "1.0"
rule:
  id: tainted-url-host
  kind: taint
  severity: WARNING
  message: >-
    User data flows into the host portion of this manually-constructed URL.
    This could allow an attacker to send data to their own server, potentially
    exposing sensitive data such as cookies or authorization information sent
    with this request. They could also probe internal servers or other
    resources that the server running this code can access. (This is called
    server-side request forgery, or SSRF.) Do not allow arbitrary hosts.
    Instead, create an allowlist for approved hosts, or hardcode the correct host.
scope:
  languages: [python]
  frameworks: [flask]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: FLASK_REQUEST
    match:
      node: CALL
      api: { type: flask.request, method: $ANYTHING }
  - id: ROUTE_PARAM
    match:
      node: PARAM
      where:
        - op: inside
          left: $FUNC
          right: |-
            @$APP.route(...)
            def $FUNC(..., $ROUTEVAR, ...):
              ...

sinks:
  - id: URL_FORMAT
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: .*://$
        - op: or
          conditions:
            - { op: eq, left: $URLSTR, right: "%s" }
            - { op: eq, left: $URLSTR, right: "%r" }

propagations:
  - id: STRING_FORMAT
    edge: arg->param
    kind: taint

sanitizers: []

barriers: []

flows:
  - source: FLASK_REQUEST
    sink: URL_FORMAT
    constraints:
      path:
        must: [ { pattern: "LITERAL(.*://)" } ]

report:
  message: "User data flows into the host portion of this manually-constructed URL."
  locations: ["source","sink"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - '"http://%s" % flask.request.args.get("host")'
    - '"http://{}".format(flask.request.args.get("host"))'
  negative:
    - '"http://example.com"'
    - '"http://%s" % "example.com"'
```
