  override Variable asVariable() { none() }
}

class UrlHostSink extends DataFlow::Node {
  UrlHostSink() {
    exists(BinaryExpr b | 
      b.getOp() = "+" and
      b.getLeftOperand().toString().matches("%://.*") and
      this.asExpr() = b
    )
    or
    exists(FString s |
      s.toString().matches("%://%.*") and
      this.asExpr() = s
    )
    or
    exists(FormatString f |
      f.getStringValue().toString().matches("%://%") and
      this.asExpr() = f
    )
    or
    exists(AugAssign p |
      p.getTarget().toString().matches("%://.*") and
      this.asExpr() = p
    )
  }

  override predicate asCfgNode() { none() }
  override DataFlow::Node getLocation() { result = this }
  override predicate getBasicBlock() { none() }
  override string toString() { result = "URL host sink" }
  override ControlFlow::Scope getScope() { none() }
  override Variable asVariable() { none() }
}

class TaintedUrlHostFlow extends TaintTracking::Configuration {
  TaintedUrlHostFlow() { this = "TaintedUrlHostFlow" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof UrlHostSink
  }
}

