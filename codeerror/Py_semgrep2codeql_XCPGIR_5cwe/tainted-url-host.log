Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 *              This could allow SSRF (Server-Side Request Forgery) vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import python
import semmle.python.api.flask.Flask
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.DataFlow

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "get" and
      ma.getReceiver().getType().toString() = "flask.Request.args"
      and
      this = ma
    ) or
    exists(Parameter p |
      p.getFunction().getDeclaringModule().getFile().getAbsolutePath().matches("%app.py%") and
      p.getFunction().hasDecorator("route")
      and
      this = p
    )
  }
}

class UrlFormatSink extends DataFlow::Node {
  UrlFormatSink() {
    exists(StringLiteral str |
      str.getValue().regexpMatch(".*://$") and
      exists(DataFlow::Node arg | arg.asExpr() = str.getAnArgument() | 
        arg.getType().toString() = "str" and
        (arg.toString() = "%s" or arg.toString() = "%r")
      )
      and
      this = str
    )
  }
}

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrlFormatSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringFormatOperation fmt |
      fmt.getAnOperand() = pred.asExpr() and
      succ.asExpr() = fmt
    )
  }
}

from TaintedUrlHostConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
       "User data flows into the host portion of this manually-constructed URL.", 
       source.getNode(), 
       "Potentially tainted data originates here"
