import python
import semmle.python.web.flask
import semmle.python.dataflow.TaintTracking
import semmle.python.StringManipulation

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["get_data", "args", "form", "values", "json"]) and
      ma.getReceiver().(Name).getId() = "request" and
      ma.getReceiver().getParentScope() instanceof flask.Request
    |
      this.asParameter() = ma.getAnArgument() or
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getADecorator().getAValue().toString().matches("%route%") and
      p = f.getAParameter() and
      this.asParameter() = p
    )
  }
}

class UrlHostSink extends DataFlow::Node {
  UrlHostSink() {
    exists(BinaryExpr b | 
      b.getOp() = "+" and
      b.getLeftOperand().toString().matches("%://.*") and
      this.asExpr() = b
    )
    or
    exists(FString s |
      s.toString().matches("%://%.*") and
      this.asExpr() = s
    )
    or
    exists(StrFormat f |
      f.getStringValue().toString().matches("%://%") and
      this.asExpr() = f
    )
    or
    exists(AugAssign p |
      p.getTarget().toString().matches("%://.*") and
      this.asExpr() = p
    )
  }
}

class TaintedUrlHostFlow extends TaintTracking::Configuration {
  TaintedUrlHostFlow() { this = "TaintedUrlHostFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrlHostSink
  }
}

