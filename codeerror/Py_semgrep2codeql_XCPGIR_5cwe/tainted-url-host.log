Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL. This could allow an attacker to send data to their own server, potentially exposing sensitive data such as cookies or authorization information sent with this request. They could also probe internal servers or other resources that the server running this code can access. (This is called server-side request forgery, or SSRF.) Do not allow arbitrary hosts. Instead, create an allowlist for approved hosts, or hardcode the correct host.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Flask
import semmle.python.Concepts
import semmle.python.StringManipulation
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["get_data", "args", "form", "values", "json"]) and
      ma.getQualifier().(Name).getId() = "request" and
      ma.getQualifier().getParentScope() instanceof FlaskRequest
    |
      this.asParameter() = ma.getAnArgument() or
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getADecorator().getValue().toString().matches("%route%") and
      p = f.getAParameter() and
      this.asParameter() = p
    )
  }
}

class UrlHostSink extends DataFlow::Node {
  UrlHostSink() {
    exists(DataFlow::BinaryExpr b | 
      b.getOp() = "+" and
      b.getLeftOperand().toString().matches("%://.*") and
      this.asExpr() = b
    )
    or
    exists(StrFormat s |
      s.getFString().toString().matches("%://%.*") and
      this.asExpr() = s
    )
    or
    exists(FormatStringOperation f |
      f.getStringValue().toString().matches("%://%") and
      this.asExpr() = f
    )
    or
    exists(PlusAssign p |
      p.getLeftOperand().toString().matches("%://.*") and
      this.asExpr() = p
    )
  }
}

class TaintedUrlHostFlow extends TaintTracking::Configuration {
  TaintedUrlHostFlow() { this = "TaintedUrlHostFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrlHostSink
  }
}

from TaintedUrlHostFlow cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "User data flows into the host portion of this manually-constructed URL.", source, sink,
  "User-controlled data may flow into URL host construction, which could lead to SSRF (Server-Side Request Forgery)."
