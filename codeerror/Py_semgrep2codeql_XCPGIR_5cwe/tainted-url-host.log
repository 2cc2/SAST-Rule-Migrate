xcpgir_version: "1.0"
rule:
  id: tainted-url-host
  kind: taint
  severity: WARNING
  message: "User data flows into the host portion of this manually-constructed URL. This could allow an attacker to send data to their own server, potentially exposing sensitive data such as cookies or authorization information sent with this request. They could also probe internal servers or other resources that the server running this code can access. (This is called server-side request forgery, or SSRF.) Do not allow arbitrary hosts. Instead, create an allowlist for approved hosts, or hardcode the correct host."
scope:
  languages: [python]
  frameworks: [flask]
sources:
  - id: FLASK_REQUEST
    match:
      node: CALL
      api: { type: flask.request, method: $ANYTHING }
  - id: ROUTE_PARAM
    match:
      node: PARAM
      where:
        - op: regex
          left: name
          right: "^ROUTEVAR"
sinks:
  - id: URL_CONSTRUCTION
    match:
      node: CALL
      where:
        - op: regex
          left: code
          right: ".*SCHEME://.*"
propagations:
  - id: STRING_FORMAT
    edge: arg->param
    kind: taint
flows:
  - source: FLASK_REQUEST
    sink: URL_CONSTRUCTION
    through: [STRING_FORMAT*]
  - source: ROUTE_PARAM
    sink: URL_CONSTRUCTION
    through: [STRING_FORMAT*]
report:
  message: "User data flows into the host portion of this manually-constructed URL."
  locations: ["source", "sink", "path"]
  evidence: {}
tests:
  positive:
    - '@app.route("/") \n def index(param): \n     url = "http://" + param'
  negative:
    - '@app.route("/") \n def index(param): \n     url = "http://example.com"'
```
