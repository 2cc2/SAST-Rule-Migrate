  - id: FLASK_REQUEST
    match:
      node: CALL
      api: { type: flask.request, method: $ANYTHING }
    
  - id: ROUTE_PARAM
    match:
      node: PARAM
      where:
        - op: pattern-inside
          left: ""
          right: "@$APP.route(...)\ndef $FUNC(..., $ROUTEVAR, ...):\n  ..."

sinks:
  - id: URL_HOST_CONCAT
    match:
      node: CALL
      where:
        - op: pattern-either
          left: ""
          right: |
            [
              ["\"$URLSTR\" % ...", {"$URLSTR": "$SCHEME://%s"}],
              ["\"$URLSTR\".format(...)", {"$URLSTR": "$SCHEME:// { ... }"}],
              ["\"$URLSTR\" + ...", {"$URLSTR": ".*://$"}],
              ["f\"$URLSTR{...}...\"", {"$URLSTR": ".*://$"}],
              ["$URL += ...", {"$URLSTR": ".*://$"}]
            ]

propagations:
  - id: DATA_FLOW
    edge: arg->param
    kind: taint

flows:
  - source: FLASK_REQUEST
    sink: URL_HOST_CONCAT
    through: [DATA_FLOW*]
  
  - source: ROUTE_PARAM
    sink: URL_HOST_CONCAT
    through: [DATA_FLOW*]

report:
  message: "User data flows into the host portion of this manually-constructed URL."
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }
