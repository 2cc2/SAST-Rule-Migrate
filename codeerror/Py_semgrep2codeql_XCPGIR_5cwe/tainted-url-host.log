Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL. This could allow an attacker 
 * to send data to their own server, potentially exposing sensitive data such as cookies or authorization 
 * information sent with this request. They could also probe internal servers or other resources that the server 
 * running this code can access. (This is called server-side request forgery, or SSRF.) Do not allow arbitrary 
 * hosts. Instead, create an allowlist for approved hosts, or hardcode the correct host.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-url-host
 * @precision high
 */

import python
import semmle.python.security.strings.TaintedStrings
import semmle.python.web.flask.FlashRequest

class FlaskRequestSource extends TaintedString::Source {
  FlaskRequestSource() {
    // Source: Flask request parameters
    exists(MethodAccess ma |
      ma.getTarget().hasQualifiedName("flask", "request") and
      this = ma.getAnArgument()
    ) or
    // Source: Route parameters with name matching ROUTEVAR*
    exists(Parameter p | 
      p.getName().matches("%ROUTEVAR%") and
      this = p.getAnAccess()
    )
  }
}

class ManualUrlConstructionSink extends TaintedString::Sink {
  ManualUrlConstructionSink() {
    // Sink: Manual URL construction with dynamic host
    exists(MethodAccess urlConstr |
      urlConstr.getTarget().hasName("format") and
      urlConstr.getArgument(0).toString().matches("%://%") and
      this = urlConstr.getAnArgument()
    ) or
    exists(StringLiteral s |
      s.getStringValue().matches("%://%") and
      this = s.getAChildExpr()
    )
  }
}

query predicate flows(TaintedString::Source src, TaintedString::Sink sink) {
  TaintedString::flowPath(src, sink)
}

from FlaskRequestSource src, ManualUrlConstructionSink sink
where flows(src, sink)
select sink, "User data flows into the host portion of this manually-constructed URL.", 
  src, "User input", sink, "URL construction"
