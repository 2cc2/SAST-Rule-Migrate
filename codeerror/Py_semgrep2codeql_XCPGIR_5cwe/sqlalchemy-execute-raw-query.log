Rule Content:
/**
 * @name SQLAlchemy raw query execution
 * @description Detects SQL injection vulnerabilities when raw SQL queries are concatenated with untrusted input in SQLAlchemy
 * @kind path-problem
 * @problem.severity error
 * @id python/sqlalchemy-injection-raw-query
 */

import python
import semmle.python.dataflow.ExternalFlow
import semmle.python.ApiGraphs
import semmle.python.Concepts
import DataFlow::PathGraph

class SqlStringConcatSource extends DataFlow::Node {
  SqlStringConcatSource() {
    exists(MethodCall call |
      call.getMethodName() = "execute" and
      (
        call.getArg(0).getText().matches("%\\+%") or               // String concatenation
        call.getArg(0).getText().matches("%\\%.*%") or             // % operator formatting
        call.getArg(0).getText().matches("%\\.format\\(.*\\)%") or // format method
        call.getArg(0).getText().matches("%f\".*\\{.*\\}.*\"%")    // f-string
      ) and
      isSourceNode(call.getArg(0))
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodCall call |
      call.getMethodName() = "execute" and
      call.getReceiver().getType().getName() = "Engine" and
      isSinkNode(call.getArg(0))
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodCall call |
      call.getMethodName() = "text" and
      call.getReceiver().getType().getName() = "sqlalchemy" and
      isSanitizerNode(call)
    )
  }
}

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlStringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

from SqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential SQL injection via string concatenation in SQLAlchemy execute(). Use prepared statements instead."
