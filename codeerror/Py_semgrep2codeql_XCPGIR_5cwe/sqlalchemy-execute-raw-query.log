/**
 * @name SQLAlchemy raw SQL execution with unsafe string concatenation
 * @description Detects SQL injection vulnerabilities caused by unsafe string
 *              concatenation in SQLAlchemy raw SQL queries.
 * @kind path-problem
 * @problem.severity error
 * @id python/sql-injection/sqlalchemy-execute-raw-query
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import DataFlow::PathGraph
import TaintTracking::PathGraph

class UnsafeStringConcatenation extends TaintTracking::AdditionalTaintStep {
  UnsafeStringConcatenation() {
    exists(Call call |
      call.getFunc().getName().regexpMatch(".*(add|format|mod|__format__)") and
      this = call.getArgument(0)
    )
  }

  override predicate isSource() { this instanceof UnsafeStringConcatenation }
}

class SqlAlchemyExecuteCall extends TaintTracking::AdditionalTaintStep {
  SqlAlchemyExecuteCall() {
    exists(Call call |
      call.getReceiver().getType().hasQualifiedName("sqlalchemy.engine.base", "Connection") and
      call.getFunc().getName() = "execute" and
      this = call.getArgument(0)
    )
  }

  override predicate isSink() { this instanceof SqlAlchemyExecuteCall }
}

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeStringConcatenation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlAlchemyExecuteCall
  }
}

from DataFlow::Node source, DataFlow::Node sink
where 
  any(SqlInjectionConfig cfg).hasFlowPath(source, sink)
select sink, "User input reaches SQL execution via unsafe string concatenation", source, sink,
  "Potential SQL injection: $@ originates from $@",
  source, "unsafe string concatenation here",
  sink, "SQL execution here"
