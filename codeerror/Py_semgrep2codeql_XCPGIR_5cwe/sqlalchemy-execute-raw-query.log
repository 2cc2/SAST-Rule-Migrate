Rule Content:
/**
 * @name SQLAlchemy raw query execution
 * @description Detects SQL injection vulnerabilities when raw SQL queries are concatenated with untrusted input in SQLAlchemy
 * @kind path-problem
 * @problem.severity error
 * @id python/sqlalchemy-injection-raw-query
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking as TT
import semmle.python.dataflow.DataFlow

class SqlStringConcatSource extends TT::TaintSource {
  SqlStringConcatSource() {
    exists(DataFlow::CallNode call |
      call.getMethodName() = "execute" and
      (
        call.getArg(0).getText().matches("%\\+%") or               // String concatenation
        call.getArg(0).getText().matches("%\\%.*%") or             // % operator formatting
        call.getArg(0).getText().matches("%\\.format\\(.*\\)%") or // format method
        call.getArg(0).getText().matches("%f\".*\\{.*\\}.*\"%")    // f-string
      ) and
      this.asExpr() = call.getArg(0)
    )
  }

  override predicate sinks(TT::TaintKind taint) { taint = TT::StringConcatenationTaint }
}

class SqlExecutionSink extends TT::TaintSink {
  SqlExecutionSink() {
    exists(DataFlow::CallNode call |
      call.getMethodName() = "execute" and
      call.getReceiver().getType().getName().matches("%sqlalchemy%.engine%") and
      this.asExpr() = call.getArg(0)
    )
  }

  override predicate sinks(TT::TaintKind taint) { taint = TT::SqlInjectionTaint }
}

class PreparedStatementSanitizer extends TT::Sanitizer {
  PreparedStatementSanitizer() {
    exists(DataFlow::CallNode call |
      call.getMethodName() = "text" and
      call.getReceiver().getType().getName().matches("%sqlalchemy%") and
      this.asExpr() = call
    )
  }

  override predicate sanitizes(TT::Taint taint) { taint = this }
}

class SqlInjectionConfig extends TT::TaintTrackingConfiguration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(TT::TaintSource source) {
    source instanceof SqlStringConcatSource
  }

  override predicate isSink(TT::TaintSink sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(TT::Sanitizer sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

from SqlInjectionConfig config, TT::TaintSource source, TT::TaintSink sink
where config.hasFlow(source, sink)
select sink, 
  "Potential SQL injection via string concatenation in SQLAlchemy execute(). Use prepared statements instead.",
  source, "String concatenation here",
  sink, "SQL execution here"
================================================================================
