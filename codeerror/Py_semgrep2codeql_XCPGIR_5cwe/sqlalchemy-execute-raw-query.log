Rule Content:
/**
 * @name SQLAlchemy raw query execution
 * @description Detects SQL injection vulnerabilities when raw SQL queries are concatenated with untrusted input in SQLAlchemy
 * @kind path-problem
 * @problem.severity error
 * @id python/sqlalchemy-injection-raw-query
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking as TaintTracking
import semmle.python.dataflow.internal.DataFlowNodeImpl

class SqlStringConcatSource extends TaintTracking::TaintSource {
  SqlStringConcatSource() {
    exists(DataFlowNodeImpl::MethodCallNode call |
      call.getMethodName() = "execute" and
      (
        call.getArg(0).getText().matches("%\\+%") or               // String concatenation
        call.getArg(0).getText().matches("%\\%.*%") or             // % operator formatting
        call.getArg(0).getText().matches("%\\.format\\(.*\\)%") or // format method
        call.getArg(0).getText().matches("%f\".*\\{.*\\}.*\"%")    // f-string
      ) and
      this = call.getArg(0)
    )
  }

  override predicate isSourceOf(TaintTracking::Taint t) { t = this }
}

class SqlExecutionSink extends TaintTracking::TaintSink {
  SqlExecutionSink() {
    exists(DataFlowNodeImpl::MethodCallNode call |
      call.getMethodName() = "execute" and
      call.getReceiver().getType().getName() = "sqlalchemy.engine.base.Engine" and
      this = call.getArg(0)
    )
  }

  override predicate isSinkFor(TaintTracking::Taint t) { t = this }
}

class PreparedStatementSanitizer extends TaintTracking::Sanitizer {
  PreparedStatementSanitizer() {
    exists(DataFlowNodeImpl::MethodCallNode call |
      call.getMethodName() = "text" and
      call.getReceiver().getType().getName() = "sqlalchemy" and
      this = call.getResult()
    )
  }

  override predicate sanitizes(TaintTracking::Taint t) { t = this }
}

class SqlInjectionConfig extends TaintTracking::TaintTrackingConfiguration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof SqlStringConcatSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

from SqlInjectionConfig config, TaintTracking::TaintSource source, TaintTracking::TaintSink sink
where config.hasFlow(source, sink)
select sink, "Potential SQL injection via string concatenation in SQLAlchemy execute(). Use prepared statements instead."
