Rule Content:
/**
 * @name SQLAlchemy raw SQL execution with unsafe string concatenation
 * @description Detects SQL injection vulnerabilities caused by unsafe string
 *              concatenation in SQLAlchemy raw SQL queries.
 * @kind path-problem
 * @problem.severity error
 * @id python/sql-injection/sqlalchemy-execute-raw-query
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class UnsafeStringConcatenation extends DataFlow::Node {
  UnsafeStringConcatenation() {
    exists(Call call |
      call.getMethodName().regexpMatch(".*(add|format|mod|__format__)") and
      result.asExpr() = call.getAnArgument()
    )
  }
}

class SqlAlchemyExecuteCall extends DataFlow::Node {
  SqlAlchemyExecuteCall() {
    exists(MethodCall call |
      call.getReceiverType().hasQualifiedName("sqlalchemy.engine.base", "Connection") and
      call.getMethodName() = "execute" and
      result.asExpr() = call.getArgument(0)
    )
  }
}

predicate isTaintedPath(DataFlow::Node source, DataFlow::Node sink) {
  exists(DataFlow::PathNode src, DataFlow::PathNode snk |
    source = src.getNode() and
    sink = snk.getNode() and
    DataFlow::localFlow(src, snk) and
    TaintTracking::localTaint(src, snk)
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink, UnsafeStringConcatenation concat,
    SqlAlchemyExecuteCall execute
where
  isTaintedPath(source.getNode(), sink.getNode()) and
  concat.getNode() = source.getNode() and
  execute.getNode() = sink.getNode()
select sink, "User input reaches SQL execution via unsafe string concatenation", source, sink,
  "Potential SQL injection: $@ originates from $@",
  source.getNode(), "unsafe string concatenation here",
  sink.getNode(), "SQL execution here"
