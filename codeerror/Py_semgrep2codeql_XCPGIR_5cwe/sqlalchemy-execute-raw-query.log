Rule Content:
/**
 * @name SQLAlchemy raw SQL execution with unsafe string concatenation
 * @description Detects SQL injection vulnerabilities caused by unsafe string
 *              concatenation in SQLAlchemy raw SQL queries.
 * @kind path-problem
 * @problem.severity error
 * @id python/sql-injection/sqlalchemy-execute-raw-query
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class UnsafeStringConcatenation extends DataFlow::Node {
  UnsafeStringConcatenation() {
    exists(Expr::Call call |
      call.getCalleeName().regexpMatch(".*(add|format|mod|__format__)") and
      this.asExpr() = call.getArg(0)
    )
  }
}

class SqlAlchemyExecuteCall extends DataFlow::Node {
  SqlAlchemyExecuteCall() {
    exists(Expr::Call call |
      call.getReceiverType().hasQualifiedName("sqlalchemy.engine.base", "Connection") and
      call.getCalleeName() = "execute" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeStringConcatenation
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlAlchemyExecuteCall
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    none()
  }
}

from DataFlow::Node source, DataFlow::Node sink, SqlInjectionConfig cfg
where 
  cfg.hasFlowPath(source, sink)
select sink, "User input reaches SQL execution via unsafe string concatenation", 
  source, sink,
  "Potential SQL injection: $@ originates from $@",
  source, "unsafe string concatenation here",
  sink, "SQL execution here"
