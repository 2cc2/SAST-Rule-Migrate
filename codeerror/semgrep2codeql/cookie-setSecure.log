Rule Content:
/**
 * @name Insecure Cookie setSecure
 * @description Default session middleware settings: `setSecure` not set to true. This
 *              ensures that the cookie is sent only over HTTPS to prevent cross-site
 *              scripting attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id java/cookie-setSecure
 * @tags security
 *       owasp/a03:2017
 *       owasp/a02:2021
 *       cwe/319
 * @precision low
 */

import java

from ConstructorCall cookieInit, MethodAccess setSecureCall, MethodAccess setSecureTrueCall
where
  cookieInit.getConstructor().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
  setSecureCall.getMethod().getName() = "setSecure" and
  setSecureCall.getArgument(0).(BooleanLiteral).getValue() = false and
  exists(setSecureTrueCall.getMethod() |
    setSecureTrueCall.getMethod().getName() = "setSecure" and
    setSecureTrueCall.getArgument(0).(BooleanLiteral).getValue() = true and
    setSecureTrueCall.getQualifier() = cookieInit.getQualifier()
  ) and
  setSecureCall.getQualifier() = cookieInit.getQualifier()
select setSecureCall, "Cookie.setSecure(false) should be set to true to ensure secure transmission over HTTPS.",
  setSecureCall.getLocation(),
  "This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks."
