/**
 * @name CRLF Injection in Logs
 * @description When data from an untrusted source is put into a logger and not neutralized correctly,
 *              an attacker could forge log entries or include malicious content.
 * @kind path-problem
 * @problem.severity warning
 * @id java/crlf-injection-logs
 * @tags security
 *       external/cwe/cwe-93
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class LoggerConfiguration extends TaintTracking::Configuration {
  LoggerConfiguration() { this = "LoggerConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(Expr e |
      e = source.asExpr() and
      exists(Call ma |
        ma = e.(Call) and
        ma.getCallee().hasName("getParameter") and
        ma.getQualifier().getType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Expr e |
      e = sink.asExpr() and
      exists(Call ma |
        ma = e.getEnclosingCall() and
        (
          ma.getCallee().getName().matches("trace|debug|info|warn|error") or
          (ma.getCallee().getName() = "log" and ma.getArgument(0).getType().hasQualifiedName("java.util.logging", "Level"))
        ) and
        (
          ma.getQualifier().getType().hasQualifiedName("org.apache.logging.log4j", "Logger") or
          ma.getQualifier().getType().hasQualifiedName("java.util.logging", "Logger")
        )
      )
    )
  }
}

