/**
 * @name CRLF Injection in Logs
 * @description When data from an untrusted source is put into a logger and not neutralized correctly,
 *              an attacker could forge log entries or include malicious content.
 * @kind problem
 * @problem.severity warning
 * @id java/crlf-injection-logs
 * @tags security
 *       external/cwe/cwe-93
 *       external/owasp/a03
 */
import java

// Define logger types
class Logger extends RefType {
  Logger() {
    this.hasQualifiedName("org.slf4j", "Logger") or
    this.hasQualifiedName("org.apache.logging.log4j", "Logger")
  }
}

// Define request types
class ServletRequest extends RefType {
  ServletRequest() {
    this.hasQualifiedName("javax.servlet", "ServletRequest") or
    this.hasQualifiedName("javax.servlet", "HttpServletRequest")
  }
}

// Find logger calls with request parameters
from MethodAccess logCall, Method getParam, string logLevel
where
  // Match logger method calls (info, warn, error, etc.)
  (logCall.getMethod().getName().matches("%log%") or logCall.getMethod().getName().matches("%info%") or
   logCall.getMethod().getName().matches("%warn%") or logCall.getMethod().getName().matches("%error%")) and
  logCall.getMethod().getDeclaringType() instanceof Logger and
  // Match request.getParameter() calls
  getParam.getDeclaringType() instanceof ServletRequest and
  getParam.getName() = "getParameter" and
  // Check if the request parameter flows into the logger call
  (getParam.getCaller() = logCall.getAnArgument() or getParam.getACall().getResult() = logCall.getAnArgument())
select logCall, "Potentially unsafe logging of HTTP request parameter, may be vulnerable to CRLF injection."
