/**
 * @name CRLF Injection in Logs
 * @description When data from an untrusted source is put into a logger and not neutralized correctly,
 *              an attacker could forge log entries or include malicious content.
 * @kind path-problem
 * @problem.severity warning
 * @id java/crlf-injection-logs
 * @tags security
 *       external/cwe/cwe-93
 *       external/owasp/a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import DataFlow::PathGraph

// Define logger types
class Logger extends RefType {
  Logger() {
    this.hasQualifiedName("org.slf4j", "Logger") or
    this.hasQualifiedName("org.apache.logging.log4j", "Logger")
  }
}

// Define logger methods as sinks
class LoggerMethod extends Method {
  LoggerMethod() {
    this.getDeclaringType() instanceof Logger and
    (
      this.getName().matches("%log%") or
      this.getName().matches("%info%") or
      this.getName().matches("%warn%") or
      this.getName().matches("%error%")
    )
  }
}

class CRLFInjectionLogsConfig extends TaintTracking::Config {
  CRLFInjectionLogsConfig() { this = "CRLFInjectionLogsConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "getParameter" and
      ma.getMethod().getDeclaringType() instanceof Servlets::ServletRequest and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCallee() instanceof LoggerMethod and
      sink.asExpr() = call.getArgument(0)
    )
  }
}

