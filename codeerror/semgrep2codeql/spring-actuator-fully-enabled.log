/**
 * @name Spring Actuator Fully Enabled
 * @description Spring Boot Actuator is fully enabled exposing sensitive endpoints such as /actuator/env, etc.
 *              Unless protected by Spring Security, this functionality is available without authentication,
 *              posing significant security risk.
 * @kind problem
 * @problem.severity error
 * @id java/spring-actuator-fully-enabled
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a01
 */

import java
import semmle.code.files.File
import semmle.code.files.FileContent

class SpringProperties extends File {
  SpringProperties() {
    this.getExtension() = "properties" and
    this.getBaseName().matches("%application%")
  }
}

class ManagementEndpointsConfig extends FileContent {
  string propertyContent
  
  ManagementEndpointsConfig() {
    this.getFile() instanceof SpringProperties and
    this.getContent().matches(".*management.endpoints.web.exposure.include\\s*=\\s*\\*.*") and
    this.propertyContent = this.getContent()
  }

  override string toString() {
    result = "Found sensitive actuator configuration in: " + this.getFile().getRelativePath()
  }
}

from ManagementEndpointsConfig config
select config, "Spring Boot Actuator is fully enabled. This exposes sensitive endpoints such as /actuator/env, " +
               "/actuator/logfile, /actuator/heapdump and others. Unless protected by Spring Security or another means, " +
               "these endpoints are available without authentication, causing significant security risk."
