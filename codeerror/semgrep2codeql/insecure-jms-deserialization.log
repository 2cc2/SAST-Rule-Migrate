Rule Content:
/**
 * @name Insecure JMS Deserialization
 * @description JMS Object messages depend on Java Serialization for marshalling/unmarshalling
 * of the message payload when ObjectMessage.getObject() is called.
 * Deserialization of untrusted data can lead to security flaws; a remote attacker
 * could via a crafted JMS ObjectMessage to execute
 * arbitrary code with the permissions of the application listening/consuming JMS
 * Messages.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.8
 * @precision medium
 * @id java/insecure-jms-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08:2017
 *       external/owasp/a08:2021
 *       external/cwe2022-top25
 *       external/cwe2021-top25
 */

import java
import semmle.code.java.dataflow.FlowSources
import DataFlow::PathGraph

class JMSMessageListener extends Class {
  JMSMessageListener() {
    this.implements("javax.jms.MessageListener") and
    this.getAMethod().hasName("onMessage")
  }
}

class GetObjectCall extends MethodAccess {
  GetObjectCall() {
    exists(Method m |
      m = this.getMethod() |
      m.getName() = "getObject" and
      m.getDeclaringType().getASupertype*().hasQualifiedName("javax.jms", "ObjectMessage")
    )
  }
}

from
  JMSMessageListener listener,
  Method onMessage,
  GetObjectCall getObjectCall,
  DataFlow::PathNode source,
  DataFlow::PathNode sink
where
  onMessage = listener.getAMethod().hasName("onMessage") and
  getObjectCall.getEnclosingCallable() = onMessage and
  TaintTracking::localTaint(source, sink, getObjectCall.getAnArgument()) and
  source.asExpr() = getObjectCall.getQualifier()
select
  getObjectCall,
  "Potential insecure JMS deserialization via ObjectMessage.getObject() call",
  source, sink,
  "This deserialization of untrusted data could lead to arbitrary code execution."
