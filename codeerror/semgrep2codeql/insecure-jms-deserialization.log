Rule Content:
/**
 * @name Insecure JMS deserialization
 * @description Detects unsafe deserialization via JMS ObjectMessage.getObject()
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/insecure-jms-deserialization
 * @tags security
 *       cwe/502
 *       owasp-a08
 *       external/cwe/cwe-502
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class JmsMessageListener extends Class {
  JmsMessageListener() {
    this.implements("javax.jms.MessageListener")
  }
}

class ObjectMessageGetObjectCall extends MethodAccess {
  ObjectMessageGetObjectCall() {
    exists(Method m | 
      m.getName() = "getObject" and
      this.getMethod() = m and
      m.getDeclaringType().hasQualifiedName("javax.jms", "ObjectMessage")
    )
  }
}

from
  JmsMessageListener listener,
  Method onMessageMethod,
  ObjectMessageGetObjectCall getObjectCall,
  DataFlow::Node source, DataFlow::Node sink
where
  onMessageMethod.getName() = "onMessage" and
  onMessageMethod.getDeclaringType() = listener and
  exists(DataFlow::PathNode path | 
    TaintTracking::localTaint(path, source, sink) and
    sink.asExpr() = getObjectCall and
    source.asParameter() = onMessageMethod.getParameter(0)
  )
select getObjectCall, 
  "JMS ObjectMessage.getObject() call may lead to insecure deserialization. " +
  "Deserialization of untrusted data can lead to arbitrary code execution."
