Rule Content:
/**
 * @name Path Traversal in HttpServletRequest
 * @description Detects potential path traversal vulnerabilities where user-controlled input
 *              from HttpServletRequest is used in file operations without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @id java/path-traversal-httpservlet
 * @tags security
 *       external/cwe/cwe-022
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 *       owasp-a05:2017
 *       owasp-a01:2021
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpServletRequestPathTraversalConfig extends TaintTracking::Configuration {
  HttpServletRequestPathTraversalConfig() { this = "HttpServletRequestPathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess cookieGetValue |
      // Source from HttpServletRequest
      source.asParameter() instanceof HttpServletRequestParameter
      or
      // Source from Cookie.getValue()
      cookieGetValue.getMethod().getName() = "getValue" and
      cookieGetValue.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      source.asExpr() = cookieGetValue
      or
      // Source from request parameter arrays
      exists(ArrayAccess arrayAccess |
        arrayAccess.getArray().getType() instanceof ArrayType and
        arrayAccess.getArray().getType().getElementType() instanceof TypeString and
        arrayAccess.getArray().getType().getElementType().hasUnderlyingType(string) and
        (arrayAccess.getArray() instanceof MethodAccess or
         arrayAccess.getArray() instanceof ParameterAccess) and
        source.asExpr() = arrayAccess
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess sanitizer |
      sanitizer.getMethod().hasQualifiedName("org.apache.commons.io", "FilenameUtils", "getName") and
      node.asExpr() = sanitizer
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall fileConstructor, ConstructorCall fileStreamConstructor |
      // Sinks for File operations
      (fileConstructor.getConstructedType().hasQualifiedName("java.io", "File") or
       fileStreamConstructor.getConstructedType().hasQualifiedName("java.io", "FileInputStream")) and
      (sink.asExpr() = fileConstructor.getAnArgument() or
       sink.asExpr() = fileStreamConstructor.getAnArgument())
    )
    or
    exists(VariableAccess fileVarAccess |
      fileVarAccess.getVariable().getType().hasQualifiedName("java.io", "File") and
      sink.asExpr() = fileVarAccess
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, HttpServletRequestPathTraversalConfig config
where config.hasFlow(source, sink)
select sink, "Potential path traversal vulnerability. User-controlled input from HttpServletRequest is used in file operation without proper sanitization."
