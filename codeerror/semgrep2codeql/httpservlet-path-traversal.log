import semmle.code.java.dataflow.FlowSources

class HttpServletRequestPathTraversalConfig extends TaintTracking::Configuration {
  HttpServletRequestPathTraversalConfig() { this = "HttpServletRequestPathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Expr cookieGetValue |
      // Source from HttpServletRequest
      source.asParameter() instanceof RemoteFlowSource
      or
      // Source from Cookie.getValue()
      cookieGetValue instanceof Method and
      cookieGetValue.(Method).getName() = "getValue" and
      cookieGetValue.(Method).getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      source.asExpr() = cookieGetValue
      or
      // Source from request parameter arrays
      exists(ArrayAccess arrayAccess |
        arrayAccess.getArray().getType() instanceof Array and
        arrayAccess.getArray().getType().(Array).getElementType().(RefType).hasName("String") and
        (arrayAccess.getArray() instanceof Method or
         arrayAccess.getArray().getType() instanceof Type) and
        source.asExpr() = arrayAccess
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Expr sanitizer |
      sanitizer instanceof Method and
      sanitizer.(Method).getMethod().hasQualifiedName("org.apache.commons.io", "FilenameUtils", "getName") and
      node.asExpr() = sanitizer
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall fileConstructor, ConstructorCall fileStreamConstructor |
      // Sinks for File operations
      (fileConstructor.getConstructedType().getUnderlyingType().hasName("File") or
       fileStreamConstructor.getConstructedType().getUnderlyingType().hasName("FileInputStream")) and
      (sink.asExpr() = fileConstructor.getAnArgument() or
       sink.asExpr() = fileStreamConstructor.getAnArgument())
    )
    or
    exists(Variable fileVar |
      fileVar.getType().getUnderlyingType().hasName("File") and
      sink.asExpr() = fileVar.getAnAccess()
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, HttpServletRequestPathTraversalConfig config
where config.hasFlow(source, sink)
select sink, "Potential path traversal vulnerability. User-controlled input from HttpServletRequest is used in file operation without proper sanitization."
