Rule Content:
/**
 * @name Use of SHA-224
 * @description This code uses a 224-bit hash function, which is deprecated or disallowed
 *              in some security policies. Consider updating to a stronger hash function such
 *              as SHA-384 or higher to ensure compliance and security.
 * @kind problem
 * @problem.severity warning
 * @precision high
 * @id java/use-of-sha224
 * @tags security
 *       owasp-a2
 *       owasp-a3
 *       cwe-328
 *       crypto
 */
import java

// Method calls patterns
from MethodAccess ma
where
  (ma.getMethod().hasName("getSha3_224Digest") or
   ma.getMethod().hasName("getSha512_224Digest") or
   ma.getMethod().hasName("sha3_224") or
   ma.getMethod().hasName("sha3_224Hex") or
   ma.getMethod().hasName("sha512_224") or
   ma.getMethod().hasName("sha512_224Hex")) and
  ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.codec.digest", "DigestUtils")
select ma, "Use of weak 224-bit hash function. Consider upgrading to SHA-384 or higher."

// Constructor patterns
from ConstructorCall cc
where
  cc.getConstructedType().hasQualifiedName("org.apache.commons.codec.digest", "DigestUtils") and
  (
    cc.getArgument(0).(CompileTimeConstantExpr).getStringValue() = "SHA_224" or
    cc.getArgument(0).(CompileTimeConstantExpr).getStringValue() = "SHA_512_224" or
    cc.getArgument(0).(CompileTimeConstantExpr).getStringValue() = "SHA3_224"
  )
select cc, "Use of weak 224-bit hash function. Consider upgrading to SHA-384 or higher."

// MessageDigest.getInstance patterns
from MethodAccess ma
where
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
  exists(Method m | m = ma.getMethod() | m.getNumberOfParameters() >= 1) and
  (
    ma.getArgument(0).(CompileTimeConstantExpr).getStringValue().matches("%224") or
    ma.getArgument(0).(CompileTimeConstantExpr).getStringValue().matches("%512_224")
  )
select ma, "Use of weak 224-bit hash function. Consider upgrading to SHA-384 or higher."
