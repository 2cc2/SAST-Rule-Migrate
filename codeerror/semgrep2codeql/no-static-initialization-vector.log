Rule Content:
/**
 * @name No Static Initialization Vector
 * @description Initialization Vectors (IVs) for block ciphers should be randomly generated
 *              each time they are used. Using a static IV means the same plaintext
 *              encrypts to the same ciphertext every time, weakening the strength
 *              of the encryption.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/no-static-initialization-vector
 * @tags security
 *       vulnerability
 *       cwe/329
 *       owasp/a02
 */

import java

// Pattern 1: Static IV declared in method
predicate isStaticIvInitialization(VariableDeclarator vd) {
  exists(ArrayCreation ac |
    vd.getInitializer() = ac and
    ac.getElementType() = Byte and
    vd.getInitializer().toString().regexpMatch("byte\\[\\]\\s*\\w+\\s*=\\s*\\{.*\\}")
  )
}

// Pattern 2: Static IV declared as class field
predicate isStaticIvField(Field f) {
  exists(ArrayCreation ac |
    f.getInitializer() = ac and
    ac.getElementType() = Byte and
    f.getInitializer().toString().regexpMatch("byte\\[\\]\\s*\\w+\\s*=\\s*\\{.*\\}")
  )
}

// Find IvParameterSpec constructor calls using the IV variables
predicate usesIvParameterSpec(VariableAccess va) {
  exists(ConstructorCall cc | 
    cc.getConstructedType().hasQualifiedName("javax.crypto.spec", "IvParameterSpec") and
    cc.getAnArgument() = va
  )
}

// Case 1: Local variable IV usage
query predicate localVarCase(VariableDeclarator vd) {
  isStaticIvInitialization(vd) and
  exists(VariableAccess va |
    va.getTarget() = vd.getVariable() and
    usesIvParameterSpec(va)
  )
}

// Case 2: Field IV usage
query predicate fieldCase(Field f) {
  isStaticIvField(f) and
  exists(VariableAccess va |
    va.getTarget() = f.getVariable() and
    usesIvParameterSpec(va)
  )
}

from VariableDeclarator vd, Field f
where localVarCase(vd) or fieldCase(f)
select vd, "Static Initialization Vector (IV) detected. IVs should be randomly generated.", vd.getLocation()
