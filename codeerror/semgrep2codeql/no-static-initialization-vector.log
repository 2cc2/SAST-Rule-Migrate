Rule Content:
/**
 * @name No Static Initialization Vector
 * @description Initialization Vectors (IVs) for block ciphers should be randomly generated
 *              each time they are used. Using a static IV means the same plaintext
 *              encrypts to the same ciphertext every time, weakening the strength
 *              of the encryption.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/no-static-initialization-vector
 * @tags security
 *       vulnerability
 *       cwe/329
 *       owasp/a02
 */

import java

// Pattern 1: Static IV declared in method
predicate isStaticIvInitialization(LocalVariableDeclaration lvd) {
  exists(ArrayInitializer ai |
    lvd.getInit() = ai and
    ai.getType() instanceof ByteType and
    lvd.getInitializer().toString().matches("%byte%[]%=%{%...%}%")
  )
}

// Pattern 2: Static IV declared as class field
predicate isStaticIvField(Field f) {
  exists(ArrayInitializer ai |
    f.getInit() = ai and
    ai.getType() instanceof ByteType and
    f.getInitializer().toString().matches("%byte%[]%=%{%...%}%")
  )
}

// Find IvParameterSpec constructor calls using the IV variables
predicate usesIvParameterSpec(Variable v) {
  exists(ConstructorCall cc | 
    cc.getConstructedType().hasQualifiedName("javax.crypto.spec", "IvParameterSpec") and
    cc.getAnArgument() = v.getAnAccess()
  )
}

// Case 1: Local variable IV usage
query predicate localVarCase(LocalVariableDeclaration lvd) {
  isStaticIvInitialization(lvd) and
  exists(LocalVariable v |
    v.getDeclaration() = lvd and
    usesIvParameterSpec(v)
  )
}

// Case 2: Field IV usage
query predicate fieldCase(Field f) {
  isStaticIvField(f) and
  exists(FieldAccess fa |
    fa.getField() = f and
    usesIvParameterSpec(fa)
  )
}

from LocalVariableDeclaration lvd, Field f
where localVarCase(lvd) or fieldCase(f)
select lvd, "Static Initialization Vector (IV) detected. IVs should be randomly generated.", lvd.getLocation()
