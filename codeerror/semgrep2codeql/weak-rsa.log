  source.asExpr().getIntValue() < 2048
select keyPairGeneratorInit.getACall(),
  "Use of weak RSA key (less than 2048 bits) based on NIST recommendation.",
  keyPairGeneratorInit.getACall(),
  "Key size is " + source.asExpr().toString() + " bits."
