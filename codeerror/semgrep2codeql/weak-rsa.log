/**
 * @name Use of weak RSA key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind problem
 * @id java/use-of-weak-rsa-key
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @tags security
 *       external/cwe/cwe-326
 *       owasp-a3:2017
 *       owasp-a2:2021
 */

import java

from MethodAccess keyPairGeneratorInit, MethodAccess getInstanceCall, Expr bitsValue,
  DataFlow::Node source, DataFlow::Node sink
where
  getInstanceCall.getMethod().hasName("getInstance") and
  getInstanceCall.getArgument(0).(StringLiteral).getValue() = "RSA" and
  keyPairGeneratorInit.getMethod().hasName("initialize") and
  DataFlow::localFlow(source, sink) and
  bitsValue.asExpr() = keyPairGeneratorInit.getArgument(0) and
  sink.asExpr() = bitsValue and
  source.asExpr() instanceof Literal and
  source.asExpr().getIntValue() < 2048
select keyPairGeneratorInit,
  "Use of weak RSA key (less than 2048 bits) based on NIST recommendation.",
  keyPairGeneratorInit,
  "Key size is " + source.asExpr().toString() + " bits."
