/**
 * @name Weak RSA Key Usage
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/use-of-weak-rsa-key
 * @tags security
 *       external/cwe/cwe-326
 *       external/owasp/a03
 *       external/owasp/a02
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class KeyPairGeneratorCall extends DataFlow::Node {
  KeyPairGeneratorCall() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "getInstance" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
      ma.getArgument(0).(StringLiteral).getValue() = "RSA" and
      this.asExpr() = ma
    )
  }
}

class InitializeCall extends DataFlow::Node {
  InitializeCall() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "initialize" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class WeakKeyRule extends TaintTracking::Configuration {
  WeakKeyRule() { this = "WeakKeyRule" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof KeyPairGeneratorCall
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InitializeCall and
    exists(DataFlow::NumberLiteral bits |
      bits = sink.asExpr() and
      bits.getValue().toInt() < 2048
    )
  }
}

from WeakKeyRule cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "RSA keys should be at least 2048 bits based on NIST recommendation"
