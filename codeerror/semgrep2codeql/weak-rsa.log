Rule Content:
/**
 * @name Use of Weak RSA Key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-weak-rsa-key
 * @tags security
 *       external/cwe/cwe-326
 *       external/owasp/a03
 *       external/owasp/a02
 */

import java
import semmle.code.java.security.KeyPairGeneratorAnalysis

class WeakRSAKey extends KeyPairGeneratorAnalysis::Configuration {
  WeakRSAKey() { this = "WeakRSAKey" }

  override predicate isKeyGenerator(KeyPairGenerator kpg) {
    kpg.getAlgorithm() = "RSA"
  }

  override predicate isWeakKeySize(Expr keySize) {
    exists(Literal literal |
      keySize = literal and
      literal.getValue().toInt() < 2048
    )
  }
}

from WeakRSAKey config, KeyPairGenerator kpg, Expr keySize
where config.isKeyGenerator(kpg) and config.isWeakKeySize(keySize)
select keySize, "RSA keys should be at least 2048 bits based on NIST recommendation."
