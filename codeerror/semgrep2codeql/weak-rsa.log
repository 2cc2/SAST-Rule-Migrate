 * @name Use of Weak RSA Key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/use-of-weak-rsa-key
 * @tags security
 *       external/cwe/cwe-326
 *       external/owasp/a03
 *       external/owasp/a02
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class KeyPairGeneratorSource extends DataFlow::Node {
  KeyPairGeneratorSource() {
    exists(Call call |
      call.getCallee().getName() = "getInstance" and
      call.getArgument(0).(StringLiteral).getValue() = "RSA" and
      this.asExpr() = call
    )
  }
}

class KeySizeInitializerSink extends DataFlow::Node {
  KeySizeInitializerSink() {
    exists(Call call, NumericLiteral bits |
      call.getCallee().getName() = "initialize" and
      bits = call.getArgument(0) and
      bits.getValue().toInt() < 2048 and
      this.asExpr() = bits
    )
  }
}

class WeakRSAKeyConfig extends DataFlow::Configuration {
  WeakRSAKeyConfig() { 
    this = "WeakRSAKeyConfig" 
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof KeyPairGeneratorSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof KeySizeInitializerSink
  }
}

from WeakRSAKeyConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Use of weak RSA key (less than 2048 bits) which violates NIST recommendations"
