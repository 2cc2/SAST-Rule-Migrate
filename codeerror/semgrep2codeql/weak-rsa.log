/**
 * @name Use of Weak RSA Key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-weak-rsa-key
 * @tags security
 *       external/cwe/cwe-326
 *       external/owasp/a03
 *       external/owasp/a02
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.security.KeyPairGeneratorAnalysis

class WeakRSAKeyConfiguration extends KeyPairGeneratorAnalysis::Configuration {
  WeakRSAKeyConfiguration() { this = "WeakRSAKeyConfiguration" }

  override predicate isKeyPairGeneratorCall(DataFlow::CallNode call) {
    exists(MethodAccess ma |
      ma = call.getNode() and
      ma.getMethod().getName() = "getInstance" and
      ma.getArgument(0).(StringLiteral).getValue() = "RSA"
    )
  }

  override predicate isKeySizeInitializer(DataFlow::CallNode call) {
    exists(NumericLiteral bits |
      call.getNode().(MethodAccess).getMethod().getName() = "initialize" and
      bits = call.getArgument(0).(NumericLiteral) and
      bits.getValue().toInt() < 2048
    )
  }
}

