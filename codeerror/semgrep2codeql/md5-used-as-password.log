/**
 * @name MD5 used as password hash
 * @description Detects when MD5 is used as a password hash. MD5 is not considered secure
 *              for password hashing. Use PBKDF2 or bcrypt instead.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision medium
 * @tags security
 *       java
 *       md5
 *       owasp-a3
 *       owasp-a2
 *       cwe-327
 * @id java/md5-password-hash
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class MD5Usage extends TaintTracking::Configuration {
  MD5Usage() { this = "MD5 password usage" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getInstance") and
      ma.getArgument(0).(StringLiteral).getValue().toUpperCase() = "MD5" and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma, RemoteFlowSource model |
      ma.getMethod().getName().matches("%password%") and
      ma.getQualifier() = model and
      sink.asExpr() = ma.getAnArgument()
    )
  }
}

from MD5Usage config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Using MD5 for password hashing is insecure. Use PBKDF2 or bcrypt instead."
