/**
 * @name MD5 used as password hash
 * @description Detects when MD5 is used as a password hash. MD5 is not considered secure
 *              for password hashing. Use PBKDF2 or bcrypt instead.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision medium
 * @tags security
 *       java
 *       md5
 *       owasp-a3
 *       owasp-a2
 *       cwe-327
 * @id java/md5-password-hash
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class MD5Usage extends TaintTracking::TaintConfiguration {
  MD5Usage() { this = "MD5 password usage" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, MethodAccess ma |
      m.hasName("getInstance") and
      m.getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
      ma.getMethod() = m and
      ma.getArgument(0).(StringLiteral).getValue().toUpperCase() = "MD5" and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, MethodAccess ma, RefType model |
      m.getName().matches("%password%") and
      ma.getMethod() = m and
      ma.getQualifier().getType() = model and
      sink.asExpr() = ma.getAnArgument()
    )
  }
}

