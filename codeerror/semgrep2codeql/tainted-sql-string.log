import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.OutputStream

class LambdaEventHandler extends Method {
  LambdaEventHandler() {
    this.getName() = "handleRequest" and
    (
      (this.getNumberOfParameters() = 2 and
       this.getParameter(0).getType().hasName("InputStream"))
      or
      (this.getNumberOfParameters() = 3 and
       this.getParameter(0).getType().hasName("InputStream") and
       this.getParameter(1).getType().hasName("OutputStream"))
    )
  }
}

class SqlStringConstruction extends TaintTracking::Configuration {
  SqlStringConstruction() { this = "SqlStringConstruction" }

  override predicate isSource(DataFlow::Node source) {
    exists(LambdaEventHandler m |
      source.asParameter() = m.getParameter(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(AddExpr add |
      add.getLeftOperand().(StringLiteral).getValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      sink.asExpr() = add.getRightOperand()
    )
    or
    exists(Method m, MethodAccess ma |
      m.hasName("concat") and
      ma.getMethod() = m and
      ma.getQualifier().(StringLiteral).getValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      sink.asExpr() = ma.getArgument(0)
    )
    or
    exists(Method m, MethodAccess ma |
      m.hasName("append") and
      ma.getMethod() = m and
      exists(Variable sb |
        sb.getInitializer().(StringLiteral).getValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
        ma.getQualifier() = sb.getAnAccess()
      ) and
      sink.asExpr() = ma.getArgument(0)
    )
    or
    exists(AssignAddExpr addAssign |
      exists(Variable v |
        v.getInitializer().(StringLiteral).getValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
        addAssign.getLValue() = v.getAnAccess()
      ) and
      sink.asExpr() = addAssign.getRValue()
    )
    or
    exists(Method m, MethodAccess ma |
      m.hasName("format") and
      ma.getMethod() = m and
      ma.getArgument(0).(StringLiteral).getValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      sink.asExpr() = ma.getArgument(1)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodAccess println |
      println.getMethod().getDeclaringType().hasQualifiedName("java.io", "PrintStream") and
      (println.getMethod().hasName("println") or println.getMethod().hasName("print")) and
      node.asExpr() = println.getAnArgument()
    )
  }
}

