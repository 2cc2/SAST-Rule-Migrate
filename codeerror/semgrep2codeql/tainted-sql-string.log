Rule Content:
/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string. This is usually
 * bad practice because manual construction could accidentally result in a SQL
 * injection. An attacker could use a SQL injection to steal or modify contents
 * of the database.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @references https://owasp.org/www-community/attacks/SQL_Injection
 * @tags security
 *       owasp-a01
 *       owasp-a03
 *       cwe-89
 *       aws-lambda
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class AWSLambdaHandlerInput extends DataFlow::Node {
  AWSLambdaHandlerInput() {
    exists(Method m, Parameter p | 
      (m.getName().matches("%handler%") or not m.getName().matches("%")) and
      (
        (
          m.getParameter(0).getType().hasName("InputStream") and
          p = m.getParameter(0) and
          this.asParameter() = p
        )
        or
        (
          m.getParameter(1).getType().hasName("OutputStream") and
          p = m.getParameter(1) and
          this.asParameter() = p
        )
        or
        (
          m.getParameter(0).getType() instanceof TypeObject and
          p = m.getParameter(0) and
          this.asParameter() = p
        )
      ) and
      m.getParameter(1).getType().getUnderlyingType().hasQualifiedName("com.amazonaws.services.lambda.runtime", "Context")
    )
  }
}

class SqlStringConstruction extends DataFlow::Node {
  SqlStringConstruction() {
    exists(StringLiteral sl | 
      sl.getValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      (
        this.asExpr() = sl
        or
        exists(AddExpr ae | ae.getAnOperand() = sl | this.asExpr() = ae.getAnOperand())
        or
        exists(MethodCall mc | 
          mc.getMethod().hasName("concat") and 
          mc.getQualifier().toString() = sl.toString() and 
          this.asExpr() = mc
        )
        or
        exists(ClassInstanceExpr cie | 
          cie.getTypeName().toString() = "StringBuilder" and
          exists(StringLiteral arg | arg = cie.getAnArgument() | arg.getValue() = sl.getValue()) and
          exists(MethodCall mc | 
            mc.getMethod().hasName("append") and
            mc.getQualifier() = cie and
            this.asExpr() = mc
          )
        )
        or
        exists(Assignment a | 
          a.getRhs().toString() = sl.toString() and 
          a.getLhs().getType() instanceof TypeString and
          this.asExpr() = a.getLhs()
        )
        or
        exists(MethodCall fm | 
          fm.getMethod().getName().matches("format") and
          exists(StringLiteral fmt | 
            fmt = fm.getArgument(0) and
            fmt.getValue() = sl.getValue() and 
            this.asExpr() = fm
          )
        )
      )
    )
  }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof AWSLambdaHandlerInput
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlStringConstruction
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Field f | 
      f.hasName("out") and
      f.getDeclaringType().hasQualifiedName("java.lang", "System") and
      exists(MethodCall mc | 
        mc.getMethod().hasName("println") and
        mc.getQualifier() = f.getAnAccess() and
        sanitizer.asExpr() = mc.getAnArgument()
      )
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSqlStringConfig cfg
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user input used to manually construct a SQL string. This could lead to SQL injection.",
  source.getNode(), "User input"
