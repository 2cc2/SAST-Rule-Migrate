import java
import codeql.java.dataflow.TaintTracking
import codeql.java.StringOperations

class SqlStringConstruction extends TaintTracking::Configuration {
  SqlStringConstruction() { this = "SqlStringConstruction" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p | 
      m.hasName("handleRequest") and
      p = m.getParameter(0) and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Expr sqlStr |
      // String concatenation patterns
      (
        exists(StringOperation so | 
          so instanceof Concatenation and
