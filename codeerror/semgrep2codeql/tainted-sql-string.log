/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-89
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat
import semmle.code.java.Console

class LambdaEventHandler extends Method {
  LambdaEventHandler() {
    (this.getName() = "handleRequest" and
    ((this.getNumberOfParameters() = 2 and
      this.getParameter(0).getType().hasName("InputStream")) or
     (this.getNumberOfParameters() = 3 and
      this.getParameter(0).getType().hasName("InputStream") and
      this.getParameter(1).getType().hasName("OutputStream"))))
    or
    exists(MethodCall ma |
      ma.getMethod() = this and
      ma.getArgument(0).getType().hasName("InputStream") and
      (ma.getNumberOfParameters() = 2 or
       (ma.getNumberOfParameters() = 3 and
        ma.getArgument(1).getType().hasName("OutputStream")))
    )
  }
}

class SqlStringConstruction extends TaintTracking::Configuration {
  SqlStringConstruction() { this = "SqlStringConstruction" }

  override predicate isSource(DataFlow::Node source) {
    exists(LambdaEventHandler m |
      source.asParameter() = m.getParameter(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(AddExpr add |
      add.getLeftOperand().getStringValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      sink.asExpr() = add.getRightOperand()
    )
    or
    exists(MethodCall concat |
      concat.getMethod().getName() = "concat" and
      concat.getQualifier().getStringValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      sink.asExpr() = concat.getArgument(0)
    )
    or
    exists(MethodCall append |
      append.getMethod().getName() = "append" and
      exists(Variable sb |
        sb.getInitializer().getStringValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
        append.getQualifier() = sb.getAnAccess()
      ) and
      sink.asExpr() = append.getArgument(0)
    )
    or
    exists(AssignAddExpr addAssign |
      exists(Variable v |
        v.getInitializer().getStringValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
        addAssign.getLValue().getAUse() = v.getAnAccess()
      ) and
      sink.asExpr() = addAssign.getRValue()
    )
    or
    exists(MethodCall format |
      format.getMethod().getName() = "format" and
      format.getArgument(0).getStringValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      sink.asExpr() = format.getArgument(1)
    )
  }

  predicate isSanitizer(DataFlow::Node node) {
    exists(SystemOut::PrintlnCall println | node.asExpr() = println.getAnArgument())
  }
}

