          append.getMethod().getName() = "append" and
          append.getQualifier().getAChild*() = cc and
          sink.asExpr() = append
        )
        or
        exists(AssignExpr ae |
          ae.getOperator() = ADD_ASSIGN and
          ae.getLeftOperand() = sqlStr and
          sink.asExpr() = ae
        )
        or
        exists(MethodAccess format |
          format.getMethod().getName() = "format" and
          format.getArgument(0) = sqlStr and
          sink.asExpr() = format
        )
      )
      and
      sqlStr.toString().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b")
      and
      not sink.getParent() instanceof SystemOutCall
    )
  }
}

