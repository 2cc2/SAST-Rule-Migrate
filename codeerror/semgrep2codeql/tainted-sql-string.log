/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string. This is usually
 *    bad practice because manual construction could accidentally result in a SQL
 *    injection. An attacker could use a SQL injection to steal or modify contents
 *    of the database. Instead, use a parameterized query which is available
 *    by default in most database engines.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 *       owasp-a01
 *       owasp-a03
 *       aws-lambda
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.aws.AWSLambda
import semmle.code.java.StringConcatenation

class SqlStringConstruction extends TaintTracking::Configuration {
  SqlStringConstruction() { this = "SqlStringConstruction" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m | 
      m instanceof AWSLambdaHandlerMethod and
      source.asParameter() = m.getParameter(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Expr sqlStr |
      // String concatenation patterns
      (
        exists(StringConcatenation sc | sc.getAnOperand() = sqlStr.toString() and sink.asExpr() = sc)
        or
        exists(MethodAccess concat | 
          concat.getMethod().getName() = "concat" and
          concat.getQualifier().toString() = sqlStr.toString() and
          sink.asExpr() = concat
        )
        or
        exists(StringBuilderConstruction sb | 
          sb.getInitialValue().toString() = sqlStr.toString() and
          sink.asExpr() = sb.getAnAppendCall()
        )
        or
        exists(CompoundAssignment compound | 
          compound.getLeftOperand().toString() = sqlStr.toString() and
          compound.getOpKind() = CompoundAssignmentOpKind.ADD and
          sink.asExpr() = compound
        )
        or
        exists(MethodAccess format | 
          format.getMethod().getName() = "format" and
          format.getArgument(0).toString() = sqlStr.toString() and
          sink.asExpr() = format
        )
      )
      and
      sqlStr.toString().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b")
      and
      not sink.getParent() instanceof SysOutCall
    )
  }
}

