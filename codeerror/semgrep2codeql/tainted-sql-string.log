Rule Content:
/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string. This is usually
 *    bad practice because manual construction could accidentally result in a SQL
 *    injection. An attacker could use a SQL injection to steal or modify contents
 *    of the database. Instead, use a parameterized query which is available
 *    by default in most database engines.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 *       owasp-a01
 *       owasp-a03
 *       aws-lambda
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringOperations

class SqlStringConstruction extends DataFlow::Configuration {
  SqlStringConstruction() { this = "SqlStringConstruction" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p | 
      m.hasName("handleRequest") and
      p = m.getParameter(0) and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Expr sqlStr |
      // String concatenation patterns
      (
        exists(AddExpr so | 
          so.getAnOperand() = sqlStr and 
          sink.asExpr() = so
        )
        or
        exists(Method concat | 
          concat.getName() = "concat" and
          concat.getQualifier() = sqlStr and
          sink.asExpr() = concat.getACall()
        )
        or
        exists(ConstructorCall cc, Method append |
          cc.getConstructedType().hasName("StringBuilder") and
          sqlStr = cc.getAnArgument() and
          append.getName() = "append" and
          append.getQualifier() = cc and
          sink.asExpr() = append.getACall()
        )
        or
        exists(AssignExpr ae |
          ae.getOperator() instanceof AssignExpr::ADD_ASSIGN and
          ae.getLeftOperand() = sqlStr and
          sink.asExpr() = ae
        )
        or
        exists(Method format |
          format.getName() = "format" and
          format.getArgument(0) = sqlStr and
          sink.asExpr() = format.getACall()
        )
      )
      and
      sqlStr.toString().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b")
      and
      not sink.getParent() instanceof SystemOutCall
    )
  }
}

