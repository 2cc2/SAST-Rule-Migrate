Rule Content:
/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string.
 *              This is usually bad practice because manual construction could accidentally 
 *              result in a SQL injection. An attacker could use a SQL injection to steal 
 *              or modify contents of the database. Instead, use a parameterized query which
 *              is available by default in most database engines. Alternatively, consider using
 *              an object-relational mapper (ORM) such as Sequelize which will protect your queries.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.8
 * @precision high
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-89
 *       external/cwe/cwe-943
 *       owasp-a01
 *       owasp-a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class LambdaHandlerInput extends DataFlow::Node {
  LambdaHandlerInput() {
    exists(Method m | 
      (m.getName().matches("handleRequest%") or // Common AWS Lambda handler naming
       m.getName().equals("handleRequest")) and
      (m.getParameter(0).getType().getName().matches("InputStream") or
       m.getParameter(1).getType().getName().matches("InputStream")) and
      this.asParameter() = m.getParameter(0)
    )
  }
}

class SqlString extends DataFlow::Node {
  SqlString() {
    // Match SQL statement patterns
    this.asExpr().(StringLiteral).getValue().matches("(?i)(select|delete|insert|create|update|alter|drop)%")
  }
}

class SqlStringOperation extends DataFlow::Node {
  SqlStringOperation() {
    // String concatenation
    exists(BinaryExpr be | 
      be.getOp().toString() = "+" and
      (be.getLeftOperand() = this.asExpr() or be.getRightOperand() = this.asExpr()) and
      be.getParent().(Expr) = this.asExpr()
    )
    or
    // String.concat() calls
    exists(MethodAccess ma |
      ma.getMethod().getName() = "concat" and
      this.asExpr() = ma.getQualifier()
    )
    or
    // StringBuilder usage
    exists(Variable sb, MethodAccess append |
      sb.getType().getName() = "StringBuilder" and
      append.getMethod().getName() = "append" and
      append.getQualifier() = sb.getAnAccess() and
      this.asExpr() = append.getAnArgument()
    )
    or
    // String += operations
    exists(AssignExpr ae |
      ae.getOp().toString() = "+=" and
      this.asExpr() = ae.getLeftOperand()
    )
    or
    // String.format() calls
    exists(MethodAccess format |
      format.getMethod().getName() = "format" and
      format.getMethod().getDeclaringType().getName() = "String" and
      this.asExpr() = format.getAnArgument()
    )
  }
}

class TaintedSqlConfig extends TaintTracking::Configuration {
  TaintedSqlConfig() { this = "TaintedSqlConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaHandlerInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlString and sink instanceof SqlStringOperation
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Exclude System.out.println calls
    exists(MethodAccess println |
      println.getMethod().getName().matches("print%") and
      println.getMethod().getDeclaringType().getName() = "System.out" and
      sanitizer.asExpr() = println.getAnArgument()
    )
  }
}

