Rule Content:
/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string. This is usually
 * bad practice because manual construction could accidentally result in a SQL
 * injection. An attacker could use a SQL injection to steal or modify contents
 * of the database.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @references https://owasp.org/www-community/attacks/SQL_Injection
 * @tags security
 *       owasp-a01
 *       owasp-a03
 *       cwe-89
 *       aws-lambda
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class AWSLambdaHandlerInput extends DataFlow::Node {
  AWSLambdaHandlerInput() {
    exists(Method m | 
      (m.getName().matches("%handler%") or not m.getName().matches("%")) and
      (
        (
          m.getParameter(0).getType().hasName("InputStream") and
          result.asParameter() = m.getParameter(0)
        )
        or
        (
          m.getParameter(1).getType().hasName("OutputStream") and
          result.asParameter() = m.getParameter(1)
        )
        or
        (
          m.getParameter(0).getType() instanceof TypeObject and
          result.asParameter() = m.getParameter(0)
        )
      ) and
      m.getParameter(1).getType().hasQualifiedName("com.amazonaws.services.lambda.runtime", "Context")
    )
  }
}

class SqlStringConstruction extends DataFlow::Node {
  SqlStringConstruction() {
    exists(StringLiteral sl | 
      sl.getValue().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      (
        result = sl
        or
        exists(Concatenation c | c.getAnOperand() = sl and result = c.getAnOperand())
        or
        exists(StringConcatMethod scm | scm.getReceiver() = sl.toString() and result = scm)
        or
        exists(StringBuilderConstructor sbc | 
          sbc.getAnArgument() = sl.toString() and result = sbc.getAMethodCall("append")
        )
        or
        exists(Assignment a | 
          a.getAnOperand() = sl.getParent().getParent() and 
          a.getLeftOperand().getType() instanceof TypeString and
          result = a.getLeftOperand()
        )
        or
        exists(JPLFormatMethod fm | 
          fm.getAFormatLiteral().getValue() = sl.getValue() and result = fm
        )
      )
    )
  }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof AWSLambdaHandlerInput
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlStringConstruction
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(PrintStreamExpr pse | pse.getAMethodCall().getMethod().hasName("println") | sanitizer = pse.getAnArgument())
  }
}

from TaintedSqlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user input used to manually construct a SQL string. This could lead to SQL injection.",
  source.getNode(), "User input"
