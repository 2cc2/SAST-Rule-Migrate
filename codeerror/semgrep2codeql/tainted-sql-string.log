class TaintedSqlConfig extends TaintTracking::Configuration {
  TaintedSqlConfig() { }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaHandlerInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlString and sink instanceof SqlStringOperation
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodCall println |
      println.getMethod().getName().matches("print%") and
      println.getMethod().getDeclaringType().getName() = "System.out" and
      sanitizer.asExpr() = println.getAnArgument()
    )
  }
}

