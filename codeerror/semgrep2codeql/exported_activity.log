Rule Content:
/**
 * @name Exported Activity Vulnerability
 * @description 
 * The application exports an activity. Any application on the device can launch the exported activity
 * which may compromise the integrity of your application or its data. Ensure that any exported activities
 * do not have privileged access to your application's control plane.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id exported-activity
 * @tags security
 *       android
 *       cwe/926
 *       owasp/a5
 */

import android.xml
import DataFlow::PathGraph

// Define the path configuration which looks for exported activities in AndroidManifest.xml
from XmlDocument manifest, XmlElement activityElement
where
  manifest.getFile().getBaseName() = "AndroidManifest.xml" and
  activityElement.getName() = "activity" and
  activityElement.getParent() = manifest.getRootElement() and
  (
    activityElement.getAttribute("android:exported").getValue() = "true" or
    exists(XmlElement filter | filter.getName() = "intent-filter" and filter.getParent() = activityElement)
  ) and
  not exists(activityElement.getAttribute("android:exported") | 
    activityElement.getAttribute("android:exported").getValue() = "false"
  )
select activityElement, "Exported activity found. Ensure this is intended and properly secured."
