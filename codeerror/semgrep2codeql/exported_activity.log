/**
 * @name Exported Android Activity Vulnerability
 * @description The application exports an activity that can be launched by any application on the device,
 *              which may compromise the integrity of the application or its data.
 * @kind problem
 * @problem.severity warning
 * @id android/exported-activity
 * @tags security
 *       external/cwe/cwe-926
 *       external/owasp/a05
 */

import android

class AndroidManifest extends File {
  AndroidManifest() { this.getBaseName() = "AndroidManifest.xml" }
}

class ActivityElement extends XmlTagElement {
  ActivityElement() {
    this.getName() = "activity" and
    this.getNamespace() = "android" and
    this.getFile() instanceof AndroidManifest
  }
}

class ExportedActivity extends ActivityElement {
  ExportedActivity() {
    (
      // Case 1: Explicitly exported
      exists(XmlAttributeElement attr |
        attr.getElement() = this and
        attr.getName() = "exported" and
        attr.getValue().toLowerCase() = "true"
      )
    ) or
    (
      // Case 2: Implicitly exported via intent-filter
      exists(XmlTagElement child |
        child.getParentElement() = this and
        child.getName() = "intent-filter"
      ) and
      // Not explicitly set to false
      not exists(XmlAttributeElement attr |
        attr.getElement() = this and
        attr.getName() = "exported" and
        attr.getValue().toLowerCase() = "false"
      )
    )
  }
}

from ExportedActivity activity
select activity, "The application exports an activity. Any application on the device can launch the exported activity which may compromise the integrity of your application or its data. Ensure that any exported activities do not have privileged access to your application's control plane."
