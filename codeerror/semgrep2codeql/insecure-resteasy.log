/**
 * @name Insecure RESTEasy Deserialization
 * @description When a Restful webservice endpoint is configured to use wildcard mediaType {*/*} as a value for the
 * @Consumes annotation, or uses application/x-java-serialized-object, it may lead to deserialization vulnerabilities.
 * @kind problem
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       owasp-a08:2017
 *       owasp-a08:2021
 */
import java

from Annotation consumes, Method m
where 
  (consumes.toString() = "@Consumes({\"application/x-java-serialized-object\"})" or
   consumes.toString() = "@Consumes({\"*/*\"})" or
   consumes.toString() = "@Consumes(\"*/*\")" or
   consumes.toString() = "@Consumes({MediaType.WILDCARD_TYPE})") and
  consumes.getTarget() = m
select consumes, "Potential insecure RESTEasy deserialization with @Consumes annotation"

/**
 * @name Default RESTEasy Provider Abuse
 * @description When a Restful webservice endpoint isn't configured with a @Consumes annotation, it may be vulnerable
 * to deserialization attacks via the SerializableProvider.
 * @kind problem
 * @id java/default-resteasy-provider-abuse
 * @tags security
 *       external/cwe/cwe-502
 *       owasp-a08:2017
 *       owasp-a08:2021
 */
import java

from Method m, Annotation path
where
  path.toString().matches("@Path(\"%\")") and
  path.getTarget() = m and
  not exists(Annotation consumes | 
    consumes.toString().matches("@Consumes(%)") and
    (consumes.getTarget() = m or consumes.getTarget() = m.getDeclaringType())
  ) and
  not exists(Annotation get | 
    get.toString() = "@GET" and
    get.getTarget() = m
  )
select m, "REST endpoint missing @Consumes annotation, potentially vulnerable to deserialization attacks"
