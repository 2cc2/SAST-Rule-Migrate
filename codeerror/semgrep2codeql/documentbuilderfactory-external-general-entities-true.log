/**
 * @name DocumentBuilderFactory External General Entities Enabled
 * @description Detects when DocumentBuilderFactory enables external general entities,
 *              which could lead to XML External Entity (XXE) attacks.
 * @kind path-problem
 * @problem.severity error
 * @id java/documentbuilderfactory-external-general-entities-true
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04
 *       external/owasp/a05
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class DocumentBuilderFactory extends RefType {
  DocumentBuilderFactory() {
    this.hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory")
  }
}

class SetFeatureCall extends DataFlow::Node {
  SetFeatureCall() {
    exists(Method m, Call call |
      m.getDeclaringType() instanceof DocumentBuilderFactory and
      m.getName() = "setFeature" and
      call.getCallee() = m and
      call.getArgument(0).(StringLiteral).getValue() = 
        "http://xml.org/sax/features/external-general-entities" and
      call.getArgument(1).(BooleanLiteral).getValue() = true and
      this.asExpr() = call
    )
  }
}

class DocumentBuilderFactoryConfig extends TaintTracking::Configuration {
  DocumentBuilderFactoryConfig() { this = "DocumentBuilderFactoryConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof SetFeatureCall 
  }

  override predicate isSink(DataFlow::Node sink) { none() }
}

from DataFlow::PathNode source
where exists(DocumentBuilderFactoryConfig cfg | cfg.hasFlowFromSource(source))
select source.getNode(), 
  source.getNode().toString(), 
  "External entities are allowed for DocumentBuilderFactory. " +
  "This is vulnerable to XML external entity attacks. Disable this " +
  "by setting the feature \"http://xml.org/sax/features/external-general-entities\" to false."
