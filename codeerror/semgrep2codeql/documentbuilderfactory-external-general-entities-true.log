/**
 * @name DocumentBuilderFactory External General Entities Enabled
 * @description Detects when external entities are enabled in DocumentBuilderFactory,
 *              making the application vulnerable to XXE attacks.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/documentbuilderfactory-external-general-entities-true
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 *       external/asvs/V5.5.2
 */
import java

from MethodAccess setFeatureCall, Expr dbfactory
where
  setFeatureCall.getMethod().getName() = "setFeature" and
  setFeatureCall.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
  exists(setFeatureCall.getArgument(0) |
    setFeatureCall.getArgument(0).(StringLiteral).getValue() = 
      "http://xml.org/sax/features/external-general-entities"
  ) and
  exists(setFeatureCall.getArgument(1) |
    setFeatureCall.getArgument(1).(BooleanLiteral).getValue() = true
  ) and
  dbfactory = setFeatureCall.getQualifier()
select setFeatureCall, "External entities are allowed for $@. This is vulnerable to XML external entity attacks.", 
  dbfactory, "DocumentBuilderFactory instance"
