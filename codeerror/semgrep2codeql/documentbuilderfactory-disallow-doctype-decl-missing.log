Rule Content:
/**
 * @name DocumentBuilderFactory with missing DOCTYPE declaration restrictions
 * @description Detects DocumentBuilderFactory instances that are vulnerable to XXE attacks due to missing DOCTYPE restrictions.
 * @kind path-problem
 * @problem.severity error
 * @id java/documentbuilderfactory-disallow-doctype-decl-missing
 * @tags security
 *       external/cwe/cwe-611
 *       owasp-a04:2017
 *       owasp-a05:2021
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class DocumentBuilderFactoryCreation extends MethodAccess {
  DocumentBuilderFactoryCreation() {
    this.getMethod().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory", "newInstance")
  }
}

class SecureFeatureSetting extends MethodAccess {
  SecureFeatureSetting() {
    (
      this.getMethod().getName() = "setFeature" and
      (
        this.getArgument(0).(StringLiteral).getValue() =
          "http://apache.org/xml/features/disallow-doctype-decl" and
        this.getArgument(1).(BooleanLiteral).getValue() = true
      )
    ) or
    (
      this.getMethod().getName() = "setFeature" and
      (
        (
          this.getArgument(0).(StringLiteral).getValue() =
            "http://xml.org/sax/features/external-general-entities" or
          this.getArgument(0).(StringLiteral).getValue() =
            "http://xml.org/sax/features/external-parameter-entities"
        ) and
        this.getArgument(1).(BooleanLiteral).getValue() = false
      )
    )
  }
}

class DocumentBuilderCreation extends MethodAccess {
  DocumentBuilderCreation() {
    this.getMethod().getName() = "newDocumentBuilder" and
    this.getQualifier().getType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory")
  }
}

class UnsafeDocumentBuilderFactoryConfig extends TaintTracking::Configuration {
  UnsafeDocumentBuilderFactoryConfig() { this = "UnsafeDocumentBuilderFactoryConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(DocumentBuilderFactoryCreation creation |
      source.asExpr() = creation.getQualifier()
    )
  }
  
  override predicate isSink(DataFlow::Node sink) {
    exists(DocumentBuilderCreation creation |
      sink.asExpr() = creation.getQualifier()
    )
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SecureFeatureSetting setting |
      sanitizer.asExpr() = setting.getQualifier()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, UnsafeDocumentBuilderFactoryConfig config
where config.hasFlowPath(source, sink)
select sink, 
  "DOCTYPE declarations are enabled for this DocumentBuilderFactory. This is vulnerable to XML external entity attacks.", 
  source, sink,
  "Disable this by setting the feature \"http://apache.org/xml/features/disallow-doctype-decl\" to true."
