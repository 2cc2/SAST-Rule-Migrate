/**
 * @name DocumentBuilderFactory with missing DOCTYPE declaration restrictions
 * @description Detects DocumentBuilderFactory instances that are vulnerable to XXE attacks due to missing DOCTYPE restrictions.
 * @kind path-problem
 * @problem.severity error
 * @id java/documentbuilderfactory-disallow-doctype-decl-missing
 * @tags security
 *       external/cwe/cwe-611
 *       owasp-a04:2017
 *       owasp-a05:2021
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class DocumentBuilderFactoryCreation extends Method {
  DocumentBuilderFactoryCreation() {
    this.hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory", "newInstance")
  }
}

class SecureFeatureSetting extends Method {
  SecureFeatureSetting() {
    (
      this.getName() = "setFeature" and
      (
        this.getParameter(0).getType().hasName("String") and
        this.getParameter(1).getType().hasName("boolean") and
        exists(StringLiteral feature |
          feature = this.getArgument(0) and
          (
            feature.getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
            exists(BooleanLiteral value |
              value = this.getArgument(1) and
              value.getValue() = true
            )
          )
          or
          (
            (feature.getValue() = "http://xml.org/sax/features/external-general-entities" or
             feature.getValue() = "http://xml.org/sax/features/external-parameter-entities") and
            exists(BooleanLiteral value |
              value = this.getArgument(1) and
              value.getValue() = false
            )
          )
        )
      )
    )
  }
}

class DocumentBuilderCreation extends Method {
  DocumentBuilderCreation() {
    this.getName() = "newDocumentBuilder" and
    this.getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory")
  }
}

class UnsafeDocumentBuilderFactoryConfig extends TaintTracking::Configuration {
  UnsafeDocumentBuilderFactoryConfig() { this = "UnsafeDocumentBuilderFactoryConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(DocumentBuilderFactoryCreation creation |
      source.asExpr() = creation.getAReference()
    )
  }
  
  override predicate isSink(DataFlow::Node sink) {
    exists(DocumentBuilderCreation creation |
      sink.asExpr() = creation.getAReference()
    )
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SecureFeatureSetting setting |
      sanitizer.asExpr() = setting.getAReference()
    )
  }
}

