Rule Content:
/**
 * @name No direct response writer
 * @description Detected a request with potential user-input going into a OutputStream
 *    or Writer object. This bypasses any view or template environments,
 *    including HTML escaping, which may expose this application to cross-site
 *    scripting (XSS) vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/no-direct-response-writer
 * @tags security
 *       external/cwe/cwe-079
 *       external/cwe/cwe-116
 *       owasp-a07:2017
 *       owasp-a03:2021
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class ServletRequestSource extends RemoteFlowSource {
  ServletRequestSource() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("getInputStream") or
       ma.getMethod().getName().matches("getParameter%") or
       ma.getMethod().getName().matches("getParameterMap") or
       ma.getMethod().getName().matches("getParameterValues") or
       ma.getMethod().getName().matches("getReader") or
       ma.getMethod().getName().matches("getCookies") or
       ma.getMethod().getName().matches("getHeader%") or
       ma.getMethod().getName().matches("getPart%") or
       ma.getMethod().getName().matches("getQueryString")) and
      (ma.getQualifier() instanceof HttpServletRequest or
       ma.getQualifier() instanceof ServletRequest) and
      this.asSource() = ma
    )
  }
}

class DirectResponseWriterSink extends DataFlow::Node {
  DirectResponseWriterSink() {
    exists(MethodAccess ma |
      (ma.getQualifier() instanceof HttpServletResponse and
       (ma.getMethod().getName().matches("getWriter") or
        ma.getMethod().getName().matches("getOutputStream"))) or
      (ma.getQualifier() instanceof PrintWriter or
       ma.getQualifier() instanceof ServletOutputStream or
       ma.getQualifier() instanceof OutputStream) and
      ma.getMethod().getName().matches("write%") and
      this.asSink() = ma
    )
  }
}

/** Sanitizers that neutralize XSS */
class XssSanitizer extends DataFlow::Node {
  XssSanitizer() {
    exists(Method m |
      (m.hasName("forHtml") and m.getDeclaringType().hasName("Encode")) or
      (m.hasName("sanitize") and m.getDeclaringType().hasName("PolicyFactory")) or
      (m.hasName("scan") and m.getDeclaringType().hasName("AntiSamy")) or
      (m.hasName("clean") and m.getDeclaringType().hasName("JSoup")) or
      (m.getDeclaringType().hasName("StringEscapeUtils") and m.hasName("escapeHtml")) or
      (m.getDeclaringType().hasName("HtmlUtils") and m.hasName("htmlEscape")) or
      (m.getDeclaringType().hasName("ESAPI") and m.hasName("encodeForHTML")) and
      this.asSanitizer() = m.getACall()
    )
  }
}

from ServletRequestSource source, DirectResponseWriterSink sink, XssSanitizer sanitizer
where TaintTracking::localTaint(source, sink) and not TaintTracking::localTaint(source, sanitizer)
select sink, "Potential XSS vulnerability: untrusted input flows directly to response writer", 
  source, "Source of user input"
