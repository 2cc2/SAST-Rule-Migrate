Rule Content:
/**
 * @name No direct response writer
 * @description Detected a request with potential user-input going into a OutputStream
 *    or Writer object. This bypasses any view or template environments,
 *    including HTML escaping, which may expose this application to cross-site
 *    scripting (XSS) vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/no-direct-response-writer
 * @tags security
 *       external/cwe/cwe-079
 *       external/cwe/cwe-116
 *       owasp-a07:2017
 *       owasp-a03:2021
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import java.io.PrintWriter
import javax.servlet.ServletOutputStream
import java.io.OutputStream

class ServletRequestSource extends RemoteFlowSource {
  ServletRequestSource() {
    exists(MethodAccessExpr ma |
      (ma.getMethod().getName().matches("getInputStream") or
       ma.getMethod().getName().matches("getParameter%") or
       ma.getMethod().getName().matches("getParameterMap") or
       ma.getMethod().getName().matches("getParameterValues") or
       ma.getMethod().getName().matches("getReader") or
       ma.getMethod().getName().matches("getCookies") or
       ma.getMethod().getName().matches("getHeader%") or
       ma.getMethod().getName().matches("getPart%") or
       ma.getMethod().getName().matches("getQueryString")) and
      (ma.getQualifier().getType().hasQualifiedName("javax.servlet", "HttpServletRequest") or
       ma.getQualifier().getType().hasQualifiedName("javax.servlet", "ServletRequest"))
    )
  }

  override predicate isSource(DataFlow::Node source) { 
    source.asExpr() instanceof ServletRequestSource 
  }

  override string getSourceType() { result = "Remote user input" }
}

class DirectResponseWriterSink extends DataFlow::Node {
  DirectResponseWriterSink() {
    exists(MethodAccessExpr ma |
      (ma.getQualifier().getType().hasQualifiedName("javax.servlet", "HttpServletResponse") and
       (ma.getMethod().getName().matches("getWriter") or
        ma.getMethod().getName().matches("getOutputStream"))) or
      (ma.getQualifier().getType().hasQualifiedName("java.io", "PrintWriter") or
       ma.getQualifier().getType().hasQualifiedName("javax.servlet", "ServletOutputStream") or
       ma.getQualifier().getType().hasQualifiedName("java.io", "OutputStream")) and
      ma.getMethod().getName().matches("write%")
    )
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink.asExpr() instanceof DirectResponseWriterSink 
  }
}

class XssSanitizer extends DataFlow::Node {
  XssSanitizer() {
    exists(Method m |
      (m.hasName("forHtml") and m.getDeclaringType().hasName("Encode")) or
      (m.hasName("sanitize") and m.getDeclaringType().hasName("PolicyFactory")) or
      (m.hasName("scan") and m.getDeclaringType().hasName("AntiSamy")) or
      (m.hasName("clean") and m.getDeclaringType().hasName("JSoup")) or
      (m.getDeclaringType().hasName("StringEscapeUtils") and m.hasName("escapeHtml")) or
      (m.getDeclaringType().hasName("HtmlUtils") and m.hasName("htmlEscape")) or
      (m.getDeclaringType().hasName("ESAPI") and m.hasName("encodeForHTML"))
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call c | sanitizer.asExpr() = c.getACallTo(XssSanitizerMethod.getAMethod()))
  }
}

class XssSanitizerMethod extends Method {
  XssSanitizerMethod() {
    (this.hasName("forHtml") and this.getDeclaringType().hasName("Encode")) or
    (this.hasName("sanitize") and this.getDeclaringType().hasName("PolicyFactory")) or
    (this.hasName("scan") and this.getDeclaringType().hasName("AntiSamy")) or
    (this.hasName("clean") and this.getDeclaringType().hasName("JSoup")) or
    (this.getDeclaringType().hasName("StringEscapeUtils") and this.hasName("escapeHtml")) or
    (this.getDeclaringType().hasName("HtmlUtils") and this.hasName("htmlEscape")) or
    (this.getDeclaringType().hasName("ESAPI") and this.hasName("encodeForHTML"))
  }
}

from DataFlow::Node source, DataFlow::Node sink, DataFlow::Node sanitizer
where TaintTracking::localTaint(source, sink) and not TaintTracking::localTaint(source, sanitizer)
and source instanceof ServletRequestSource 
and sink instanceof DirectResponseWriterSink
and sanitizer instanceof XssSanitizer
select sink, "Potential XSS vulnerability: untrusted input flows directly to response writer", 
  source, "Source of user input"
