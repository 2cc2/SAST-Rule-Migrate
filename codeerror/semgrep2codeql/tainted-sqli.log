Rule Content:
/**
 * @name Tainted SQL Injection
 * @description Detected SQL statement that is tainted by `$EVENT` object. This could lead to SQL
 *    injection if variables in the SQL statement are not properly sanitized.
 *    Use parameterized SQL queries or properly sanitize user input instead.
 * @id tainted-sqli
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @tags security
 *       sql
 *       java
 *       aws-lambda
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 *       weakness
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.SpringFramework

class LambdaEventHandler extends Method {
  LambdaEventHandler() {
    (this.getName() matches "handle%" or this.getName() matches "process%") and
    exists(MethodAccess ma | ma.getMethod() = this |
      ma.getArgument(0).getType().toString().matches("%Event%") or
      ma.getArgument(0).getType() instanceof TypeInputStream
    )
  }
}

class TaintedSqlFlowConfiguration extends TaintTracking::Configuration {
  TaintedSqlFlowConfiguration() { this = "TaintedSqlFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m | m instanceof LambdaEventHandler |
      source.asParameter() = m.getParameter(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      // Statement creation
      (ma.getMethod().getName().matches("createStatement") or
       ma.getMethod().getName().matches("prepareStatement") or
       ma.getMethod().getName().matches("prepareCall")) and
      sink.asExpr() = ma.getAnArgument()
    )
    or
    // Spring JDBC operations
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("query%") or
      ma.getMethod().getName().matches("execute%") or
      ma.getMethod().getName().matches("update%") or
      ma.getMethod().getName().matches("batchUpdate") and
      sink.asExpr() = ma.getAnArgument()
    )
    or
    // Raw SQL string concatenation
    exists(StringConcatenation str |
      str.getAnOperand().toString().matches("(?i)^(SELECT|INSERT|UPDATE).*") and
      sink.asExpr() = str
    )
  }
}

from TaintedSqlFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection vulnerability from $@ to $@. Use parameterized queries.",
  source, source.toString(), sink, sink.toString()
