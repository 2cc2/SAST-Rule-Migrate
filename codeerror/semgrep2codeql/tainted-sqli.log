Rule Content:
/**
 * @name Tainted SQL Injection
 * @description Detected SQL statement that is tainted by $EVENT object. This could lead to SQL
 *              injection if variables in the SQL statement are not properly sanitized.
 *              Use parameterized SQL queries or properly sanitize user input instead.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 9.8
 * @precision medium
 * @id java/tainted-sqli
 * @tags security
 *       external/cwe/cwe-089
 *       owasp-a01
 *       owasp-a03
 *       injection
 *       sql
 *       java
 *       aws-lambda
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.FlowSources

class AWSLambdaEventSource extends DataFlow::Node {
  AWSLambdaEventSource() {
    // Handler with AWS Lambda Context
    exists(Method m, Parameter p |
      m.getDeclaringType().hasQualifiedName("com.amazonaws.services.lambda.runtime", "RequestHandler") and
      p = m.getAParameter() and
      not p.getType().hasName("Context") and
      this.asParameter() = p
    )
    or
    // Handler with InputStream/OutputStream
    exists(Method m, Parameter p |
      m.getDeclaringType().hasQualifiedName("java.io", "InputStream") and
      p = m.getAParameter() and
      not p.getType().hasName("Context") and
      this.asParameter() = p
    )
  }
}

class SQLSink extends DataFlow::Node {
  SQLSink() {
    exists(Expr ma |
      ma instanceof MethodAccess and
      ma.getMethod().getDeclaringType().getQualifiedName().matches("java.sql.%") and
      (
        ma.getMethod().hasName(["execute", "query", "executeUpdate", "batchUpdate"]) or
        ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
      ) and
      this.asExpr() = ma.getAnArgument()
    )
    or
    exists(Variable v |
      (
        exists(RefType t | t.hasQualifiedName("java.sql", "CallableStatement") and t = v.getType()) or
        exists(RefType t | t.hasQualifiedName("java.sql", "Statement") and t = v.getType()) or
        exists(RefType t | t.hasQualifiedName("java.sql", "PreparedStatement") and t = v.getType())
      ) and
      this.asExpr() = v.getAUse()
    )
  }
}

class TaintedSQLIConfig extends TaintTracking::TaintConfiguration {
  TaintedSQLIConfig() { this = "TaintedSQLIConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof AWSLambdaEventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SQLSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.getType() instanceof PrimitiveType or
    not exists(RefType rt | 
      rt.hasName("String") and 
      rt = sanitizer.getType().getASupertype*()
    )
  }
}

from TaintedSQLIConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL Injection from AWS Lambda event object."
