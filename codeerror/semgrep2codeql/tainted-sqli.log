Rule Content:
/**
 * @name Tainted SQL Injection in AWS Lambda
 * @description Detected SQL statement that is tainted by event object. This could lead to SQL
 *              injection if variables in the SQL statement are not properly sanitized.
 *              Use parameterized SQL queries or properly sanitize user input instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/tainted-sqli
 * @tags security
 *       sql
 *       java
 *       aws-lambda
 *       cwe-89
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringControllers

class LambdaHandlerMethod extends Method {
  LambdaHandlerMethod() {
    (this.getName().matches("handle%") or this.getName().matches("handleRequest%") or
     this.getName().matches("process%")) and
    (this.getDeclaringType().getASupertype*().hasQualifiedName("com.amazonaws.services.lambda.runtime", 
     "RequestHandler") or
     (this.getNumberOfParameters() >= 2 and
      this.getParameter(0).getType().hasName("InputStream") and
      this.getParameter(1).getType().hasName("OutputStream") and
      exists(Parameter p | this.getParameter(2).getType().hasQualifiedName(
        "com.amazonaws.services.lambda.runtime", "Context"))))
  }
}

class EventParameterSource extends DataFlow::Node {
  EventParameterSource() {
    exists(LambdaHandlerMethod m | m.getParameter(0) = this.asParameter())
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    // Statement creation variants
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("%Statement") and
       ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection")) or
      (ma.getMethod().getName().matches("prepareStatement") and
       ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection")) or
      ((ma.getMethod().getName().matches("queryFor%") or 
        ma.getMethod().getName().matches("execute%") or 
        ma.getMethod().getName().matches("batchUpdate")) and
       ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcOperations"))
    )
  }
}

class TaintedSqlFlowConfiguration extends TaintTracking::Configuration {
  TaintedSqlFlowConfiguration() { this = "TaintedSqlFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof EventParameterSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof SqlSink 
  }

  override predicate isSanitizer(DataFlow::Node node) {
    // Add sanitization checks if needed
    none()
  }
}

from TaintedSqlFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected SQL statement that is tainted by event object. This could lead to SQL injection."
