Rule Content:
/**
 * @name Tainted SQL Query in AWS Lambda
 * @description Detected SQL statement that is tainted by event object. This could lead to SQL
 *              injection if variables in the SQL statement are not properly sanitized.
 *              Use parameterized SQL queries or properly sanitize user input instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sqli-lambda
 * @tags security
 *       cwe
 *       cwe-89
 *       aws-lambda
 *       sql
 *       java
 *       owasp-a01
 *       owasp-a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.Method

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Method m | 
      (m.hasName("handleRequest") or 
       m.getAnAnnotation().getType().hasQualifiedName("com.amazonaws.services.lambda.runtime.annotations", "RequestHandler")) and
      (m.getParameter(0).getType().hasName("InputStream") or 
       m.getParameter(0).getType().hasName("APIGatewayProxyRequestEvent")) and
      this.asParameter() = m.getParameter(0)
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      (ma.getMethod().hasName("prepareStatement") or
       ma.getMethod().hasName("queryForObject") or
       ma.getMethod().hasName("queryForMap") or
       ma.getMethod().hasName("execute") or
       ma.getMethod().hasName("query") or
       ma.getMethod().hasName("executeUpdate") or
       ma.getMethod().hasName("batchUpdate")) and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Statement") and
      this.asExpr() = ma.getArgument(0)
    ) or
    exists(StringLiteral sql |
      sql.getValue().regexpMatch("(?i)^SELECT.*|^INSERT.*|^UPDATE.*") and
      this.asExpr() = sql
    )
  }
}

class TaintedSqlConfig extends TaintTracking::Configuration {
  TaintedSqlConfig() { this = "TaintedSqlConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }
}

from TaintedSqlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection from AWS Lambda event object", source,
  "This SQL query is constructed from user input which could lead to SQL injection."
