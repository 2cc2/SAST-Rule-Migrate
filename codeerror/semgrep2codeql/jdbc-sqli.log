            <origin_rule>
            以下是用户提交的规则代码，请进行转换：
            rules:
- id: jdbc-sqli
  message: >-
    Detected a formatted string in a SQL statement. This could lead to SQL
    injection if variables in the SQL statement are not properly sanitized.
    Use a prepared statements (java.sql.PreparedStatement) instead. You
    can obtain a PreparedStatement using 'connection.prepareStatement'.
  languages: [java]
  severity: WARNING
  patterns:
  - pattern-either:
    - patterns:
      - pattern-either:
        - pattern-inside: |
            String $SQL = $X + $Y;
            ...
        - pattern-inside: |
            String $SQL = String.format(...);
            ...
        - pattern-inside: |
            $VAL $FUNC(...,String $SQL,...) {
              ...
            }
      - pattern-not-inside: |
          String $SQL = "..." + "...";
          ...
      - pattern: $S.$METHOD($SQL,...)
    - pattern: |
        $S.$METHOD(String.format(...),...);
    - pattern: |
        $S.$METHOD($X + $Y,...);
  - pattern-either:
    - pattern-inside: |
        java.sql.Statement $S = ...;
        ...
    - pattern-inside: |
        $TYPE $FUNC(...,java.sql.Statement $S,...) {
          ...
        }
  - pattern-not: |
      $S.$METHOD("..." + "...",...);
  - metavariable-regex:
      metavariable: $METHOD
      regex: ^(executeQuery|execute|executeUpdate|executeLargeUpdate|addBatch|nativeSQL)$
  metadata:
    cwe:
    - "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"
    category: security
    technology:
    - jdbc
    owasp:
    - A01:2017 - Injection
    - A03:2021 - Injection
    references:
    - https://owasp.org/Top10/A03_2021-Injection
    cwe2022-top25: true
    cwe2021-top25: true
    subcategory:
    - audit
    likelihood: LOW
    impact: HIGH
    confidence: LOW
            </origin_rule>
            <example>
            请仿照下面提供的例子进行规则的编写，
            /**
 * @name CRLF Injection in Logs
 * @description When data from an untrusted source is put into a logger and not neutralized correctly,
 *              an attacker could forge log entries or include malicious content.
 * @kind path-problem
 * @problem.severity warning
 * @id java/crlf-injection-logs
 * @tags security
 *       external/cwe/cwe-93
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class Logger extends RefType {
  Logger() { 
    this.hasQualifiedName("org.slf4j", "Logger") or
    this.hasQualifiedName("org.apache.logging.log4j", "Logger")
  }
}

predicate isLoggerMethod(Method m) {
  m.getDeclaringType() instanceof Logger
}

class LoggerParameter extends DataFlow::Node {
  LoggerParameter() {
    exists(Expr ma |
      ma.(Call).getCallee().getName().matches("getParameter%") and
      ma.(Call).getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      this.asExpr() = ma
    )
  }
}

class LoggerSink extends DataFlow::Node {
  LoggerSink() {
    exists(Expr ma |
      (isLoggerMethod(ma.(Call).getCallee()) or ma.(Call).getCallee().getName().matches("log")) and
      this.asExpr() = ma.(Call).getArgument(0)
    )
  }
}

class LoggerConfig extends TaintTracking::Configuration {
  LoggerConfig() { this = "LoggerConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof LoggerParameter }

  override predicate isSink(DataFlow::Node sink) { sink instanceof LoggerSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from LoggerConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential CRLF injection in logs from untrusted source"
