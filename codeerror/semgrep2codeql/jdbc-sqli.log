Rule Content:
/**
 * @name JDBC SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 * injection if variables in the SQL statement are not properly sanitized.
 * Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/jdbc-sqli
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-564
 *       owasp-a01
 *       owasp-a03
 * @precision low
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.security.QueryInjection

class StringConcatenationInSql extends DataFlow::Node {
  StringConcatenationInSql() {
    exists(AddExpr add | 
      add.getAnOperand() = this.asExpr() and
      DataFlow::conditionalSinkExists(_, _, add.getResult(), _)
    )
    or
    exists(MethodAccess formatCall |
      formatCall.getMethod().hasName("format") and
      formatCall.getQualifier() != null and
      formatCall.getQualifier().getType().hasName("String") and
      DataFlow::conditionalSinkExists(_, _, formatCall, _)
    )
  }
}

class JdbcStatement extends DataFlow::Node {
  JdbcStatement() {
    getType() instanceof TypeClass and
    getType().hasQualifiedName("java.sql", "Statement")
  }
}

class SqlExecutionMethod extends Method {
  SqlExecutionMethod() {
    getName() in ["executeQuery", "execute", "executeUpdate", "executeLargeUpdate", "addBatch", "nativeSQL"] and
    getDeclaringType().hasQualifiedName("java.sql", "Statement")
  }
}

from StringConcatenationInSql sqlSource, JdbcStatement stmt, SqlExecutionMethod method, MethodAccess call
where
  call.getMethod() = method and
  DataFlow::localFlow(DataFlow::exprNode(sqlSource), DataFlow::exprNode(call.getArgument(0))) and
  call.getQualifier() = stmt.asExpr() and
  DataFlow::conditionalSink(_, _, sqlSource, _, _)
select call, "Potential SQL injection found. Use prepared statements instead.", sqlSource,
  "This SQL query is constructed with string concatenation which could lead to SQL injection."
