Rule Content:
/**
 * @name Cookie Missing Secure Flag
 * @description Detects cookies without the 'secure' flag set.
 * @kind problem
 * @problem.severity warning
 * @id java/cookie-missing-secure-flag
 * @tags security
 *       external/cwe/cwe-614
 *       external/owasp/a05:2021
 */

import java
import semmle.code.java.dataflow.DataFlow

predicate isSecureFlagSet(Call ma) {
  exists(Method m | 
    m.hasName("setSecure") and
    m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    ma.getCallee() = m and
    ma.getArgument(0).(BooleanLiteral).getValue() = true
  )
}

predicate isCookieInResponse(Call ma) {
  exists(Method m | 
    m.hasName("addCookie") and
    m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
    ma.getCallee() = m
  )
}

from Call cookieCreation, Call responseAdd, DataFlow::Node cookieNode
where
  // Match cookie creation
  cookieCreation.getCallee().getName() = "setValue" and
  // Avoid already secured cookies
  not exists(Call secureSet | 
    secureSet.getCallee().hasName("setSecure") and
    secureSet.getQualifier() = cookieCreation.getQualifier()
  ) and
  // Match response.addCookie()
  isCookieInResponse(responseAdd) and
  responseAdd.getArgument(0) = cookieCreation.getQualifier() and
  // Data flow from cookie creation to response addition
  cookieNode.asExpr() = responseAdd.getArgument(0) and
  cookieNode.asExpr() = cookieCreation.getQualifier()
select responseAdd, "A cookie is being added without setting the 'secure' flag. Consider setting it with 'setSecure(true)'."
