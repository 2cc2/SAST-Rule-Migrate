/**
 * @name Cookie Missing Secure Flag
 * @description Detects cookies without the 'secure' flag set, which could lead to transmission over insecure channels.
 * @kind problem
 * @id java/cookie-missing-secure-flag
 * @tags security
 *       external/cwe/cwe-614
 *       owasp/a05:2021
 * @problem.severity warning
 */

import java

from MethodAccess setSecureCall, MethodAccess addCookieCall, Expr cookie, MethodAccess cookieCreation,
    StringLiteral cookieName
where
  // Find cookie creations
  (cookieCreation.getMethod().getName() = "from" and cookieCreation.getMethod().getDeclaringType().hasQualifiedName("jakarta.servlet.http", "Cookie"))
  or
  (cookieCreation.getMethod().getName() = "newCookie" and cookieCreation.getMethod().getDeclaringType().hasQualifiedName("jakarta.servlet.http", "Cookie"))
  or
  (cookieCreation.getMethod().getName() = "clone" and cookieCreation.getMethod().getDeclaringType().hasQualifiedName("jakarta.servlet.http", "Cookie"))
  and
  cookie = cookieCreation.getQualifier() and
  // Find cookie additions without secure flag
  (
    // Case 1: setSecure(false) explicitly called
    (setSecureCall.getMethod().getName() = "setSecure" and setSecureCall.getArgument(0).(BooleanLiteral).getValue() = false)
    or
    // Case 2: No setSecure call before addCookie
    (
      addCookieCall.getMethod().getName() = "addCookie" and
      not exists(MethodAccess secureCall |
        secureCall.getMethod().getName() = "setSecure" and
        secureCall.getArgument(0).(BooleanLiteral).getValue() = true and
        secureCall.getQualifier() = cookie
      )
    )
  )
select addCookieCall, "A cookie was detected without setting the 'secure' flag. The 'secure' flag prevents transmission over insecure channels. Call setSecure(true) on the cookie."
