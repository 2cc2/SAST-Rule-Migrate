/**
 * @name GCM Nonce Reuse
 * @description Detects reuse of the same IV/nonce in GCM encryption, which can render the encryption ineffective.
 * @kind path-problem
 * @problem.severity error
 * @id java/gcm-nonce-reuse
 * @tags security
 *       external/cwe/cwe-323
 *       external/owasp/a02
 *       external/cryptographic-failure
 */

import java
import semmle.code.java.dataflow.TaintTracking

class GCMParameterSpec extends RefType {
  GCMParameterSpec() {
    this.hasQualifiedName("javax.crypto.spec", "GCMParameterSpec")
  }
}

class ConstantNonceSource extends DataFlow::Node {
  ConstantNonceSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "getBytes" and
      ma.getQualifier().(Literal).getStringValue() != "" and
      this.asExpr() = ma
    )
  }
}

class GCMParameterSpecSink extends DataFlow::Node {
  GCMParameterSpecSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType() instanceof GCMParameterSpec and
      (
        this.asExpr() = cc.getArgument(1) or
        exists(DataFlow::Node arg |
          arg.asExpr() = cc.getArgument(1) and
          arg.asExpr().(VarAccess).getVariable().getAnAssignedExpr() = this.asExpr()
        )
      )
    )
  }
}

class NonceReuseConfig extends TaintTracking::Configuration {
  NonceReuseConfig() { this = "NonceReuseConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof ConstantNonceSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof GCMParameterSpecSink }
}

from NonceReuseConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "GCM IV/nonce is reused: encryption can be totally ineffective"
