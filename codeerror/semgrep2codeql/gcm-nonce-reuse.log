/**
 * @name GCM IV/nonce reuse
 * @description Detects reuse of GCM IV/nonce which can make encryption effectively useless
 * @kind problem
 * @problem.severity error
 * @id java/gcm-nonce-reuse
 * @tags security
 *       external/cwe/cwe-323
 *       owasp/a02
 */

import java

from ConstructorCall gcmParamSpec, MethodAccess getBytes, ArrayCreation nonceArray
where
  (
    // Pattern 1: Direct byte array creation in GCMParameterSpec constructor
    (gcmParamSpec.getConstructor().getDeclaringType().hasQualifiedName("javax.crypto.spec", "GCMParameterSpec") and
    getBytes.getMethod().getName() = "getBytes" and
    gcmParamSpec.getAnArgument() = getBytes)
    or
    // Pattern 2: Byte array created separately then reused
    exists(DataFlow::Node source, DataFlow::Node sink |
      source.asExpr() = nonceArray and
      sink.asExpr() = gcmParamSpec.getAnArgument() and
      DataFlow::localFlow(source, sink) and
      exists(MethodAccess ma | ma = nonceArray.getAnOperand() | ma.getMethod().getName() = "getBytes")
    )
  )
select gcmParamSpec, "GCM IV/nonce is reused: encryption can be totally useless"
