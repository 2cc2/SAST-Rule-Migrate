/**
 * @name Formatted SQL String
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 * injection if variables in the SQL statement are not properly sanitized.
 * Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/formatted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.frameworks.spring.Spring
import semmle.code.java.StringOps
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow

class SQLInjectionConfig extends TaintTracking::Configuration {
  SQLInjectionConfig() { this = "SQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource
    or
    exists(Parameter p |
      p.getType().hasName("String") and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Expr arg |
      (m.getName().matches("execute%") or
       m.getName().matches("createQuery") or
       m.getName().matches("query") or
       m.getName().matches("addBatch") or
       m.getName().matches("nativeSQL") or
       m.getName().matches("create") or
       m.getName().matches("prepare")) and
      (m.getDeclaringType().hasQualifiedName("java.sql", "Statement") or
       m.getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
       m.getDeclaringType().hasQualifiedName("java.sql", "Connection") or
       m.getDeclaringType().hasQualifiedName("javax.persistence", "EntityManager")) and
      not arg.toString().matches(".*TABLE.*") and
      not arg.toString().matches(".*TABLE %s.*") and
      sink.asExpr() = arg
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("javax.persistence.criteria", "CriteriaBuilder") and
      sanitizer.asExpr() = m.getACall()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Method m, Expr qual |
      (m.getName() = "append" and
       (m.getDeclaringType().hasQualifiedName("java.lang", "StringBuffer") or
        m.getDeclaringType().hasQualifiedName("java.lang", "StringBuilder"))) and
      node1.asExpr() = m.getArgument(0) and
      node2.asExpr() = qual
    )
  }
}

