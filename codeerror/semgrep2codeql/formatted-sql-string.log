 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow

class FormattedSqlStringConfig extends TaintTracking::Configuration {
  FormattedSqlStringConfig() { this = "FormattedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p, Callable c |
      source.asParameter() = p and
      (p.getCallable().getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet.http", "HttpServletRequest") or
       p.getCallable().getDeclaringType().getASupertype*().hasQualifiedName("jakarta.servlet.http", "HttpServletRequest"))
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m |
      sink.asExpr() = m.getACall() and
      (m.getName().matches("execute%") or
       m.getName().matches("prepare%") or
       m.getName().matches("query%") or
       m.getName() = "nativeSQL" or
       m.getName() = "addBatch" or
       m.getName().matches("create%"))
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("javax.persistence.criteria", "CriteriaBuilder") and
      node.asExpr() = m.getACall()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Method m, DataFlow::CallNode call |
      (m.getName().matches("%add%") or
       m.getName().matches("%append%") or
       m.getName() = "concat" or
       m.getName() = "format" or
       m.getName() = "join") and
      call = m.getACall() and
      node1.asExpr() = call.getArgument(0) and
      node2.asExpr() = call
    )
  }
}

