Rule Content:
/**
 * @name Formatted SQL String
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 * injection if variables in the SQL statement are not properly sanitized.
 * Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/formatted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat

class SQLInjectionConfig extends TaintTracking::Configuration {
  SQLInjectionConfig() { this = "SQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodInput input |
      input instanceof HttpServletRequestParameter or
      input.isParameterOfAnnotatedMethod(["javax.servlet.http.HttpServletRequest"]) |
      source.asParameter() = input
    )
    or
    exists(MethodInput input |
      input instanceof StringParameter |
      source.asParameter() = input
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("execute%") or
       ma.getMethod().getName().matches("createQuery") or
       ma.getMethod().getName().matches("query") or
       ma.getMethod().getName().matches("addBatch") or
       ma.getMethod().getName().matches("nativeSQL") or
       ma.getMethod().getName().matches("create") or
       ma.getMethod().getName().matches("prepare")) and
      (ma.getQualifier().getType() instanceof Statement or
       ma.getQualifier().getType() instanceof PreparedStatement or
       ma.getQualifier().getType() instanceof Connection or
       ma.getQualifier().getType() instanceof EntityManager) and
      not ma.getArgument(0).toString().matches(".*TABLE.*") and
      not ma.getArgument(0).toString().matches(".*TABLE %s.*") |
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getQualifier().getType() instanceof CriteriaBuilder |
      sanitizer.asExpr() = ma
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "append" and
       (ma.getQualifier().getType() instanceof StringBuffer or
        ma.getQualifier().getType() instanceof StringBuilder)) |
      node1.asExpr() = ma.getArgument(0) and
      node2.asExpr() = ma.getQualifier()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SQLInjectionConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection from formatted string. Use prepared statements instead."
