import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class SqlInjectionConfiguration extends TaintTracking::Configuration {
  SqlInjectionConfiguration() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, Method m |
      ma.getMethod() = m and
      (m.hasName("getParameter") or m.getName().matches("%Request%")) and
      source.asExpr() = ma.getAnArgument()
    )
    or
    exists(Parameter p |
      source.asParameter() = p and
      p.getType() instanceof StringType
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("execute%") or
       ma.getMethod().getName().matches("createQuery") or
       ma.getMethod().getName().matches("prepareStatement") or
       ma.getMethod().getName().matches("nativeSQL") or
       ma.getMethod().getName().matches("addBatch")) and
      (ma.getQualifier().getType() instanceof Statement or
       ma.getQualifier().getType() instanceof PreparedStatement or
       ma.getQualifier().getType() instanceof Connection or
       ma.getQualifier().getType() instanceof EntityManager) and
      sink.asExpr() = ma.getAnArgument()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getQualifier().getType() instanceof CriteriaBuilder and
      sanitizer.asExpr() = ma.getAnArgument()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "append" and
       (ma.getQualifier().getType() instanceof StringBuffer or
        ma.getQualifier().getType() instanceof StringBuilder)) and
      node1.asExpr() = ma.getAnArgument() and
      node2.asExpr() = ma.getQualifier()
    )
  }
}

