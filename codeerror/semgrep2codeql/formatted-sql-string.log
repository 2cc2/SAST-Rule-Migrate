/**
 * @name Formatted SQL string
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 * injection if variables in the SQL statement are not properly sanitized.
 * Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @id java/sql-injection-formatted-string
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import java.sql.Statement
import java.sql.PreparedStatement
import java.sql.Connection
import javax.persistence.EntityManager
import javax.persistence.criteria.CriteriaBuilder
import java.lang.StringBuffer
import java.lang.StringBuilder

class SqlInjectionConfiguration extends TaintTracking::Configuration {
  SqlInjectionConfiguration() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Expr arg |
      (m.hasName("getParameter") or m.getName().matches("%Request%")) and
      m.getACall().getAnArgument() = arg and
      source.asExpr() = arg
    )
    or
    exists(Parameter p |
      source.asParameter() = p and
      p.getType().hasName("String")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Expr arg |
      (m.getName().matches("execute%") or
       m.getName().matches("createQuery") or
       m.getName().matches("prepareStatement") or
       m.getName().matches("nativeSQL") or
       m.getName().matches("addBatch")) and
      (m.getDeclaringType() instanceof TypeStatement or
       m.getDeclaringType() instanceof TypePreparedStatement or
       m.getDeclaringType() instanceof TypeConnection or
       m.getDeclaringType() instanceof TypeEntityManager) and
      m.getACall().getAnArgument() = arg and
      sink.asExpr() = arg
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Method m, Expr arg |
      m.getDeclaringType() instanceof TypeCriteriaBuilder and
      m.getACall().getAnArgument() = arg and
      sanitizer.asExpr() = arg
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Method m, Expr arg, Expr qualifier |
      m.getName() = "append" and
      (m.getDeclaringType() instanceof TypeStringBuffer or
       m.getDeclaringType() instanceof TypeStringBuilder) and
      m.getACall().getAnArgument() = arg and
      m.getACall().getQualifier() = qualifier and
      node1.asExpr() = arg and
      node2.asExpr() = qualifier
    )
  }
}

