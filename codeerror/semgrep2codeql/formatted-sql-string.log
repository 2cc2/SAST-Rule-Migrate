Rule Content:
/**
 * @name Formatted SQL String
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 * injection if variables in the SQL statement are not properly sanitized.
 * Use a prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @id java/sql-injection
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01
 *       external/owasp/a03
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat
import semmle.code.java.security.QueryInjection

class FormattedSqlStringConfig extends TaintTracking::Configuration {
  FormattedSqlStringConfig() { this = "FormattedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Expr ma | 
      ma.(MethodAccess).getCallee().getName() = "getParameter" and
      ma.(MethodAccess).getCallee().getDeclaringType().getQualifiedName() = "javax.servlet.http.HttpServletRequest" and
      source.asExpr() = ma.getArgument(0)
    )
    or
    exists(Method m, Parameter p | 
      m.getAnAnnotation().getType().getName() = "RequestMapping" and
      p = m.getAParameter() and
      p.getType() instanceof TypeString and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Expr ma |
      (ma.(MethodAccess).getCallee().getName().matches("execute%") or
       ma.(MethodAccess).getCallee().getName().matches("createQuery") or
       ma.(MethodAccess).getCallee().getName().matches("query%") or
       ma.(MethodAccess).getCallee().getName() = "addBatch" or
       ma.(MethodAccess).getCallee().getName() = "nativeSQL" or
       ma.(MethodAccess).getCallee().getName() = "create" or
       ma.(MethodAccess).getCallee().getName() = "prepare") and
      (ma.(MethodAccess).getReceiver().getType().getName() = "Statement" or
       ma.(MethodAccess).getReceiver().getType().getName() = "PreparedStatement" or
       ma.(MethodAccess).getReceiver().getType().getName() = "Connection" or
       ma.(MethodAccess).getReceiver().getType().getQualifiedName() = "javax.persistence.EntityManager") and
      sink.asExpr() = ma.getAnArgument()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Expr ma |
      ma.(MethodAccess).getCallee().getDeclaringType().getQualifiedName() = "javax.persistence.criteria.CriteriaBuilder" and
      sanitizer.asExpr() = ma
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Expr ma |
      (ma.(MethodAccess).getCallee().getName() = "append" and
       (ma.(MethodAccess).getReceiver().getType().getName() = "StringBuilder" or
        ma.(MethodAccess).getReceiver().getType().getName() = "StringBuffer")) and
      node1.asExpr() = ma.getArgument(0) and
      node2.asExpr() = ma.getReceiver()
    )
  }
}

