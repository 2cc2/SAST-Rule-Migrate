Rule Content:
/**
 * @name Formatted SQL String
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 *              injection if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/formatted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.security.QueryInjection
import semmle.code.java.frameworks.StatementExecution
import semmle.code.java.StringConcatenation
import semmle.code.java.security.SourceTracking

class FormattedSqlString extends QueryInjection::Range {
  FormattedSqlString() {
    exists(MethodAccess ma, Callable c |
      // Sources: HTTP request parameters or method inputs
      (SourceTracking::remoteUserInput(_, _, _, _, _) or
       any(Parameter p | c.getAParameter() = p).getAnAccess())
       and
      // Propagators: string concatenation operations
      (
        ma.getMethod().getName().matches("%add%") or
        ma.getMethod().getName().matches("%append%") or
        ma.getMethod().getName() = "concat" or
        ma.getMethod().getName() = "format" or
        ma.getMethod().getName() = "join"
      )
      and
      // Sinks: SQL execution methods
      (
        exists(StatementExecution::ExecutableSqlOperation eso |
          eso.getMethod().getName().matches("execute%") or
          eso.getMethod().getName().matches("prepare%") or
          eso.getMethod().getName().matches("query%") or
          eso.getMethod().getName().matches("nativeSQL") or
          eso.getMethod().getName().matches("addBatch") or
          eso.getMethod().getName().matches("create%")
        )
      )
      and
      // Exclude some false positives
      not exists(Literal l | l.getStringValue().matches("%TABLE *%"))
      and
      not exists(Literal l | l.getStringValue().matches("%TABLE %s%"))
    )
  }
}

