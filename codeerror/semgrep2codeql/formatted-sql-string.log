/**
 * @name Formatted SQL String
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 *              injection if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/formatted-sql-string
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph
import DataFlow::StringConcat

class FormattedSqlStringConfig extends TaintTracking::Configuration {
  FormattedSqlStringConfig() { this = "FormattedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p |
      m.getAReferenceArgument() = p.getAnAccess() and
      (p.getCallable().getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet.http", "HttpServletRequest") or
       p.getCallable().getDeclaringType().getASupertype*().hasQualifiedName("jakarta.servlet.http", "HttpServletRequest"))
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("execute%") or
      ma.getMethod().getName().matches("prepare%") or
      ma.getMethod().getName().matches("query%") or
      ma.getMethod().getName().matches("nativeSQL") or
      ma.getMethod().getName().matches("addBatch") or
      ma.getMethod().getName().matches("create%")
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(CriteriaBuilder cb | cb.getAMethodCall() = node.asExpr())
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("%add%") or
       ma.getMethod().getName().matches("%append%") or
       ma.getMethod().getName() = "concat" or
       ma.getMethod().getName() = "format" or
       ma.getMethod().getName() = "join") and
      ma.getReceiver() = node1.asExpr() and
      node2.asExpr() = ma
    )
  }
}

