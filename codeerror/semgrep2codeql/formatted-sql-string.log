Rule Content:
/**
 * @name Formatted SQL String
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 * injection if variables in the SQL statement are not properly sanitized.
 * Use a prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @id java/sql-injection
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01
 *       external/owasp/a03
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.security.QueryInjection

class FormattedSqlStringConfig extends TaintTracking::Configuration {
  FormattedSqlStringConfig() { this = "FormattedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma | 
      ma.getMethod().getName() = "getParameter" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      source.asExpr() = ma.getArgument(0)
    )
    or
    exists(Method m, Parameter p | 
      m.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestMapping") and
      p = m.getAParameter() and
      p.getType() instanceof TypeString and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("execute%") or
       ma.getMethod().getName() = "createQuery" or
       ma.getMethod().getName().matches("query%") or
       ma.getMethod().getName() = "addBatch" or
       ma.getMethod().getName() = "nativeSQL" or
       ma.getMethod().getName() = "create" or
       ma.getMethod().getName() = "prepare") and
      (ma.getQualifier().getType().hasName("Statement") or
       ma.getQualifier().getType().hasName("PreparedStatement") or
       ma.getQualifier().getType().hasName("Connection") or
       ma.getQualifier().getType().hasQualifiedName("javax.persistence", "EntityManager")) and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.persistence.criteria", "CriteriaBuilder") and
      sanitizer.asExpr() = ma
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "append" and
      (ma.getQualifier().getType().hasName("StringBuilder") or
       ma.getQualifier().getType().hasName("StringBuffer")) and
      node1.asExpr() = ma.getArgument(0) and
      node2.asExpr() = ma.getQualifier()
    )
  }
}

