/**
 * @name Spring Actuator Fully Enabled Vulnerability
 * @description Spring Boot Actuator is fully enabled, exposing sensitive endpoints without authentication.
 * @kind problem
 * @problem.severity warning
 * @id java/spring-actuator-fully-enabled
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a01
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.SpringBoot

class SpringActuatorConfig extends RefType {
  SpringActuatorConfig() { 
    this.hasQualifiedName("org.springframework.boot.actuate.autoconfigure", "EndpointAutoConfiguration")
  }
}

class ActuatorEndpoints extends DataFlow::Node {
  ActuatorEndpoints() {
    exists(Field f |
      f.getDeclaringType() instanceof SpringActuatorConfig and
      f.getName() = "endpoints" and
      this.asExpr() = f.getAnAccess()
    )
  }
}

class FullyEnabledCheck extends DataFlow::Node {
  FullyEnabledCheck() {
    exists(MethodAccess ma |
      ma.getCallee().getName() = "include" and
      ma.getAnArgument().getLiteralValue() = "*" and
      this.asExpr() = ma
    )
  }
}

class ActuatorConfig extends TaintTracking::Configuration {
  ActuatorConfig() { this = "ActuatorConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof ActuatorEndpoints }

  override predicate isSink(DataFlow::Node sink) { sink instanceof FullyEnabledCheck }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from ActuatorConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Spring Boot Actuator is fully enabled. This exposes sensitive endpoints such as /actuator/env, /actuator/logfile, /actuator/heapdump and others without authentication, causing a severe security risk."
