/**
 * @name Manifest Uses Cleartext Traffic True
 * @description The Android manifest is configured to allow non-encrypted connections.
 *              Evaluate if this is necessary for your app, and disable it if appropriate.
 *              This flag is ignored on Android 7 (API 24) and above if a Network Security
 *              Config is present.
 * @kind problem
 * @problem.severity warning
 * @precision high
 * @id android/manifest-uses-cleartext-traffic-true
 * @tags security
 *       android
 */

import java
import Xml

from XmlFile file, XmlAttribute attr
where
  file.getExtension() = "xml" and
  attr.getName() = "android:usesCleartextTraffic" and
  attr.getValue() = "true" and
  not exists(XmlComment c | c.containing(attr))
select attr, "The Android manifest is configured to allow non-encrypted connections."

/**
 * @name Manifest Uses Cleartext Traffic Ignored by NSC
 * @description Manifest uses both `android:usesCleartextTraffic` and Network Security Config.
 *              The `usesCleartextTraffic` directive is ignored on Android 7 (API 24) and above
 *              if a Network Security Config is present.
 * @kind problem
 * @problem.severity warning
 * @precision high
 * @id android/manifest-uses-cleartext-traffic-ignored
 * @tags security
 *       android
 */

import java
import Xml

from XmlFile file, XmlAttribute attr1, XmlAttribute attr2
where
  file.getExtension() = "xml" and
  ((attr1.getName() = "android:usesCleartextTraffic" and attr2.getName() = "android:networkSecurityConfig") or
   (attr1.getName() = "android:networkSecurityConfig" and attr2.getName() = "android:usesCleartextTraffic")) and
  attr1.getParent().getParent().getParent() = attr2.getParent().getParent().getParent() and
  not exists(XmlComment c | c.containing(attr1) or c.containing(attr2))
select attr1, "Manifest uses both `android:usesCleartextTraffic` and Network Security Config. "
             + "The `usesCleartextTraffic` directive is ignored on Android 7 (API 24) and above "
             + "if a Network Security Config is present."
