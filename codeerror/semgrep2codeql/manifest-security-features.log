/**
 * @name Android Manifest Cleartext Traffic Misconfiguration
 * @description The Android manifest is configured to allow non-encrypted connections
 *              or has conflicting configuration with Network Security Config
 * @kind problem
 * @problem.severity information
 * @id android/manifest-cleartext-traffic
 * @tags security
 *       best-practice
 *       external/android
 */

import xml

// Rule for detecting usesCleartextTraffic="true"
class CleartextTrafficEnabled extends XmlElement {
  CleartextTrafficEnabled() {
    getName() = "application" and
    exists(getAttribute("usesCleartextTraffic") |
      getAttribute("usesCleartextTraffic").getValue() = "true"
    )
  }
}

// Rule for detecting conflicting configurations
class ConflictingConfiguration extends XmlElement {
  ConflictingConfiguration() {
    getName() = "application" and
    exists(
      getAttribute("usesCleartextTraffic") and
      getAttribute("networkSecurityConfig")
    )
  }
}

from CleartextTrafficEnabled cfg
select cfg, "The Android manifest is configured to allow non-encrypted connections. " +
            "Evaluate if this is necessary for your app, and disable it if appropriate. " +
            "This flag is ignored on Android 7 (API 24) and above if a Network Security " +
            "Config is present."

from ConflictingConfiguration cfg
select cfg, "Manifest uses both `android:usesCleartextTraffic` and Network Security Config. " +
            "The `usesCleartextTraffic` directive is ignored on Android 7 (API 24) and above " +
            "if a Network Security Config is present."
