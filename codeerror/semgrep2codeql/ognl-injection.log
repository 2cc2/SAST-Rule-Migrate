import java

// Define the risky method patterns
private predicate isRiskyMethodInvocation(MethodCall mc) {
  exists(Method m | 
    (m.hasName("getGetMethod") or
     m.hasName("getSetMethod") or
     m.hasName("getField") or
     m.hasName("setProperties") or
     m.hasName("setProperty") or
     m.hasName("getValue") or
     m.hasName("setValue") or
     m.hasName("translateVariables") or
     m.hasName("translateVariablesCollection") or
     m.hasName("shallBeIncluded") or
     m.hasName("commaDelimitedStringToSet") or
     m.hasName("evaluate") or
     m.hasName("callMethod") or
     m.hasName("compile") or
     m.hasName("isTrue") or
     m.hasName("findString") or
     m.hasName("findValue") or
     m.hasName("getText") or
     m.hasName("makeSelectList") or
     m.hasName("setParameter")) 
    and
    m.getDeclaringType().getASupertype*() instanceof RefType t |
      t.hasQualifiedName("ognl", "OgnlReflectionProvider") or
      t.hasQualifiedName("ognl", "ReflectionProvider") or
      t.hasQualifiedName("ognl.text", "TextParseUtil") or
      t.hasQualifiedName("ognl", "TextParser") or
      t.hasQualifiedName("ognl", "OgnlTextParser") or
      t.hasQualifiedName("ognl", "OgnlUtil") or
      t.hasQualifiedName("ognl.webwork", "VelocityStrutsUtil") or
      t.hasQualifiedName("com.opensymphony.xwork2.util", "StrutsUtil") or
      t.hasQualifiedName("ognl", "OgnlTool") or
      t.hasQualifiedName("com.opensymphony.xwork2.util", "ValueStack")
    and
    mc.getMethod() = m
    and
    not mc.getArgument(0).isCompileTimeConstant()
    and
    not (exists(LocalVariableDecl lvd | 
      lvd.getInitializer().isCompileTimeConstant() 
      and 
      mc.getAnArgument() = lvd.getVariable().getAnAccess()
    ))
  )
}

// Exclude cases where arguments are string literals
private predicate isLiteralString(Expr arg) {
  arg.isCompileTimeConstant()
  or
  exists(LocalVariableDecl lvd | 
    lvd.getInitializer().isCompileTimeConstant() 
    and 
    arg = lvd.getVariable().getAnAccess()
  )
}

from MethodCall mc
where 
  isRiskyMethodInvocation(mc)
  and not isLiteralString(mc.getArgument(0))
select mc, "Potential OGNL injection. The source of the expression parameter should be verified."
