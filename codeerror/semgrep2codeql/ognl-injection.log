Rule Content:
/**
 * @name OGNL Injection
 * @description An expression is built with a dynamic value. The source of the value(s) should
 *              be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-94
 *       external/owasp/a03
 *       technology/ognl
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class OgnlInputSource extends DataFlow::Node {
  OgnlInputSource() {
    exists(MethodAccess ma |
      ma.getCallee().getName().matches("getParameter%") and
      ma.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      this.asExpr() = ma
    ) or
    exists(Method m | 
      m.getName().matches("get%") and
      not m.isStatic() and
      this.asExpr() = m.getAReference()
    )
  }
}

class OgnlMethods extends Method {
  OgnlMethods() {
    // OgnlReflectionProvider methods
    this.getName().matches("getGetMethod") or
    this.getName().matches("getSetMethod") or
    this.getName().matches("getField") or
    this.getName().matches("setProperties") or
    this.getName().matches("setProperty") or
    this.getName().matches("getValue") or
    this.getName().matches("setValue") or
    // ReflectionProvider methods (same as above)
    this.getName().matches("getGetMethod") or
    this.getName().matches("getSetMethod") or
    this.getName().matches("getField") or
    this.getName().matches("setProperties") or
    this.getName().matches("setProperty") or
    this.getName().matches("getValue") or
    this.getName().matches("setValue") or
    // TextParseUtil methods
    this.getName().matches("translateVariables") or
    this.getName().matches("translateVariablesCollection") or
    this.getName().matches("shallBeIncluded") or
    this.getName().matches("commaDelimitedStringToSet") or
    // TextParser/OgnlTextParser methods
    this.getName().matches("evaluate") or
    // OgnlUtil methods
    this.getName().matches("setProperties") or
    this.getName().matches("setProperty") or
    this.getName().matches("getValue") or
    this.getName().matches("setValue") or
    this.getName().matches("callMethod") or
    this.getName().matches("compile") or
    // VelocityStrutsUtil methods
    this.getName().matches("evaluate") or
    // StrutsUtil methods
    this.getName().matches("isTrue") or
    this.getName().matches("findString") or
    this.getName().matches("findValue") or
    this.getName().matches("getText") or
    this.getName().matches("translateVariables") or
    this.getName().matches("makeSelectList") or
    // OgnlTool methods
    this.getName().matches("findValue") or
    // ValueStack methods
    this.getName().matches("findString") or
    this.getName().matches("findValue") or
    this.getName().matches("setValue") or
    this.getName().matches("setParameter")
  }
}

class OgnlSink extends DataFlow::Node {
  OgnlSink() {
    exists(MethodAccess ma |
      ma.getCallee() instanceof OgnlMethods and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

predicate isLiteralOrFinalString(Expr e) {
  e instanceof StringLiteral or
  exists(Variable v |
    v.getType().hasName("String") and
    v.isFinal() and
    exists(v.getInitializer() | this = e)
  )
}

class OgnlConfig extends TaintTracking::Configuration {
  OgnlConfig() { this = "OgnlConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof OgnlInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof OgnlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    isLiteralOrFinalString(sanitizer.asExpr())
  }
}

from OgnlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential OGNL injection from untrusted source"
