/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should
 *              be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind problem
 * @problem.severity warning
 * @precision low
 * @id java/ognl-injection
 * @tags security
 *       cwe/94
 *       owasp/a03
 */

import java

// Define the vulnerable method calls
predicate isVulnerableCall(MethodAccessExpr ma) {
  ma.getMethod().hasName("getGetMethod") or
  ma.getMethod().hasName("getSetMethod") or
  ma.getMethod().hasName("getField") or
  ma.getMethod().hasName("setProperties") or
  ma.getMethod().hasName("setProperty") or
  ma.getMethod().hasName("getValue") or
  ma.getMethod().hasName("setValue") or
  ma.getMethod().hasName("translateVariables") or
  ma.getMethod().hasName("translateVariablesCollection") or
  ma.getMethod().hasName("shallBeIncluded") or
  ma.getMethod().hasName("commaDelimitedStringToSet") or
  ma.getMethod().hasName("evaluate") or
  ma.getMethod().hasName("callMethod") or
  ma.getMethod().hasName("compile") or
  ma.getMethod().hasName("isTrue") or
  ma.getMethod().hasName("findString") or
  ma.getMethod().hasName("findValue") or
  ma.getMethod().hasName("getText") or
  ma.getMethod().hasName("makeSelectList") or
  ma.getMethod().hasName("setParameter")
  and
  not ma.getArgument(1).(StringLiteral).exists()
}

// Define the vulnerable types
predicate isVulnerableType(RefType type) {
  type.hasQualifiedName("ognl", "ReflectionProvider") or
  type.hasQualifiedName("ognl", "OgnlReflectionProvider") or
  type.hasQualifiedName("ognl", "TextParseUtil") or
  type.hasQualifiedName("ognl", "TextParser") or
  type.hasQualifiedName("ognl", "OgnlTextParser") or
  type.hasQualifiedName("ognl", "OgnlUtil") or
  type.hasQualifiedName("ognl", "VelocityStrutsUtil") or
  type.hasQualifiedName("ognl", "StrutsUtil") or
  type.hasQualifiedName("ognl", "OgnlTool") or
  type.hasQualifiedName("ognl", "ValueStack")
}

from MethodAccessExpr ma, RefType type
where 
  isVulnerableCall(ma) and
  isVulnerableType(type) and
  ma.getQualifier().getType() = type
select ma, "Potential OGNL injection vulnerability. Verify the source of input values."
