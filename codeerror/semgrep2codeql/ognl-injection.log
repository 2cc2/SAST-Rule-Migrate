  type.hasQualifiedName("ognl", "OgnlReflectionProvider") or
  type.hasQualifiedName("ognl", "TextParseUtil") or
  type.hasQualifiedName("ognl", "TextParser") or
  type.hasQualifiedName("ognl", "OgnlTextParser") or
  type.hasQualifiedName("ognl", "OgnlUtil") or
  type.hasQualifiedName("ognl", "VelocityStrutsUtil") or
  type.hasQualifiedName("ognl", "StrutsUtil") or
  type.hasQualifiedName("ognl", "OgnlTool") or
  type.hasQualifiedName("ognl", "ValueStack")
}

from MethodAccess ma, RefType type
where 
  isVulnerableCall(ma) and
  isVulnerableType(type) and
  ma.getQualifier().getType() = type
select ma, "Potential OGNL injection vulnerability. Verify the source of input values."
