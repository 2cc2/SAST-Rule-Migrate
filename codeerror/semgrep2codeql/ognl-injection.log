Rule Content:
/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should
 *              be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-94
 *       external/owasp/a03
 *       external/cwe2022-top25
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class OgnlClass extends RefType {
  OgnlClass() {
    this.hasQualifiedName("ognl", "OgnlReflectionProvider") or
    this.hasQualifiedName("ognl", "ReflectionProvider") or
    this.hasQualifiedName("ognl", "TextParseUtil") or
    this.hasQualifiedName("ognl", "TextParser") or
    this.hasQualifiedName("ognl", "OgnlTextParser") or
    this.hasQualifiedName("ognl", "OgnlUtil") or
    this.hasQualifiedName("ognl", "VelocityStrutsUtil") or
    this.hasQualifiedName("ognl", "StrutsUtil") or
    this.hasQualifiedName("ognl", "OgnlTool") or
    this.hasQualifiedName("ognl", "ValueStack")
  }
}

class OgnlMethod extends Method {
  OgnlMethod() {
    this.getDeclaringType() instanceof OgnlClass and
    (
      this.getName() = "getGetMethod" or
      this.getName() = "getSetMethod" or
      this.getName() = "getField" or
      this.getName() = "setProperties" or
      this.getName() = "setProperty" or
      this.getName() = "getValue" or
      this.getName() = "setValue" or
      this.getName() = "translateVariables" or
      this.getName() = "translateVariablesCollection" or
      this.getName() = "shallBeIncluded" or
      this.getName() = "commaDelimitedStringToSet" or
      this.getName() = "evaluate" or
      this.getName() = "callMethod" or
      this.getName() = "compile" or
      this.getName() = "isTrue" or
      this.getName() = "findString" or
      this.getName() = "findValue" or
      this.getName() = "getText" or
      this.getName() = "makeSelectList" or
      this.getName() = "setParameter"
    )
  }
}

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(MethodAccess ma |
      ma.getCallee().getName().matches("getParameter%") and
      this.asExpr() = ma
    )
  }
}

class OgnlSink extends DataFlow::Node {
  OgnlSink() {
    exists(MethodAccess ma |
      ma.getCallee() instanceof OgnlMethod and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class OgnlConfig extends TaintTracking::Configuration {
  OgnlConfig() { this = "OgnlConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof OgnlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal literal | literal.getStringValue() != "" | sanitizer.asExpr() = literal)
  }
}

from OgnlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential OGNL injection from untrusted source"
