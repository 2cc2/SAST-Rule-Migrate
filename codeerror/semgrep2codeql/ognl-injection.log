/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should
 *              be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-094
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.RemoteFlowSource
import semmle.code.java.dataflow.TaintTracking

class OgnlInjectionConfig extends TaintTracking::Configuration {
  OgnlInjectionConfig() { this = "OgnlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(RemoteFlowSource rfs | source.asExpr() = rfs.getSource())
  }

  override predicate isSink(DataFlow::Node sink) {
    // Define all the sink patterns from the Semgrep rule as method calls
    exists(MethodAccess ma |
      (ma.getMethod().hasQualifiedName("ognl", "OgnlReflectionProvider", "getGetMethod") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlReflectionProvider", "getSetMethod") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlReflectionProvider", "getField") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlReflectionProvider", "setProperties") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlReflectionProvider", "setProperty") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlReflectionProvider", "getValue") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlReflectionProvider", "setValue") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "getGetMethod") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "getSetMethod") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "getField") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "setProperties") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "setProperty") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "getValue") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "setValue") or
       ma.getMethod().hasQualifiedName("ognl", "TextParseUtil", "translateVariables") or
       ma.getMethod().hasQualifiedName("ognl", "TextParseUtil", "translateVariablesCollection") or
       ma.getMethod().hasQualifiedName("ognl", "TextParseUtil", "shallBeIncluded") or
       ma.getMethod().hasQualifiedName("ognl", "TextParseUtil", "commaDelimitedStringToSet") or
       ma.getMethod().hasQualifiedName("ognl", "TextParser", "evaluate") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlTextParser", "evaluate") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlUtil", "setProperties") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlUtil", "setProperty") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlUtil", "getValue") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlUtil", "setValue") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlUtil", "callMethod") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlUtil", "compile") or
       ma.getMethod().hasQualifiedName("ognl", "VelocityStrutsUtil", "evaluate") or
       ma.getMethod().hasQualifiedName("ognl", "StrutsUtil", "isTrue") or
       ma.getMethod().hasQualifiedName("ognl", "StrutsUtil", "findString") or
       ma.getMethod().hasQualifiedName("ognl", "StrutsUtil", "findValue") or
       ma.getMethod().hasQualifiedName("ognl", "StrutsUtil", "getText") or
       ma.getMethod().hasQualifiedName("ognl", "StrutsUtil", "translateVariables") or
       ma.getMethod().hasQualifiedName("ognl", "StrutsUtil", "makeSelectList") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlTool", "findValue") or
       ma.getMethod().hasQualifiedName("ognl", "ValueStack", "findString") or
       ma.getMethod().hasQualifiedName("ognl", "ValueStack", "findValue") or
       ma.getMethod().hasQualifiedName("ognl", "ValueStack", "setValue") or
       ma.getMethod().hasQualifiedName("ognl", "ValueStack", "setParameter")) and
      sink.asExpr() = ma.getArgument(0) and
      not ma.getArgument(0).(StringLiteral).getValue().regexpMatch("\".*\"") and
      not exists(StringLiteral sl | sl = ma.getArgument(0))
    )
  }
}

