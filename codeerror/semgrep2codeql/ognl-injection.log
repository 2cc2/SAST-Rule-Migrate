Rule Content:
/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should
 *              be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-94
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class OgnlMethodCall extends MethodAccess {
  OgnlMethodCall() {
    exists(Method m | m = this.getMethod() |
      m.getName().matches("getGetMethod") or
      m.getName().matches("getSetMethod") or
      m.getName().matches("getField") or
      m.getName().matches("setProperties") or
      m.getName().matches("setProperty") or
      m.getName().matches("getValue") or
      m.getName().matches("setValue") or
      m.getName().matches("translateVariables") or
      m.getName().matches("translateVariablesCollection") or
      m.getName().matches("shallBeIncluded") or
      m.getName().matches("commaDelimitedStringToSet") or
      m.getName().matches("evaluate") or
      m.getName().matches("callMethod") or
      m.getName().matches("compile") or
      m.getName().matches("isTrue") or
      m.getName().matches("findString") or
      m.getName().matches("findValue") or
      m.getName().matches("getText") or
      m.getName().matches("makeSelectList") or
      m.getName().matches("setParameter")
    ) and
    (
      this.getReceiverType().hasQualifiedName("ognl", "OgnlReflectionProvider") or
      this.getReceiverType().hasQualifiedName("ognl", "ReflectionProvider") or
      this.getReceiverType().hasQualifiedName("ognl", "TextParseUtil") or
      this.getReceiverType().hasQualifiedName("ognl", "TextParser") or
      this.getReceiverType().hasQualifiedName("ognl", "OgnlTextParser") or
      this.getReceiverType().hasQualifiedName("ognl", "OgnlUtil") or
      this.getReceiverType().hasQualifiedName("ognl", "VelocityStrutsUtil") or
      this.getReceiverType().hasQualifiedName("ognl", "StrutsUtil") or
      this.getReceiverType().hasQualifiedName("ognl", "OgnlTool") or
      this.getReceiverType().hasQualifiedName("ognl", "ValueStack")
    )
  }
}

class OgnlSink extends DataFlow::Node {
  OgnlSink() {
    exists(OgnlMethodCall call |
      this.asExpr() = call.getArgument(0) and
      not call.getArgument(0).isStringLiteral() and
      not (
        exists(LocalVariableDeclaration var |
          var.getInitializer().isStringLiteral() and
          this.asExpr() = var.getVariable().getAnAccess()
        )
      )
    )
  }
}

class OgnlConfig extends TaintTracking::Configuration {
  OgnlConfig() { this = "OgnlConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OgnlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from OgnlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential OGNL injection from untrusted source"
