Rule Content:
/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should
 *              be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind problem
 * @problem.severity warning
 * @precision low
 * @id java/ognl-injection
 * @tags security
 *       cwe/94
 *       owasp/a03
 */

import java

// Define the vulnerable method calls
predicate isVulnerableCall(MethodAccess ma) {
  ma.getMethod().hasName([
    "getGetMethod", "getSetMethod", "getField", 
    "setProperties", "setProperty", "getValue", "setValue",
    "translateVariables", "translateVariablesCollection",
    "shallBeIncluded", "commaDelimitedStringToSet",
    "evaluate", "callMethod", "compile",
    "isTrue", "findString", "findValue",
    "getText", "makeSelectList", "setParameter"
  ]) and
  not ma.getArgument(1).(StringLiteral).exists() and
  not exists(BlockStmt b |
    b.getAllVariableDeclarations() |
    this instanceof StringLiteral |
    ma.getArgument(1) = result.getAChild()
  )
}

// Define the vulnerable types
predicate isVulnerableType(RefType type) {
  type.hasQualifiedName([
    "ognl", "ReflectionProvider",
    "ognl", "OgnlReflectionProvider",
    "ognl", "TextParseUtil",
    "ognl", "TextParser",
    "ognl", "OgnlTextParser",
    "ognl", "OgnlUtil",
    "ognl", "VelocityStrutsUtil",
    "ognl", "StrutsUtil",
    "ognl", "OgnlTool",
    "ognl", "ValueStack"
  ])
}

from MethodAccess ma, RefType type
where 
  isVulnerableCall(ma) and
  isVulnerableType(type) and
  ma.getQualifier().getType() = type
select ma, "Potential OGNL injection vulnerability. Verify the source of input values."
