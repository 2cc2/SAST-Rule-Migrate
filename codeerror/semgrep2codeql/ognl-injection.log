       ma.getMethod().hasQualifiedName("ognl", "OgnlReflectionProvider", "setValue") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "getGetMethod") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "getSetMethod") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "getField") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "setProperties") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "setProperty") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "getValue") or
       ma.getMethod().hasQualifiedName("ognl", "ReflectionProvider", "setValue") or
       ma.getMethod().hasQualifiedName("ognl", "TextParseUtil", "translateVariables") or
