       ma.getMethod().hasQualifiedName("ognl", "StrutsUtil", "makeSelectList") or
       ma.getMethod().hasQualifiedName("ognl", "OgnlTool", "findValue") or
       ma.getMethod().hasQualifiedName("ognl", "ValueStack", "findString") or
       ma.getMethod().hasQualifiedName("ognl", "ValueStack", "findValue") or
       ma.getMethod().hasQualifiedName("ognl", "ValueStack", "setValue") or
       ma.getMethod().hasQualifiedName("ognl", "ValueStack", "setParameter")) and
      sink.asExpr() = ma.getArgument(0) and
      not ma.getArgument(0).(StringLiteral).getValue().regexpMatch("\".*\"") and
      not exists(StringLiteral sl | sl = ma.getArgument(0))
    )
  }
}

