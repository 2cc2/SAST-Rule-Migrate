/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should
 *              be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-094
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::Configuration

class OgnlInjectionConfig extends TaintTracking::Configuration {
  OgnlInjectionConfig() { this = "OgnlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(RemoteFlowSource::Range rfs | source.asExpr() = rfs)
  }

  override predicate isSink(DataFlow::Node sink) {
    // Define all the sink patterns from the Semgrep rule as method calls
    exists(MethodAccessExpr ma |
