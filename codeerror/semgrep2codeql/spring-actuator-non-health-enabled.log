Rule Content:
/**
 * @name Spring Actuator Dangerous Endpoints Enabled
 * @description Detects if Spring Boot Actuators with potentially dangerous endpoints are exposed.
 * @kind path-problem
 * @problem.severity warning
 * @id java/spring-actuator-dangerous-endpoints-enabled
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a01
 * @precision high
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class ActuatorConfig extends DataFlow::Node {
  ActuatorConfig() {
    exists(Expr expr, Value val |
      expr instanceof FieldRead and
      expr.getField().getName().matches("management.endpoints.web.exposure.include") and
      val = expr.getValue() and
      not val.toString().matches(".*health.*") and
      not val.toString() = "*" and
      this.asExpr() = expr
    )
  }
}

class SpringActuatorConfig extends TaintTracking::Configuration {
  SpringActuatorConfig() { this = "SpringActuatorConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ActuatorConfig
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Expr expr |
      expr instanceof FieldRead and
      expr.getField().getName().matches("management.endpoints.web.exposure.include") and
      sink.asExpr() = expr
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr().toString().matches(".*health.*") or
    sanitizer.asExpr().toString() = "*"
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SpringActuatorConfig cfg
where cfg.hasFlowPath(source, sink)
select sink, "Spring Boot Actuators are enabled with potentially dangerous endpoints. Please verify if they are properly secured.",
  source, sink, "Dangerous actuator endpoints exposure"
