import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class ActuatorPropertySource extends DataFlow::Node {
  ActuatorPropertySource() {
    exists(Property p |
      p.getName().matches("management.endpoints.web.exposure.include") and
      not p.getStringValue().matches("*health*") and
      not p.getStringValue() = "*" and
      this.asExpr() = p.getValue()
    )
  }
}

class SpringActuatorConfig extends TaintTracking::Configuration {
  SpringActuatorConfig() { this = "SpringActuatorConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ActuatorPropertySource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Property p | sink.asExpr() = p.getValue())
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr().toString().matches("*health*") or
    sanitizer.asExpr().toString() = "*"
  }
}

