/**
 * @name Spring Actuator Dangerous Endpoints Enabled
 * @description Detects if Spring Boot Actuators with potentially dangerous endpoints are exposed.
 * @kind path-problem
 * @problem.severity warning
 * @id java/spring-actuator-dangerous-endpoints-enabled
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a01
 * @precision high
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringProperties

class ActuatorPropertySource extends DataFlow::Node {
  ActuatorPropertySource() {
    exists(SpringProperty p |
      p.getName() = "management.endpoints.web.exposure.include" and
      p.getValue().toString().matches("%health%") = false and
      p.getValue().toString().matches("%\\*%") = false and
      this.asExpr() = p.getValue()
    )
  }
}

class SpringActuatorConfig extends TaintTracking::Configuration {
  SpringActuatorConfig() { this = "SpringActuatorConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ActuatorPropertySource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SpringProperty p | sink.asExpr() = p.getValue())
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr().toString().matches("health") or
    sanitizer.asExpr().toString() = "*"
  }
}

from SpringActuatorConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Spring Boot Actuators are enabled with potentially dangerous endpoints. Please verify if they are properly secured."
