/**
 * @name Spring Actuator Dangerous Endpoints Enabled
 * @description Detects if potentially dangerous Spring Actuator endpoints are exposed.
 * @kind problem
 * @problem.severity warning
 * @id java/spring-actuator-dangerous-endpoints
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a05
 */

import java
import semmle.code.java.frameworks.spring.EndpointSupport

class DangerousEndpointAnnotation extends Annotation {
  DangerousEndpointAnnotation() {
    this.getType().hasQualifiedName("org.springframework.boot.actuate.endpoint.annotation", "Endpoint") and
    exists(string id | 
      id = this.getAValue("id").getStringValue() and
      (id = "prometheus" or id = "logfile")
    )
  }
}

from DangerousEndpointAnnotation endpoint
select endpoint, "Potentially dangerous Spring Actuator endpoint '$@' is exposed",
  endpoint.getAValue("id").getStringValue(), "endpoint"
