/**
 * @name Spring Actuator Dangerous Endpoints Enabled
 * @description Detects if potentially dangerous Spring Actuator endpoints are exposed.
 * @kind problem
 * @problem.severity warning
 * @id java/spring-actuator-dangerous-endpoints
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a05
 */

import java
import semmle.code.yaml.properties.YAML

class SpringActuatorConfig extends YAML::Value {
  SpringActuatorConfig() {
    this.getFile().getAbsolutePath().matches("%application.yml") or
    this.getFile().getAbsolutePath().matches("%application.yaml")
  }
}

class DangerousEndpoint extends YAML::Value {
  DangerousEndpoint() {
    this.getParent().(YAML::KeyValue).getKeyText() = "include" and
    exists(string endpoint | 
      this.getText() = endpoint and
      endpoint = "prometheus" or endpoint = "logfile"
    )
  }
}

from SpringActuatorConfig config, DangerousEndpoint endpoint
where endpoint.getParent+() = config
select endpoint, "Potentially dangerous Spring Actuator endpoint '$@' is exposed",
  endpoint.getText(), "endpoint"
