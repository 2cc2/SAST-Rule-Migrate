Rule Content:
/**
 * @name MongoDB NoSQL Injection
 * @description Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator.
 * @kind problem
 * @problem.severity warning
 * @id java/mongodb-nosqli
 * @tags security
 *       external/cwe/cwe-943
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 *       external/nosql
 *       external/mongodb
 */

import java

// Basic pattern of putting $where clause directly
from MethodAccess putCall, MethodAccess putAllCall, MethodAccess appendCall, 
     ObjectCreation basicDBObjectCreation, ObjectCreation basicDBObjectWithMapCreation,
     MethodAccess startCall, MethodAccess startWithMapCall, MethodAccess addCall, 
     MethodAccess appendCallOnBuilder
where
  // .put("$where", ...)
  (putCall.getTarget().getName() = "put" and 
   putCall.getTarget().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
   exists(putCall.getAnArgument().(StringLiteral).getValue()) and 
   putCall.getAnArgument().(StringLiteral).getValue() = "$where") 
  or
  // .putAll(map) after .put("$where") into map
  (putAllCall.getTarget().getName() = "putAll" and 
   putAllCall.getTarget().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
   exists(MethodAccess mapPut | 
     mapPut.getTarget().getName() = "put" and
     mapPut.getTarget().getDeclaringType().hasQualifiedName("java.util", "HashMap") and
     exists(mapPut.getAnArgument().(StringLiteral).getValue()) and
     mapPut.getAnArgument().(StringLiteral).getValue() = "$where" and
     mapPut.getQualifier() = putAllCall.getAnArgument()))
  or
  // .append("$where", ...)
  (appendCall.getTarget().getName() = "append" and 
   appendCall.getTarget().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
   exists(appendCall.getAnArgument().(StringLiteral).getValue()) and 
   appendCall.getAnArgument().(StringLiteral).getValue() = "$where")
  or
  // new BasicDBObject("$where", ...)
  (basicDBObjectCreation.getConstructedType().hasQualifiedName("com.mongodb", "BasicDBObject") and
   exists(basicDBObjectCreation.getAnArgument().(StringLiteral).getValue()) and
   basicDBObjectCreation.getAnArgument().(StringLiteral).getValue() = "$where")
  or
  // new BasicDBObject(map) after .put("$where") into map
  (basicDBObjectWithMapCreation.getConstructedType().hasQualifiedName("com.mongodb", "BasicDBObject") and
   exists(MethodAccess mapPut |
     mapPut.getTarget().getName() = "put" and
     mapPut.getTarget().getDeclaringType().hasQualifiedName("java.util", "HashMap") and
     exists(mapPut.getAnArgument().(StringLiteral).getValue()) and
     mapPut.getAnArgument().(StringLiteral).getValue() = "$where" and
     mapPut.getQualifier() = basicDBObjectWithMapCreation.getAnArgument()))
  or
  // BasicDBObjectBuilder.start().add("$where", ...)
  (addCall.getTarget().getName() = "add" and 
   addCall.getTarget().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObjectBuilder") and
   exists(addCall.getAnArgument().(StringLiteral).getValue()) and 
   addCall.getAnArgument().(StringLiteral).getValue() = "$where" and
   addCall.getQualifier() = startCall.getQualifier())
  or
  // BasicDBObjectBuilder.start().append("$where", ...)
  (appendCallOnBuilder.getTarget().getName() = "append" and 
   appendCallOnBuilder.getTarget().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObjectBuilder") and
   exists(appendCallOnBuilder.getAnArgument().(StringLiteral).getValue()) and 
   appendCallOnBuilder.getAnArgument().(StringLiteral).getValue() = "$where" and
   appendCallOnBuilder.getQualifier() = startCall.getQualifier())
  or
  // BasicDBObjectBuilder.start("$where", ...)
  (startCall.getTarget().getName() = "start" and 
   startCall.getTarget().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObjectBuilder") and
   exists(startCall.getAnArgument().(StringLiteral).getValue()) and 
   startCall.getAnArgument().(StringLiteral).getValue() = "$where")
  or
  // BasicDBObjectBuilder.start(map) after .put("$where") into map
  (startWithMapCall.getTarget().getName() = "start" and 
   startWithMapCall.getTarget().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObjectBuilder") and
   exists(MethodAccess mapPut |
     mapPut.getTarget().getName() = "put" and
     mapPut.getTarget().getDeclaringType().hasQualifiedName("java.util", "HashMap") and
     exists(mapPut.getAnArgument().(StringLiteral).getValue()) and
     mapPut.getAnArgument().(StringLiteral).getValue() = "$where" and
     mapPut.getQualifier() = startWithMapCall.getAnArgument()))
select putCall, "Non-constant data passed into a NoSQL query using the 'where' operator. This could lead to NoSQL injection."
