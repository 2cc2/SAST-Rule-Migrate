Rule Content:
/**
 * @name Spring Actuator Fully Enabled
 * @description Detects when Spring Actuator endpoints are fully exposed (include: "*"), which could lead
 *              to sensitive information disclosure or unauthorized access.
 * @kind path-problem
 * @problem.severity warning
 * @id java/spring-actuator-fully-enabled
 * @tags security
 *       external/owasp/a06
 */

import java
import semmle.code.yaml.YAML

class SpringActuatorConfig extends YAML::Value {
  SpringActuatorConfig() {
    exists(YAML::Map management |
      management.hasKey("management") and
      exists(YAML::Map endpoints |
        management.get("management").(YAML::Map).get("endpoints") = endpoints and
        exists(YAML::Map web |
          endpoints.get("web") = web and
          exists(YAML::Value exposure |
            web.get("exposure") = exposure and
            exists(YAML::Value include |
              exposure.(YAML::Map).get("include") = include and
              include.(YAML::Scalar).getStringValue() = "*" and
              this = include
            )
          )
        )
      )
    )
  }
}

from SpringActuatorConfig config
select config, "Spring Actuator endpoints are fully exposed (include: '*'). This may lead to sensitive information disclosure."
