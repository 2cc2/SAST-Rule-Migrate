/**
 * @name Spring Actuator Fully Enabled
 * @description Detects when Spring Actuator endpoints are fully exposed (include: "*"), which could lead
 *              to sensitive information disclosure or unauthorized access.
 * @kind path-problem
 * @problem.severity warning
 * @id java/spring-actuator-fully-enabled
 * @tags security
 *       external/owasp/a06
 */

import java
import semmle.code.java.frameworks.spring.Spring

class ActuatorEndpointExposure extends Expr {
  ActuatorEndpointExposure() {
    exists(Field f |
      f.getAnnotatedElement().getAnnotations().getType().hasQualifiedName("org.springframework.boot.actuate.autoconfigure.endpoint.web", 
        "WebEndpointProperties") and
      this = f.getInitializer() and
      this.toString().matches("%exposure.include%") and
      this.toString().contains("\"*\"")
    )
  }
}

from ActuatorEndpointExposure exposure
select exposure, "Spring Actuator endpoints are fully exposed (include: '*'). This may lead to sensitive information disclosure."
