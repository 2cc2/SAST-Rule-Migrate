/**
 * @name Spring Actuator Fully Enabled
 * @description Detects when Spring Actuator endpoints are fully exposed (include: "*")
 * @kind path-problem
 * @problem.severity warning
 * @id java/spring-actuator-fully-enabled
 * @tags security
 *       external/cwe/cwe-200
 */

import java
import semmle.code.yaml.Yaml

predicate isActuatorFullyEnabledYaml(YamlValue exposure) {
  exists(YamlMapping mapping |
    exposure = mapping and
    mapping.getPair("include").getScalarValue().getStringValue() = "*"
  )
}

from YamlFile file, YamlValue exposure
where
  exists(YamlPath path |
    path = file.getPath("management.endpoints.web.exposure") and
    exposure = file.getAtPath(path) and
    isActuatorFullyEnabledYaml(exposure)
  )
select exposure, "Spring Actuator endpoints are fully exposed (include: \"*\"), this may leak sensitive information."
