Rule Content:
/**
 * @name Tainted session from HTTP request
 * @description Detected input from a HTTPServletRequest going into a session command, like `setAttribute`.
 *              User input into such commands could lead to trust boundary violations.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-session-from-http-request
 * @tags security
 *       external/cwe/cwe-501
 *       external/owasp/a04
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class TaintedSessionRequestConfiguration extends TaintTracking::TaintTrackingConfiguration {
  TaintedSessionRequestConfiguration() { this = "TaintedSessionRequestConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    // Source patterns from servlet request
    exists(MethodAccess ma, Method m |
      ma.(MethodAccess).getMethod() = m and
      m.getDeclaringType() instanceof HttpServletRequest and
      not m.hasName("getSession") and
      source.asExpr() = ma.getQualifier()
    )
    or
    // Source from cookies
    exists(VariableDeclarator lvd, ArrayCreationExpr ac, MethodAccess ma |
      lvd.getInit() = ac and
      ac.getType().hasName("javax.servlet.http.Cookie[]") and
      ma.(MethodAccess).getMethod().hasName("getCookies") and
      ma.getQualifier().getType() instanceof HttpServletRequest and
      exists(ForStmt fs, VariableDeclarator cookieVar |
        fs.getInit() = cookieVar and
        exists(MethodAccess cookieGetValue |
          cookieGetValue.(MethodAccess).getMethod().hasName("getValue") and
          source.asExpr() = cookieGetValue
        )
      )
    )
    or
    // Source from request parameters
    exists(VariableDeclarator lvd, MethodAccess ma |
      lvd.getInit() = ma and
      ma.(MethodAccess).getMethod().getDeclaringType() instanceof HttpServletRequest and
      exists(ArrayAccess aa |
        aa.getArray() = lvd.getVariable().getAnAccess() and
        source.asExpr() = aa
      )
    )
    or
    // Source from request headers that are later decoded
    exists(MethodAccess getHeaders, MethodAccess headerFunc, MethodAccess decode |
      getHeaders.(MethodAccess).getMethod().hasName("getHeaders") and
      headerFunc.getQualifier() = getHeaders and
      decode.(MethodAccess).getMethod().hasName("decode") and
      decode.getArgument(0) = headerFunc and
      decode.getArgument(0).getType() instanceof java.net.URLDecoder and
      source.asExpr() = decode
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma, Method m |
      ma.(MethodAccess).getMethod() = m and
      m.getDeclaringType().hasName("HttpSession") and
      (m.hasName("putValue") or m.hasName("setAttribute")) and
      sink.asExpr() = ma.getArgument(1)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSessionRequestConfiguration conf
where conf.hasFlowPath(source, sink)
select sink, source, sink,
  "Input from HTTP request flows into session command $@, potentially causing trust boundary violation.",
  source.getNode(),
  "User input flows here"
