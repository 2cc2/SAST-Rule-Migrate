Rule Content:
/**
 * @name Tainted session from HTTP request
 * @description Detected input from a HTTPServletRequest going into a session command, like `setAttribute`.
 *              User input into such a command could lead to an attacker inputting malicious code into your session
 *              parameters, blurring the line between what's trusted and untrusted (trust boundary violation).
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @id java/tainted-session-from-http-request
 * @tags security
 *       external/cwe/cwe-501
 *       owasp/a04
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(Call ma |
      ma.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      (
        ma.getCallee().getName().matches("getParameter%") or
        ma.getCallee().getName() = "getHeader" or
        ma.getCallee().getName() = "getHeaders" or
        ma.getCallee().getName() = "getCookies"
      ) and
      this.asExpr() = ma
    )
    or
    exists(Call cgv | 
      cgv.getCallee().getName() = "getValue" and
      cgv.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.asExpr() = cgv.getAnArgument()
    )
    or
    exists(ArrayAccess aa |
      exists(VariableDeclaration lvda |
        lvda.getType().hasUnderlyingType("[]") and
        lvda.getInitializer().getExpr().(Call).getCallee().getDeclaringType().
          hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
        aa.getArray().getAChild*() = lvda.getAnAccess() and
        this.asExpr() = aa
      )
    )
    or
    exists(Call ma |
      ma.getCallee().getName() = "decode" and
      ma.getCallee().getDeclaringType().hasQualifiedName("java.net", "URLDecoder") and
      exists(Call headerAccess |
        headerAccess.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
        headerAccess.getCallee().getName().matches("getHeader%") and
        this.asExpr().getAChild*() = headerAccess
      )
    )
  }
}

class SessionSink extends DataFlow::Node {
  SessionSink() {
    exists(Call ma |
      ma.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpSession") and
      ma.getCallee().getName().matches(["putValue", "setAttribute"]) and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class TaintedSessionFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedSessionFromHttpRequestConfig() { this = any() }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SessionSink }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSessionFromHttpRequestConfig cfg
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potentially tainted data from HTTP request flows into session"
