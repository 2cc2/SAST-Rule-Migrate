Rule Content:
/**
 * @name Tainted Session from HTTP Request
 * @description Detected input from a HTTPServletRequest going into a session command like setAttribute.
 *              User input into such commands could lead to trust boundary violations.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-session-from-http-request
 * @tags security
 *       external/cwe/cwe-501
 *       external/owasp/a04
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class HttpServletRequestSource extends DataFlow::Node {
  HttpServletRequestSource() {
    exists(Expr ma |
      // Pattern 1: Direct HttpServletRequest methods
      (ma.(Call).getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
       not ma.(Call).getCallee().getName().matches("getSession") and
       this.asExpr() = ma) or
      
      // Pattern 2: Cookie values
      exists(LocalVariableDecl cookieArray, ForStmt forLoop |
        cookieArray.getAnAssignedValue().(Call).getCallee().getName() = "getCookies" and
        forLoop.getAChild() = cookieArray.getVariable(0).getAnAccess() and
        ma.(Call).getCallee().getName() = "getValue" and
        this.asExpr() = ma
      ) or
      
      // Pattern 3: Array values from request
      exists(LocalVariableDecl arrayDecl, ArrayAccess arrayAccess |
        arrayDecl.getAnAssignedValue().(Call).getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
        arrayAccess.getArray() = arrayDecl.getVariable(0).getAnAccess() and
        this.asExpr() = arrayAccess
      ) or
      
      // Pattern 4: Decoded request headers
      exists(Expr decodeCall |
        decodeCall.(Call).getCallee().hasQualifiedName("java.net", "URLDecoder", "decode") and
        exists(LocalVariableDecl headerDecl |
          headerDecl.getAnAssignedValue().(Call).getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
          decodeCall.(Call).getArgument(0) = headerDecl.getVariable(0).getAnAccess() and
          this.asExpr() = decodeCall
        )
      )
    )
  }
}

class SessionSink extends DataFlow::Node {
  SessionSink() {
    exists(MethodAccess ma |
      ma.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      ma.getCallee().getName() = "getSession" and
      exists(Expr sessionCall |
        sessionCall.(Call).getCallee().getName().regexpMatch("^(putValue|setAttribute)$") and
        this.asExpr() = sessionCall.(Call).getArgument(1)
      )
    )
  }
}

class SessionTaintConfig extends TaintTracking::Configuration {
  SessionTaintConfig() { this = "SessionTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpServletRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SessionSink }
}

from SessionTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential trust boundary violation: user input flows into session parameters"
