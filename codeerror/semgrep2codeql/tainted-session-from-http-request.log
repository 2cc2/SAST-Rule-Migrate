/**
 * @name Tainted session from HTTP request
 * @description Detected input from a HTTPServletRequest going into a session command.
 * @id java/tainted-session-from-http-request
 * @kind path-problem
 * @security-severity 7.5
 * @problem.severity warning
 * @precision medium
 * @tags security
 *       external/cwe/cwe-501
 *       owasp-a04
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpRequestSessionTaintedFlow extends TaintTracking::Configuration {
  HttpRequestSessionTaintedFlow() { this = "HttpRequestSessionTaintedFlow" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodCall ma |
      ma.getMethod().getDeclaringType() instanceof HttpServletRequest and
      not ma.getMethod().hasName("getSession") and
      source.asExpr() = ma
    )
    or
    exists(Variable lvd, ArrayAccess aa |
      lvd.getType() instanceof Array and
      exists(MethodCall initMa | lvd.getInitializer() = initMa.getExpr()) and
      aa.getArray() = lvd.getAnAccess() and
      source.asExpr() = aa
    )
    or
    exists(MethodCall ma, MethodCall decode |
      ma.getMethod().getDeclaringType() instanceof HttpServletRequest and
      ma.getMethod().hasName("getHeaders") and
      decode.getMethod().hasName("decode") and
      decode.getMethod().getDeclaringType().hasQualifiedName("java.net", "URLDecoder") and
      source.asExpr() = decode.getArgument(0)
    )
    or
    exists(Variable lvd |
      lvd.getType() instanceof Array and
      exists(MethodCall ma | 
        ma.getMethod().getName() = "getCookies" and
        lvd.getInitializer() = ma.getExpr()
      ) and
      exists(VariableAccess va | 
        va.getVariable() = lvd and
        exists(MethodCall cookieMa |
          cookieMa.getMethod().getName() = "getValue" and
          source.asExpr() = cookieMa
        )
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall sessionMa |
      sessionMa.getMethod().getName().matches("putValue|setAttribute") and
      exists(MethodCall getSessionMa | 
        getSessionMa.getMethod().hasName("getSession") and
        sessionMa.getQualifier() = getSessionMa
      ) and
      sink.asExpr() = sessionMa.getArgument(1)
    )
  }
}

