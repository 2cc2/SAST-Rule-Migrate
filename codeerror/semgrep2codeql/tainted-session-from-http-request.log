Rule Content:
/**
 * @name Tainted session from HTTP request
 * @description Detected input from a HTTPServletRequest going into a session command, like `setAttribute`.
 *              User input into such a command could lead to an attacker inputting malicious code into your session
 *              parameters, blurring the line between what's trusted and untrusted (trust boundary violation).
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @id java/tainted-session-from-http-request
 * @tags security
 *       external/cwe/cwe-501
 *       owasp/a04
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      (
        ma.getMethod().getName().matches("getParameter%") or
        ma.getMethod().getName() = "getHeader" or
        ma.getMethod().getName() = "getHeaders" or
        ma.getMethod().getName() = "getCookies"
      ) and
      this.asExpr() = ma
    )
    or
    exists(CookieGetValue cgv | this.asExpr() = cgv.getAChildExpr())
    or
    exists(ArrayAccess aa |
      exists(LocalVariableDeclArray lvda |
        lvda.getInitializer().getExpr().(MethodAccess).getMethod().getDeclaringType().
          hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
        aa.getArray().getAChild*() = lvda.getAVariable().getAnAccess() and
        this.asExpr() = aa
      )
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "decode" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.net", "URLDecoder") and
      exists(MethodAccess headerAccess |
        headerAccess.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
        headerAccess.getMethod().getName().matches("getHeader%") and
        this.asExpr().getAChild*() = headerAccess
      )
    )
  }
}

class SessionSink extends DataFlow::Node {
  SessionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpSession") and
      ma.getMethod().getName().matches(["putValue", "setAttribute"]) and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class TaintedSessionFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedSessionFromHttpRequestConfig() { this = "TaintedSessionFromHttpRequestConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SessionSink }
}

from TaintedSessionFromHttpRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potentially tainted data from HTTP request flows into session"
