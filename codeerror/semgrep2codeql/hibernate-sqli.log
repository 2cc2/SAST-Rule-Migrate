 * @description Detects formatted strings in SQL statements that could lead to SQL injection.
 * @kind path-problem
 * @problem.severity warning
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       owasp-a01:2017
 *       owasp-a03:2021
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringConstruction

predicate isHibernateSession(Expr e) {
  exists(Method m | 
    e = m.getADataFlowNode() and
    m.getDeclaringType().getName() = "Session" and
    m.getDeclaringType().getPackage().getName() = "org.hibernate"
  )
  or
  exists(Variable v | 
    e = v.getAnAccess() and
    v.getType().getName() = "Session" and
    v.getType().getPackage().getName() = "org.hibernate"
  )
}

from MethodCall ma, DataFlow::Node sqlArg, StringConcatExpr sce
where
  (
    // Cases for Restrictions.sqlRestriction
    (
      ma.getMethod().hasName("sqlRestriction") and
      ma.getMethod().getDeclaringType().getName() = "Restrictions" and
      ma.getMethod().getDeclaringType().getPackage().getName() = "org.hibernate.criterion" and
      sqlArg.asExpr() = ma.getArgument(0)
    )
    or
    // Cases for Session.createQuery/createSQLQuery
    (
      ma.getMethod().getName() in ["createQuery", "createSQLQuery"] and
      isHibernateSession(ma.getQualifier()) and
      sqlArg.asExpr() = ma.getArgument(0)
    )
  )
  and
  (
    // String concatenation case
    exists(sce | 
      sqlArg.asExpr() = sce and
      not exists(StringLiteral sl | sce.getAnOperand() = sl)
    )
    or
    exists(MethodAccess fmt | 
      fmt.getMethod().hasName("format") and
      fmt.getMethod().getDeclaringType().getName() = "String" and
      sqlArg.asExpr() = fmt
    )
  )
select sqlArg, 
  "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables are not properly sanitized. Use PreparedStatement instead."
