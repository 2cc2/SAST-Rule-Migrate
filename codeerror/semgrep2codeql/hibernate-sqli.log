Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 * injection if variables in the SQL statement are not properly sanitized.
 * Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-564
 *       owasp/a1
 *       owasp/a3
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class HibernateSQLInjectionConfig extends TaintTracking::Configuration {
  HibernateSQLInjectionConfig() { this = "HibernateSQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Expr e |
      e = source.asExpr() and
      (
        isConcatenatedString(e)
        or
        exists(StringFormat fmt | fmt = e)
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Expr arg |
      m = sink.asExpr().(MethodAccess).getMethod() and
      arg = sink.asExpr().(MethodAccess).getArgument(0) and
      (
        (m.hasQualifiedName(["org.hibernate.criterion", "Restrictions"], "sqlRestriction") and arg = sink.asExpr())
        or
        (m.getName() in ["createQuery", "createSQLQuery"] and
         m.getDeclaringType().hasQualifiedName("org.hibernate", "Session") and
         arg = sink.asExpr())
      )
    )
  }
}

predicate isConcatenatedString(Expr e) {
  exists(BinaryExpr be |
    be instanceof AddExpr and
    be = e and
    not be.getLeftOperand() instanceof StringLiteral and
    not be.getRightOperand() instanceof StringLiteral
  )
}

