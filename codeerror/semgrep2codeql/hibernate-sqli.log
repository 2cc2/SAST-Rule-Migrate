Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detects formatted strings in SQL statements that could lead to SQL injection.
 * @kind path-problem
 * @problem.severity warning
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       owasp-a01:2017
 *       owasp-a03:2021
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.security.StringFormatPatterns

predicate isHibernateSessionVariable(Expr e) {
  exists(Method m | e = m.getAValueReturnedBy(true) | 
    m.getDeclaringType().hasQualifiedName("org.hibernate", "Session"))
  or
  exists(Variable v | e = v.getAnAccess() | 
    v.getType().hasQualifiedName("org.hibernate", "Session"))
}

from MethodCall ma, DataFlow::Node sqlArg, StringFormatPattern sfo
where
  (
    // Cases for Restrictions.sqlRestriction
    (
      ma.getTarget().hasQualifiedName("org.hibernate.criterion", "Restrictions", "sqlRestriction") and
      (sqlArg.asExpr() = ma.getArgument(0) or
      exists(MethodCall ma2 | ma2.getQualifier() = ma.getQualifier() | 
        sqlArg.asExpr() = ma2.getArgument(0)))
    )
    or
    // Cases for Session.createQuery/createSQLQuery
    (
      ma.getTarget().getName() in ["createQuery", "createSQLQuery"] and
      isHibernateSessionVariable(ma.getQualifier()) and
      sqlArg.asExpr() = ma.getArgument(0)
    )
  )
  and
  (
    // String concatenation case
    exists(AddExpr ae | 
      ae = sqlArg.getAUseOfFlow() and 
      not exists(StringLiteral sl | ae.getAnOperand() = sl.asExpr())
    )
    or
    // String.format case
    exists(sfo | sqlArg.getAUseOfFlow() = sfo.getAnOperand())
  )
select sqlArg, 
  "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables are not properly sanitized. Use PreparedStatement instead.",
  sqlArg, "Potentially unsafe SQL statement"
