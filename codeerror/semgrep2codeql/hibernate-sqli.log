Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 * injection if variables in the SQL statement are not properly sanitized.
 * Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-564
 *       owasp/a1
 *       owasp/a3
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat

class HibernateSQLInjection extends DataFlow::PathNode {
  HibernateSQLInjection() {
    exists(DataFlow::PathNode source, DataFlow::PathNode sink |
      this = source and
      (
        // Case 1: Direct concatenation in sqlRestriction
        exists(MethodAccess ma |
          ma.getMethod().hasQualifiedName("org.hibernate.criterion", "Restrictions", "sqlRestriction") and
          ma.getArgument(0) = sink.asExpr() and
          isConcatenatedString(source.asExpr())
        )
        or
        // Case 2: String.format in sqlRestriction
        exists(MethodAccess ma |
          ma.getMethod().hasQualifiedName("org.hibernate.criterion", "Restrictions", "sqlRestriction") and
          ma.getArgument(0) = sink.asExpr() and
          exists(StringFormatOperation sfo |
            sfo = source.asExpr() and
            sfo.getAnOperand() = ma.getArgument(0)
          )
        )
        or
        // Case 3: Session.createQuery/createSQLQuery with concatenation
        exists(MethodAccess ma |
          (ma.getMethod().getName() = "createQuery" or ma.getMethod().getName() = "createSQLQuery") and
          ma.getQualifier().getType().hasQualifiedName("org.hibernate", "Session") and
          ma.getArgument(0) = sink.asExpr() and
          isConcatenatedString(source.asExpr())
        )
        or
        // Case 4: Session.createQuery/createSQLQuery with String.format
        exists(MethodAccess ma |
          (ma.getMethod().getName() = "createQuery" or ma.getMethod().getName() = "createSQLQuery") and
          ma.getQualifier().getType().hasQualifiedName("org.hibernate", "Session") and
          ma.getArgument(0) = sink.asExpr() and
          exists(StringFormatOperation sfo |
            sfo = source.asExpr() and
            sfo.getAnOperand() = ma.getArgument(0)
          )
        )
      ) and
      DataFlow::flowPath(source, sink)
    )
  }

  predicate isConcatenatedString(Expr e) {
    exists(BinaryAdd ba |
      ba = e and
      not ba.getLeftOperand().(StringLiteral) and
      not ba.getRightOperand().(StringLiteral)
    )
    or
    exists(AddAssignmentExpr aae |
      aae = e and
      not aae.getLeftOperand().(StringLiteral) and
      not aae.getRightOperand().(StringLiteral)
    )
  }
}

