import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class CommandSource extends DataFlow::Node {
  CommandSource() {
    exists(Parameter p | this.asParameter() = p) or
    exists(Invoke i |
      (i.getMethod().getName() = "concat" and
       i.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")) or
      exists(Method m |
        m.getName().matches("format|join") and
        m.getDeclaringType().hasQualifiedName("java.lang", "String") and
        i.getMethod() = m
      )
      and this.asExpr() = i.getAnArgument()
    )
  }
}

class CommandSink extends DataFlow::Node {
  CommandSink() {
    exists(Invoke i |
      i.getMethod().getName().matches("exec|loadLibrary|load") and
      (
        i.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") or
        i.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
      ) and
      this.asExpr() = i.getAnArgument()
    ) or
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.asExpr() = cc.getAnArgument()
    )
  }
}

class CommandConfig extends TaintTracking::Configuration {
  CommandConfig() { this = "CommandConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof CommandSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CommandSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Invoke i |
      i.getMethod().getName() = "append" and
      i.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder") and
      pred.asExpr() = i.getAnArgument() and
      succ.asExpr() = i.getQualifier()
    )
  }
}

