/**
 * @name Tainted system command
 * @description Detected user input entering a method which executes a system command.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/tainted-system-command
 * @tags security
 *       external/cwe/cwe-078
 *       owasp-a01
 *       owasp-a03
 *       external/cwe-top25-2021
 *       external/cwe-top25-2022
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class TaintedInputConfiguration extends TaintTracking::Configuration {
  TaintedInputConfiguration() { this = "TaintedInputConfiguration" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p, Annotation ann |
      m.getAParameter() = p and
      p.getAnAnnotation() = ann and
      ann.getType().hasQualifiedName(["org.springframework.web.bind.annotation"],
          ["RequestBody", "PathVariable", "RequestParam", "RequestHeader",
           "CookieValue", "ModelAttribute"]) and
      source.asParameter() = p and
      not p.getType() instanceof BoxedType and
      not p.getType() instanceof PrimitiveType
    )
    
    or
    
    exists(MethodAccess ma, Expr arg |
      (ma.getMethod().hasName("concat") and arg = ma.getArgument(0))
      or
      (ma.getMethod().hasName("format") and arg.isIncludedIn(ma.getArgument(1)))
      or
      (ma.getMethod().hasName("join") and arg.isIncludedIn(ma.getArgument(1)))
      or
      exists(InfixExpr ie |
        (ie.getOperator() = "+" or ie.getOperator() = "+=") and
        (arg = ie.getLeftOperand() or arg = ie.getRightOperand())
      )
    |
      source.asExpr() = arg
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ProcessBuilder pb, MethodAccess ma |
      (ma.getMethod().hasName("command") or ma.getMethod().hasName("add") or ma.getMethod().hasName("addAll")) and
      ma.getQualifier() = pb and
      sink.asExpr() = ma.getAnArgument()
    )
    or
    exists(Runtime rt, MethodAccess ma |
      ma.getMethod().hasName("exec") and
      (ma.getQualifier() = rt or ma.getQualifier() = rt.getRuntime()) and
      sink.asExpr() = ma.getAnArgument()
    )
    or
    exists(ProcessBuilder pb, MethodAccess ma |
      ma.getMethod().hasName("start") and
      ma.getQualifier() = pb and
      sink.asExpr() = pb.getAnArgument()
    )
  }
}

from TaintedInputConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
