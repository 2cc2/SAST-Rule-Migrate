/**
 * @name Tainted SQL from HTTP request
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement. This
 *              could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 *              Use parameterized SQL queries or properly sanitize user input instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/tainted-sql-from-http-request
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-564
 *       owasp-a1
 *       owasp-a3
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.Servlets
import semmle.code.java.frameworks.JDBC
import semmle.code.java.dataflow.FlowSources

class ServletSQLTaintConfig extends TaintTracking::Configuration {
  ServletSQLTaintConfig() { this = "ServletSQLTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Expr ma |
      ma = any(MethodAccess ma | ma.getMethod() = m) and
      (
        m.getName().matches("getInputStream|getParameter|getParameterMap|getParameterValues|getReader|getCookies|getHeader|getHeaderNames|getHeaders|getPart|getParts|getQueryString") and
        m.getDeclaringType().getASupertype*() instanceof RefType and
        m.getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet", "HttpServletRequest")
      ) and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Expr ma |
      ma = any(MethodAccess ma | ma.getMethod() = m) and
      (
        // CallableStatement
        m.getDeclaringType().hasQualifiedName("java.sql", "CallableStatement") or
        // Statement execute methods
        (m.getDeclaringType().hasQualifiedName("java.sql", "Statement") and
         m.getName().matches("execute|query|executeUpdate|batchUpdate")) or
        // PreparedStatement
        m.getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
        // Connection.prepareStatement
        (m.getName() = "prepareStatement" and
         m.getDeclaringType().hasQualifiedName("java.sql", "Connection")) or
        // JdbcTemplate methods
        (m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
         m.getName().matches("queryForObject|queryForMap|batchUpdate"))
      ) and
      sink.asExpr() = ma
    ) or
    exists(Method m, Expr ma, StringLiteral sql |
      ma = any(MethodAccess ma | ma.getMethod() = m) and
      sql.getValue().regexpMatch("(?i)(^SELECT.*|^INSERT.*|^UPDATE.*)") and
      sink.asExpr() = ma.getAnArgument() and
      m.getName().matches("execute|query|executeUpdate|batchUpdate")
    )
  }
}

