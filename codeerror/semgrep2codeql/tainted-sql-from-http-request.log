Rule Content:
/**
 * @name Tainted SQL from HTTP request
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement. This
 *              could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 *              Use parameterized SQL queries or properly sanitize user input instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id java/tainted-sql-from-http-request
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-564
 *       owasp-a1
 *       owasp-a3
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import semmle.code.java.frameworks.SQL

class ServletSQLTaintConfig extends TaintTracking::Configuration {
  ServletSQLTaintConfig() { this = "ServletSQLTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, Method m |
      ma.getMethod() = m and
      (
        m.getName().matches("getInputStream|getParameter|getParameterMap|getParameterValues|getReader|getCookies|getHeader|getHeaderNames|getHeaders|getPart|getParts|getQueryString") and
        m.getDeclaringType().getASupertype*() instanceof TypeServlet
      ) and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (
        // CallableStatement
        ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "CallableStatement") or
        // Statement execute methods
        (ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") and
         ma.getMethod().getName().matches("execute|query|executeUpdate|batchUpdate")) or
        // PreparedStatement
        ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
        // Connection.prepareStatement
        (ma.getMethod().getName() = "prepareStatement" and
         ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection")) or
        // JdbcTemplate methods
        (ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
         ma.getMethod().getName().matches("queryForObject|queryForMap|batchUpdate")) or
        // Dynamic SQL construction
        exists(Method m, StringLiteral sql |
          sql.getValue().regexpMatch("(?i)(^SELECT.*|^INSERT.*|^UPDATE.*)") and
          sink.asExpr() = ma.getAnArgument() and
          ma.getMethod() = m and
          m.getName().matches("execute|query|executeUpdate|batchUpdate")
        )
      ) and
      sink.asExpr() = ma or sink.asExpr() = ma.getAnArgument()
    )
  }
}
