Rule Content:
/**
 * @name Tainted SQL from HTTP Request
 * @description Detects input from HTTPServletRequest going into a SQL statement without proper sanitization,
 *              which could lead to SQL injection vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sql-from-http-request
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(Call c |
      c.getCallee().getName().matches("getInputStream|getParameter|getParameterMap|getParameterValues|getReader|getCookies|getHeader|getHeaderNames|getHeaders|getPart|getParts|getQueryString") and
      (c.getReceiver().getType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") or
       c.getReceiver().getType().hasQualifiedName("javax.servlet", "ServletRequest")) and
      this.asExpr() = c
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(Call c |
      // Statement methods
      (c.getCallee().getName().matches("execute|executeUpdate|executeQuery|addBatch|batchUpdate") and
       c.getReceiver().getType().hasQualifiedName("java.sql", "Statement|PreparedStatement|CallableStatement")) or
      // JdbcTemplate methods
      (c.getCallee().getName().matches("query|queryForObject|queryForMap|update|batchUpdate") and
       c.getReceiver().getType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")) or
      // SQL string construction
      exists(StringLiteral sql |
        sql.getStringValue().regexpMatch("(?i)(^SELECT.*|^INSERT.*|^UPDATE.*)") and
        this.asExpr() = sql and
        DataFlow::localExprFlow(sql, c.getArgument(0))
      )
    )
  }
}

class SqlTaintConfig extends TaintTracking::Configuration {
  SqlTaintConfig() { this = "SqlTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from SqlTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection from HTTP request to SQL statement"
