Rule Content:
/**
 * @name Tainted SQL from HTTP Request
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement. This
 *    could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 *    Use parameterized SQL queries or properly sanitize user input instead.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.0
 * @precision high
 * @id java/tainted-sql-from-http-request
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/top25-2021
 *       external/cwe/top25-2022
 *       owasp-a1
 *       owasp-a3
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import semmle.code.java.security.Sql
import DataFlow::PathGraph

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(MethodAccess ma |
      (
        ma.getMethod().hasName(["getInputStream", "getParameter", "getParameterMap", "getParameterValues",
                              "getReader", "getCookies", "getHeader", "getHeaderNames", 
                              "getHeaders", "getPart", "getParts", "getQueryString"]) and
        (ma.getQualifier().getType().hasName("HttpServletRequest") or
         ma.getQualifier().getType().hasName("ServletRequest"))
      ) and
      this.asExpr() = ma
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    // Statement/PreparedStatement creation
    exists(VariableAccess va | 
      va.getVariable().getType().hasName(["Statement", "PreparedStatement", "CallableStatement"]) and
      this.asExpr() = va
    ) or
    // JdbcTemplate operations
    exists(MethodAccess ma |
      ma.getMethod().hasName(["queryForObject", "queryForMap", "batchUpdate"]) and
      ma.getQualifier().getType().hasName("JdbcTemplate") and
      this.asExpr() = ma
    ) or
    // String SQL concatenation followed by execution
    exists(AddExpr sc, MethodAccess ma |
      (sc.getRightOperand().toString().matches("%SELECT.*%") or
      sc.getRightOperand().toString().matches("%INSERT.*%") or
      sc.getRightOperand().toString().matches("%UPDATE.*%")) and
      ma.getMethod().hasName(["execute", "query", "executeUpdate", "batchUpdate"]) and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

class TaintedSqlFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedSqlFromHttpRequestConfig() { this = "TaintedSqlFromHttpRequestConfig" }
 
  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }
 
  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }
 
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.getType() instanceof PrimitiveType or
    sanitizer.getType() instanceof BoxedType
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSqlFromHttpRequestConfig cfg
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "Potential SQL injection from HTTP request parameter"
