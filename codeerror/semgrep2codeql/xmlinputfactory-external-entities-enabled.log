/**
 * @name XMLInputFactory External Entities Enabled
 * @description Detects enabling of XML external entities in XMLInputFactory,
 *              which makes the application vulnerable to XXE attacks.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.3
 * @references
 *  - https://semgrep.dev/blog/2022/xml-security-in-java
 *  - https://semgrep.dev/docs/cheat-sheets/java-xxe/
 *  - https://www.blackhat.com/docs/us-15/materials/us-15-Wang-FileCry-The-New-Age-Of-XXE-java-wp.pdf
 * @tags security
 *       external/cwe/cwe-611
 *       owasp-a04
 *       owasp-a05
 *       cwe2021-top25
 *       cwe2022-top25
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.XML

class XMLExternalEntityEnabled extends DataFlow::Configuration {
  XMLExternalEntityEnabled() { this = "XMLExternalEntityEnabled" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("setProperty") and
      ma.getQualifier().getType().hasName("javax.xml.stream.XMLInputFactory") and
      (
        ma.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" or
        ma.getArgument(0).(FieldAccess).getTarget().hasName("IS_SUPPORTING_EXTERNAL_ENTITIES") or
        ma.getArgument(0).(FieldAccess).getTarget().hasName("SUPPORT_DTD")
      ) and
      (
        ma.getArgument(1).(BooleanLiteral).getValue() = true or
        ma.getArgument(1).(FieldAccess).getTarget().hasName("TRUE")
      ) and
      source.asExpr() = ma
    )
  }
}

