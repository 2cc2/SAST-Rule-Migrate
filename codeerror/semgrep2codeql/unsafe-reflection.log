Rule Content:
/**
 * @name Unsafe Reflection
 * @description Detects unsafe use of Class.forName() with potentially attacker-controlled input
 * @kind problem
 * @problem.severity warning
 * @id java/unsafe-reflection
 * @tags security
 *       external/cwe/cwe-470
 *       owasp-a03
 */

import java

from MethodAccess call
where
  call.getMethod().hasName("forName") and
  call.getQualifier().getQualifierType() instanceof TypeClass and
  call.getQualifier().getQualifierType().hasQualifiedName("java.lang", "Class") and
  not call.getArgument(0).isCompileTimeConstant() and
  not exists(LocalVariableAssignment assign | assign.getRValue().isCompileTimeConstant() | assign.getVariable().getAnAssignedValue() = call.getArgument(0))
select call, 
  "Potential unsafe reflection using externally controlled input. Attackers may bypass authentication or access controls by controlling class loading."
