Rule Content:
/**
 * @name Tainted environment from HTTP request
 * @description Detected input from a HTTPServletRequest going into the environment variables of
 *              an 'exec' command. Instead, call the command with user-supplied arguments by
 *              using the overloaded method with one String array as the argument.
 *              `exec({"command", "arg1", "arg2"})`.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.0
 * @precision high
 * @id java/tainted-env-from-http-request
 * @tags security
 *       external/cwe/cwe-454
 *       owasp-a01:2017/injection
 *       owasp-a03:2021/injection
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletRequestAsEnvSource extends DataFlow::Node {
  ServletRequestAsEnvSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("getCookies") and
      ma.getMethod().getDeclaringType() instanceof HttpServletRequest and
      ma.getQualifier() = this.asExpr()
    )
    or
    exists(CookieGetValue cgv | cgv.getReceiver() = this.asExpr())
  }
}

class RuntimeExecEnvSink extends DataFlow::Node {
  RuntimeExecEnvSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "exec" and
      ma.getMethod().getDeclaringType() instanceof Runtime and
      ma.getArgument(1) = this.asExpr()
    )
  }
}

class TaintedEnvFromRequestConfiguration extends TaintTracking::Configuration {
  TaintedEnvFromRequestConfiguration() {
    this = "TaintedEnvFromRequestConfiguration"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestAsEnvSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RuntimeExecEnvSink
  }
}

from TaintedEnvFromRequestConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected input from a HTTPServletRequest going into the environment variables of an 'exec' command."
