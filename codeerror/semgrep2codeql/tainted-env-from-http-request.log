Rule Content:
/**
 * @name Tainted environment from HTTP request
 * @description Detected input from a HTTPServletRequest going into the environment variables of an 'exec' command.
 *              Instead, call the command with user-supplied arguments by using the overloaded method with one String array as the argument.
 *              `exec({"command", "arg1", "arg2"})`.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-env-from-http-request
 * @tags security
 *       external/cwe/cwe-454
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpRequestSource extends RemoteFlowSource::Range {
  HttpRequestSource() {
    exists(MethodAccess ma | 
      (ma.getMethod().getName() = "getCookies" and ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")) or
      exists(Method m | 
        m = ma.getMethod() and
        m.hasName("getValue") and
        m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
      )
    ) and 
    this.asExpr() = ma.getQualifier()
  }
}

class RuntimeExecEnvSink extends DataFlow::Node {
  RuntimeExecEnvSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "exec" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      ma.getArgument(1) = this.asExpr()
    )
  }
}

class TaintedEnvFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedEnvFromHttpRequestConfig() { this = "TaintedEnvFromHttpRequestConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof RuntimeExecEnvSink }
}

from TaintedEnvFromHttpRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential unsafe execution with tainted environment variables from HTTP request", source,
  "User input from $@ flows into environment variables of exec command here", source.getNode(), "this source"
