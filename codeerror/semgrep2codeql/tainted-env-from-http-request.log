Rule Content:
/**
 * @name Tainted environment from HTTP request
 * @description Detected input from a HTTPServletRequest going into the environment variables of an 'exec' command.
 *              Instead, call the command with user-supplied arguments by using the overloaded method 
 *              with one String array as the argument.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-env-from-http-request
 * @tags security
 *       external/cwe/cwe-454
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ServletRequestSource extends RemoteFlowSource {
  ServletRequestSource() {
    exists(MethodAccess ma | 
      (ma.getMethod().getName() = "getParameter" or ma.getMethod().getName() = "getQueryString" or
       ma.getMethod().getName() = "getHeader" or ma.getMethod().getName() = "getCookies") and
      ma.getQualifier().getType().hasName("HttpServletRequest")
    )
    or
    exists(MethodAccess ma | 
      ma.getMethod().getName() = "getValue" and
      ma.getQualifier().getType().hasName("javax.servlet.http.Cookie")
    )
  }
}

class RuntimeExecEnvSink extends Method {
  RuntimeExecEnvSink() {
    this.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
    this.getName() = "exec" and
    this.getNumberOfParameters() > 1 and
    exists(int i | i >= 1 and this.getParameter(i).getType().toString() = "String[]")
  }
}

class TaintedEnvFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedEnvFromHttpRequestConfig() { this = "TaintedEnvFromHttpRequestConfig" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof ServletRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod() instanceof RuntimeExecEnvSink and
      sink.asExpr() = ma.getArgument(1)  // $ENV_ARGS parameter
    )
  }
}

from TaintedEnvFromHttpRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected input from a HTTPServletRequest going into the environment variables of an 'exec' command. " +
  "Instead, call the command with user-supplied arguments by using the overloaded method with one " +
  "String array as the argument `exec({\"command\", \"arg1\", \"arg2\"})`."
