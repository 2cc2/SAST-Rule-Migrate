Rule Content:
/**
 * @name JPA SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 *              injection if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jpa-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 *       external/cwe2022-top25
 *       external/cwe2021-top25
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class EntityManager extends RefType {
  EntityManager() {
    this.hasQualifiedName("javax.persistence", "EntityManager")
  }
}

class SqlSource extends DataFlow::Node {
  SqlSource() {
    exists(MethodAccess fmtCall |
      fmtCall.getCallee().getName() = "format" and
      fmtCall.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = fmtCall
    )
    or
    exists(BinaryExpr concat |
      concat.getOperator() = BinaryOperator.PLUS and
      (concat.getLeftOperand().getType() instanceof StringType or
       concat.getRightOperand().getType() instanceof StringType) and
      this.asExpr() = concat
    )
  }
}

class JpaSink extends DataFlow::Node {
  JpaSink() {
    exists(MethodAccess ma |
      ma.getCallee().getDeclaringType() instanceof EntityManager and
      (ma.getCallee().getName() = "createQuery" or
       ma.getCallee().getName() = "createNativeQuery") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class JpaSqlInjectionConfig extends TaintTracking::Configuration {
  JpaSqlInjectionConfig() { this = "JpaSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SqlSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof JpaSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal lit | sanitizer.asExpr() = lit)
  }
}

from JpaSqlInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential JPA SQL injection from un-sanitized string concatenation"
