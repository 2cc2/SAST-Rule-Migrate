Rule Content:
/**
 * @name JPA SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 *   injection if variables in the SQL statement are not properly sanitized.
 *   Use a prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/jpa-sqli
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-564
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat

from MethodAccess call, Expr sqlArg, EntityManager em
where
  (
    // Case 1: String concatenation or format used in SQL argument
    (exists(AddExpr add | sqlArg = add) or exists(MethodAccess format | sqlArg = format))
    or
    // Case 2: Variable containing SQL from concatenation or format
    (
      exists(LocalVariableDecl sqlVar | sqlVar.getAnAccess() = sqlArg |
        exists(AddExpr add | sqlVar.getInitializer() = add)
        or
        exists(MethodAccess format | sqlVar.getInitializer() = format)
      )
    )
  )
  // Target methods are createQuery or createNativeQuery
  and call.getMethod().hasName(["createQuery", "createNativeQuery"])
  and sqlArg = call.getArgument(0)
  // The receiver must be an EntityManager
  and em = call.getQualifier()
  and em.getType().hasQualifiedName("javax.persistence", "EntityManager")
  // Exclude cases where string literals are concatenated
  and not exists(AddExpr litAdd | sqlArg = litAdd | litAdd.getAnOperand() instanceof StringLiteral)
select sqlArg, "Potentially unsafe SQL string concatenation. Use prepared statements instead."
