import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class EntityManager extends RefType {
  EntityManager() {
    this.hasQualifiedName("javax.persistence", "EntityManager")
  }
}

class SqlSource extends DataFlow::Node {
  SqlSource() {
    exists(MethodCall fmtCall |
      fmtCall.getMethod().getName() = "format" and
      fmtCall.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = fmtCall
    )
    or
    exists(Expr concat |
      concat instanceof BinaryExpr and
      concat.(BinaryExpr).getOperator() = BinaryOperator.PLUS and
      (concat.(BinaryExpr).getLeftOperand().getType() instanceof StringType or
       concat.(BinaryExpr).getRightOperand().getType() instanceof StringType) and
      this.asExpr() = concat
    )
  }
}

class JpaSink extends DataFlow::Node {
  JpaSink() {
    exists(MethodCall ma |
      ma.getMethod().getDeclaringType() instanceof EntityManager and
      (ma.getMethod().getName() = "createQuery" or
       ma.getMethod().getName() = "createNativeQuery") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class JpaSqlInjectionConfig extends TaintTracking::Configuration {
  JpaSqlInjectionConfig() { this = "JpaSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SqlSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof JpaSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal lit | sanitizer.asExpr() = lit)
  }
}

