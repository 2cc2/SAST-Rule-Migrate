/**
 * @name Spring JSP Eval Injection
 * @description A Spring expression is built with a dynamic value. The source of the value(s) should be verified to
 *              avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/spring-jsp-eval
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 *       technology/spring
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class SpringEvalTag extends HTMLElement {
  SpringEvalTag() {
    this.getTagName() = "spring:eval" and
    exists(Attribute attr |
      attr.getParentTag() = this and
      attr.getName() = "expression"
    )
  }
}

class SpringEvalSource extends DataFlow::Node {
  SpringEvalSource() {
    exists(HTMLElement e |
      e instanceof SpringEvalTag and
      exists(Attribute attr |
        attr.getParentTag() = e and
        attr.getName() = "expression" and
        this.asExpr() = attr.getValue()
      )
    )
  }
}

class SpringEvalSink extends DataFlow::Node {
  SpringEvalSink() {
    // Empty - we're just looking for the presence of the eval tag
    none()
  }
}

class SpringEvalConfig extends TaintTracking::Configuration {
  SpringEvalConfig() { this = "SpringEvalConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SpringEvalSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SpringEvalSink }
}

from SpringEvalConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential Spring JSP eval injection from untrusted source"
