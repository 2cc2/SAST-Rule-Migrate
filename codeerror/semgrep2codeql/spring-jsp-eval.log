/**
 * @name Spring JSP Expression Evaluation
 * @description Detects dynamic Spring expressions in JSP files that could lead to eval injection
 * @kind path-problem
 * @problem.severity warning
 * @id java/spring-jsp-eval
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 * @precision low
 */

import java

from JspFile jsp
where jsp.getElement().getAttribute("expression").exists()
  and jsp.getElement().getName() = "spring:eval"
select jsp, "A Spring expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."
