/**
 * @name Spring JSP Eval Injection
 * @description A Spring expression is built with a dynamic value. The source of the value(s) should be verified to
 *              avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/spring-jsp-eval
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 *       technology/spring
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import PathGraph

class SpringEvalPattern extends DataFlow::Node {
  SpringEvalPattern() {
    exists(DataFlow::StringNode str |
      str.getValue().matches("<spring:eval.*expression=.*>") and
      this = str
    )
  }
}

class SpringEvalSource extends DataFlow::Node {
  SpringEvalSource() {
    exists(DataFlow::ExternalFlow source |
      source.getNode() instanceof SpringEvalPattern and
      this = source.getNode()
    )
  }
}

class SpringEvalConfig extends TaintTracking::ConfigurationTainting {
  SpringEvalConfig() { this = "SpringEvalConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof SpringEvalSource }

  override predicate isSink(DataFlow::Node sink) { none() }
}

from SpringEvalConfig cfg, PathGraph::PathNode source, PathGraph::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential Spring JSP eval injection detected - dynamic expression evaluation"
