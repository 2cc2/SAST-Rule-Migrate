/**
 * @name Permissive CORS
 * @description Permissive CORS policy will allow a malicious application to communicate with
 *    the victim application in an inappropriate way, leading to spoofing, data theft,
 *    relay and other attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/permissive-cors
 * @tags security
 *       owasp: a04
 *       cwe: 183
 *       asvs: V14:14.4.8
 */
import java
import java.lang.String

predicate isPermissiveValue(Expr value) {
  exists(string str |
    value instanceof Literal and
    str = value.(Literal).getLiteral() and
    (matches(str, "*") or matches(str, "null"))
  )
}

predicate isAccessControlHeader(Expr header) {
  header instanceof Literal and
  exists(string headerStr |
    headerStr = header.(Literal).getLiteral().toLowerCase() and
    contains(headerStr, "access-control-allow-origin")
  )
}

from MethodCall ma
where
  // Pattern 1: HttpServletResponse.addHeader/setHeader
  (
    exists(Type servletResponseType |
      servletResponseType.hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
      ma.getQualifier().getType() = servletResponseType
    ) and
    (ma.getMethod().hasName("addHeader") or ma.getMethod().hasName("setHeader")) and
    isAccessControlHeader(ma.getArgument(0)) and
    isPermissiveValue(ma.getArgument(1))
  )
  or
  // Pattern 2: ServerHttpResponse.getHeaders().add
  (
    exists(Type httpHeadersType |
      httpHeadersType.hasQualifiedName("org.springframework.http", "HttpHeaders") and
      ma.getQualifier().getType() = httpHeadersType and
      exists(MethodCall getHeadersCall |
        getHeadersCall.getMethod().hasName("getHeaders") and
        exists(Type serverHttpResponseType |
          serverHttpResponseType.hasQualifiedName("org.springframework.http.server.reactive", "ServerHttpResponse") and
          getHeadersCall.getQualifier().getType() = serverHttpResponseType
        ) and
        ma.getQualifier() = getHeadersCall
      )
    ) and
    ma.getMethod().hasName("add") and
    isAccessControlHeader(ma.getArgument(0)) and
    isPermissiveValue(ma.getArgument(1))
  )
  or
  // Pattern 3: HttpHeaders.set
  (
    exists(Type httpHeadersType |
      httpHeadersType.hasQualifiedName("org.springframework.http", "HttpHeaders") and
      ma.getQualifier().getType() = httpHeadersType and
      ma.getMethod().hasName("set") and
      isAccessControlHeader(ma.getArgument(0)) and
      isPermissiveValue(ma.getArgument(1))
    )
  )
  or
  // Pattern 4: ServerWebExchange.getResponse().getHeaders().add
  (
    ma.getMethod().hasName("add") and
    isAccessControlHeader(ma.getArgument(0)) and
    isPermissiveValue(ma.getArgument(1)) and
    exists(MethodCall getHeadersCall |
      getHeadersCall.getMethod().hasName("getHeaders") and
      exists(MethodCall getResponseCall |
        getResponseCall.getMethod().hasName("getResponse") and
        exists(Type serverWebExchangeType |
          serverWebExchangeType.hasQualifiedName("org.springframework.web.server", "ServerWebExchange") and
          getResponseCall.getQualifier().getType() = serverWebExchangeType
        ) and
        getHeadersCall.getQualifier() = getResponseCall and
        ma.getQualifier() = getHeadersCall
      )
    )
  )
  or
  // Pattern 5: ResponseEntity.header
  (
    exists(Type responseEntityType |
      responseEntityType.hasQualifiedName("org.springframework.http", "ResponseEntity") and
      ma.getQualifier().getType() = responseEntityType and
      ma.getMethod().hasName("header") and
      isAccessControlHeader(ma.getArgument(0)) and
      isPermissiveValue(ma.getArgument(1))
    )
  )
  or
  // Pattern 6: ServerResponse.header
  (
    exists(Type serverResponseType |
      serverResponseType.hasQualifiedName("org.springframework.web.reactive.function.server", "ServerResponse") and
      ma.getQualifier().getType() = serverResponseType and
      ma.getMethod().hasName("header") and
      isAccessControlHeader(ma.getArgument(0)) and
      isPermissiveValue(ma.getArgument(1))
    )
  )
select ma, "Permissive CORS policy detected with '*' or 'null' value"
