/**
 * @name Permissive CORS
 * @description Permissive CORS policy will allow a malicious application to communicate with
 * the victim application in an inappropriate way, leading to spoofing, data theft,
 * relay and other attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/permissive-cors
 * @tags security
 *       cwe/183
 *       owasp/a04
 */
import java
import semmle.code.java.dataflow.DataFlow

predicate isPermissiveCorsValue(Expr value) {
  value.toString() = "*" or value.toString() = "null"
}

from Method m, DataFlow::Node headerName, DataFlow::Node headerValue
where
  // Check for addHeader/setHeader patterns
  (
    m.hasName(["addHeader", "setHeader"]) and
    m.getDeclaringType().hasQualifiedName(["javax.servlet.http", "org.springframework.http"], "HttpServletResponse") and
    DataFlow::parameterNode(m, 0) = headerName and
    headerName.asExpr().toString().matches("(?i)access-control-allow-origin") and
    DataFlow::parameterNode(m, 1) = headerValue and
    isPermissiveCorsValue(headerValue.asExpr())
  )
  or
  // Check for HttpHeaders.set/add patterns
  (
    m.hasName(["add", "set"]) and
    m.getDeclaringType().hasQualifiedName("org.springframework.http", "HttpHeaders") and
    DataFlow::parameterNode(m, 0) = headerName and
    headerName.asExpr().toString().matches("(?i)access-control-allow-origin") and
    DataFlow::parameterNode(m, 1) = headerValue and
    isPermissiveCorsValue(headerValue.asExpr())
  )
  or
  // Check for ServerResponse/ResponseEntity.header patterns
  (
    m.hasName("header") and
    (
      m.getDeclaringType().hasQualifiedName("org.springframework.http", "ResponseEntity") or
      m.getDeclaringType().hasQualifiedName("org.springframework.web.reactive.function.server", "ServerResponse")
    ) and
    DataFlow::parameterNode(m, 0) = headerName and
    headerName.asExpr().toString().matches("(?i)access-control-allow-origin") and
    DataFlow::parameterNode(m, 1) = headerValue and
    isPermissiveCorsValue(headerValue.asExpr())
  )
select m, "Permissive CORS policy detected that allows '*' or 'null' origin. " +
  "This may allow malicious applications to communicate with this application inappropriately."
