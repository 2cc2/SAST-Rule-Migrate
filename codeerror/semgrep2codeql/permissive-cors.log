Rule Content:
/**
 * @name Permissive CORS Policy
 * @description Detects permissive CORS policies that allow '*' or 'null' as Access-Control-Allow-Origin values
 *               which could lead to security vulnerabilities.
 * @kind problem
 * @problem.severity warning
 * @id java/permissive-cors
 * @tags security
 *       external/cwe/cwe-183
 *       external/owasp/a04
 */
import java
import semmle.code.java.dataflow.FlowSources

predicate isPermissiveCORSValue(Expr exp) {
  exists(string str |
    exp = str and
    (str.regexpMatch("^\\*\$") or str.regexpMatch("^null\$"))
  )
}

from MethodAccess ma, Call addHeaderCall, Call setHeaderCall, 
     MethodAccess headersAdd, MethodAccess headersSet,
     MethodAccess responseEntityHeader, MethodAccess serverResponseHeader
where
  // Case 1: HttpServletResponse.addHeader with bad value
  (
    ma.getMethod().hasName("addHeader") and
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
    ma.getArgument(0).toString().toLowerCase().matches("%access-control-allow-origin%") and
    isPermissiveCORSValue(ma.getArgument(1))
  )
  or
  // Case 2: HttpServletResponse.setHeader with bad value
  (
    ma.getMethod().hasName("setHeader") and
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
    ma.getArgument(0).toString().toLowerCase().matches("%access-control-allow-origin%") and
    isPermissiveCORSValue(ma.getArgument(1))
  )
  or
  // Case 3: HttpHeaders.add/set with bad value
  (
