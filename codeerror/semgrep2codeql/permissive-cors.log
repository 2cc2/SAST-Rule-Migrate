Rule Content:
/**
 * @name Permissive CORS
 * @description Permissive CORS policy will allow a malicious application to communicate with
 *    the victim application in an inappropriate way, leading to spoofing, data theft,
 *    relay and other attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/permissive-cors
 * @tags security
 *       owasp: a04
 *       cwe: 183
 *       asvs: V14:14.4.8
 */
import java

// Pattern 1: HttpServletResponse.addHeader
from MethodAccess ma, Argument response, Argument headerValue
where 
  response.getType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
  ma.getMethod().hasName("addHeader") and
  ma.getQualifier() = response and
  (
    headerValue instanceof Literal and
    (headerValue.toString().matches("%*%") or headerValue.toString().matches("%null%"))
  ) and
  ma.getArgument(0).toString().matches("%(?i)access-control-allow-origin%")
select ma, "Permissive CORS policy detected using addHeader() with '*' or 'null' value"

// Pattern 2: HttpServletResponse.setHeader
from MethodAccess ma, Argument response, Argument headerValue
where 
  response.getType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
  ma.getMethod().hasName("setHeader") and
  ma.getQualifier() = response and
  (
    headerValue instanceof Literal and
    (headerValue.toString().matches("%*%") or headerValue.toString().matches("%null%"))
  ) and
  ma.getArgument(0).toString().matches("%(?i)access-control-allow-origin%")
select ma, "Permissive CORS policy detected using setHeader() with '*' or 'null' value"

// Pattern 3: ServerHttpResponse.getHeaders().add
from MethodAccess ma, Argument response, Argument headerValue
where 
  response.getType().hasQualifiedName("org.springframework.http.server.reactive", "ServerHttpResponse") and
  ma.getMethod().hasName("add") and
  ma.getQualifier().getARead().getEnclosingCallable().getName() = "getHeaders" and
  ma.getQualifier().getARead().getEnclosingCallable().getQualifier() = response and
  (
    headerValue instanceof Literal and
    (headerValue.toString().matches("%*%") or headerValue.toString().matches("%null%"))
  ) and
  ma.getArgument(0).toString().matches("%(?i)access-control-allow-origin%")
select ma, "Permissive CORS policy detected using ServerHttpResponse.getHeaders().add() with '*' or 'null' value"

// Pattern 4: HttpHeaders.set
from MethodAccess ma, Argument headers, Argument headerValue
where 
  headers.getType().hasQualifiedName("org.springframework.http", "HttpHeaders") and
  ma.getMethod().hasName("set") and
  ma.getQualifier() = headers and
  (
    headerValue instanceof Literal and
    (headerValue.toString().matches("%*%") or headerValue.toString().matches("%null%"))
  ) and
  ma.getArgument(0).toString().matches("%(?i)access-control-allow-origin%")
select ma, "Permissive CORS policy detected using HttpHeaders.set() with '*' or 'null' value"

// Pattern 5: ServerWebExchange.getResponse().getHeaders().add
from MethodAccess ma, Argument exchange, Argument headerValue
where 
  exchange.getType().hasQualifiedName("org.springframework.web.server", "ServerWebExchange") and
  ma.getMethod().hasName("add") and
  ma.getQualifier().getARead().getEnclosingCallable().getName() = "getHeaders" and
  exists(Call call |
    call.getQualifier().getARead().getEnclosingCallable().getName() = "getResponse" and
    call.getQualifier() = exchange and
    call = ma.getQualifier().getARead().getEnclosingCallable().getQualifier()
  ) and
  (
    headerValue instanceof Literal and
    headerValue.toString().matches("%*%")
  ) and
  ma.getArgument(0).toString().matches("%(?i)access-control-allow-origin%")
select ma, "Permissive CORS policy detected using ServerWebExchange.getResponse().getHeaders().add() with '*' value"

// Patterns 6-9: Same as above but in method implementations
predicate isPermissiveCorsMethod(Method m) {
  exists(MethodAccess ma, Argument response, Argument headerValue |
    (
      // Method implementations with HttpServletResponse
      (
        (response.getType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
        (ma.getMethod().hasName("addHeader") or ma.getMethod().hasName("setHeader")))
        or
        // Method implementations with ServerHttpResponse
        (response.getType().hasQualifiedName("org.springframework.http.server.reactive", "ServerHttpResponse") and
        ma.getMethod().hasName("add") and
        ma.getQualifier().getARead().getEnclosingCallable().getName() = "getHeaders")
        or
        // Method implementations with ServerWebExchange
        (response.getType().hasQualifiedName("org.springframework.web.server", "ServerWebExchange") and
        ma.getMethod().hasName("add") and
        exists(Call call |
          call.getQualifier().getARead().getEnclosingCallable().getName() = "getResponse" and
          call.getQualifier() = response and
          call = ma.getQualifier().getARead().getEnclosingCallable().getQualifier()
        ))
      ) and
      ma.getEnclosingCallable() = m and
      ma.getQualifier() = response and
      (
        headerValue instanceof Literal and
        (headerValue.toString().matches("%*%") or headerValue.toString().matches("%null%"))
      ) and
      ma.getArgument(0).toString().matches("%(?i)access-control-allow-origin%")
    )
  )
}

from Method m
where isPermissiveCorsMethod(m)
select m, "Method contains permissive CORS policy with '*' or 'null' value"

// Pattern 10: ResponseEntity.header
from MethodAccess ma, Argument headerValue
where 
  ma.getQualifier().getType().hasQualifiedName("org.springframework.http", "ResponseEntity") and
  ma.getMethod().hasName("header") and
  (
    headerValue instanceof Literal and
    (headerValue.toString().matches("%*%") or headerValue.toString().matches("%null%"))
  ) and
  ma.getArgument(0).toString().matches("%(?i)access-control-allow-origin%")
select ma, "Permissive CORS policy detected using ResponseEntity.header() with '*' or 'null' value"

// Pattern 11: ServerResponse.header
from MethodAccess ma, Argument headerValue
where 
  ma.getQualifier().getType().hasQualifiedName("org.springframework.web.reactive.function.server", "ServerResponse") and
  ma.getMethod().hasName("header") and
  (
    headerValue instanceof Literal and
    (headerValue.toString().matches("%*%") or headerValue.toString().matches("%null%"))
  ) and
  ma.getArgument(0).toString().matches("%(?i)access-control-allow-origin%")
select ma, "Permissive CORS policy detected using ServerResponse.header() with '*' or 'null' value"
