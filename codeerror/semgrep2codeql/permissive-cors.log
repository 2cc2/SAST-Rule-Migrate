Rule Content:
/**
 * @name Permissive CORS
 * @description Permissive CORS policy will allow a malicious application to communicate with
 * the victim application in an inappropriate way, leading to spoofing, data theft,
 * relay and other attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/permissive-cors
 * @tags security
 *       cwe/183
 *       owasp/a04
 */
import java
import semmle.code.java.dataflow.DataFlow

predicate isPermissiveCorsValue(Expr value) {
  value.toString() = "*" or value.toString() = "null"
}

from MethodAccess ma, DataFlow::Node headerName, DataFlow::Node headerValue
where
  // Check for addHeader/setHeader patterns
  (
    ma.getMethod().hasName(["addHeader", "setHeader"]) and
    ma.getMethod().getDeclaringType().hasQualifiedName(["javax.servlet.http", "org.springframework.http"], "HttpServletResponse") and
    DataFlow::localFlow(DataFlow::exprToNode(ma.getArgument(0)), headerName) and
    headerName.asExpr().toString().matches("(?i)access-control-allow-origin") and
    DataFlow::localFlow(DataFlow::exprToNode(ma.getArgument(1)), headerValue) and
    isPermissiveCorsValue(headerValue.asExpr())
  )
  or
  // Check for HttpHeaders.set/add patterns
  (
    ma.getMethod().hasName(["add", "set"]) and
    ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.http", "HttpHeaders") and
    DataFlow::localFlow(DataFlow::exprToNode(ma.getArgument(0)), headerName) and
    headerName.asExpr().toString().matches("(?i)access-control-allow-origin") and
    DataFlow::localFlow(DataFlow::exprToNode(ma.getArgument(1)), headerValue) and
    isPermissiveCorsValue(headerValue.asExpr())
  )
  or
  // Check for ServerResponse/ResponseEntity.header patterns
  (
    ma.getMethod().hasName("header") and
    (
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.http", "ResponseEntity") or
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.web.reactive.function.server", "ServerResponse")
    ) and
    DataFlow::localFlow(DataFlow::exprToNode(ma.getArgument(0)), headerName) and
    headerName.asExpr().toString().matches("(?i)access-control-allow-origin") and
    DataFlow::localFlow(DataFlow::exprToNode(ma.getArgument(1)), headerValue) and
    isPermissiveCorsValue(headerValue.asExpr())
  )
select ma, "Permissive CORS policy detected that allows '*' or 'null' origin. " +
  "This may allow malicious applications to communicate with this application inappropriately."
