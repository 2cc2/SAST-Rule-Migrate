/**
 * @name Hardcoded Conditional
 * @description This if statement will always have the same behavior and is therefore unnecessary.
 * @kind problem
 * @problem.severity error
 * @id java/hardcoded-conditional
 * @tags correctness
 *       maintainability
 */

import java

predicate hardcodedTrueIf(IfStmt ifstmt) {
  exists(BooleanLiteral bool |
    bool.getValue() == true and
    (
      ifstmt.getCondition() = bool or
      exists(BinaryExpr binExpr |
        binExpr = ifstmt.getCondition() and
        (binExpr.getRightOperand() = bool or binExpr.getLeftOperand() = bool)
      )
    )
  )
}

predicate hardcodedFalseIf(IfStmt ifstmt) {
  exists(BooleanLiteral bool |
    bool.getValue() == false and
    (
      ifstmt.getCondition() = bool or
      exists(BinaryExpr binExpr |
        binExpr = ifstmt.getCondition() and
        (binExpr.getRightOperand() = bool or binExpr.getLeftOperand() = bool)
      )
    )
  )
}

predicate assignmentInCondition(IfStmt ifstmt) {
  exists(AssignExpr assign, BooleanLiteral bool |
    (bool.getValue() == true or bool.getValue() == false) and
    assign.getDest() instanceof Variable and
    assign.getSource() = bool and
    ifstmt.getCondition() = assign
  )
}

from IfStmt ifstmt
where hardcodedTrueIf(ifstmt) or hardcodedFalseIf(ifstmt) or assignmentInCondition(ifstmt)
select ifstmt, "This if statement will always have the same behavior and is therefore unnecessary."
