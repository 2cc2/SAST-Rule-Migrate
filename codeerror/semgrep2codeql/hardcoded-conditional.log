/**
 * @name Hardcoded conditional
 * @description This if statement will always have the same behavior and is therefore unnecessary.
 * @id hardcoded-conditional
 * @kind problem
 * @problem.severity error
 * @tags correctness
 *     java
 */

import java

predicate alwaysTrue(Expr expr) {
  exists(Literal l | l = expr and l.getBooleanValue() = true)
  or
  exists(InfixExpression e |
    e = expr and
    (  
      (e.getOperator() = "||" and alwaysTrue(e.getLeftOperand()))
      or
      (e.getOperator() = "||" and alwaysTrue(e.getRightOperand()))
    )
  )
}

predicate alwaysFalse(Expr expr) {
  exists(Literal l | l = expr and l.getBooleanValue() = false)
  or
  exists(InfixExpression e |
    e = expr and
    (  
      (e.getOperator() = "&&" and alwaysFalse(e.getLeftOperand()))
      or
      (e.getOperator() = "&&" and alwaysFalse(e.getRightOperand()))
    )
  )
}

from IfStmt ifStmt, Expr expr
where
  expr = ifStmt.getCondition() and
  (
    alwaysTrue(expr) 
    or 
    alwaysFalse(expr)
    or
    exists(AssignmentExpr assign |
      assign.getOperator() = "=" and
      assign.getRightOperand().getBooleanValue() = true and
      expr = assign
    )
    or
    exists(AssignmentExpr assign |
      assign.getOperator() = "=" and
      assign.getRightOperand().getBooleanValue() = false and
      expr = assign
    )
  )
select ifStmt, "This if statement will always have the same behavior and is therefore unnecessary."
