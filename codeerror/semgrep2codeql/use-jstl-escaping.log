 *       external/owasp/a03
 * @security-severity 4.0
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.jsp.Jsp

from JspFile jsp, string tag
where 
  tag = jsp.getContent() and
  tag.matches("<.*\\$\\{.*\\}.*>") and
  not tag.matches("<.*:out.*>")
select tag, "Expression Language segment without output escaping detected. Use JSTL 'out' tag to prevent XSS.",
  tag, "$ { } expression without escaping",
  "Reference: https://www.tutorialspoint.com/jsp/jstl_core_out_tag.htm"
