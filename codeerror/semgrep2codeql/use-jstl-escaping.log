/**
 * @name JSTL Output Escaping Bypass
 * @description Detected an Expression Language segment in a tag that does not escape output.
 *              This is dangerous because if any data in this expression can be controlled
 *              externally, it is a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jstl-output-escaping-bypass
 * @tags security
 *       external/owasp/a03
 *       external/cwe/cwe-116
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.jsp.Parser

class ExpressionLanguage extends DataFlow::Node {
  ExpressionLanguage() {
    exists(EvalExpr expr |
      expr.getStringValue().regexpMatches(".*\\$\\{.*\\}.*") and
      not expr.getStringValue().regexpMatches("<[A-Za-z0-9]+:out.*") and
      this.asExpr() = expr
    )
  }
}

class UntrustedInput extends DataFlow::Node {
  UntrustedInput() {
    exists(Parameter p |
      p.getType().hasName("HttpServletRequest") and
      this.asParameter() = p
    ) or
    exists(Call c |
      c.getCallee().getName().matches("getParameter%") and
      c.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      this.asExpr() = c
    )
  }
}

class JstlOutputConfig extends TaintTracking::Configuration {
  JstlOutputConfig() { this = "JstlOutputConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UntrustedInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof ExpressionLanguage }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(EvalExpr expr |
      expr.getStringValue().regexpMatches("<[A-Za-z0-9]+:out.*") and
      sanitizer.asExpr() = expr
    )
  }
}

from JstlOutputConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential XSS vulnerability due to unescaped JSTL expression. Use the 'out' tag from JSTL taglib to escape this expression."
