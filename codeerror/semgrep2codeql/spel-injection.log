/**
 * @name SpEL Injection
 * @description A Spring expression is built with a dynamic value. The source of the value(s) should be 
 *              verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind problem
 * @problem.severity warning
 * @id java/spel-injection
 * @tags security
 *       external/cwe/cwe-094
 *       external/owasp/a03
 *       external/cwe-top25-2022
 *       spring
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isParserType(Type t) {
  exists(RefType rt | 
    rt = t and (
      rt.hasQualifiedName("org.springframework.expression", "ExpressionParser") or
      rt.hasQualifiedName("org.springframework.expression.spel.standard", "SpelExpressionParser") or
      rt.hasQualifiedName("org.springframework.expression.common", "TemplateAwareExpressionParser")
    )
  )
}

from MethodCall mc, Expr arg, Variable parser
where
  // Find parseExpression method calls
  mc.getMethod().getName() = "parseExpression" and
  mc.getMethod().getDeclaringType().getASourceSupertype*().hasQualifiedName("org.springframework.expression", "ExpressionParser") and
  // Where argument is not literal string
  arg = mc.getArgument(0) and
  not arg instanceof StringLiteral and
  not (arg instanceof VariableAccess and exists(StringLiteral sl | arg instanceof VariableAccess and sl = (arg.(VariableAccess)).getVariable().getInitializer())) and
  // And called on a parser variable
  parser = mc.getQualifier() and
  isParserType(parser.getType())
select mc, "Potential SpEL injection vulnerability. Verify the source of dynamic values in parseExpression()."
