Rule Content:
/**
 * @name LDAP Entry Poisoning
 * @description An object-returning LDAP search will allow attackers to control the LDAP response.
 *              This could lead to Remote Code Execution.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision low
 * @id java/ldap-entry-poisoning
 * @tags security
 *       owasp/a1
 *       owasp/a3
 *       cwe/90
 */

import java
import semmle.code.java.frameworks.ldap.SearchControls

predicate setReturningObjFlagTrue(MethodAccess ma) {
  ma.getMethod().getName() = "setReturningObjFlag" and
  ma.getArgument(0).(BooleanLiteral).getValue() = true
}

from SearchControlsConstructorCall sc, MethodAccess setMethod
where 
  (sc.getACall().getArgument(4).(BooleanLiteral).getValue() = true or
   exists(setMethod | 
     setMethod.getQualifier() = sc.getAVariable() and
     setReturningObjFlagTrue(setMethod)
   ))
select sc, 
  "An object-returning LDAP search will allow attackers to control the LDAP response. " +
  "This could lead to Remote Code Execution.", sc.getACall(),
  "Potential LDAP entry poisoning vulnerability"
