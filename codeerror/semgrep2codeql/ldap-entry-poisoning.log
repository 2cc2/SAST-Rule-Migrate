/**
 * @name LDAP Entry Poisoning
 * @description An object-returning LDAP search will allow attackers to control the LDAP response.
 *              This could lead to Remote Code Execution.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision low
 * @id java/ldap-entry-poisoning
 * @tags security
 *       owasp/a1
 *       owasp/a3
 *       cwe/90
 */

import java
import javax.naming.directory.SearchControls

class SearchControlsCreation extends Constructor {
  SearchControlsCreation() {
    this.getConstructedType().hasQualifiedName("javax.naming.directory", "SearchControls")
  }
}

predicate setupReturningObjFlagTrue(Method m) {
  m.hasName("setReturningObjFlag") and
  exists(Call call | 
    call.getCallee() = m and
    call.getArgument(0).(BooleanLiteral).getValue() = true
  )
}

from SearchControlsCreation sc, Method m
where 
  (
    exists(Call call |
      call = sc.getAConstructorCall() and
      call.getArgument(4).(BooleanLiteral).getValue() = true
    )
    or
    exists(Call setCall |
      setCall.getQualifier() = sc.getAConstructorCall() and
      setupReturningObjFlagTrue(setCall.getCallee())
    )
  )
select sc.getAConstructorCall(), 
  "An object-returning LDAP search will allow attackers to control the LDAP response. " +
  "This could lead to Remote Code Execution.",
  sc.getAConstructorCall(),
  "Potential LDAP entry poisoning vulnerability"
