/**
 * @name LDAP Entry Poisoning
 * @description An object-returning LDAP search will allow attackers to control the LDAP response.
 *              This could lead to Remote Code Execution.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision low
 * @id java/ldap-entry-poisoning
 * @tags security
 *       owasp/a1
 *       owasp/a3
 *       cwe/90
 */

import java
import javax.naming.ldap.ControlFactory
import javax.naming.ldap.LdapContext

class SearchControlsCreation extends ConstructorCall {
  SearchControlsCreation() {
    this.getDeclaredType().hasQualifiedName("javax.naming.directory", "SearchControls")
  }
}

predicate setupReturningObjFlagTrue(Method m, Expr arg) {
  m.hasName("setReturningObjFlag") and
  arg.(BooleanLiteral).getValue() = true
}

from SearchControlsCreation sc, MethodAccess ma, Method m, Expr arg
where 
  (
    sc.getArgument(4).(BooleanLiteral).getValue() = true or
    (
      ma.getMethod() = m and
      ma.getQualifier() = sc.getVariable().getAnAccess() and
      setupReturningObjFlagTrue(m, ma.getArgument(0))
    )
  )
select sc, 
  "An object-returning LDAP search will allow attackers to control the LDAP response. " +
  "This could lead to Remote Code Execution.",
  sc,
  "Potential LDAP entry poisoning vulnerability"
