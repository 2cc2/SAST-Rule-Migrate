/**
 * @name LDAP Entry Poisoning
 * @description An object-returning LDAP search will allow attackers to control the LDAP response.
 *              This could lead to Remote Code Execution.
 * @kind path-problem
 * @problem.severity warning
 * @precision low
 * @id java/ldap-entry-poisoning
 * @tags security
 *       external/cwe/cwe-90
 *       owasp-a03
 *       owasp-a01
 */

import java

// Case 1: SearchControls constructor with returnObjFlag set to true
from ConstructorCall cc, MethodAccess ma
where
  cc.getConstructor().hasQualifiedName("javax.naming.directory", "SearchControls") and
  (
    // Check if the 5th parameter (returnObjFlag) is true
    cc.getArgument(4).(BooleanLiteral).getValue() = true
    or
    // OR case where flag is set via setReturningObjFlag()
    (
      exists(MethodAccess ma |
        ma.getMethod().hasName("setReturningObjFlag") and
        ma.getQualifier() = cc.getAnAssignee() and
        ma.getArgument(0).(BooleanLiteral).getValue() = true
      )
    )
  )
select cc, "LDAP SearchControls with returningObjFlag set to true may lead to LDAP Entry Poisoning"
