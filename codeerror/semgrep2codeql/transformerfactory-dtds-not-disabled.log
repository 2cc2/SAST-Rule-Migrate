 * @description DOCTYPE declarations are enabled for this TransformerFactory. This is vulnerable to XML external entity attacks. Disable this by setting the attributes "accessExternalDTD" and "accessExternalStylesheet" to "".
 * @kind path-problem
 * @problem.severity error
 * @id java/transformerfactory-dtds-not-disabled
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 *       external/cwe2022-top25
 *       external/cwe2021-top25
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow

class TransformerFactoryCreation extends RefType {
  TransformerFactoryCreation() {
    exists(Method m | 
      m.getName() = "newInstance" and
      m.getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      this = m.getDeclaringType()
    )
  }
}

class ConfigureSecureAttributes extends Call {
  ConfigureSecureAttributes() {
    (
      exists(Method m | 
        m.getName() = "setAttribute" and
        m.getParameterType(0).hasName("String") and
        this.getCallee() = m and
        this.getArgument(0).toString().matches("%accessExternalDTD%") and
        this.getArgument(1).toString() = "\"\"") or
      exists(Method m | 
        m.getName() = "setAttribute" and
        m.getParameterType(0).hasName("String") and
        this.getCallee() = m and
        this.getArgument(0).toString().matches("%accessExternalStylesheet%") and
        this.getArgument(1).toString() = "\"\"")
    ) and
    exists(ConfigureSecureAttributes other | 
      other != this and
      other.getQualifier() = this.getQualifier() and
      (
        (other.getArgument(0).toString().matches("%accessExternalDTD%") and 
         this.getArgument(0).toString().matches("%accessExternalStylesheet%")) or
        (other.getArgument(0).toString().matches("%accessExternalStylesheet%") and 
         this.getArgument(0).toString().matches("%accessExternalDTD%"))
      )
    )
  }
}

class UnsafeTransformerFactoryConfiguration extends TaintTracking::Config {
  UnsafeTransformerFactoryConfiguration() {
    this = "UnsafeTransformerFactoryConfiguration"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(VarAccess va |
      va.getVariable().getType() instanceof TransformerFactoryCreation and
      source.asExpr() = va
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call c |
      c.getCallee().getName() = "newTransformer" and
      c.getCallee().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      sink.asExpr() = c.getQualifier()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(ConfigureSecureAttributes csa |
      sanitizer.asExpr() = csa.getQualifier()
    )
  }
}

