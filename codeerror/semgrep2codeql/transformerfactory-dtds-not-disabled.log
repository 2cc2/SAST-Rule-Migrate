Rule Content:
/**
 * @name TransformerFactory XXE Vulnerability
 * @description Detects when TransformerFactory instances are created without disabling DTD processing,
 * which makes applications vulnerable to XML External Entity (XXE) attacks.
 * @id java/transformerfactory-dtds-not-disabled
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.0
 * @precision high
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 *       external/cwe2022-top25
 *       external/cwe2021-top25
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow

class TransformerFactoryCreation extends MethodAccess {
  TransformerFactoryCreation() {
    this.getMethod().hasName("newInstance") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory")
  }
}

class UnsafeTransformerFactory extends TaintTracking::Configuration {
  UnsafeTransformerFactory() { this = "UnsafeTransformerFactory" }

  override predicate isSource(DataFlow::Node source) {
    exists(TransformerFactoryCreation creation |
      source.asExpr() = creation.getQualifier() and
      not exists(creation.getEnclosingCallable().getBody().getAChild*() |
        exists(MethodAccess ma |
          ma.getMethod().hasName("setAttribute") and
          (
            ma.getArgument(0).toString() = "XMLConstants.ACCESS_EXTERNAL_DTD" or
            ma.getArgument(0).toString() = "XMLConstants.ACCESS_EXTERNAL_STYLESHEET" or
            ma.getArgument(0).toString().matches("%accessExternalDTD%") or 
            ma.getArgument(0).toString().matches("%accessExternalStylesheet%")
          ) and
          ma.getArgument(1).toString() = "\"\"" and
          ma.getQualifier() = source.asExpr()
        )
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("newTransformer") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.transform", "TransformerFactory") and
      sink.asExpr() = ma.getQualifier()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, UnsafeTransformerFactory conf
where conf.hasFlowPath(source, sink)
select sink, source, sink, 
  "DOCTYPES declarations are enabled for this TransformerFactory. This is vulnerable to XML external entity attacks. Disable this by setting the attributes 'accessExternalDTD' and 'accessExternalStylesheet' to \"\"."
