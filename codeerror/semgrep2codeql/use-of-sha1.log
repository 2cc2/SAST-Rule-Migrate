Rule Content:
/**
 * @name Use of SHA1
 * @description Detected SHA1 hash algorithm which is considered insecure. 
 *              SHA1 is not collision resistant and is therefore not suitable as a cryptographic signature. 
 *              Instead, use PBKDF2 for password hashing or SHA256 or SHA512 for other hash function applications.
 * @kind problem
 * @problem.severity warning
 * @precision high
 * @id java/use-of-sha1
 * @tags security
 *       owasp-a2
 *       owasp-a3
 *       cwe-328
 */

import java

// Case 1: MessageDigest.getInstance() with SHA1 algorithm
from MethodAccess ma, StringLiteral lit
where 
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
  lit = ma.getArgument(0) and
  lit.getValue().matches("(?i)SHA1|SHA-1")
select ma, "Use of insecure SHA1 hash algorithm detected."

// Case 2: Direct use of getSha1Digest()
from MethodAccess ma
where 
  ma.getMethod().getName() = "getSha1Digest" and
  (
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "DigestUtils") or
    ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("javax.crypto", "DigestUtils")
  )
select ma, "Use of insecure SHA1 hash algorithm detected."
