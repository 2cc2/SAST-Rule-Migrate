Rule Content:
/**
 * @name Use of SHA1
 * @description Detected SHA1 hash algorithm which is considered insecure. SHA1 is not
 * collision resistant and is therefore not suitable as a cryptographic
 * signature. Instead, use PBKDF2 for password hashing
 * or SHA256 or SHA512 for other hash function applications.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-sha1
 * @tags security
 *       owasp-a03:2017
 *       owasp-a02:2021
 *       cwe/328
 */

import java

predicate isSHA1Algorithm(string algo) {
  algo.regexpMatch("(?i)(SHA1|SHA-1)")
}

from MethodAccess md, String algo
where
  (
    md.getMethod().hasName("getInstance") and
    md.getMethod().getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
    algo = md.getArgument(0).(StringLiteral).getValue() and
    isSHA1Algorithm(algo)
  )
  or
  (
    md.getMethod().hasName("digest") and
    md.getQualifier().(MethodAccess).getMethod().hasName("getSha1Digest")
  )
select md, "Use of insecure SHA1 hash algorithm. Consider using more secure alternatives like PBKDF2, SHA256 or SHA512."
