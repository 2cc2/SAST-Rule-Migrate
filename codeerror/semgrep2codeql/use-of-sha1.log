/**
 * @name Use of SHA1
 * @description Detected SHA1 hash algorithm which is considered insecure. SHA1 is not
 * collision resistant and is therefore not suitable as a cryptographic
 * signature. Instead, use PBKDF2 for password hashing
 * or SHA256 or SHA512 for other hash function applications.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-sha1
 * @tags security
 *       owasp-a03:2017
 *       owasp-a02:2021
 *       cwe/328
 */

import java

predicate isSHA1Algorithm(Expr e) {
  exists(string algo | 
    e = any(StringLiteral sl).getValue() and
    algo = sl.getValue() and
    algo.regexpMatch("(?i)(SHA1|SHA-1)")
  )
}

from Call md
where
  (
    md.getCallee().hasName("getInstance") and
    md.getCallee().getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
    isSHA1Algorithm(md.getAnArgument(0))
  )
  or
  (
    md.getCallee().hasName("digest") and
    exists(Caller c | 
      c = md.getCaller() and
      c.getCallee().hasName("getSha1Digest")
    )
  )
select md, "Use of insecure SHA1 hash algorithm. Consider using more secure alternatives like PBKDF2, SHA256 or SHA512."
