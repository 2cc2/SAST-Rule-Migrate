/**
 * @name Cookie Missing HttpOnly Flag
 * @description Detects cookies that don't have the HttpOnly flag set.
 * @kind problem
 * @problem.severity warning
 * @id java/cookie-missing-httponly
 * @tags security
 *       external/cwe/cwe-1004
 *       owasp/a05:2021
 */

import java

from MethodAccess setHttpOnlyCall, MethodAccess addCookieCall, 
     MethodAccess setValueCall, MethodAccess cookieCreation
where 
  // Cookie is added to response without HttpOnly flag
  (
    addCookieCall.getMethod().hasName("addCookie") and
    not exists(setHttpOnlyCall.getMethod().hasName("setHttpOnly") and
               setHttpOnlyCall.getQualifier() = addCookieCall.getArgument(0))
  )
  or
  // Cookie is explicitly set to non-HttpOnly
  (
    setHttpOnlyCall.getMethod().hasName("setHttpOnly") and
    setHttpOnlyCall.getArgument(0).(Literal).getValue().toInt() = 0
  )
  or
  // Cookie is created without HttpOnly flag
  (
    cookieCreation.getMethod().getName() = "from" and
    not exists(cookieCreation.getAnAccess().getName() = "httpOnly")
  )
select addCookieCall, "A cookie was detected without setting the 'HttpOnly' flag. " +
       "The 'HttpOnly' flag for cookies instructs the browser to forbid client-side " +
       "scripts from reading the cookie. Set the 'HttpOnly' flag by calling " +
       "'cookie.setHttpOnly(true);'"
