Rule Content:
/**
 * @name Cookie Missing HttpOnly Flag
 * @description Detects cookies without the 'HttpOnly' flag set.
 * @kind problem
 * @problem.severity warning
 * @id java/cookie-missing-httponly
 * @tags security
 *       external/cwe/cwe-1004
 *       external/owasp/a05:2021
 */

import java

predicate isCookieMissingHttpOnly(CookieCreation cookie) {
  exists(boolean val |
    cookie.setHttpOnly(val) and
    val = false
  )
  or
  not exists(cookie.setHttpOnly(_))
}

from MethodAccess ma, CookieCreation cookie
where
  (
    ma.getMethod().getName() = "addCookie" and
    ma.getArgument(0) = cookie.getCreationExpr()
  )
  and
  not isResponseCookieFrom(cookie) and
  not isSettingEmptyValue(cookie) and
  (
    isCookieMissingHttpOnly(cookie)
    or
    not exists(cookie.getHttpOnlyCall())
  )
select ma, "A cookie was detected without setting the 'HttpOnly' flag. " +
  "The 'HttpOnly' flag for cookies instructs the browser to forbid " +
  "client-side scripts from reading the cookie. Set the 'HttpOnly' " +
  "flag by calling 'cookie.setHttpOnly(true);'."

predicate isResponseCookieFrom(CookieCreation cookie) {
  exists(MethodAccess ma |
    ma.getMethod().getName() = "from" and
    ma.getQualifier().getType().hasName("ResponseCookie") and
    ma = cookie.getCreationExpr()
  )
}

predicate isSettingEmptyValue(CookieCreation cookie) {
  exists(MethodAccess ma |
    ma.getMethod().getName() = "setValue" and
    ma.getQualifier() = cookie.getCreationExpr() and
    ma.getArgument(0).(StringLiteral).getValue() = ""
  )
}

class CookieCreation extends Expr {
  CookieCreation() {
    exists(Class c | c.getASupertype*().hasName("Cookie") | this.getType().getASupertype*() = c)
  }

  Expr getCreationExpr() { result = this }

  MethodAccess getHttpOnlyCall() {
    result.getMethod().getName() = "setHttpOnly" and
    result.getQualifier() = this.getCreationExpr()
  }
}
