/**
 * @name Assignment in conditional check
 * @description Detects assignment operations used in conditional checks where comparison was likely intended
 * @kind problem
 * @id java/assignment-comparison
 * @tags correctness
 *   - java
 */

import java

predicate isAssignmentInCondition(Expr e) {
  exists(AssignmentExpr assign |
    assign = e and
    assign.getTarget() instanceof VariableAccess and
    (
      assign.getSource() instanceof Literal and
      (
        assign.getSource().(Literal).getValue().toString() = "true" or
        assign.getSource().(Literal).getValue().toString() = "false"
      )
    )
  )
}

from IfStmt ifStmt, Expr cond
where
  cond = ifStmt.getCondition() and
  isAssignmentInCondition(cond)
select ifStmt, "The value is being ignored and will be used in the conditional test"
