import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringExpr

class RuntimeExecCall extends Call {
  RuntimeExecCall() {
    exists(Method m | 
      m.hasName("exec") and
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      this.getCallee() = m
    )
  }
}

class RuntimeLoadLibraryCall extends Call {
  RuntimeLoadLibraryCall() {
    exists(Method m |
      m.hasName("loadLibrary") and
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      this.getCallee() = m
    )
  }
}

class ShellCommand extends string {
  ShellCommand() {
    this.matches("%(sh|bash|ksh|csh|tcsh|zsh)%")
  }
}

class BashCOption extends string {
  BashCOption() {
    this.matches("%-c%")
  }
}

class RuntimeExecTaintConfig extends TaintTracking::Configuration {
  RuntimeExecTaintConfig() { this = "RuntimeExecTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(ShellCommand shell | source.asExpr() = shell) or
    exists(BashCOption opt | source.asExpr() = opt) or
    source.getType() instanceof TypeString
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeExecCall exec | 
      sink.asExpr() = exec.getAnArgument() or
      sink.asExpr() = exec.getQualifier()
    ) or
    exists(RuntimeLoadLibraryCall load | 
      sink.asExpr() = load.getAnArgument() or
      sink.asExpr() = load.getQualifier()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.getType() instanceof PrimitiveType or
    exists(StringExpr format | sanitizer.asExpr() = format)
  }
}

