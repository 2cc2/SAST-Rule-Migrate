/**
 * @name Command Injection in Runtime Calls
 * @description Formatted or concatenated strings as input to java.lang.Runtime calls
 *              could lead to command injection if user input is not sanitized.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-runtime-call
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class RuntimeCall extends MethodAccess {
  RuntimeCall() {
    exists(Method m | 
      m.hasName("exec", "loadLibrary") and
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      this.getMethod() = m
    )
  }
}

class RuntimeSource extends DataFlow::Node {
  RuntimeSource() {
    exists(Expr e |
      (e instanceof AddExpr or 
       e instanceof StringFormatExpr or
       exists(MethodAccess ma | 
         ma.getMethod().hasName("format") and 
         ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
         e = ma
       )) and
      this.asExpr() = e
    )
  }
}

class ShellCommandPattern extends StringLiteral {
  ShellCommandPattern() {
    this.getValue().regexpMatch(".*/(sh|bash|ksh|csh|tcsh|zsh)/.*")
  }

  string getShellPattern() { result = this.getValue() }
}

class BashOptionPattern extends StringLiteral {
  BashOptionPattern() {
    this.getValue().matches("%-c%")
  }
}

class RuntimeShellSink extends DataFlow::Node {
  RuntimeShellSink() {
    exists(RuntimeCall rc, Expr arg |
      (arg instanceof StringLiteral and arg instanceof ShellCommandPattern or
       exists(ArrayInit ai | arg = ai and ai.getAnInit() instanceof ShellCommandPattern) or
       exists(MethodAccess ma | 
         ma.getMethod().hasName("asList") and 
         ma.getMethod().getDeclaringType().hasQualifiedName("java.util", "Arrays") and
         arg = ma and ma.getAnArgument() instanceof ShellCommandPattern
       )) and
      (rc.getAnArgument() = arg or
       rc.getAnArgument().(MethodAccess).getAnArgument() = arg) and
      this.asExpr() = arg
    )
  }
}

class RuntimeConfig extends TaintTracking::Configuration {
  RuntimeConfig() { this = "RuntimeConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof RuntimeSource or
    source instanceof ShellCommandPattern
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof RuntimeShellSink or
    exists(RuntimeCall rc | sink.asExpr() = rc.getAnArgument())
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral lit | lit = sanitizer.asExpr())
  }
}

from RuntimeConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential command injection in Runtime call from unverified input"
