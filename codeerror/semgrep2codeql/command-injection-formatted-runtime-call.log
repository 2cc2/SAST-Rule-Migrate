Rule Content:
/**
 * @name Command Injection in Runtime.exec
 * @description Detects potentially dangerous formatted or concatenated strings passed to Runtime.exec() calls
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-runtime-exec
 * @tags security
 *       cwe/cwe-78
 *       owasp/a01:2017
 *       owasp/a03:2021
 */
import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class RuntimeExecCall extends MethodAccess {
  RuntimeExecCall() {
    exists(Method m |
      m = this.getMethod() and
      m.getName() = "exec" or m.getName() = "loadLibrary" and
      m.getDeclaringType().getName() = "Runtime" and
      m.getDeclaringType().getPackage().getName() = "java.lang"
    )
  }
}

predicate isShellCommand(Expr arg) {
  exists(string regex |
    regex = "%/(sh|bash|ksh|csh|tcsh|zsh)/" and
    arg.toString().matches(regex)
  )
}

predicate isMinusC(Expr arg) {
  exists(string pattern |
    pattern = "%-c%" and
    arg.toString().matches(pattern)
  )
}

predicate isConcatenation(Expr arg) {
  exists(BinaryAdd add | add = arg)
  or
  exists(MethodAccess fmt | 
    fmt.getMethod().getName() = "format" and
    fmt.getQualifier().getType().getName() = "String" and
    arg = fmt
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink, RuntimeExecCall call, Expr arg
where
  // Source is user-controlled input
  TaintTracking::localTaint(source, sink) and
  // Sink is an argument to Runtime.exec()
  (
    arg = call.getArgument(0) or
    (
      call.getArgument(0).getType().getName() = "String[]" and
      arg = call.getArgument(0).getChild(0)
    ) or
    (
      call.getArgument(0).getType().getName() = "List" and
      arg = call.getArgument(0).getChild(0)
    )
  ) and
  // Argument is dangerous
  (
    isShellCommand(arg) or
    isMinusC(arg) or
    isConcatenation(arg) or
    exists(ArrayInit arrInit | 
      arg = arrInit and
      exists(InitExpr init |
        init = arrInit.getAnInit() and
        (isShellCommand(init.getInitExpr()) or isMinusC(init.getInitExpr()))
      )
    )
  ) and
  sink.asExpr() = arg
select sink, "Potential command injection vulnerability due to user input in " +
  call.toString() + ". User input should be properly sanitized.", source, call
