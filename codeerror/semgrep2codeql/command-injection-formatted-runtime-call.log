class ShellCommand extends DataFlow::Node {
  ShellCommand() {
    exists(string val | 
      this.asExpr().(StringLiteral).getValue() = val and
      val.regexpMatch(".*(sh|bash|ksh|csh|tcsh|zsh).*")
    )
  }
}

class BashCOption extends DataFlow::Node {
  BashCOption() {
    exists(string val |
      this.asExpr().(StringLiteral).getValue() = val and
      val.regexpMatch(".*-c.*")
    )
  }
}

class RuntimeExecTaintConfig extends TaintTracking::Config {
  RuntimeExecTaintConfig() { this = "RuntimeExecTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(ShellCommand shell | source = shell) or
    exists(BashCOption opt | source = opt) or
    source.getType() instanceof TypeString
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeExecCall exec | 
      sink.asExpr() = exec.getAnArgument() or
      sink.asExpr() = exec.getQualifier()
    ) or
    exists(RuntimeLoadLibraryCall load | 
      sink.asExpr() = load.getAnArgument() or
      sink.asExpr() = load.getQualifier()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.getType() instanceof PrimitiveType or
    exists(string s | s = "..." and sanitizer.asExpr() instanceof StringLiteral)
  }
}

from DataFlow::PathGraph::PathNode source, DataFlow::PathGraph::PathNode sink, RuntimeExecTaintConfig config
where config.hasFlowPath(source, sink)
select sink, "Potential command injection found via concatenated/formatted string in Runtime call"
