  RuntimeExecCall() {
    exists(Method m |
      m = this.getMethod() and
      (m.getName() = "exec" or m.getName() = "loadLibrary") and
      m.getDeclaringType().getName() = "Runtime" and
      m.getDeclaringType().getPackage().getName() = "java.lang"
    )
  }
}

predicate isShellCommand(Expr arg) {
