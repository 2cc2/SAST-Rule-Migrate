Rule Content:
/**
 * @name Command Injection in Formatted Runtime Call
 * @description A formatted or concatenated string was detected as input to a java.lang.Runtime call.
 *              This is dangerous if a variable is controlled by user input and could result in a
 *              command injection.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-formatted-runtime-call
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class RuntimeMethod extends Method {
  RuntimeMethod() {
    this.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
    (
      this.getName() = "exec" or
      this.getName() = "loadLibrary"
    )
  }
}

class RuntimeSource extends DataFlow::Node {
  RuntimeSource() {
    exists(MethodAccess ma |
      ma.getMethod() instanceof RuntimeMethod and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class RuntimeSink extends DataFlow::Node {
  RuntimeSink() {
    exists(MethodAccess ma |
      ma.getMethod() instanceof RuntimeMethod and
      exists(Expr arg |
        arg = ma.getArgument(0) and
        (
          arg instanceof BinaryExpr or                              // $X + $Y
          arg.(MethodAccess).getMethod().getName() = "format" or   // String.format
          exists(ArrayCreation arr | arg = arr) or                 // new String[]
          exists(MethodAccess als | als.getMethod().getName() = "asList")  // Arrays.asList
        )
      ) and
      this.asExpr() = ma
    )
  }
}

class RuntimeShellCommand extends DataFlow::Node {
  RuntimeShellCommand() {
    exists(MethodAccess ma |
      ma.getMethod() instanceof RuntimeMethod and
      exists(Expr arg |
        arg = ma.getArgument(0) and
        (
          arg instanceof StringLiteral and arg.toString().matches("%sh|bash|ksh|csh|tcsh|zsh%") or
          exists(ArrayCreation arr |
            arg = arr and
            exists(arr.getAnInit() |
              this.asExpr().(StringLiteral).getValue().matches("%sh|bash|ksh|csh|tcsh|zsh%")
            )
          )
        )
      ) and
      this.asExpr() = ma
    )
  }
}

class RuntimeConfiguration extends TaintTracking::Configuration {
  RuntimeConfiguration() { this = "RuntimeConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RuntimeSource or source instanceof RuntimeShellCommand
  }

  override predicate isSink(DataFlow::Node sink) { sink instanceof RuntimeSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral lit | lit = sanitizer.asExpr())
  }
}

from RuntimeConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential command injection in formatted runtime call"
