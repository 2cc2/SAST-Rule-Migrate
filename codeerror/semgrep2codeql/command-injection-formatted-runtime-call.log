Rule Content:
/**
 * @name Command Injection in Runtime.exec
 * @description Detects potentially unsafe use of Runtime.exec() with formatted or 
 *              concatenated strings that could lead to command injection.
 * @kind path-problem
 * @problem.severity error
 * @precision medium
 * @id java/command-injection-formatted-runtime-call
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-089
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class RuntimeExecCall extends MethodAccess {
  RuntimeExecCall() {
    this.getMethod().hasName("exec") and
    this.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime")
  }
}

class RuntimeLoadLibraryCall extends MethodAccess {
  RuntimeLoadLibraryCall() {
    this.getMethod().hasName("loadLibrary") and
    this.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime")
  }
}

class ShellCommand extends string::Literal {
  ShellCommand() {
    this.getValue().regexpMatch(".*(sh|bash|ksh|csh|tcsh|zsh).*")
  }
}

class BashCOption extends string::Literal {
  BashCOption() {
    this.getValue().regexpMatch(".*-c.*")
  }
}

class RuntimeExecTaintConfig extends TaintTracking::Configuration {
  RuntimeExecTaintConfig() { this = "RuntimeExecTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(ShellCommand shell | source.asExpr() = shell) or
    exists(BashCOption opt | source.asExpr() = opt) or
    source.getType() instanceof TypeString
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeExecCall exec | 
      sink.asExpr() = exec.getArgument(_) or
      sink.asExpr() = exec.getQualifier()
    ) or
    exists(RuntimeLoadLibraryCall load | 
      sink.asExpr() = load.getArgument(_) or
      sink.asExpr() = load.getQualifier()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.getType() instanceof PrimitiveType or
    exists(StringFormat format | sanitizer.asExpr() = format)
  }
}

from DataFlow::Node source, DataFlow::Node sink, RuntimeExecTaintConfig config
where config.hasFlow(source, sink)
select sink, "Potential command injection found via concatenated/formatted string in Runtime call"
