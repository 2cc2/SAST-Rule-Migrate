/**
 * @name Command Injection in Runtime Call
 * @description Detects potentially unsafe Runtime.exec() calls using formatted or concatenated strings
 * @id command-injection-formatted-runtime-call
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.0
 * @precision low
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.FlowSources

class RuntimeExecCall extends Invocation {
  RuntimeExecCall() {
    exists(Method m | m = this.getTarget() |
      (m.getName() = "exec" or m.getName() = "loadLibrary") and
      m.getDeclaringType().toString() = "java.lang.Runtime"
    )
  }
}

predicate isShellCommand(Expr arg) {
  exists(string pattern |
    pattern = "/(sh|bash|ksh|csh|tcsh|zsh)/" |
    arg.toString().regexpMatch(pattern)
  )
}

predicate isDangerousArgument(Expr arg) {
  exists(BinaryExpr bin | bin.getOperator() = PLUS | arg = bin) or
  exists(Invocation fmt | fmt.getTarget().getName() = "format" | arg = fmt) or
  isShellCommand(arg)
}

from RuntimeExecCall call, Expr arg
where
  arg = call.getArgument(0) and
  isDangerousArgument(arg) and
  not arg.isCompileTimeConstant() and
  not exists(Literal literal | arg = literal | literal instanceof StringLiteral)
select call,
  "A formatted or concatenated string was detected as input to a java.lang.Runtime call. " +
  "This is dangerous if a variable is controlled by user input and could result in command injection."
