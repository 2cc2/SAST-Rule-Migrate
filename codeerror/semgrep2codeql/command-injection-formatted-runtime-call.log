Rule Content:
/**
 * @name Command Injection in Runtime Calls
 * @description Detect formatted or concatenated strings as input to java.lang.Runtime calls that could lead to command injection
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-runtime-call
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class RuntimeType extends RefType {
  RuntimeType() {
    this.hasQualifiedName("java.lang", "Runtime")
  }
}

class RuntimeCall extends Call {
  RuntimeCall() {
    exists(Method m | 
      m.getDeclaringType() instanceof RuntimeType and
      (m.getName() = "exec" or m.getName() = "loadLibrary") and
      this.getCallee() = m
    )
  }
}

class DangerousArgument extends DataFlow::Node {
  DangerousArgument() {
    exists(Expr concat |
      concat instanceof AddExpr and this.asExpr() = concat
    ) or
    exists(StringFormat format |
      format.isStringFormatInvocation() and this.asExpr() = format
    ) or
    exists(StringLiteral sl | 
      sl.getString().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)") and
      this.asExpr() = sl
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { 
    this = "CommandInjectionConfig" 
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DangerousArgument
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeCall rc | 
      rc.getAnArgument() = sink.asExpr()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl |
      sl.getString().regexpMatch("^[a-zA-Z0-9_/.-]+$") and
      sanitizer.asExpr() = sl
    )
  }
}

from CommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential command injection via Runtime call with formatted or concatenated string"
