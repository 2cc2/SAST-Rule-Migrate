 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 *       owasp-a01
 *       owasp-a03
 */
import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat

class JdbcTemplateMethod extends Method {
  JdbcTemplateMethod() {
    this.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
    this.getName() = "JdbcTemplate"
  }
}

class JdbcTemplateCreation extends DataFlow::Node {
  JdbcTemplateCreation() {
    exists(Method m, DataFlow::CallNode call |
      m instanceof JdbcTemplateMethod and
      call = m.getACall() and
      this.asExpr() = call.getASuperArgument()
    )
  }
}

class UnsafeJdbcMethodCall extends DataFlow::Node {
  UnsafeJdbcMethodCall() {
    exists(Method m, DataFlow::CallNode call |
      (
        m.getName().matches("%queryForObject%") or
        m.getName().matches("%queryForList%") or
        m.getName().matches("%update%") or
        m.getName().matches("%execute%") or
        m.getName().matches("%insert%")
      ) and
      m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      call = m.getACall() and
      this.asExpr() = call.getArgument(0) and
      (
        exists(AddExpr add | add = this.asExpr().getAChild()) or
        exists(DataFlow::CallNode formatCall |
          formatCall.getTarget().getName() = "format" and
          formatCall.getTarget().getDeclaringType().hasQualifiedName("java.lang", "String") and
          DataFlow::localFlow(formatCall.getArgument(0), this)
        ) or
        exists(DataFlow::CallNode sbCall |
          sbCall.getTarget().getName() = "append" and
          sbCall.getTarget().getDeclaringType().inheritsFrom("java.lang.AbstractStringBuilder") and
          DataFlow::localFlow(sbCall.getQualifier(), this)
        )
      )
    )
  }
}

