Rule Content:
/**
 * @name JDBC SQL Formatted String
 * @description Detects possible JDBC injection when using string concatenation or formatting
 *              instead of parameterized queries in JdbcTemplate operations.
 * @id jdbc-sql-formatted-string
 * @kind problem
 * @problem.severity warning
 * @security-severity 8.0
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 *       owasp-a01
 *       owasp-a03
 */
import java
import semmle.code.java.dataflow.DataFlow

class JdbcTemplateCreation extends DataFlow::Node {
  JdbcTemplateCreation() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "JdbcTemplate" and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      this.asExpr() = ma
    )
  }
}

class UnsafeJdbcMethodCall extends DataFlow::Node {
  UnsafeJdbcMethodCall() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName().matches("%queryForObject%") or
        ma.getMethod().getName().matches("%queryForList%") or
        ma.getMethod().getName().matches("%update%") or
        ma.getMethod().getName().matches("%execute%") or
        ma.getMethod().getName().matches("%insert%")
      ) and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      this.asExpr() = ma.getArgument(0) and
      (
        // String concatenation
        exists(AddExpr add | add = this.asExpr().getAChildExpr()) or
        // String.format()
        exists(MethodInvocation formatInvocation |
          formatInvocation.getMethod().getName() = "format" and
          formatInvocation.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
          formatInvocation = this.asExpr().getAChildExpr()
        ) or
        // StringBuilder usage
        exists(MethodInvocation appendInvocation |
          appendInvocation.getMethod().getName() = "append" and
          appendInvocation.getMethod().getDeclaringType().inheritsFrom("java.lang.AbstractStringBuilder") and
          appendInvocation.getQualifier().getAChildExpr*() = this.asExpr().getAChildExpr()
        )
      )
    )
  }
}

