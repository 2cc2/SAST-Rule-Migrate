  JwtSecretConfig() { this = "JwtSecretConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HardcodedSecret or
    source instanceof SecretAssignment
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HmacCall
  }
}

