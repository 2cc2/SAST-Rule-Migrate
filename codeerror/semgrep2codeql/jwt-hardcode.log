/**
 * @name Hardcoded JWT Secret
 * @description A hard-coded credential was detected. It is not recommended to store credentials in source-code,
 *              as this risks secrets being leaked and used by either an internal or external malicious adversary.
 * @kind path-problem
 * @problem.severity warning
 * @id java/hardcoded-jwt-secret
 * @tags security
 *       external/cwe/cwe-798
 *       external/owasp/a07
 *       external/cwe2021-top25
 *       external/cwe2022-top25
 */

import java
import semmle.code.java.StringLiterals
import semmle.code.java.dataflow.TaintTracking

class JwtAlgorithm extends RefType {
  JwtAlgorithm() {
    this.hasQualifiedName("com.auth0.jwt.algorithms", "Algorithm") or
    this.hasQualifiedName("io.jsonwebtoken.SignatureAlgorithm", "")
  }
}

class HmacMethod extends Method {
  HmacMethod() {
    this.getDeclaringType() instanceof JwtAlgorithm and
    this.getName().matches("HMAC256|HMAC384|HMAC512")
  }
}

class HardcodedSecret extends DataFlow::Node {
  HardcodedSecret() {
    exists(StringLiteral s | this.asExpr() = s)
  }
}

class HmacCall extends DataFlow::Node {
  HmacCall() {
    exists(MethodAccess ma |
      ma.getMethod() instanceof HmacMethod and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class SecretAssignment extends DataFlow::Node {
  SecretAssignment() {
    exists(Variable v, StringLiteral s |
      v.getAnAssignedValue() = s and
      this.asExpr() = v.getAnAccess()
    )
  }
}

class JwtSecretConfig extends TaintTracking::Configuration {
  JwtSecretConfig() { this = "JwtSecretConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HardcodedSecret or
    source instanceof SecretAssignment
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HmacCall
  }
}

