/**
 * @name Hard-coded JWT secret
 * @description Hard-coded credentials detected in JWT HMAC algorithm initialization.
 *              Storing credentials in source code risks secret leakage to malicious actors.
 * @kind problem
 * @problem.severity warning
 * @id java/jwt/hardcoded-secret
 * @tags security
 *       external/cwe/cwe-798
 *       owasp-a7
 *       jwt
 *       secrets
 */

import java

// Pattern 1: Direct HMAC algorithm initialization with hardcoded secret
from MethodAccess ma, Expr secretArg, StringLiteral secret
where 
  ma.getMethod().hasName(["HMAC256", "HMAC384", "HMAC512"]) and
  secretArg = ma.getArgument(0) and
  secret.getValue().getFullyQualifiedName() = secretArg.getFullyQualifiedName() and
  secretArg instanceof StringLiteral
select secret, "Hard-coded JWT secret detected in HMAC algorithm initialization."

// Pattern 2: Variable assigned hardcoded secret later used in HMAC
from VariableAssignment va, VariableAccess va2, MethodAccess ma, StringLiteral secret
where
  va.getRightOperand() = secret and
  secret instanceof StringLiteral and
  va2.getTarget() = va.getVariable() and
  ma.getArgument(0) = va2 and
  ma.getMethod().hasName(["HMAC256", "HMAC384", "HMAC512"])
select secret, "Hard-coded JWT secret detected via variable in HMAC algorithm initialization."

// Pattern 3: Class field with hardcoded secret used in HMAC
from Field f, VariableAccess va, MethodAccess ma, StringLiteral secret
where
  f.getInitializer() = secret and
  secret instanceof StringLiteral and
  va.getTarget() = f and
  ma.getArgument(0) = va and
  ma.getMethod().hasName(["HMAC256", "HMAC384", "HMAC512"])
select secret, "Hard-coded JWT secret detected via class field in HMAC algorithm initialization."
