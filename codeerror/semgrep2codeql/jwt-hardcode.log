 *       external/cwe/cwe-798
 *       owasp-a7
 *       jwt
 *       secrets
 */

import java

predicate isHardcodedJWTSecret(Expr secretExpr) {
  exists(MethodAccess ma |
    ma.getMethod().hasName(["HMAC256", "HMAC384", "HMAC512"]) and
    secretExpr = ma.getArgument(0) and
    secretExpr instanceof StringLiteral
  )
  or
  exists(AssignExpr va, VariableAccessExpr va2, MethodAccess ma |
    va.getRight() instanceof StringLiteral and
    va2.getTarget() = va.getDest() and
    ma.getArgument(0) = va2 and
