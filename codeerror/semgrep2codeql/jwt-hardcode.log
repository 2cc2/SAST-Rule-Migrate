    secretExpr = va.getRight()
  )
  or
  exists(Field f, VariableAccessExpr va, MethodAccess ma |
    f.getInitializer() instanceof StringLiteral and
    va.getTarget() = f and
    ma.getArgument(0) = va and
    ma.getMethod().hasName(["HMAC256", "HMAC384", "HMAC512"]) and
    secretExpr = f.getInitializer()
  )
}

from Expr secretExpr
where isHardcodedJWTSecret(secretExpr)
select secretExpr, "Hard-coded JWT secret detected"
