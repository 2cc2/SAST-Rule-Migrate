Rule Content:
/**
 * @name Use of default AES encryption
 * @description Detects use of AES encryption with default ECB mode which is insecure.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-default-aes
 * @tags security
 *       external/cwe/cwe-327
 *       owasp-a3
 *       owasp-a2
 */

import java

from MethodAccess ma
where 
  ma.getMethod().hasName("getInstance") and
  ma.getArgument(0).toString().matches("%AES%") and
  not ma.getArgument(0).toString().matches("%AES/%") and
  (
    ma.getQualifier().getType().hasName("Cipher") or
    ma.getQualifier().getType().getASupertype*().hasName("Cipher")
  )
select ma, 
  "Use of AES with no settings detected. By default, java.crypto.Cipher uses ECB mode. " +
  "ECB doesn't provide message confidentiality and is not semantically secure so should not be used. " +
  "Instead, use a strong, secure cipher: java.crypto.Cipher.getInstance(\"AES/CBC/PKCS7PADDING\"). " +
  "See https://owasp.org/www-community/Using_the_Java_Cryptographic_Extensions for more information."
