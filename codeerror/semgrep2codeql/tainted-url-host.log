/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 *              This could allow an attacker to send data to their own server,
 *              potentially exposing sensitive data such as cookies or authorization
 *              information sent with this request. They could also probe internal
 *              servers or other resources that the server running this code can access.
 *              (This is called server-side request forgery, or SSRF.) Do not allow
 *              arbitrary hosts. Instead, create an allowlist for approved hosts, hardcode
 *              the correct host, or ensure that the user data can only affect the path or parameters.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 *       external/owasp/a10
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class TaintedURLHostConfig extends TaintTracking::Configuration {
  TaintedURLHostConfig() { this = "TaintedURLHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p, Annotation a |
      m.getAParameter() = p and
      p.getAnAnnotation() = a and
      (
        a.getType().hasName("RequestBody") or
        a.getType().hasName("PathVariable") or
        a.getType().hasName("RequestParam") or
        a.getType().hasName("RequestHeader") or
        a.getType().hasName("CookieValue") or
        a.getType().hasName("ModelAttribute")
      ) and
      not p.getType().toString().matches("Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean") and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc, Expr arg |
      cc.getConstructor().getDeclaringType().hasQualifiedName("java.net", "URL") and
      cc.getArgument(0) = arg and
      sink.asExpr() = arg and
      isSuspiciousURLString(arg)
    )
    or
    exists(StringConcatenationOperation sco |
      sink.asExpr() = sco and
      isSuspiciousURLString(sco)
    )
  }

  predicate isSuspiciousURLString(Expr expr) {
    exists(string s |
      expr.getStringValue() = s and
      s.regexpMatches("http(s?)://%(v|s|q).*")
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "format" and
      (
        ma.getArgument(0).getStringValue().regexpMatches("http(s?)://%(v|s|q).*") or
        exists(Variable v |
          ma.getArgument(0) = v.getAnAccess() and
          v.getInitializer().getStringValue().regexpMatches("http(s?)://%(v|s|q).*")
        )
      )
    )
  }
}

