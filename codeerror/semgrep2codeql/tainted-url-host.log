Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 *              This could allow an attacker to send data to their own server,
 *              potentially exposing sensitive data such as cookies or authorization
 *              information sent with this request. They could also probe internal
 *              servers or other resources that the server running this code can access.
 *              (This is called server-side request forgery, or SSRF.)
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 *       external/owasp/a10
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class UrlSource extends DataFlow::Node {
  UrlSource() {
    exists(Call ma |
      (ma.getCallee().getName() = "getParameter" or 
       ma.getCallee().getName() = "getHeader" or
       ma.getCallee().getName() = "getCookie") and
      ma.getQualifier().getType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      this.asExpr() = ma
    )
    or
    exists(SpringController::RequestParam param |
      this.asExpr() = param.getAnAccess()
    )
    or
    exists(SpringController::PathVariable param |
      this.asExpr() = param.getAnAccess()
    )
  }
}

class UrlSink extends DataFlow::Node {
  UrlSink() {
    exists(ClassInstanceExpr url |
      url.getConstructionType().hasQualifiedName("java.net", "URL") and
      this.asExpr() = url.getArgument(0)
    )
    or
    exists(Expr concat |
      concat instanceof ConcatExpr and
      concat.getRightOperand().getStringValue().matches("http(s?)://[^/]+") and
      this.asExpr() = concat
    )
    or
    exists(Call concatCall |
      (concatCall.getCallee().getName() = "concat" or concatCall.getCallee().getName() = "format") and
      concatCall.getQualifier().getStringValue().matches("http(s?)://[^/]+") and
      this.asExpr() = concatCall
    )
  }
}

class UrlConfig extends TaintTracking::Configuration {
  UrlConfig() { this = "UrlConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UrlSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof UrlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from UrlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "User data flows into the host portion of this manually-constructed URL. This could lead to SSRF vulnerability."
