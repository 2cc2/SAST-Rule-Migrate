Rule Content:
/**
 * @name Seam Log Injection
 * @description Seam Logging API supports expression language that can introduce bean properties to log messages.
 *              The expression language might also lead to unwanted code execution if dynamic values are used.
 *              Verify the source of values to prevent unfiltered values from risky code evaluation.
 * @kind problem
 * @problem.severity error
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 *       technology/jboss
 */

import java

predicate isSeamLogImport(Import i) {
  exists(| i.getAReference().getPackage().getName() = "org.jboss.seam.log")
}

predicate isSeamLogVariable(Field f) {
  exists(MethodAccess ma | 
    ma.getMethod().getName() = "getLogger" and
    ma.getMethod().getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log")
  ) and
  f.getType().hasQualifiedName("org.jboss.seam.log", "Log")
}

predicate isLoggingMethod(Method m) {
  m.getName() = "debug" or
  m.getName() = "error" or
  m.getName() = "fatal" or
  m.getName() = "info" or
  m.getName() = "trace" or
  m.getName() = "warn"
}

from MethodAccess ma, Expr arg1, Expr arg2
where
  // Match log method calls like LOG.info(X + Y,...)
  ma.getMethod().hasName(isLoggingMethod(_)) and
  (exists(ma.getArgument(0) = arg1.| arg1 instanceof BinaryAddExpr) or
   exists(ma.getArgument(1) = arg2.| arg2 instanceof BinaryAddExpr)) and
  // Check if it's a Seam Log instance
  (exists(Field f | 
    ma.getQualifier() = f.getAnAccess() and
    isSeamLogVariable(f)
  ) or
  exists(Import i | 
    isSeamLogImport(i) and
    ma.getQualifier().getType().hasQualifiedName("org.jboss.seam.log", "Log")
  ))
select ma, "Seam logging with potential expression language injection. Verify dynamic values used in log messages."
