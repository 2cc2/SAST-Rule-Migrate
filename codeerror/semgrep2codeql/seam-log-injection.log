Rule Content:
/**
 * @name Seam Log Injection
 * @description Seam Logging API supports expression language that can introduce bean property to log messages.
 *              The expression language may lead to unwanted code execution if dynamic values are used unfiltered.
 * @kind problem
 * @problem.severity error
 * @precision low
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-95
 *       owasp-a3
 *       jboss
 */

import java

from Method logCall, Expr logArgument, StringLiteral infoLevel
where
  infoLevel.getValue().matches("debug|error|fatal|info|trace|warn") and
  (
    exists(Import i | i.getImportedType().getName() = "Log" and 
           i.getImportedType().getCompilationUnit().getPackage().getName() = "org.jboss.seam.log") or
    exists(Field f | f.getType().getName() = "Log" and 
           f.getType().getCompilationUnit().getPackage().getName() = "org.jboss.seam.log")
  ) and
  logCall.getName() = infoLevel.getValue() and
  logCall.getDeclaringType().getName() = "Log" and
  logCall.getDeclaringType().getCompilationUnit().getPackage().getName() = "org.jboss.seam.log" and
  logArgument = logCall.getAPrimaryQlClass()
select logCall, "Potential Seam log injection with dynamic expression language. Verify input values to prevent code execution."
