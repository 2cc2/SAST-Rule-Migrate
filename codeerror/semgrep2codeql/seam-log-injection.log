  logCall.getQualifier().getType().hasName("Log") and
  logCall.getQualifier().getType().getPackage().getName() = "org.jboss.seam.log" and
  logArgument = logCall.getArgument(0)
select logCall, "Potential Seam log injection with dynamic expression language. Verify input values to prevent code execution."
