import java

from MethodAccess logCall, Expr logArgument, StringLiteral infoLevel
where
  infoLevel.getValue().matches("debug|error|fatal|info|trace|warn") and
  (
    exists(ImportType i | i.getImportedName() = "org.jboss.seam.log.Log") or
