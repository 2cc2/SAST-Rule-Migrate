import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.web.HttpServletRequest
import semmle.code.java.web.HttpServletResponse
import semmle.code.java.io.PrintWriter

class ServletResponseWriterXSSCfg extends TaintTracking::Configuration {
  ServletResponseWriterXSSCfg() { this = "ServletResponseWriterXSSCfg" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      p.getCallable().getAParameter().getType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccessExpr writeCall |
      writeCall.getMethod().getName() = "write" and
      writeCall.getQualifier().getType().hasQualifiedName("java.io", "PrintWriter") and
      sink.asExpr() = writeCall.getAnArgument() and
      exists(MethodAccessExpr getWriterCall |
        getWriterCall.getMethod().getName() = "getWriter" and
        getWriterCall.getQualifier().getType().hasQualifiedName("javax.servlet.http", "HttpServletResponse")
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccessExpr encodeCall |
      encodeCall.getMethod().getName() = "forHtml" and
      encodeCall.getQualifier().toString() = "Encode" and
      sanitizer.asExpr() = encodeCall
    )
  }
}

