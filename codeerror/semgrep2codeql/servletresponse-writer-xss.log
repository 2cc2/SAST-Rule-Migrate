/**
 * @name ServletResponse Writer XSS
 * @description Detects cross-site scripting in HttpServletResponse writer where user input from
 *              HttpServletRequest flows directly into output without proper encoding.
 * @kind problem
 * @problem.severity error
 * @id java/servlet-response-writer-xss
 * @tags security
 *       external/cwe/cwe-79
 *       external/owasp/a07:2017
 *       external/owasp/a03:2021
 *       cwe2022-top25
 *       cwe2021-top25
 */

import java
import semmle.code.java.dataflow.TaintTracking
import javax.servlet.http.HttpServletRequest
import javax.servlet.http.HttpServletResponse
import java.io.PrintWriter

class ServletResponseWriterXSSCfg extends TaintTracking::Configuration {
  ServletResponseWriterXSSCfg() { this = "ServletResponseWriterXSSCfg" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      p.getCallable().getAParameter().getType() instanceof HttpServletRequest and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess writeCall |
      writeCall.getMethod().getName() = "write" and
      writeCall.getThisReceiver().getType() instanceof PrintWriter and
      sink.asExpr() = writeCall.getAnArgument() and
      exists(MethodAccess getWriterCall |
        getWriterCall.getMethod().getName() = "getWriter" and
        getWriterCall.getThisReceiver().getType() instanceof HttpServletResponse
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess encodeCall |
      encodeCall.getMethod().getName() = "forHtml" and
      encodeCall.getQualifier().toString() = "Encode" and
      sanitizer.asExpr() = encodeCall
    )
  }
}

