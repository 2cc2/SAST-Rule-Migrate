Rule Content:
/**
 * @name ServletResponse Writer XSS
 * @description Detects cross-site scripting in HttpServletResponse writer where user input from
 *              HttpServletRequest flows directly into output without proper encoding.
 * @kind problem
 * @problem.severity error
 * @id java/servlet-response-writer-xss
 * @tags security
 *       external/cwe/cwe-79
 *       external/owasp/a07:2017
 *       external/owasp/a03:2021
 *       cwe2022-top25
 *       cwe2021-top25
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.DataFlow

class ServletResponseWriterXSSCfg extends DataFlow::Configuration {
  ServletResponseWriterXSSCfg() { this = "ServletResponseWriterXSSCfg" }

  override predicate isSource(DataFlow::Node source) {
    exists(ParameterAccess reqParam | 
      source.asExpr() = reqParam.getAnAccess() and
      reqParam.getCallable().getAParameter().getType() instanceof TypeHttpServletRequest
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess writeCall |
      writeCall.getMethod().getName() = "write" and
      writeCall.getReceiver().getType() instanceof TypePrintWriter and
      sink.asExpr() = writeCall.getAnArgument() and
      exists(MethodAccess getWriterCall |
        getWriterCall.getMethod().getName() = "getWriter" and
        getWriterCall.getReceiver().getType() instanceof TypeHttpServletResponse
      )
    )
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    exists(MethodAccess encodeCall |
      encodeCall.getMethod().getName() = "forHtml" and
      encodeCall.getQualifier().toString() = "Encode" and
      barrier.asExpr() = encodeCall
    )
  }
}

from ServletResponseWriterXSSCfg cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "Cross-site scripting detected in HttpServletResponse writer. User input flows directly" +
  " from HttpServletRequest into output. Ensure data is properly encoded using " +
  "org.owasp.encoder.Encode.forHtml."
