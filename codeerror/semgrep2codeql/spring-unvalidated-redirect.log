/**
 * @name Spring Unvalidated Redirect
 * @description Application redirects a user to a destination URL specified by a user supplied 
 *              parameter that is not validated.
 * @kind problem
 * @problem.severity warning
 * @id java/spring-unvalidated-redirect
 * @tags security
 *       external/cwe/cwe-601
 *       external/owasp/a01
 */
import java

// Case 1: Direct return "redirect:" + URL
from Method m, Variable url, ReturnStmt ret
where 
  m.getAParameter() = url and
  (
    ret.getExpr() instanceof AddExpr and
    ret.getExpr().getLeftOperand().toString() = "\"redirect:\"" and
    ret.getExpr().getRightOperand() = url
  )
select ret, "Unvalidated redirect from user-supplied parameter"

// Case 2: Intermediate variable assignment then return
from Method m, Variable url, VariableAccess redirAcc, Variable redirVar, Assignment assign, ReturnStmt ret
where 
  m.getAParameter() = url and
  assign.getDest() = redirVar and
  assign.getSource() instanceof AddExpr and
  assign.getSource().getLeftOperand().toString() = "\"redirect:\"" and
  assign.getSource().getRightOperand() = url and
  redirAcc.getTarget() = redirVar and
  ret.getExpr() = redirAcc
select ret, "Unvalidated redirect from user-supplied parameter via intermediate variable"

// Case 3: Direct ModelAndView construction with "redirect:" + URL
from Method m, Variable url, ClassInstanceExpr cie
where 
  m.getAParameter() = url and
  cie.getConstructedType().hasQualifiedName("org.springframework.web.servlet", "ModelAndView") and
  (
    cie.getAnArgument() instanceof AddExpr and
    cie.getAnArgument().getLeftOperand().toString() = "\"redirect:\"" and
    cie.getAnArgument().getRightOperand() = url
  )
select cie, "Unvalidated redirect from user-supplied parameter in ModelAndView"

// Case 4: Intermediate variable then ModelAndView construction
from Method m, Variable url, VariableAccess redirAcc, Variable redirVar, Assignment assign, ClassInstanceExpr cie
where 
  m.getAParameter() = url and
  assign.getDest() = redirVar and
  assign.getSource() instanceof AddExpr and
  assign.getSource().getLeftOperand().toString() = "\"redirect:\"" and
  assign.getSource().getRightOperand() = url and
  redirAcc.getTarget() = redirVar and
  cie.getConstructedType().hasQualifiedName("org.springframework.web.servlet", "ModelAndView") and
  cie.getAnArgument() = redirAcc
select cie, "Unvalidated redirect from user-supplied parameter in ModelAndView via intermediate variable"
