Rule Content:
/**
 * @name Spring Unvalidated Redirect
 * @description Application redirects a user to a destination URL specified by a user supplied 
 *              parameter that is not validated.
 * @kind problem
 * @problem.severity warning
 * @id java/spring-unvalidated-redirect
 * @tags security
 *       external/cwe/cwe-601
 *       external/owasp/a01
 */
import java
import semmle.code.java.String

from Method m, Parameter url, Expr redirectExpr, Expr $result
where
  url = m.getAParameter() and
  (
    // Case 1: Direct return "redirect:" + URL
    (
      $result instanceof ReturnStmt and
      redirectExpr = $result.getReturnValue() and
      redirectExpr instanceof AddExpr and
      redirectExpr.getLeftOperand().toString() = "redirect:" and
      redirectExpr.getRightOperand() = url
    )
    or
    // Case 2: Intermediate variable assignment then return
    (
      redirectExpr instanceof AddExpr and
      redirectExpr.getLeftOperand().toString() = "redirect:" and
      redirectExpr.getRightOperand() = url and
      exists(Variable v |
        v.getAnAssignedValue() = redirectExpr and
        $result instanceof ReturnStmt and
        $result.getReturnValue() = v.getAnAccess()
      )
    )
    or
    // Case 3: Direct ModelAndView construction with "redirect:" + URL
    (
      $result instanceof ClassInstanceExpr and
      $result.getConstructedType().hasQualifiedName("org.springframework.web.servlet", "ModelAndView") and
      exists(Expr arg |
        arg = $result.getAnArgument() and
        arg instanceof AddExpr and
        arg.getLeftOperand().toString() = "redirect:" and
        arg.getRightOperand() = url
      )
    )
    or
    // Case 4: Intermediate variable then ModelAndView construction
    (
      redirectExpr instanceof AddExpr and
      redirectExpr.getLeftOperand().toString() = "redirect:" and
      redirectExpr.getRightOperand() = url and
      exists(Variable v |
        v.getAnAssignedValue() = redirectExpr and
        $result instanceof ClassInstanceExpr and
        $result.getConstructedType().hasQualifiedName("org.springframework.web.servlet", "ModelAndView") and
        $result.getAnArgument() = v.getAnAccess()
      )
    )
  )
select $result, "Unvalidated redirect from user-supplied parameter"
