Rule Content:
/**
 * @name SAXParserFactory DOCTYPE Declaration Missing
 * @description DOCTYPE declarations are enabled for this SAXParserFactory, making it vulnerable to XXE attacks.
 * @kind path-problem
 * @problem.severity error
 * @id java/saxparserfactory-disallow-doctype-decl-missing
 * @tags security
 *       asvs:5.5.2
 *       cwe:611
 *       owasp:a04,a05
 *       external/cwe/cwe-611
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 */
import java
import semmle.code.yaml.dataflow.TaintTracking
import DataFlow::PathGraph

class SAXParserFactoryCreation extends MethodAccess {
  SAXParserFactoryCreation() {
    this.getMethod().hasName("newInstance") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory")
  }
}

class DisableDoctypeFeature extends MethodAccess {
  DisableDoctypeFeature() {
    this.getMethod().hasName("setFeature") and
    this.getArgument(0).(StringLiteral).getValue() = 
      "http://apache.org/xml/features/disallow-doctype-decl" and
    this.getArgument(1).(BooleanLiteral).booleanValue() = true
  }
}

class DisableExternalEntitiesFeature extends MethodAccess {
  DisableExternalEntitiesFeature() {
    this.getMethod().hasName("setFeature") and
    (
      this.getArgument(0).(StringLiteral).getValue() = 
        "http://xml.org/sax/features/external-general-entities" or
      this.getArgument(0).(StringLiteral).getValue() = 
        "http://xml.org/sax/features/external-parameter-entities"
    ) and
    this.getArgument(1).(BooleanLiteral).booleanValue() = false
  }
}

class SafeSAXParserFactory extends MethodAccess {
  SafeSAXParserFactory() {
    exists(DisableDoctypeFeature ddf | 
      this.getEnclosingCallable() = ddf.getEnclosingCallable() and
      this.getMethod().hasName("newSAXParser")
    )
    or
    exists(DisableExternalEntitiesFeature deef1, DisableExternalEntitiesFeature deef2 |
      this.getEnclosingCallable() = deef1.getEnclosingCallable() and
      this.getEnclosingCallable() = deef2.getEnclosingCallable() and
      deef1.getArgument(0).(StringLiteral).getValue() != deef2.getArgument(0).(StringLiteral).getValue() and
      this.getMethod().hasName("newSAXParser")
    )
  }
}

class SAXParserFactoryConfig extends TaintTracking::Configuration {
  SAXParserFactoryConfig() { this = "SAXParserFactoryConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(SAXParserFactoryCreation spfc |
      source.asExpr() = spfc.getQualifier()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("newSAXParser") and
      sink.asExpr() = ma.getQualifier() and
      not exists(SafeSAXParserFactory sf | sf = ma)
    )
  }
}

from SAXParserFactoryConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "DOCTYPE declarations are enabled for this SAXParserFactory. This is vulnerable " +
  "to XML external entity attacks. Disable this by setting the feature " +
  "`http://apache.org/xml/features/disallow-doctype-decl` to true. Alternatively, " +
  "allow DOCTYPE declarations and only prohibit external entities declarations."
