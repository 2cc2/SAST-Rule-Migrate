/**
 * @name SAXParserFactory DOCTYPE declarations vulnerability
 * @description Detects SAXParserFactory instances where DOCTYPE declarations are enabled, making it vulnerable to XXE attacks.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @id java/saxparserfactory-doctype-vulnerability
 * @tags security
 *       external/cwe/cwe-611
 *       owasp-a04:2017
 *       owasp-a05:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking

class SAXParserFactoryCreation extends Expr {
  SAXParserFactoryCreation() {
    exists(Method m | 
      m.hasQualifiedName("javax.xml.parsers", "SAXParserFactory", "newInstance") and
      this = m.getACallTo()
    )
  }
}

class SafeFeatureSetting extends Expr {
  SafeFeatureSetting() {
    exists(Method m, Call c |
      m.hasQualifiedName("javax.xml.parsers", "SAXParserFactory", "setFeature") and
      c.getCallee() = m and
      this = c and
      (
        (c.getArgument(0).(StringLiteral).getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
         c.getArgument(1).(BooleanLiteral).booleanValue() = true)
        or
        (c.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-general-entities" and
         c.getArgument(1).(BooleanLiteral).booleanValue() = false)
        or
        (c.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-parameter-entities" and
         c.getArgument(1).(BooleanLiteral).booleanValue() = false)
      )
    )
  }
}

class SAXParserCreation extends Expr {
  SAXParserCreation() {
    exists(Method m | 
      m.hasQualifiedName("javax.xml.parsers", "SAXParserFactory", "newSAXParser") and
      this = m.getACallTo()
    )
  }
}

class TaintTrackingConfiguration extends TaintTracking::Configuration {
  TaintTrackingConfiguration() { this = "SAXParserFactoryTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(SAXParserFactoryCreation newInstance |
      source.asExpr() = newInstance and
      not exists(SafeFeatureSetting safeSetting |
        safeSetting.getEnclosingCallable() = newInstance.getEnclosingCallable()
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SAXParserCreation newSAXParser |
      sink.asExpr() = newSAXParser
    )
  }
}

