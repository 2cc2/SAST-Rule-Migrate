import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.XML

class SAXParserFactoryCreation extends MethodAccess {
  SAXParserFactoryCreation() {
    this.getMethod().hasQualifiedName("javax.xml.parsers", "SAXParserFactory", "newInstance")
  }
}

class SafeFeatureSetting extends MethodAccess {
  SafeFeatureSetting() {
    (
      this.getMethod().hasQualifiedName("javax.xml.parsers", "SAXParserFactory", "setFeature") and
      this.getArgument(0).(StringLiteral).getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
      this.getArgument(1).(BooleanLiteral).getValue() = true
    )
    or
    (
      this.getMethod().hasQualifiedName("javax.xml.parsers", "SAXParserFactory", "setFeature") and
      this.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-general-entities" and
      this.getArgument(1).(BooleanLiteral).getValue() = false
    )
    or
    (
      this.getMethod().hasQualifiedName("javax.xml.parsers", "SAXParserFactory", "setFeature") and
      this.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-parameter-entities" and
      this.getArgument(1).(BooleanLiteral).getValue() = false
    )
  }
}

class SAXParserCreation extends MethodAccess {
  SAXParserCreation() {
    this.getMethod().hasQualifiedName("javax.xml.parsers", "SAXParserFactory", "newSAXParser")
  }
}

class ConfigurableSAXParserFactory extends RefType {
  ConfigurableSAXParserFactory() {
    this.getASupertype*().hasQualifiedName("javax.xml.parsers", "SAXParserFactory")
  }
}

class TaintTrackingConfiguration extends TaintTracking::Configuration {
  TaintTrackingConfiguration() { this = "SAXParserFactoryTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(SAXParserFactoryCreation newInstance |
      source.asExpr() = newInstance.getQualifier()
    )
    and
    not exists(SafeFeatureSetting safeSetting |
      safeSetting.getQualifier().getAPredecessor*() = source.asExpr()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SAXParserCreation newSAXParser |
      sink.asExpr() = newSAXParser.getQualifier()
    )
  }
}

