Rule Content:
/**
 * @name Tainted command from HTTP request
 * @description Detected input from a HTTPServletRequest going into a 'ProcessBuilder' or 'exec' command.
 *              This could lead to command injection if variables passed into the exec commands are not
 *              properly sanitized. Instead, avoid using these OS commands with user-supplied input, or,
 *              if you must use these commands, use a whitelist of specific values.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.0
 * @id java/tainted-cmd-from-http-request
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class HttpRequestSource extends RemoteFlowSource {
  HttpRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") or
      ma.getMethod().getName() = "getValue" and
      ma.getQualifier().getType().hasQualifiedName("javax.servlet.http", "Cookie")
    )
  }
}

class CommandSink extends DataFlow::Node {
  CommandSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        ma.getMethod().getName() = "command"
      ) or
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
        ma.getMethod().getName() = "exec" and
        this = ma.getArgument(0)
      )
    )
  }
}

class TaintedCmdFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedCmdFromHttpRequestConfig() { this = "TaintedCmdFromHttpRequestConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CommandSink }
}

from TaintedCmdFromHttpRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Command injection vulnerability: user input from HTTP request flows into OS command execution."
