import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import DataFlow::PathGraph

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(Method m | 
      m.getName() = "getCookies" and
      this.asExpr() = m.getACall().getQualifier()
    ) or
    exists(Method m | 
      m.getName() = "getValue" and
      exists(DataFlow::Node cookieVar | 
        m.getACall().getQualifier() = cookieVar.asExpr() and
