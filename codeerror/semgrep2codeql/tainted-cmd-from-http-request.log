import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph2

class HttpRequestSource extends RemoteFlowSource {
  override predicate getSourceType() { this instanceof HttpRequestSource }

  HttpRequestSource() {
    exists(Method m |
      (
        m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") or
        m.getName() = "getValue" and
        m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
      ) and
      this.asParameter() = m.getAParameter()
    )
  }
}

class CommandSink extends DataFlow::Node {
  CommandSink() {
    exists(Method m |
      (
        m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        m.getName() = "command"
      ) or
      (
        m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
        m.getName() = "exec" and
        this.asExpr() = m.getParameter(0)
      )
    )
  }
}

class TaintedCmdFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedCmdFromHttpRequestConfig() { 
    this = "TaintedCmdFromHttpRequestConfig" 
  }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CommandSink }
}

