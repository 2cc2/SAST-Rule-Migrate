Rule Content:
/**
 * @name Tainted command from HTTP request
 * @description Detected input from a HTTPServletRequest going into a 'ProcessBuilder' or 'exec' command. This could
 *    lead to command injection if variables passed into the exec commands are not properly sanitized. Instead,
 *    avoid using these OS commands with user-supplied input, or, if you must use these commands, use a
 *    whitelist of specific values.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-cmd-from-http-request
 * @tags security
 *       external/cwe/cwe-078
 *       owasp-a01
 *       owasp-a03
 *       cwe2021-top25
 *       cwe2022-top25
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpRequestSource extends RemoteFlowSource::Range {
  HttpRequestSource() {
    exists(MethodAccess getCookiesCall | 
      getCookiesCall.getMethod().getName() = "getCookies" and
      this.asExpr() = getCookiesCall.getQualifier().(VariableAccess).getVariable()
    ) or
    exists(MethodAccess getValueCall | 
      getValueCall.getMethod().getName() = "getValue" and
      exists(Variable v | 
        getValueCall.getQualifier() = v.getAnAccess() and
        v.getType() instanceof TypeCookie and
        this.asExpr() = getValueCall
      )
    )
  }
}

class CommandSink extends DataFlow::Node {
  CommandSink() {
    exists(ProcessBuilder pb | pb.getConstruction().getExpr() = this.asExpr()) or
    exists(MethodAccess execCall | 
      execCall.getMethod().getName() = "exec" and
      execCall.getMethod().getDeclaringType() instanceof TypeRuntime and
      (
        this.asExpr() = execCall.getArgument(0) or
        exists(DataFlow::Node arg | 
          arg.asExpr() = execCall.getArgument(0) and
          this.asExpr() = arg
        )
      )
    ) or
    exists(MethodAccess commandCall | 
      commandCall.getMethod().getName() = "command" and
      commandCall.getMethod().getDeclaringType() instanceof TypeProcessBuilder and
      exists(DataFlow::Node arg | 
        arg.asExpr() = commandCall.getArgument(0) and
        this.asExpr() = arg
      )
    )
  }
}

class Configuration extends TaintTracking::Configuration {
  Configuration() { this = "TaintedCommandFromHttpRequest" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CommandSink
  }
}

from Configuration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Input from HTTP request flows into OS command and may cause command injection"
