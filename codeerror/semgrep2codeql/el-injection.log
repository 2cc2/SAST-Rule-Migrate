Rule Content:
/**
 * @name EL Injection
 * @description Detects improper control of code generation (Expression Language injection).
 * @kind problem
 * @problem.severity warning
 * @precision low
 * @id java/el-injection
 * @tags security
 *       external/cwe/cwe-094
 *       owasp-a3
 *       cwe2022-top25
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.ExpressionLanguage

class ELInjection extends DataFlow::Configuration {
  ELInjection() { this = "ELInjection" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p |
      m.getAParameter() = p and
      p.getType().getName() = "String" and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "createValueExpression" or
       ma.getMethod().getName() = "createMethodExpression") and
      ma.getMethod().getDeclaringType().getName() = "ExpressionFactory" and
      sink.asExpr() = ma.getArgument(1)
    ) or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "buildConstraintViolationWithTemplate" and
      sink.asExpr() = ma.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ELInjection conf
where conf.hasFlowPath(source, sink)
select sink.getNode(), "An expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."
