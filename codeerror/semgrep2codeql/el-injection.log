/**
 * @name Expression Language Injection
 * @description Detects dynamic Expression Language (EL) evaluation that could lead to code injection
 * @kind path-problem
 * @problem.severity warning
 * @id java/el-injection
 * @tags security
 *       external/cwe/cwe-094
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.security.SecurityHelpers

class ElInjectionConfig extends TaintTracking::Configuration {
  ElInjectionConfig() { this = "ElInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Expr arg |
      m.hasName(["createValueExpression", "createMethodExpression", "buildConstraintViolationWithTemplate"]) and
      (
        m.getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") or
        m.getDeclaringType().hasQualifiedName("javax.validation", "ConstraintValidatorContext")
      ) and
      arg = m.getACall().getArgument(1) and
      sink.asExpr() = arg
    )
  }
}

