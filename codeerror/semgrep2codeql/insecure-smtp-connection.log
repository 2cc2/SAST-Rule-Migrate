/**
 * @name Insecure SMTP Connection
 * @description Detects insecure SMTP connections that trust any SSL certificate.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-smtp-connection
 * @tags security
 *       external/cwe/cwe-297
 *       owasp/a07
 */

import java

from MethodAccess sendCall, MethodAccess setSSLCall, SimpleEmailCreation create
where
  // Find SimpleEmail creation
  create.getConstructedType().hasQualifiedName("org.apache.commons.mail", "SimpleEmail") and
  // Find send() method calls on SimpleEmail instances
  sendCall.getMethod().hasName("send") and
  sendCall.getQualifier().getType() = create.getConstructedType() and
  // Ensure there's no setSSLCheckServerIdentity(true) call
  not exists(MethodAccess checkIdentity |
    checkIdentity.getMethod().hasName("setSSLCheckServerIdentity") and
    checkIdentity.getArgument(0).(BooleanLiteral).getValue() = true and
    checkIdentity.getQualifier() = sendCall.getQualifier()
  )
select sendCall, "Insecure SMTP connection detected. This connection will trust any SSL certificate. " +
  "Enable certificate verification by setting 'email.setSSLCheckServerIdentity(true)'."
