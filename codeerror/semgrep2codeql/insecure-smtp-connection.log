/**
 * @name Insecure SMTP Connection
 * @description Detects insecure SMTP connections that trust any SSL certificate.
 * @kind problem
 * @id java/insecure-smtp-connection
 * @severity Warning
 * @security-severity 6.1
 * @tags security
 *       external/cwe/cwe-297
 *       owasp/a07
 */

import java
import semmle.code.java.security.InsecureConfigurations

class InsecureSMTPConnection extends MethodAccess {
  InsecureSMTPConnection() {
    exists(MethodAccess send |
      send.getMethod().hasName("send") and
      send.getQualifier().getType().hasName("SimpleEmail") and
      not exists(MethodAccess checkServerIdentity |
        checkServerIdentity.getMethod().hasName("setSSLCheckServerIdentity") and
        checkServerIdentity.getArgument(0).(BooleanLiteral).getValue() = true and
        checkServerIdentity.getQualifier() = send.getQualifier()
      )
    )
    and
    this.getMethod().hasName("send")    )
}

from InsecureSMTPConnection s
select s, "Insecure SMTP connection detected. This connection will trust any SSL certificate. Enable certificate verification by setting 'email.setSSLCheckServerIdentity(true)'."
