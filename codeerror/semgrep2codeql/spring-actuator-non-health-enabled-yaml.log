Rule Content:
/**
 * @name Spring Actuator Dangerous Endpoints Enabled
 * @description Detects when potentially dangerous Spring Actuator endpoints are enabled in YAML configuration.
 * @kind path-problem
 * @problem.severity warning
 * @id spring/actuator-dangerous-endpoints-enabled
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a01
 *       external/cwe/top-25
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.yaml.Yaml

predicate isActuatorEndpoint(string endpoint) {
  endpoint = "health" or endpoint = "*"
}

class DangerousActuatorConfig extends TaintTracking::Configuration {
  DangerousActuatorConfig() { this = "DangerousActuatorConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Yaml::Node node |
      node.getPath() = "management.endpoints.web.exposure.include" and
      source.asExpr() = node.getValue() and
      exists(node.getAChild().getValue().toString() as endpoint |
        not isActuatorEndpoint(endpoint)
      )
    )
  }
}

from DangerousActuatorConfig cfg, DataFlow::Node node
where cfg.isSource(node)
select node, "Spring Boot Actuator endpoint is enabled. Depending on the actuator, this can pose a significant security risk. Please double-check if the actuator is needed and properly secured."
