/**
 * @name Spring Actuator Dangerous Endpoints Enabled
 * @description Detects when Spring Boot Actuator exposes dangerous endpoints through YAML configuration
 * @id spring-actuator-dangerous-endpoints-enabled-yaml
 * @kind problem
 * @problem.severity warning
 * @precision medium
 * @tags security
 *       spring
 *       external/cwe/cwe-200
 *       owasp-a01
 */

import yaml
import semmle.code.yaml.dataflow.TaintTracking

predicate isDangerousActuator(string actuator) {
  not (actuator = "health" or actuator = "*")
}

from YamlFile file, YamlMapping mapping, YamlKeyValue exposureKV, YamlKeyValue includeKV,
     YamlSequence sequence, YamlSequenceElement element, string actuator
where
  mapping = file.getRoot().getMapping() and
  mapping.getKeyValue("management").getMapping().getKeyValue("endpoints").getMapping()
          .getKeyValue("web").getMapping().getKeyValue("exposure") = exposureKV and
  exposureKV.getMapping().getKeyValue("include") = includeKV and
  includeKV.getValue() = sequence and
  sequence.getElement(_) = element and
  element.getStringValue() = actuator and
  isDangerousActuator(actuator)
select includeKV, 
  "Spring Boot Actuator \"" + actuator + "\" is enabled. Depending on the actuator, this can pose a significant " +
  "security risk. Please double-check if the actuator is needed and properly secured."
