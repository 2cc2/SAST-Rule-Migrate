/**
 * @name No JSP Scriptlets
 * @description JSP scriptlet detected. Scriptlets are difficult to use securely and are considered bad practice.
 * @kind problem
 * @problem.severity warning
 * @precision medium
 * @id jsp/no-scriptlets
 * @tags security
 *       owasp:a03
 *       cwe:116
 * @reference http://stackoverflow.com/a/3180202,
 *             Useful StackOverflow thread explaining the issue
 */

import java
import Regex

from Regex::SimplePatternMatch scriptlet
where scriptlet.getADocument().getFile().getExtension() = "jsp"
  and scriptlet.getRegex().toString() = "<%[^@].*"
select scriptlet, "JSP scriptlet detected. Consider migrating to JSF or using Expression Language '${...}' with escapeXml function."
