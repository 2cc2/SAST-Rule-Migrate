/**
 * @name JSP Scriptlet Detection
 * @description JSP scriptlet detected. Scriptlets are difficult to use securely and
 *              are considered bad practice. See https://stackoverflow.com/a/3180202.
 *              Instead, consider migrating to JSF or using the Expression Language
 *              '${...}' with the escapeXml function in your JSP files.
 * @kind path-problem
 * @problem.severity warning
 * @id jsp/no-scriptlets
 * @tags security
 *       external/cwe/cwe-116
 *       external/owasp/a03
 */

import java
import jsp

class JspScriptlet extends JspFile {
  JspScriptlet() { 
    this.getFileType() = JspFileType.JSP and
    exists(RegexpMatch r |
      r.getFile() = this and
      r.getPattern().regexpMatch("\\<\\%[^\\@].*")
    )
  }
}

from JspScriptlet js
select js, "JSP scriptlet detected. Scriptlets are difficult to use securely and are considered bad practice."
