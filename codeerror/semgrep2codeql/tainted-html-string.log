/**
 * @name Tainted HTML String
 * @description Detected user input flowing into a manually constructed HTML string.
 * @id tainted-html-string
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @tags security
 *       external/cwe/cwe-079
 *       external/cwe/cwe-116
 *       owasp-a03
 *       owasp-a07
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Spring

class TaintedHtmlStringConfig extends TaintTracking::Configuration {
  TaintedHtmlStringConfig() { this = "TaintedHtmlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p |
      m.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", 
        ["RequestBody", "PathVariable", "RequestParam", "RequestHeader", "CookieValue", "ModelAttribute"]) and
      p = m.getAParameter() and
      source.asParameter() = p and
      not p.getType() instanceof BoxedType and
      not p.getType() instanceof PrimitiveType
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma, string prefix |
      (ma.getMethod().getName() = "ResponseEntity" or ma.getMethod().getName() matches "^ok|of$") and
      prefix = ma.getArgument(0).(Literal).getStringValue() and
      prefix.matches("^<\\w+") and
      sink.asExpr() = ma.getArgument(0)
    )
    or
    exists(StringBuilder sb, string prefix |
      prefix = sb.getStringInit().getStringValue() and
      prefix.matches("^<\\w+") and
      sink.asExpr() = sb.getAnAppend().getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.owasp.esapi", "Encoder", "encodeForHTML") or
      ma.getMethod().hasQualifiedName("org.owasp.html", "PolicyFactory", "sanitize") or
      ma.getMethod().hasQualifiedName("org.owasp.validator.html", "AntiSamy", "scan") or
      ma.getMethod().hasQualifiedName("org.jsoup", "Jsoup", "clean") and
      sanitizer.asExpr() = ma.getArgument(0)
    )
  }
}

from TaintedHtmlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
