/**
 * @name Tainted HTML String
 * @description Detects user input flowing into a manually constructed HTML string.
 *              This could create a cross-site scripting vulnerability if the HTML
 *              is not rendered safely.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-html-string
 * @tags security
 *       external/cwe/cwe-79
 *       external/owasp/a07
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.Spring

class HtmlInputSource extends DataFlow::Node {
  HtmlInputSource() {
    exists(Method m, Parameter p |
      m.getAnAnnotation().getTypeName() in [
        "org.springframework.web.bind.annotation.RequestBody",
        "org.springframework.web.bind.annotation.PathVariable",
        "org.springframework.web.bind.annotation.RequestParam",
        "org.springframework.web.bind.annotation.RequestHeader",
        "org.springframework.web.bind.annotation.CookieValue",
        "org.springframework.web.bind.annotation.ModelAttribute"
      ] and
      p = m.getAParameter() and
      not p.getType().hasName(["Integer","Long","Float","Double","Char","Boolean","int","long","float","double","char","boolean"]) and
      this.asParameter() = p
    )
  }
}

class HtmlStringLiteral extends DataFlow::Node {
  HtmlStringLiteral() {
    exists(StringLiteral s |
      s.toString().matches("^<\\w+") and
      this.asExpr() = s
    )
  }
}

class HtmlConcatenation extends DataFlow::Node {
  HtmlConcatenation() {
    this = any(AddExpr e | 
      e.getLeftOp().getLiteral().toString().matches("^<\\w+")
    ) or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "concat" and
      ma.getQualifier().getLiteral().toString().matches("^<\\w+") and
      this.asExpr() = ma
    ) or
    exists(MethodAccess ma, StringLiteral s |
      ma.getMethod().getName() = "append" and
      ma.getQualifier().getType().hasName("StringBuilder") and
      s.getValue().matches("^<\\w+") and
      s = ma.getQualifier().getAValue() and
      this.asExpr() = ma
    )
  }
}

class HtmlSink extends DataFlow::Node {
  HtmlSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("org.springframework.http", "ResponseEntity") and
      this.asExpr() = cc.getArgument(0)
    ) or
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.http", "ResponseEntity") and
      ma.getMethod().getName() = "body" and
      this.asExpr() = ma.getArgument(0)
    ) or
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.http", "ResponseEntity") and
      ma.getMethod().getName().matches("ok|of") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class HtmlSanitizer extends DataFlow::Node {
  HtmlSanitizer() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "forHtml" and
       ma.getMethod().getDeclaringType().hasQualifiedName("org.owasp.esapi", "Encoder")) or
      (ma.getMethod().getName() = "sanitize" and
       ma.getMethod().getDeclaringType().hasQualifiedName("org.owasp.html", "PolicyFactory")) or
      (ma.getMethod().getName() = "scan" and
       ma.getMethod().getDeclaringType().hasQualifiedName("org.owasp.validator.html", "AntiSamy")) or
      (ma.getMethod().getName() = "clean" and
       ma.getMethod().getDeclaringType().hasQualifiedName("org.jsoup", "JSoup"))
    )
  }
}

class HtmlTaintConfig extends TaintTracking::Configuration {
  HtmlTaintConfig() { this = "HtmlTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HtmlInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlSink and
    exists(DataFlow::Node html | 
      html instanceof HtmlStringLiteral or 
      html instanceof HtmlConcatenation |
      TaintTracking::localTaint(html, sink)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof HtmlSanitizer
  }
}

