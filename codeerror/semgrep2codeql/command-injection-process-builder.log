Rule Content:
/**
 * @name Command Injection in ProcessBuilder
 * @description When a command string in ProcessBuilder is constructed from user input without 
 *              proper sanitization, it may lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class ProcessBuilderConstruction extends Expr {
  ProcessBuilderConstruction() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this = cc
    )
  }
}

class ProcessBuilderCommand extends MethodAccess {
  ProcessBuilderCommand() {
    exists(Method m | 
      m.hasName("command") and
      m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.getMethod() = m
    )
  }
}

class CommandSource extends DataFlow::Node {
  CommandSource() {
    exists(Method m |
      m.hasName(["doGet", "doPost", "getParameter"]) and
      m.getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet.http", "HttpServlet") and
      this.asParameter() = m.getAParameter()
    )
    or
    exists(Expr e | 
      e instanceof Literal and not e.(Literal).getValue().regexpMatch("\".*\"") and
      this.asExpr() = e
    )
  }
}

class CommandSink extends DataFlow::Node {
  CommandSink() {
    exists(ProcessBuilderConstruction pb |
      pb.getArgument(0) = this.asExpr()
    )
    or
    exists(ProcessBuilderCommand pbc |
      pbc.getArgument(0) = this.asExpr()
    )
  }
}

class ShellCommandPattern extends DataFlow::Node {
  ShellCommandPattern() {
    exists(Literal lit |
      lit.getValue().toString().matches("(sh|bash|ksh|csh|tcsh|zsh)") and
      this.asExpr() = lit
    )
    or
    exists(Literal lit |
      lit.getValue().toString() = "cmd" and
      this.asExpr() = lit
    )
  }
}

class CommandConfig extends TaintTracking::Configuration {
  CommandConfig() { this = "CommandConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof CommandSource or
    exists(ShellCommandPattern scp | scp = source)
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof CommandSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { 
    exists(Literal lit | 
      lit.getValue().regexpMatch("\".*\"") and
      sanitizer.asExpr() = lit
    )
  }
}

from CommandConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Possible command injection vulnerability in ProcessBuilder: User input may control command execution"
