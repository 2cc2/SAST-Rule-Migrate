Rule Content:
/**
 * @name Command Injection via ProcessBuilder
 * @description Detects dangerous ProcessBuilder usage that could lead to command injection
 * @id command-injection-process-builder
 * @kind problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision medium
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 *       owasp-a01
 *       owasp-a03
 */
import java

class ProcessBuilderConstruction extends ConstructorCall {
  ProcessBuilderConstruction() {
    this.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder")
  }
}

class UnsafeProcessBuilderCommand extends MethodAccess {
  UnsafeProcessBuilderCommand() {
    this.getMethod().hasName("command") and
    this.getQualifier().getType().hasQualifiedName("java.lang", "ProcessBuilder")
  }
}

predicate isUnsafeArgument(Expr arg) {
  not arg.isCompileTimeConstant() and
  not exists(
    LocalVariableDecl lv |
    lv.getAnAssignedValue() = arg and
    (
      exists(StringLiteral sl | sl = lv.getAnAssignedValue()) or
      exists(ArrayInit ai | ai = lv.getAnAssignedValue()) or
      exists(MethodAccess ma | ma = lv.getAnAssignedValue())
    )
  ) and
  (
    not exists(ArrayInit ai | ai = arg) or
    not exists(MethodAccess ma | 
      ma = arg and
      ma.getMethod().hasName("asList") and
      ma.getAnArgument().isCompileTimeConstant()
    )
  )
}

from ProcessBuilderConstruction pb, Expr cmd
where 
  (cmd = pb.getArgument(0) or (pb.getNumArgument() > 0 and cmd = pb.getArgument(0)))
  and isUnsafeArgument(cmd)
select pb, "Potential command injection in ProcessBuilder construction - $@ might contain user input", 
  cmd, "variable"

from UnsafeProcessBuilderCommand ma, Expr cmd
where
  (cmd = ma.getArgument(0) or (ma.getNumArgument() > 0 and cmd = ma.getArgument(0)))
  and isUnsafeArgument(cmd)
select ma, "Potential command injection in ProcessBuilder.command() call - $@ might contain user input",
  cmd, "parameter"

from UnsafeProcessBuilderCommand ma, Expr arg
where
  (
    exists(StringLiteral cmd | 
      cmd = ma.getAnArgument() and
      (
        cmd.getValue().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh|cmd)") and
        exists(StringLiteral flag |
          flag = ma.getAnArgument() and
          (flag.getValue() = "-c" or flag.getValue() = "/c")
        )
      )
    ) or
    exists(ArrayInit arr |
      arr = ma.getAnArgument() and
      exists(StringLiteral cmd |
