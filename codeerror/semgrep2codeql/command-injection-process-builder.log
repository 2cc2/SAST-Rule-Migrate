import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.Expr

class ProcessBuilderConstruction extends DataFlow::Node {
  ProcessBuilderConstruction() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.asExpr() = cc and
      not (
        exists(StringLiteral sl | sl = cc.getArgument(0)) or
        exists(ArrayInit ai | ai = cc.getArgument(0) | ai.getInit().forall(InitExpr e | exists(StringLiteral sl | sl = e))) or
        exists(MethodAccess ma | ma = cc.getArgument(0) and ma.getName() = "asList" |
          ma.getArgument().forall(Expr e | exists(StringLiteral sl | sl = e))
        )
      )
    )
  }
}

class ProcessBuilderCommandCall extends DataFlow::Node {
  ProcessBuilderCommandCall() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "command" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.asExpr() = ma and
      not (
        exists(StringLiteral sl | sl = ma.getArgument(0)) or
        exists(ArrayInit ai | ai = ma.getArgument(0) | ai.getInit().forall(InitExpr e | exists(StringLiteral sl | sl = e))) or
        exists(MethodAccess ma2 | ma2 = ma.getArgument(0) and ma2.getName() = "asList" |
          ma2.getArgument().forall(Expr e | exists(StringLiteral sl | sl = e))
        )
      )
    )
  }
}

class ShellCommandPattern extends DataFlow::Node {
  ShellCommandPattern() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.asExpr() = cc and
      (
        (exists(StringLiteral sl | sl = cc.getArgument(0) |
          sl.getLiteral() = "sh" or sl.getLiteral() = "bash" or
          sl.getLiteral() = "ksh" or sl.getLiteral() = "csh" or
          sl.getLiteral() = "tcsh" or sl.getLiteral() = "zsh"
        ) and
