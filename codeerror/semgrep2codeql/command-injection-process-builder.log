/**
 * @name Command injection in ProcessBuilder
 * @description Detects potentially unsafe ProcessBuilder usage that could lead to command injection
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.controlflow.BinaryExpr
import semmle.code.java.controlflow.BinaryAddOp

class ProcessBuilderCommand extends DataFlow::Node {
  ProcessBuilderCommand() {
    exists(MethodCall ma |
      ma.getMethod().hasName("command") and
      ma.getQualifier().getType().getName() = "ProcessBuilder" and
      this.asExpr() = ma.getAnArgument()
    )
    or
    exists(ClassInstanceExpr cie |
      cie.getTypeName().getName() = "ProcessBuilder" and
      this.asExpr() = cie.getAnArgument()
    )
  }
}

class SafeStringLiteral extends DataFlow::Node {
  SafeStringLiteral() {
    exists(StringLiteral sl | this.asExpr() = sl)
    or
    exists(ArrayInit ai |
      forall(Expr e |
        ai.getAnInit() = e and
        exists(StringLiteral sl | e = sl)
      ) and
      this.asExpr() = ai
    )
    or
    exists(MethodCall ma |
      ma.getMethod().hasName("asList") and
      ma.getMethod().getDeclaringType().getName() = "Arrays" and
      forall(Expr e |
        ma.getAnArgument() = e and
        exists(StringLiteral sl | e = sl)
      ) and
      this.asExpr() = ma
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ProcessBuilderCommand and
    not source instanceof SafeStringLiteral
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall ma |
      (ma.getMethod().hasName("command") and ma.getQualifier().getType().getName() = "ProcessBuilder" or
      ma.getMethod().hasName("<init>") and ma.getQualifier().getType().getName() = "ProcessBuilder") and
      sink.asExpr() = ma.getAnArgument()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodCall ma |
      ma.getMethod().hasName("concat") and
      node1.asExpr() = ma.getQualifier() and
      node2.asExpr() = ma
    )
    or
    exists(BinaryExpr be |
      be.getOp() instanceof BinaryAddOp and
      node1.asExpr() = be.getLeftOperand() and
      node2.asExpr() = be
    )
  }
}

