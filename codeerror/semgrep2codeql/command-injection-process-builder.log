Rule Content:
/**
 * @name ProcessBuilder Command Injection
 * @description Detects potentially unsafe ProcessBuilder usage with non-constant commands
 *              which could lead to command injection if inputs are user-controlled.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class ProcessBuilderCall extends Call {
  ProcessBuilderCall() { 
    this.getCallee().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
    (
      this.getCallee().getName() = "ProcessBuilder" or
      this.getCallee().getName() = "command"
    )
  }
}

class PotentiallyUnsafeProcessBuilder extends ProcessBuilderCall {
  PotentiallyUnsafeProcessBuilder() {
    exists(DataFlow::Node arg |
      arg.asExpr() = this.getAnArgument() and
      not arg.asExpr() instanceof StringLiteral and
      not exists(ArrayCreationExpr arr | 
        arg.asExpr() = arr and
        arr.getArrayInitializer() instanceof ArrayInitializer init and
        forall(Expr expr | 
          expr = init.getInit() |
          expr instanceof StringLiteral
        )
      ) and
      not exists(MethodAccess ma |
        ma.getMethod().getName() = "asList" and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.util", "Arrays") and
        arg.asExpr() = ma and
        forall(Expr expr | expr = ma.getArgument() | expr instanceof StringLiteral)
      )
    )
  }
}

class ShellInvocation extends ProcessBuilderCall {
  ShellInvocation() {
    (
      exists(Expr cmd, Expr arg |
        cmd = this.getArgument(0) and
        arg = this.getArgument(2) and
        (
          (cmd instanceof StringLiteral and
           cmd.toString().matches("/(sh|bash|ksh|csh|tcsh|zsh)/") and
           this.getArgument(1).toString() = "-c") or
          (cmd instanceof StringLiteral and
           cmd.toString() = "cmd" and
           this.getArgument(1).toString() = "/c")
        ) and
        not arg instanceof StringLiteral
      )
    )
  }
}

class ProcessBuilderSource extends DataFlow::Node {
  ProcessBuilderSource() {
    exists(PotentiallyUnsafeProcessBuilder pb |
      this.asExpr() = pb.getAnArgument()
    ) or
    exists(ShellInvocation si |
      this.asExpr() = si.getArgument(2)
    )
  }
}

class ProcessBuilderConfiguration extends TaintTracking::Configuration {
  ProcessBuilderConfiguration() { this = "ProcessBuilderCommandInjection" }

  override predicate isSource(DataFlow::Node source) { source instanceof ProcessBuilderSource }

  override predicate isSink(DataFlow::Node sink) {
    exists(PotentiallyUnsafeProcessBuilder pb | sink.asExpr() = pb) or
    exists(ShellInvocation si | sink.asExpr() = si)
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from ProcessBuilderConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Potentially unsafe ProcessBuilder command construction. User-controlled inputs should be sanitized to prevent command injection."
