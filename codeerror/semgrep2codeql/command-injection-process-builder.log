/**
 * @name Command Injection in ProcessBuilder
 * @description Detects potential command injection vulnerabilities in ProcessBuilder usage
 * @id command-injection-process-builder
 * @kind path-problem
 * @problem.severity error
 * @precision low
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class ProcessBuilderCommandInjection extends TaintTracking::Sink {
  ProcessBuilderCommandInjection() {
    exists(Method m |
      (m.getName() = "ProcessBuilder" and m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
       not exists(StringLiteral sl | sl = m.getACall().getArgument(0)) and
       not exists(ArrayCreationExpr ace | ace = m.getACall().getArgument(0)) and
       not exists(MethodAccess ma | ma.getMethod().getName() = "asList" and ma = m.getACall().getArgument(0))
      )
      or
      (m.getName() = "command" and m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
       not exists(StringLiteral sl | sl = m.getACall().getArgument(0)) and
       not exists(ArrayCreationExpr ace | ace = m.getACall().getArgument(0)) and
       not exists(MethodAccess ma | ma.getMethod().getName() = "asList" and ma = m.getACall().getArgument(0))
      )
      or
      ((m.getName() = "ProcessBuilder" or m.getName() = "command") and
       (
         (exists(StringLiteral sl | sl = m.getACall().getArgument(0) and sl.getValue().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)")) and
          exists(StringLiteral sl2 | sl2 = m.getACall().getArgument(1) and sl2.getValue() = "-c") and
          not exists(StringLiteral sl3 | sl3 = m.getACall().getArgument(2))
         )
         or
         ((exists(StringLiteral sl | sl = m.getACall().getArgument(0) and sl.getValue() = "cmd") or
           exists(Variable v | v.getName() = "CMD" and exists(StringLiteral slInit | slInit = v.getInitializer() and slInit.getValue() = "cmd"))
          ) and
          exists(StringLiteral sl4 | sl4 = m.getACall().getArgument(1) and sl4.getValue() = "/c") and
          not exists(StringLiteral sl5 | sl5 = m.getACall().getArgument(2))
         )
       )
      )
    )
  }
}

