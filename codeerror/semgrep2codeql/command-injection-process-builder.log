 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.security.CommandInjection

class ProcessBuilderCommandInjection extends CommandInjectionSink {
  ProcessBuilderCommandInjection() {
    exists(MethodAccess ma |
      // Case 1: new ProcessBuilder(command, ...)
      (ma.getMethod().getName() = "ProcessBuilder" and ma.getMethod().getDeclaringType().getName() = "ProcessBuilder" and
       not ma.getArgument(0).(StringLiteral).getValue().regexpMatch(".*") and
       not ma.getArgument(0).isArrayInitializer() and
       not ma.getArgument(0).isListLiteral()
      )
      or
      // Case 2: ProcessBuilder instance command() method
      (ma.getMethod().getName() = "command" and ma.getMethod().getDeclaringType().getName() = "ProcessBuilder" and
       not ma.getArgument(0).(StringLiteral).getValue().regexpMatch(".*") and
       not ma.getArgument(0).isArrayInitializer() and
       not ma.getArgument(0).isListLiteral()
      )
      or
      // Case 3: Shell command patterns
      ((ma.getMethod().getName() = "ProcessBuilder" or ma.getMethod().getName() = "command") and
       (
         // Shell pattern with -c
         (ma.getArgument(0).(StringLiteral).getValue().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)") and
          exists(ma.getArgument(1) | ma.getArgument(1).(StringLiteral).getValue() = "-c") and
          not ma.getArgument(2).isStringLiteral()
         )
         or
         // cmd.exe pattern with /c
         ((ma.getArgument(0).(StringLiteral).getValue() = "cmd" or
           exists(VariableAccess va | va.getVariable().getName() = "CMD" and va.getVariable().getInitializer().(StringLiteral).getValue() = "cmd")
          ) and
          exists(ma.getArgument(1) | ma.getArgument(1).(StringLiteral).getValue() = "/c") and
          not ma.getArgument(2).isStringLiteral()
         )
       )
      )
    )
  }
}

