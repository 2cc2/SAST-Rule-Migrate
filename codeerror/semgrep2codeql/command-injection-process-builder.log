/**
 * @name Potential Command Injection in ProcessBuilder
 * @description Detects potentially unsafe ProcessBuilder usage where command arguments may be influenced by user input.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.Expr
import semmle.code.java.StringUtil

class ProcessBuilderConstruction extends DataFlow::Node {
  ProcessBuilderConstruction() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.asExpr() = cc
    )
  }
}

class ProcessBuilderCommandMethod extends DataFlow::Node {
  ProcessBuilderCommandMethod() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "command" and
      mc.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.asExpr() = mc
    )
  }
}

class ShellCommandPattern extends DataFlow::Node {
  ShellCommandPattern() {
    exists(ArrayCreationExpr ace, StringLiteral lit |
      ace.getAnInitializer() = lit and
      lit.getValue().regexpMatch(".*(/bin/(sh|bash|ksh|csh|tcsh|zsh)|cmd).*")
    ) or
    exists(StringLiteral lit |
      lit.getValue().regexpMatch(".*(/bin/(sh|bash|ksh|csh|tcsh|zsh)|cmd).*")
    )
  }
}

predicate isLiteralArgument(Expr arg) {
  exists(StringLiteral _ | arg = _) or
  exists(ArrayCreationExpr ace | arg = ace and ace.getAnInitializer() instanceof StringLiteral) or
  exists(MethodCall mc | 
    mc.getMethod().getName() = "asList" and
    mc.getMethod().getDeclaringType().hasQualifiedName("java.util", "Arrays") and
    arg = mc and
    mc.getAnArgument() instanceof StringLiteral
  )
}

class DangerousArgument extends DataFlow::Node {
  DangerousArgument() {
    exists(MethodCall mc |
      (
        mc.getMethod().getName() = "command" or
        mc.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
      ) and
      this.asExpr() = mc.getAnArgument() and
      not isLiteralArgument(mc.getAnArgument())
    )
  }
}

class ProcessBuilderConfig extends TaintTracking::Configuration {
  ProcessBuilderConfig() { this = "ProcessBuilderCommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof DangerousArgument or
    source instanceof ShellCommandPattern
  }

  override predicate isSink(DataFlow::Node sink) {
