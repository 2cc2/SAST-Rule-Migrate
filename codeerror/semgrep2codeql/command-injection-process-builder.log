          arg.(ArrayCreation).getInitializer().getAnInit().get(0).(Literal).getValue() = shell and
          exists(Expr secondInit |
            arg.(ArrayCreation).getInitializer().getAnInit().get(1) = secondInit and
            secondInit.isLiteral() and
            (secondInit.(Literal).getValue() = "-c" or secondInit.(Literal).getValue() = "/c") and
            exists(Expr thirdInit |
              arg.(ArrayCreation).getInitializer().getAnInit().get(2) = thirdInit and
              not thirdInit.isLiteral() and
              source.asExpr() = thirdInit
            )
          )
        )
      )
    )
  }
}

