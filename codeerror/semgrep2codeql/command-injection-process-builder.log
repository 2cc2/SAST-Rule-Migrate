import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.Arrays

class DangerousProcessBuilder extends TaintTracking::Configuration {
  DangerousProcessBuilder() { this = "Command Injection in ProcessBuilder" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      (
        // Case 1: new ProcessBuilder with variable arguments
        call.getCallee().(Constructor).getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        source.asExpr() = call.getArgument(0) and
        not call.getArgument(0).isLiteral()
      )
      or
      (
        // Case 2: command() method call with variable arguments
        call.getCallee().getName() = "command" and
        call.getCallee().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        source.asExpr() = call.getArgument(0) and
