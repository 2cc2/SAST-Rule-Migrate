/**
 * @name Command Injection in ProcessBuilder
 * @description Detects dangerous ProcessBuilder usage that could lead to command injection
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 *       owasp-a01:2017
 *       owasp-a03:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking

class DangerousProcessBuilder extends TaintTracking::TaintTrackingConfiguration {
  DangerousProcessBuilder() { this = "Command Injection in ProcessBuilder" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      (
        // Case 1: new ProcessBuilder with variable arguments
        call.getCallee() instanceof Constructor and
        call.getCallee().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        source.asExpr() = call.getArgument(0) and
        not call.getArgument(0) instanceof Literal
      )
      or
      (
        // Case 2: command() method call with variable arguments
        call.getCallee().getName() = "command" and
        call.getCallee().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        source.asExpr() = call.getArgument(0) and
        not call.getArgument(0) instanceof Literal
      )
    )
    or
    exists(Call call, string shell |
      // Case 3: Shell invocation patterns
      shell = ["sh", "bash", "ksh", "csh", "tcsh", "zsh", "cmd"] and
      (
        (call.getCallee() instanceof Constructor and
         call.getCallee().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")) or
        (call.getCallee().getName() = "command" and
         call.getCallee().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder"))
      ) and
      (
        // Shell with -c or cmd with /c
        exists(Expr arg |
          call.getArgument(0) = arg and
          (
            arg instanceof Literal and arg.(Literal).getValue() = shell and
            exists(Expr secondArg |
              call.getArgument(1) = secondArg and
              secondArg instanceof Literal and 
              (secondArg.(Literal).getValue() = "-c" or secondArg.(Literal).getValue() = "/c") and
              exists(Expr thirdArg |
                call.getArgument(2) = thirdArg and
                not thirdArg instanceof Literal and
                source.asExpr() = thirdArg
              )
            )
          )
          or
          // Array versions
          arg.(ArrayCreation).getInitializer().getAnInit().get(0) instanceof Literal and
          arg.(ArrayCreation).getInitializer().getAnInit().get(0).(Literal).getValue() = shell and
          exists(Expr secondInit |
            arg.(ArrayCreation).getInitializer().getAnInit().get(1) = secondInit and
            secondInit instanceof Literal and
            (secondInit.(Literal).getValue() = "-c" or secondInit.(Literal).getValue() = "/c") and
            exists(Expr thirdInit |
              arg.(ArrayCreation).getInitializer().getAnInit().get(2) = thirdInit and
              not thirdInit instanceof Literal and
              source.asExpr() = thirdInit
            )
          )
        )
      )
    )
  }
}

