Rule Content:
/**
 * @name Command Injection in ProcessBuilder
 * @description Detects potentially unsafe command execution via ProcessBuilder where arguments
 *              might be influenced by user input without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class ProcessBuilderConstruction extends DataFlow::Node {
  ProcessBuilderConstruction() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      (
        // Detect ProcessBuilder with variable arguments
        not cc.getArgument(0).(StringLiteral).getLiteral().regexpMatch(".*") or
        not cc.getArgument(0).(ArrayCreation).getInitializer().forall(Expr e | e.(StringLiteral).getLiteral().regexpMatch(".*")) or
        not cc.getArgument(0).(MethodAccess).getName() = "asList" and
          cc.getArgument(0).(MethodAccess).getArgument().forall(Expr e | e.(StringLiteral).getLiteral().regexpMatch(".*"))
      ) and
      this.asExpr() = cc
    )
  }
}

class ProcessBuilderCommandCall extends DataFlow::Node {
  ProcessBuilderCommandCall() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "command" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      (
        // Detect unsafe command() calls with variable arguments
        not ma.getArgument(0).(StringLiteral).getLiteral().regexpMatch(".*") or
        not ma.getArgument(0).(ArrayCreation).getInitializer().forall(Expr e | e.(StringLiteral).getLiteral().regexpMatch(".*")) or
        not ma.getArgument(0).(MethodAccess).getName() = "asList" and
          ma.getArgument(0).(MethodAccess).getArgument().forall(Expr e | e.(StringLiteral).getLiteral().regexpMatch(".*"))
      ) and
      this.asExpr() = ma
    )
  }
}

class ShellCommandPattern extends DataFlow::Node {
  ShellCommandPattern() {
    exists(MethodAccess ma, ConstructorCall cc |
      // Detect shell command patterns
      (
        // From constructor
        cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
        (
          (cc.getArgument(0).(StringLiteral).getLiteral() = "sh" or
             cc.getArgument(0).(StringLiteral).getLiteral() = "bash" or
             cc.getArgument(0).(StringLiteral).getLiteral() = "ksh" or
             cc.getArgument(0).(StringLiteral).getLiteral() = "csh" or
             cc.getArgument(0).(StringLiteral).getLiteral() = "tcsh" or
             cc.getArgument(0).(StringLiteral).getLiteral() = "zsh") and
           cc.getArgument(1).(StringLiteral).getLiteral() = "-c" and
           not cc.getArgument(2).(StringLiteral).getLiteral().regexpMatch(".*")
          ) or
          cc.getArgument(0).(Literal).getValue() = "cmd" and
          cc.getArgument(1).(Literal).getValue() = "/c" and
          not cc.getArgument(2).(Literal).getValue().regexpMatch(".*")
        ) and
        this.asExpr() = cc
      ) or
      (
        // From command() calls
        ma.getMethod().getName() = "command" and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        (
          (ma.getArgument(0).(StringLiteral).getLiteral() = "sh" or
             ma.getArgument(0).(StringLiteral).getLiteral() = "bash" or
             ma.getArgument(0).(StringLiteral).getLiteral() = "ksh" or
             ma.getArgument(0).(StringLiteral).getLiteral() = "csh" or
             ma.getArgument(0).(StringLiteral).getLiteral() = "tcsh" or
             ma.getArgument(0).(StringLiteral).getLiteral() = "zsh") and
           ma.getArgument(1).(StringLiteral).getLiteral() = "-c" and
           not ma.getArgument(2).(StringLiteral).getLiteral().regexpMatch(".*")
          ) or
          (ma.getArgument(0).(Literal).getValue() = "cmd" and
           ma.getArgument(1).(Literal).getValue() = "/c" and
           not ma.getArgument(2).(Literal).getValue().regexpMatch(".*"))
        ) and
        this.asExpr() = ma
      )
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("getParameter%") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      this.asExpr() = ma
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof UserInputSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof ProcessBuilderConstruction or
    sink instanceof ProcessBuilderCommandCall or
    sink instanceof ShellCommandPattern
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from CommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential command injection vulnerability in ProcessBuilder. User input flows into command execution without proper sanitization."
