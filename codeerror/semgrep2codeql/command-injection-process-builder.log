 * @name Command Injection via ProcessBuilder
 * @description Detects dangerous ProcessBuilder usage that could lead to command injection
 * @id command-injection-process-builder
 * @kind problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision medium
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 *       owasp-a01
 *       owasp-a03
 */
import java

// Case 1: ProcessBuilder construction with potentially unsafe arguments
from ConstructorCall pb, Expr cmd
where 
  pb.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
  (
    cmd = pb.getArgument(0) or
    (pb.getNumArgument() > 0 and cmd = pb.getArgument(0))
  ) and
  not cmd.isCompileTimeConstant() and
  not exists(
    LocalVariableDecl lv |
    lv.getAnAssignedValue() = cmd and
    (
      exists(lv.getAnAssignedValue().(Literal).getStringValue()) or
      exists(lv.getAnAssignedValue().(ArrayInit).getAnInit()) or
      exists(lv.getAnAssignedValue().(MethodAccess).getAnArgument())
    )
  ) and
  (
    not exists(cmd.(ArrayInit).getAnInit()) or
    not exists(cmd.(MethodAccess).getCallName()) or
    not cmd.(MethodAccess).getCallName().matches("asList") or
    not cmd.(MethodAccess).getAnArgument().isCompileTimeConstant()
  )
select pb, "Potential command injection in ProcessBuilder construction - $@ might contain user input", 
  cmd, "variable"

// Case 2: ProcessBuilder.command() calls with potentially unsafe arguments
from MethodAccess ma, Expr cmd, VariableAccess pbVar, ConstructorCall pbConstr
where
  ma.getMethod().hasName("command") and
  ma.getQualifier() = pbVar and
  pbVar.getVariable().getInitializer() = pbConstr and
  pbConstr.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
  (
    cmd = ma.getArgument(0) or
    (ma.getNumArgument() > 0 and cmd = ma.getArgument(0))
  ) and
  not cmd.isCompileTimeConstant() and
  not exists(
    LocalVariableDecl lv |
    lv.getAnAssignedValue() = cmd and
    (
      exists(lv.getAnAssignedValue().(Literal).getStringValue()) or
      exists(lv.getAnAssignedValue().(ArrayInit).getAnInit()) or
      exists(lv.getAnAssignedValue().(MethodAccess).getAnArgument())
    )
  ) and
  (
    not exists(cmd.(ArrayInit).getAnInit()) or
    not exists(cmd.(MethodAccess).getCallName()) or
    not cmd.(MethodAccess).getCallName().matches("asList") or
    not cmd.(MethodAccess).getAnArgument().isCompileTimeConstant()
  )
select ma, "Potential command injection in ProcessBuilder.command() call - $@ might contain user input",
  cmd, "parameter"

// Case 3: Shell command patterns
from MethodAccess ma, Expr arg, VariableAccess pbVar, ConstructorCall pbConstr
where
  (
    (
      ma.getMethod().hasName("command") and
      ma.getQualifier() = pbVar and
      pbVar.getVariable().getInitializer() = pbConstr and
      pbConstr.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder")
    ) or
    ma.getEnclosingCallable().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
  ) and
  (
    (
      exists(ma.getAnArgument().(Literal).getStringValue() as shellCmd |
        shellCmd.regexpMatch("(sh|bash|ksh|csh|tcsh|zsh|cmd)")
      ) and
      (
        ma.getAnArgument().(Literal).getStringValue() = "-c" or
        ma.getAnArgument().(Literal).getStringValue() = "/c"
      ) and
      ma.getAnArgument() = arg
    ) or
    (
      exists(ma.getAnArgument().(ArrayInit).getAnInit().(Literal).getStringValue() as shellCmd |
        shellCmd.regexpMatch("(sh|bash|ksh|csh|tcsh|zsh|cmd)")
      ) and
      exists(ma.getAnArgument().(ArrayInit).getAnInit().(Literal).getStringValue() as flag |
        flag = "-c" or flag = "/c"
      ) and
      ma.getAnArgument().(ArrayInit).getAnInit() = arg
    )
  ) and
  not arg.isCompileTimeConstant()
select ma, "Potential shell command injection - $@ might contain user input", 
  arg, "argument"
