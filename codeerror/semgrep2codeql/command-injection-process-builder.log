import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class ProcessBuilderConstruction extends DataFlow::Node {
  ProcessBuilderConstruction() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      (
        not exists(cc.getArgument(0).(StringLiteral)) or
        exists(ArrayCreationExpr ae | ae = cc.getArgument(0) |
          not ae.getInitializer().forall(Expr e | exists(e.(StringLiteral)))
        ) or
        exists(MethodAccess ma | ma = cc.getArgument(0) |
          ma.getName() = "asList" and
          not ma.getArgument().forall(Expr e | exists(e.(StringLiteral)))
        )
      ) and
      this.asExpr() = cc
    )
  }
}

class ProcessBuilderCommandCall extends DataFlow::Node {
  ProcessBuilderCommandCall() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "command" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      (
        not exists(ma.getArgument(0).(StringLiteral)) or
        exists(ArrayCreationExpr ae | ae = ma.getArgument(0) |
          not ae.getInitializer().forall(Expr e | exists(e.(StringLiteral)))
        ) or
        exists(MethodAccess ma2 | ma2 = ma.getArgument(0) |
          ma2.getName() = "asList" and
          not ma2.getArgument().forall(Expr e | exists(e.(StringLiteral)))
        )
      ) and
      this.asExpr() = ma
    )
  }
}

