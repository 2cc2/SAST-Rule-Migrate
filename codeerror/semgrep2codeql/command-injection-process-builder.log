/**
 * @name Potential Command Injection in ProcessBuilder
 * @description Detects potentially unsafe ProcessBuilder usage where command arguments may be influenced by user input.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-78
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class ProcessBuilderConstruction extends DataFlow::Node {
  ProcessBuilderConstruction() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.asExpr() = cc
    )
  }
}

class ProcessBuilderCommandMethod extends DataFlow::Node {
  ProcessBuilderCommandMethod() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "command" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.asExpr() = ma
    )
  }
}

class ShellCommandPattern extends DataFlow::Node {
  ShellCommandPattern() {
    exists(ArrayInitializer ai, Literal lit |
      ai.getAnArgument() = lit and
      lit.getStringValue().regexpMatch(".*(/bin/(sh|bash|ksh|csh|tcsh|zsh)|cmd).*")
    ) or
    exists(Literal lit | // Handle direct string literals
      lit.getStringValue().regexpMatch(".*(/bin/(sh|bash|ksh|csh|tcsh|zsh)|cmd).*")
    )
  }
}

class DangerousArgument extends DataFlow::Node {
  DangerousArgument() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName() = "command" or
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
      ) and
      this.asExpr() = ma.getAnArgument() and
      not isLiteralArgument(ma.getAnArgument())
    )
  }
  
  predicate isLiteralArgument(Expr arg) {
    exists(Literal _ | arg = _) or
    exists(ArrayInitializer ai | arg = ai and ai.getAnArgument() instanceof Literal) or
    exists(MethodAccess ma | 
      ma.getMethod().getName() = "asList" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.util", "Arrays") and
      arg = ma and
      ma.getAnArgument() instanceof Literal
    )
  }
}

class ProcessBuilderConfig extends TaintTracking::Configuration {
  ProcessBuilderConfig() { this = "ProcessBuilderConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof DangerousArgument or
    source instanceof ShellCommandPattern
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ProcessBuilderConstruction or
    sink instanceof ProcessBuilderCommandMethod
  }
}

from ProcessBuilderConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Potential command injection vulnerability in ProcessBuilder. User-controlled input flows into command execution."
