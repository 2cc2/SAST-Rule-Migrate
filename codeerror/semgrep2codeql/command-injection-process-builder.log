Rule Content:
/**
 * @name Command Injection in ProcessBuilder
 * @description Detects dangerous ProcessBuilder usage that could lead to command injection
 * @kind problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 *       owasp-a01:2017
 *       owasp-a03:2021
 */

import java
import DataFlow

class DangerousProcessBuilder extends DataFlow::Node {
  DangerousProcessBuilder() {
    exists(MethodAccess ma |
      (
        // Case 1: new ProcessBuilder with variable arguments
        ma.getMethod().hasName("ProcessBuilder") and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        this.asExpr() = ma.getArgument(0) and
        not ma.getArgument(0).isCompileTimeConstant()
      )
      or
      (
        // Case 2: command() method call with variable arguments
        ma.getMethod().hasName("command") and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
        this.asExpr() = ma.getArgument(0) and
        not ma.getArgument(0).isCompileTimeConstant()
      )
    )
    or
    exists(MethodAccess ma, string shell |
      // Case 3: Shell invocation patterns
      shell = ["sh", "bash", "ksh", "csh", "tcsh", "zsh", "cmd"] and
      (
        ma.getMethod().hasName("ProcessBuilder") or
        (ma.getMethod().hasName("command") and
         ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder"))
      ) and
      (
        // Shell with -c or cmd with /c
        exists(Expr arg |
          ma.getArgument(0) = arg and
          (
            arg.(Literal).getValue() = shell and
            exists(Expr secondArg |
              ma.getArgument(1) = secondArg and
              (secondArg.(Literal).getValue() = "-c" or secondArg.(Literal).getValue() = "/c") and
              exists(Expr thirdArg |
                ma.getArgument(2) = thirdArg and
                not thirdArg.isCompileTimeConstant() and
                this.asExpr() = thirdArg
              )
            )
          )
          or
          // Array or list versions
          arg.(ArrayInitializer).getAnInit().get(0).(Literal).getValue() = shell and
          exists(Expr secondInit |
            arg.(ArrayInitializer).getAnInit().get(1) = secondInit and
            (secondInit.(Literal).getValue() = "-c" or secondInit.(Literal).getValue() = "/c") and
            exists(Expr thirdInit |
              arg.(ArrayInitializer).getAnInit().get(2) = thirdInit and
              not thirdInit.isCompileTimeConstant() and
              this.asExpr() = thirdInit
            )
          )
        )
      )
    )
  }
}

