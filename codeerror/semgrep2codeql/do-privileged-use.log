/**
 * @name do-privileged-use
 * @description Marking code as privileged enables a piece of trusted code to temporarily
 * enable access to more resources than are available directly to the code
 * that called it. Be very careful in your use of the privileged construct,
 * and always remember to make the privileged code section as small as possible.
 * @kind problem
 * @problem.severity warning
 * @security-severity 5.0
 * @precision low
 * @id java/do-privileged-use
 * @tags security
 *       external/cwe/cwe-269
 *       owasp-a04
 */
import java

// Detect AccessController.doPrivileged() calls
from MethodAccess ma
where ma.getMethod().getName() = "doPrivileged"
  and ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "AccessController")
select ma, "Use of AccessController.doPrivileged() can lead to privilege escalation."

// Detect classes implementing PrivilegedAction
from Class c
where c.getASupertype().hasQualifiedName("java.security", "PrivilegedAction")
select c, "Class implementing PrivilegedAction can lead to privilege escalation."
