 * @tags security
 *       external/cwe/cwe-269
 *       owasp-a04
 */
import java

from 
  Call doPrivilegedCall,
  Class privActionClass
where
  // Matches AccessController.doPrivileged(...) calls
  (
    doPrivilegedCall.getCallee().hasName("doPrivileged") and
    doPrivilegedCall.getCallee().getDeclaringType().hasQualifiedName("java.security", "AccessController")
  )
  or
  // Matches classes implementing PrivilegedAction<Void>
  (
    exists(privActionClass.getASupertype() as superType |
      superType.hasQualifiedName("java.security", "PrivilegedAction") and
      exists(superType.(GenericType).getATypeBound() as typeBound |
        typeBound.hasQualifiedName("java.lang", "Void")
      )
    )
  )
select doPrivilegedCall,
  case
    when doPrivilegedCall.getCallee().hasName("doPrivileged") 
      then "Use of AccessController.doPrivileged() can lead to privilege escalation"
    else "Implementation of PrivilegedAction<Void> can lead to privilege escalation"
  end
