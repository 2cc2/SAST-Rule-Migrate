Rule Content:
/**
 * @name do-privileged-use
 * @description Marking code as privileged enables a piece of trusted code to temporarily
 * enable access to more resources than are available directly to the code
 * that called it. Be very careful in your use of the privileged construct,
 * and always remember to make the privileged code section as small as possible.
 * @kind problem
 * @problem.severity warning
 * @id java/do-privileged-use
 * @tags security
 *   - cwe-269
 *   - owasp-a04
 */
import java

from Or<MethodAccess, Class> privilegedUse
where
  // Case 1: Direct AccessController.doPrivileged call
  (
    privilegedUse instanceof MethodAccess and
    privilegedUse.(MethodAccess).getMethod().getName() = "doPrivileged" and
    privilegedUse.(MethodAccess).getMethod().getDeclaringType().hasQualifiedName("java.security", "AccessController")
  )
  or
  // Case 2: PrivilegedAction implementation
  (
    privilegedUse instanceof Class and
    privilegedUse.(Class).getASupertype() instanceof TypeClass and
    privilegedUse.(Class).getASupertype().hasQualifiedName("java.security", "PrivilegedAction")
  )
select privilegedUse,
  case
    when privilegedUse instanceof MethodAccess then "Use of AccessController.doPrivileged(), be cautious with privilege escalation."
    else "Detected implementation of PrivilegedAction, be cautious with privilege escalation."
  end,
  "Privilege escalation risk found"
