  then mc else c end,
  if exists(mc.getMethod())
  then "Use of AccessController.doPrivileged(), be cautious with privilege escalation."
  else "Detected implementation of PrivilegedAction, be cautious with privilege escalation." end,
  "Privilege escalation risk found"
