Rule Content:
/**
 * @name Insecure Trust Manager
 * @description Detected empty trust manager implementations. This is dangerous because it accepts any
 *              certificate, enabling man-in-the-middle attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03
 *       external/owasp/a07
 */

import java

class X509TrustManager extends RefType {
  X509TrustManager() {
    this.hasQualifiedName("javax.net.ssl", "X509TrustManager") or
    this.hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager")
  }
}

class EmptyTrustManager extends Interface {
  EmptyTrustManager() {
    this.getDeclaringType() instanceof X509TrustManager and
    (
      this.hasName("checkClientTrusted") or
      this.hasName("checkServerTrusted") or
      this.hasName("getAcceptedIssuers")
    ) and
    exists(MethodAccess ma |
      ma.getMethod() = this and
      ma.getMethod().getBody().getAChildStmt*().empty()
    )
  }
}

class NullIssuersMethod extends Interface {
  NullIssuersMethod() {
    this.getDeclaringType() instanceof X509TrustManager and
    this.hasName("getAcceptedIssuers") and
    exists(MethodAccess ma |
      ma.getMethod() = this and
      ma.getMethod().getBody().getAChildStmt*() instanceof ReturnStmt and
      ma.getMethod().getBody().getAChildStmt*().getExpr().toString() = "null"
    )
  }
}

from EmptyTrustManager etm, NullIssuersMethod nim
select etm, "Empty trust manager implementation. This accepts any certificate, enabling man-in-the-middle attacks."
union
select nim, "getAcceptedIssuers() returns null. This accepts any certificate, enabling man-in-the-middle attacks."
