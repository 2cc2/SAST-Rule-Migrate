/**
 * @name Insecure Trust Manager
 * @description Detected empty trust manager implementations. This is dangerous because it accepts any
 *              certificate, enabling man-in-the-middle attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03
 *       external/owasp/a07
 */

import java

class X509TrustManager extends RefType {
  X509TrustManager() {
    this.hasQualifiedName("javax.net.ssl", "X509TrustManager") or
    this.hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager")
  }
}

class EmptyTrustManager extends Method {
  EmptyTrustManager() {
    this.getDeclaringType() instanceof X509TrustManager and
    (
      this.hasName("checkClientTrusted") or
      this.hasName("checkServerTrusted") or
      this.hasName("getAcceptedIssuers")
    ) and
    this.getBody().getNumStmt() = 0
  }
}

class NullIssuersMethod extends Method {
  NullIssuersMethod() {
    this.getDeclaringType() instanceof X509TrustManager and
    this.hasName("getAcceptedIssuers") and
    exists(ReturnStmt rs |
      rs.getParent() = this.getBody() and
      rs.getResult().toString() = "null"
    )
  }
}

from Method m
where 
  m instanceof EmptyTrustManager or
  m instanceof NullIssuersMethod
select m, 
  if m instanceof EmptyTrustManager
    then "Empty trust manager implementation. This accepts any certificate, enabling man-in-the-middle attacks."
    else "getAcceptedIssuers() returns null. This accepts any certificate, enabling man-in-the-middle attacks."
