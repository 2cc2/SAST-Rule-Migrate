/**
 * @name Insecure Trust Manager
 * @description Detected empty trust manager implementations. This is dangerous because it accepts
 * any certificate, enabling man-in-the-middle attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 *       owasp/a03:2017
 *       owasp/a07:2021
 */

import java

from Class c, Method m1, Method m2, Method m3
where 
  // Check for classes implementing trust managers
  (c instanceof X509TrustManager or c instanceof X509ExtendedTrustManager) and
  
  // Check for missing security checks
  ((m1.hasName("checkClientTrusted") and m1.getNumberOfStmt() = 0 and m1.getDeclaringType() = c) or
   (m2.hasName("checkServerTrusted") and m2.getNumberOfStmt() = 0 and m2.getDeclaringType() = c) or
   (m3.hasName("getAcceptedIssuers") and m3.getDeclaringType() = c and exists(ReturnStmt r | r.getExpr() instanceof NullLiteral)))
select c, "Insecure trust manager implementation that accepts any certificate, making it vulnerable to MITM attacks."
