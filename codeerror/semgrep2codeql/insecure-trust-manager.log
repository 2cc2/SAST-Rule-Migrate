Rule Content:
/**
 * @name Insecure Trust Manager
 * @description Detected empty trust manager implementations. This is dangerous because it accepts any
 * certificate, enabling man-in-the-middle attacks. Consider using a KeyStore
 * and TrustManagerFactory instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03
 *       external/owasp/a07
 */
import java

class InsecureTrustManager extends RefType {
  InsecureTrustManager() {
    this.getQualifiedName() = "javax.net.ssl.X509TrustManager" or
    this.getQualifiedName() = "javax.net.ssl.X509ExtendedTrustManager"
  }
}

predicate isEmptyMethodBody(Method m) {
  m.getBody().getNumStmt() = 0
}

predicate returnsNull(Method m) {
  exists(ReturnStmt rs | rs.getResult() instanceof NullLiteral |
    rs.getEnclosingCallable() = m)
}

class TrustManagerFinding {
  Element element;
  string message;
  
  TrustManagerFinding() {
    exists(Class cls, Method m |
      cls.getASupertype() instanceof InsecureTrustManager and
      m.getDeclaringType() = cls and
      (
        (m.hasName("checkClientTrusted") and isEmptyMethodBody(m)) or
        (m.hasName("checkServerTrusted") and isEmptyMethodBody(m)) or
        (m.hasName("getAcceptedIssuers") and returnsNull(m))
      ) and
      this.element = m and
      this.message = "Insecure trust manager implementation found in class " + cls.getName()
    )
    or
    exists(ClassInstanceExpr cie, Method m |
      cie.getConstructedType().getASupertype() instanceof InsecureTrustManager and
      m.getDeclaringType() = cie.getConstructedType() and
      (
        (m.hasName("checkClientTrusted") and isEmptyMethodBody(m)) or
        (m.hasName("checkServerTrusted") and isEmptyMethodBody(m)) or
        (m.hasName("getAcceptedIssuers") and returnsNull(m))
      ) and
      this.element = cie and
      this.message = "Insecure trust manager implementation found in anonymous class"
    )
  }
}

from TrustManagerFinding finding
select finding.element, finding.message
