Rule Content:
/**
 * @name Insecure Trust Manager
 * @description Detected empty trust manager implementations. This is dangerous because it accepts any
 *              certificate, enabling man-in-the-middle attacks. Consider using a KeyStore
 *              and TrustManagerFactory instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03
 *       external/owasp/a07
 *       external/asvs/v9.2.1
 */

import java

class X509TrustManager extends RefType {
  X509TrustManager() {
    this.hasQualifiedName("javax.net.ssl", "X509TrustManager") or
    this.hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager")
  }
}

class EmptyTrustManager extends Class {
  EmptyTrustManager() {
    this.implements(X509TrustManager) and
    (
      exists(Method m | 
        m.getDeclaringType() = this and
        (
          (m.getName() = "checkClientTrusted" and m.getNumberOfParameters() > 0 and m.getBody().getNumStmt() = 0) or
          (m.getName() = "checkServerTrusted" and m.getNumberOfParameters() > 0 and m.getBody().getNumStmt() = 0) or
          (m.getName() = "getAcceptedIssuers" and m.getBody().toString() = "return null;")
        )
      )
    )
  }
}

class AnonymousEmptyTrustManager extends ClassInstanceExpr {
  AnonymousEmptyTrustManager() {
    exists(Class c | 
      c.implements(X509TrustManager) and
      this.getAnonymousClass() = c and
      (
        exists(Method m | 
          m.getDeclaringType() = c and
          (
            (m.getName() = "checkClientTrusted" and m.getNumberOfParameters() > 0 and m.getBody().getNumStmt() = 0) or
            (m.getName() = "checkServerTrusted" and m.getNumberOfParameters() > 0 and m.getBody().getNumStmt() = 0) or
            (m.getName() = "getAcceptedIssuers" and m.getBody().toString() = "return null;")
          )
        )
      )
    )
  }
}

from EmptyTrustManager c
select c, "Detected empty trust manager implementation. This is dangerous because it accepts any certificate, enabling man-in-the-middle attacks."

from AnonymousEmptyTrustManager a
select a, "Detected empty anonymous trust manager implementation. This is dangerous because it accepts any certificate, enabling man-in-the-middle attacks."
