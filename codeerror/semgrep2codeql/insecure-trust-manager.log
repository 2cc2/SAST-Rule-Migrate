/**
 * @name Insecure Trust Manager
 * @description Detected empty trust manager implementations. This is dangerous because it accepts any
 * certificate, enabling man-in-the-middle attacks. Consider using a KeyStore
 * and TrustManagerFactory instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03
 *       external/owasp/a07
 */
import java
import javax.net.ssl.X509TrustManager
import javax.net.ssl.X509ExtendedTrustManager

predicate isTrustManager(RefType t) {
  t.getASupertype() instanceof X509TrustManager or
  t.getASupertype() instanceof X509ExtendedTrustManager
}

predicate isEmptyMethodBody(Method m) {
  m.getBody().getNumStmt() = 0
}

predicate returnsNull(Method m) {
  exists(ReturnStmt rs | rs.getResult() instanceof NullLiteral | 
    m.getADeclarationEntry() = rs.getEnclosingCallable())
}

from Class cls, Method m
where 
  isTrustManager(cls) and
  (
    (m.hasName("checkClientTrusted") and isEmptyMethodBody(m)) or
    (m.hasName("checkServerTrusted") and isEmptyMethodBody(m)) or
    (m.hasName("getAcceptedIssuers") and returnsNull(m))
  )
select cls, "Insecure trust manager implementation found in class " + cls.getName()

from ClassInstanceExpr cie, Method m
where 
  isTrustManager(cie.getConstructedType()) and
  (
    (m.hasName("checkClientTrusted") and isEmptyMethodBody(m)) or
    (m.hasName("checkServerTrusted") and isEmptyMethodBody(m)) or
    (m.hasName("getAcceptedIssuers") and returnsNull(m))
  )
select cie, "Insecure trust manager implementation found in anonymous class"
