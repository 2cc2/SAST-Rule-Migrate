Rule Content:
/**
 * @name Insecure Trust Manager
 * @description Detected empty trust manager implementations. This is dangerous because it accepts any
 * certificate, enabling man-in-the-middle attacks. Consider using a KeyStore
 * and TrustManagerFactory instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03
 *       external/owasp/a07
 */
import java

// Finds classes implementing X509TrustManager or X509ExtendedTrustManager
from Class cls
where 
  cls.implements("javax.net.ssl.X509TrustManager") or 
  cls.implements("javax.net.ssl.X509ExtendedTrustManager")
select cls, "Class implements trust manager interface"

// Finds anonymous classes implementing trust managers
from ClassInstanceExpr cie
where 
  cie.getClass().implements("javax.net.ssl.X509TrustManager") or
  cie.getClass().implements("javax.net.ssl.X509ExtendedTrustManager")
select cie, "Anonymous trust manager implementation"

// Finds empty or insecure implementations of checkClientTrusted
from MethodAccess ma
where 
  ma.getMethod().hasName("checkClientTrusted") and
  ma.getMethod().getBody().getNumStmt() = 0
select ma, "Empty checkClientTrusted implementation lacks proper certificate validation"

// Finds empty or insecure implementations of checkServerTrusted
from MethodAccess ma
where 
  ma.getMethod().hasName("checkServerTrusted") and
  ma.getMethod().getBody().getNumStmt() = 0
select ma, "Empty checkServerTrusted implementation lacks proper certificate validation"

// Finds insecure getAcceptedIssuers implementation
from MethodAccess ma
where 
  ma.getMethod().hasName("getAcceptedIssuers") and
  exists(ReturnStmt rs | rs.getExpr() instanceof NullLiteral)
select ma, "Insecure getAcceptedIssuers implementation returning null"
