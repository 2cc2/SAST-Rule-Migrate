/**
 * @name find-sql-string-concatenation
 * @description In $METHOD, $X is used to construct a SQL query via string concatenation.
 * @id security/java/find-sql-string-concatenation
 * @kind path-problem
 * @problem.severity error
 * @precision medium
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-564
 *       external/owasp/a01
 *       external/owasp/a03
 *       jboss
 */

import java
import semmle.code.java.dataflow.FlowSources
import DataFlow::PathGraph

class StringConcatenationConfiguration extends DataFlow::Configuration {
  StringConcatenationConfiguration() { this = "StringConcatenationConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodParameter mp | source.asParameter() = mp and mp.getType().hasName("String"))
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma | ma.getMethod().getName() = "prepareStatement" and sink.asExpr() = ma.getArgument(0))
  }

  override predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(BinaryAddExpr add |
      (add.getLeftOperand() = node1.asExpr() and node2.asExpr() = add) or
      (add.getRightOperand() = node1.asExpr() and node2.asExpr() = add)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, Method m
where
  exists(StringConcatenationConfiguration sc | sc.hasFlowPath(source, sink)) and
  sink.getNode().asExpr().getEnclosingCallable() = m
select sink.getNode(), source, sink, "In $@, $@ is used to construct a SQL query via string concatenation.",
  m, "method", source.getNode(), "parameter"
