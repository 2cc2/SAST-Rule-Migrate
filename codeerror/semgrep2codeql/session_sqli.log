/**
 * @name SQL query constructed with string concatenation
 * @description Constructing SQL queries with string concatenation is vulnerable to SQL injection.
 * @kind problem
 * @problem.severity error
 * @security-severity 9.8
 * @precision medium
 * @id java/sql-string-concatenation
 * @tags security
 *       external/cwe/cwe-089
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.security.SQLInjectionFlow

predicate isSession(Expr expr) {
  exists(RefType type | type.hasQualifiedName("org.hibernate", "Session") and expr.getType().getASupertype*() = type)
}

predicate usedInSQLQueryConstruction(Expr concatExpr, Expr param) {
  exists(AddExpr add | add = concatExpr |
    add.getAnOperand() = param.asExpr() 
    or 
    exists(AddExpr innerAdd | usedInSQLQueryConstruction(innerAdd, param) and add.getAnOperand() = innerAdd)
  )
}

from Method method, Parameter param, Expr concatExpr, MethodAccess prepareStmt, MethodAccess executeQuery
where
  param.getType() instanceof TypeString and
  usedInSQLQueryConstruction(concatExpr, param.getAnAccess()) and
  exists(MethodAccess sessionConn | 
    sessionConn.getMethod().getName() = "connection" and
    isSession(sessionConn.getQualifier()) and
    prepareStmt.getMethod().getName() = "prepareStatement" and
    prepareStmt.getQualifier() = sessionConn and
    prepareStmt.getArgument(0) = concatExpr and
    executeQuery.getMethod().getName() = "executeQuery" and
    exists(DataFlow::Node source, DataFlow::Node sink |
      source.asExpr() = prepareStmt and
      sink.asExpr() = executeQuery and
      exists(SQLInjectionFlow::FlowPath flow | flow.getSource() = source and flow.getSink() = sink)
    )
  )
select param, "In $@, this parameter is used to construct a SQL query via string concatenation.", method, method.getName()
