/**
 * @name Constructing SQL query with string concatenation
 * @description Using string concatenation to build SQL queries can lead to SQL injection vulnerabilities.
 * @kind problem
 * @problem.severity error
 * @security-severity 9.8
 * @precision medium
 * @id java/sql-string-concatenation
 * @tags security
 *       external/cwe/cwe-089
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.security.QueryInjection

/**
 * Strings that are known to be safe by simple local analysis.
 */
predicate safeString(Expr expr) {
  expr instanceof StringLiteral
  or
  expr instanceof NullLiteral
  or
  exists(Variable v | v.getAnAccess() = expr and exists(v.getAnAssignedValue()) |
    forall(Expr other | v.getAnAssignedValue() = other | safeString(other))
  )
}

predicate builtFromUnsafeConcat(Expr expr) {
  exists(AddExpr concat | concat = expr |
    builtFromUnsafeConcat(concat.getAnOperand())
  )
  or
  exists(AddExpr concat | concat = expr |
    exists(Expr arg | arg = concat.getAnOperand() | not safeString(arg))
  )
  or
  exists(Expr other | builtFromUnsafeConcat(other) |
    exists(Variable v | v.getAnAssignedValue() = other and v.getAnAccess() = expr)
  )
}

from Method method, Parameter param, StringLiteral query, Call call, Call prepareCall
where
  param.getType().hasName("String") and
  param.getMethod() = method and
  builtFromUnsafeConcat(query) and
  exists(DataFlow::Node source, DataFlow::Node sink |
    source.asParameter() = param and
    sink.asExpr() = query and
    DataFlow::localFlow(source, sink)
  ) and
  call.getMethod().getName() = "executeQuery" and
  prepareCall.getMethod().getName() = "prepareStatement" and
  prepareCall.getArgument(0) = query and
  call.getQualifier() = prepareCall
select query, "SQL query constructed with unsafe string concatenation of parameter $" + param.getName()
