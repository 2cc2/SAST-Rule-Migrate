 */

import java
import semmle.code.java.dataflow.FlowSources
import DataFlow
import TaintTracking

class StringConcatenationConfiguration extends TaintTracking::Configuration {
  StringConcatenationConfiguration() { this = "StringConcatenationConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p and p.getType().hasName("String"))
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Expr ma | ma.(MethodAccess).getMethod().getName() = "prepareStatement" and 
      sink.asExpr() = ma.getArgument(0))
  }

  override predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(AddExpr add |
      (add.getLeftOperand() = node1.asExpr() and node2.asExpr() = add) or
      (add.getRightOperand() = node1.asExpr() and node2.asExpr() = add)
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, Method m
where
  exists(StringConcatenationConfiguration sc | sc.hasFlow(source, sink)) and
  sink.asExpr().getEnclosingCallable() = m
select sink, source, "In $@, $@ is used to construct a SQL query via string concatenation.",
  m, "method", source, "parameter"
