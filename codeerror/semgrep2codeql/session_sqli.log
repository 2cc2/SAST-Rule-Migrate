Rule Content:
/**
 * @name SQL query construction via string concatenation
 * @description Constructing SQL queries via string concatenation can lead to SQL injection vulnerabilities.
 * @kind problem
 * @problem.severity error
 * @security-severity 9.8
 * @precision medium
 * @id java/sql-string-concatenation
 * @tags security
 *       external/cwe/cwe-089
 *       owasp-a01
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jdbc.Jdbc

/** Detects methods where string concatenation is used to construct SQL queries. */
predicate isSqlStringConcatenationMethod(Method method, Variable sqlParam, Expr queryExpr) {
  exists(MethodAccess prepareStmt |
    prepareStmt.getMethod().getName() = "prepareStatement" and
    prepareStmt.getQualifier() = JdbcSession::getConnection() and
    prepareStmt.getAnArgument() = queryExpr and
    queryExpr instanceof AddExpr and
    (
      exists(queryExpr.getAnOperand() |
        TaintTracking::localTaint(_, _, sqlParam.getAnAccess(), _) and
        sqlParam.getParent() = method.getAParameter()
      )
      or
      exists(Variable v |
        v.getAnAccess() = queryExpr.getAnOperand() and
        TaintTracking::localTaint(_, _, sqlParam.getAnAccess(), v.getAnAssignedValue())
      )
    ) and
    exists(MethodAccess executeQuery |
      executeQuery.getMethod().getName() = "executeQuery" and
      executeQuery.getQualifier().getType().getName() = "PreparedStatement"
    )
  )
}

from Method method, Variable sqlParam, Expr queryExpr
where
  isSqlStringConcatenationMethod(method, sqlParam, queryExpr)
select queryExpr, "In " + method.getName() + ", " + sqlParam.getName() + 
  " is used to construct a SQL query via string concatenation."
