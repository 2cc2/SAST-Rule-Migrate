 *       owasp-a05:2021
 */

import java
import semmle.code.java.dataflow.FlowSources

class XMLInputFactoryCreation extends MethodAccess {
  XMLInputFactoryCreation() {
    (this.getMethod().getName() = "newFactory" and
      this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")) or
    this.getConstructor().getDeclaringType().hasQualifiedName("", "XMLInputFactory")
  }
}

class SafeXMLInputFactoryUsage extends MethodAccess {
  SafeXMLInputFactoryUsage() {
    exists(Method m | 
      m.getName() = "setProperty" and
      m.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      (
        this.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" or
        this.getArgument(0).getType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
        this.getArgument(0).(FieldAccess).getName() = "IS_SUPPORTING_EXTERNAL_ENTITIES"
      ) and
      (
        this.getArgument(1).(BooleanLiteral).getValue() = false or
        this.getArgument(1).(FieldAccess).getName() = "FALSE" and
        this.getArgument(1).getType().hasQualifiedName("java.lang", "Boolean")
      )
    )
  }
}

