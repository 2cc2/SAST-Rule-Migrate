     this.(Call).getCallee().getName() = "newFactory" and
     this.(Call).getCallee().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")) or
    (this instanceof ConstructorCall and
     this.(ConstructorCall).getConstructor().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory"))
  }
}

class SafePropertySetting extends Expr {
  SafePropertySetting() {
    exists(Method setProperty, string propName, Expr falseValue |
      setProperty.getName() = "setProperty" and
      setProperty.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      (
        (propName = "javax.xml.stream.isSupportingExternalEntities" and
         (falseValue instanceof BooleanLiteral and falseValue.(BooleanLiteral).getValue() = false or
          falseValue instanceof FieldAccess and
          falseValue.(FieldAccess).getField().getDeclaringType().hasQualifiedName("java.lang", "Boolean") and
          falseValue.(FieldAccess).getField().getName() = "FALSE"))
        or
        (this instanceof Call and
         this.(Call).getArgument(0) instanceof FieldAccess and
         this.(Call).getArgument(0).(FieldAccess).getField().getName() = "IS_SUPPORTING_EXTERNAL_ENTITIES" and
         this.(Call).getArgument(0).(FieldAccess).getField().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
         (falseValue instanceof BooleanLiteral and falseValue.(BooleanLiteral).getValue() = false or
          falseValue instanceof FieldAccess and
          falseValue.(FieldAccess).getField().getDeclaringType().hasQualifiedName("java.lang", "Boolean") and
          falseValue.(FieldAccess).getField().getName() = "FALSE"))
      ) and
      this instanceof Call and
      this.(Call).getCallee() = setProperty and
      (
        (this.(Call).getArgument(0).toString() = propName) or
        (this.(Call).getArgument(0) instanceof FieldAccess and
