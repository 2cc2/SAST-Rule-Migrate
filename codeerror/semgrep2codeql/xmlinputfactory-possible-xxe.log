 *       external/owasp/a05
 *       external/cwe2022-top25
 *       external/cwe2021-top25
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isSafeXMLInputFactory(Expr e) {
  exists(Call setProp |
    setProp.getCallee().getName() = "setProperty" and
    exists(VariableAccess qualifierAccess, VariableAccess exprAccess |
      qualifierAccess = setProp.getQualifier() and
      exprAccess = e and
      qualifierAccess.getVariable() = exprAccess.getVariable() 
    ) and
    (
      (setProp.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" and
       setProp.getArgument(1).(BooleanLiteral).getBooleanValue() = false)
