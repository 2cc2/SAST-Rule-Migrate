Rule Content:
/**
 * @name XMLInputFactory Possible XXE
 * @description XML external entities are not explicitly disabled for this XMLInputFactory.
 *              This could be vulnerable to XML external entity vulnerabilities.
 * @id xmlinputfactory-possible-xxe
 * @kind problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision medium
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04
 *       external/owasp/a05
 *       external/cwe2022-top25
 *       external/cwe2021-top25
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isSafeXMLInputFactory(Expr e) {
  exists(MethodAccess setProp |
    setProp.getMethod().getName() = "setProperty" and
    setProp.getQualifier().(VariableAccess).getVariable() = e.(VariableAccess).getVariable() and
    (
      (setProp.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" and
       setProp.getArgument(1) instanceof BooleanLiteral and
       setProp.getArgument(1).(BooleanLiteral).getValue() = false)
      or
      (setProp.getArgument(0).(FieldAccess).getTarget().toString() = "XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES" and
       setProp.getArgument(1) instanceof BooleanLiteral and
       setProp.getArgument(1).(BooleanLiteral).getValue() = false)
      or
      (setProp.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" and
       setProp.getArgument(1).(FieldAccess).getTarget().toString() = "Boolean.FALSE")
      or
      (setProp.getArgument(0).(FieldAccess).getTarget().toString() = "XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES" and
       setProp.getArgument(1).(FieldAccess).getTarget().toString() = "Boolean.FALSE")
    )
  )
}

from Expr factoryCreation, Variable factory
where
  (
    factoryCreation instanceof ClassInstanceExpr and
    factoryCreation.(ClassInstanceExpr).getConstructedType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")
    or
    factoryCreation instanceof MethodAccess and
    factoryCreation.(MethodAccess).getMethod().hasQualifiedName("javax.xml.stream", "XMLInputFactory", "newFactory")
  ) and
  factoryCreation.(Expr).getEnclosingCallable() = factory.getEnclosingCallable() and
  not exists(ControlFlowNode node |
    dominates(factoryCreation, node) and
    isSafeXMLInputFactory(factory.(Variable).getAnAccess())
  )
select factoryCreation, "XML external entities are not explicitly disabled for this XMLInputFactory. " +
  "This could be vulnerable to XML external entity vulnerabilities. " +
  "Explicitly disable external entities by setting 'javax.xml.stream.isSupportingExternalEntities' to false."
