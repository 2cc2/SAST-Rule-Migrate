/**
 * @name XMLInputFactory Possible XXE
 * @description Detects XMLInputFactory instances where external entities are not explicitly disabled,
 *              which could lead to XXE vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision medium
 * @id java/xmlinputfactory-possible-xxe
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.XmlUtils

class XMLInputFactoryCreation extends MethodAccess {
  XMLInputFactoryCreation() {
    (this.getMethod().hasName("newFactory") and
     this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")) or
    (this.getMethod().isConstructor() and
     this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory"))
  }
}

class SafePropertySetting extends MethodAccess {
  SafePropertySetting() {
    this.getMethod().getName() = "setProperty" and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
    (
      (this.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" and
       this.getArgument(1).(BooleanLiteral).getValue() = false) or
      (this.getArgument(0).(FieldAccess).getTarget().getName() = "IS_SUPPORTING_EXTERNAL_ENTITIES" and
       this.getArgument(0).getType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
       this.getArgument(1).(BooleanLiteral).getValue() = false) or
      (this.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" and
       this.getArgument(1).(FieldAccess).getTarget().getName() = "FALSE" and
       this.getArgument(1).getType().hasQualifiedName("java.lang", "Boolean")) or
      (this.getArgument(0).(FieldAccess).getTarget().getName() = "IS_SUPPORTING_EXTERNAL_ENTITIES" and
       this.getArgument(0).getType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
       this.getArgument(1).(FieldAccess).getTarget().getName() = "FALSE" and
       this.getArgument(1).getType().hasQualifiedName("java.lang", "Boolean"))
    )
  }
}

from XMLInputFactoryCreation xmlCreation, MethodAccess propertySetCall, Method unsafeMethod
where
  DataFlow::localExprFlow(
    DataFlow::exprNode(xmlCreation),
    DataFlow::exprNode(propertySetCall.getQualifier())
  ) and
  not exists(SafePropertySetting s | DataFlow::localExprFlow(DataFlow::exprNode(s), DataFlow::exprNode(propertySetCall.getQualifier()))) and
  unsafeMethod.getBody().getAChildExpr*() = propertySetCall and
  unsafeMethod = propertySetCall.getEnclosingCallable()
select xmlCreation, "XML external entities are not explicitly disabled for this XMLInputFactory, which could lead to XXE vulnerabilities."
