/**
 * @name XMLInputFactory Possible XXE
 * @description Detects XMLInputFactory instances without explicit disabling of external entities
 * @kind problem
 * @problem.severity warning
 * @precision medium
 * @id java/xmlinputfactory-possible-xxe
 * @tags security
 *       external/cwe/cwe-611
 *       owasp-a04:2017
 *       owasp-a05:2021
 */

import java
import semmle.code.java.dataflow.FlowSources

class XMLInputFactoryCreation extends MethodCall, ConstructorCall {
  XMLInputFactoryCreation() {
    (this instanceof MethodCall and
      this.getMethod().getName() = "newFactory" and
      this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")) or
    (this instanceof ConstructorCall and
      this.getConstructedType().hasQualifiedName("", "XMLInputFactory"))
  }

  override predicate getConstructor() {
    this instanceof ConstructorCall and
    this.getConstructedType().hasQualifiedName("", "XMLInputFactory")
  }
}

class SafeXMLInputFactoryUsage extends MethodCall {
  SafeXMLInputFactoryUsage() {
    exists(Method m | 
      m.getName() = "setProperty" and
      m.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      (
        this.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" or
        this.getArgument(0).getType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
        this.getArgument(0).(FieldAccess).getField().getName() = "IS_SUPPORTING_EXTERNAL_ENTITIES"
      ) and
      (
        this.getArgument(1).(BooleanLiteral).getValue() = false or
        this.getArgument(1).(FieldAccess).getField().getName() = "FALSE" and
        this.getArgument(1).getType().hasQualifiedName("java.lang", "Boolean")
      )
    )
  }
}

from XMLInputFactoryCreation xmlCreation, MethodCall unsafeUsage
where
  not exists(SafeXMLInputFactoryUsage safe |
    safe.getEnclosingCallable() = unsafeUsage.getEnclosingCallable()
  ) and
  xmlCreation.getEnclosingCallable() = unsafeUsage.getEnclosingCallable()
select xmlCreation, "XML external entities are not explicitly disabled for this XMLInputFactory. " +
  "This could be vulnerable to XML external entity vulnerabilities. Explicitly disable external entities by setting " +
  "\"javax.xml.stream.isSupportingExternalEntities\" to false."
