/**
 * @name XMLInputFactory Possible XXE
 * @description XML external entities are not explicitly disabled for this XMLInputFactory.
 *              This could be vulnerable to XML external entity vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/xmlinputfactory-possible-xxe
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04
 *       external/owasp/a05
 */

import java
import semmle.code.java.dataflow.TaintTracking

class XMLInputFactoryCreation extends DataFlow::Node {
  XMLInputFactoryCreation() {
    exists(Call ma |
      (ma.getCallee().getName() = "newFactory" and
       ma.getCallee().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")) or
      (ma.getCallee().getName() = "<init>" and
       ma.getCallee().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")) and
      this.asExpr() = ma
    )
  }
}

class SafeXMLInputFactory extends DataFlow::Node {
  SafeXMLInputFactory() {
    exists(Call setProp |
      setProp.getCallee().getName() = "setProperty" and
      (setProp.getArgument(0).toString() = "\"javax.xml.stream.isSupportingExternalEntities\"" or
       setProp.getArgument(0).toString() = "javax.xml.stream.XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES") and
      (setProp.getArgument(1).toString() = "false" or
       setProp.getArgument(1).toString() = "Boolean.FALSE") and
      this.asExpr() = setProp.getImmediateCaller()
    )
  }
}

class XXEConfig extends TaintTracking::Configuration {
  XXEConfig() { this = "XXEConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof XMLInputFactoryCreation
  }

  override predicate isSink(DataFlow::Node sink) {
    not exists(SafeXMLInputFactory safe |
      safe.asSource() = sink.asSource()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from XXEConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "XML external entities are not explicitly disabled for this XMLInputFactory. " +
  "This could be vulnerable to XML external entity vulnerabilities."
