/**
 * @name XMLInputFactory Possible XXE
 * @description Detects XMLInputFactory instances without disabled external entities,
 *              which could be vulnerable to XXE attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/xmlinputfactory-possible-xxe
 * @security-severity 7.5
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 *       external/cwe2022-top25
 *       external/cwe2021-top25
 */

import java
import DataFlow

class XMLInputFactoryCreation extends MethodAccess {
  XMLInputFactoryCreation() {
    (this.getMethod().getName() = "newFactory" and
     this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")) or
    (this.getMethod().getName() = "<init>" and
     this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory"))
  }
}

class SafePropertySetting extends MethodAccess {
  SafePropertySetting() {
    exists(Method setProperty, string propName, Expr falseValue |
      setProperty.getName() = "setProperty" and
      setProperty.getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      (
        (propName = "javax.xml.stream.isSupportingExternalEntities" and
         (falseValue instanceof BooleanLiteral and falseValue.(BooleanLiteral).getValue() = false or
          falseValue instanceof FieldAccess and
          falseValue.(FieldAccess).getTarget().hasQualifiedName("java.lang", "Boolean") and
          falseValue.(FieldAccess).getName() = "FALSE"))
        or
        (propName = "IS_SUPPORTING_EXTERNAL_ENTITIES" and
         this.getArgument(0).(FieldAccess).getTarget().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
         (falseValue instanceof BooleanLiteral and falseValue.(BooleanLiteral).getValue() = false or
          falseValue instanceof FieldAccess and
          falseValue.(FieldAccess).getTarget().hasQualifiedName("java.lang", "Boolean") and
          falseValue.(FieldAccess).getName() = "FALSE"))
      ) and
      this.getMethod() = setProperty and
      this.getArgument(0).toString() = propName and
      this.getArgument(1) = falseValue
    )
  }
}

from XMLInputFactoryCreation xifCreation, Method method
where
  method = xifCreation.getEnclosingCallable() and
  not exists(SafePropertySetting sps |
    sps.getEnclosingCallable() = method and
    DataFlow::localFlow(DataFlow::exprNode(sps), DataFlow::exprNode(xifCreation))
  )
select xifCreation,
  "XML external entities are not explicitly disabled for this XMLInputFactory. " +
  "This could be vulnerable to XML external entity vulnerabilities. " +
  "Explicitly disable external entities by setting \"javax.xml.stream.isSupportingExternalEntities\" to false."
