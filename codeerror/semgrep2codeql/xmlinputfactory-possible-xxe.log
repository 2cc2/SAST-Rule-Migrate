Rule Content:
/**
 * @name XMLInputFactory Possible XXE
 * @description Detects XMLInputFactory instances where external entities are not explicitly disabled,
 *              which could lead to XXE vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision medium
 * @id java/xmlinputfactory-possible-xxe
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class XMLInputFactoryCreation extends Expr {
  XMLInputFactoryCreation() {
    exists(MethodCall mc |
      mc.getMethod().hasName("newFactory") and
      mc.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      this = mc
    )
    or
    exists(ConstructorCall cc |
      cc.getConstructor().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      this = cc
    )
  }
}

class SafePropertySetting extends MethodCall {
  SafePropertySetting() {
    this.getMethod().getName() = "setProperty" and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
    (
      exists(StringLiteral sl |
        sl = this.getArgument(0) and
        sl.getValue() = "javax.xml.stream.isSupportingExternalEntities" and
        this.getArgument(1).toString() = "false"
      )
      or
      exists(FieldAccess fa |
        fa = this.getArgument(0) and
        fa.getQualifier().getType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
        fa.getMember().getName() = "IS_SUPPORTING_EXTERNAL_ENTITIES" and
        this.getArgument(1).toString() = "false"
      )
      or
      exists(StringLiteral sl, FieldAccess fa |
        sl = this.getArgument(0) and
        sl.getValue() = "javax.xml.stream.isSupportingExternalEntities" and
        fa = this.getArgument(1) and
        fa.getQualifier().getType().hasQualifiedName("java.lang", "Boolean") and
        fa.getMember().getName() = "FALSE"
      )
      or
      exists(FieldAccess fa1, FieldAccess fa2 |
        fa1 = this.getArgument(0) and
        fa1.getQualifier().getType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
        fa1.getMember().getName() = "IS_SUPPORTING_EXTERNAL_ENTITIES" and
        fa2 = this.getArgument(1) and
        fa2.getQualifier().getType().hasQualifiedName("java.lang", "Boolean") and
        fa2.getMember().getName() = "FALSE"
      )
    )
  }
}

from XMLInputFactoryCreation xmlCreation, MethodCall propertySetCall, Method unsafeMethod
where
  DataFlow::localExprFlow(
    DataFlow::exprNode(xmlCreation),
    DataFlow::exprNode(propertySetCall.getQualifier())
  ) and
  not exists(SafePropertySetting s |
    DataFlow::localExprFlow(DataFlow::exprNode(s), DataFlow::exprNode(propertySetCall.getQualifier()))
  ) and
  unsafeMethod.getBody().getAChild*() = propertySetCall and
  unsafeMethod = propertySetCall.getEnclosingCallable()
select xmlCreation, "XML external entities are not explicitly disabled for this XMLInputFactory, which could lead to XXE vulnerabilities."
