Rule Content:
/**
 * @name XMLInputFactory Possible XXE
 * @description Detects when XMLInputFactory is created without disabling external entities, which could lead to XXE vulnerabilities.
 * @kind problem
 * @problem.severity warning
 * @security-severity 8.8
 * @precision medium
 * @id java/xmlinputfactory-possible-xxe
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isXMLInputFactoryCreation(Expr creation) {
  creation.(ConstructorCall).getConstructedType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")
  or
  exists(MethodAccess newFactory | 
    newFactory.getMethod().hasQualifiedName("javax.xml.stream", "XMLInputFactory", "newFactory")
    and creation = newFactory
  )
}

predicate isPropertyProtected(Expr factory) {
  exists(MethodAccess setProperty |
    setProperty.getMethod().hasQualifiedName("javax.xml.stream", "XMLInputFactory", "setProperty")
    and setProperty.getArgument(0).toString() = "\"javax.xml.stream.isSupportingExternalEntities\""
    and setProperty.getArgument(1).toString() = "false"
    and flows(setProperty.getQualifier(), factory)
  )
  or
  exists(MethodAccess setProperty |
    setProperty.getMethod().hasQualifiedName("javax.xml.stream", "XMLInputFactory", "setProperty")
    and setProperty.getArgument(0).toString() = "XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES"
    and setProperty.getArgument(1).toString() = "false"
    and flows(setProperty.getQualifier(), factory)
  )
}

from Expr factoryCreation, Method method
where 
  isXMLInputFactoryCreation(factoryCreation)
  and method.getEnclosingCallable() = method
  and not (
    exists(BlockStmt block |
      block.getEnclosingCallable() = method
      and exists(block.getAStmt() | isPropertyProtected(factoryCreation))
    )
  )
select factoryCreation, "XMLInputFactory created without disabling external entities (XXE vulnerability). " +
  "Set javax.xml.stream.isSupportingExternalEntities to false to prevent XXE attacks."
