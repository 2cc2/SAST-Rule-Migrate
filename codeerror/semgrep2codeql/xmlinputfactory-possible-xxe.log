/**
 * @name XMLInputFactory possible XXE
 * @description XML external entities are not explicitly disabled for this XMLInputFactory.
 *              This could be vulnerable to XML external entity vulnerabilities. Explicitly
 *              disable external entities by setting "javax.xml.stream.isSupportingExternalEntities"
 *              to false.
 * @kind path-problem
 * @problem.severity warning
 * @id java/xmlinputfactory-possible-xxe
 * @tags security
 *       cwe/611
 *       owasp/a04
 *       owasp/a05
 */

import java
import semmle.code.java.dataflow.FlowSources
import DataFlow::PathGraph

class XMLInputFactoryTaintedFlow extends TaintTracking::Configuration {
  XMLInputFactoryTaintedFlow() { this = "XMLInputFactoryTaintedFlow" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("newFactory") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      source.asExpr() = ma
    )
    or
    exists(ClassInstanceExpr cie |
      cie.getConstructedType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      source.asExpr() = cie
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "setProperty" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      (
        (
          ma.getArgument(0).(CompileTimeConstantExpr).getStringValue() = 
            "javax.xml.stream.isSupportingExternalEntities" and
          not ma.getArgument(1).(CompileTimeConstantExpr).getBooleanValue()
        )
        or
        (
          ma.getArgument(0).(FieldAccess).getField().hasName("IS_SUPPORTING_EXTERNAL_ENTITIES") and
          not ma.getArgument(1).(CompileTimeConstantExpr).getBooleanValue()
        )
      ) and
      sink.asExpr() = ma.getQualifier()
    )
  }
}

