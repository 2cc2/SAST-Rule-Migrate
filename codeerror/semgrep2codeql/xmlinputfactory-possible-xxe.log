import java
import semmle.code.java.dataflow.DataFlow

class XMLInputFactoryCreation extends Expr {
  XMLInputFactoryCreation() {
    (this instanceof Call and
     this.(Call).getCallee().getName() = "newFactory" and
     this.(Call).getCallee().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")) or
    (this instanceof NewClass and
     this.(NewClass).getConstructedType().hasQualifiedName("javax.xml.stream", "XMLInputFactory"))
  }
}

class SafePropertySetting extends Expr {
