/**
 * @name HTTP Response Splitting
 * @description Detects potential HTTP response splitting vulnerabilities caused by CRLF injection 
 *              in cookie values from user input.
 * @kind path-problem
 * @problem.severity warning
 * @id java/http-response-splitting
 * @tags security
 * @tags owasp:a03 # Injection
 * @tags cwe:113   # Improper Neutralization of CRLF Sequences in HTTP Headers
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpServletResponseSplittingConfig extends TaintTracking::Configuration {
  HttpServletResponseSplittingConfig() { this = "HttpServletResponseSplittingConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("getParameter%") and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet", "ServletRequest") and
      source.asExpr() = ma
    )
    or
    exists(Parameter p |
      p.hasAnnotation("org.springframework.web.bind.annotation.PathVariable") and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc, MethodAccess ma |
      cc.getConstructedType().hasQualifiedName("javax.servlet.http", "Cookie") and
      sink.asExpr() = cc.getArgument(1) and
      ma.getMethod().getName() = "addCookie" and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
      ma.getArgument(0) = cc
    )
  }
}

