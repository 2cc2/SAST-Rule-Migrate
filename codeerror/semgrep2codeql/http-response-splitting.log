/**
 * @name HTTP Response Splitting
 * @description Detects potential HTTP response splitting vulnerabilities caused by CRLF injection 
 *              in cookie values from user input.
 * @kind path-problem
 * @problem.severity warning
 * @id java/http-response-splitting
 * @tags security
 * @tags owasp:a03 # Injection
 * @tags cwe:113   # Improper Neutralization of CRLF Sequences in HTTP Headers
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpServletResponseSplittingConfig extends DataFlow::Configuration {
  HttpServletResponseSplittingConfig() { }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodCall mc |
      mc.getCallee().getName().matches("getParameter%") and
      mc.getCallee().getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet", "ServletRequest") and
      source.asExpr() = mc
    )
    or
    exists(Parameter p |
      p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable") and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc, MethodCall mc |
      cc.getConstructedType().hasQualifiedName("javax.servlet.http", "Cookie") and
      sink.asExpr() = cc.getArgument(1) and
      mc.getCallee().getName() = "addCookie" and
      mc.getCallee().getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
      mc.getArgument(0) = cc
    )
  }
}

from HttpServletResponseSplittingConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential HTTP response splitting vulnerability due to unvalidated user input in cookie value."
