/**
 * @name HTTP Response Splitting
 * @description Detects potential HTTP response splitting vulnerabilities where user input containing CRLF
 *              sequences is used in cookie values without proper sanitization.
 * @kind path-problem
 * @problem.severity warning
 * @id java/http-response-splitting
 * @tags security
 *       external/cwe/cwe-113
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class ResponseSplittingConfig extends TaintTracking::Configuration {
  ResponseSplittingConfig() { this = "ResponseSplittingConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "getParameter" and ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest"))
      or
      (ma.getMethod().hasAnnotationType("org.springframework.web.bind.annotation.PathVariable"))
      |
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc, MethodAccess ma |
      cc.getConstructedType().hasQualifiedName("javax.servlet.http", "Cookie") and
      (sink.asExpr() = cc.getArgument(1) or sink.asExpr() = cc.getArgument(2)) and
      ma.getMethod().getName() = "addCookie" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
      DataFlow::localFlow(cc, ma.getArgument(0))
    )
  }
}

