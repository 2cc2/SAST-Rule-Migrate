 *       external/cwe/cwe-113
 *       external/owasp/a03
 */

import java
import DataFlow::PathGraph
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringController

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  // Case 1: Request parameter directly used in Cookie creation
  (
    exists(Method m |
      m.getACall().getName() = "getParameter" and
      source.asExpr() = m.getACall().getAnArgument() and
      exists(Method cookieCreation |
        cookieCreation.getName() = "Cookie" and
        cookieCreation.getACall().getArgument(1) = source.asExpr() and
        exists(Method addCookie |
          addCookie.getName() = "addCookie" and
          addCookie.getACall().getArgument(0).getVariable().getAnAccess() = cookieCreation.getACall() and
          sink.asExpr() = addCookie.getACall().getArgument(0)
        )
      )
    )
  )
  or
  // Case 2: Spring @PathVariable used in Cookie creation
  (
    exists(Method m, Parameter p |
      p = m.getAParameter() and
      exists(Annotation anno |
        anno = p.getAnAnnotation() and
        anno.getType().getName() = "PathVariable" and
        source.asParameter() = p
      ) and
      exists(Method cookieCreation |
        cookieCreation.getName() = "Cookie" and
        cookieCreation.getACall().getArgument(1) = source.asExpr() and
        exists(Method addCookie |
          addCookie.getName() = "addCookie" and
          addCookie.getACall().getArgument(0).getVariable().getAnAccess() = cookieCreation.getACall() and
          sink.asExpr() = addCookie.getACall().getArgument(0)
        )
      )
    )
  )
select sink, "Potential HTTP response splitting vulnerability due to unencoded CRLF characters in cookie value"
