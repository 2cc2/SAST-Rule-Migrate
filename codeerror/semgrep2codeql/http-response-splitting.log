/**
 * @name HTTP Response Splitting
 * @description Older Java application servers are vulnerable to HTTP response splitting,
 *              which may occur if an HTTP request can be injected with CRLF characters.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/http-response-splitting
 * @tags security
 *       external/cwe/cwe-113
 *       external/owasp/a03
 */

import java
import semmle.code.java.security.HttpResponseSplitting
import semmle.code.java.frameworks.spring.SpringController

from HttpRequest request, DataFlow::Node source, DataFlow::Node sink
where
  // Case 1: Request parameter directly used in Cookie creation
  (
    exists(MethodAccess getParam |
      getParam = request.getAMethodAccess("getParameter") and
      source.asExpr() = getParam.getAnArgument() and
      exists(MethodAccess cookieCreation |
        cookieCreation.getMethod().getName() = "Cookie" and
        cookieCreation.getArgument(1) = source.asExpr() and
        exists(MethodAccess addCookie |
          addCookie.getMethod().getName() = "addCookie" and
          addCookie.getArgument(0).(VariableAccess).getTarget() = cookieCreation and
          sink.asExpr() = addCookie.getArgument(0)
        )
      )
    )
  )
  or
  // Case 2: Spring @PathVariable used in Cookie creation
  (
    exists(SpringPathVariableAnnotation pathVar, Method m |
      m.getAParamWithAnnotation(pathVar) = source.asParameter() and
      exists(MethodAccess cookieCreation |
        cookieCreation.getMethod().getName() = "Cookie" and
        cookieCreation.getArgument(1) = source.asExpr() and
        exists(MethodAccess addCookie |
          addCookie.getMethod().getName() = "addCookie" and
          addCookie.getArgument(0).(VariableAccess).getTarget() = cookieCreation and
          sink.asExpr() = addCookie.getArgument(0)
        )
      )
    )
  )
select sink, "Potential HTTP response splitting vulnerability due to unencoded CRLF characters in cookie value"
