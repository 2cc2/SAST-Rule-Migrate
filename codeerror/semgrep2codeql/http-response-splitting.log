Rule Content:
/**
 * @name HTTP Response Splitting
 * @description Older Java application servers are vulnerable to HTTP response splitting,
 *              which may occur if an HTTP request can be injected with CRLF characters.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/http-response-splitting
 * @tags security
 *       external/cwe/cwe-113
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringController

class HttpResponseSplittingConfig extends TaintTracking::Configuration {
  HttpResponseSplittingConfig() { this = "HttpResponseSplittingConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      call.getMethod().getName() = "getParameter" and
      source.asExpr() = call.getArgument(0)
    )
    or
    exists(Parameter p, Annotation anno |
      p.getAnAnnotation() = anno and
      anno.getType().getName() = "PathVariable" and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call cookieCreation, Call addCookie |
      cookieCreation.getMethod().getName() = "Cookie" and
      sink.asExpr() = cookieCreation.getArgument(1) and
      addCookie.getMethod().getName() = "addCookie" and
      addCookie.getArgument(0).(VariableAccess).getTarget() = cookieCreation
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink
where
  any(HttpResponseSplittingConfig conf).hasFlow(source, sink)
select sink, "Potential HTTP response splitting vulnerability due to unencoded CRLF characters in cookie value"
