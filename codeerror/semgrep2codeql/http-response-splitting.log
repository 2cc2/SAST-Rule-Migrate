import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.TaintTrackingConfiguration
import DataFlow::PathGraph

class ResponseSplittingConfig extends TaintTrackingConfiguration {
