    exists(MethodAccess ma |
      (ma.getMethod().getName() = "getParameter" and 
       ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest"))
      or
      (ma.getMethod().getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable"))
      |
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc, MethodAccess ma |
      cc.getConstructedType().hasQualifiedName("javax.servlet.http", "Cookie") and
      (sink.asExpr() = cc.getArgument(1) or sink.asExpr() = cc.getArgument(2)) and
      ma.getMethod().getName() = "addCookie" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse")
    )
  }
}

