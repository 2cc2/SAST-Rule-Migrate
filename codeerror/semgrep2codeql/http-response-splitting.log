/**
 * @name HTTP Response Splitting
 * @description Detects potential HTTP response splitting vulnerabilities where CRLF sequences
 *              can be injected through HTTP headers via cookie values.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/http-response-splitting
 * @tags security
 *       external/cwe/cwe-113
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class HttpServletResponseSplitConfig extends TaintTracking::Configuration {
  HttpServletResponseSplitConfig() { this = "HttpServletResponseSplitConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getParameter") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      source.asExpr() = ma.getArgument(0)
    )
    or
    exists(Parameter p |
      p.hasAnnotation("org.springframework.web.bind.annotation.PathVariable") and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("javax.servlet.http", "Cookie") and
      sink.asExpr() = cc.getArgument(1)
    )
    and
    exists(MethodAccess ma |
      ma.getMethod().hasName("addCookie") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
      sink.asExpr().getEnclosingCallable() = ma.getEnclosingCallable()
    )
  }
}

