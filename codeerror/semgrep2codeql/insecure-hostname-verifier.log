Rule Content:
/**
 * @name Insecure HostnameVerifier Implementation
 * @description Insecure HostnameVerifier implementation detected. This will accept any SSL certificate with any hostname,
 *              which creates the possibility for man-in-the-middle attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-hostname-verifier
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03
 *       external/owasp/a07
 *       external/asvs/V9.2.1
 */

import java
import semmle.code.java.security.HostnameVerifier

class InsecureHostnameVerifier extends HostnameVerifier {
  InsecureHostnameVerifier() {
    exists(Method m |
      m.getDeclaringType() = this and
      m.getName() = "verify" and
      m.getNumberOfParameters() > 0 and
      m.getReturnType().toString() = "boolean" and
      exists(m.getAStmt() |
        asExpr().(ReturnStmt).getResult().(Literal).getValue().toString() = "true"
      )
    )
  }
}

class NoopHostnameVerifierImport extends RefType {
  NoopHostnameVerifierImport() {
    this.hasQualifiedName("org.apache.http.conn.ssl", "NoopHostnameVerifier")
  }
}

from InsecureHostnameVerifier verifier
select verifier, "Insecure HostnameVerifier implementation detected. This will accept any SSL certificate with any hostname."

from NoopHostnameVerifierImport verifier
select verifier, "Insecure HostnameVerifier (NoopHostnameVerifier) imported. This will accept any SSL certificate with any hostname."
