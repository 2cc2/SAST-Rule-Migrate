Rule Content:
/**
 * @name Insecure HostnameVerifier Implementation
 * @description Detects insecure HostnameVerifier implementations that accept any SSL certificate,
 *              making the application vulnerable to man-in-the-middle attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-hostname-verifier
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03
 *       external/owasp/a07
 */

import java
import semmle.code.java.dataflow.DataFlow

class HostnameVerifierType extends RefType {
  HostnameVerifierType() {
    this.hasQualifiedName("javax.net.ssl", "HostnameVerifier")
  }
}

class InsecureVerifyMethod extends Method {
  InsecureVerifyMethod() {
    this.getName() = "verify" and
    this.getDeclaringType().getASupertype() instanceof HostnameVerifierType and
    (
      exists(MethodAccess ma |
        ma.getMethod() = this and
        ma.getArgument(0).toString() = "true"
      )
      or
      exists(BlockStmt b | 
        b.getAChild().toString() = "return true" and
        b.getParent() = this.getBody()
      )
    )
  }
}

class NoopHostnameVerifierImport extends Import {
  NoopHostnameVerifierImport() {
    this.getElement().hasQualifiedName("org.apache.http.conn.ssl", "NoopHostnameVerifier")
  }
}

from InsecureVerifyMethod ivm
select ivm, "Insecure HostnameVerifier implementation detected. This will accept any SSL certificate with any hostname, which creates the possibility for man-in-the-middle attacks."

from NoopHostnameVerifierImport nhvi
select nhvi, "Insecure NoopHostnameVerifier import detected. This will accept any SSL certificate with any hostname, which creates the possibility for man-in-the-middle attacks."
