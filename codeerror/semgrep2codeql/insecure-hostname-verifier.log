Rule Content:
/**
 * @name Insecure HostnameVerifier Implementation
 * @description Detects insecure HostnameVerifier implementations that accept any SSL certificate
 *              with any hostname, creating the possibility for man-in-the-middle attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-hostname-verifier
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03
 *       external/owasp/a07
 */

import java
import semmle.code.java.security.HostnameVerifier

class InsecureHostnameVerifier extends RefType {
  InsecureHostnameVerifier() {
    this.implements("javax.net.ssl.HostnameVerifier") and
    exists(Method m |
      m.getName() = "verify" and
      m.getDeclaringType() = this and
      m.getNumberOfParameters() >= 2 and
      m.getParameterType(0).hasName("String") and
      m.getParameterType(1).hasName("SSLSession") and
      m.getBody().toString().matches("%return true%")
    )
  }
}

class NoopHostnameVerifierImport extends ImportStmt {
  NoopHostnameVerifierImport() {
    this.getImportedType().hasQualifiedName("org.apache.http.conn.ssl", "NoopHostnameVerifier")
  }
}

from InsecureHostnameVerifier iv, NoopHostnameVerifierImport nvi
select iv, "Insecure HostnameVerifier implementation detected. This will accept any SSL certificate with any hostname."
union
select nvi, "Insecure NoopHostnameVerifier import detected. This will accept any SSL certificate with any hostname."
