Rule Content:
/**
 * @name Insecure HostnameVerifier implementation
 * @description Detects insecure HostnameVerifier implementations that accept any SSL certificate
 *              with any hostname, creating potential for man-in-the-middle attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-hostname-verifier
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03:2017
 *       external/owasp/a07:2021
 *       asvs/V9-Communications:9.2.1
 */
import java

from Class cls, Method meth
where (cls.getASupertype*().hasQualifiedName("org.apache.http.conn.ssl", "HostnameVerifier") and
      meth.getDeclaringType() = cls and
      meth.getName() = "verify" and
      exists(ReturnStmt rs | 
        rs = meth.getAReturnStmt() and
        rs.getExpr() instanceof BooleanLiteral and
        rs.getExpr().(BooleanLiteral).getValue() = true
      ))
select cls, "Insecure HostnameVerifier implementation that always returns true in verify() method"

from ClassInstanceExpr cie, Method meth
where (cie.getAnonymousClass().getASupertype*().hasQualifiedName("org.apache.http.conn.ssl", "HostnameVerifier") and
      meth.getDeclaringType() = cie.getAnonymousClass() and
      meth.getName() = "verify" and
      exists(ReturnStmt rs |
        rs = meth.getAReturnStmt() and
        rs.getExpr() instanceof BooleanLiteral and
        rs.getExpr().(BooleanLiteral).getValue() = true
      ))
select cie, "Insecure HostnameVerifier anonymous class implementation that always returns true in verify()"

from Import imp
where imp.getNamespace().hasQualifiedName("org.apache.http.conn.ssl") and
      imp.getName() = "NoopHostnameVerifier"
select imp, "Import of insecure NoopHostnameVerifier that accepts any hostname"
