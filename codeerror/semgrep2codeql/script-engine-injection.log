/**
 * @name Script Engine Injection
 * @description Detected potential code injection using ScriptEngine. Ensure user-controlled data cannot enter '.eval()',
 *              otherwise, this is a code injection vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @precision low
 * @id java/script-engine-injection
 * @tags security
 *       external/cwe/cwe-094
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class ScriptEngineEvalCall extends MethodAccess {
  ScriptEngineEvalCall() {
    getMethod().hasName("eval") and
    getMethod().getDeclaringType().getASupertype*().hasQualifiedName("javax.script", "ScriptEngine")
  }
}

class ScriptEngineConfiguration extends DataFlow::Configuration {
  ScriptEngineConfiguration() { this = "ScriptFlow" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m |
      m.getParameter(0).getAnAccess() = source.asParameter()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ScriptEngineEvalCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, ScriptEngineConfiguration config
where config.hasFlow(source, sink)
select sink, "Potential code injection vulnerability in ScriptEngine.eval() due to user-controlled input"
