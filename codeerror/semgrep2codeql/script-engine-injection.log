/**
 * @name Script Engine Injection
 * @description Detected potential code injection using ScriptEngine. Ensure
 *    user-controlled data cannot enter '.eval()', otherwise, this is
 *    a code injection vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id java/script-engine-injection
 * @tags security
 *       external/cwe/cwe-094
 *       owasp-a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import DataFlow::PathGraph

class ScriptEngineEvalAccess extends MethodAccess {
  ScriptEngineEvalAccess() {
    exists(Method eval |
      eval.hasName("eval") and
      eval.getDeclaringType().getASupertype*().hasQualifiedName("javax.script", "ScriptEngine") and
      this.getMethod() = eval
    )
  }
}

class ConstantExprGuard extends Expr {
  ConstantExprGuard() {
    exists(StringLiteral s | this = s) or
    exists(Variable v |
      this = v.getInitializer() and
      exists(StringLiteral s | s = v.getInitializer())
    )
  }
}

from ScriptEngineEvalAccess se, Expr arg, DataFlow::PathNode source, DataFlow::PathNode sink
where
  arg = se.getArgument(0) and
  // Ensure argument flows from source that might be user-controlled
  exists(DataFlow::PathNode confSource |
    TaintTracking::localTaint(confSource, sink) and
    not exists(ConstantExprGuard guard | sink.getNode() = guard)
  )
select se, "Potential code injection vulnerability via ScriptEngine.eval()", source, sink
