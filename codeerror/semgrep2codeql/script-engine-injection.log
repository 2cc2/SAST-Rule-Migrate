/**
 * @name Script Engine Injection
 * @description Detected potential code injection using ScriptEngine. Ensure
 *     user-controlled data cannot enter '.eval()', otherwise, this is
 *     a code injection vulnerability.
 * @kind problem
 * @problem.severity warning
 * @id java/script-engine-injection
 * @tags security
 *       external/cwe/cwe-94
 *       external/owasp/a03
 */

import java
import semmle.code.java.Member

from MethodCall evalCall, Variable se, Method method
where
  // Find ScriptEngine.eval() calls
  evalCall.getMethod().getName() = "eval" and
  evalCall.getMethod().getDeclaringType().hasQualifiedName("javax.script", "ScriptEngine") and
  // Find the ScriptEngine variable
  ((se.getType() instanceof RefType and (se.getType() as RefType).hasQualifiedName("javax.script", "ScriptEngine")) or
   (se.getType() instanceof RefType and (se.getType() as RefType).getASupertype().hasQualifiedName("javax.script", "ScriptEngine"))) and
  // The eval is called on ScriptEngine variable
  evalCall.getQualifier() = se.getAnAccess() and
  // The containing method
  evalCall.getEnclosingCallable() = method and
  // Exclude cases where the argument is a string literal
  not exists(Expr arg | arg = evalCall.getArgument(0) | arg instanceof StringLiteral) and
  // Exclude cases where the argument is a string literal assigned to a variable
  not exists(LocalVariableDecl decl |
    decl.getAnAccess() = evalCall.getArgument(0) |
    decl.getInitializer() instanceof StringLiteral)
select evalCall, "Potential code injection using ScriptEngine.eval(). Ensure user-controlled data cannot enter .eval() call."
