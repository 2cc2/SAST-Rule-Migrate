Rule Content:
/**
 * @name Jackson unsafe deserialization
 * @description When using Jackson to marshall/unmarshall JSON to Java objects,
 *              enabling default typing is dangerous and can lead to RCE. If an attacker
 *              can control the JSON input it might be possible to provide a malicious JSON which
 *              can be used to exploit unsecure deserialization.
 * @kind problem
 * @problem.severity warning
 * @id java/jackson-unsafe-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a8
 */
import java

// Case 1: Direct enableDefaultTyping() call followed by readValue()
from ObjectMapper om, MethodAccess readValueCall, Expr jsonInput
where
  om.getConstruction().getAPrimaryQlClass() instanceof ObjectMapperConstruction and
  exists(Method enableTypingCall | 
    enableTypingCall.getTarget().getName() = "enableDefaultTyping" and
    enableTypingCall.getQualifier() = om and
    enableTypingCall.getAPrimaryQlClass() is enabledBefore(readValueCall)
  ) and
  readValueCall.getTarget().getName() = "readValue" and
  readValueCall.getQualifier() = om and
  jsonInput = readValueCall.getArgument(0)
select readValueCall, "Unsafe Jackson deserialization with default typing enabled", jsonInput,
  "This readValue call uses ObjectMapper with default typing enabled, which is unsafe."

// Case 2: @JsonTypeInfo with dangerous types
from Class cls, Field f, Annotation jsonTypeInfo, MethodAccess readValueCall, Expr jsonInput
where
  jsonTypeInfo.getType().hasQualifiedName("com.fasterxml.jackson.annotation", "JsonTypeInfo") and
  exists(jsonTypeInfo.getAValue().getAnArg() | 
    this.toString() = "use=Id.CLASS"
  ) and
  f.getDeclaringType() = cls and
  f.getAnAnnotation() = jsonTypeInfo and
  f.getType().getASupertype*().hasName(["Object", "Serializable", "Comparable"]) and
  readValueCall.getTarget().getName() = "readValue" and
  exists(readValueCall.getArgument(1).(ClassLiteral).getType() | this = cls) and
  jsonInput = readValueCall.getArgument(0)
select readValueCall, "Unsafe Jackson deserialization with @JsonTypeInfo(use=Id.CLASS)", jsonInput,
  "This readValue call deserializes to a class with @JsonTypeInfo(use=Id.CLASS) annotation on dangerous type."

// Case 3: ObjectMapper with enableDefaultTyping() in initialization method
from Class cls, Field omField, ObjectMapperConstruction omConstr, 
     Method initMethod, MethodAccess enableTypingCall, 
     MethodAccess readValueCall, Expr jsonInput
where
  omField.getDeclaringType() = cls and
  omConstr.getEnclosingCallable() = initMethod and
  omField.getAnAssignedValue() = omConstr and
  enableTypingCall.getQualifier() = omField.getAnAccess() and
  enableTypingCall.getTarget().getName() = "enableDefaultTyping" and
  exists(initMethod.getBody().getAChild*() | this = enableTypingCall) and
  readValueCall.getQualifier() = omField.getAnAccess() and
  readValueCall.getTarget().getName() = "readValue" and
  jsonInput = readValueCall.getArgument(0)
select readValueCall, "Unsafe Jackson deserialization with ObjectMapper initialized with default typing", jsonInput,
  "This readValue call uses ObjectMapper that was initialized with default typing enabled."
