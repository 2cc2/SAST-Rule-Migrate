Rule Content:
/**
 * @name Unvalidated Redirect
 * @description Application redirects to a destination URL specified by a user-supplied
 *              parameter that is not validated. This could direct users to malicious locations.
 *              Consider using an allowlist to validate URLs.
 * @kind problem
 * @problem.severity warning
 * @id java/unvalidated-redirect
 * @tags security
 *       external/cwe/cwe-601
 *       external/owasp/a01
 *       external/asvs/V5:5.1.5
 */

import java

predicate isParameterRedirect(MethodCall mc, Parameter p) {
  mc.getArgument(0) = p.getAnAccess() and
  not p.getType().toString() = "HttpServletResponse"
}

predicate isRequestParameterRedirect(MethodCall mc) {
  exists(MethodCall getParam |
    mc.getArgument(0) = getParam and
    getParam.getMethod().hasName("getParameter") and
    exists(Parameter p | getParam.getQualifier().getType() instanceof TypeHttpServletRequest)
  )
}

predicate isSendRedirectCase(MethodCall mc) {
  mc.getMethod().hasName("sendRedirect") and
  (isParameterRedirect(mc, _) or isRequestParameterRedirect(mc))
}

predicate isAddHeaderCase(MethodCall mc) {
  mc.getMethod().hasName("addHeader") and
  mc.getArgument(0).toString() = "\"Location\"" and
  (exists(Parameter p | isParameterRedirect(mc, p)) or isRequestParameterRedirect(mc))
}

from MethodCall mc
where isSendRedirectCase(mc) or isAddHeaderCase(mc)
select mc,
  if isSendRedirectCase(mc) then
    if exists(Parameter p | isParameterRedirect(mc, p)) then
      "Unvalidated redirect using parameter via sendRedirect"
    else
      "Unvalidated redirect using request parameter directly via sendRedirect"
  else
    if exists(Parameter p | isParameterRedirect(mc, p)) then
      "Unvalidated redirect using parameter via addHeader" 
    else
      "Unvalidated redirect using request parameter directly via addHeader"
