 */

import java

predicate isResponseSendRedirect(MethodAccess ma) {
  ma.getMethod().getName() = "sendRedirect" and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse")
}

predicate isResponseAddHeaderLocation(MethodAccess ma) {
  ma.getMethod().getName() = "addHeader" and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
