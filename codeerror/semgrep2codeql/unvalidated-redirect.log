Rule Content:
/**
 * @name Unvalidated Redirect
 * @description Application redirects to a destination URL specified by a user-supplied
 *              parameter that is not validated. This could direct users to malicious locations.
 *              Consider using an allowlist to validate URLs.
 * @kind problem
 * @problem.severity warning
 * @id java/unvalidated-redirect
 * @tags security
 *       external/cwe/cwe-601
 *       external/owasp/a01
 *       external/asvs/V5:5.1.5
 */

import java

predicate isUnvalidatedRedirectSendRedirect(MethodAccess sendRedirect) {
  sendRedirect.getMethod().hasName("sendRedirect") and
  (
    exists(Method method, Parameter urlParam |
      sendRedirect.getArgument(0) = urlParam.getAnAccess() and
      method.getAParameter() = urlParam and
      not urlParam.getType().toString() = "HttpServletResponse"
    )
    or
    exists(MethodAccess getParam, Method method |
      sendRedirect.getArgument(0) = getParam and
      getParam.getMethod().hasName("getParameter") and
      exists(Parameter p | method.getAParameter() = p |
        p.getType().toString() = "HttpServletRequest"
      )
    )
  )
}

predicate isUnvalidatedRedirectAddHeader(MethodAccess addHeader) {
  addHeader.getMethod().hasName("addHeader") and
  addHeader.getArgument(0).toString() = "\"Location\"" and
  (
    exists(Method method, Parameter urlParam |
      addHeader.getArgument(1) = urlParam.getAnAccess() and
      method.getAParameter() = urlParam and
      not urlParam.getType().toString() = "HttpServletResponse"
    )
    or
    exists(MethodAccess getParam, Method method |
      addHeader.getArgument(1) = getParam and
      getParam.getMethod().hasName("getParameter") and
      exists(Parameter p | method.getAParameter() = p |
        p.getType().toString() = "HttpServletRequest"
      )
    )
  )
}

from MethodAccess ma
where isUnvalidatedRedirectSendRedirect(ma) or isUnvalidatedRedirectAddHeader(ma)
select ma,
  if isUnvalidatedRedirectSendRedirect(ma) then
    if exists(Parameter p | ma.getArgument(0) = p.getAnAccess() |
      not p.getType().toString() = "HttpServletResponse"
    )
    then "Unvalidated redirect using $@ via sendRedirect" 
    else "Unvalidated redirect using request parameter directly via sendRedirect"
  else
    if exists(Parameter p | ma.getArgument(1) = p.getAnAccess() |
      not p.getType().toString() = "HttpServletResponse"
    )
    then "Unvalidated redirect using $@ via addHeader" 
    else "Unvalidated redirect using request parameter directly via addHeader",
  if (isUnvalidatedRedirectSendRedirect(ma) and exists(Parameter p | ma.getArgument(0) = p.getAnAccess() |
      not p.getType().toString() = "HttpServletResponse"
    ))
    or (isUnvalidatedRedirectAddHeader(ma) and exists(Parameter p | ma.getArgument(1) = p.getAnAccess() |
      not p.getType().toString() = "HttpServletResponse"
    ))
  then "parameter" else ""
