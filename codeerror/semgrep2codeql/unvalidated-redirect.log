Rule Content:
/**
 * @name Unvalidated Redirect
 * @description Application redirects to a destination URL specified by a user-supplied
 *              parameter that is not validated. This could direct users to malicious locations.
 *              Consider using an allowlist to validate URLs.
 * @kind problem
 * @problem.severity warning
 * @id java/unvalidated-redirect
 * @tags security
 *       external/cwe/cwe-601
 *       external/owasp/a01
 *       external/asvs/V5.1.5
 */
import java
import semmle.code.java.frameworks.Servlets

/**
 * Determines if a method call is redirecting using unvalidated URL from request parameter.
 */
predicate isUnvalidatedRedirect(MethodAccess ma, Expr url) {
  ma.getMethod().hasName("sendRedirect") and
  url = ma.getArgument(0) and
  ma.getQualifier().getType() instanceof TypeHttpServletResponse
  or
  ma.getMethod().hasName("addHeader") and
  ma.getArgument(0).(StringLiteral).getValue() = "Location" and
  url = ma.getArgument(1) and
  ma.getQualifier().getType() instanceof TypeHttpServletResponse
}

from Method m, MethodAccess ma, DataFlow::Node sink, DataFlow::ParameterNode source
where
  isUnvalidatedRedirect(ma, sink.asExpr()) and
  (
    exists(Parameter p | 
      source = p and
      p.getType() instanceof TypeString and
      DataFlow::localFlow(source, sink)
    )
    or
    exists(Call call | 
      call.getMethod().getName().matches("getParameter%") and
      call.getQualifier().getType() instanceof TypeHttpServletRequest and
      DataFlow::localFlow(DataFlow::exprNode(call), sink)
    )
  )
select ma, "Unvalidated redirect to URL from user input. Consider validating the URL with an allowlist."
