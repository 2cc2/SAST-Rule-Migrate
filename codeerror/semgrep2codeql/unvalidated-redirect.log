Rule Content:
/**
 * @name Unvalidated Redirect
 * @description Application redirects to a destination URL specified by a user-supplied
 *              parameter that is not validated. This could direct users to malicious locations.
 *              Consider using an allowlist to validate URLs.
 * @kind problem
 * @problem.severity warning
 * @id java/unvalidated-redirect
 * @tags security
 *       external/cwe/cwe-601
 *       external/owasp/a01
 *       external/asvs/V5:5.1.5
 */

import java

// Case 1: sendRedirect with String parameter
from MethodAccess sendRedirect, Method method, Parameter urlParam
where
  sendRedirect.getMethod().hasName("sendRedirect") and
  sendRedirect.getArgument(0) = urlParam.getAnAccess() and
  method.getAParameter() = urlParam and
  not urlParam.getType().toString() = "HttpServletResponse"
select sendRedirect, "Unvalidated redirect using $@", urlParam, "parameter"

// Case 2: sendRedirect with request.getParameter directly
from MethodAccess sendRedirect, MethodAccess getParam, Method method
where
  sendRedirect.getMethod().hasName("sendRedirect") and
  getParam.getMethod().hasName("getParameter") and
  sendRedirect.getArgument(0) = getParam and
  exists(Parameter p | method.getAParameter() = p | p.getType().toString() = "HttpServletRequest")
select sendRedirect, "Unvalidated redirect using request parameter directly"

// Case 3: addHeader("Location") with String parameter
from MethodAccess addHeader, Method method, Parameter urlParam
where
  addHeader.getMethod().hasName("addHeader") and
  addHeader.getArgument(0).toString() = "\"Location\"" and
  addHeader.getArgument(1) = urlParam.getAnAccess() and
  method.getAParameter() = urlParam and
  not urlParam.getType().toString() = "HttpServletResponse"
select addHeader, "Unvalidated redirect using $@ via addHeader", urlParam, "parameter"

// Case 4: addHeader("Location") with request.getParameter directly
from MethodAccess addHeader, MethodAccess getParam, Method method
where
  addHeader.getMethod().hasName("addHeader") and
  addHeader.getArgument(0).toString() = "\"Location\"" and
  getParam.getMethod().hasName("getParameter") and
  addHeader.getArgument(1) = getParam and
  exists(Parameter p | method.getAParameter() = p | p.getType().toString() = "HttpServletRequest")
select addHeader, "Unvalidated redirect using request parameter directly via addHeader"
