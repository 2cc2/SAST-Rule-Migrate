Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 *    injection if variables in the SQL statement are not properly sanitized.
 *    Use a prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 *       external/cwe2022-top25
 *       external/cwe2021-top25
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.JavaJDO

// Case 1: Query method with dynamic SQL
from MethodAccess call, Expr sql, Variable q
where
  // SQL source patterns
  (
    // String concatenation
    sql instanceof AddExpr
    or
    // String.format
    exists(MethodInvocation format | format.getMethod().getName() = "format" and sql = format)
  )
  and
  // Query usage patterns
  (
    (q.getType() instanceof RawType and q.getType().getName() = "javax.jdo.Query" and call.getQualifier() = q.getAnAccess())
    or
    (exists(Parameter param | param.getType() instanceof RawType and param.getType().getName() = "javax.jdo.Query" 
       and param.getAnAccess() = call.getQualifier()))
  )
  and
  // Method filter
  call.getMethod().getName() matches /^(setFilter|setGrouping)$/
  and
  // Exclude static string concatenation
  not exists(AddExpr staticConcat | sql = staticConcat and all(Expr operand | operand instanceof StringLiteral))
select call, "Detected a formatted string in a SQL statement. This could lead to SQL injection."

// Case 2: PersistenceManager.newQuery with dynamic SQL
from MethodInvocation newQuery, Expr sql, Variable pm
where
  newQuery.getMethod().getName() = "newQuery" 
  and newQuery.getMethod().getDeclaringType().getName() = "javax.jdo.PersistenceManager"
  and
  // SQL source patterns
  (
    // String concatenation
    sql instanceof AddExpr
    or
    // String.format
    exists(MethodInvocation format | format.getMethod().getName() = "format" and sql = format)
  )
  and
  // PersistenceManager usage patterns
  (
    (pm.getType() instanceof RawType and pm.getType().getName() = "javax.jdo.PersistenceManager" and newQuery.getQualifier() = pm.getAnAccess())
    or
    (exists(Parameter param | param.getType() instanceof RawType and param.getType().getName() = "javax.jdo.PersistenceManager" 
       and param.getAnAccess() = newQuery.getQualifier()))
  )
  and
  // Exclude static string concatenation
  not exists(AddExpr staticConcat | sql = staticConcat and all(Expr operand | operand instanceof StringLiteral))
select newQuery, "Detected a formatted string in a SQL statement. This could lead to SQL injection."
