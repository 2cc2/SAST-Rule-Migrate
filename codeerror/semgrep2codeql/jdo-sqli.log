Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 *    injection if variables in the SQL statement are not properly sanitized.
 *    Use a prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 *       external/cwe2022-top25
 *       external/cwe2021-top25
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isDynamicSQL(Expr sql) {
  exists(AddExpr add | sql = add and not exists(StringLiteral lit | add.getAnOperand() = lit))
  or
  exists(Call format | format.getCallee().hasName("format") and sql = format)
}

from Call call, Expr sql, Variable q
where
  isDynamicSQL(sql) and
  (
    (q.getType().hasName("javax.jdo.Query") and call.getQualifier() = q.getAnAccess())
    or
    exists(Parameter param | param.getType().hasName("javax.jdo.Query") and param.getAnAccess() = call.getQualifier())
  ) and
  (call.getCallee().hasName("setFilter") or call.getCallee().hasName("setGrouping"))
select call, "Detected a formatted string in a SQL statement. This could lead to SQL injection."

from Call newQuery, Expr sql, Variable pm
where
  newQuery.getCallee().hasName("newQuery") and
  newQuery.getCallee().getDeclaringType().hasName("javax.jdo.PersistenceManager") and
  isDynamicSQL(sql) and
  (
    (pm.getType().hasName("javax.jdo.PersistenceManager") and newQuery.getQualifier() = pm.getAnAccess())
    or
    exists(Parameter param | param.getType().hasName("javax.jdo.PersistenceManager") and param.getAnAccess() = newQuery.getQualifier())
  )
select newQuery, "Detected a formatted string in a SQL statement. This could lead to SQL injection."
