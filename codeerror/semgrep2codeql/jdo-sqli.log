/**
 * @name JDO SQL Injection
 * @description Detects potential SQL injection in JDO queries when using string concatenation or String.format().
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class JdoQuery extends RefType {
  JdoQuery() {
    this.hasQualifiedName("javax.jdo", "Query")
  }
}

class JdoPersistenceManager extends RefType {
  JdoPersistenceManager() {
    this.hasQualifiedName("javax.jdo", "PersistenceManager")
  }
}

class SqlSource extends DataFlow::Node {
  SqlSource() {
    exists(StringConcatenation sc |
      this.asExpr() = sc
    ) or
    exists(StringFormatExpr sfe |
      this.asExpr() = sfe
    )
  }
}

class JdoSink extends DataFlow::Node {
  JdoSink() {
    exists(MethodAccess ma |
      (ma.getCallee().getDeclaringType() instanceof JdoQuery and
       ma.getCallee().getName().matches("setFilter|setGrouping")) and
      this.asExpr() = ma.getArgument(0)
    ) or
    exists(MethodAccess ma |
      ma.getCallee().getDeclaringType() instanceof JdoPersistenceManager and
      ma.getCallee().getName() = "newQuery" and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

predicate isSafeString(Expr e) {
  exists(StringLiteral sl |
    DataFlow::literalExpr(sl, e)
  )
}

class JdoConfig extends TaintTracking::Configuration {
  JdoConfig() { this = "JdoConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlSource and
    not isSafeString(source.asExpr())
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JdoSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from JdoConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection in JDO query. Use prepared statements instead."
