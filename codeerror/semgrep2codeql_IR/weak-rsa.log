/**
 * @name Use of weak RSA key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-weak-rsa-key
 * @tags security
 *   vulnerability
 *   cwe/326
 *   owasp/a03:2017
 *   owasp/a02:2021
 *   asvs/V6.2.5
 */
import java

from MethodAccess initializeCall, MethodAccess getInstanceCall, Expr bitsExpr
where
  // Match KeyPairGenerator.getInstance("RSA")
  getInstanceCall.getMethod().getName() = "getInstance" and
  getInstanceCall.getQualifier().getType().hasName("KeyPairGenerator") and
  getInstanceCall.getArgument(0).(StringLiteral).getValue() = "RSA" and
  
  // Match initialize() call on the same KeyPairGenerator instance
  initializeCall.getMethod().getName() = "initialize" and
  initializeCall.getQualifier() = getInstanceCall.getQualifier() and
  
  // Get the bits argument
  bitsExpr = initializeCall.getArgument(0) and
  bitsExpr.getValue().toInt() < 2048
select initializeCall, "RSA keys should be at least 2048 bits based on NIST recommendation."
