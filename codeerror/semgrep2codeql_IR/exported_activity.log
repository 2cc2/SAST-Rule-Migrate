Rule Content:
/**
 * @name Exported Activity Vulnerability
 * @description The application exports an activity. Any application on the device can launch the exported activity which may compromise the integrity of your application or its data.
 * @kind problem
 * @problem.severity warning
 * @id android/exported-activity
 * @tags security
 *       vulnerability
 *       android
 * @cwe 926
 * @owasp A5:2021
 */

import java
import semmle.code.xml.XML

from XmlElement activity, XmlAttribute exportedAttr, XmlElement intentFilter
where
  activity.getName() = "activity" and
  (
    (exportedAttr.getName() = "exported" and exportedAttr.getValue() = "true") or
    activity.getChild("intent-filter") = intentFilter
  ) and
  not exists(
    XmlAttribute falseExported |
    falseExported.getName() = "exported" and
    falseExported.getValue() = "false" and
    activity.getAnAttribute() = falseExported
  ) and
  activity.getFile().getAbsolutePath().matches("%AndroidManifest.xml") and
  not activity.getFile().getAbsolutePath().matches("%sources/%") and
  not activity.getFile().getAbsolutePath().matches("%classes3.dex") and
  not activity.getFile().getAbsolutePath().matches("%.so")
select activity, "Exported activity found. Ensure that any exported activities do not have privileged access to your application's control plane."
