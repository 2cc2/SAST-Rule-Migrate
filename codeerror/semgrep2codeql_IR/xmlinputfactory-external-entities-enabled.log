Rule Content:
/**
 * @name XMLInputFactory External Entities Enabled
 * @description XML external entities are enabled for this XMLInputFactory. This is vulnerable to XML external entity attacks. 
 *              Disable external entities by setting "javax.xml.stream.isSupportingExternalEntities" to false.
 * @kind problem
 * @problem.severity error
 * @id java/xmlinputfactory-external-entities-enabled
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 *       external/asvs/V5.5.2
 *       cwe2021-top25
 *       cwe2022-top25
 */

import java

from MethodAccess setPropertyCall, Variable xmlFactory
where
  // Check for direct string property name
  (
    setPropertyCall.getMethod().getName() = "setProperty" and
    setPropertyCall.getArgument(0).(StringLiteral).getValue() = 
      "javax.xml.stream.isSupportingExternalEntities" and
    (setPropertyCall.getArgument(1).(BooleanLiteral).getValue() = true or
     setPropertyCall.getArgument(1).toString() = "Boolean.TRUE")
  )
  or
  // Check for constant field property name
  (
    setPropertyCall.getMethod().getName() = "setProperty" and
    setPropertyCall.getArgument(0).toString() = 
      "javax.xml.stream.XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES" and
    (setPropertyCall.getArgument(1).(BooleanLiteral).getValue() = true or
     setPropertyCall.getArgument(1).toString() = "Boolean.TRUE")
  )
  or
  // Check for DTD support
  (
    setPropertyCall.getMethod().getName() = "setProperty" and
    (setPropertyCall.getArgument(0).toString() = 
      "javax.xml.stream.XMLInputFactory.SUPPORT_DTD" or
     setPropertyCall.getArgument(0).(StringLiteral).getValue() = 
      "javax.xml.stream.supportDTD") and
    (setPropertyCall.getArgument(1).(BooleanLiteral).getValue() = true or
     setPropertyCall.getArgument(1).toString() = "Boolean.TRUE")
  ) and
  xmlFactory = setPropertyCall.getQualifier() and
  xmlFactory.getType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")
select setPropertyCall, 
  "XML external entities are enabled for this XMLInputFactory. This is vulnerable to XML external entity attacks. " +
  "Disable external entities by setting \"javax.xml.stream.isSupportingExternalEntities\" to false."
