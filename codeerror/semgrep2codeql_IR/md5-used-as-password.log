/**
 * @name MD5 used as password hash
 * @description Detects when MD5 is used as a password hash, which is insecure.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision medium
 * @id java/md5-used-as-password
 * @tags security
 *       vulnerability
 *       owasp-a03
 *       owasp-a02
 *       cwe-327
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.security.MessageDigest

class MD5PasswordHashConfig extends TaintTracking::Configuration {
  MD5PasswordHashConfig() { this = "MD5PasswordHashConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.security.MessageDigest", "getInstance") and
      ma.getArgument(0).(StringLiteral).getValue().toUpperCase() = "MD5" and
      source.asExpr() = ma
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "digest" and
      ma.getQualifier().getType().hasName("java.security.MessageDigest") and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%password%") and
      sink.asExpr() = ma.getAnArgument()
    )
  }
}

from MD5PasswordHashConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "It looks like MD5 is used as a password hash. MD5 is not considered a secure password hash because it can be cracked by an attacker in a short amount of time. Use a suitable password hashing function such as PBKDF2 or bcrypt. You can use `javax.crypto.SecretKeyFactory` with `SecretKeyFactory.getInstance(\"PBKDF2WithHmacSHA1\")` or, if using Spring, `org.springframework.security.crypto.bcrypt`.",
  source, sink,
  "Insecure password hashing using MD5"
