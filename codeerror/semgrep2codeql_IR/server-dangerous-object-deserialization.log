Rule Content:
/**
 * @name Server Dangerous Object Deserialization
 * @description Using an arbitrary object with Java RMI is an insecure deserialization vulnerability.
 *              This object can be manipulated by a malicious actor allowing them to execute code on your system.
 *              Instead, use an integer ID to look up your object, or consider alternative serialization schemes such as JSON.
 * @kind problem
 * @problem.severity error
 * @id java/server-dangerous-object-deserialization
 * @tags security
 *       cwe/502
 *       owasp/a08
 *       owasp/a08:2017
 *       owasp/a08:2021
 *       cwe2021-top25
 *       cwe2022-top25
 *       technology/rmi
 *       subcategory/audit
 */

import java

// Define primitive types and their wrapper classes to exclude
predicate isSafeType(RefType t) {
  t.hasQualifiedName("java.lang", "String") or
  t.hasQualifiedName("java.lang", "Boolean") or
  t.hasQualifiedName("java.lang", "Byte") or
  t.hasQualifiedName("java.lang", "Character") or
  t.hasQualifiedName("java.lang", "Double") or
  t.hasQualifiedName("java.lang", "Float") or
  t.hasQualifiedName("java.lang", "Integer") or
  t.hasQualifiedName("java.lang", "Long") or
  t.hasQualifiedName("java.lang", "Short") or
  t.hasQualifiedName("", "boolean") or
  t.hasQualifiedName("", "byte") or
  t.hasQualifiedName("", "char") or
  t.hasQualifiedName("", "double") or
  t.hasQualifiedName("", "float") or
  t.hasQualifiedName("", "int") or
  t.hasQualifiedName("", "long") or
  t.hasQualifiedName("", "short")
}

// Find RMI interfaces extending Remote
class RmiInterface extends RefType {
  RmiInterface() {
    this.getASupertype*().hasQualifiedName("java.rmi", "Remote") and
    this.isInterface()
  }
}

// Find methods in RMI interfaces with unsafe parameter types
class UnsafeRmiMethod extends Method {
  UnsafeRmiMethod() {
    exists(RmiInterface rmiInterface, Parameter p |
      this.getDeclaringType() = rmiInterface and
      this.getAParameter() = p and
      not isSafeType(p.getType()) and
      this.getAnException().hasQualifiedName("java.rmi", "RemoteException")
    )
  }
}

from UnsafeRmiMethod method, Parameter param
where not isSafeType(param.getType())
select method, "Using an arbitrary object (" + param.getType() + " " + param.getName() + 
  ") with Java RMI is an insecure deserialization vulnerability. " +
  "This object can be manipulated by a malicious actor allowing them to execute code on your system. " +
  "Instead, use an integer ID to look up your object, or consider alternative serialization schemes such as JSON."
