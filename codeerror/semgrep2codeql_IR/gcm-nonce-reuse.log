/**
 * @name GCM IV/nonce reuse
 * @description Detects cases where GCM IV/nonce is reused, making encryption ineffective
 * @kind problem
 * @problem.severity error
 * @id java/gcm-nonce-reuse
 * @tags security
 *       external/cwe/cwe-323
 *       owasp-a2
 *       crypto
 */

import java

// Case 1: Direct string literal used as nonce
from ConstructorInvocation ci, MethodAccess ma
where 
  ci.getConstructor().getDeclaringType().hasQualifiedName("javax.crypto.spec", "GCMParameterSpec") and
  ma.getMethod().getName() = "getBytes" and
  ma.getQualifier() instanceof StringLiteral and
  ma.getEnclosingCallable() = ci.getEnclosingCallable()
select ci, "GCM IV/nonce is reused: encryption can be totally useless"

// Case 2: String literal assigned to variable then used as nonce
from LocalVariableDecl lvd, VariableAccess va, ConstructorInvocation ci, MethodAccess ma
where
  lvd.getVariable() = va.getVariable() and
  ci.getConstructor().getDeclaringType().hasQualifiedName("javax.crypto.spec", "GCMParameterSpec") and
  va.getEnclosingCallable() = ci.getEnclosingCallable() and
  ma.getMethod().getName() = "getBytes" and
  ma.getQualifier() instanceof StringLiteral and
  ma.getEnclosingCallable() = lvd.getEnclosingCallable() and
  exists(Expr arg | arg = ci.getArgument(_) | arg = va)
select ci, "GCM IV/nonce is reused: encryption can be totally useless"
