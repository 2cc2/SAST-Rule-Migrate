/**
 * @name Spring Boot Actuator Fully Enabled
 * @description Spring Boot Actuator is fully enabled. This exposes sensitive endpoints such as /actuator/env, 
 *              /actuator/logfile, /actuator/heapdump and others. Unless you have Spring Security enabled or 
 *              another means to protect these endpoints, this functionality is available without authentication, 
 *              causing a severe security risk.
 * @kind problem
 * @problem.severity warning
 * @id spring-actuator-fully-enabled-yaml
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a01
 *       cwe2021-top25
 * @precision medium
 * @security-severity 8.0
 */
import yaml

predicate isActuatorFullyEnabled(YamlFile yamlFile) {
  exists(YamlMap managementMap, YamlMap endpointsMap, YamlMap webMap, YamlMap exposureMap, YamlScalar includeScalar |
    yamlFile.getTopLevelValue("management") = managementMap and
    managementMap.getMapValue("endpoints") = endpointsMap and
    endpointsMap.getMapValue("web") = webMap and
    webMap.getMapValue("exposure") = exposureMap and
    exposureMap.getScalarValue("include") = includeScalar and
    includeScalar.getStringValue() = "*"
  )
}

from YamlFile yamlFile
where isActuatorFullyEnabled(yamlFile)
select yamlFile, "Spring Boot Actuator is fully enabled with wildcard endpoint exposure. This exposes sensitive " +
  "endpoints without authentication, causing a severe security risk."
