Rule Content:
/**
 * @name No direct response writer
 * @description Detected a request with potential user-input going into a OutputStream or Writer object. 
 *              This bypasses any view or template environments, including HTML escaping, which may expose 
 *              this application to cross-site scripting (XSS) vulnerabilities. Consider using a view 
 *              technology such as JavaServer Faces (JSFs) which automatically escapes HTML views.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/no-direct-response-writer
 * @tags security
 *       vulnerability
 *       cwe/79
 *       owasp-a07:2017
 *       owasp-a03:2021
 *       cwe2021-top25
 *       cwe2022-top25
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ServletRequestSource extends DataFlow::ExprNode {
  ServletRequestSource() {
    exists(Method m |
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getInputStream") or
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getParameter") or
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getParameterMap") or
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getParameterValues") or
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getReader") or
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getCookies") or
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getHeader") or
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getHeaderNames") or
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getHeaders") or
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getPart") or
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getParts") or
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getQueryString") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getInputStream") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getParameter") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getParameterMap") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getParameterValues") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getReader") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getCookies") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getHeader") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getHeaderNames") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getHeaders") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getPart") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getParts") or
      m.hasQualifiedName("javax.servlet.ServletRequest", "getQueryString") |
      this.asExpr() = m.getACall()
    )
  }
}

class ResponseWriterSink extends DataFlow::ExprNode {
  ResponseWriterSink() {
    exists(Method m |
      m.hasQualifiedName("javax.servlet.http.HttpServletResponse", "getWriter") or
      m.hasQualifiedName("javax.servlet.http.HttpServletResponse", "getOutputStream") or
      m.hasQualifiedName("java.io.PrintWriter", "write") or
      m.hasQualifiedName("javax.servlet.ServletOutputStream", "write") or
      m.hasQualifiedName("java.io.OutputStream", "write") |
      this.asExpr() = m.getACall()
    )
  }
}

class HtmlSanitizer extends DataFlow::ExprNode {
  HtmlSanitizer() {
    exists(Method m |
      m.hasQualifiedName("Encode", "forHtml") or
      m.hasQualifiedName("PolicyFactory", "sanitize") or
      m.hasQualifiedName("AntiSamy", "scan") or
      m.hasQualifiedName("JSoup", "clean") or
      m.hasQualifiedName("org.apache.commons.lang.StringEscapeUtils", "escapeHtml") or
      m.hasQualifiedName("org.springframework.web.util.HtmlUtils", "htmlEscape") or
      m.hasQualifiedName("org.owasp.esapi.ESAPI.encoder", "encodeForHTML") |
      this.asExpr() = m.getACall()
    )
  }
}

class NoDirectResponseWriterConfig extends TaintTracking::Configuration {
  NoDirectResponseWriterConfig() { this = "NoDirectResponseWriterConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ResponseWriterSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof HtmlSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, NoDirectResponseWriterConfig cfg
where cfg.hasFlowPath(source, sink)
select sink, "Potential XSS vulnerability: user input flows directly to response writer without proper HTML escaping."
