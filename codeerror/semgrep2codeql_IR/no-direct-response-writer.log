Rule Content:
/**
 * @name No direct response writer
 * @description Detected a request with potential user-input going into a OutputStream or Writer object. 
 *              This bypasses any view or template environments, including HTML escaping, which may expose 
 *              this application to cross-site scripting (XSS) vulnerabilities. Consider using a view 
 *              technology such as JavaServer Faces (JSFs) which automatically escapes HTML views.
 * @kind path-problem
 * @problem.severity warning
 * @precision medium
 * @id java/no-direct-response-writer
 * @tags security
 *       vulnerability
 *       cwe/79
 *       owasp-a07:2017
 *       owasp-a03:2021
 *       cwe2021-top25
 *       cwe2022-top25
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat

class ServletRequestSource extends RemoteFlowSource::Range {
  ServletRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getInputStream") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getParameter") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getParameterMap") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getParameterValues") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getReader") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getCookies") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getHeader") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getHeaderNames") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getHeaders") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getPart") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getParts") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getQueryString") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getInputStream") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getParameter") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getParameterMap") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getParameterValues") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getReader") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getCookies") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getHeader") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getHeaderNames") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getHeaders") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getPart") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getParts") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getQueryString") and
      this = ma.getMethod().getReturnType()
    )
  }
}

class ResponseWriterSink extends DataFlow::Node {
  ResponseWriterSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletResponse", "getWriter") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletResponse", "getOutputStream") or
      ma.getMethod().hasQualifiedName(
        "java.io.PrintWriter", "write") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletOutputStream", "write") or
      ma.getMethod().hasQualifiedName(
        "java.io.OutputStream", "write") and
      this.asExpr() = ma
    )
  }
}

class HtmlSanitizer extends DataFlow::Node {
  HtmlSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName(
        "Encode", "forHtml") or
      ma.getMethod().hasQualifiedName(
        "PolicyFactory", "sanitize") or
      ma.getMethod().hasQualifiedName(
        "AntiSamy", "scan") or
      ma.getMethod().hasQualifiedName(
        "JSoup", "clean") or
      ma.getMethod().hasQualifiedName(
        "org.apache.commons.lang.StringEscapeUtils", "escapeHtml") or
      ma.getMethod().hasQualifiedName(
        "org.springframework.web.util.HtmlUtils", "htmlEscape") or
      ma.getMethod().hasQualifiedName(
        "org.owasp.esapi.ESAPI.encoder", "encodeForHTML") and
      this.asExpr() = ma
    )
  }
}

class NoDirectResponseWriterConfig extends TaintTracking::Configuration {
  NoDirectResponseWriterConfig() { this = "NoDirectResponseWriterConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ResponseWriterSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof HtmlSanitizer
  }
}

from NoDirectResponseWriterConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential XSS vulnerability: user input flows directly to response writer without proper HTML escaping."
