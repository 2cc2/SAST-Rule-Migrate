      ma.getMethod().hasQualifiedName("javax.servlet.ServletRequest", "getHeader") or
      ma.getMethod().hasQualifiedName("javax.servlet.ServletRequest", "getHeaderNames") or
      ma.getMethod().hasQualifiedName("javax.servlet.ServletRequest", "getHeaders") or
      ma.getMethod().hasQualifiedName("javax.servlet.ServletRequest", "getPart") or
      ma.getMethod().hasQualifiedName("javax.servlet.ServletRequest", "getParts") or
      ma.getMethod().hasQualifiedName("javax.servlet.ServletRequest", "getQueryString")) and
      this.asExpr() = ma
    )
  }
}

class ResponseWriterSink extends DataFlow::ExprNode {
  ResponseWriterSink() {
    exists(MethodAccess ma |
      (ma.getMethod().hasQualifiedName("javax.servlet.http.HttpServletResponse", "getWriter") or
      ma.getMethod().hasQualifiedName("javax.servlet.http.HttpServletResponse", "getOutputStream") or
      ma.getMethod().hasQualifiedName("java.io.PrintWriter", "write") or
      ma.getMethod().hasQualifiedName("javax.servlet.ServletOutputStream", "write") or
      ma.getMethod().hasQualifiedName("java.io.OutputStream", "write")) and
      this.asExpr() = ma
    )
  }
}

class HtmlSanitizer extends DataFlow::ExprNode {
  HtmlSanitizer() {
    exists(MethodAccess ma |
      (ma.getMethod().hasQualifiedName("Encode", "forHtml") or
      ma.getMethod().hasQualifiedName("PolicyFactory", "sanitize") or
      ma.getMethod().hasQualifiedName("AntiSamy", "scan") or
      ma.getMethod().hasQualifiedName("JSoup", "clean") or
      ma.getMethod().hasQualifiedName("org.apache.commons.lang.StringEscapeUtils", "escapeHtml") or
      ma.getMethod().hasQualifiedName("org.springframework.web.util.HtmlUtils", "htmlEscape") or
      ma.getMethod().hasQualifiedName("org.owasp.esapi.ESAPI.encoder", "encodeForHTML")) and
      this.asExpr() = ma
    )
  }
}

class NoDirectResponseWriterConfig extends TaintTracking::Configuration {
  NoDirectResponseWriterConfig() { this = "NoDirectResponseWriterConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ResponseWriterSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof HtmlSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, NoDirectResponseWriterConfig cfg
where cfg.hasFlowPath(source, sink)
select sink, "Potential XSS vulnerability: user input flows directly to response writer without proper HTML escaping."
================================================================================
