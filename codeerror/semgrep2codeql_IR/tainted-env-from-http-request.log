 * @description Detected input from a HTTPServletRequest going into the environment variables of an 'exec' command.
 *              Instead, call the command with user-supplied arguments by using the overloaded method with one String array as the argument.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-env-from-http-request
 * @tags security
 *       external/cwe/cwe-454
 *       owasp-a01
 *       owasp-a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(Method m, Parameter p |
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      p = m.getAParameter() and
      this.asParameter() = p
    )
    or
    exists(MethodAccess ma, ForStmt fs, LocalVariableDeclStmt lvds |
      ma.getMethod().getName() = "getCookies" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      lvds.getDeclaredType().hasQualifiedName("javax.servlet.http", "Cookie[]") and
      exists(MethodAccess cookieGetValue |
        cookieGetValue.getMethod().getName() = "getValue" and
        cookieGetValue.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
        this.asExpr() = cookieGetValue
      )
    )
  }
}

class RuntimeExecSink extends DataFlow::Node {
  RuntimeExecSink() {
    exists(Method m, MethodAccess ma |
      m.getName() = "exec" and
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class TaintedEnvFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedEnvFromHttpRequestConfig() { this = "TaintedEnvFromHttpRequestConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof RuntimeExecSink }
}

