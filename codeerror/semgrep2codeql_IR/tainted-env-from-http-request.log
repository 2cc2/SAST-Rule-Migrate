Rule Content:
/**
 * @name Tainted environment from HTTP request
 * @description Detected input from a HTTPServletRequest going into the environment variables of an 'exec' command.
 *              Instead, call the command with user-supplied arguments by using the overloaded method with one String array as the argument.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-env-from-http-request
 * @tags security
 *       external/cwe/cwe-454
 *       owasp-a01
 *       owasp-a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class HttpRequestSource extends DataFlow::Source {
  HttpRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") |
      this.asParameter() = ma.getAnArgument()
    )
    or
    exists(MethodAccess ma, ForStmt fs |
      ma.getMethod().getName() = "getCookies" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      fs.getAChild() instanceof LocalVariableDeclStmt and
      fs.getAChild().getAChild().getType().hasQualifiedName("javax.servlet.http", "Cookie[]") and
      ma.getAnArgument() = this.asParameter() and
      exists(MethodAccess cookieGetValue |
        cookieGetValue.getMethod().getName() = "getValue" and
        cookieGetValue.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
        this.asExpr() = cookieGetValue
      )
    )
  }
}

class RuntimeExecSink extends DataFlow::Sink {
  RuntimeExecSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "exec" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      ma.getArgument(1) = this.asExpr()
    )
  }
}

class TaintedEnvFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedEnvFromHttpRequestConfig() { this = "TaintedEnvFromHttpRequestConfig" }

  override predicate isSource(DataFlow::Source source) { source instanceof HttpRequestSource }

  override predicate isSink(DataFlow::Sink sink) { sink instanceof RuntimeExecSink }
}

from TaintedEnvFromHttpRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected input from a HTTPServletRequest going into the environment variables of an 'exec' command."
