 *   external/cwe-top25
 */

import java

// Case 1: ExpressionFactory.createValueExpression with dynamic input
predicate isDynamicValueExprCreation(Expr ma) {
  exists(Method m, Expr qualifier, Expr input |
    ma.(MethodAccess).getMethod().hasName("createValueExpression") and
    qualifier = ma.(MethodAccess).getQualifier() and
    qualifier.getType().hasQualifiedName("javax.el", "ExpressionFactory") and
    input = ma.(MethodAccess).getArgument(1) and
    not input instanceof StringLiteral and
    not exists(LocalVariableDecl lvd | 
      lvd.getAnAccess() = input and
      lvd.getInitializer() instanceof StringLiteral
    )
  )
}

// Case 2: ExpressionFactory.createMethodExpression with dynamic input
predicate isDynamicMethodExprCreation(Expr ma) {
  exists(Method m, Expr qualifier, Expr input |
    ma.(MethodAccess).getMethod().hasName("createMethodExpression") and
    qualifier = ma.(MethodAccess).getQualifier() and
    qualifier.getType().hasQualifiedName("javax.el", "ExpressionFactory") and
    input = ma.(MethodAccess).getArgument(1) and
    not input instanceof StringLiteral and
    not exists(LocalVariableDecl lvd | 
      lvd.getAnAccess() = input and
      lvd.getInitializer() instanceof StringLiteral
    )
  )
}

// Case 3: buildConstraintViolationWithTemplate with dynamic input
predicate isDynamicConstraintViolation(Expr ma) {
  exists(Method m, Expr input |
    ma.(MethodAccess).getMethod().hasName("buildConstraintViolationWithTemplate") and
    input = ma.(MethodAccess).getArgument(0) and
    not input instanceof StringLiteral and
    not exists(LocalVariableDecl lvd | 
      lvd.getAnAccess() = input and
      lvd.getInitializer() instanceof StringLiteral
    )
  )
}

from Expr ma
where 
  isDynamicValueExprCreation(ma) or 
  isDynamicMethodExprCreation(ma) or 
  isDynamicConstraintViolation(ma)
select ma, "Potential EL injection vulnerability due to dynamic input in expression evaluation"
