Rule Content:
/**
 * @name EL Injection
 * @description An expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind problem
 * @problem.severity warning
 * @id java/el-injection
 * @tags security
 *   external/cwe/cwe-94
 *   external/owasp/a03
 *   external/cwe-top25
 */

import java

// Case 1: ExpressionFactory.createValueExpression with dynamic input
predicate isDynamicValueExprCreation(MethodAccess ma) {
  exists(Method m, Variable ef, Expr input |
    ma.getMethod().hasName("createValueExpression") and
    ma.getQualifier() = ef and
    ef.getType().hasQualifiedName("javax.el", "ExpressionFactory") and
    input = ma.getArgument(1) and
    not input instanceof StringLiteral and
    not exists(LocalVariableDecl lvd | 
      lvd.getVariable().getAnAccess() = input and
      lvd.getInitializer() instanceof StringLiteral
    )
  )
}

// Case 2: ExpressionFactory.createMethodExpression with dynamic input
predicate isDynamicMethodExprCreation(MethodAccess ma) {
  exists(Method m, Variable ef, Expr input |
    ma.getMethod().hasName("createMethodExpression") and
    ma.getQualifier() = ef and
    ef.getType().hasQualifiedName("javax.el", "ExpressionFactory") and
    input = ma.getArgument(1) and
    not input instanceof StringLiteral and
    not exists(LocalVariableDecl lvd | 
      lvd.getVariable().getAnAccess() = input and
      lvd.getInitializer() instanceof StringLiteral
    )
  )
}

// Case 3: buildConstraintViolationWithTemplate with dynamic input
predicate isDynamicConstraintViolation(MethodAccess ma) {
  exists(Method m, Expr input |
    ma.getMethod().hasName("buildConstraintViolationWithTemplate") and
    input = ma.getArgument(0) and
    not input instanceof StringLiteral and
    not exists(LocalVariableDecl lvd | 
      lvd.getVariable().getAnAccess() = input and
      lvd.getInitializer() instanceof StringLiteral
    )
  )
}

from MethodAccess ma
where 
  isDynamicValueExprCreation(ma) or 
  isDynamicMethodExprCreation(ma) or 
  isDynamicConstraintViolation(ma)
select ma, "Potential EL injection vulnerability due to dynamic input in expression evaluation"
