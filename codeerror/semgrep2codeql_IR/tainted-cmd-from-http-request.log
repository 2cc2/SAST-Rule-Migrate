 * @tags cwe/78
 *       owasp/a01
 *       owasp/a03
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class HttpServletRequestSource extends DataFlow::Node {
  HttpServletRequestSource() {
    exists(Method m, Parameter p |
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      p = m.getAParameter() and
      this.asParameter() = p
    )
    or
    exists(LocalVariableDecl lvd |
      lvd.getType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      this.asExpr() = lvd.getVariable().getAnAccess()
    )
    or
    exists(MethodAccess ma, LocalVariableDecl lvd, ForStmt fs |
      ma.getMethod().getName() = "getCookies" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      lvd.getType().hasQualifiedName("javax.servlet.http", "Cookie[]") and
      lvd.getVariable().getAnAccess() = ma.getQualifier() and
      fs.getInit() = lvd and
      this.asExpr() = fs.getBody().getAChild().(MethodAccess).getQualifier()
    )
  }
}

class CommandSink extends DataFlow::Node {
  CommandSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.asExpr() = cc
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "exec" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      this.asExpr() = ma.getAnArgument(0)
    )
    or
    exists(MethodAccess ma, ConstructorCall cc |
      ma.getMethod().getName() = "add" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.util", "List") and
      cc.getConstructedType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getQualifier().getType() instanceof List and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

