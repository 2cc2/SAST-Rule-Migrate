Rule Content:
/**
 * @name Command Injection in ProcessBuilder
 * @description Detects potentially unsafe ProcessBuilder usage where command arguments
 *              are constructed dynamically, which could lead to command injection.
 * @id command-injection-process-builder
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision medium
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.security.CommandInjectionQuery

class ProcessBuilderCommandInjection extends CommandInjectionQuery {
  ProcessBuilderCommandInjection() {
    this = "ProcessBuilder command injection"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      // Case 1: new ProcessBuilder with dynamic command
      (ma.getMethod().getName() = "ProcessBuilder" and
       ma.getMethod().getDeclaringType().getName() = "ProcessBuilder" and
       not ma.getArgument(0).isCompileTimeConstant() and
       not ma.getArgument(0).(ArrayInit).getAnElement().isCompileTimeConstant() and
       not ma.getArgument(0).(ListInit).getAnElement().isCompileTimeConstant() and
       source.asExpr() = ma.getArgument(0)
      )
      or
      // Case 2: ProcessBuilder.command with dynamic command
      (ma.getMethod().getName() = "command" and
       ma.getMethod().getDeclaringType().getName() = "ProcessBuilder" and
       exists(ConstructorCall cc | cc.getConstructedType().getName() = "ProcessBuilder" |
         DataFlow::localFlow(DataFlow::exprNode(cc), DataFlow::exprNode(ma.getQualifier()))
       ) and
       not ma.getArgument(0).isCompileTimeConstant() and
       not ma.getArgument(0).(ArrayInit).getAnElement().isCompileTimeConstant() and
       not ma.getArgument(0).(ListInit).getAnElement().isCompileTimeConstant() and
       source.asExpr() = ma.getArgument(0)
      )
      or
      // Case 3: Shell command execution patterns
      (ma.getMethod().getName() = "ProcessBuilder" and
       ma.getMethod().getDeclaringType().getName() = "ProcessBuilder" and
       (
         (ma.getArgument(0).isCompileTimeConstant() and
          ma.getArgument(0).toString().matches("%sh|bash|ksh|csh|tcsh|zsh%") and
          ma.getArgument(1).isCompileTimeConstant() and
          ma.getArgument(1).toString() = "-c" and
          not ma.getArgument(2).isCompileTimeConstant() and
          source.asExpr() = ma.getArgument(2)
         )
         or
         (ma.getArgument(0).isCompileTimeConstant() and
          ma.getArgument(0).toString() = "cmd" and
          ma.getArgument(1).isCompileTimeConstant() and
          ma.getArgument(1).toString() = "/c" and
          not ma.getArgument(2).isCompileTimeConstant() and
          source.asExpr() = ma.getArgument(2)
         )
       )
      )
      or
      // Case 4: ProcessBuilder.command shell patterns
      (ma.getMethod().getName() = "command" and
       ma.getMethod().getDeclaringType().getName() = "ProcessBuilder" and
       exists(ConstructorCall cc | cc.getConstructedType().getName() = "ProcessBuilder" |
         DataFlow::localFlow(DataFlow::exprNode(cc), DataFlow::exprNode(ma.getQualifier()))
       ) and
       (
         (ma.getArgument(0).isCompileTimeConstant() and
          ma.getArgument(0).toString().matches("%sh|bash|ksh|csh|tcsh|zsh%") and
          ma.getArgument(1).isCompileTimeConstant() and
          ma.getArgument(1).toString() = "-c" and
          not ma.getArgument(2).isCompileTimeConstant() and
          source.asExpr() = ma.getArgument(2)
         )
         or
         (ma.getArgument(0).isCompileTimeConstant() and
          ma.getArgument(0).toString() = "cmd" and
          ma.getArgument(1).isCompileTimeConstant() and
          ma.getArgument(1).toString() = "/c" and
          not ma.getArgument(2).isCompileTimeConstant() and
          source.asExpr() = ma.getArgument(2)
         )
       )
      )
    )
  }

  override string getAlertMessage(DataFlow::Node source, DataFlow::Node sink) {
    "A formatted or concatenated string was detected as input to a ProcessBuilder call. " +
    "This is dangerous if a variable is controlled by user input and could result in a command injection. " +
    "Ensure your variables are not controlled by users or sufficiently sanitized."
  }
}

from ProcessBuilderCommandInjection pbci, DataFlow::Node source, DataFlow::Node sink
where pbci.hasFlow(source, sink)
select sink, source, pbci.getAlertMessage(source, sink)
