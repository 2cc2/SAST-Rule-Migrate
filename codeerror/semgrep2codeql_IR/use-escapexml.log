/**
 * @name Use of unescaped Expression Language output
 * @description Detected an Expression Language segment that does not escape output. This is dangerous because if any data in this expression can be controlled externally, it is a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id jsp/use-escapexml
 * @tags security
 *       owasp-a03
 *       cwe-116
 * @precision low
 */

import java
import semmle.code.java.StringLiterals

predicate isUnescapedELExpression(StringLiteral str) {
  str.getValue().regexpMatch("\\$\\{(?!.*escapeXml).*\\}")
}

from StringLiteral str
where isUnescapedELExpression(str)
select str, "Found unescaped Expression Language output. Use the 'escapeXml' function from the JSTL taglib to prevent XSS vulnerabilities."
