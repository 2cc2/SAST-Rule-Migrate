/**
 * @name Use of unescaped Expression Language output
 * @description Detected an Expression Language segment that does not escape output. This is dangerous because if any data in this expression can be controlled externally, it is a cross-site scripting vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id jsp/use-escapexml
 * @tags security
 *       owasp-a03
 *       cwe-116
 * @precision low
 */

import java
import JSP

predicate isUnescapedELExpression(ELExpression expr) {
  not exists(MethodAccess ma |
    ma.getMethod().getName() = "escapeXml" and
    ma.getEnclosingCallable() = expr.getEnclosingCallable()
  )
}

from ELExpression expr
where isUnescapedELExpression(expr)
select expr, "Found unescaped Expression Language output. Use the 'escapeXml' function from the JSTL taglib to prevent XSS vulnerabilities."
