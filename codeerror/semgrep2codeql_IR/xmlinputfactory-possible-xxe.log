/**
 * @name XMLInputFactory XXE Vulnerability
 * @description XML external entities are not explicitly disabled for this XMLInputFactory.
 *              This could be vulnerable to XML external entity vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/xmlinputfactory-possible-xxe
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04
 *       external/owasp/a05
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class XMLInputFactoryCreation extends DataFlow::Node {
  XMLInputFactoryCreation() {
    exists(MethodAccess ma |
      (ma.getCallee().getName() = "newFactory" and
       ma.getCallee().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")) or
      exists(ConstructorCall cc |
        cc.getConstructedType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
        this.asExpr() = cc
      )
    )
  }
}

class SafeXMLInputFactory extends DataFlow::Node {
  SafeXMLInputFactory() {
    exists(MethodAccess ma |
      ma.getCallee().getName() = "setProperty" and
      ma.getCallee().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
      (
        (ma.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" or
         ma.getArgument(0).(FieldAccess).getTarget().getName() = "IS_SUPPORTING_EXTERNAL_ENTITIES") and
        (ma.getArgument(1).(BooleanLiteral).getValue() = false or
         ma.getArgument(1).(FieldAccess).getTarget().getName() = "FALSE")
      ) and
      this.asExpr() = ma.getQualifier()
    )
  }
}

class XMLInputFactoryTaintConfig extends TaintTracking::Configuration {
  XMLInputFactoryTaintConfig() { this = "XMLInputFactoryTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof XMLInputFactoryCreation }

  override predicate isSink(DataFlow::Node sink) { not sink instanceof SafeXMLInputFactory }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

