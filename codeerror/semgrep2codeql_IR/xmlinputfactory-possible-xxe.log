import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class XMLInputFactoryCreation extends DataFlow::Node {
  XMLInputFactoryCreation() {
    exists(MethodAccess ma |
      (ma.getCallee().getName() = "newFactory" and
       ma.getCallee().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")) or
      exists(ConstructorCall cc |
        cc.getConstructedType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
        this.asExpr() = cc
      )
    )
  }
}

class SafeXMLInputFactoryConfig extends DataFlow::Node {
  SafeXMLInputFactoryConfig() {
    exists(MethodAccess ma |
      ma.getCallee().getName() = "setProperty" and
      (ma.getAnArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" or
       ma.getAnArgument(0).toString() = "XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES") and
      (ma.getAnArgument(1).toString() = "false" or
