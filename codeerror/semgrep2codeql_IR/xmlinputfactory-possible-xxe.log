/**
 * @name XMLInputFactory XXE Vulnerability
 * @description XMLInputFactory instances should explicitly disable external entities to prevent XXE attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id java/xmlinputfactory-possible-xxe
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04
 *       external/owasp/a05
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class XMLInputFactoryCreation extends DataFlow::Node {
  XMLInputFactoryCreation() {
    exists(MethodAccess ma |
      (ma.getCallee().getName() = "newFactory" and
       ma.getCallee().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory")) or
      exists(ConstructorCall cc |
        cc.getConstructedType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
        this.asExpr() = cc
      )
    )
  }
}

class SafeXMLInputFactoryConfig extends DataFlow::Node {
  SafeXMLInputFactoryConfig() {
    exists(MethodAccess ma |
      ma.getCallee().getName() = "setProperty" and
      (ma.getAnArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities" or
       ma.getAnArgument(0).toString() = "XMLInputFactory.IS_SUPPORTING_EXTERNAL_ENTITIES") and
      (ma.getAnArgument(1).toString() = "false" or
       ma.getAnArgument(1).toString() = "Boolean.FALSE") and
      this.asExpr() = ma.getQualifier()
    )
  }
}

class XMLInputFactoryTaintConfig extends TaintTracking::Configuration {
  XMLInputFactoryTaintConfig() { this = "XMLInputFactoryTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof XMLInputFactoryCreation }

  override predicate isSink(DataFlow::Node sink) { 
    not exists(SafeXMLInputFactoryConfig safe | DataFlow::localFlow(safe, sink))
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

