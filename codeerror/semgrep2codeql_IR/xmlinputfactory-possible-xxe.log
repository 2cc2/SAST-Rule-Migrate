select sink.getNode(), source, sink, "XML external entities are not explicitly disabled for this XMLInputFactory. This could be vulnerable to XML external entity vulnerabilities. Explicitly disable external entities by setting 'javax.xml.stream.isSupportingExternalEntities' to false."
