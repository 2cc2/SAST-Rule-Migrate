import semmle.code.java.dataflow.FlowSources

predicate isXMLInputFactoryCreation(Expr e) {
  exists(MethodAccess ma |
    ma.getMethod().getName() = "newFactory" and
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
