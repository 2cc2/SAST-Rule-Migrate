/**
 * @name JPA SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/jpa-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 *       external/cwe2021-top25
 *       external/cwe2022-top25
 *       technology/jpa
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

predicate isJpaMethod(Method m) {
  m.getName() in ["createQuery", "createNativeQuery"] and
  m.getDeclaringType().getASupertype*().hasQualifiedName("javax.persistence", "EntityManager")
}

predicate isStringConcatenation(Expr e) {
  exists(BinaryExpr add | add = e and add.getOp() = ADD |
    not (add.getLeftOperand() instanceof StringLiteral and add.getRightOperand() instanceof StringLiteral)
  )
  or
  exists(MethodAccess format | format = e |
    format.getMethod().getName() = "format" and format.getQualifier().getType().hasName("java.lang.String")
  )
}

from MethodAccess ma, Expr sqlArg
where
  isJpaMethod(ma.getMethod()) and
  (
    sqlArg = ma.getArgument(0) and isStringConcatenation(sqlArg)
    or
    exists(MethodAccess nestedMa |
      nestedMa = sqlArg and isJpaMethod(nestedMa.getMethod()) and isStringConcatenation(nestedMa.getArgument(0))
    )
  ) and
  not (ma.getArgument(0) instanceof StringLiteral)
select ma, "Detected a formatted string in a SQL statement. This could lead to SQL injection. Use prepared statements instead."
