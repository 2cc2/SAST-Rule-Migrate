/**
 * @name CRLF Injection in Logs
 * @description When data from an untrusted source is put into a logger and not neutralized correctly,
 *              an attacker could forge log entries or include malicious content.
 * @kind path-problem
 * @problem.severity warning
 * @id java/crlf-injection-logs
 * @tags security
 *       vulnerability
 *       injection
 *       owasp-a03
 *       cwe-93
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class LoggerCall extends Expr {
  LoggerCall() {
    exists(Method m | 
      this.(MethodAccess).getMethod() = m and
      m.hasName(["info", "warn", "error", "debug", "log"]) and
      m.getDeclaringType().getASupertype*().hasQualifiedName("org.slf4j", "Logger")
    )
  }
}

class HttpRequestParameterSource extends RemoteFlowSource {
  HttpRequestParameterSource() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName(["javax.servlet.http.HttpServletRequest", "javax.servlet.ServletRequest"]) and
      m.hasName("getParameter") and
      this.asExpr() = m.getACall()
    )
  }

  override predicate getSourceType() { this instanceof HttpRequestParameterSource }
}

class CRLFInjectionLogsConfig extends TaintTracking::Configuration {
  CRLFInjectionLogsConfig() { this = "CRLFInjectionLogsConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpRequestParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(LoggerCall logCall |
      sink.asExpr() = logCall.getAnArgument()
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    none()
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, CRLFInjectionLogsConfig cfg
where cfg.hasFlowPath(source, sink)
select sink, "Potential CRLF injection vulnerability in log statement from untrusted source", source,
  "This log entry contains data from $@ which may allow an attacker to inject malicious log entries.",
  source.getNode(), "untrusted source"
