/**
 * @name Hardcoded JWT Secret
 * @description Detects hard-coded credentials used in JWT algorithms.
 * @kind problem
 * @problem.severity warning
 * @id java/jwt/hardcoded-secret
 * @tags security
 *   - cwe/798
 *   - owasp/a07
 *   - external/cwe/cwe-2021-top25
 *   - external/cwe/cwe-2022-top25
 */

import java

// Pattern 1: Direct HMAC algorithm initialization with string literal
from MethodAccess algoCall, StringLiteral secret, Method algoMethod
where
  algoCall.getMethod() = algoMethod and
  algoMethod.getName().matches("HMAC256|HMAC384|HMAC512") and
  algoCall.getAnArgument() = secret
select secret, "A hard-coded credential was detected in JWT algorithm initialization."

// Pattern 2: Variable assignment then used in HMAC algorithm
from Variable secretVar, StringLiteral secretInit, MethodAccess algoCall, Method algoMethod
where
  secretVar.getAnInitializer() = secretInit and
  algoCall.getMethod() = algoMethod and
  algoMethod.getName().matches("HMAC256|HMAC384|HMAC512") and
  algoCall.getAnArgument() = secretVar.getAnAccess()
select secretInit, "A hard-coded credential was detected in JWT algorithm initialization."

// Pattern 3: Class field assignment then used in HMAC algorithm
from Field secretField, StringLiteral secretInit, MethodAccess algoCall, Method algoMethod
where
  secretField.getAnInitializer() = secretInit and
  algoCall.getMethod() = algoMethod and
  algoMethod.getName().matches("HMAC256|HMAC384|HMAC512") and
  algoCall.getAnArgument() = secretField.getAnAccess()
select secretInit, "A hard-coded credential was detected in JWT algorithm initialization."
