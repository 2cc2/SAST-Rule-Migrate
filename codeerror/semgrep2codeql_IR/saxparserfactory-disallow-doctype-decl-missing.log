/**
 * @name SAXParserFactory disallow doctype decl missing
 * @description DOCTYPE declarations are enabled for this SAXParserFactory. This is vulnerable to XML external entity attacks. 
 *              Disable this by setting the feature `http://apache.org/xml/features/disallow-doctype-decl` to true. 
 *              Alternatively, allow DOCTYPE declarations and only prohibit external entities declarations.
 * @kind path-problem
 * @problem.severity error
 * @id java/saxparserfactory-disallow-doctype-decl-missing
 * @tags security
 *       external/cwe/cwe-611
 *       owasp-a04:2017
 *       owasp-a05:2021
 *       asvs.4.0:V5.5.2
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class SAXParserFactoryCreation extends DataFlow::Node {
  SAXParserFactoryCreation() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("newInstance") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      this.asExpr() = ma
    )
  }
}

class UnsafeSAXParserCreation extends DataFlow::Node {
  UnsafeSAXParserCreation() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("newSAXParser") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      this.asExpr() = ma
    )
  }
}

class SafeFeatureSetting extends DataFlow::Node {
  SafeFeatureSetting() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("setFeature") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "SAXParserFactory") and
      (
        ma.getArgument(0).(StringLiteral).getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
        ma.getArgument(1).(BooleanLiteral).getValue() = true
        or
        ma.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-general-entities" and
        ma.getArgument(1).(BooleanLiteral).getValue() = false
      ) and
      this.asExpr() = ma.getQualifier()
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "SAXParserFactory XXE Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SAXParserFactoryCreation and
    not exists(SafeFeatureSetting safe | safe.flowsTo(source))
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnsafeSAXParserCreation
  }
}

from Config cfg, DataFlow::Node source, DataFlow::Node sink
