select sink, "Vulnerable SAXParserFactory creation with DOCTYPE declarations enabled. " +
       "This is vulnerable to XML external entity attacks. Disable this by setting the feature " +
       "`http://apache.org/xml/features/disallow-doctype-decl` to true."
