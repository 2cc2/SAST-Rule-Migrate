/**
 * @name DESede is deprecated
 * @description Triple DES (3DES or DESede) is considered deprecated. AES is the recommended cipher. Upgrade to use AES.
 * @kind problem
 * @problem.severity warning
 * @id java/desede-is-deprecated
 * @tags security
 *       vulnerability
 *       cwe/326
 *       owasp/a03:2017
 *       owasp/a02:2021
 *       external/cwe/cwe-326
 * @precision high
 */

import java

// Pattern 1: Detect Cipher.getInstance() with DESede algorithm
from MethodAccess ma, string algo
where 
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
  algo = ma.getArgument(0).(Literal).getValue() and
  algo.matches("DESede.*")
select ma, "Triple DES (3DES or DESede) is considered deprecated. AES is the recommended cipher."

// Pattern 2: Detect KeyGenerator.getInstance() with DES algorithm
from MethodAccess ma, string algo
where 
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "KeyGenerator") and
  algo = ma.getArgument(0).(Literal).getValue() and
  algo = "DES"
select ma, "Triple DES (3DES or DESede) is considered deprecated. AES is the recommended cipher."
