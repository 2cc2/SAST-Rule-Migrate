Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/cwe/cwe-943
 *       external/owasp/a01
 *       external/owasp/a03
 */
import java
import semmle.code.java.StringFormat
import semmle.code.java.StringConcatenation
import semmle.code.java.dataflow.FlowSources

predicate isJdoQueryMethod(MethodAccess ma) {
  ma.getMethod().getName() = "setFilter" or
  ma.getMethod().getName() = "setGrouping"
}

predicate isJdoPersistenceManagerNewQuery(MethodAccess ma) {
  ma.getMethod().getName() = "newQuery" and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager")
}

predicate isStringFormatOrConcat(Expr e) {
  exists(StringFormatOperation sfo | e = sfo) or
  exists(StringConcatenation sc | e = sc)
}

from MethodAccess ma, Expr sqlArg
where
  (
    (isJdoQueryMethod(ma) and sqlArg = ma.getArgument(0)) or
    (isJdoPersistenceManagerNewQuery(ma) and exists(int i | sqlArg = ma.getArgument(i)))
  ) and
  isStringFormatOrConcat(sqlArg) and
  not exists(StringConcatenation sc | sc = sqlArg | sc.getLeftOperand().isStringLiteral() and sc.getRightOperand().isStringLiteral())
select ma, "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead."
