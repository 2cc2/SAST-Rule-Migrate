Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 */
import java
import semmle.code.java.StringFormat
import semmle.code.java.Concat

predicate isJdoQueryMethod(Method m) {
  m.getName() = "setFilter" or
  m.getName() = "setGrouping"
}

predicate isJdoPersistenceManagerNewQuery(Method m) {
  m.getName() = "newQuery" and
  m.getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager")
}

predicate isStringFormatOrConcat(Expr e) {
  exists(MethodAccess ma | 
    ma.getMethod().getName() = "format" and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
    e = ma
  )
  or
  exists(AddExpr ae | e = ae)
}

from MethodAccess ma, Expr sqlArg
where
  (
    (isJdoQueryMethod(ma.getMethod()) and sqlArg = ma.getArgument(0)) or
    (isJdoPersistenceManagerNewQuery(ma.getMethod()) and exists(int i | sqlArg = ma.getArgument(i)))
  ) and
  isStringFormatOrConcat(sqlArg) and
  not exists(AddExpr ae | 
    ae = sqlArg and
    ae.getLeftOperand().(StringLiteral).getValue() != "" and
    ae.getRightOperand().(StringLiteral).getValue() != ""
  )
select ma, "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead."
