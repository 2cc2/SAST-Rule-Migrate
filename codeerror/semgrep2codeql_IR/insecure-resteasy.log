/**
 * @name Insecure RESTEasy Deserialization
 * @description Detects endpoints using wildcard media type in @Consumes annotation,
 *              which could lead to deserialization vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08:2017
 *       external/owasp/a08:2021
 */

import java
import semmle.code.java.frameworks.jaxrs.JaxRs

class WildcardConsumesAnnotation extends Annotation {
  WildcardConsumesAnnotation() {
    exists(Method m | 
      this = m.getAnAnnotation() and
      this.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      (
        this.getValue().toString() = "\"*/*\"" or
        this.getValue().toString() = "{\"*/*\"}" or
        this.getValue().toString() = "{\"application/x-java-serialized-object\"}" or
        exists(Expr e | 
          e = this.getValue() and
          e.toString() = "MediaType.WILDCARD_TYPE"
        )
      )
    )
  }
}

from Method m, WildcardConsumesAnnotation ann
where ann = m.getAnAnnotation()
select ann, "Endpoint uses wildcard media type in @Consumes annotation, which could lead to deserialization vulnerabilities"

/**
 * @name Default RESTEasy Provider Abuse
 * @description Detects endpoints missing @Consumes annotation,
 *              which could lead to deserialization vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/default-resteasy-provider-abuse
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08:2017
 *       external/owasp/a08:2021
 */

import java
import semmle.code.java.frameworks.jaxrs.JaxRs

class MissingConsumesMethod extends Method {
  MissingConsumesMethod() {
    exists(PathAnnotation path | 
      path = this.getAnAnnotation() and
      not exists(ConsumesAnnotation consumes | consumes = this.getAnAnnotation())
    ) and
    not exists(Class c | 
      this.getDeclaringType() = c and
      exists(ConsumesAnnotation classConsumes | classConsumes = c.getAnAnnotation())
    )
  }
}

from MissingConsumesMethod m
select m, "Endpoint is missing @Consumes annotation, which could lead to deserialization vulnerabilities"
