/**
 * @name Insecure RESTEasy Deserialization
 * @description When a Restful webservice endpoint is configured to use wildcard mediaType {*/*} as a value for the @Consumes annotation,
 *              an attacker could abuse the SerializableProvider by sending a HTTP Request with a Content-Type of 
 *              application/x-java-serialized-object. The body of that request would be processed by the SerializationProvider and 
 *              could contain a malicious payload, which may lead to arbitrary code execution when calling the $Y.getObject method.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       cwe/502
 *       owasp-a08:2017
 *       owasp-a08:2021
 */
import java

from Annotation ann, Method m
where 
  (ann.toString().matches("@Consumes(\"*/*\")") or
   ann.toString().matches("@Consumes({\"*/*\"})") or
   ann.toString().matches("@Consumes({MediaType.WILDCARD_TYPE})") or
   ann.toString().matches("@Consumes({\"application/x-java-serialized-object\"})")) and
  m.getAnAnnotation() = ann
select ann, "Potential insecure deserialization vulnerability due to wildcard or unsafe media type in @Consumes annotation"

/**
 * @name Default RESTEasy Provider Abuse
 * @description When a Restful webservice endpoint isn't configured with a @Consumes annotation, an attacker could abuse the 
 *              SerializableProvider by sending a HTTP Request with a Content-Type of application/x-java-serialized-object.
 *              The body of that request would be processed by the SerializationProvider and could contain a malicious payload,
 *              which may lead to arbitrary code execution. Instead, add a @Consumes annotation to the function or class.
 * @kind problem
 * @problem.severity warning
 * @id java/default-resteasy-provider-abuse
 * @tags security
 *       cwe/502
 *       owasp-a08:2017
 *       owasp-a08:2021
 */
import java

from Method m, Class c
where 
  exists(Annotation a | a = m.getAnAnnotation() | a.toString().matches("@Path(\".*\")")) and
  not exists(Annotation a | a = m.getAnAnnotation() | a.toString().matches("@Consumes(.*)")) and
  not exists(Annotation a | a = c.getAnAnnotation() | a.toString().matches("@Consumes(.*)")) and
  not exists(Annotation a | a = m.getAnAnnotation() | a.toString().matches("@GET"))
