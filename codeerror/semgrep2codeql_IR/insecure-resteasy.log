Rule Content:
/**
 * @name Insecure deserialization in Resteasy
 * @description Detects insecure deserialization in Resteasy due to wildcard mediaType or missing @Consumes annotation
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08
 */

import java
import JAXRS

// Pattern 1: Wildcard consumes
class WildcardConsumes extends Annotation {
  WildcardConsumes() {
    exists(AnnotationValue v |
      this.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      (
        v = this.getAValue() and
        (
          v.toString() = "\"application/x-java-serialized-object\"" or
          v.toString() = "\"*/*\"" or
          v.toString() = "MediaType.WILDCARD_TYPE"
        )
      )
    )
  }
}

// Pattern 2: Missing consumes
class MissingConsumes extends Method {
  MissingConsumes() {
    exists(Annotation path |
      path.getType().hasQualifiedName("javax.ws.rs", "Path") and
      this.getAnAnnotation() = path and
      not exists(Annotation consumes |
        consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
        this.getAnAnnotation() = consumes
      ) and
      not exists(Annotation consumes |
        consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
        this.getDeclaringType().getAnAnnotation() = consumes
      ) and
      not this.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "GET")
    )
  }
}

from WildcardConsumes wc
select wc, "Insecure deserialization in Resteasy due to wildcard mediaType"

from MissingConsumes mc
select mc, "Insecure deserialization in Resteasy due to missing @Consumes annotation"
