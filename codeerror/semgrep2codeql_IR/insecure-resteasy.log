/**
 * @name Insecure deserialization in Resteasy
 * @description Detected insecure deserialization in Resteasy due to wildcard mediaType or missing @Consumes annotation
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08:2017
 *       external/owasp/a08:2021
 */

import java
import semmle.code.java.frameworks.jaxrs.JAXRS

class WildcardConsumes extends Annotation {
  WildcardConsumes() {
    this.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
    (
      this.getAValue().toString() = "\"application/x-java-serialized-object\"" or
      this.getAValue().toString() = "\"*/*\"" or
      this.getAValue().toString() = "MediaType.WILDCARD_TYPE"
    )
  }
}

class MissingConsumesMethod extends Method {
  MissingConsumesMethod() {
    exists(Annotation path | 
      path.getType().hasQualifiedName("javax.ws.rs", "Path") and
      path.getParent() = this
    ) and
    not exists(Annotation consumes | 
      consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      consumes.getParent() = this
    ) and
    not exists(Annotation get | 
      get.getType().hasQualifiedName("javax.ws.rs", "GET") and
      get.getParent() = this
    )
  }
}

class MissingConsumesClass extends Class {
  MissingConsumesClass() {
    exists(Method m | 
      m instanceof MissingConsumesMethod and
      m.getDeclaringType() = this
    ) and
    not exists(Annotation consumes | 
      consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      consumes.getParent() = this
    )
  }
}

from WildcardConsumes wc
select wc, "Insecure deserialization in Resteasy due to wildcard mediaType in @Consumes annotation"

from MissingConsumesMethod mcm
select mcm, "Insecure deserialization in Resteasy due to missing @Consumes annotation on method"

from MissingConsumesClass mcc
select mcc, "Insecure deserialization in Resteasy due to missing @Consumes annotation on class"
