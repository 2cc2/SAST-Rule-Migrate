Rule Content:
/**
 * @name Insecure deserialization in Resteasy
 * @description Detected insecure deserialization in Resteasy due to wildcard mediaType or missing @Consumes annotation
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.resteasy.Resteasy

class ResteasySource extends DataFlow::Node {
  ResteasySource() {
    exists(Method m |
      m.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      (
        m.getAnAnnotation().getValue("value").toString() = "\"application/x-java-serialized-object\"" or
        m.getAnAnnotation().getValue("value").toString() = "\"*/*\"" or
        m.getAnAnnotation().getValue("value").toString() = "MediaType.WILDCARD_TYPE"
      ) and
      Resteasy::isResteasyEndpoint(m) and
      this.asExpr() = m.getAnAnnotation()
    )
  }
}

class SerializationSink extends DataFlow::Node {
  SerializationSink() {
    exists(MethodAccess ma |
      Resteasy::isSerializationProviderCall(ma) and
      this.asExpr() = ma
    )
  }
}

class MissingConsumesAnnotation extends DataFlow::Node {
  MissingConsumesAnnotation() {
    exists(Method m |
      not exists(Annotation a |
        a.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
        a.getParent() = m
      ) and
      Resteasy::isResteasyEndpoint(m) and
      this.asExpr() = m
    )
  }
}

class DeserializationTaintConfig extends TaintTracking::Configuration {
  DeserializationTaintConfig() { this = "DeserializationTaintConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof ResteasySource or
    source instanceof MissingConsumesAnnotation
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof SerializationSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }

  override predicate isForbidden(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Method m |
      m.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      node1.asExpr() = m.getAnAnnotation() and
      node2.asExpr().(MethodAccess).getMethod() = m
    )
  }
}

from DeserializationTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  if source.getNode() instanceof MissingConsumesAnnotation
  then "Missing @Consumes annotation makes endpoint vulnerable to serialization attacks"
  else "Insecure deserialization in Resteasy due to wildcard mediaType"
