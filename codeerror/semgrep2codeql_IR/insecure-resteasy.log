/**
 * @name Insecure RESTEasy Deserialization
 * @description Detects endpoints using wildcard media type or application/x-java-serialized-object in @Consumes annotation,
 *              which could lead to deserialization vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class InsecureConsumesAnnotation extends Annotation {
  InsecureConsumesAnnotation() {
    this.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
    (
      exists(StringLiteral sl | 
        sl = this.getAnArgument() and
        (sl.getValue() = "*/*" or sl.getValue() = "application/x-java-serialized-object")
      )
      or
      exists(MethodAccess ma |
        ma.getCallee().getName() = "WILDCARD_TYPE" and
        ma.getCallee().getDeclaringType().hasQualifiedName("javax.ws.rs.core", "MediaType") and
        ma = this.getAnArgument()
      )
    )
  }
}

class InsecureEndpoint extends Method {
  InsecureEndpoint() {
    exists(InsecureConsumesAnnotation ica | ica.getAnnotatedElement() = this)
  }
}

