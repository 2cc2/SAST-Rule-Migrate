/**
 * @name Insecure Resteasy Deserialization
 * @description Detects endpoints using wildcard media type in @Consumes annotation,
 *              which could lead to deserialization vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class InsecureConsumesAnnotation extends Annotation {
  InsecureConsumesAnnotation() {
    this.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
    (
      this.getAValue().toString() = "\"*/*\"" or
      this.getAValue().toString() = "\"application/x-java-serialized-object\"" or
      exists(Expr e | e = this.getAValue() | e.toString() = "MediaType.WILDCARD_TYPE")
    )
  }
}

class InsecureEndpoint extends Method {
  InsecureEndpoint() {
    exists(InsecureConsumesAnnotation a | a.getAnnotatedElement() = this)
  }
}

from InsecureEndpoint endpoint
select endpoint, "This endpoint uses insecure @Consumes annotation which could lead to deserialization vulnerabilities"

/**
 * @name Default Resteasy Provider Abuse
 * @description Detects endpoints missing @Consumes annotation,
 *              which could lead to deserialization vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/default-resteasy-provider-abuse
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08
 */

import java

class PathAnnotation extends Annotation {
  PathAnnotation() {
    this.getType().hasQualifiedName("javax.ws.rs", "Path")
  }
}

class MissingConsumesEndpoint extends Method {
  MissingConsumesEndpoint() {
    exists(PathAnnotation p | p.getAnnotatedElement() = this) and
    not exists(Annotation a |
      a.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      a.getAnnotatedElement() = this
    ) and
    not exists(Annotation a |
      a.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      a.getAnnotatedElement() = this.getDeclaringType()
    ) and
    not this.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "GET")
  }
}

from MissingConsumesEndpoint endpoint
select endpoint, "This endpoint is missing @Consumes annotation which could lead to deserialization vulnerabilities"
