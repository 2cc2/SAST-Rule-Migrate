Rule Content:
/**
 * @name Insecure Resteasy Deserialization
 * @description Detects when a Restful webservice endpoint is configured to use wildcard mediaType (*/*) as a value for the @Consumes annotation, which could lead to unsafe deserialization.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08:2017
 *       external/owasp/a08:2021
 */

import java

from Annotation consumes, Method m
where 
  (consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
   (
     exists(consumes.getValue().getAChild() |
       (
         exists(StringLiteral sl | 
           sl = consumes.getValue().getAChild() and
           (sl.getValue() = "*/*" or sl.getValue() = "application/x-java-serialized-object")
         )
         or
         exists(FieldAccess fa |
           fa = consumes.getValue().getAChild() and
           fa.getField().getName() = "WILDCARD_TYPE" and
           fa.getField().getDeclaringType().hasQualifiedName("javax.ws.rs.core", "MediaType")
         )
       )
     )
   ) and
   m.getAnAnnotation() = consumes
)
select consumes, "Unsafe @Consumes annotation allows potential deserialization attacks (" + consumes + ")"

/**
 * @name Default Resteasy Provider Abuse
 * @description Detects when a Restful webservice endpoint isn't configured with a @Consumes annotation, which could allow unsafe deserialization.
 * @kind problem
 * @problem.severity warning
 * @id java/default-resteasy-provider-abuse
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08:2017
 *       external/owasp/a08:2021
 */

import java

from Method m, Annotation path
where
  path.getType().hasQualifiedName("javax.ws.rs", "Path") and
  m.getAnAnnotation() = path and
  not exists(
    Annotation consumes |
    consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
    (consumes.getParent() = m or exists(consumes.getParent() = m.getDeclaringType()))
  ) and
  not (
    m instanceof Constructor and
    from m.getDeclaringType().getAnAnnotation() a
    where a.getType().hasQualifiedName("javax.ws.rs", "Consumes")
    select a
  )
select m, "Missing @Consumes annotation on REST endpoint makes it vulnerable to deserialization attacks (" + m + ")"
