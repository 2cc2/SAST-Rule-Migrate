/**
 * @name Insecure Resteasy Deserialization
 * @description Detects endpoints using wildcard media type in @Consumes annotation,
 *              which could lead to deserialization vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08
 */

import java
import semmle.code.java.frameworks.jaxrs.JaxRs

class InsecureConsumesAnnotation extends Annotation {
  InsecureConsumesAnnotation() {
    this.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
    (
      this.getAValue().toString() = "\"*/*\"" or
      this.getAValue().toString() = "\"application/x-java-serialized-object\"" or
      exists(FieldAccess fa |
        fa.getField().getName() = "WILDCARD_TYPE" and
        fa.getField().getDeclaringType().hasQualifiedName("javax.ws.rs.core", "MediaType") and
        this.getAValue() = fa
      )
    )
  }
}

from Method m, InsecureConsumesAnnotation consumes
where consumes.getParent() = m
select m, "This endpoint uses an insecure @Consumes annotation that could lead to deserialization vulnerabilities"

/**
 * @name Default Resteasy Provider Abuse
 * @description Detects endpoints missing @Consumes annotation,
 *              which could be abused for deserialization attacks.
 * @kind path-problem
 * @problem.severity warning
 * @id java/default-resteasy-provider-abuse
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08
 */

import java
import semmle.code.java.frameworks.jaxrs.JaxRs

class JaxRsEndpoint extends Method {
  JaxRsEndpoint() {
    exists(Annotation path | path.getParent() = this) and
    not exists(Annotation consumes | 
      consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      consumes.getParent() = this
    ) and
    not exists(Annotation consumes | 
      consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
      consumes.getParent().(Class).getAMethod() = this
    )
  }
}

from JaxRsEndpoint endpoint
select endpoint, "This JAX-RS endpoint is missing @Consumes annotation, making it vulnerable to deserialization attacks"
