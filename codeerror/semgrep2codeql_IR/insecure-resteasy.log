/**
 * @name Insecure deserialization in Resteasy
 * @description Detected insecure deserialization in Resteasy due to wildcard mediaType or missing @Consumes annotation
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-resteasy-deserialization
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08
 */

import java
import semmle.code.java.frameworks.jaxrs.JaxRsClasses

predicate wildcardConsumes(Method m) {
  exists(Annotation a |
    a = m.getAnAnnotation() and
    a.getType().hasQualifiedName("javax.ws.rs", "Consumes") and
    (
      a.getValue().toString() = "\"*/*\"" or
      a.getValue().toString() = "\"application/x-java-serialized-object\"" or
      a.getValue().toString() = "{\"*/*\"}" or
      a.getValue().toString() = "{\"application/x-java-serialized-object\"}" or
      a.getValue().toString() = "{MediaType.WILDCARD_TYPE}"
    )
  )
}

predicate missingConsumes(Method m) {
  exists(Annotation path |
    path = m.getAnAnnotation() and
    path.getType().hasQualifiedName("javax.ws.rs", "Path") and
    not exists(Annotation get | 
      get = m.getAnAnnotation() and 
      get.getType().hasQualifiedName("javax.ws.rs", "GET")
    ) and
    not exists(Annotation consumes |
      consumes = m.getAnAnnotation() and
      consumes.getType().hasQualifiedName("javax.ws.rs", "Consumes")
    ) and
    not exists(Annotation classConsumes |
      classConsumes = m.getDeclaringType().getAnAnnotation() and
      classConsumes.getType().hasQualifiedName("javax.ws.rs", "Consumes")
    )
  )
}

from Method m
where wildcardConsumes(m) or missingConsumes(m)
select m, "Insecure deserialization in Resteasy due to wildcard mediaType or missing @Consumes annotation"
