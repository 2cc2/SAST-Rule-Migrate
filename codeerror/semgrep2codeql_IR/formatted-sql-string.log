Rule Content:
/**
 * @name Formatted SQL string
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead. You can obtain a PreparedStatement using 'connection.prepareStatement'.
 * @kind path-problem
 * @problem.severity error
 * @id java/formatted-sql-string
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.SQL

class FormattedSqlStringConfig extends TaintTracking::Configuration {
  FormattedSqlStringConfig() { this = "FormattedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodParameter p |
      p.getType().hasName("String") and
      (
        exists(Method m | m.getParameter(0).getType().hasName("HttpServletRequest") and p = m.getParameter(0)) or
        p.getAnnotatedType().getAnAnnotation() != none and
        p.getCallable().getDeclaringType().getAnAnnotation() != none
      ) and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName(
        "java.sql.Statement", "execute") or
      ma.getMethod().hasQualifiedName(
        "java.sql.Statement", "executeQuery") or
      ma.getMethod().hasQualifiedName(
        "java.sql.PreparedStatement", "execute") or
      ma.getMethod().hasQualifiedName(
        "java.sql.PreparedStatement", "executeQuery") or
      ma.getMethod().hasQualifiedName(
        "javax.persistence.EntityManager", "createQuery") or
      ma.getMethod().hasQualifiedName(
        "javax.persistence.EntityManager", "query") or
      ma.getMethod().hasQualifiedName(
        "java.sql.Statement", "addBatch") or
      ma.getMethod().hasQualifiedName(
        "java.sql.Connection", "nativeSQL") or
      ma.getMethod().hasQualifiedName(
        "java.sql.Connection", "create") or
      ma.getMethod().hasQualifiedName(
        "java.sql.Connection", "prepare")
      and
      not (
        ma.getArgument(0).(StringLiteral).getValue().matches("%TABLE *%") or
        ma.getArgument(0).(StringLiteral).getValue().matches("%TABLE %s%")
      )
      and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.persistence.criteria.CriteriaBuilder") and
      sanitizer.asExpr() = ma
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringBufferAppend sa | sa.getAnArgument() = pred.asExpr() | succ.asExpr() = sa) or
    exists(StringBuilderAppend sa | sa.getAnArgument() = pred.asExpr() | succ.asExpr() = sa) or
    exists(AddExpr ae | ae.getAnOperand() = pred.asExpr() | succ.asExpr() = ae) or
    exists(AssignAddExpr aae | aae.getLeftOperand() = pred.asExpr() | succ.asExpr() = aae) or
    exists(StringFormat sf | sf.getAnArgument() = pred.asExpr() | succ.asExpr() = sf) or
    exists(StringJoin sj | sj.getAnArgument() = pred.asExpr() | succ.asExpr() = sj) or
    exists(StringConcat sc | sc.getAnOperand() = pred.asExpr() | succ.asExpr() = sc) or
    exists(ConstructorCall cc |
      cc.getConstructedType().hasName("StringBuffer", "StringBuilder") and
      cc.getAnArgument() = pred.asExpr() |
      succ.asExpr() = cc
    )
  }
}

from FormattedSqlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
