Rule Content:
/**
 * @name Formatted SQL string
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 * @id java/formatted-sql-string
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.SQL

class FormattedSqlStringConfig extends TaintTracking::Configuration {
  FormattedSqlStringConfig() { this = "FormattedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p |
      p.getType().hasName("String") and
      (
        (m.getParameter(0).getType().hasName("HttpServletRequest") and p = m.getParameter(0)) or
        (p.getAnnotatedType().getAnAnnotation() != none and
         p.getCallable().getDeclaringType().getAnAnnotation() != none)
      ) and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (ma.getMethod().hasQualifiedName("java.sql.Statement", "execute") or
       ma.getMethod().hasQualifiedName("java.sql.Statement", "executeQuery") or
       ma.getMethod().hasQualifiedName("java.sql.PreparedStatement", "execute") or
       ma.getMethod().hasQualifiedName("java.sql.PreparedStatement", "executeQuery") or
       ma.getMethod().hasQualifiedName("javax.persistence.EntityManager", "createQuery") or
       ma.getMethod().hasQualifiedName("javax.persistence.EntityManager", "query") or
       ma.getMethod().hasQualifiedName("java.sql.Statement", "addBatch") or
       ma.getMethod().hasQualifiedName("java.sql.Connection", "nativeSQL") or
       ma.getMethod().hasQualifiedName("java.sql.Connection", "create") or
       ma.getMethod().hasQualifiedName("java.sql.Connection", "prepare")) and
      not (ma.getArgument(0).toString().matches("%TABLE *%") or
           ma.getArgument(0).toString().matches("%TABLE %s%")) and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.persistence.criteria", "CriteriaBuilder") and
      sanitizer.asExpr() = ma
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "append" and
      (ma.getMethod().getDeclaringType().hasName("StringBuffer") or
       ma.getMethod().getDeclaringType().hasName("StringBuilder")) and
      ma.getArgument(0) = pred.asExpr() and
      succ.asExpr() = ma
    )
    or
    exists(BinaryExpr be |
      be.getOp() = "+" and
      (be.getLeftOperand() = pred.asExpr() or be.getRightOperand() = pred.asExpr()) and
      succ.asExpr() = be
    )
    or
    exists(AssignExpr ae |
      ae.getOp() = "+=" and
      ae.getLeftOperand() = pred.asExpr() and
      succ.asExpr() = ae
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "format" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getAnArgument() = pred.asExpr() and
      succ.asExpr() = ma
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "join" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getAnArgument() = pred.asExpr() and
      succ.asExpr() = ma
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "concat" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      (ma.getQualifier() = pred.asExpr() or ma.getArgument(0) = pred.asExpr()) and
      succ.asExpr() = ma
    )
    or
    exists(ConstructorCall cc |
      (cc.getConstructedType().hasName("StringBuffer") or
       cc.getConstructedType().hasName("StringBuilder")) and
      cc.getAnArgument() = pred.asExpr() and
      succ.asExpr() = cc
    )
  }
}

from FormattedSqlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead."
