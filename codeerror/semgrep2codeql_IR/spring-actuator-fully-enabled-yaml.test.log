/**
 * @name Spring Actuator endpoints are fully exposed
 * @description Detects when Spring Actuator endpoints are fully exposed with wildcard and custom base path
 * @kind problem
 * @problem.severity warning
 * @id java/spring/actuator-fully-enabled-yaml
 */

import java
import yaml.YamlFile

predicate isActuatorExposure(YamlFile::Value value) {
  exists(YamlFile::KeyValuePair kvp |
    kvp.getParent() = value.getParent() and
    kvp.getKey().getScalarValue() = "management.endpoints.web.exposure.include" and
    value.getScalarValue() = "*"
  )
}

predicate isActuatorBasePath(YamlFile::Value value) {
  exists(YamlFile::KeyValuePair kvp |
    kvp.getParent() = value.getParent() and
    kvp.getKey().getScalarValue() = "management.endpoints.web.base-path" and
    value.getScalarValue() = "/internal"
  )
}

from YamlFile::Value exposure, YamlFile::Value basePath
where
  isActuatorExposure(exposure) and
  isActuatorBasePath(basePath) and
  exposure.getFile() = basePath.getFile()
select exposure, "Spring Actuator endpoints are fully exposed with wildcard and custom base path"
