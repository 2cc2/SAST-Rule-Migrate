/**
 * @name Spring Actuator endpoints are fully exposed
 * @description Detects when Spring Actuator endpoints are fully exposed with wildcard and custom base path
 * @kind problem
 * @problem.severity warning
 * @id java/spring/actuator-fully-enabled-yaml
 */

import java
import DataFlow::PathGraph
import semmle.code.yaml.dataflow.YamlTraversal

class SpringActuatorConfig extends YamlTraversal::Configuration {
  SpringActuatorConfig() {
    this.hasKey("management.endpoints.web.exposure.include") and
    this.hasKey("management.endpoints.web.base-path")
  }

  override predicate isSink(YamlTraversal::ValueNode sink) {
    sink.getParent().(YamlTraversal::KeyValuePair).getKey().getScalarValue() =
      "management.endpoints.web.exposure.include" and
    sink.getScalarValue() = "*" or
    sink.getParent().(YamlTraversal::KeyValuePair).getKey().getScalarValue() =
      "management.endpoints.web.base-path" and
    sink.getScalarValue() = "/internal"
  }
}

from SpringActuatorConfig config, YamlTraversal::ValueNode exposure, YamlTraversal::ValueNode basePath
where
  config.isSink(exposure) and
  config.isSink(basePath) and
  exposure.getFile() = basePath.getFile()
select exposure, "Spring Actuator endpoints are fully exposed with wildcard and custom base path"
