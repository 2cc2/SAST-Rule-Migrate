/**
 * @name URL Rewriting Security Risk
 * @description Detects usage of HttpServletResponse.encodeURL() and related methods which may expose session IDs in URLs.
 * @kind problem
 * @problem.severity warning
 * @id java/url-rewriting
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a01:2021
 */
import java

from Call call, MethodAccess ma, Method m, Variable resp
where
  (
    call.getCallee().hasName("encodeURL") or
    call.getCallee().hasName("encodeUrl") or
    call.getCallee().hasName("encodeRedirectURL") or
    call.getCallee().hasName("encodeRedirectUrl")
  ) and
  resp.getType().getQualifiedName() = "javax.servlet.http.HttpServletResponse" and
  ma.getQualifier() = resp.getAnAccess() and
  m = ma.getEnclosingCallable()
select call, "URL rewriting has significant security risks. Since session ID appears in the URL, it may be easily seen by third parties."
