Rule Content:
/**
 * @name URL Rewriting Security Risk
 * @description Detects usage of HttpServletResponse.encodeURL() and related methods which may expose session IDs in URLs.
 * @kind problem
 * @problem.severity warning
 * @id java/url-rewriting
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a01:2021
 */
import java

from MethodAccess ma, Method m, Variable resp
where
  (
    ma.getMethod().hasName("encodeURL") or
    ma.getMethod().hasName("encodeUrl") or
    ma.getMethod().hasName("encodeRedirectURL") or
    ma.getMethod().hasName("encodeRedirectUrl")
  ) and
  resp.getType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
  ma.getQualifier() = resp.getAnAccess() and
  m = ma.getEnclosingCallable()
select ma, "URL rewriting has significant security risks. Since session ID appears in the URL, it may be easily seen by third parties."
