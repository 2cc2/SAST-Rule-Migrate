/**
 * @name Command injection via formatted Runtime call
 * @description Detects potentially unsafe formatted or concatenated strings used as input to java.lang.Runtime calls,
 *              which could lead to command injection if variables are user-controlled.
 * @kind problem
 * @problem.severity error
 * @id java/command-injection-formatted-runtime-call
 * @tags security
 *       external/cwe/cwe-078
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class RuntimeCall extends Expr {
  RuntimeCall() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.lang", "Runtime", "exec") or
      ma.getMethod().hasQualifiedName("java.lang", "Runtime", "loadLibrary") |
      this = ma
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeCall call, Expr arg |
      arg = call.getArgument(0) and
      sink.asExpr() = arg and
      (
        exists(AddExpr add | add = arg) or
        exists(MethodAccess format |
          format.getMethod().hasQualifiedName("java.lang", "String", "format") and
          format = arg
        ) or
        exists(ArrayInit array |
          array = arg and
          exists(array.getAnInit() | this.isShellCommandLiteral(_))
        ) or
        exists(GenericElement listElem |
          listElem = arg and
          exists(listElem.getAnInitializer() | this.isShellCommandLiteral(_))
        )
      )
    )
  }

  predicate isShellCommandLiteral(Expr expr) {
    exists(StringLiteral literal |
      literal = expr and
      (
        literal.getValue().regexpMatch(".*(sh|bash|ksh|csh|tcsh|zsh).*") or
        literal.getValue() = "-c"
      )
    )
  }
}

