          exists(AddExpr add | add = arg) or
          exists(MethodAccess format |
            format.getMethod().hasQualifiedName("java.lang", "String", "format") and
            format = arg
          ) or
          exists(ArrayInit array |
            array = arg and
            exists(array.getAnInit() | isShellCommandLiteral(_))
          ) or
          exists(ListLiteral list |
            list = arg and
            exists(list.getAnElement() | isShellCommandLiteral(_))
          )
        )
      )
    )
  }

  predicate isShellCommandLiteral(Expr expr) {
    exists(StringLiteral literal |
      literal = expr and
      (
        literal.getValue().regexpMatch(".*(sh|bash|ksh|csh|tcsh|zsh).*") or
        literal.getValue() = "-c"
      )
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, CommandInjectionConfig config
where config.hasFlow(source, sink)
select sink, "A formatted or concatenated string was detected as input to a java.lang.Runtime call. " +
  "This is dangerous if a variable is controlled by user input and could result in a command injection. " +
  "Ensure your variables are not controlled by users or sufficiently sanitized."
================================================================================
