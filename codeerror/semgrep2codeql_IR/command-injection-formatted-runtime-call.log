Rule Content:
/**
 * @name Command injection via formatted Runtime call
 * @description Detects potentially unsafe formatted or concatenated strings used as input to java.lang.Runtime calls,
 *              which could lead to command injection if variables are user-controlled.
 * @kind problem
 * @problem.severity error
 * @id java/command-injection-formatted-runtime-call
 * @tags security
 *       external/cwe/cwe-078
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class RuntimeCall extends MethodAccess {
  RuntimeCall() {
    this.getMethod().hasQualifiedName("java.lang", "Runtime", "exec") or
    this.getMethod().hasQualifiedName("java.lang", "Runtime", "loadLibrary")
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeCall call |
      sink.asExpr() = call.getAnArgument() and
      (
        // Check for string concatenation
        exists(AddExpr add | add = sink.asExpr()) or
        // Check for String.format calls
        exists(MethodAccess format |
          format.getMethod().hasQualifiedName("java.lang", "String", "format") and
          format = sink.asExpr()
        ) or
        // Check for shell command patterns
        exists(ArrayCreation array |
          array = sink.asExpr() and
          exists(array.getAnInit() |
            this.isShellCommandLiteral(_)
          )
        ) or
        exists(ListCreation list |
          list = sink.asExpr() and
          exists(list.getAnElement() |
            this.isShellCommandLiteral(_)
          )
        )
      )
    )
  }

  predicate isShellCommandLiteral(Expr expr) {
    exists(Literal literal |
      literal = expr and
      literal.getStringValue().regexpMatch(".*(sh|bash|ksh|csh|tcsh|zsh).*")
    ) or
    exists(Literal literal |
      literal = expr and
      literal.getStringValue() = "-c"
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink, CommandInjectionConfig config
where config.hasFlow(source, sink)
select sink, "A formatted or concatenated string was detected as input to a java.lang.Runtime call. " +
  "This is dangerous if a variable is controlled by user input and could result in a command injection. " +
  "Ensure your variables are not controlled by users or sufficiently sanitized."
