  headerValue = setHeader.getArgument(1) and
  isCorsHeaderName(headerName.getValue()) and
  isPermissiveCorsValue(headerValue.getValue())
select setHeader, "Permissive CORS policy using HttpServletResponse.setHeader() with value " + headerValue.getValue()

