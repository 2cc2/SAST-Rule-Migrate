Rule Content:
/**
 * @name Permissive CORS Policy
 * @description Detects permissive CORS policies that allow a malicious application to communicate
 *              with the victim application in an inappropriate way, leading to spoofing, data theft,
 *              relay and other attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/permissive-cors
 * @tags security
 *       external/cwe/cwe-183
 *       external/owasp/asvs/V14.4.8
 *       external/owasp/a04
 */
import java

// Pattern 1: HttpServletResponse.addHeader with permissive CORS
from MethodAccess addHeader, Variable resp, StringLiteral headerName, StringLiteral headerValue
where
  addHeader.getMethod().getName() = "addHeader" and
  addHeader.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
  resp = addHeader.getQualifier() and
  headerName = addHeader.getArgument(0) and
  headerValue = addHeader.getArgument(1) and
  headerName.getValue().matches("access-control-allow-origin") and
  headerValue.getValue().matches("^\\*|null$")
select addHeader, "Permissive CORS policy using HttpServletResponse.addHeader() with value " + headerValue.getValue()

// Pattern 2: HttpServletResponse.setHeader with permissive CORS
from MethodAccess setHeader, Variable resp, StringLiteral headerName, StringLiteral headerValue
where
  setHeader.getMethod().getName() = "setHeader" and
  setHeader.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
  resp = setHeader.getQualifier() and
  headerName = setHeader.getArgument(0) and
  headerValue = setHeader.getArgument(1) and
  headerName.getValue().matches("access-control-allow-origin") and
  headerValue.getValue().matches("^\\*|null$")
select setHeader, "Permissive CORS policy using HttpServletResponse.setHeader() with value " + headerValue.getValue()

// Pattern 3: ServerHttpResponse.getHeaders().add with permissive CORS
from MethodAccess add, MethodAccess getHeaders, Variable resp, StringLiteral headerName, StringLiteral headerValue
where
  getHeaders.getMethod().getName() = "getHeaders" and
  getHeaders.getMethod().getDeclaringType().hasQualifiedName("org.springframework.http.server", "ServerHttpResponse") and
  resp = getHeaders.getQualifier() and
  add.getMethod().getName() = "add" and
  add.getQualifier() = getHeaders and
  headerName = add.getArgument(0) and
  headerValue = add.getArgument(1) and
  headerName.getValue().matches("access-control-allow-origin") and
  headerValue.getValue().matches("^\\*|null$")
select add, "Permissive CORS policy using ServerHttpResponse.getHeaders().add() with value " + headerValue.getValue()

// Pattern 4: HttpHeaders.set with permissive CORS
from MethodAccess set, Variable headers, StringLiteral headerName, StringLiteral headerValue
where
  set.getMethod().getName() = "set" and
  set.getMethod().getDeclaringType().hasQualifiedName("org.springframework.http", "HttpHeaders") and
  headers = set.getQualifier() and
  headerName = set.getArgument(0) and
  headerValue = set.getArgument(1) and
  headerName.getValue().matches("access-control-allow-origin") and
  headerValue.getValue().matches("^\\*|null$")
select set, "Permissive CORS policy using HttpHeaders.set() with value " + headerValue.getValue()

// Pattern 5: ServerWebExchange.getResponse().getHeaders().add with permissive CORS
from MethodAccess add, MethodAccess getHeaders, MethodAccess getResponse, Variable swe, StringLiteral headerName, StringLiteral headerValue
where
  getResponse.getMethod().getName() = "getResponse" and
  getResponse.getMethod().getDeclaringType().hasQualifiedName("org.springframework.web.server", "ServerWebExchange") and
  swe = getResponse.getQualifier() and
  getHeaders.getMethod().getName() = "getHeaders" and
  getHeaders.getQualifier() = getResponse and
  add.getMethod().getName() = "add" and
  add.getQualifier() = getHeaders and
  headerName = add.getArgument(0) and
  headerValue = add.getArgument(1) and
  headerName.getValue().matches("access-control-allow-origin") and
  headerValue.getValue().matches("^\\*|null$")
select add, "Permissive CORS policy using ServerWebExchange.getResponse().getHeaders().add() with value " + headerValue.getValue()

// Pattern 6-9: Methods with various permissive CORS patterns
from Method m, MethodAccess ma, StringLiteral headerName, StringLiteral headerValue
where
  (
    // Pattern 6: Method with HttpServletResponse.addHeader
    (
      ma.getMethod().getName() = "addHeader" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
      exists(m.getAParameter() | m.getAParameter().getType().hasQualifiedName("javax.servlet.http", "HttpServletResponse"))
    ) or
    // Pattern 7: Method with HttpServletResponse.setHeader
    (
      ma.getMethod().getName() = "setHeader" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
      exists(m.getAParameter() | m.getAParameter().getType().hasQualifiedName("javax.servlet.http", "HttpServletResponse"))
    ) or
    // Pattern 8: Method with ServerHttpResponse.getHeaders().add
    (
      ma.getMethod().getName() = "add" and
      exists(MethodAccess getHeaders |
        getHeaders.getMethod().getName() = "getHeaders" and
        getHeaders.getMethod().getDeclaringType().hasQualifiedName("org.springframework.http.server", "ServerHttpResponse") and
        ma.getQualifier() = getHeaders and
        exists(m.getAParameter() | m.getAParameter().getType().hasQualifiedName("org.springframework.http.server", "ServerHttpResponse"))
      )
    ) or
    // Pattern 9: Method with ServerWebExchange.getResponse().getHeaders().add
    (
      ma.getMethod().getName() = "add" and
      exists(MethodAccess getHeaders, MethodAccess getResponse |
        getResponse.getMethod().getName() = "getResponse" and
        getResponse.getMethod().getDeclaringType().hasQualifiedName("org.springframework.web.server", "ServerWebExchange") and
        getHeaders.getMethod().getName() = "getHeaders" and
        getHeaders.getQualifier() = getResponse and
        ma.getQualifier() = getHeaders and
        exists(m.getAParameter() | m.getAParameter().getType().hasQualifiedName("org.springframework.web.server", "ServerWebExchange"))
      )
    )
  ) and
  headerName = ma.getArgument(0) and
  headerValue = ma.getArgument(1) and
  headerName.getValue().matches("access-control-allow-origin") and
  headerValue.getValue().matches("^\\*|null$")
select ma, "Method " + m.getName() + " contains permissive CORS policy with value " + headerValue.getValue()

// Pattern 10: ResponseEntity with permissive CORS header
from MethodAccess header, StringLiteral headerName, StringLiteral headerValue
where
  header.getMethod().getName() = "header" and
  header.getQualifier().getType().hasQualifiedName("org.springframework.http", "ResponseEntity") and
  headerName = header.getArgument(0) and
  headerValue = header.getArgument(1) and
  headerName.getValue().matches("access-control-allow-origin") and
  headerValue.getValue().matches("^\\*|null$")
select header, "Permissive CORS policy using ResponseEntity.header() with value " + headerValue.getValue()

// Pattern 11: ServerResponse with permissive CORS header
from MethodAccess header, StringLiteral headerName, StringLiteral headerValue
where
  header.getMethod().getName() = "header" and
  header.getQualifier().getType().hasQualifiedName("org.springframework.web.reactive.function.server", "ServerResponse") and
  headerName = header.getArgument(0) and
  headerValue = header.getArgument(1) and
  headerName.getValue().matches("access-control-allow-origin") and
  headerValue.getValue().matches("^\\*|null$")
select header, "Permissive CORS policy using ServerResponse.header() with value " + headerValue.getValue()
