  qualifier = getHeaders.getQualifier() and
  add.getMethod().hasName("add") and
  add.getQualifier() = getHeaders and
  headerName = add.getArgument(0) and
  headerValue = add.getArgument(1) and
  isCorsHeaderName(headerName.getValue()) and
  isPermissiveCorsValue(headerValue.getValue())
select add, "Permissive CORS policy using ServerHttpResponse.getHeaders().add() with value " + headerValue.getValue()

// Pattern 4: HttpHeaders.set with permissive CORS
from MethodAccess set, Expr qualifier, StringLiteral headerName, StringLiteral headerValue
