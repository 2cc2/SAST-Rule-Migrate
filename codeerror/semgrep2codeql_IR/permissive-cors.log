Rule Content:
/**
 * @name Permissive CORS Policy
 * @description Detects permissive CORS policies that allow a malicious application to communicate
 *              with the victim application in an inappropriate way, leading to spoofing, data theft,
 *              relay and other attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/permissive-cors
 * @tags security
 *       external/cwe/cwe-183
 *       external/owasp/asvs/V14.4.8
 *       external/owasp/a04
 */
import java

// Helper predicate to check for permissive CORS values
predicate isPermissiveCorsValue(string value) {
  value.matches("^\\*|null$")
}

// Helper predicate to check for CORS header name
predicate isCorsHeaderName(string name) {
  name.matches("access-control-allow-origin")
}

// Pattern 1: HttpServletResponse.addHeader with permissive CORS
from Call addHeader, Expr qualifier, StringLiteral headerName, StringLiteral headerValue
where
  addHeader.getCallee().hasName("addHeader") and
  addHeader.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
  qualifier = addHeader.getImmediateQualifier() and
  headerName = addHeader.getArgument(0) and
