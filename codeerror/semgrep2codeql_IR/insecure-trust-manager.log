Rule Content:
/**
 * @name Insecure Trust Manager Implementation
 * @description Detected empty trust manager implementations. This is dangerous because it accepts any certificate,
 *              enabling man-in-the-middle attacks. Consider using a KeyStore and TrustManagerFactory instead.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03:2017
 *       external/owasp/a07:2021
 */

import java
import semmle.code.java.dataflow.FlowSources

from Class cls, RefType trustManagerType
where
  (trustManagerType.hasQualifiedName("javax.net.ssl", "X509TrustManager") or
   trustManagerType.hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager")) and
  cls.getASupertype*() = trustManagerType
select cls, "Class implements $@ with insecure certificate validation", trustManagerType,
  "This trust manager implementation may accept any certificate, making it vulnerable to MITM attacks."

from AnonymousClass anon, RefType trustManagerType
where
  (trustManagerType.hasQualifiedName("javax.net.ssl", "X509TrustManager") or
   trustManagerType.hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager")) and
  anon.getBaseType().getSourceDeclaration() = trustManagerType
select anon, "Anonymous class implements $@ with insecure certificate validation", trustManagerType,
  "This trust manager implementation may accept any certificate, making it vulnerable to MITM attacks."

from Method m
where
  (m.getName() = "checkClientTrusted" or 
   m.getName() = "checkServerTrusted" or
   m.getName() = "getAcceptedIssuers") and
  (m.getBody().getNumStmt() = 0 or
   (m.getName() = "getAcceptedIssuers" and 
    exists(ReturnStmt ret | ret.getResult().toString() = "null")))
select m, "Empty or null implementation of $@() found. This is insecure and should be properly implemented.", m,
  "This method should properly validate certificates to prevent MITM attacks."
