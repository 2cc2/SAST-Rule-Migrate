/**
 * @name Insecure Trust Manager Implementation
 * @description Detected empty trust manager implementations. This is dangerous because it accepts any certificate,
 *              enabling man-in-the-middle attacks. Consider using a KeyStore and TrustManagerFactory instead.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03:2017
 *       external/owasp/a07:2021
 */

import java

from Class cls, RefType trustManagerType
where
  (trustManagerType.hasQualifiedName("javax.net.ssl", "X509TrustManager") or
   trustManagerType.hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager")) and
  cls.getASupertype*() = trustManagerType and
  exists(Method m | 
    m.getDeclaringType() = cls and
    ((m.getName() = "checkClientTrusted" and m.getBody().getNumStmt() = 0) or
     (m.getName() = "checkServerTrusted" and m.getBody().getNumStmt() = 0) or
     (m.getName() = "getAcceptedIssuers" and 
      exists(ReturnStmt ret | ret.getResult().toString() = "null")))
  )
select cls, "Insecure trust manager implementation found in $@. This accepts any certificate, making it vulnerable to MITM attacks.",
  cls, "Consider using a KeyStore and TrustManagerFactory for proper certificate validation."

from AnonymousClass anon, RefType trustManagerType
where
  (trustManagerType.hasQualifiedName("javax.net.ssl", "X509TrustManager") or
   trustManagerType.hasQualifiedName("javax.net.ssl", "X509ExtendedTrustManager")) and
  anon.getBaseType().getSourceDeclaration() = trustManagerType and
  exists(Method m | 
    m.getDeclaringType() = anon and
    ((m.getName() = "checkClientTrusted" and m.getBody().getNumStmt() = 0) or
     (m.getName() = "checkServerTrusted" and m.getBody().getNumStmt() = 0) or
     (m.getName() = "getAcceptedIssuers" and 
      exists(ReturnStmt ret | ret.getResult().toString() = "null")))
  )
select anon, "Insecure anonymous trust manager implementation found in $@. This accepts any certificate, making it vulnerable to MITM attacks.",
  anon, "Consider using a KeyStore and TrustManagerFactory for proper certificate validation."
