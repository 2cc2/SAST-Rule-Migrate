Rule Content:
/**
 * @name Insecure Trust Manager Implementation
 * @description Detected empty trust manager implementations. This is dangerous because it accepts any certificate,
 *              enabling man-in-the-middle attacks. Consider using a KeyStore and TrustManagerFactory instead.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-trust-manager
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03:2017
 *       external/owasp/a07:2021
 */

import java

// Match classes implementing X509TrustManager or X509ExtendedTrustManager
from Class cls, ClassInterfaceImplementation impl
where
  (impl.getImplementedClass() = cls and
   (cls.getName() = "X509TrustManager" or cls.getName() = "X509ExtendedTrustManager")) or
  exists(AnonymousClass anon |
    anon.getBaseType().(RefType).getName() = "X509TrustManager" or
    anon.getBaseType().(RefType).getName() = "X509ExtendedTrustManager"
  )
select cls, "Insecure trust manager implementation found. This may accept any certificate, making it vulnerable to MITM attacks."

// Check for empty or null implementations of critical methods
from Method m
where
  (m.getName() = "checkClientTrusted" or 
   m.getName() = "checkServerTrusted" or
   m.getName() = "getAcceptedIssuers") and
  (m.getBody().getNumStmt() = 0 or
   (m.getName() = "getAcceptedIssuers" and 
    exists(ReturnStmt ret | ret.getResult().toString() = "null")))
select m, "Empty or null implementation of " + m.getName() + "() found. This is insecure and should be properly implemented."
