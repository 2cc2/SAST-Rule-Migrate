Rule Content:
/**
 * @name Script Engine Injection
 * @description Detected potential code injection using ScriptEngine. Ensure user-controlled data cannot enter '.eval()', otherwise, this is a code injection vulnerability.
 * @kind problem
 * @problem.severity warning
 * @id java/script-engine-injection
 * @tags security
 *       external/cwe/cwe-094
 *       external/owasp/a03
 *       cwe2022-top25
 */
import java

from MethodAccess evalCall, Variable se
where
  // Find ScriptEngine.eval() calls
  evalCall.getMethod().hasName("eval") and
  evalCall.getMethod().getDeclaringType().hasQualifiedName("javax.script", "ScriptEngine") and
  // Ensure the argument is not a string literal
  not exists(StringLiteral sl | sl = evalCall.getArgument(0)) and
  // Ensure the argument is not a local string variable initialized with a literal
  not exists(LocalVariableDeclaration lvd, StringLiteral sl |
    lvd.getVariable() = evalCall.getArgument(0).(VariableAccess).getTarget() and
    lvd.getInitializer() = sl
  ) and
  // Find ScriptEngine variables
  (
    // Field declarations
    (se.getType().hasQualifiedName("javax.script", "ScriptEngine") and se instanceof Field) or
    // Local variable declarations
    (se.getType().hasQualifiedName("javax.script", "ScriptEngine") and se instanceof LocalVariable)
  ) and
  // Ensure the eval call is using the ScriptEngine variable
  evalCall.getQualifier() = se.getAnAccess()
select evalCall, "Potential code injection vulnerability via ScriptEngine.eval(). Ensure user-controlled data cannot enter this method."
