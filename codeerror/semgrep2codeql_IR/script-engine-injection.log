Rule Content:
/**
 * @name Script Engine Injection
 * @description Detected potential code injection using ScriptEngine. Ensure user-controlled data cannot enter '.eval()', otherwise, this is a code injection vulnerability.
 * @kind problem
 * @problem.severity warning
 * @id java/script-engine-injection
 * @tags security
 *       external/cwe/cwe-094
 *       external/owasp/a03
 *       cwe2022-top25
 */
import java

from Expr se, MethodAccess evalCall
where
  // Find ScriptEngine declarations (fields or local variables)
  (
    (se instanceof Field and se.getType().hasQualifiedName("javax.script", "ScriptEngine")) or
    (se instanceof LocalVariableDecl and se.getType().hasQualifiedName("javax.script", "ScriptEngine"))
  )
  and
  // Find eval() method calls on ScriptEngine
  evalCall.getMethod().hasName("eval") and
  evalCall.getMethod().getDeclaringType().hasQualifiedName("javax.script", "ScriptEngine") and
  evalCall.getQualifier() = se.getAnAccess() and
  // Exclude cases where argument is a string literal
  not evalCall.getArgument(0) instanceof StringLiteral and
  // Exclude cases where argument is a local string variable initialized with literal
  not exists(LocalVariableDecl lvd, StringLiteral sl |
    evalCall.getArgument(0) = lvd.getVariable().getAnAccess() and
    lvd.getInitializer() = sl
  )
select evalCall, "Potential code injection vulnerability via ScriptEngine.eval(). Ensure user-controlled data cannot enter this method."
