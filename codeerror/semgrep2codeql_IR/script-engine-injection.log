Rule Content:
/**
 * @name Script Engine Injection
 * @description Detected potential code injection using ScriptEngine. Ensure user-controlled data cannot enter '.eval()', otherwise, this is a code injection vulnerability.
 * @kind problem
 * @problem.severity warning
 * @id java/script-engine-injection
 * @tags security
 *       external/cwe/cwe-094
 *       external/owasp/a03
 *       cwe2022-top25
 */
import java

// Find ScriptEngine declarations
from Class cls, Field f
where f.getDeclaringType() = cls and
      f.getType().hasQualifiedName("javax.script", "ScriptEngine")
select f

// Find ScriptEngine local variable declarations
from VariableAccess va
where va.getType().hasQualifiedName("javax.script", "ScriptEngine")
select va

// Find eval() method calls
from MethodAccess evalCall
where evalCall.getMethod().hasName("eval") and
      evalCall.getMethod().getDeclaringType().hasQualifiedName("javax.script", "ScriptEngine") and
      not exists(Expr arg | arg = evalCall.getArgument(0) | arg instanceof StringLiteral) and
      not exists(VariableAccess va, StringLiteral sl |
        va = evalCall.getArgument(0) and
        sl.getAStmt().getASuccessor*() = va.getAStmt()
      )
select evalCall, "Potential code injection vulnerability via ScriptEngine.eval(). Ensure user-controlled data cannot enter this method."
