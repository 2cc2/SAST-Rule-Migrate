import java
import semmle.code.java.StringFormat

// Match JDBC Statement usage
class JdbcStatement extends RefType {
  JdbcStatement() {
    this.hasQualifiedName("java.sql", "Statement") or
    this.hasQualifiedName("java.sql", "PreparedStatement") or
    this.hasQualifiedName("java.sql", "CallableStatement")
