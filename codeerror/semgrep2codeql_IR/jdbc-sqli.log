Rule Content:
/**
 * @name JDBC SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/jdbc-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 *       cwe2021-top25
 *       cwe2022-top25
 *       technology/jdbc
 */

import java
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.JDBC

// Match SQL statement creation with string concatenation or format
predicate isUnsafeSqlConstruction(Expr sqlExpr) {
  exists(MethodAccess ma, Method m |
    ma.getMethod() = m and
    m.getName().matches("^(executeQuery|execute|executeUpdate|executeLargeUpdate|addBatch|nativeSQL)$") and
    (
      // Case 1: String concatenation
      exists(BinaryExpr be |
        be.getOp() = BinaryOperator.PLUS and
        be.getLeftOperand().getType() instanceof TypeString and
        be.getRightOperand().getType() instanceof TypeString and
        sqlExpr = be
      )
      or
      // Case 2: String.format()
      exists(MethodAccess formatCall |
        formatCall.getMethod().getName() = "format" and
        formatCall.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
        sqlExpr = formatCall
      )
      or
      // Case 3: Variable passed to SQL method
      exists(LocalVariableDecl lvd |
        lvd.getType() instanceof TypeString and
        lvd.getName() = "SQL" and
        sqlExpr = lvd.getAnAccess()
      )
    )
  )
}

// Match JDBC Statement usage
class JdbcStatement extends RefType {
  JdbcStatement() {
    this.hasQualifiedName("java.sql", "Statement") or
    this.hasQualifiedName("java.sql", "PreparedStatement") or
    this.hasQualifiedName("java.sql", "CallableStatement")
  }
}

from MethodAccess ma, Method m, Expr sqlArg
where
  ma.getMethod() = m and
  m.getName().matches("^(executeQuery|execute|executeUpdate|executeLargeUpdate|addBatch|nativeSQL)$") and
  m.getDeclaringType() instanceof JdbcStatement and
  isUnsafeSqlConstruction(sqlArg) and
  sqlArg = ma.getArgument(0)
select ma, "Detected a formatted string in a SQL statement. This could lead to SQL injection. Use prepared statements instead."
