Rule Content:
/**
 * @name Suspicious self-comparison
 * @description `$X == $X` or `$X != $X` is always true. (Unless the value compared is a float or double).
 *              To test if `$X` is not-a-number, use `Double.isNaN($X)`.
 * @kind problem
 * @problem.severity error
 * @id java/eqeq
 * @tags correctness
 *       java
 */

import java

predicate isSelfComparison(BinaryExpr expr) {
  exists(Expr left, Expr right |
    (expr.getOp() instanceof EqualityEqual or expr.getOp() instanceof EqualityNotEqual) and
    left = expr.getLeftOperand() and
    right = expr.getRightOperand() and
    left.toString() = right.toString() and
    not left.getType() instanceof FloatingPointType and
    not right.getType() instanceof FloatingPointType and
    not (left instanceof Literal and right instanceof Literal)
  )
}

predicate isInsideAssert(Expr e) {
  exists(AssertStmt assertStmt |
    (assertStmt.getExpr() = e or assertStmt.getMessage() = e)
  )
}

from BinaryExpr expr
where 
  isSelfComparison(expr) and
  not isInsideAssert(expr)
select expr, "Suspicious self-comparison that is always true (unless comparing float/double). " +
           "To test for NaN, use Double.isNaN() instead."
