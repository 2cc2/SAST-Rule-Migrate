Rule Content:
/**
 * @name Suspicious self-comparison
 * @description `$X == $X` or `$X != $X` is always true. (Unless the value compared is a float or double). 
 *              To test if `$X` is not-a-number, use `Double.isNaN($X)`.
 * @kind problem
 * @problem.severity error
 * @id java/eqeq
 * @tags correctness
 *       java
 */

import java

// Match expressions like X == X or X != X
predicate isSelfComparison(Expr e) {
  exists(BinaryExpr be |
    (be.getOp() = EqualityOperation.EQUAL or be.getOp() = EqualityOperation.NOTEQUAL) and
    be.getLeftOperand().toString() = be.getRightOperand().toString() and
    // Exclude float/double comparisons which might be NaN checks
    not be.getLeftOperand().getType() instanceof FloatingPointType and
    not be.getRightOperand().getType() instanceof FloatingPointType and
    // Exclude obvious true cases like 1 == 1
    not (be.getLeftOperand() instanceof Literal and be.getRightOperand() instanceof Literal) and
    e = be
  )
}

// Exclude assertions
predicate isInsideAssert(Expr e) {
  exists(AssertStmt as |
    (as.getExpr() = e or as.getMessage() = e) and
    e.getEnclosingCallable() = as.getEnclosingCallable()
  )
}

from Expr e
where 
  isSelfComparison(e) and
  not isInsideAssert(e)
select e, "Suspicious self-comparison that is always true (unless comparing float/double). " +
           "To test for NaN, use Double.isNaN() instead."
