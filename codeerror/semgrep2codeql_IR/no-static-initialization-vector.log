Rule Content:
/**
 * @name No Static Initialization Vector
 * @description Initialization Vectors (IVs) for block ciphers should be randomly generated each time they are used. 
 *              Using a static IV means the same plaintext encrypts to the same ciphertext every time, 
 *              weakening the strength of the encryption.
 * @kind problem
 * @problem.severity warning
 * @id java/no-static-initialization-vector
 * @tags security
 *   vulnerability
 *   cwe/329
 *   owasp/a02
 *   asvs/V6.2.5
 */
import java

// Pattern 1: Detects static IV initialization in a local variable
from LocalVariableDeclaration lvd, VariableAccess va, MethodAccess ma
where
  lvd.getType().(ArrayType).getElementType() instanceof PrimitiveType and
  lvd.getType().(ArrayType).getElementType().(PrimitiveType).getTypeName() = "byte" and
  exists(ma.getMethod() | ma.getMethod().getName() = "IvParameterSpec") and
  va.getVariable() = lvd.getVariable() and
  ma.getArgument(0) = va
select ma, "Initialization Vector (IV) should be randomly generated, not static"

// Pattern 2: Detects static IV initialization in a class field
from Field f, VariableAccess va, MethodAccess ma, Method m
where
  f.getType().(ArrayType).getElementType() instanceof PrimitiveType and
  f.getType().(ArrayType).getElementType().(PrimitiveType).getTypeName() = "byte" and
  exists(ma.getMethod() | ma.getMethod().getName() = "IvParameterSpec") and
  va.getVariable() = f and
  ma.getArgument(0) = va and
  m.getDeclaringType() = f.getDeclaringType()
select ma, "Initialization Vector (IV) should be randomly generated, not static"
