Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/hibernate-sqli
 * @tags security
 *   external/cwe/cwe-89
 *   external/owasp/a01
 *   external/owasp/a03
 *   external/cwe2021-top25
 *   external/cwe2022-top25
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Hibernate

// Case 1: sqlRestriction with string concatenation or String.format
from MethodAccess ma, Expr sqlArg
where
  ma.getMethod().hasName("sqlRestriction") and
  ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate.criterion", "Restrictions") and
  (
    // String concatenation case
    (
      exists(AddExpr add | add = sqlArg |
        not exists(Literal literal | add.getAnOperand() = literal)
      )
      or
      // String.format case
      exists(MethodAccess formatCall | formatCall = sqlArg |
        formatCall.getMethod().hasName("format") and
        formatCall.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")
      )
    )
  )
select ma, "Potential SQL injection in Hibernate sqlRestriction. Use prepared statements instead."

// Case 2: Session.createQuery/createSQLQuery with string concatenation or String.format
from MethodAccess ma, Expr sqlArg, VariableAccess session
where
  (
    ma.getMethod().hasName("createQuery") or
    ma.getMethod().hasName("createSQLQuery")
  ) and
  ma.getMethod().getDeclaringType().hasQualifiedName("org.hibernate", "Session") and
  session.getVariable().getType().hasQualifiedName("org.hibernate", "Session") and
  ma.getQualifier() = session and
  (
    // String concatenation case
    (
      exists(AddExpr add | add = sqlArg |
        not exists(Literal literal | add.getAnOperand() = literal)
      )
      or
      // String.format case
      exists(MethodAccess formatCall | formatCall = sqlArg |
        formatCall.getMethod().hasName("format") and
        formatCall.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")
      )
    )
  )
select ma, "Potential SQL injection in Hibernate Session query. Use prepared statements instead."
