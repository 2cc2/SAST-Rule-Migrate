 * @tags security
 *       external/cwe/cwe-319
 *       external/owasp/a03
 *       external/owasp/a02
 */

import java

class InsecureCookieCreation extends Expr {
  InsecureCookieCreation() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this = cc and
      not exists(MethodAccess ma |
        ma.getQualifier().(VariableAccess).getVariable() = cc.getVariable() and
        ma.getMethod().getName() = "setSecure" and
        ma.getArgument(0).(BooleanLiteral).getValue() = true
      )
    )
  }
}

