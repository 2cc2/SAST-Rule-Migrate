/**
 * @name Insecure Cookie Configuration
 * @description Detects when a Cookie is created without setting the secure flag to true,
 *              which could lead to sensitive information being transmitted over unencrypted connections.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-cookie-configuration
 * @tags security
 *       external/cwe/cwe-319
 *       external/owasp/a03
 *       external/owasp/a02
 */

import java

class InsecureCookieCreation extends MethodAccess {
  InsecureCookieCreation() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      m.getName() = "<init>" and
      this.getMethod() = m
    )
  }
}

class SecureFlagNotSet extends MethodAccess {
  SecureFlagNotSet() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      m.getName() = "setSecure" and
      this.getMethod() = m and
      not this.getAnArgument().(BooleanLiteral).getValue()
    )
  }
}

class CookieInstance extends RefType {
  CookieInstance() {
    this.hasQualifiedName("javax.servlet.http", "Cookie")
  }
}

from InsecureCookieCreation cookieCreation, VariableAccess cookieVar
where
  cookieVar.getType() instanceof CookieInstance and
  cookieVar.getAnAccess() = cookieCreation.getQualifier() and
  not exists(SecureFlagNotSet secureSet |
    secureSet.getQualifier() = cookieVar.getAnAccess() and
    secureSet.getLocation().getFile() = cookieCreation.getLocation().getFile() and
    secureSet.getLocation().getStartLine() > cookieCreation.getLocation().getStartLine()
  )
