Rule Content:
/**
 * @name JAX-RS Path Traversal Vulnerability
 * @description Detects potential path traversal vulnerabilities in JAX-RS endpoints where
 *              PathParam values are directly used in file operations without sanitization.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jax-rs-path-traversal
 * @tags security
 *       external/cwe/cwe-022
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 *       owasp-a05:2017
 *       owasp-a01:2021
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.jaxrs.JaxRs

class PathTraversalConfig extends DataFlow::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p |
      m.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "PathParam") and
      p = m.getAParameter() and
      p.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "PathParam") and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.io", "File") and
      sink.asExpr() = cc.getAnArgument()
    )
  }
}

from PathTraversalConfig ptc, DataFlow::Node source, DataFlow::Node sink
where ptc.hasFlow(source, sink)
select sink, 
  "Potential path traversal vulnerability. User-controlled path parameter is used in file operation " +
  "without proper sanitization. Consider using FilenameUtils.getName() or similar sanitization.",
  source.getNode(), 
  "User input flows to file operation here."
