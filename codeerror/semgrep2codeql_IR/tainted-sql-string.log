Rule Content:
/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string. This is usually bad practice because manual construction could accidentally result in a SQL injection. An attacker could use a SQL injection to steal or modify contents of the database. Instead, use a parameterized query which is available by default in most database engines. Alternatively, consider using an object-relational mapper (ORM) such as Sequelize which will protect your queries.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision medium
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-89
 *       external/cwe/cwe-943
 *       owasp-a01
 *       owasp-a03
 *       cwe2021-top25
 *       cwe2022-top25
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.StringConcat

class LambdaHandler extends Method {
  LambdaHandler() {
    (
      this.getName().matches("handleRequest") and
      (
        (this.getNumberOfParameters() = 2 and
         this.getParameter(0).getType().toString() = "InputStream" and
         this.getParameter(1).getType().toString() = "OutputStream")
        or
        (this.getNumberOfParameters() = 2 and
         this.getParameter(0).getType().toString() = "APIGatewayProxyRequestEvent" and
         this.getParameter(1).getType().toString() = "Context")
      )
    )
  }
}

class TaintedSQLSource extends DataFlow::Node {
  TaintedSQLSource() {
    exists(Method m | m instanceof LambdaHandler | this.asParameter() = m.getParameter(0))
  }
}

class SQLStringSink extends DataFlow::Node {
  SQLStringSink() {
    exists(StringLiteral sql |
      sql.getText().regexpMatch("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      (
        exists(StringConcatOperation concat | concat.getLeftOperand() = sql | this.asExpr() = concat)
        or
        exists(MethodAccess concat | concat.getMethod().getName() = "concat" and concat.getQualifier() = sql | this.asExpr() = concat)
        or
        exists(StringBuilderAppend append | append.getAnArgument() = sql | this.asExpr() = append)
        or
        exists(AssignmentOperation assign | assign.getLeftOperand() = this.asExpr() and assign.getRightOperand() = sql)
        or
        exists(StringFormatOperation format | format.getFormatString() = sql | this.asExpr() = format)
      )
    ) and
    not exists(MethodAccess println | println.getMethod().getName().matches("println") | this.asExpr() = println)
  }
}

class TaintedSQLConfig extends TaintTracking::Configuration {
  TaintedSQLConfig() { this = "TaintedSQLConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof TaintedSQLSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLStringSink
  }
}

