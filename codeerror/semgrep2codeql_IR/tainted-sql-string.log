Rule Content:
/**
 * @name Tainted SQL String
 * @description User data flows into this manually-constructed SQL string. User data can be safely inserted into SQL strings using prepared statements or an object-relational mapping (ORM). Manually-constructed SQL strings is a possible indicator of SQL injection, which could let an attacker steal or manipulate data from the database.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 *       cwe-top-25-2021
 *       cwe-top-25-2022
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat

class TaintedSQLStringConfig extends TaintTracking::Configuration {
  TaintedSQLStringConfig() { this = "TaintedSQLStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p |
      m.getAnAnnotation().getType().getName().matches("RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue") and
      p = m.getAParameter() and
      source.asParameter() = p and
      not p.getType().hasName("Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Expr e |
      // String concatenation cases
      (
        (e instanceof AddExpr and e.getRightOperand().toString().matches("%select|delete|insert|create|update|alter|drop%")) or
        (e instanceof MethodAccess and e.getMethod().getName() = "concat" and e.getQualifier().toString().matches("%select|delete|insert|create|update|alter|drop%")) or
        (e instanceof AssignmentExpr and e.getLeftOperand().toString().matches("%select|delete|insert|create|update|alter|drop%")) or
        (e instanceof MethodAccess and e.getMethod().getName() = "format" and 
          (e.getArgument(0).toString().matches("%select|delete|insert|create|update|alter|drop%") or
           e.getQualifier().getType().hasName("String")))
      ) and
      sink.asExpr() = e and
      not exists(MethodAccess ma |
        ma.getMethod().getName().matches("println|info|warn|warning|debug|debugging|error") and
        ma.getAnArgument() = e
      ) and
      not exists(ThrowStmt ts | ts.getExpression() = e)
    )
    or
    // StringBuilder cases
    exists(StringBuilder sb, MethodAccess appendCall |
      sb.getAConstructorCall().getAnArgument().toString().matches("%select|delete|insert|create|update|alter|drop%") and
      appendCall.getMethod().getName() = "append" and
      appendCall.getQualifier() = sb.getAnAccess() and
      sink.asExpr() = appendCall.getAnArgument()
    )
  }
}

