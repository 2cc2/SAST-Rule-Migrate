/**
 * @name Tainted SQL String Construction
 * @description Detected user input used to manually construct a SQL string. This is usually bad practice because manual construction could accidentally result in a SQL injection. An attacker could use a SQL injection to steal or modify contents of the database. Instead, use a parameterized query which is available by default in most database engines. Alternatively, consider using an object-relational mapper (ORM) such as Sequelize which will protect your queries.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-sql-string
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class LambdaHandlerSource extends DataFlow::Node {
  LambdaHandlerSource() {
    exists(Method m |
      (m.getName().matches("%Handler") or m.getName().matches("%handler")) and
      (
        m.getNumberOfParameters() = 2 and
        m.getParameter(1).getType().hasQualifiedName("com.amazonaws.services.lambda.runtime", "Context")
        or
        m.getNumberOfParameters() = 3 and
        m.getParameter(0).getType().hasQualifiedName("java.io", "InputStream") and
        m.getParameter(1).getType().hasQualifiedName("java.io", "OutputStream") and
        m.getParameter(2).getType().hasQualifiedName("com.amazonaws.services.lambda.runtime", "Context")
      ) and
      this.asParameter() = m.getParameter(0)
    )
  }
}

class SqlStringSink extends DataFlow::Node {
  SqlStringSink() {
    exists(StringConcatenation sc |
      sc.getRightOperand().getType() instanceof TypeString and
      sc.getLeftOperand().getType() instanceof TypeString and
      sc.toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      not sc.getParent() instanceof MethodAccess and
      this.asExpr() = sc
    )
    or
    exists(MethodAccess ma |
      ma.getCallee().getName() = "concat" and
      ma.getQualifier().getType() instanceof TypeString and
      ma.getAnArgument().getType() instanceof TypeString and
      ma.getQualifier().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      this.asExpr() = ma
    )
    or
    exists(MethodAccess ma |
      ma.getCallee().getName() = "append" and
      ma.getQualifier().getType().hasQualifiedName("java.lang", "StringBuilder") and
      exists(Variable v |
        v.getInitializer().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
        ma.getQualifier() = v.getAnAccess() and
        this.asExpr() = ma.getAnArgument()
      )
    )
    or
    exists(Assignment a |
      a.getDest().getType() instanceof TypeString and
      a.getSource().getType() instanceof TypeString and
      a.getDest().getARead().getParent() instanceof Assignment and
      a.getSource().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      this.asExpr() = a.getDest()
    )
    or
    exists(MethodAccess ma |
      ma.getCallee().getName() = "format" and
      ma.getAnArgument().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)\\b") and
      not ma.getParent() instanceof MethodAccess and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

class SqlStringTaintConfig extends TaintTracking::Configuration {
  SqlStringTaintConfig() { this = "SqlStringTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaHandlerSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlStringSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

