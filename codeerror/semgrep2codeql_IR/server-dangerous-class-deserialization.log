/**
 * @name Server Dangerous Class Deserialization
 * @description Using a non-primitive class with Java RMI may be an insecure deserialization vulnerability.
 *              Depending on the implementation, this could allow malicious actors to execute code on your system.
 *              Instead, use an integer ID to look up your object, or consider alternative serialization schemes like JSON.
 * @kind problem
 * @problem.severity warning
 * @id java/server-dangerous-class-deserialization
 * @tags security
 *       cwe:502
 *       owasp:a08
 *       owasp:a08:2021
 *       cwe2022-top25
 *       cwe2021-top25
 *       audit
 * @precision low
 * @security-severity 7.5
 */

import java

// Define primitive types to exclude
predicate isPrimitiveType(RefType t) {
  t.hasName("int") or
  t.hasName("boolean") or
  t.hasName("short") or
  t.hasName("long") or
  t.hasName("byte") or
  t.hasName("char") or
  t.hasName("float") or
  t.hasName("double")
}

// Find RMI interfaces extending Remote with non-primitive parameter types
from Interface remoteInterface, MethodInterface method, Parameter param, RefType paramType
where
  remoteInterface.getASupertype*().hasQualifiedName("java.rmi", "Remote") and
  method = remoteInterface.getAMethod() and
  param = method.getAParameter() and
  paramType = param.getType() and
  not isPrimitiveType(paramType)
select param, "Using a non-primitive class with Java RMI may be an insecure deserialization vulnerability. " +
  "Consider using an integer ID to look up your object, or alternative serialization schemes like JSON."
