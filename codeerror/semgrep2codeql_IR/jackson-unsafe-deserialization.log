Rule Content:
/**
 * @name Jackson unsafe deserialization
 * @description When using Jackson to marshall/unmarshall JSON to Java objects, enabling default typing is dangerous and can lead to RCE.
 * @kind problem
 * @problem.severity warning
 * @id java/jackson-unsafe-deserialization
 * @tags security
 *       audit
 *       cwe/502
 *       owasp/a8
 * @security-severity 7.5
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Jackson

class UnsafeJacksonDeserialization extends MethodAccess {
  UnsafeJacksonDeserialization() {
    // Case 1: ObjectMapper with enableDefaultTyping() followed by readValue()
    (
      exists(MethodAccess enableCall |
        enableCall.getMethod().getName() = "enableDefaultTyping" and
        enableCall.getQualifier() = this.getQualifier() and
        enableCall.getEnclosingCallable() = this.getEnclosingCallable()
      )
      or
      // Case 2: Class with @JsonTypeInfo(use = Id.CLASS) and dangerous field types
      exists(Class cls, Field f, Annotation ann |
        ann.getType().hasQualifiedName("com.fasterxml.jackson.annotation", "JsonTypeInfo") and
        exists(MemberAccess ma |
          ma = ann.getValue("use") and
          ma.getTarget().getName() = "CLASS"
        ) and
        f.getDeclaringType() = cls and
        f.getType().getName() in ["Object", "Serializable", "Comparable"] and
        this.getArgument(1).getType().getName() = cls.getName()
      )
      or
      // Case 3: ObjectMapper field initialized with enableDefaultTyping() and used in readValue()
      exists(Field omField, Method initMethod, MethodAccess enableCall |
        omField.getType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
        omField.getDeclaringType() = this.getEnclosingCallable().getDeclaringType() and
        initMethod.getDeclaringType() = omField.getDeclaringType() and
        enableCall.getMethod().getName() = "enableDefaultTyping" and
        enableCall.getQualifier() = omField.getAnAccess() and
        exists(initMethod.getBody().getAChild*() = enableCall) and
        this.getQualifier() = omField.getAnAccess()
      )
    ) and
    this.getMethod().getName() = "readValue"
  }

  Expr getJsonSource() { result = this.getArgument(0) }
}

from UnsafeJacksonDeserialization ujd, Expr jsonSource
where jsonSource = ujd.getJsonSource()
select ujd,
  "Unsafe Jackson deserialization with default typing enabled. Attackers may provide malicious JSON to exploit RCE.",
  jsonSource, "Potential malicious JSON input"
