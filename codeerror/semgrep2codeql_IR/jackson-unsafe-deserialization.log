Rule Content:
/**
 * @name Jackson unsafe deserialization
 * @description When using Jackson to marshall/unmarshall JSON to Java objects, enabling default typing is dangerous and can lead to RCE.
 * @kind problem
 * @problem.severity warning
 * @id java/jackson-unsafe-deserialization
 * @tags security
 *       audit
 *       cwe/502
 *       owasp/a8
 * @security-severity 7.5
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Jackson

// Case 1: ObjectMapper with enableDefaultTyping() followed by readValue()
from ObjectMapper om, MethodAccess readValueCall, Expr jsonSource
where
  om.getAMethodCall("enableDefaultTyping") and
  readValueCall.getMethod().getName() = "readValue" and
  readValueCall.getQualifier() = om and
  jsonSource = readValueCall.getArgument(0)
select readValueCall,
  "Unsafe Jackson deserialization with default typing enabled. Attackers may provide malicious JSON to exploit RCE.",
  jsonSource, "Potential malicious JSON input"

// Case 2: Class with @JsonTypeInfo(use = Id.CLASS) and dangerous field types
from Class cls, Field f, Annotation ann, MethodAccess readValueCall, Expr jsonSource
where
  ann.getType().hasQualifiedName("com.fasterxml.jackson.annotation", "JsonTypeInfo") and
  ann.getValue("use").(MemberAccess).getTarget().getName() = "CLASS" and
  f.getDeclaringType() = cls and
  f.getType().getName() in ["Object", "Serializable", "Comparable"] and
  readValueCall.getMethod().getName() = "readValue" and
  readValueCall.getArgument(1).getType().getName() = cls.getName() and
  jsonSource = readValueCall.getArgument(0)
select readValueCall,
  "Unsafe Jackson deserialization with @JsonTypeInfo(use = Id.CLASS) and dangerous field type " + f.getType().getName(),
  jsonSource, "Potential malicious JSON input"

// Case 3: ObjectMapper field initialized with enableDefaultTyping() and used in readValue()
from Class cls, Field omField, Method initMethod, MethodAccess enableCall, MethodAccess readValueCall, Expr jsonSource
where
  omField.getType().hasQualifiedName("com.fasterxml.jackson.databind", "ObjectMapper") and
  omField.getDeclaringType() = cls and
  initMethod.getDeclaringType() = cls and
  enableCall.getMethod().getName() = "enableDefaultTyping" and
  enableCall.getQualifier().(FieldAccess).getField() = omField and
  exists(initMethod.getBody().getAChild*() = enableCall) and
  readValueCall.getMethod().getName() = "readValue" and
  readValueCall.getQualifier().(FieldAccess).getField() = omField and
  jsonSource = readValueCall.getArgument(0)
select readValueCall,
  "Unsafe Jackson deserialization with ObjectMapper field initialized with default typing enabled",
  jsonSource, "Potential malicious JSON input"
