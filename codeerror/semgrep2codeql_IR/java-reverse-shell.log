/**
 * @name Java Reverse Shell Detection
 * @description Detects potential reverse shell behavior in Java code
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision low
 * @id java/reverse-shell
 * @tags security
 *       external/cwe/cwe-78
 *       external/cwe/cwe-88
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

predicate isSocketReverseShell(Expr e) {
  exists(MethodAccess ma, MethodAccess getInput, MethodAccess available, MethodAccess read, MethodAccess flush |
    ma.getMethod().hasName("getInputStream") and
    getInput = ma and
    available.getMethod().hasName("available") and
    read.getMethod().hasName("read") and
    flush.getMethod().hasName("flush") and
    exists(WhileStmt ws, WhileStmt innerWs |
      ws.getCondition().(MethodAccess).getMethod().hasName("isClosed") and
      innerWs.getCondition().(MethodAccess) = available and
      innerWs.getBody().(Block).getAChild() = read and
      ws.getBody().(Block).getAChild*() = flush
    )
  )
}

predicate isProcessReverseShell(Expr e) {
  exists(MethodAccess start, MethodAccess destroy |
    start.getMethod().hasName("start") and
    start.getCaller().(MethodAccess).getMethod().hasName("redirectErrorStream") and
    destroy.getMethod().hasName("destroy") and
    destroy.getQualifier().getType().toString() = "Process"
  )
}

from Expr e
where isSocketReverseShell(e) or isProcessReverseShell(e)
select e, "Potential reverse shell behavior detected"
