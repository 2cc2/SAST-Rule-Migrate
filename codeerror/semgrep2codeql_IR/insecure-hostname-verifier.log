/**
 * @name Insecure HostnameVerifier Implementation
 * @description Detects insecure HostnameVerifier implementations that accept any SSL certificate with any hostname,
 *              creating the possibility for man-in-the-middle attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-hostname-verifier
 * @tags security
 *       external/cwe/cwe-295
 *       external/owasp/a03:2017
 *       external/owasp/a07:2021
 *       external/asvs/v9.2.1
 */
import java

// Case 1: Class implementing HostnameVerifier with verify() always returning true
from Class cls, Method m
where
  cls.getASupertype*().hasQualifiedName("javax.net.ssl", "HostnameVerifier") and
  m.getDeclaringType() = cls and
  m.getName() = "verify" and
  exists(ReturnStmt rs | 
    rs.getEnclosingCallable() = m and
    rs.getResult().(BooleanLiteral).getValue() = true
  )
select m, "Insecure HostnameVerifier implementation. This will accept any SSL certificate with any hostname, creating the possibility for man-in-the-middle attacks."

// Case 2: Anonymous HostnameVerifier with verify() always returning true
from ClassInstanceExpr cie, Method m
where
  cie.getType().hasQualifiedName("javax.net.ssl", "HostnameVerifier") and
  m.getDeclaringType() = cie.getAnonymousClass() and
  m.getName() = "verify" and
  exists(ReturnStmt rs |
    rs.getEnclosingCallable() = m and
    rs.getResult().(BooleanLiteral).getValue() = true
  )
select m, "Insecure HostnameVerifier implementation. This will accept any SSL certificate with any hostname, creating the possibility for man-in-the-middle attacks."

// Case 3: Import of NoopHostnameVerifier
from ImportType imp
where imp.getImportedType().hasQualifiedName("org.apache.http.conn.ssl", "NoopHostnameVerifier")
select imp, "Insecure HostnameVerifier import detected. NoopHostnameVerifier accepts any SSL certificate with any hostname, creating the possibility for man-in-the-middle attacks."
