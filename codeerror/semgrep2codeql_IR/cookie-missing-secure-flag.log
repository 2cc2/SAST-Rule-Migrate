/**
 * @name Cookie Missing Secure Flag
 * @description Detects cookies without the 'secure' flag set. The 'secure' flag prevents
 *              transmission over insecure channels like HTTP.
 * @kind problem
 * @problem.severity warning
 * @id java/cookie-missing-secure-flag
 * @tags security
 *       audit
 *       cwe/614
 *       owasp/a05
 *       asvs/V3.4.1
 */
import java

from Method setSecureMethod, Method addCookieMethod, Expr cookie, MethodAccess setSecureCall, MethodAccess addCookieCall
where
  // Find cookie.setSecure(false) calls
  (
    setSecureCall.getMethod() = setSecureMethod and
    setSecureMethod.hasName("setSecure") and
    setSecureCall.getArgument(0).(BooleanLiteral).getValue() = false and
    setSecureCall.getQualifier() = cookie
  )
  or
  // Find cases where secure flag is not set before addCookie
  (
    addCookieCall.getMethod() = addCookieMethod and
    addCookieMethod.hasName("addCookie") and
    addCookieCall.getArgument(0) = cookie and
    not exists(
      MethodAccess secureCall |
      secureCall.getMethod().hasName("setSecure") and
      secureCall.getQualifier() = cookie and
      secureCall.getArgument(0).(BooleanLiteral).getValue() = true
    ) and
    not exists(
      MethodAccess fromCall |
      fromCall.getMethod().hasName("from") and
      fromCall.getQualifier().getType().hasQualifiedName("javax.servlet.http", "Cookie") and
      fromCall.getAnArgument() = cookie
    )
  )
select addCookieCall, "A cookie was detected without setting the 'secure' flag. " +
  "The 'secure' flag for cookies prevents the client from transmitting the " +
  "cookie over insecure channels such as HTTP. Set the 'secure' flag by " +
  "calling 'setSecure(true)' on the cookie."
