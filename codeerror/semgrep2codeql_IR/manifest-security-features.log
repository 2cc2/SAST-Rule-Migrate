Rule Content:
/**
 * @name Manifest usesCleartextTraffic=true
 * @description The Android manifest is configured to allow non-encrypted connections. 
 * Evaluate if this is necessary for your app, and disable it if appropriate. 
 * This flag is ignored on Android 7 (API 24) and above if a Network Security Config is present.
 * @kind problem
 * @problem.severity warning
 * @id android/manifest-usesCleartextTraffic-true
 * @tags security
 *       android
 *       best-practice
 */
import java
import Xml

from XmlFile file, XmlElement attr
where 
  file.getExtension() = "xml" and
  attr.getName() = "android:usesCleartextTraffic" and
  attr.getValue() = "true" and
  not attr.isInComment()
select attr, "The Android manifest is configured to allow non-encrypted connections."

/**
 * @name Manifest usesCleartextTraffic ignored by NSC
 * @description Manifest uses both `android:usesCleartextTraffic` and Network Security Config. 
 * The `usesCleartextTraffic` directive is ignored on Android 7 (API 24) and above if a Network Security Config is present.
 * @kind problem
 * @problem.severity warning
 * @id android/manifest-usesCleartextTraffic-ignored-by-nsc
 * @tags security
 *       android
 *       best-practice
 */
import java
import Xml

from XmlFile file, XmlElement cleartextAttr, XmlElement nscAttr
where 
  file.getExtension() = "xml" and
  (
    (cleartextAttr.getName() = "android:usesCleartextTraffic" and
     nscAttr.getName() = "android:networkSecurityConfig") or
    (cleartextAttr.getName() = "android:networkSecurityConfig" and
     nscAttr.getName() = "android:usesCleartextTraffic")
  ) and
  cleartextAttr.getParent() = nscAttr.getParent() and
  not cleartextAttr.isInComment() and
  not nscAttr.isInComment()
select cleartextAttr, "Manifest uses both `android:usesCleartextTraffic` and Network Security Config."
