/**
 * @name Dangerous Spring Actuator endpoints enabled in YAML configuration
 * @description Detects when dangerous Spring Actuator endpoints (prometheus, logfile) are exposed in YAML configuration
 * @kind problem
 * @id spring-actuator-dangerous-endpoints-enabled-yaml
 * @severity error
 */

import java
import DataFlow::PathGraph

from ConfigurationFile config, DataFlow::PathNode source, DataFlow::PathNode sink
where
  config.getKey() = "management.endpoints.web.exposure.include" and
  (
    config.getValue().matches("*prometheus*") or
    config.getValue().matches("*logfile*")
  ) and
  not config.getValue().matches("*health*") and
  DataFlow::localFlow(source, sink)
select sink, "Dangerous Spring Actuator endpoints enabled in YAML configuration"
