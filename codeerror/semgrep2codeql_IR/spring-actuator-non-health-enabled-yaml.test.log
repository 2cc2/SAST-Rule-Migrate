/**
 * @name Dangerous Spring Actuator endpoints enabled in YAML configuration
 * @description Detects when dangerous Spring Actuator endpoints (prometheus, logfile) are exposed in YAML configuration
 * @kind problem
 * @id java/spring/dangerous-actuator-endpoints
 * @severity error
 */

import java
import yaml

from YamlKeyValue kv
where
  kv.getKey() = "management.endpoints.web.exposure.include" and
  (
    kv.getValue().matches("%prometheus%") or
    kv.getValue().matches("%logfile%")
  ) and
  not kv.getValue().matches("%health%")
select kv, "Dangerous Spring Actuator endpoints enabled in YAML configuration"
