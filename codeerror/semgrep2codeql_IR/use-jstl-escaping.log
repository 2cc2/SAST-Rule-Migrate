Rule Content:
/**
 * @name Use JSTL escaping
 * @description Detected an Expression Language segment in a tag that does not escape output.
 *              This is dangerous because if any data in this expression can be controlled externally,
 *              it is a cross-site scripting vulnerability. Instead, use the 'out' tag from the JSTL taglib
 *              to escape this expression.
 * @kind problem
 * @problem.severity warning
 * @id java/use-jstl-escaping
 * @tags security
 *   owasp: a3
 *   cwe: 116
 * @precision low
 * @references
 *   https://www.tutorialspoint.com/jsp/jstl_core_out_tag.htm
 *   https://stackoverflow.com/a/4948856
 *   https://stackoverflow.com/a/3180202
 */

import java
import Regex

from JspTag tag, RegexMatch match
where
  // Match JSP tags containing EL expressions that don't use JSTL out tag
  match = regexMatch(/<(?![A-Za-z0-9]+:out).*?\$\{.*?\}.*>/, tag.getContent()) and
  // Ensure we're only checking JSP files
  tag.getFile().getExtension() = "jsp"
select tag, "Found unescaped Expression Language segment. Use JSTL 'out' tag to properly escape output."
