/**
 * @name Cookie missing HttpOnly flag
 * @description Detects cookies that are not set with the HttpOnly flag.
 * @kind problem
 * @problem.severity warning
 * @id java/cookie-missing-httponly
 * @tags security
 *       external/cwe/cwe-1004
 *       external/owasp/a05:2021
 *       external/asvs/V3:3.4.2
 */

import java

// Pattern 1: Detects direct cookie creation without HttpOnly flag
from MethodAccess setValue, MethodAccess addCookie, Expr cookie
where
  setValue.getMethod().getName() = "setValue" and
  setValue.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
  cookie = setValue.getQualifier() and
  not exists(MethodAccess ma |
    ma.getMethod().getName() = "setHttpOnly" and
    ma.getQualifier() = cookie
  ) and
  addCookie.getMethod().getName() = "addCookie" and
  addCookie.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
  addCookie.getArgument(0) = cookie
select addCookie, "A cookie was detected without setting the 'HttpOnly' flag."

// Pattern 2: Detects ResponseCookie.from() pattern without HttpOnly flag
from MethodAccess fromMethod, MethodAccess addCookie, Expr cookie
where
  fromMethod.getMethod().getName() = "from" and
  fromMethod.getMethod().getDeclaringType().hasQualifiedName("org.springframework.http", "ResponseCookie") and
  cookie = fromMethod and
  not exists(MethodAccess ma |
    ma.getMethod().getName() = "httpOnly" and
    ma.getQualifier().getType().hasQualifiedName("org.springframework.http", "ResponseCookie$Builder")
  ) and
  addCookie.getMethod().getName() = "addCookie" and
  addCookie.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
  addCookie.getArgument(0) = cookie
select addCookie, "A cookie was detected without setting the 'HttpOnly' flag."

// Pattern 3: Detects explicit setHttpOnly(false)
from MethodAccess setHttpOnly, MethodAccess addCookie
where
  setHttpOnly.getMethod().getName() = "setHttpOnly" and
  setHttpOnly.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
  setHttpOnly.getArgument(0).(BooleanLiteral).getValue() = false and
  addCookie.getMethod().getName() = "addCookie" and
  addCookie.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
  addCookie.getArgument(0) = setHttpOnly.getQualifier()
select setHttpOnly, "A cookie was explicitly set with 'HttpOnly=false' which is insecure."
