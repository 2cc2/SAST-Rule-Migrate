/**
 * @name Insecure Cookie setSecure
 * @description Detects when cookie's setSecure is not set to true, which could lead to sensitive data exposure over unencrypted connections.
 * @kind problem
 * @problem.severity warning
 * @id java/cookie-setSecure
 * @tags security
 *       external/cwe/cwe-319
 *       external/owasp/a03
 *       external/owasp/a02
 */

import java

class InsecureCookie extends MethodAccess {
  InsecureCookie() {
    exists(Method m |
      this.getMethod() = m and
      m.getName() = "setSecure" and
      this.getAnArgument().(BooleanLiteral).getValue() = false and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
    )
  }
}

class SecureCookie extends MethodAccess {
  SecureCookie() {
    exists(Method m |
      this.getMethod() = m and
      m.getName() = "setSecure" and
      this.getAnArgument().(BooleanLiteral).getValue() = true and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
    )
  }
}

from InsecureCookie ic, MethodAccess cookieCreation
where
  exists(ConstructorCall cc |
    cc.getConstructedType().hasQualifiedName("javax.servlet.http", "Cookie") and
    cookieCreation.getQualifier().getAChild*() = cc
  ) and
  not exists(SecureCookie sc |
    sc.getQualifier() = ic.getQualifier()
  )
select ic, "Default session middleware settings: `setSecure` not set to true. This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks."
