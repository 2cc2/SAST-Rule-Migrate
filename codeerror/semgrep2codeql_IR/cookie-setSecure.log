/**
 * @name Insecure Cookie Secure Flag
 * @description Detects when a cookie is created without the secure flag set to true,
 *              which could lead to sensitive data exposure over unencrypted connections.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-cookie-secure-flag
 * @tags security
 *       external/cwe/cwe-319
 *       external/owasp/a03
 *       external/owasp/a02
 */

import java

class InsecureCookie extends MethodAccess {
  InsecureCookie() {
    exists(Method m |
      m.getName() = "setSecure" and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.getMethod() = m and
      this.getAnArgument().(BooleanLiteral).getValue() = false
    )
  }
}

class SecureCookie extends MethodAccess {
  SecureCookie() {
    exists(Method m |
      m.getName() = "setSecure" and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.getMethod() = m and
      this.getAnArgument().(BooleanLiteral).getValue() = true
    )
  }
}

from MethodAccess cookieCreation, InsecureCookie insecureSet
where
  exists(MethodAccess newCookie |
    newCookie.getMethod().getName() = "<init>" and
    newCookie.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    newCookie.getQualifier() = cookieCreation.getQualifier() and
    insecureSet.getQualifier() = cookieCreation.getQualifier()
  ) and
  not exists(SecureCookie secureSet |
    secureSet.getQualifier() = cookieCreation.getQualifier()
  )
select insecureSet, "Default session middleware settings: `setSecure` not set to true. " +
  "This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks."
