/**
 * @name Path Traversal from HTTP Request
 * @description Detected input from a HTTPServletRequest going into a file operation.
 *              This could lead to path traversal if variables are not properly sanitized.
 * @kind path-problem
 * @problem.severity error
 * @id java/path-traversal-from-http-request
 * @tags security
 *       external/cwe/cwe-22
 *       external/owasp/a01
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class ServletSource extends DataFlow::Node {
  ServletSource() {
    exists(MethodAccess ma |
      (ma.getCallee().getName() = "getCookies" or
       ma.getCallee().getName() = "getValue") and
      (ma.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") or
       ma.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")) and
      this.asExpr() = ma
    )
    or
    exists(ArrayAccess aa |
      aa.getArray().getType() instanceof RefType and
      aa.getArray().getType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      this.asExpr() = aa
    )
  }
}

class FileOperationSink extends DataFlow::Node {
  FileOperationSink() {
    exists(ConstructorCall cc |
      (cc.getConstructedType().hasQualifiedName("java.io", "FileInputStream") or
       cc.getConstructedType().hasQualifiedName("java.io", "File") or
       cc.getConstructedType().hasQualifiedName("java.io", "FileOutputStream")) and
      this.asExpr() = cc.getAnArgument()
    )
  }
}

class FilenameUtilsSanitizer extends DataFlow::Node {
  FilenameUtilsSanitizer() {
    exists(MethodAccess ma |
      ma.getCallee().getName() = "getName" and
      ma.getCallee().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
      this.asExpr() = ma
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof ServletSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof FileOperationSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FilenameUtilsSanitizer
  }
}

from PathTraversalConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential path traversal from untrusted HTTP request"
