import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class ServletSource extends DataFlow::Node {
  ServletSource() {
    exists(MethodAccess ma |
      (ma.getCallee().getName() = "getCookies" or
       exists(MethodAccess cookieGetValue |
         cookieGetValue.getCallee().getName() = "getValue" and
         cookieGetValue.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
         this.asExpr() = cookieGetValue
       )) and
      ma.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      this.asExpr() = ma
    )
    or
    exists(ArrayAccess aa |
      aa.getArray().getType() instanceof RefType and
      this.asExpr() = aa
