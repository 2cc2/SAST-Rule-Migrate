Rule Content:
/**
 * @name Path Traversal in File Operations
 * @description Detected a potential path traversal. A malicious actor could control the location of this file, 
 *              to include going backwards in the directory with '../'. To address this, ensure that user-controlled 
 *              variables in file paths are sanitized. You may also consider using a utility method such as 
 *              org.apache.commons.io.FilenameUtils.getName(...) to only retrieve the file name from the path.
 * @kind path-problem
 * @problem.severity error
 * @id java/path-traversal
 * @tags security
 *       external/cwe/cwe-22
 *       external/owasp/a05:2017
 *       external/owasp/a01:2021
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma | 
      ma.getMethod().hasQualifiedName("javax.servlet.http.Cookie", "getValue") and
      source.asExpr() = ma
    )
    or
    exists(Parameter p |
      p.getType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      source.asParameter() = p
    )
    or
    exists(ArrayAccess aa | source.asExpr() = aa)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc |
      (cc.getConstructedType().hasQualifiedName("java.io", "File") or
       cc.getConstructedType().hasQualifiedName("java.io", "FileOutputStream") or
       cc.getConstructedType().hasQualifiedName("java.io", "FileInputStream")) and
      sink.asExpr() = cc
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.apache.commons.io", "FilenameUtils", "getName") and
      sanitizer.asExpr() = ma
    )
  }
}

