import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, MethodAccess ma |
      m.hasQualifiedName("javax.servlet.http.Cookie", "getValue") and
      ma.getMethod() = m and
      source.asExpr() = ma
    )
    or
    exists(Parameter p |
      p.getType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      source.asParameter() = p
    )
    or
    exists(ArrayAccess aa | source.asExpr() = aa)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Constructor c, ConstructorCall cc |
      (c.getDeclaringType().hasQualifiedName("java.io", "File") or
       c.getDeclaringType().hasQualifiedName("java.io", "FileOutputStream") or
       c.getDeclaringType().hasQualifiedName("java.io", "FileInputStream")) and
      cc.getConstructor() = c and
      sink.asExpr() = cc
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Method m, MethodAccess ma |
      m.hasQualifiedName("org.apache.commons.io", "FilenameUtils", "getName") and
      ma.getMethod() = m and
      sanitizer.asExpr() = ma
    )
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink, "Potential path traversal vulnerability from $@ to $@.",
  source, "user input", sink, "file operation"
