Rule Content:
/**
 * @name Tainted SQL Injection in AWS Lambda
 * @description Detected SQL statement that is tainted by $EVENT object. This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sqli
 * @tags security
 *       sql
 *       java
 *       aws-lambda
 *       cwe-89
 *       owasp-a01
 *       owasp-a03
 *       cwe-top25
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.aws.AWSLambda

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Method m | 
      (m.getName().matches("handleRequest%") or m.getName().matches("handle%")) and
      (
        exists(Parameter p | 
          p = m.getParameter(0) and
          (p.getType().getName() = "APIGatewayProxyRequestEvent" or
           p.getType().getName() = "InputStream") and
          this.asParameter() = p
        )
      )
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("execute%") or
       ma.getMethod().getName().matches("query%") or
       ma.getMethod().getName().matches("executeUpdate%") or
       ma.getMethod().getName().matches("batchUpdate%")) and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Statement") and
      this.asExpr() = ma.getArgument(0)
    )
    or
    exists(StringLiteral sl |
      sl.getString().matches("SELECT%") or
      sl.getString().matches("INSERT%") or
      sl.getString().matches("UPDATE%") and
      exists(MethodAccess ma |
        ma.getMethod().getName().matches("execute%") or
        ma.getMethod().getName().matches("query%") or
        ma.getMethod().getName().matches("executeUpdate%") or
        ma.getMethod().getName().matches("batchUpdate%") and
        this.asExpr() = sl
      )
    )
  }
}

class TaintedSqlFlowConfiguration extends TaintTracking::Configuration {
  TaintedSqlFlowConfiguration() { this = "TaintedSqlFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlSink
  }
}

from TaintedSqlFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential SQL injection vulnerability. User input from Lambda event flows into SQL statement without proper sanitization."
