Rule Content:
/**
 * @name JDBC SQL Injection
 * @description Detects potential SQL injection vulnerabilities in JDBC queries where strings are concatenated or formatted
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sql-formatted-string
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 *       external/asvs/V5:5.3.5
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Jdbc

class JdbcTemplateSource extends DataFlow::Node {
  JdbcTemplateSource() {
    exists(ConstructorCall c |
      c.getConstructedType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      this.asExpr() = c
    )
  }
}

class JdbcSink extends DataFlow::Node {
  JdbcSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["queryForObject", "queryForList", "update", "execute", "insert"] and
      ma.getQualifier().getType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class JdbcTaintConfig extends TaintTracking::Configuration {
  JdbcTaintConfig() { this = "JdbcTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof JdbcTemplateSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JdbcSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // Propagate taint through string operations
    exists(StringConcatenation sc | sc.getAnOperand() = pred.asExpr() and succ.asExpr() = sc) or
    exists(MethodAccess fmt | 
      fmt.getMethod().getName() = "format" and
      fmt.getQualifier().getType().hasQualifiedName("java.lang", "String") and
      (pred.asExpr() = fmt.getAnArgument() or pred.asExpr() = fmt.getQualifier()) and
      succ.asExpr() = fmt
    ) or
    exists(MethodAccess sb | 
      sb.getMethod().getName() in ["append", "toString"] and
      sb.getQualifier().getType().hasQualifiedName("java.lang", "StringBuilder") and
      pred.asExpr() = sb.getAnArgument() and
      succ.asExpr() = sb
    )
  }
}

from JdbcTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Possible JDBC injection detected. Use parameterized queries instead of concatenating or formatting strings."
