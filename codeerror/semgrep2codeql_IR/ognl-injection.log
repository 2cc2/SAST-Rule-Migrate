Rule Content:
/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-094
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class OgnlInjectionConfig extends TaintTracking::Configuration {
  OgnlInjectionConfig() { this = "OgnlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      p.getType().hasName("String") and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, Call call |
      m.hasQualifiedName(
        ["OgnlReflectionProvider", "ReflectionProvider", "TextParseUtil", 
         "TextParser", "OgnlTextParser", "OgnlUtil", "VelocityStrutsUtil",
         "StrutsUtil", "OgnlTool", "ValueStack"],
        ["getGetMethod", "getSetMethod", "getField", "setProperties", 
         "setProperty", "getValue", "setValue", "translateVariables",
         "translateVariablesCollection", "shallBeIncluded", "commaDelimitedStringToSet",
         "evaluate", "callMethod", "compile", "isTrue", "findString", "findValue",
         "getText", "makeSelectList", "setParameter"]
      ) and
      call.getMethod() = m and
      (sink.asExpr() = call.getArgument(1) or sink.asExpr() = call.getArgument(2))
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral sl | node.asExpr() = sl) or
    exists(Variable v, StringLiteral sl | 
      node.asExpr() = v.getAnAccess() and
      v.getInitializer() = sl
    )
  }
}

