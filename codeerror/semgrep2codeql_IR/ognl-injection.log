Rule Content:
/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-094
 *       external/owasp/a03
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class OgnlInjectionConfig extends TaintTracking::Configuration {
  OgnlInjectionConfig() { this = "OgnlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Parameter p |
      m.getAParameter() = p and
      p.getType().hasName("String") and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (ma.getMethod().hasQualifiedName("OgnlReflectionProvider", "getGetMethod") or
       ma.getMethod().hasQualifiedName("OgnlReflectionProvider", "getSetMethod") or
       ma.getMethod().hasQualifiedName("OgnlReflectionProvider", "getField") or
       ma.getMethod().hasQualifiedName("OgnlReflectionProvider", "setProperties") or
       ma.getMethod().hasQualifiedName("OgnlReflectionProvider", "setProperty") or
       ma.getMethod().hasQualifiedName("OgnlReflectionProvider", "getValue") or
       ma.getMethod().hasQualifiedName("OgnlReflectionProvider", "setValue") or
       ma.getMethod().hasQualifiedName("ReflectionProvider", "getGetMethod") or
       ma.getMethod().hasQualifiedName("ReflectionProvider", "getSetMethod") or
       ma.getMethod().hasQualifiedName("ReflectionProvider", "getField") or
       ma.getMethod().hasQualifiedName("ReflectionProvider", "setProperties") or
       ma.getMethod().hasQualifiedName("ReflectionProvider", "setProperty") or
       ma.getMethod().hasQualifiedName("ReflectionProvider", "getValue") or
       ma.getMethod().hasQualifiedName("ReflectionProvider", "setValue") or
       ma.getMethod().hasQualifiedName("TextParseUtil", "translateVariables") or
       ma.getMethod().hasQualifiedName("TextParseUtil", "translateVariablesCollection") or
       ma.getMethod().hasQualifiedName("TextParseUtil", "shallBeIncluded") or
       ma.getMethod().hasQualifiedName("TextParseUtil", "commaDelimitedStringToSet") or
       ma.getMethod().hasQualifiedName("TextParser", "evaluate") or
       ma.getMethod().hasQualifiedName("OgnlTextParser", "evaluate") or
       ma.getMethod().hasQualifiedName("OgnlUtil", "setProperties") or
       ma.getMethod().hasQualifiedName("OgnlUtil", "setProperty") or
       ma.getMethod().hasQualifiedName("OgnlUtil", "getValue") or
       ma.getMethod().hasQualifiedName("OgnlUtil", "setValue") or
       ma.getMethod().hasQualifiedName("OgnlUtil", "callMethod") or
       ma.getMethod().hasQualifiedName("OgnlUtil", "compile") or
       ma.getMethod().hasQualifiedName("VelocityStrutsUtil", "evaluate") or
       ma.getMethod().hasQualifiedName("StrutsUtil", "isTrue") or
       ma.getMethod().hasQualifiedName("StrutsUtil", "findString") or
       ma.getMethod().hasQualifiedName("StrutsUtil", "findValue") or
       ma.getMethod().hasQualifiedName("StrutsUtil", "getText") or
       ma.getMethod().hasQualifiedName("StrutsUtil", "translateVariables") or
       ma.getMethod().hasQualifiedName("StrutsUtil", "makeSelectList") or
       ma.getMethod().hasQualifiedName("OgnlTool", "findValue") or
       ma.getMethod().hasQualifiedName("ValueStack", "findString") or
       ma.getMethod().hasQualifiedName("ValueStack", "findValue") or
       ma.getMethod().hasQualifiedName("ValueStack", "setValue") or
       ma.getMethod().hasQualifiedName("ValueStack", "setParameter")) and
      (sink.asExpr() = ma.getArgument(1) or sink.asExpr() = ma.getArgument(2))
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node.getType() instanceof StringLiteral or
    exists(Variable v | node.asExpr() = v.getAnAccess() and v.getInitializer() instanceof StringLiteral)
  }
}

from OgnlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "A expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."
