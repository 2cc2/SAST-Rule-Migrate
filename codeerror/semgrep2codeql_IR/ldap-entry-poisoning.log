 * @tags security
 *       external/cwe/cwe-090
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 * @problem.severity warning
 */

import java

from ConstructorCall cc, Expr assign, MethodAccess ma
where
  cc.getConstructedType().hasQualifiedName("javax.naming.directory", "SearchControls") and
  (
    // Case 1: Direct instantiation with returningObjFlag set to true
    (cc.getArgument(4).(Literal).getValue().toInt() = 1) or
    // Case 2: Indirect instantiation with setReturningObjFlag(true)
    (
      ma.getMethod().hasName("setReturningObjFlag") and
      ma.getQualifier() = assign.getVariable().getAnAccess() and
      assign.getAChildExpr() = cc and
      ma.getArgument(0).(Literal).getValue().toString() = "true"
    )
  )
select cc, "An object-returning LDAP search will allow attackers to control the LDAP response. This could lead to Remote Code Execution."
