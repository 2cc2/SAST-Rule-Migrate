Rule Content:
/**
 * @name Tainted session from HTTP request
 * @description Detected input from a HTTPServletRequest going into a session command, like `setAttribute`.
 *              User input into such a command could lead to an attacker inputting malicious code into your
 *              session parameters, blurring the line between what's trusted and untrusted, and therefore
 *              leading to a trust boundary violation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-session-from-http-request
 * @tags security
 *       external/cwe/cwe-501
 *       external/owasp/a04
 *       external/cwe/cwe-20
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class HttpServletRequestSource extends DataFlow::Node {
  HttpServletRequestSource() {
    // Source 1: HttpServletRequest method calls (excluding getSession)
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      not ma.getMethod().getName() = "getSession" and
      this.asExpr() = ma
    )
    or
    // Source 2: Cookie.getValue in a loop after getCookies
    exists(MethodAccess ma, ForStmt loop |
      ma.getMethod().hasQualifiedName("javax.servlet.http", "Cookie", "getValue") and
      ma.getQualifier().getType().hasQualifiedName("javax.servlet.http", "Cookie") and
      loop.getBody().getAChild*() = ma and
      exists(DataFlow::Node getCookies |
        getCookies.asExpr().(MethodAccess).getMethod().hasQualifiedName("javax.servlet.http", "HttpServletRequest", "getCookies") and
        getCookies.asExpr().getParent().(VariableAccess).getTarget().getType() instanceof ArrayType and
        getCookies.getASuccessor*() = ma.getQualifier()
      ) and
      this.asExpr() = ma
    )
    or
    // Source 3: Array access from HttpServletRequest parameters
    exists(ArrayAccess aa, MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      ma.getMethod().getName().matches("get%") and
      ma.getParent() instanceof VariableAccess and
      aa.getArray().getAChild*() = ma.getParent() and
      this.asExpr() = aa
    )
    or
    // Source 4: URLDecoder.decode after getHeaders
    exists(MethodAccess decode, DataFlow::Node headers |
      decode.getMethod().hasQualifiedName("java.net", "URLDecoder", "decode") and
      headers.asExpr().(MethodAccess).getMethod().hasQualifiedName("javax.servlet.http", "HttpServletRequest", "getHeaders") and
      headers.getASuccessor*() = decode.getAnArgument() and
      this.asExpr() = decode
    )
  }
}

class SessionSink extends DataFlow::Node {
  SessionSink() {
    exists(MethodAccess ma |
      (ma.getMethod().hasQualifiedName("javax.servlet.http", "HttpSession", "putValue") or
       ma.getMethod().hasQualifiedName("javax.servlet.http", "HttpSession", "setAttribute")) and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class TaintedSessionFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedSessionFromHttpRequestConfig() { this = "TaintedSessionFromHttpRequestConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpServletRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SessionSink }
}

from TaintedSessionFromHttpRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected input from a HTTPServletRequest going into a session command. User input into such a command could lead to trust boundary violation."
