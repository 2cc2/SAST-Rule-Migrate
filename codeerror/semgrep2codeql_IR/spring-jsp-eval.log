Rule Content:
/**
 * @name Spring JSP Eval Injection
 * @description Detects Spring expression evaluation in JSP files that may lead to code injection.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision low
 * @id spring-jsp-eval
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 *       external/cwe/cwe-094
 */

import java
import Jsp

from Jsp::TaglibInvocation taglib
where taglib.getNamespace() = "spring" 
  and taglib.getTagName() = "eval"
  and exists(taglib.getAttribute("expression"))
select taglib, "A Spring expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."
