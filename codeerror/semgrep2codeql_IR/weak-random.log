Rule Content:
/**
 * @name Weak Random Number Generator
 * @description Detected use of the functions `Math.random()` or `java.util.Random()`. These are both not cryptographically strong random number generators (RNGs). If you are using these RNGs to create passwords or secret tokens, use `java.security.SecureRandom` instead.
 * @kind problem
 * @id java/weak-random
 * @tags security
 *   - owasp-a02
 *   - cwe-330
 * @severity warning
 */

import java

// Match java.util.Random constructor calls
from Constructor c, MethodAccess ma
where
  c.getDeclaringType().hasQualifiedName("java.util", "Random") and
  ma.getMethod().getName() = "$FUNC" and
  ma.getQualifier() = c
select ma, "Use of java.util.Random(), which is not cryptographically strong. Consider using java.security.SecureRandom instead."

// Match Math.random() calls
from MethodAccess ma
where
  ma.getMethod().hasName("random") and
  ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Math")
select ma, "Use of Math.random(), which is not cryptographically strong. Consider using java.security.SecureRandom instead."
