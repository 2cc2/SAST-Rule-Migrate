Rule Content:
/**
 * @name DocumentBuilderFactory missing DOCTYPE declaration restriction
 * @description DOCTYPE declarations are enabled for this DocumentBuilderFactory. This is vulnerable to XML external entity attacks.
 * @kind path-problem
 * @problem.severity error
 * @id java/documentbuilderfactory-disallow-doctype-decl-missing
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 *       external/asvs/V5.5.2
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class DocumentBuilderFactoryCreation extends MethodAccess {
  DocumentBuilderFactoryCreation() {
    this.getMethod().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory", "newInstance")
  }
}

class UnsafeDocumentBuilderCreation extends MethodAccess {
  UnsafeDocumentBuilderCreation() {
    this.getMethod().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory", "newDocumentBuilder")
  }
}

class SafeFeatureSetting extends MethodAccess {
  SafeFeatureSetting() {
    (
      this.getMethod().hasName("setFeature") and
      (
        this.getArgument(0).(StringLiteral).getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
        this.getArgument(1).(BooleanLiteral).getValue() = true
        or
        (
          this.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-general-entities" and
          this.getArgument(1).(BooleanLiteral).getValue() = false
        )
        or
        (
          this.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-parameter-entities" and
          this.getArgument(1).(BooleanLiteral).getValue() = false
        )
      )
    )
  }
}

class DocumentBuilderFactoryTaintConfig extends TaintTracking::Configuration {
  DocumentBuilderFactoryTaintConfig() { this = "DocumentBuilderFactoryTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(DocumentBuilderFactoryCreation dbc |
      source.asExpr() = dbc and
      not exists(SafeFeatureSetting sfs |
        sfs.getQualifier().getARead() = source.asExpr() and
        sfs.getEnclosingCallable() = dbc.getEnclosingCallable()
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(UnsafeDocumentBuilderCreation udbc | sink.asExpr() = udbc)
  }
}

from DocumentBuilderFactoryTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "DOCTYPE declarations are enabled for this DocumentBuilderFactory. This is vulnerable to XML external entity attacks. " +
  "Disable this by setting the feature \"http://apache.org/xml/features/disallow-doctype-decl\" to true. " +
  "Alternatively, allow DOCTYPE declarations and only prohibit external entities declarations by setting " +
  "\"http://xml.org/sax/features/external-general-entities\" and \"http://xml.org/sax/features/external-parameter-entities\" to false."
