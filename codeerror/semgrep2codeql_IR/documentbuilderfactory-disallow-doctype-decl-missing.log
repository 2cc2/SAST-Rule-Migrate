/**
 * @name DocumentBuilderFactory missing DOCTYPE declaration restriction
 * @description DOCTYPE declarations are enabled for this DocumentBuilderFactory. This is vulnerable to XML external entity attacks.
 * @kind path-problem
 * @problem.severity error
 * @id java/documentbuilderfactory-disallow-doctype-decl-missing
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 *       external/asvs/V5.5.2
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class DocumentBuilderFactoryCreation extends Expr {
  DocumentBuilderFactoryCreation() {
    exists(Method m |
      m.hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory", "newInstance") and
      this = m.getACall()
    )
  }
}

class UnsafeDocumentBuilderCreation extends Expr {
  UnsafeDocumentBuilderCreation() {
    exists(Method m |
      m.hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory", "newDocumentBuilder") and
      this = m.getACall()
    )
  }
}

class SafeFeatureSetting extends Expr {
  SafeFeatureSetting() {
    exists(Method m, Call setFeatureCall |
      m.hasName("setFeature") and
      setFeatureCall.getCallee() = m and
      (
        (setFeatureCall.getArgument(0).(StringLiteral).getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
         setFeatureCall.getArgument(1).(BooleanLiteral).getValue() = true)
        or
        (setFeatureCall.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-general-entities" and
         setFeatureCall.getArgument(1).(BooleanLiteral).getValue() = false)
        or
        (setFeatureCall.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-parameter-entities" and
         setFeatureCall.getArgument(1).(BooleanLiteral).getValue() = false)
      ) and
      this = setFeatureCall
    )
  }
}

class DocumentBuilderFactoryTaintConfig extends TaintTracking::Configuration {
  DocumentBuilderFactoryTaintConfig() { this = "DocumentBuilderFactoryTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(DocumentBuilderFactoryCreation dbc |
      source.asExpr() = dbc and
      not exists(SafeFeatureSetting sfs |
        sfs.getEnclosingCallable() = dbc.getEnclosingCallable() and
        exists(DataFlow::Node qualifier |
          qualifier.asExpr() = sfs.getImmediateQualifier() and
          qualifier.asExpr() = source.asExpr()
        )
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(UnsafeDocumentBuilderCreation udbc | sink.asExpr() = udbc)
  }
}

