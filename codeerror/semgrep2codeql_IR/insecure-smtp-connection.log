/**
 * @name Insecure SMTP connection
 * @description Detects insecure SMTP connections that trust any SSL certificate without proper verification.
 * @kind path-problem
 * @problem.severity warning
 * @id java/insecure-smtp-connection
 * @tags security
 *       external/cwe/cwe-297
 *       owasp-a07
 */

import java
import semmle.code.java.dataflow.FlowSources

class SimpleEmailCreation extends MethodAccess {
  SimpleEmailCreation() {
    exists(Method m | 
      m.hasName("SimpleEmail") and
      this.getMethod() = m
    )
  }
}

class SetSSLCheckServerIdentityCall extends MethodAccess {
  SetSSLCheckServerIdentityCall() {
    exists(Method m |
      m.hasName("setSSLCheckServerIdentity") and
      this.getMethod() = m and
      this.getArgument(0).(BooleanLiteral).getValue() = true
    )
  }
}

class SendCall extends MethodAccess {
  SendCall() {
    exists(Method m |
      m.hasName("send") and
      this.getMethod() = m
    )
  }
}

from 
  SimpleEmailCreation emailCreation,
  LocalVariableDeclaration emailVar,
  SendCall sendCall
where
  emailVar.getAnAccess() = emailCreation and
  not exists(SetSSLCheckServerIdentityCall checkCall |
    checkCall.getQualifier().getAChild*() = emailVar.getVariable() and
    checkCall.getEnclosingCallable() = sendCall.getEnclosingCallable()
  ) and
  sendCall.getQualifier().getAChild*() = emailVar.getVariable()
select sendCall, 
  "Insecure SMTP connection detected. This connection will trust any SSL certificate. " +
  "Enable certificate verification by setting 'email.setSSLCheckServerIdentity(true)'."
