Rule Content:
/**
 * @name Tainted SQL from HTTP request
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement. 
 *              This could lead to SQL injection if variables in the SQL statement are not 
 *              properly sanitized. Use parameterized SQL queries or properly sanitize user input instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sql-from-http-request
 * @tags security
 *       external/cwe/cwe-89
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.DataFlow

class HttpRequestSource extends DataFlow::Source {
  HttpRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getInputStream") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getParameter") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getParameterMap") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getParameterValues") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getReader") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getCookies") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getHeader") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getHeaderNames") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getHeaders") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getPart") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getParts") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.http.HttpServletRequest", "getQueryString") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getInputStream") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getParameter") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getParameterMap") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getParameterValues") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getReader") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getCookies") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getHeader") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getHeaderNames") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getHeaders") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getPart") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getParts") or
      ma.getMethod().hasQualifiedName(
        "javax.servlet.ServletRequest", "getQueryString")
      |
      this = ma
    )
  }
}

class SqlSink extends DataFlow::Sink {
  SqlSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("java.sql", "Statement", "execute") or
      ma.getMethod().hasQualifiedName("java.sql", "Statement", "executeQuery") or
      ma.getMethod().hasQualifiedName("java.sql", "Statement", "executeUpdate") or
      ma.getMethod().hasQualifiedName("java.sql", "Statement", "executeBatch") or
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
      ma.getMethod().hasQualifiedName("java.sql", "Connection", "prepareStatement") or
      ma.getMethod().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate", "queryForObject") or
      ma.getMethod().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate", "queryForMap") or
      ma.getMethod().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate", "batchUpdate")
      |
      this = ma.getAnArgument()
    )
  }
}

class TaintedSqlFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedSqlFromHttpRequestConfig() { this = "TaintedSqlFromHttpRequestConfig" }
  
  override predicate isSource(DataFlow::Source source) { source instanceof HttpRequestSource }
  
  override predicate isSink(DataFlow::Sink sink) { sink instanceof SqlSink }
}

from TaintedSqlFromHttpRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "Potential SQL injection from HTTP request parameter to SQL statement"
