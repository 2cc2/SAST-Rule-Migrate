/**
 * @name Tainted SQL from HTTP request
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement.
 *              This could lead to SQL injection if variables in the SQL statement are not 
 *              properly sanitized. Use parameterized SQL queries or properly sanitize user input instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sql-from-http-request
 * @tags security
 *       external/cwe/cwe-89
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.DataFlow

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(Method m, MethodAccess ma |
      (m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getInputStream") or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getParameter") or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getParameterMap") or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getParameterValues") or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getReader") or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getCookies") or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getHeader") or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getHeaderNames") or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getHeaders") or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getPart") or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getParts") or
       m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getQueryString") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getInputStream") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getParameter") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getParameterMap") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getParameterValues") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getReader") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getCookies") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getHeader") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getHeaderNames") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getHeaders") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getPart") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getParts") or
       m.hasQualifiedName("javax.servlet.ServletRequest", "getQueryString")) and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(Method m, MethodAccess ma |
      (m.hasQualifiedName("java.sql", "Statement", "execute") or
       m.hasQualifiedName("java.sql", "Statement", "executeQuery") or
       m.hasQualifiedName("java.sql", "Statement", "executeUpdate") or
       m.hasQualifiedName("java.sql", "Statement", "executeBatch") or
       m.getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
       m.hasQualifiedName("java.sql", "Connection", "prepareStatement") or
       m.hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate", "queryForObject") or
       m.hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate", "queryForMap") or
       m.hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate", "batchUpdate")) and
      ma.getMethod() = m and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

class TaintedSqlFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedSqlFromHttpRequestConfig() { this = "TaintedSqlFromHttpRequestConfig" }
  
  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }
  
  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }
}

from TaintedSqlFromHttpRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "Potential SQL injection from HTTP request parameter to SQL statement"
