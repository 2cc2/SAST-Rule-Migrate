Rule Content:
/**
 * @name Strings should not be compared with '=='
 * @description Using '==' for String comparison does reference comparison. Use '.equals()' instead.
 * @kind problem
 * @id java/no-string-eqeq
 * @tags correctness
 *   - java
 */

import java

from BinaryExpr expr
where expr.getOperator() = "=="
  and expr.getRightOperand().getType() instanceof StringType
  and not expr.getLeftOperand().isNull()
select expr, "Strings should not be compared with '=='. This is a reference comparison operator. Use '.equals()' instead."
