Rule Content:
/**
 * @name SpEL Injection
 * @description A Spring expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind problem
 * @problem.severity warning
 * @id java/spel-injection
 * @tags security
 *   external/cwe/cwe-94
 *   external/owasp/a03
 *   external/owasp/top10
 *   framework/spring
 */

import java
import semmle.code.java.dataflow.FlowSources

class SpELParser extends RefType {
  SpELParser() {
    this.hasQualifiedName("org.springframework.expression", "ExpressionParser") or
    this.hasQualifiedName("org.springframework.expression", "SpelExpressionParser") or
    this.hasQualifiedName("org.springframework.expression", "TemplateAwareExpressionParser")
  }
}

class SpELParseExpressionCall extends MethodAccess {
  SpELParseExpressionCall() {
    exists(Method m |
      m.getName() = "parseExpression" and
      m.getDeclaringType() instanceof SpELParser and
      this.getMethod() = m
    )
  }
}

predicate isDynamicArgument(Expr arg) {
  not exists(StringLiteral sl | arg = sl) and
  not exists(LocalVariableDecl lvd |
    arg instanceof VariableAccess and
    arg.asExpr().getVariable().getAnAccess() = arg and
    exists(lvd.getInitializer().getAChildExpr() |
      _ instanceof StringLiteral
    )
  )
}

from SpELParseExpressionCall call, Expr arg
where
  arg = call.getArgument(0) and
  isDynamicArgument(arg)
select call, "Potential SpEL injection vulnerability due to dynamic expression evaluation"
