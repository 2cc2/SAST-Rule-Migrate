Rule Content:
/**
 * @name Use of MD5 DigestUtils
 * @description Detected MD5 hash algorithm which is considered insecure. MD5 is not collision resistant and is therefore not suitable as a cryptographic signature. Use HMAC instead.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-md5-digest-utils
 * @tags security
 *   external/cwe/cwe-328
 *   external/owasp/a03:2017
 *   external/owasp/a02:2021
 */
import java

from MethodAccess ma, Method getMd5Method, Type digestUtilsType
where
  getMd5Method.hasName("getMd5Digest") and
  digestUtilsType.hasQualifiedName("org.apache.commons.codec.digest", "DigestUtils") and
  getMd5Method.getDeclaringType() = digestUtilsType and
  ma.getMethod() = getMd5Method
select ma, "Use of MD5 hash algorithm which is considered insecure. Use HMAC instead."
