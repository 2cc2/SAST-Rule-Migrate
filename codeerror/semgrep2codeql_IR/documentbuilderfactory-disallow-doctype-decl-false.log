Rule Content:
/**
 * @name DocumentBuilderFactory disallow-doctype-decl-false
 * @description DOCTYPE declarations are enabled for DocumentBuilderFactory. Without prohibiting external entity declarations, this is vulnerable to XML external entity attacks. Disable this by setting the feature "http://apache.org/xml/features/disallow-doctype-decl" to true. Alternatively, allow DOCTYPE declarations and only prohibit external entities declarations. This can be done by setting the features "http://xml.org/sax/features/external-general-entities" and "http://xml.org/sax/features/external-parameter-entities" to false.
 * @kind problem
 * @problem.severity error
 * @id java/documentbuilderfactory-disallow-doctype-decl-false
 * @tags security
 *       cwe
 *       cwe-611
 *       owasp
 *       owasp-a04
 *       owasp-a05
 *       xml
 *       external-entity
 *       cwe2021-top25
 *       cwe2022-top25
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isVulnerableDBF(MethodAccess ma) {
  exists(Method m |
    ma.getMethod() = m and
    m.getName() = "setFeature" and
    ma.getArgument(0).(StringLiteral).getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
    ma.getArgument(1).(BooleanLiteral).getValue() = false
  )
}

predicate hasMitigation(Method m) {
  exists(MethodAccess ma1, MethodAccess ma2 |
    ma1.getMethod().getName() = "setFeature" and
    ma1.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-general-entities" and
    ma1.getArgument(1).(BooleanLiteral).getValue() = false and
    ma2.getMethod().getName() = "setFeature" and
    ma2.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-parameter-entities" and
    ma2.getArgument(1).(BooleanLiteral).getValue() = false and
    m.getBody().getAChild*() = ma1 and
    m.getBody().getAChild*() = ma2
  )
  or
  exists(MethodAccess ma1, MethodAccess ma2 |
    ma1.getMethod().getName() = "setAttribute" and
    ma1.getArgument(0).(FieldAccess).getField().getName() = "ACCESS_EXTERNAL_DTD" and
    ma1.getArgument(1).(StringLiteral).getValue() = "" and
    ma2.getMethod().getName() = "setAttribute" and
    ma2.getArgument(0).(FieldAccess).getField().getName() = "ACCESS_EXTERNAL_SCHEMA" and
    ma2.getArgument(1).(StringLiteral).getValue() = "" and
    m.getBody().getAChild*() = ma1 and
    m.getBody().getAChild*() = ma2
  )
}

from MethodAccess ma, Method m
where
  isVulnerableDBF(ma) and
  m.getBody().getAChild*() = ma and
  not hasMitigation(m)
select ma, "DOCTYPE declarations are enabled for DocumentBuilderFactory. Without prohibiting external entity declarations, this is vulnerable to XML external entity attacks."
