import java
import semmle.code.java.dataflow.FlowSources

predicate isVulnerableDBF(MethodCall ma) {
  exists(Method m |
    ma.getMethod() = m and
    m.getName() = "setFeature" and
    ma.getArgument(0).(StringLiteral).getValue() = "http://apache.org/xml/features/disallow-doctype-decl" and
    ma.getArgument(1).(BooleanLiteral).getValue() = false
  )
}

predicate hasMitigation(Method m) {
  exists(MethodCall ma1, MethodCall ma2 |
    ma1.getMethod().getName() = "setFeature" and
    ma1.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-general-entities" and
    ma1.getArgument(1).(BooleanLiteral).getValue() = false and
    ma2.getMethod().getName() = "setFeature" and
    ma2.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-parameter-entities" and
    ma2.getArgument(1).(BooleanLiteral).getValue() = false and
    ma1.getEnclosingCallable() = m and
    ma2.getEnclosingCallable() = m
  )
  or
  exists(MethodCall ma1, MethodCall ma2 |
    ma1.getMethod().getName() = "setAttribute" and
    ma1.getArgument(0).(FieldAccess).getField().getName() = "ACCESS_EXTERNAL_DTD" and
    ma1.getArgument(1).(StringLiteral).getValue() = "" and
