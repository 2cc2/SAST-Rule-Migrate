Rule Content:
/**
 * @name JWT None Algorithm Usage
 * @description Detected use of the 'none' algorithm in a JWT token. The 'none' algorithm assumes the integrity of the token has already been verified. This would allow a malicious actor to forge a JWT token that will automatically be verified.
 * @kind problem
 * @problem.severity error
 * @id java/jjwt-none-alg
 * @tags security
 *       external/cwe/cwe-327
 *       external/owasp/a03
 *       external/owasp/a02
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class JwtBuilderCall extends DataFlow::Node {
  JwtBuilderCall() {
    exists(Method m |
      m.getName() = "builder" and
      m.getDeclaringType().hasQualifiedName("io.jsonwebtoken", "Jwts") and
      this.asExpr() = m.getACall()
    )
  }
}

class JwtSignWithCall extends DataFlow::Node {
  JwtSignWithCall() {
    exists(Method m |
      m.getName() = "signWith" and
      m.getDeclaringType().hasQualifiedName("io.jsonwebtoken", "JwtBuilder") and
      this.asExpr() = m.getACall()
    )
  }
}

class JwtNoneAlgorithmConfig extends TaintTracking::Configuration {
  JwtNoneAlgorithmConfig() { this = "JwtNoneAlgorithmConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof JwtBuilderCall }

  override predicate isSink(DataFlow::Node sink) {
    not exists(JwtSignWithCall signWith | 
      DataFlow::localFlow(DataFlow::exprNode(signWith.asExpr()), DataFlow::exprNode(sink.asExpr()))
    )
  }
}

from JwtNoneAlgorithmConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected use of the 'none' algorithm in a JWT token. The 'none' algorithm assumes the integrity of the token has already been verified. This would allow a malicious actor to forge a JWT token that will automatically be verified. Do not explicitly use the 'none' algorithm. Instead, use an algorithm such as 'HS256'."
