/**
 * @name Blowfish insufficient key size
 * @description Using less than 128 bits for Blowfish is considered insecure. Use 128 bits or more, or switch to use AES instead.
 * @kind problem
 * @problem.severity warning
 * @id java/blowfish-insufficient-key-size
 * @tags security
 *   audit
 *   cwe/326
 *   owasp/a03:2017
 *   owasp/a02:2021
 *   asvs/V6/6.2.5
 */
import java

from Method keyGenInit, Method getInstance, Literal size
where
  getInstance.getName() = "getInstance" and
  getInstance.getDeclaringType().hasQualifiedName("javax.crypto", "KeyGenerator") and
  getInstance.getACall().getArgument(0).(StringLiteral).getValue() = "Blowfish" and
  keyGenInit.getName() = "init" and
  keyGenInit.getDeclaringType().hasQualifiedName("javax.crypto", "KeyGenerator") and
  keyGenInit.getACall().getQualifier() = getInstance.getACall() and
  size = keyGenInit.getACall().getArgument(0) and
  size instanceof IntLiteral and
  size.getValue().toInt() < 128
select keyGenInit.getACall(), "Using less than 128 bits for Blowfish is considered insecure. Use 128 bits or more, or switch to use AES instead."
