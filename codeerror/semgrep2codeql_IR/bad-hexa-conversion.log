Rule Content:
/**
 * @name Bad Hexadecimal Conversion
 * @description "'Integer.toHexString()' strips leading zeroes from each byte if read byte-by-byte. This mistake weakens the hash value computed since it introduces more collisions. Use 'String.format(\"%02X\", ...)' instead."
 * @kind problem
 * @problem.severity warning
 * @id java/bad-hexa-conversion
 * @tags security
 *   - cwe/704
 *   - owasp/a03
 *   - external/cwe/cwe-704
 */

import java

from MethodAccess mdCall, MethodAccess hexCall, VariableDeclaration mdDecl
where
  // Match MessageDigest variable declaration
  mdDecl.getType().hasName("MessageDigest") and
  // Match digest() method call on MessageDigest instance
  mdCall.getMethod().hasName("digest") and
  mdCall.getQualifier() = mdDecl.getAVariable() and
  // Match Integer.toHexString() call
  hexCall.getMethod().hasName("toHexString") and
  hexCall.getQualifier().getType().hasName("Integer") and
  // Ensure they are in the same method
  exists(Method m | m.getBody() = mdDecl.getParent() and m.getBody() = mdCall.getParent() and m.getBody() = hexCall.getParent())
select hexCall, "Using 'Integer.toHexString()' for byte-to-hex conversion strips leading zeroes. Use 'String.format(\"%02X\", ...)' instead to preserve hash strength."
