Rule Content:
/**
 * @name Vertx SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @precision low
 * @id vertx-sqli
 * @tags security
 *       external/cwe/cwe-89
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class VertxSqlClient extends RefType {
  VertxSqlClient() {
    this.hasQualifiedName("io.vertx", "SqlClient") or
    this.hasQualifiedName("io.vertx", "SqlConnection")
  }
}

class SqlMethod extends Method {
  SqlMethod() {
    this.getName().matches("query|preparedQuery|prepare") and
    this.getDeclaringType().getASupertype() instanceof VertxSqlClient
  }
}

class StringConcatenation extends Expr {
  StringConcatenation() {
    exists(Method m | m.getName() = "concat" and this = m.getACall())
    or
    exists(BinaryOperation bo | 
      bo.getOperator() = "+" and
      bo.getLeftOperand().getType() instanceof TypeString and
      bo.getRightOperand().getType() instanceof TypeString and
      this = bo
    )
  }
}

class StringFormat extends Expr {
  StringFormat() {
    exists(Method m | 
      m.getName() = "format" and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      this = m.getACall()
    )
  }
}

class TaintedSqlString extends Expr {
  TaintedSqlString() {
    this instanceof StringConcatenation or
    this instanceof StringFormat
  }
}

class VertxSqlInjectionConfig extends TaintTracking::Configuration {
  VertxSqlInjectionConfig() { this = "VertxSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(TaintedSqlString tss | source.asExpr() = tss)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod() instanceof SqlMethod and
      sink.asExpr() = ma.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, VertxSqlInjectionConfig config
where config.hasFlowPath(source, sink)
select sink, "Potential SQL injection vulnerability due to un-sanitized input in SQL statement. Use prepared statements instead."
