Rule Content:
/**
 * @name Use of SHA-224
 * @description This code uses a 224-bit hash function, which is deprecated or disallowed in some security policies.
 *              Consider updating to a stronger hash function such as SHA-384 or higher to ensure compliance and security.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-sha224
 * @tags security
 *       owasp-a03:2017
 *       owasp-a02:2021
 *       cwe-328
 *       crypto
 *       java
 * @precision high
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isWeakHashAlgorithm(Expr algo) {
  algo instanceof StringLiteral and
  (
    algo.getStringValue().matches(".*224") or
    algo.getStringValue() = "SHA-224" or
    algo.getStringValue() = "SHA3-224" or
    algo.getStringValue() = "SHA512/224"
  )
}

from MethodAccess ma, Expr algo
where
  (
    // DigestUtils method calls
    (
      ma.getMethod().hasName(["getSha3_224Digest", "getSha512_224Digest", "sha3_224", "sha3_224Hex", "sha512_224", "sha512_224Hex"]) and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.codec.digest", "DigestUtils")
    )
    or
    // DigestUtils constructor with weak algorithms
    (
      ma.getMethod().hasName("<init>") and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.codec.digest", "DigestUtils") and
      ma.getArgument(0).(FieldAccess).getField().hasQualifiedName("org.apache.commons.codec.digest.MessageDigestAlgorithms", ["SHA_224", "SHA_512_224", "SHA3_224"])
    )
    or
    // MessageDigest.getInstance with weak algorithms
    (
      ma.getMethod().hasName("getInstance") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
      isWeakHashAlgorithm(algo) and
      ma.getArgument(0) = algo
    )
  )
select ma, "Use of 224-bit hash function $@ is deprecated or disallowed in some security policies. Consider updating to a stronger hash function such as SHA-384 or higher.",
  ma.getMethod(), "weak hash function"
