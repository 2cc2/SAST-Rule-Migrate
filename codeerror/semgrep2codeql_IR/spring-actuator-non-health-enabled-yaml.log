/**
 * @name Spring Actuator Dangerous Endpoints Enabled
 * @description Spring Boot Actuator is enabled with potentially dangerous endpoints.
 *              Depending on the actuator, this can pose a significant security risk.
 * @kind problem
 * @problem.severity warning
 * @id java/spring/actuator-dangerous-endpoints-enabled
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a01:2021
 *       cwe2021-top25
 * @precision medium
 * @references
 *   https://docs.spring.io/spring-boot/docs/current/reference/html/production-ready-features.html#production-ready-endpoints-exposing-endpoints
 *   https://medium.com/walmartglobaltech/perils-of-spring-boot-actuators-misconfiguration-185c43a0f785
 *   https://blog.maass.xyz/spring-actuator-security-part-1-stealing-secrets-using-spring-actuators
 */

import java
import yaml

predicate isDangerousActuator(string actuator) {
  not (actuator = "health" or actuator = "*")
}

from YamlFile yamlFile, YamlKeyValue includeKey, YamlSequence actuatorList, string actuator
where
  // Match Spring Boot Actuator configuration structure
  yamlFile.getPath().matches("%/application.yml") or
  yamlFile.getPath().matches("%/application.yaml") and
  exists(YamlKeyValue management | 
    management.getKey().getValue() = "management" and
    exists(YamlKeyValue endpoints |
      endpoints.getKey().getValue() = "endpoints" and
      exists(YamlKeyValue web |
        web.getKey().getValue() = "web" and
        exists(YamlKeyValue exposure |
          exposure.getKey().getValue() = "exposure" and
          includeKey.getKey().getValue() = "include" and
          actuatorList = includeKey.getValue() and
          actuator = actuatorList.getAnEntry().getValue() and
          isDangerousActuator(actuator)
        )
      )
    )
  )
select includeKey, "Spring Boot Actuator \"" + actuator + "\" is enabled. " +
  "Depending on the actuator, this can pose a significant security risk. " +
  "Please double-check if the actuator is needed and properly secured."
