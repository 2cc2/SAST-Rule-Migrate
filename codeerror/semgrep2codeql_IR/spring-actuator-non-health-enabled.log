/**
 * @name Spring Boot Actuators Dangerous Endpoints Enabled
 * @description Spring Boot Actuators are enabled with potentially dangerous endpoints exposed.
 * @kind problem
 * @problem.severity warning
 * @id java/spring/actuator-dangerous-endpoints-enabled
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a01
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.Spring.SpringBootProperties

from SpringBootProperty property, string actuatorValue
where
  property.getKey() = "management.endpoints.web.exposure.include" and
  property.getValue() = actuatorValue and
  not (actuatorValue = "health" or actuatorValue = "*")
select property, 
  "Spring Boot Actuators \"" + actuatorValue + "\" are enabled. Depending on the actuators, " +
  "this can pose a significant security risk. Please double-check if the actuators are needed and properly secured.",
  property.getLocation(),
  "management.endpoints.web.exposure.include"
