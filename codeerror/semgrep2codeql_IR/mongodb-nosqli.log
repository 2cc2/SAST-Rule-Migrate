/**
 * @name MongoDB NoSQL Injection via $where operator
 * @description Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator.
 * @id mongodb-nosqli
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision low
 * @tags security
 *       external/cwe/cwe-943
 *       external/owasp/a01
 *       external/owasp/a03
 *       nosql
 *       mongodb
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class MongoWhereInput extends DataFlow::Node {
  MongoWhereInput() {
    exists(MethodAccess ma |
      (
        // Pattern 1: BasicDBObject.put("$where", input)
        ma.getMethod().getName() = "put" and
        ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
        ma.getArgument(0).(StringLiteral).getValue() = "$where" and
        this.asExpr() = ma.getArgument(1)
      )
      or
      (
        // Pattern 2: BasicDBObject.append("$where", input)
        ma.getMethod().getName() = "append" and
        ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObject") and
        ma.getArgument(0).(StringLiteral).getValue() = "$where" and
        this.asExpr() = ma.getArgument(1)
      )
      or
      (
        // Pattern 3: new BasicDBObject("$where", input)
        exists(ConstructorCall cc |
          cc.getConstructedType().hasQualifiedName("com.mongodb", "BasicDBObject") and
          cc.getArgument(0).(StringLiteral).getValue() = "$where" and
          this.asExpr() = cc.getArgument(1)
        )
      )
      or
      (
        // Pattern 4: BasicDBObjectBuilder.add/append/start with "$where"
        ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb", "BasicDBObjectBuilder") and
        (
          ma.getMethod().getName() = "add" or
          ma.getMethod().getName() = "append" or
          ma.getMethod().getName() = "start"
        ) and
        ma.getArgument(0).(StringLiteral).getValue() = "$where" and
        this.asExpr() = ma.getArgument(1)
      )
    )
    and
    not this.asExpr().isConstant() // Ensure input is not constant
  }
}

class MongoWhereSink extends DataFlow::Node {
  MongoWhereSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "find" and
      ma.getMethod().getDeclaringType().hasQualifiedName("com.mongodb.client", "MongoCollection") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class MongoWhereTaintConfig extends TaintTracking::Configuration {
  MongoWhereTaintConfig() { this = "MongoWhereTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof MongoWhereInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MongoWhereSink
  }
}

from MongoWhereTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected non-constant data passed into a NoSQL query using the 'where' evaluation operator. " +
  "If this data can be controlled by an external user, this is a NoSQL injection. " +
  "Ensure data passed to the NoSQL query is not user controllable, or properly sanitize the data. " +
  "Ideally, avoid using the 'where' operator at all and instead use the helper methods provided by " +
  "com.mongodb.client.model.Filters with comparative operators such as eq, ne, lt, gt, etc."
