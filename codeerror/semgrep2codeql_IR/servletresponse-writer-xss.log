/**
 * @name ServletResponse writer XSS
 * @description Detects cross-site scripting in HttpServletResponse writer where user input flows directly from HttpServletRequest to output.
 * @kind path-problem
 * @problem.severity error
 * @id java/servletresponse-writer-xss
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletResponseWriterXSSConfig extends TaintTracking::Configuration {
  ServletResponseWriterXSSConfig() { this = "ServletResponseWriterXSSConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, MethodAccess ma |
      m.hasQualifiedName("javax.servlet.http.HttpServletRequest", "getParameter") and
      ma.getMethod() = m and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, MethodAccess ma |
      m.hasQualifiedName("javax.servlet.http.HttpServletResponse", "getWriter") and
      ma.getMethod() = m and
      exists(MethodAccess writeCall |
        writeCall.getQualifier() = ma and
        writeCall.getMethod().getName() = "write" and
        sink.asExpr() = writeCall.getArgument(0)
      )
    )
  }
}

from ServletResponseWriterXSSConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Cross-site scripting detected in HttpServletResponse writer. User input was detected going directly from the HttpServletRequest into output. Ensure your data is properly encoded using org.owasp.encoder.Encode.forHtml.",
  source.getNode(), sink.getNode(),
  "Unsanitized user input flows to HTTP response"
