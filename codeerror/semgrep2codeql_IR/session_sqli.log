/**
 * @name SQL String Concatenation
 * @description Detects SQL queries constructed via string concatenation with untrusted input
 * @kind path-problem
 * @problem.severity error
 * @id java/find-sql-string-concatenation
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class StringParameter extends DataFlow::Node {
  StringParameter() {
    exists(Method m, Parameter p |
      m = this.getEnclosingCallable() and
      p = this.asParameter() and
      p.getType().hasName("String") and
      p.getName() = "$X"
    )
  }
}

class PreparedStatementSink extends DataFlow::Node {
  PreparedStatementSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SessionVariable extends Variable {
  SessionVariable() {
    this.getType().hasQualifiedName("java.sql", "Session") and
    this.getName() = "$SESSION"
  }
}

class PreparedStatementVariable extends Variable {
  PreparedStatementVariable() {
    this.getType().hasQualifiedName("java.sql", "PreparedStatement") and
    this.getName() = "$PS"
  }
}

class ResultSetExecuteQuery extends MethodAccess {
  ResultSetExecuteQuery() {
    this.getMethod().getName() = "executeQuery" and
    this.getMethod().getDeclaringType().hasQualifiedName("java.sql", "ResultSet")
  }
}

class SqlConcatenationConfig extends TaintTracking::Configuration {
  SqlConcatenationConfig() { this = "SqlConcatenationConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof StringParameter }

  override predicate isSink(DataFlow::Node sink) { sink instanceof PreparedStatementSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      ma.getArgument(_) = node1.asExpr() and
      ma = node2.asExpr()
    )
  }
}

from SqlConcatenationConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink, Method m
where
  cfg.hasFlowPath(source, sink) and
  m = source.getNode().getEnclosingCallable() and
  exists(SessionVariable sv | sv.getEnclosingCallable() = m) and
  exists(PreparedStatementVariable pv | pv.getEnclosingCallable() = m) and
  exists(ResultSetExecuteQuery rq | rq.getEnclosingCallable() = m)
select sink.getNode(), source, sink, "In $METHOD, $X is used to construct a SQL query via string concatenation."
