Rule Content:
/**
 * @name SQL Query String Concatenation
 * @description Detects SQL queries constructed via string concatenation with user input.
 *              This could lead to SQL injection if variables are not properly sanitized.
 * @kind path-problem
 * @problem.severity error
 * @id java/sql-string-concatenation
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class StringConcatenationSource extends DataFlow::Node {
  StringConcatenationSource() {
    exists(Method m, Parameter p |
      m.getAParameter() = p and
      p.getType().hasName("String") and
      this.asParameter() = p
    )
  }
}

class SqlConcatenationSink extends DataFlow::Node {
  SqlConcatenationSink() {
    exists(MethodAccess ma |
      ma.getCallee().getName() = "prepareStatement" and
      ma.getCallee().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

class StringConcatenationTaintConfig extends TaintTracking::Configuration {
  StringConcatenationTaintConfig() { this = "StringConcatenationTaintConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof StringConcatenationSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    exists(StringConcatenationFlow flow |
      flow.getASource() = sink and
      flow.getASink() instanceof SqlConcatenationSink
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

class StringConcatenationFlow extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(BinaryExpr be |
      be.getOp() instanceof Add and
      (be.getLeftOperand() = pred.asExpr() or be.getRightOperand() = pred.asExpr()) and
      succ.asExpr() = be
    )
  }
}

from StringConcatenationTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "SQL query constructed via string concatenation with $@", 
  source.getNode(), "user input"
