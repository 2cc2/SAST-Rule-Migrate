/**
 * @name SQL String Concatenation Vulnerability
 * @description Detects SQL queries constructed via string concatenation with untrusted input
 * @kind path-problem
 * @problem.severity error
 * @id java/find-sql-string-concatenation
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class StringParameterSource extends DataFlow::Node {
  StringParameterSource() {
    exists(Method m, Parameter p |
      m.getAParameter() = p and
      p.getType().hasName("String") and
      this.asParameter() = p
    )
  }
}

class PreparedStatementSink extends DataFlow::Node {
  PreparedStatementSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SessionContext extends DataFlow::Node {
  SessionContext() {
    exists(Variable v |
      v.getType().hasQualifiedName("", "Session") and
      this.asExpr() = v.getAnAccess()
    )
  }
}

class PreparedStatementContext extends DataFlow::Node {
  PreparedStatementContext() {
    exists(Variable v |
      v.getType().hasQualifiedName("java.sql", "PreparedStatement") and
      this.asExpr() = v.getAnAccess()
    )
  }
}

class ResultSetExecuteContext extends DataFlow::Node {
  ResultSetExecuteContext() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "executeQuery" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "ResultSet") and
      this.asExpr() = ma
    )
  }
}

class SqlConcatenationConfig extends TaintTracking::Configuration {
  SqlConcatenationConfig() { this = "SqlConcatenationConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof StringParameterSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof PreparedStatementSink 
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      node1.asExpr() = ma.getAnArgument() and
      node2.asExpr() = ma
    )
  }
}

from SqlConcatenationConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink,
     SessionContext session, PreparedStatementContext ps, ResultSetExecuteContext rs
where 
  cfg.hasFlowPath(source, sink) and
  exists(Method m | m = source.getNode().getEnclosingCallable()) and
  exists(m.getAChild() | this = session or this = ps or this = rs)
select sink.getNode(), source, sink, 
  "In " + source.getNode().getEnclosingCallable().getName() + 
  ", " + source.getNode().toString() + 
  " is used to construct a SQL query via string concatenation."
