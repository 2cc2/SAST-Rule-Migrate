/**
 * @name SQL Query String Concatenation
 * @description Detects SQL queries constructed via string concatenation with method parameters.
 *              This could lead to SQL injection if variables are not properly sanitized.
 * @kind path-problem
 * @problem.severity error
 * @id java/sql-string-concatenation
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class MethodParameterSource extends DataFlow::Node {
  MethodParameterSource() {
    exists(Method m, Parameter p |
      m.getAParameter() = p and
      p.getType().hasName("String") and
      this.asParameter() = p
    )
  }
}

class SqlPreparedStatementSink extends DataFlow::Node {
  SqlPreparedStatementSink() {
    exists(MethodAccess ma |
      ma.getCallee().getName() = "prepareStatement" and
      ma.getCallee().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

class StringConcatenationStep extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node pred, DataFlow::Node succ) {
    exists(BinaryExpr be |
      be.getOp() instanceof Plus and
      (be.getLeftOperand() = pred.asExpr() or be.getRightOperand() = pred.asExpr()) and
      succ.asExpr() = be
    )
  }
}

class SqlStringConcatenationConfig extends TaintTracking::Configuration {
  SqlStringConcatenationConfig() { this = "SqlStringConcatenationConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof MethodParameterSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof SqlPreparedStatementSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringConcatenationStep step | step.step(pred, succ))
  }
}

from SqlStringConcatenationConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "SQL query constructed via string concatenation with $@", 
  source.getNode(), "method parameter"
