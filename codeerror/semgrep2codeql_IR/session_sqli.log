/**
 * @name SQL String Concatenation
 * @description Detects SQL queries constructed via string concatenation which may lead to SQL injection.
 * @kind path-problem
 * @problem.severity error
 * @id java/find-sql-string-concatenation
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class StringParameter extends DataFlow::Node {
  StringParameter() {
    exists(Method m, Parameter p |
      m.getAParameter() = p and
      p.getType().hasName("String") and
      this.asParameter() = p
    )
  }
}

class PreparedStatementSink extends DataFlow::Node {
  PreparedStatementSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class SessionVariable extends DataFlow::Node {
  SessionVariable() {
    exists(Variable v |
      v.getType().hasName("Session") and
      this.asVariable() = v
    )
  }
}

class PreparedStatementVariable extends DataFlow::Node {
  PreparedStatementVariable() {
    exists(Variable v |
      v.getType().hasName("PreparedStatement") and
      this.asVariable() = v
    )
  }
}

class ResultSetCall extends DataFlow::Node {
  ResultSetCall() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "executeQuery" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "ResultSet") and
      this.asExpr() = ma
    )
  }
}

class SqlConcatenationConfig extends TaintTracking::Configuration {
  SqlConcatenationConfig() { this = "SqlConcatenationConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof StringParameter }

  override predicate isSink(DataFlow::Node sink) { sink instanceof PreparedStatementSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodAccess ma |
      node1.asExpr() = ma.getAnArgument() and
      node2.asExpr() = ma
    )
  }

  override predicate isAdditionalFlowCondition(DataFlow::Node node) {
    exists(Method m |
      m.getAChild() = node.asExpr() and
      exists(SessionVariable sv | sv.getAUse() = node.asExpr()) and
      exists(PreparedStatementVariable pv | pv.getAUse() = node.asExpr()) and
      exists(ResultSetCall rc | rc.getEnclosingCallable() = m)
    )
  }
}

from SqlConcatenationConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection via string concatenation in $@", source.getNode(),
  "parameter"
