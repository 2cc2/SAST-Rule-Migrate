/**
 * @name DES is deprecated
 * @description DES is considered deprecated. AES is the recommended cipher. Upgrade to use AES.
 * @kind problem
 * @problem.severity warning
 * @id java/des-is-deprecated
 * @tags security
 *       vulnerability
 *       cwe/326
 *       owasp/a03
 *       owasp/a02
 *       asvs/V6.2.5
 */
import java

// Pattern 1: Detect Cipher.getInstance() calls with DES algorithm
from MethodAccess ma, string algo
where 
  ma.getMethod().getName() = "getInstance" and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
  (
    algo = ma.getArgument(0).(Literal).getValue() and
    (algo.matches("DES.*") or algo = "DES")
  )
select ma, "DES is considered deprecated. AES is the recommended cipher. Upgrade to use AES. See https://www.nist.gov/news-events/news/2005/06/nist-withdraws-outdated-data-encryption-standard for more information."

// Pattern 2: Detect string literals containing DES algorithm
from Literal l, string value
where 
  value = l.getValue() and
  (value.matches("DES.*") or value = "DES") and
  exists(DataFlow::localFlow(DataFlow::exprToSource(l), _))
select l, "DES is considered deprecated. AES is the recommended cipher. Upgrade to use AES. See https://www.nist.gov/news-events/news/2005/06/nist-withdraws-outdated-data-encryption-standard for more information."
