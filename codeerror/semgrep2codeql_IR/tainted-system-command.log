Rule Content:
/**
 * @name Tainted system command
 * @description Detected user input entering a method which executes a system command. This could result in a command injection vulnerability.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/tainted-system-command
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Sources from method parameters with Spring annotations
    exists(Method m, Parameter p |
      m.getAnAnnotation() instanceof SpringRequestAnnotation and
      p = m.getAParameter() and
      source.asParameter() = p and
      not p.getType() instanceof PrimitiveType and
      not p.getType() instanceof BoxedType
    )
    or
    // Sources from string operations
    exists(StringOperation op |
      op instanceof StringConcat or
      op instanceof StringBuilderAppend or
      op instanceof StringFormat or
      op instanceof StringJoin or
      (op instanceof AssignmentAdd and op.getRhs() instanceof Expr) and
      source.asExpr() = op.getAnOperand() and
      TaintTracking::localTaint(source.getEnclosingCallable(), _, source)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // Sink: Process constructor
    exists(ClassInstanceExpr cie |
      cie.getConstructedType().hasQualifiedName("java.lang", "Process") and
      sink.asExpr() = cie.getAnArgument() and
      isConcatArgument(sink)
    )
    or
    // Sink: Runtime.exec/load/loadLibrary
    exists(MethodAccess ma |
      (ma.getMethod().hasQualifiedName("java.lang", "Runtime", "exec") or
       ma.getMethod().hasQualifiedName("java.lang", "Runtime", "load") or
       ma.getMethod().hasQualifiedName("java.lang", "Runtime", "loadLibrary")) and
      ma.getQualifier().toString() = "Runtime.getRuntime()" and
      sink.asExpr() = ma.getAnArgument() and
      isConcatArgument(sink)
    )
    or
    // Sink: ProcessBuilder methods
    exists(MethodAccess ma |
      (ma.getMethod().hasQualifiedName("java.lang", "ProcessBuilder", "command") or
       ma.getMethod().hasQualifiedName("java.lang", "ProcessBuilder", "add") or
       ma.getMethod().hasQualifiedName("java.lang", "ProcessBuilder", "addAll") or
       ma.getMethod().hasQualifiedName("java.lang", "ProcessBuilder", "start")) and
      sink.asExpr() = ma.getAnArgument() and
      isConcatArgument(sink)
    )
  }

  predicate isConcatArgument(DataFlow::Node node) {
    exists(StringOperation op |
      op instanceof StringConcat or
      op instanceof StringBuilderAppend or
      op instanceof StringFormat or
      op instanceof StringJoin or
      (op instanceof AssignmentAdd and op.getRhs() instanceof Expr) and
      node.asExpr() = op.getAnOperand()
    )
  }
}

from CommandInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user input entering a method which executes a system command. This could result in a command injection vulnerability."
