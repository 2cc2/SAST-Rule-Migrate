Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL. This could allow an attacker to send data to their own server, potentially exposing sensitive data such as cookies or authorization information sent with this request. They could also probe internal servers or other resources that the server running this code can access. (This is called server-side request forgery, or SSRF.) Do not allow arbitrary hosts. Instead, create an allowlist for approved hosts, hardcode the correct host, or ensure that the user data can only affect the path or parameters.
 * @kind path-problem
 * @problem.severity error
 * @id java/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 *       external/owasp/a10
 *       technology/java
 *       technology/spring
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class TaintedURLHostConfig extends TaintTracking::Configuration {
  TaintedURLHostConfig() { this = "TaintedURLHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodParameter p |
      p = source.asParameter() and
      not p.getType().hasName(["Integer", "Long", "Float", "Double", "Char", "Boolean", "int", "long", "float", "double", "char", "boolean"]) and
      (
        p.getAnAnnotation().getType().hasQualifiedName(["org.springframework.web.bind.annotation", "RequestBody"]) or
        p.getAnAnnotation().getType().hasQualifiedName(["org.springframework.web.bind.annotation", "PathVariable"]) or
        p.getAnAnnotation().getType().hasQualifiedName(["org.springframework.web.bind.annotation", "RequestParam"]) or
        p.getAnAnnotation().getType().hasQualifiedName(["org.springframework.web.bind.annotation", "RequestHeader"]) or
        p.getAnAnnotation().getType().hasQualifiedName(["org.springframework.web.bind.annotation", "CookieValue"]) or
        p.getAnAnnotation().getType().hasQualifiedName(["org.springframework.web.bind.annotation", "ModelAttribute"])
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ConstructorCall cc, string base |
      cc.getConstructedType().hasQualifiedName("java.net", "URL") and
      cc.getArgument(0) = sink.asExpr() and
      base = cc.getArgument(0).(StringLiteral).getString() and
      base.regexpMatches("http(s?)://%(v|s|q).*")
    )
    or
    exists(StringConcatenation sc |
      sc = sink.asExpr() and
      sc.getStringValue().regexpMatches("http(s?)://%(v|s|q).*")
    )
  }
}

from TaintedURLHostConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "User-controlled data flows into URL host, which may lead to SSRF vulnerability.", source,
  "User data flows into the host portion of this manually-constructed URL."
