/**
 * @name GCM Detection
 * @description Detects usage of AES/GCM encryption and GCMParameterSpec initialization.
 * @kind problem
 * @problem.severity warning
 * @id java/gcm-detection
 * @tags security
 *       crypto::search::randomness::javax.crypto
 *       external/cwe/cwe-323
 *       owasp-a02
 */

import java

// Detects either Cipher.getInstance("AES/GCM/NoPadding") or new GCMParameterSpec()
from MethodAccess ma, Method m, ClassInstanceExpr cie, Class c
where 
  (
    // Pattern for Cipher.getInstance("AES/GCM/NoPadding")
    ma.getMethod().hasName("getInstance") and
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
    exists(ma.getAnArgument().(StringLiteral).getValue().regexpMatch(".*AES/GCM/NoPadding.*"))
  )
  or
  (
    // Pattern for new GCMParameterSpec()
    cie.getConstructedType().hasQualifiedName("javax.crypto.spec", "GCMParameterSpec")
  )
select ma, "GCM detected, please check that IV/nonce is not reused. " +
  "An Initialization Vector (IV) is a nonce used to randomize the encryption. " +
  "Unlike the Key, the IV usually does not need to be secret, but must be random and unique. " +
  "Reusing same IV with the same Key allows attackers to compare ciphertexts and gain information."
