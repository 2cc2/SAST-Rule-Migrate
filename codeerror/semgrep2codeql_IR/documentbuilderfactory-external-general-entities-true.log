Rule Content:
/**
 * @name DocumentBuilderFactory External General Entities Enabled
 * @description Detects when DocumentBuilderFactory allows external general entities,
 *              making it vulnerable to XXE attacks.
 * @kind problem
 * @problem.severity error
 * @id java/documentbuilderfactory-external-general-entities-true
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 *       external/asvs/V5.5.2
 *       cwe2021-top25
 *       cwe2022-top25
 */
import java

from MethodAccess setFeatureCall
where
  setFeatureCall.getMethod().getName() = "setFeature" and
  setFeatureCall.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
  exists(Expr featureArg | featureArg = setFeatureCall.getArgument(0) |
    featureArg.(StringLiteral).getValue() = "http://xml.org/sax/features/external-general-entities"
  ) and
  exists(Expr valueArg | valueArg = setFeatureCall.getArgument(1) |
    valueArg.(BooleanLiteral).getValue() = true
  )
select setFeatureCall,
  "External entities are allowed for DocumentBuilderFactory. This is vulnerable to XML external entity attacks. " +
  "Disable this by setting the feature \"http://xml.org/sax/features/external-general-entities\" to false."
