/**
 * @name Assignment in conditional test
 * @description The value of an assignment is being ignored and will be used in the conditional test
 * @kind problem
 * @id java/assignment-comparison
 * @tags correctness
 *       java
 * @severity error
 */

import java

from IfStmt ifstmt, AssignExpr assign
where ifstmt.getCondition() = assign
  and assign.getRight() instanceof BooleanLiteral
  and (assign.getRight().toString() = "true" or assign.getRight().toString() = "false")
select ifstmt, "The value of " + assign.getLeft() + " is being ignored and will be used in the conditional test"
