/**
 * @name Assignment in conditional test
 * @description The value of an assignment is being ignored and will be used in the conditional test
 * @kind problem
 * @id java/assignment-comparison
 * @tags correctness
 *       java
 * @severity error
 */

import java

from IfStmt ifstmt, BinaryExpr expr
where
  expr = ifstmt.getCondition() and
  expr.getOperator() = AssignExpr.Operator.ASSIGN and
  expr.getRight() instanceof BooleanLiteral and
  (expr.getRight().toString() = "true" or expr.getRight().toString() = "false")
select ifstmt, "The value of " + expr.getLeft() + " is being ignored and will be used in the conditional test"
