Rule Content:
/**
 * @name Unrestricted Request Mapping
 * @description Detected a method annotated with 'RequestMapping' that does not specify the HTTP method.
 *              CSRF protections are not enabled for GET, HEAD, TRACE, or OPTIONS, and by default all HTTP
 *              methods are allowed when the HTTP method is not explicitly specified. This means that a
 *              method that performs state changes could be vulnerable to CSRF attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/unrestricted-request-mapping
 * @tags security
 *       external/cwe/cwe-352
 *       external/owasp/a01
 *       external/cwe/top25-2021
 *       external/cwe/top25-2022
 */
import java

from Method m, Annotation requestMapping
where
  requestMapping.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestMapping") and
  m.getAnAnnotation() = requestMapping and
  not exists(requestMapping.getAnArgument().getName() = "method")
select m, "RequestMapping annotation does not specify HTTP method, making it vulnerable to CSRF attacks. " +
          "Specify HTTP method (e.g. RequestMethod.POST) to mitigate."
