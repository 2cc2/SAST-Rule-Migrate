Rule Content:
/**
 * @name Hardcoded Conditional
 * @description Detects if statements that will always have the same behavior and are therefore unnecessary.
 * @kind problem
 * @id java/hardcoded-conditional
 * @tags correctness
 *   java
 * @severity error
 */

import java

// Case 1: Always true conditional
from IfStmt ifstmt, Literal lit
where lit.getType().toString() = "boolean" and lit.getValue().toInt() = 1
  and ifstmt.getCondition() = lit
select ifstmt, "This if statement will always evaluate to true and is therefore unnecessary."

// Case 2: Always false conditional
from IfStmt ifstmt, Literal lit
where lit.getType().toString() = "boolean" and lit.getValue().toInt() = 0
  and ifstmt.getCondition() = lit
select ifstmt, "This if statement will always evaluate to false and is therefore unnecessary."

// Case 3: Variable assignment with true/false in conditional
from IfStmt ifstmt, AssignExpr assign, Literal lit
where lit.getType().toString() = "boolean"
  and (lit.getValue().toInt() = 1 or lit.getValue().toInt() = 0)
  and ifstmt.getCondition() = assign
  and assign.getRightOperand() = lit
select ifstmt, "This if statement contains a variable assignment with a boolean literal and is therefore unnecessary."

// Case 4: Logical AND with false makes entire expression false
from IfStmt ifstmt, BinaryExpr binExpr, Literal lit
where lit.getType().toString() = "boolean" and lit.getValue().toInt() = 0
  and ifstmt.getCondition() = binExpr
  and binExpr.getOperator() = "&&"
  and (binExpr.getLeftOperand() = lit or binExpr.getRightOperand() = lit)
select ifstmt, "This if statement contains a logical AND with false which makes the entire expression false."

// Case 5: Logical OR with true makes entire expression true
from IfStmt ifstmt, BinaryExpr binExpr, Literal lit
where lit.getType().toString() = "boolean" and lit.getValue().toInt() = 1
  and ifstmt.getCondition() = binExpr
  and binExpr.getOperator() = "||"
  and (binExpr.getLeftOperand() = lit or binExpr.getRightOperand() = lit)
select ifstmt, "This if statement contains a logical OR with true which makes the entire expression true."
