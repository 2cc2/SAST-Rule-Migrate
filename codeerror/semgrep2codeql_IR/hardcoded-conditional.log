Rule Content:
/**
 * @name Hardcoded Conditional
 * @description Detects if statements that will always have the same behavior and are therefore unnecessary.
 * @kind problem
 * @id java/hardcoded-conditional
 * @tags correctness
 *   java
 * @severity error
 */

import java

predicate isTrueLiteral(Expr expr) {
  exists(Literal lit | 
    lit.getType().toString() = "boolean" and 
    lit.getValue().toInt() = 1 and
    expr = lit
  )
}

predicate isFalseLiteral(Expr expr) {
  exists(Literal lit | 
    lit.getType().toString() = "boolean" and 
    lit.getValue().toInt() = 0 and
    expr = lit
  )
}

from IfStmt ifstmt
where
  // Case 1: Always true conditional
  (isTrueLiteral(ifstmt.getCondition())) or
  // Case 2: Always false conditional
  (isFalseLiteral(ifstmt.getCondition())) or
  // Case 3: Variable assignment with true/false in conditional
  (exists(AssignExpr assign | 
    ifstmt.getCondition() = assign and
    (isTrueLiteral(assign.getRhs()) or isFalseLiteral(assign.getRhs()))
  )) or
  // Case 4: Logical AND with false makes entire expression false
  (exists(BinaryExpr binExpr |
    ifstmt.getCondition() = binExpr and
    binExpr.getOp() instanceof AndLogical and
    (isFalseLiteral(binExpr.getLeftOperand()) or isFalseLiteral(binExpr.getRightOperand()))
  )) or
  // Case 5: Logical OR with true makes entire expression true
  (exists(BinaryExpr binExpr |
    ifstmt.getCondition() = binExpr and
    binExpr.getOp() instanceof OrLogical and
    (isTrueLiteral(binExpr.getLeftOperand()) or isTrueLiteral(binExpr.getRightOperand()))
  ))
select ifstmt, "This if statement will always have the same behavior and is therefore unnecessary."
