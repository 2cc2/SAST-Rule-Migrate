Rule Content:
/**
 * @name InsecureXSSRequestWrapper
 * @description Detects insecure implementation of XSSRequestWrapper and insecure XSS filtering patterns.
 * @kind problem
 * @problem.severity warning
 * @id java/xssrequestwrapper-is-insecure
 * @tags security
 *       external/cwe/cwe-079
 *       external/cwe/cwe-2021-top25
 *       external/cwe/cwe-2022-top25
 *       external/owasp/a07
 *       external/owasp/a03
 */
import java

// Rule 1: Detect insecure implementation of XSSRequestWrapper
from Class cls
where
  cls.getName() = "XSSRequestWrapper" and
  cls.getASupertype*().hasQualifiedName("javax.servlet.http", "HttpServletRequestWrapper")
select cls, "It looks like you're using an implementation of XSSRequestWrapper from dzone. The XSS filtering in this code is not secure and can be bypassed by malicious actors. It is recommended to use a stack that automatically escapes in your view or templates instead of filtering yourself."

// Rule 2: Detect insecure XSS filtering pattern
from MethodAccess ma, Method m, Variable v
where
  m.getName() = "compile" and
  m.getDeclaringType().hasQualifiedName("java.util.regex", "Pattern") and
  ma.getMethod() = m and
  ma.getArgument(0).toString() = "\"</script>\"" and
  exists(FieldAccess fa | 
    fa.getField().hasName("CASE_INSENSITIVE") and
    fa.getQualifier().getType().hasQualifiedName("java.util.regex", "Pattern")
  ) and
  exists(MethodAccess replaceAll |
    replaceAll.getMethod().getName() = "replaceAll" and
    replaceAll.getQualifier().getType().hasQualifiedName("java.util.regex", "Matcher") and
    replaceAll.getArgument(0).toString() = "\"\"" and
    replaceAll.getQualifier() = v.getAnAccess()
  )
select ma, "Detects insecure XSS filtering pattern that can be bypassed by malicious actors. It is recommended to use proper output encoding instead."
