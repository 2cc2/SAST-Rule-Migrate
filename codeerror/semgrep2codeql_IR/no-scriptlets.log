/**
 * @name No JSP Scriptlets
 * @description JSP scriptlet detected. Scriptlets are difficult to use securely and are considered bad practice. 
 *              Instead, consider migrating to JSF or using the Expression Language '${...}' with the escapeXml 
 *              function in your JSP files.
 * @kind problem
 * @problem.severity warning
 * @id java/no-scriptlets
 * @tags security
 *       owasp-a03
 *       cwe-116
 *       jsp
 * @precision low
 */
import java

from JspFile jsp
where jsp.getText().regexpMatch("<%[^@].*")
select jsp, "JSP scriptlet detected. Scriptlets are difficult to use securely and are considered bad practice. " +
       "See https://stackoverflow.com/a/3180202. Instead, consider migrating to JSF or using the Expression " +
       "Language '${...}' with the escapeXml function in your JSP files."
