/**
 * @name DocumentBuilderFactory External Parameter Entities Enabled
 * @description Detects when external parameter entities are enabled in DocumentBuilderFactory,
 *              making the application vulnerable to XML external entity (XXE) attacks.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @id java/documentbuilderfactory-external-parameter-entities-true
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 *       external/asvs/V5.5.2
 *       cwe2021-top25
 *       cwe2022-top25
 */
import java
import semmle.code.java.dataflow.FlowSources

class DocumentBuilderFactorySetFeature extends Expr {
  DocumentBuilderFactorySetFeature() {
    exists(MethodCall mc |
      mc.getMethod().hasName("setFeature") and
      mc.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
      mc.getArgument(0).(StringLiteral).getValue() = "http://xml.org/sax/features/external-parameter-entities" and
      mc.getArgument(1).(BooleanLiteral).getValue() = true and
      this = mc
    )
  }
}

