/**
 * @name DocumentBuilderFactory External Parameter Entities Enabled
 * @description Detects when external parameter entities are enabled in DocumentBuilderFactory,
 *              making the application vulnerable to XML external entity (XXE) attacks.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @id java/documentbuilderfactory-external-parameter-entities-true
 * @tags security
 *       external/cwe/cwe-611
 *       external/owasp/a04:2017
 *       external/owasp/a05:2021
 *       external/asvs/V5.5.2
 *       cwe2021-top25
 *       cwe2022-top25
 */
import java
import semmle.code.java.dataflow.FlowSources

class DocumentBuilderFactorySetFeature extends MethodAccess {
  DocumentBuilderFactorySetFeature() {
    this.getMethod().hasName("setFeature") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
    exists(MethodAccess arg1, Literal arg2 |
      arg1 = this.getArgument(0) and
      arg2 = this.getArgument(1) and
      arg2.getStringValue() = "http://xml.org/sax/features/external-parameter-entities" and
      arg1.getStringValue() = "true"
    )
  }
}

from DocumentBuilderFactorySetFeature dbf
select dbf, 
  "External entities are allowed for DocumentBuilderFactory. This is vulnerable to XML external entity attacks. " +
  "Disable this by setting the feature \"http://xml.org/sax/features/external-parameter-entities\" to false.",
  dbf.getLocation(),
  "$DBFACTORY.setFeature(\"http://xml.org/sax/features/external-parameter-entities\", true)"
