Rule Content:
/**
 * @name Do Privileged Use
 * @description Detected usage of AccessController.doPrivileged which enables privilege escalation.
 *              Marking code as privileged enables a piece of trusted code to temporarily enable
 *              access to more resources than are available directly to the code that called it.
 * @kind problem
 * @problem.severity warning
 * @id java/do-privileged-use
 * @tags security
 *       external/cwe/cwe-269
 *       external/owasp/a04
 */

import java

from Import i, MethodAccess ma, Class c
where 
  // Check for java.security.* imports
  i.getPackage().getName().matches("java.security%") or
  // Check for AccessController.doPrivileged calls
  (ma.getMethod().getName() = "doPrivileged" and 
   ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "AccessController")) or
  // Check for classes implementing PrivilegedAction<Void>
  (c.getASupertype() instanceof RefType and
   (c.getASupertype().hasQualifiedName("java.security", "PrivilegedAction") or
    c.getASupertype().hasQualifiedName("java.security", "PrivilegedExceptionAction")))
select ma, "Use of privileged construct detected. Ensure privileged code section is as small as possible."
