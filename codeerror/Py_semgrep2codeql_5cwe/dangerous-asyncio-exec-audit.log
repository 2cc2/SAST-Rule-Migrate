Rule Content:
/**
 * @name Dangerous asyncio.exec audit
 * @description Detected subprocess function without a static string. If controllable by a malicious actor, may lead to command injection.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 */

import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class UserControlledInput extends DataFlow::Node {
  UserControlledInput() {
    exists(string name | 
      name = this.asParameter().getName() or 
      name = this.asLocal().getName() |
      name.matches("%user%") or 
      name.matches("%input%") or 
      name.matches("%request%")
    )
  }
}

class SubprocessExecSink extends DataFlow::Node {
  SubprocessExecSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "subprocess_exec" and
      ma.getMethod().getDeclaringType().getName() = "asyncio" and
      (
        this = ma.getArgument(1) or
        (ma.getArgument(1).getStringValue().matches("%(sh|bash|ksh|csh|tcsh|zsh)%") and
         ma.getArgument(2).getStringValue() = "-c")
      )
    )
  }
}

class AsyncioProtocolSanitizer extends DataFlow::Node {
  AsyncioProtocolSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "subprocess_exec" and
      ma.getMethod().getDeclaringType().getName() = "asyncio" and
      this = ma.getArgument(0)
    )
  }
}

class StaticArgumentSanitizer extends DataFlow::Node {
  StaticArgumentSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "subprocess_exec" and
      ma.getMethod().getDeclaringType().getName() = "asyncio" and
      this = ma.getArgument(1) and
      this.getType().getName() = "str" and
      not exists(string val | 
        val = this.getStringValue() and
        val.matches("%\\$%") or
        val.matches("%[^a-zA-Z0-9_/]%")
      )
    )
  }
}

class AsyncioExecConfig extends TaintTracking::Configuration {
  AsyncioExecConfig() { this = "AsyncioExecConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserControlledInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessExecSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof AsyncioProtocolSanitizer or
    sanitizer instanceof StaticArgumentSanitizer
  }
}

from AsyncioExecConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), "Detected subprocess function call with potentially user-controlled input. " +
  "This may lead to command injection. Consider using 'shlex.escape()' or validating the input.",
source.getNode(), "User input flows into subprocess call here"
