Rule Content:
/**
 * @name Dangerous asyncio subprocess_exec audit
 * @description Detects subprocess function '$LOOP.subprocess_exec' without a static string.
 * @kind problem
 * @problem.severity error
 * @id python/command-injection/dangerous-asyncio-exec
 */

import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class DangerousAsyncioExecConfig extends TaintTracking::Configuration {
  DangerousAsyncioExecConfig() { this = "DangerousAsyncioExecConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(Function::Parameter p | 
      p = source.asParameter() and
      p.getBaseName().matches(".*user.*|.*input.*|.*request.*")
    )
    or
    exists(Variable v | 
      v = source.asVariable() and
      v.getBaseName().matches(".*user.*|.*input.*|.*request.*")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call c |
      c = sink.asExpr() and
      (
        (
          c.getCalleeName() = "subprocess_exec" and
          c.getImportedFrom().getQualifiedName() = "asyncio" and
          // Checking argument position 1 (0-based)
          sink = c.getArgument(1)
        )
        or
        (
          c.getCalleeName() = "subprocess_exec" and
          c.getImportedFrom().getQualifiedName() = "asyncio" and
          exists(string shell | 
            shell = c.getArgument(1).getStringValue() and
            shell.matches("/(sh|bash|ksh|csh|tcsh|zsh)/")
          ) and
          exists(string arg | 
            arg = c.getArgument(2).getStringValue() and
            arg = "-c"
          )
        )
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call c |
      c = sanitizer.asExpr() and
      c.getCalleeName() = "subprocess_exec" and
      c.getImportedFrom().getQualifiedName() = "asyncio" and
      // Checking protocol argument (position 0)
      sanitizer = c.getArgument(0)
    )
    or
    exists(Call c |
      c = sanitizer.asExpr() and
      c.getCalleeName() = "subprocess_exec" and
      c.getImportedFrom().getQualifiedName() = "asyncio" and
      exists(string arg |
        arg = c.getArgument(1).getStringValue() and
        not arg.matches(".*\\$.*|.*[^a-zA-Z0-9_/].*")
      )
    )
  }
}

from DangerousAsyncioExecConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
