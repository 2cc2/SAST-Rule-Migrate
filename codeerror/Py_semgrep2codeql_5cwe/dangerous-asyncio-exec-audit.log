Rule Content:
/**
 * @name Dangerous asyncio exec audit
 * @description Detected subprocess function 'LOOP.subprocess_exec' without a static string. 
 * If this data can be controlled by a malicious actor, it may be an instance of command injection.
 * Audit the use of this call to ensure it is not controllable by an external resource.
 * You may consider using 'shlex.escape()'.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking

class AsyncioSubprocessExecCall extends API::Call {
  AsyncioSubprocessExecCall() {
    this.getMethod().getName() = "subprocess_exec" and
    this.getReceiver().getType().getName() = "AbstractEventLoop" and
    this.getReceiver().getType().getASource().getName() = "asyncio"
  }
}

class UserControlledInput extends DataFlow::Node {
  UserControlledInput() {
    exists(string pattern |
      pattern =
        /.*user.*|.*input.*|.*request.*/ and
      // Match parameter or local variable names
      (this.asParameter().getName().matches(pattern) or
      this.asLocal().getName().matches(pattern))
    )
  }
}

class SafeProtocolSanitizer extends BarrierGuard {
  override predicate checks(DataFlow::Node node, boolean branch) {
    exists(AsyncioSubprocessExecCall call |
      call.getArgument(0) = node
    )
  }
}

class StaticArgsSanitizer extends BarrierGuard {
  override predicate checks(DataFlow::Node node, boolean branch) {
    exists(AsyncioSubprocessExecCall call |
      call.getArgument(1) = node and
      node.getBasicType().getName() = "str" and
      not exists(string val | 
        node.getStringValue() = val and
        (val.regexpMatch(/.*\\$.*/) or val.regexpMatch(/.*[^a-zA-Z0-9_/].*/))
      )
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "DangerousAsyncioExec" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserControlledInput
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(AsyncioSubprocessExecCall call |
      // Match direct subprocess_exec sink
      (call.getArgument(1) = sink and not call.getArgument(2).getStringValue() = "-c") or
      // Match shell variant sink
      (call.getArgument(2).getStringValue() = "-c" and
       call.getArgument(1).getStringValue().regexpMatch(/(sh|bash|ksh|csh|tcsh|zsh)/))
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node.getBarrierGuard() instanceof SafeProtocolSanitizer or
    node.getBarrierGuard() instanceof StaticArgsSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagate taint through arguments
    exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
      param = node1 and arg = node2 and
      arg.(DataFlow::ArgumentNode).getCall().getAnArgument() = node1 and
      node2.asExpr() = arg
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected subprocess function without static string. Possible command injection."
