Rule Content:
import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class DangerousAsyncioExecConfig extends TaintTracking::Configuration {
  DangerousAsyncioExecConfig() { this = "DangerousAsyncioExecConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    exists(VariableAccess va |
      va.getVariableBaseName() matches(".*user.*|.*input.*|.*request.*") and
      (source.asParameterNode().getVariableAccess() = va or source.asVariableAccess() = va)
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(CallExpr call, string packageName, string methodName |
      call.getArg(1) = sink.asExpr() and
      (
        (call.getTarget().getName() = "subprocess_exec" and
         call.getTarget().getImportedFrom() = "asyncio") or
        (call.getTarget().getName() = "subprocess_exec" and
         call.getArg(1).getValue().regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/") and
         call.getArg(2).getValue() = "-c")
      )
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(CallExpr call |
      call.getArg(0) = sanitizer.asExpr() and
      call.getTarget().getName() = "subprocess_exec" and
      call.getTarget().getImportedFrom() = "asyncio"
    ) or
    exists(CallExpr call |
      call.getArg(1) = sanitizer.asExpr() and
      call.getTarget().getName() = "subprocess_exec" and
      call.getTarget().getImportedFrom() = "asyncio" and
      call.getArg(1).getValue().getType() = "string" and
      not call.getArg(1).getValue().regexpMatch(".*\\$.*|.*[^a-zA-Z0-9_/].*")
    )
  }
}

from DangerousAsyncioExecConfig cfg, TaintTracking::TaintSource src, TaintTracking::TaintSink sink
where cfg.hasFlow(src, sink)
select sink, "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
