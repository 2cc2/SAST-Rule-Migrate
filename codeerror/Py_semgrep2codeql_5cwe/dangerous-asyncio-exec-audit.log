Rule Content:
/**
 * @name Dangerous asyncio subprocess_exec without static string
 * @description Detects subprocess function '$LOOP.subprocess_exec' without a static string.
 *              May indicate command injection vulnerability if input is user-controlled.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @id py/dangerous-asyncio-exec-audit
 */

import semmle.python.Concepts
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class UserControlledInput extends DataFlow::Node {
  UserControlledInput() {
    exists(Parameter p |
      p = this.asParameter() and
      p.getDisplayName().matches("%user%|%input%|%request%")
    )
    or
    exists(Variable v |
      v = this.asVariable() and
      v.getDisplayName().matches("%user%|%input%|%request%")
    )
  }
}

class SubprocessExecSink extends DataFlow::Node {
  SubprocessExecSink() {
    exists(Call call |
      call = this.asExpr() and
      call.getCalleeName() = "subprocess_exec" and
      call.getImportedFromScope().getName() = "asyncio"
    )
  }
}

class ShellExecSink extends DataFlow::Node {
  ShellExecSink() {
    exists(Call call |
      call = this.asExpr() and
      call.getCalleeName() = "subprocess_exec" and
      call.getImportedFromScope().getName() = "asyncio" and
      (
        exists(Literal arg | 
          arg = call.getArg(1) and 
          arg.getStringValue().matches("%sh|bash|ksh|csh|tcsh|zsh%")
        )
        or
        exists(Literal arg |
          arg = call.getArg(2) and
          arg.getStringValue() = "-c"
        )
      )
    )
  }
}

class AsyncioProtocolSanitizer extends DataFlow::Node {
  AsyncioProtocolSanitizer() {
    exists(Call call |
      call = this.asExpr() and
      call.getCalleeName() = "subprocess_exec" and
      call.getImportedFromScope().getName() = "asyncio" and
      call.getArg(0).hasStaticValue()
    )
  }
}

class StaticArgsSanitizer extends DataFlow::Node {
  StaticArgsSanitizer() {
    exists(Call call, Literal arg |
      call = this.asExpr() and
      call.getCalleeName() = "subprocess_exec" and
      call.getImportedFromScope().getName() = "asyncio" and
      arg = call.getArg(1) and
      arg.hasStaticValue() and
      not arg.getStringValue().matches("%\\$%|[^a-zA-Z0-9_/]%")
    )
  }
}

class DangerousAsyncioExecConfig extends TaintTracking::Configuration {
  DangerousAsyncioExecConfig() { this = "DangerousAsyncioExecConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof UserControlledInput 
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessExecSink or
    sink instanceof ShellExecSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof AsyncioProtocolSanitizer or
    sanitizer instanceof StaticArgsSanitizer
  }
}

from DangerousAsyncioExecConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, 
  "Detected subprocess function 'subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance " +
  "of command injection. Consider using 'shlex.escape()'.", source,
  "User-controlled input flows to subprocess call here"
