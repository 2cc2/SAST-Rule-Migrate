import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class UserControlledInput extends TaintTracking::TaintSource {
  UserControlledInput() {
    exists(Parameter p | 
      p.getName().matches(".*(user|input|request).*") |
      this.asParameterNode() = p
    )
    or
    exists(Variable v |
      v.getName().matches(".*(user|input|request).*") |
      this.asVariableNode() = v
    )
  }

  override predicate asCfgNode() { none() }
  override predicate getLocation() { this = any() }
  override predicate getBasicBlock() { none() }
  override string toString() { result = "User controlled input" } 
  override predicate getScope() { none() }
}

class SubprocessExecSink extends TaintTracking::TaintSink {
  SubprocessExecSink() {
    exists(Call call |
      call.getTarget().getName() = "subprocess_exec" and
      call.getImportedFrom().toString() = "asyncio" and
      this.asExprNode() = call.getArgument(1)
    )
  }

  override predicate asCfgNode() { none() }
  override predicate getLocation() { this = any() }
  override predicate getBasicBlock() { none() }
  override string toString() { result = "subprocess_exec sink" }
  override predicate getScope() { none() }
}

class ShellExecSink extends TaintTracking::TaintSink {
  ShellExecSink() {
    exists(Call call |
      call.getTarget().getName() = "subprocess_exec" and
      call.getImportedFrom().toString() = "asyncio" and
      exists(string shell | shell.matches(".*(sh|bash|ksh|csh|tcsh|zsh).*") |
        call.getArgument(1).getStringValue() = shell
      ) and
      call.getArgument(2).getStringValue() = "-c" and
      this.asExprNode() = call.getArgument(1)
    )
  }

  override predicate asCfgNode() { none() }
  override predicate getLocation() { this = any() } 
  override predicate getBasicBlock() { none() }
  override string toString() { result = "shell exec sink" }
  override predicate getScope() { none() }
}

class AsyncioProtocolSanitizer extends TaintTracking::Sanitizer {
  AsyncioProtocolSanitizer() {
    exists(Call call |
      call.getTarget().getName() = "subprocess_exec" and
      call.getImportedFrom().toString() = "asyncio" and
      this.asExprNode() = call.getArgument(0).getExpr()
    )
  }

  override predicate asCfgNode() { none() }
  override predicate getLocation() { this = any() }
  override predicate getBasicBlock() { none() }
  override string toString() { result = "asyncio protocol sanitizer" }
  override predicate getScope() { none() }
}

class StaticArgsSanitizer extends TaintTracking::Sanitizer {
  StaticArgsSanitizer() {
    exists(Call call |
      call.getTarget().getName() = "subprocess_exec" and
      call.getImportedFrom().toString() = "asyncio" and
      exists(DataFlow::StringLiteral literal |
        literal = call.getArgument(1).getExpr() and
        not literal.getStringValue().matches(".*\\$.*|[^a-zA-Z0-9_/].*")
      ) and
      this.asExprNode() = call.getArgument(1).getExpr()
    )
  }

  override predicate asCfgNode() { none() }
  override predicate getLocation() { this = any() }
  override predicate getBasicBlock() { none() }
  override string toString() { result = "static args sanitizer" }
  override predicate getScope() { none() }
}

class DangerousAsyncioExecConfig extends TaintTracking::Configuration {
  DangerousAsyncioExecConfig() { this = "Dangerous asyncio exec config" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof UserControlledInput
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SubprocessExecSink or sink instanceof ShellExecSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sane) {
    sane instanceof AsyncioProtocolSanitizer or sane instanceof StaticArgsSanitizer
  }
}

from DangerousAsyncioExecConfig cfg, TaintTracking::TaintSource src, TaintTracking::TaintSink sink
where cfg.hasFlow(src, sink)
select sink, "Detected subprocess function 'subprocess_exec' without a static string. $@",
  src, "User controlled input flows here"
