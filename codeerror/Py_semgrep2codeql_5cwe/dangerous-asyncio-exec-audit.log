Rule Content:
/**
 * @name Dangerous asyncio.subprocess_exec audit
 * @description Detected subprocess function '$LOOP.subprocess_exec' without a static string.
 *              If this data can be controlled by a malicious actor, it may be an instance
 *              of command injection. Consider using shlex.escape() for safety.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @id py/dangerous-asyncio-exec-audit
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class UserControlledInput extends DataFlow::Node {
  UserControlledInput() {
    exists(Parameter p |
      p = self.asParameter() |
      regexpMatch(p.getName(), ".*user.*|.*input.*|.*request.*")
    )
    or
    exists(LocalVariable v |
      v = self.asLocalVariable() |
      regexpMatch(v.getName(), ".*user.*|.*input.*|.*request.*")
    )
  }
}

class AsyncioSubprocessExecCall extends DataFlow::Node {
  AsyncioSubprocessExecCall() {
    exists(MethodAccess call |
      call.getMethodName() = "subprocess_exec" and
      call.getQualifier().toString() = "asyncio" and
      self.asExpr() = call
    )
  }

  Expr getShellArgument() { result = getArgument(1) }
  Expr getCommandArgument() { result = getArgument(2) }
}

predicate isSafeProtocol(AsyncioSubprocessExecCall call) {
  exists(MethodAccess ma |
    ma = call.asExpr().getImmediateCaller() |
    ma.getMethodName() = "set_protocol" 
  )
}

predicate isStaticArgument(AsyncioSubprocessExecCall call) {
  call.getCommandArgument().getStringValue().regexpMatch("^[a-zA-Z0-9_/]+$")
}

class DangerousSubprocessExecConfig extends TaintTracking::Configuration {
  DangerousSubprocessExecConfig() { this = "DangerousSubprocessExecConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserControlledInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof AsyncioSubprocessExecCall and
    not isSafeProtocol(sink.(AsyncioSubprocessExecCall)) and
    not isStaticArgument(sink.(AsyncioSubprocessExecCall))
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AsyncioSubprocessExecCall call |
      call.getShellArgument() = sanitizer and
      sanitizer.getStringValue().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$")
    )
  }
}

from DangerousSubprocessExecConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "Potential command injection vulnerability if user-controlled data reaches this call."
