Rule Content:
/**
 * @name Dangerous asyncio subprocess execution
 * @description Detects subprocess_exec without static string arguments
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 */

import python
import DataFlow
import semmle.python.security.dataflow.TaintTracking

private class UserControlledInput extends DataFlow::Node::Parameter, DataFlow::Node::Local {
  UserControlledInput() {
    this.getVariable().getName().matches("%user%|%input%|%request%")
  }

  override predicate asCfgNode() { this = result }
  override DataFlow::Node getLocation() { result = this }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.getValue().getBasicBlock() }
  override string toString() { result = this.getValue().toString() }
  override Scope getScope() { result = this.getValue().getScope() }
  override Variable asVariable() { result = this.getValue().asVariable() }
}

private class AsyncioSubprocessExecCall extends DataFlow::Node::Call {
  AsyncioSubprocessExecCall() {
    exists(CallNode call |
      call.getTarget().hasName("subprocess_exec") and
      call.getTarget().getQualifierName() = "asyncio" and
      this = call
    )
  }

  DataFlow::Node getCommandArgument() { result = this.getArgument(1) }

  predicate isShellExecution() {
    exists(string shell |
      this.getCommandArgument().getValue().getStringValue() = shell and
      shell.matches("%sh%|%bash%|%ksh%|%csh%|%tcsh%|%zsh%") and
      this.getArgument(2).getValue().getStringValue() = "-c"
    )
  }

  override predicate asCfgNode() { this = result }
  override DataFlow::Node getLocation() { result = this }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.getValue().getBasicBlock() }
  override string toString() { result = this.getValue().toString() }
  override Scope getScope() { result = this.getValue().getScope() }
  override Variable asVariable() { result = this.getValue().asVariable() }
}

private class SafeProtocolSanitizer extends DataFlow::Node::Call {
  SafeProtocolSanitizer() {
    this.getTarget().hasName("subprocess_exec") and
    this.getTarget().getQualifierName() = "asyncio"
  }

  override predicate asCfgNode() { this = result }
}

private class StaticArgumentSanitizer extends DataFlow::Node {
  StaticArgumentSanitizer() {
    exists(AsyncioSubprocessExecCall call |
      call.getCommandArgument() = this and
      this.getValue().getType().toString() = "string" and
      not this.getValue().getStringValue().matches("%\\$%|%[^a-zA-Z0-9_/]%")
    )
  }
}

private class DangerousSubprocessExecConfig extends TaintTracking::Configuration {
  DangerousSubprocessExecConfig() { this = "DangerousSubprocessExecConfig" }

  override predicate isSource(TaintSource source) {
    source.getNode() instanceof UserControlledInput
  }

  override predicate isSink(TaintSink sink) {
    sink.getNode() instanceof AsyncioSubprocessExecCall
  }

  override predicate isSanitizer(Sanitizer sanitizer) {
    sanitizer.getNode() instanceof SafeProtocolSanitizer or
    sanitizer.getNode() instanceof StaticArgumentSanitizer
  }
}

from DangerousSubprocessExecConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where
  cfg.hasFlowPath(source, sink) and
  sink.getNode().(AsyncioSubprocessExecCall).isShellExecution()
select sink, "Detected subprocess function 'subprocess_exec' with possible command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource."
