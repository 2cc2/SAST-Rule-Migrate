import python
import python.TaintTracking
import python.DataFlow

class UserControlledInput extends TaintTracking::TaintSource {
  UserControlledInput() {
    exists(Variable v | 
      (this.asVariable() = v or this.asParameter() = v) and
      v.getName().matches("%user%") or v.getName().matches("%input%") or v.getName().matches("%request%")
    )
  }

  override predicate isSource(TaintTracking::TaintSource source) {
    source = this
  }

  /* Implement required abstract methods */
  override predicate asCfgNode() { this.asVariable() = _ }
  override string getLocation() { result = this.toString() }
  override predicate getBasicBlock() { this.asVariable() = _ }
  override string toString() { result = "User controlled input" }
  override predicate getScope() { this.asVariable() = _ }
  override ControlFlow::Variable asVariable() { result = this }
}

class SubprocessExecSink extends TaintTracking::TaintSink {
  SubprocessExecSink() {
    exists(DataFlow::MethodCallNode call |
      call.getMethod().getName() = "subprocess_exec" and
      call.getReceiverType().getName().matches("%asyncio%") and
      call.getArgument(1).asExpr() = this.asExpr()
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink = this
  }

  /* Implement required abstract methods */
  override predicate asCfgNode() { this.asVariable() = _ }
  override string getLocation() { result = this.toString() }
  override predicate getBasicBlock() { this.asVariable() = _ }
  override string toString() { result = "Subprocess exec sink" }
  override predicate getScope() { this.asVariable() = _ }
  override ControlFlow::Variable asVariable() { result = this }
}

class AsyncioProtocolSanitizer extends TaintTracking::Sanitizer {
  AsyncioProtocolSanitizer() {
    exists(DataFlow::MethodCallNode call |
      call.getMethod().getName() = "subprocess_exec" and
      call.getReceiverType().getName().matches("%asyncio%") and
      call.getArgument(0).asExpr() = this.asExpr()
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer = this
  }

  /* Implement required abstract methods */
  override predicate asCfgNode() { this.asVariable() = _ }
  override string getLocation() { result = this.toString() }
  override predicate getBasicBlock() { this.asVariable() = _ }
  override string toString() { result = "Asyncio protocol sanitizer" }
  override predicate getScope() { this.asVariable() = _ }
  override ControlFlow::Variable asVariable() { result = this }
}

class StaticArgumentSanitizer extends TaintTracking::Sanitizer {
  StaticArgumentSanitizer() {
    exists(DataFlow::MethodCallNode call |
      call.getMethod().getName() = "subprocess_exec" and
      call.getReceiverType().getName().matches("%asyncio%") and
      exists(DataFlow::Node arg |
        arg = call.getArgument(1) and
        arg.getType().getName() = "str" and 
        not arg.getStringValue().matches("%\\$%|%[^a-zA-Z0-9_/]%")
      )
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer = this
  }

  /* Implement required abstract methods */
  override predicate asCfgNode() { this.asVariable() = _ }
  override string getLocation() { result = this.toString() }
  override predicate getBasicBlock() { this.asVariable() = _ }
  override string toString() { result = "Static argument sanitizer" }
  override predicate getScope() { this.asVariable() = _ }
  override ControlFlow::Variable asVariable() { result = this }
}

class DangerousAsyncioExecConfig extends TaintTracking::Configuration {
  DangerousAsyncioExecConfig() { this = "DangerousAsyncioExecConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof UserControlledInput
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SubprocessExecSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof AsyncioProtocolSanitizer or
    sanitizer instanceof StaticArgumentSanitizer
  }
}

from DangerousAsyncioExecConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
