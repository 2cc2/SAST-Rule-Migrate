Rule Content:
/**
 * @name Dangerous asyncio.subprocess_exec usage
 * @description Detects subprocess function calls with potential command injection vulnerability
 * @kind path-problem
 * @problem.severity error
 * @id py/dangerous-asyncio-exec-audit
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import python.dataflow.TaintTracking
import semmle.python.dataflow.new.RemoteFlowSources
import DataFlow::PathGraph

class UserControlledInput extends DataFlow::Node {
  UserControlledInput() {
    exists(Parameter p | 
      p.getAnnotatedName().matches("%user%|%input%|%request%") and
      this = p.asParameter().getNode()
    )
    or
    exists(Variable v |
      v.getName().matches("%user%|%input%|%request%") and
      this = v.asVariable().getNode()
    )
  }
}

class SubprocessExecSink extends DataFlow::Node {
  SubprocessExecSink() {
    exists(Call c |
      c.getTargetName() = "subprocess_exec" and
      c.getImportedScope().getPackageName() = "asyncio" and
      this = c.getArg(1).asExpr().getNode()
    )
  }
}

class ShellExecSink extends DataFlow::Node {
  ShellExecSink() {
    exists(Call c |
      c.getTargetName() = "subprocess_exec" and
      c.getImportedScope().getPackageName() = "asyncio" and
      c.getArg(1).asExpr().getStringValue().matches("/sh|bash|ksh|csh|tcsh|zsh/") and
      c.getArg(2).asExpr().getStringValue() = "-c" and
      this = c.getArg(1).asExpr().getNode()
    )
  }
}

class AsyncioProtocolSanitizer extends DataFlow::BarrierGuard {
  AsyncioProtocolSanitizer() {
    exists(Call c |
      c.getTargetName() = "subprocess_exec" and
      c.getImportedScope().getPackageName() = "asyncio" and
      this = c.getArg(0).asExpr().getNode()
    )
  }
}

class StaticArgsSanitizer extends DataFlow::BarrierGuard {
  StaticArgsSanitizer() {
    exists(Call c |
      c.getTargetName() = "subprocess_exec" and
      c.getImportedScope().getPackageName() = "asyncio" and
      c.getArg(1).asExpr().getStringValue() != "" and
      not c.getArg(1).asExpr().getStringValue().matches(".*\\$.*|.*[^a-zA-Z0-9_/].*") and
      this = c.getArg(1).asExpr().getNode()
    )
  }
}

class DangerousAsyncioExecConfig extends TaintTracking::Configuration {
  DangerousAsyncioExecConfig() { this = "DangerousAsyncioExecConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof UserControlledInput 
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessExecSink or sink instanceof ShellExecSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof AsyncioProtocolSanitizer or 
    sanitizer instanceof StaticArgsSanitizer
  }
}

