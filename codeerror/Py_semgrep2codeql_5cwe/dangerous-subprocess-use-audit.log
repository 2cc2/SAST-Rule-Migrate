Rule Content:
/**
 * @name Dangerous subprocess use audit
 * @description Detected subprocess function without a static string. If controllable by attacker, it may lead to command injection.
 * @kind problem
 * @problem.severity error
 * @id python/dangerous-subprocess-use
 */

import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.TaintTracking::PartialPathGraph
import semmle.python.Strings

class SubprocessCall extends API::Node {
  SubprocessCall() {
    getModule().getName() = "subprocess" and
    exists(string funcName | getQualifiedName().matches("subprocess." + funcName))
  }
}

class ShellExecutionSource extends TaintTracking::TaintSource {
  ShellExecutionSource() {
    exists(SubprocessCall call |
      call.getArgument(0).asExpr().getStringValue().matches("sh|bash|ksh|csh|tcsh|zsh") and
      call.getArgument(1).asExpr().getStringValue() = "-c" and
      this = call
    )
  }
}

class PythonExecutionSource extends TaintTracking::TaintSource {
  PythonExecutionSource() {
    exists(SubprocessCall call |
      call.getArgument(0).asExpr().getStringValue().matches("python") and
      this = call
    )
  }
}

class SubprocessSink extends TaintTracking::TaintSink {
  SubprocessSink() {
    exists(SubprocessCall call | this = call)
  }
}

class StaticStringSanitizer extends TaintTracking::Sanitizer {
  StaticStringSanitizer() {
    exists(SubprocessCall call |
      call.getArgument(0).asExpr().getStringValue() = "..." and
      this = call
    )
  }
}

class ShellSafeArraySanitizer extends TaintTracking::Sanitizer {
  ShellSafeArraySanitizer() {
    exists(SubprocessCall call |
      not call.getArgument(0).asExpr().getStringValue().matches("sh|bash|ksh|csh|tcsh|zsh") and
      this = call
    )
  }
}

class ArgumentToCall extends TaintTracking::TaintPropagation {
  override predicate propagates(TaintTracking::TaintSource source, DataFlow::Node node1, DataFlow::Node node2) {
    exists(CallNode call |
      node1.asExpr() = call.getAnArgument() and
      node2 = call
    )
  }
}

class DangerousSubprocessConfig extends TaintTracking::Configuration {
  DangerousSubprocessConfig() { this = "DangerousSubprocessConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof ShellExecutionSource or
    source instanceof PythonExecutionSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof SubprocessSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof StaticStringSanitizer or
    sanitizer instanceof ShellSafeArraySanitizer
  }

  override predicate propagates(TaintTracking::TaintSource source, DataFlow::Node node1, DataFlow::Node node2) {
    ArgumentToCall::propagates(source, node1, node2)
  }
}

from DangerousSubprocessConfig cfg, TaintTracking::PartialPathNode source, TaintTracking::PartialPathNode sink
where cfg.hasFlow(source, sink)
select sink,
  "Detected subprocess function '" + sink.getNode().(SubprocessCall).getQualifiedName() +
  "' without a static string. If this data can be controlled by a malicious actor, it may be an " +
  "instance of command injection. Audit the use of this call to ensure it is not controllable " +
  "by an external resource. You may consider using 'shlex.escape()'."
