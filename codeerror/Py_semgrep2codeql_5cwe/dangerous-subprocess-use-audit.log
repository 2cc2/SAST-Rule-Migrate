import python
import semmle.python.web.HttpRequest
import semmle.python.Concepts
import DataFlow::PathGraph

class SubprocessCall extends DataFlow::Call {
  SubprocessCall() {
    getTarget().toString() = "subprocess" and
    exists(string funcName | getMethodName() = funcName | funcName.matches("%run%") or funcName.matches("%call%") or funcName.matches("%Popen%"))
  }

  Expr getCommandArg() { result = getArgument(0) }
}

class ShellSource extends DataFlow::Node {
  ShellSource() {
    exists(SubprocessCall call |
      call.getCommandArg().getStringValue().regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/") and
      call.getArgument(1).getStringValue() = "-c"
    )
  }
}

class PythonSource extends DataFlow::Node {
  PythonSource() {
    exists(SubprocessCall call |
      call.getCommandArg().getStringValue().regexpMatch("/python/")
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(SubprocessCall call | this.asExpr() = call.getCommandArg())
  }
}

class StaticStringSanitizer extends DataFlow::Node {
  StaticStringSanitizer() {
    // Neutralizes when argument is a static string
    exists(SubprocessCall call |
      this.asExpr() = call.getCommandArg() and
      call.getCommandArg().getStringValue() = "..."
    )
  }
}

class ShellSafeArraySanitizer extends DataFlow::Node {
  ShellSafeArraySanitizer() {
    // Neutralizes when first element is not a shell
    exists(SubprocessCall call |
      this.asExpr() = call.getCommandArg() and
      not call.getCommandArg().getStringValue().regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/")
    )
  }
}

class SubprocessConfiguration extends DataFlow::Configuration {
  SubprocessConfiguration() { this = "SubprocessConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ShellSource or source instanceof PythonSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticStringSanitizer or sanitizer instanceof ShellSafeArraySanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(SubprocessConfiguration conf |
    conf.hasFlowPath(source, sink)
  )
select sink, "Detected subprocess function call without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'."
