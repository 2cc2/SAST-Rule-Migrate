Rule Content:
/**
 * @name Dangerous Subprocess Use Audit
 * @description Detected subprocess function without a static string. If this data can be controlled by a malicious actor,
 * it may be an instance of command injection. Audit the use of this call to ensure it is not controllable by
 * an external resource. You may consider using 'shlex.escape()'.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-subprocess-use-audit
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.TaintTracking::Configuration

class SubprocessCall extends MethodCall {
  SubprocessCall() {
    this.getTarget().(QualifiedName).getPackage() = "subprocess" and
    this.getMethodName().matches("%")
  }

  string getQualifiedName() { result = this.getTarget().toString() }
  string toString() { result = "Subprocess call: " + this.getQualifiedName() }
}

class ShellExecutionSource extends DataFlow::SourceNode {
  ShellExecutionSource() {
    exists(SubprocessCall call |
      call.getAnArgument(0).getStringValue() = any("sh", "bash", "ksh", "csh", "tcsh", "zsh").getAValue() and
      call.getAnArgument(1).getStringValue() = "-c" and
      this = call
    )
  }
}

class PythonExecutionSource extends DataFlow::SourceNode {
  PythonExecutionSource() {
    exists(SubprocessCall call |
      call.getAnArgument(0).getStringValue() = "python" and
      this = call
    )
  }
}

class SubprocessSink extends DataFlow::SinkNode {
  SubprocessSink() {
    exists(SubprocessCall call | this = call)
  }
}

class StaticStringSanitizer extends DataFlow::Sanitizer {
  StaticStringSanitizer() {
    exists(SubprocessCall call |
      call.getAnArgument(0).getStringValue() = "..." and
      this = call
    )
  }
}

class ShellSafeArraySanitizer extends DataFlow::Sanitizer {
  ShellSafeArraySanitizer() {
    exists(SubprocessCall call |
      call.getAnArgument(0).getStringValue() != any("sh", "bash", "ksh", "csh", "tcsh", "zsh").getAValue() and
      this = call
    )
  }
}

class DangerousSubprocessConfig extends TaintTracking::Configuration {
  DangerousSubprocessConfig() { this = "DangerousSubprocessConfig" }

  override predicate isSource(DataFlow::SourceNode source) {
    source instanceof ShellExecutionSource or
    source instanceof PythonExecutionSource
  }

  override predicate isSink(DataFlow::SinkNode sink) {
    sink instanceof SubprocessSink
  }

  override predicate isSanitizer(DataFlow::Sanitizer sanitizer) {
    sanitizer instanceof StaticStringSanitizer or
    sanitizer instanceof ShellSafeArraySanitizer
  }

  override predicate propagates(DataFlow::Node pred, DataFlow::Node succ) {
    pred.asExpr() = succ.(DataFlow::ExprNode).getAMethodCallArgument()
  }
}

from DangerousSubprocessConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Detected subprocess function '" + sink.getNode().(SubprocessCall).getQualifiedName() + 
  "' without a static string. This may be vulnerable to command injection."
