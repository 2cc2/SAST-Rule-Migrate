Rule Content:
/**
 * @name Dangerous subprocess use audit
 * @description Detected subprocess function without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection.
 * @kind problem
 * @problem.severity error
 * @id python/dangerous-subprocess-use-audit
 */

import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph
import semmle.python.dataflow.new.TaintTracking

class SubprocessFunction extends BuiltinFunction {
  SubprocessFunction() {
    this.getPackage() = "subprocess" and
    this.getName().matches("%FUNC%")
  }
}

class ShellExecutionSource extends DataFlow::Node {
  ShellExecutionSource() {
    exists(Call call, SubprocessFunction func |
      call.getTarget() = func and
      call.getArg(0).getStringValue().matches("/(sh|bash|ksh|csh|tcsh|zsh)/") and
      call.getArg(1).getStringValue() = "-c"
    )
  }
}

class PythonExecutionSource extends DataFlow::Node {
  PythonExecutionSource() {
    exists(Call call, SubprocessFunction func |
      call.getTarget() = func and
      call.getArg(0).getStringValue().matches("/(python)/")
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(Call call, SubprocessFunction func | call.getTarget() = func)
  }
}

class Sanitizer extends DataFlow::Node {
  Sanitizer() {
    exists(Call call, SubprocessFunction func |
      call.getTarget() = func and
      call.getArg(0).getStringValue() = "..."
    )
  }
}

class ShellSafeArraySanitizer extends DataFlow::Node {
  ShellSafeArraySanitizer() {
    exists(Call call, SubprocessFunction func |
      call.getTarget() = func and
      not call.getArg(0).getStringValue().matches("/(sh|bash|ksh|csh|tcsh|zsh)/")
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "SubprocessTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ShellExecutionSource or
    source instanceof PythonExecutionSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof Sanitizer or
    sanitizer instanceof ShellSafeArraySanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig conf
where conf.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(), 
  "Detected subprocess function '$FUNC' without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection. Audit the use of this call to ensure it is not controllable by an external resource. You may consider using 'shlex.escape()'."
