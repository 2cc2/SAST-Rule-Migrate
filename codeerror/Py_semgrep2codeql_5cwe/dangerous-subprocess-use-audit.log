Rule Content:
/**
 * @name Dangerous subprocess use audit
 * @description Detected subprocess function without a static string. If this data can be
 *   controlled by a malicious actor, it may be an instance of command injection.
 * @id dangerous-subprocess-use-audit
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-088
 */

import python
import semmle.python.Concepts
import DataFlow
import TaintTracking

class SubprocessCall extends DataFlow::Node {
  SubprocessCall() {
    exists(FunctionValue func, Call call |
      call.getFunc() = func and
      func.getModule().getName() = "subprocess" and
      this.asExpr() = call
    )
  }

  string getFunctionName() {
    result = this.getFunc().getName()
  }
}

class ShellSource extends DataFlow::Node {
  ShellSource() {
    exists(SubprocessCall call |
      call.getArg(0).getValueExpr().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)") and
      call.getArg(1).getValueExpr().matches("-c") and
      this.asSource() = call
    )
  }
}

class PythonSource extends DataFlow::Node {
  PythonSource() {
    exists(SubprocessCall call |
      call.getArg(0).getValueExpr().regexpMatch("python") and
      this.asSource() = call
    )
  }
}

class StaticStringSanitizer extends DataFlow::Node {
  StaticStringSanitizer() {
    exists(SubprocessCall call |
      call.getArg(0).getValueExpr().matches("...") and
      this.asSanitizer() = call
    )
  }
}

class ShellSafeArraySanitizer extends DataFlow::Node {
  ShellSafeArraySanitizer() {
    exists(SubprocessCall call |
      not call.getArg(0).getValueExpr().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)") and
      this.asSanitizer() = call
    )
  }
}

class ArgumentToCall extends TaintTracking::TaintBarrier {
  override predicate propagatesTaint(DataFlow::Node source, DataFlow::Node sink) {
    exists(Call call |
      source.asExpr() = call.getAnArg() and
      sink.asExpr() = call
    )
  }
}

class DangerousSubprocessConfig extends TaintTracking::Configuration {
  DangerousSubprocessConfig() { this = "DangerousSubprocessConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ShellSource or
    source instanceof PythonSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticStringSanitizer or
    sanitizer instanceof ShellSafeArraySanitizer
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof ArgumentToCall
  }
}

from DangerousSubprocessConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Detected subprocess function '" + sink.getFunctionName() + 
  "' without a static string. If this data can be controlled by a malicious actor, " +
  "it may be an instance of command injection. Audit the use of this call to ensure " +
  "it is not controllable by an external resource. You may consider using 'shlex.escape()'."
