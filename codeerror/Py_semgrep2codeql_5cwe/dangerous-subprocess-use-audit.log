/**
 * @name Dangerous Subprocess Use
 * @description Detects subprocess function calls without static strings that could lead to command injection
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-subprocess-use
 */

import python
import DataFlow::PathGraph
import semmle.python.security.CommandInjectionCustomizations

private class SubprocessCall extends DataFlow::Node {
  SubprocessCall() {
    exists(Call call |
      call.getCalleeName().matches("subprocess.(run|call|Popen)") and
      this.asExpr() = call
    )
  }
}

private class ShellSource extends DataFlow::Node {
  ShellSource() {
    exists(Call call, string shellPattern |
      call.getCalleeName().matches("subprocess.(run|call|Popen)") and
      call.getArgument(1).getValue().toString() = "-c" and
      shellPattern.matches("/(sh|bash|ksh|csh|tcsh|zsh)/") and
      call.getArgument(0).getValue().toString().matches(shellPattern) and
      this.asSource() = call
    )
  }
}

private class PythonSource extends DataFlow::Node {
  PythonSource() {
    exists(Call call, string pythonPattern |
      call.getCalleeName().matches("subprocess.(run|call|Popen)") and
      pythonPattern.matches("/python/") and
      call.getArgument(0).getValue().toString().matches(pythonPattern) and
      this.asSource() = call
    )
  }
}

private class StaticStringSanitizer extends DataFlow::Node {
  StaticStringSanitizer() {
    exists(Call call |
      call.getCalleeName().matches("subprocess.(run|call|Popen)") and
      call.getArgument(0).getValue().toString() = "..." and
      this.asSanitizer() = call
    )
  }
}

private class ShellSafeArraySanitizer extends DataFlow::Node {
  ShellSafeArraySanitizer() {
    exists(Call call |
      call.getCalleeName().matches("subprocess.(run|call|Popen)") and
      not call.getArgument(0).getValue().toString().matches("/(sh|bash|ksh|csh|tcsh|zsh)/") and
      this.asSanitizer() = call
    )
  }
}

class SubprocessConfiguration extends TaintTracking::Configuration {
  SubprocessConfiguration() { this = "SubprocessConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ShellSource or source instanceof PythonSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticStringSanitizer or sanitizer instanceof ShellSafeArraySanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SubprocessConfiguration config
where config.hasFlowPath(source, sink)
select sink, "Detected subprocess function call without a static string. $@",
  "This may be an instance of command injection if the data can be controlled by an attacker. " +
  "Consider using 'shlex.escape()' or passing commands as an array."
