Rule Content:
/**
 * @name Dangerous subprocess call without static string
 * @description Detects subprocess function calls without a static string that could lead to command injection
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-subprocess-use
 */

import python
import semmle.python.Concepts
import DataFlow
import DataFlow::PathGraph
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking

class SubprocessCall extends API::Function {
  SubprocessCall() {
    this.getPackage().getName() = "subprocess" and
    exists(string func | this.getQualifiedName() = "subprocess." + func | true)
  }
}

class ShellExecutionSource extends DataFlow::Node {
  ShellExecutionSource() {
    exists(Exprs::Call call |
      call.getCallee() instanceof SubprocessCall and
      (
        (this.asExpr() = call.getArgument(0) and
        (this.asExpr().(StringLiteral).getValue()).regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)")) or
        (this.asExpr() = call.getArgument(1) and
        (this.asExpr().(StringLiteral).getValue()) = "-c")
      )
    )
  }
}

class PythonExecutionSource extends DataFlow::Node {
  PythonExecutionSource() {
    exists(Exprs::Call call |
      call.getCallee() instanceof SubprocessCall and
      this.asExpr() = call.getArgument(0) and
      (this.asExpr().(StringLiteral).getValue()).regexpMatch("python")
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(Exprs::Call call |
      call.getCallee() instanceof SubprocessCall and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class StaticStringSanitizer extends DataFlow::Node {
  StaticStringSanitizer() {
    exists(Exprs::Call call |
      call.getCallee() instanceof SubprocessCall and
      this.asExpr() = call.getArgument(0) and
      (this.asExpr().(StringLiteral).getValue()) = "..."
    )
  }
}

class ShellSafeArraySanitizer extends DataFlow::Node {
  ShellSafeArraySanitizer() {
    exists(Exprs::Call call |
      call.getCallee() instanceof SubprocessCall and
      exists(string shell |
        this.asExpr() = call.getArgument(0) and
        not (this.asExpr().(StringLiteral).getValue()).regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)")
      )
    )
  }
}

class ShellCommandInjectionConfig extends TaintTracking::Configuration {
  ShellCommandInjectionConfig() { this = "ShellCommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ShellExecutionSource or source instanceof PythonExecutionSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticStringSanitizer or sanitizer instanceof ShellSafeArraySanitizer
  }
}

from ShellCommandInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected subprocess function call without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection. Audit the use of this call to ensure it is not controllable by an external resource. You may consider using 'shlex.escape()'."
