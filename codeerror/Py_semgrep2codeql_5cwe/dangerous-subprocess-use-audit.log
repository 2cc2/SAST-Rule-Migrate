Rule Content:
/**
 * @name Dangerous Subprocess Use
 * @description Detects subprocess function calls without static strings that may lead to command injection
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-subprocess-use
 */

import python
import semmle.python.ApiGraphs
import DataFlow

class SubprocessCall extends DataFlow::CallNode {
  SubprocessCall() {
    getReceiver().toString() = "subprocess" and
    exists(Method m | m = getMethod() | 
      m.getName().matches("Popen|run|call|check_call|check_output")
    )
  }

  string getFunctionName() { result = getMethod().getName() }
  Expr getCommandArg() { result = getArgument(0) }
  Expr getShellArg() { result = getArgument(1) }
}

class ShellSource extends DataFlow::Source {
  ShellSource() {
    exists(string shell |
      shell = ["sh", "bash", "ksh", "csh", "tcsh", "zsh"].getAString() |
      toString() = shell
    )
  }
}

class PythonSource extends DataFlow::Source {
  PythonSource() {
    toString() = "python"
  }
}

class SubprocessSink extends DataFlow::Sink {
  SubprocessSink() {
    exists(SubprocessCall call |
      this.asExpr() = call.getCommandArg()
    )
  }
}

class StaticStringSanitizer extends DataFlow::SanitizerNode {
  StaticStringSanitizer() {
    exists(SubprocessCall call |
      this.asExpr() = call.getCommandArg() and
      call.getCommandArg().getStringValue().isFixed()
    )
  }
}

class ShellSafeArraySanitizer extends DataFlow::SanitizerNode {
  ShellSafeArraySanitizer() {
    exists(SubprocessCall call |
      this.asExpr() = call.getCommandArg() and
      not call.getCommandArg().getStringValue().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)")
    )
  }
}

class DangerousSubprocessConfig extends DataFlow::Configuration {
  DangerousSubprocessConfig() { this = "DangerousSubprocessConfig" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof ShellSource or
    source instanceof PythonSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof SubprocessSink
  }

  override predicate isSanitizer(DataFlow::SanitizerNode sanitizer) {
    sanitizer instanceof StaticStringSanitizer or
    sanitizer instanceof ShellSafeArraySanitizer
  }

  override predicate propagates(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodCall call |
      pred.asExpr() = call.getAnArgument() and
      succ.asExpr() = call
    )
  }
}

from DangerousSubprocessConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected subprocess function '" + sink.getNode().(SubprocessCall).getFunctionName() + 
  "' without a static string. If this data can be controlled by a malicious actor, " +
  "it may be an instance of command injection. Audit the use of this call to ensure " +
  "it is not controllable by an external resource. Consider using 'shlex.escape()'.",
  source, sink, "Potential command injection"
