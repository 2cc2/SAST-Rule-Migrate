Rule Content:
/**
 * @name Dangerous subprocess use audit
 * @description Detected subprocess function call without a static string. If this data can be controlled by a
 * malicious actor, it may be an instance of command injection. Audit the use of this call to ensure it is not
 * controllable by an external resource. Consider using 'shlex.escape()'.
 * @kind path-problem
 * @problem.severity error
 * @id py/dangerous-subprocess-use-audit
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts

class SubprocessCall extends API::CallNode {
  SubprocessCall() {
    exists(Expr e | 
      e = API::moduleImport("subprocess").getACall() and
      this = e
    )
  }
}

class ShellExecution extends API::CallNode {
  ShellExecution() {
    exists(SubprocessCall call |
      call.getArg(0).getValueText().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)") and
      call.getArg(1).getValueText() = "-c" and
      this = call
    )
  }
}

class PythonExecution extends API::CallNode {
  PythonExecution() {
    exists(SubprocessCall call |
      call.getArg(0).getValueText().regexpMatch("python") and
      this = call
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "Dangerous subprocess use audit" }

  override predicate isSource(DataFlow::Node source) {
    exists(ShellExecution shellExec | source = shellExec.getAParameterNode()) or
    exists(PythonExecution pythonExec | source = pythonExec.getAParameterNode())
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SubprocessCall call | sink = call.getAParameterNode())
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SubprocessCall call |
      call.getArg(0).getValueText() = "..." and
      sanitizer = call.getAParameterNode()
    ) or
    exists(SubprocessCall call |
      not call.getArg(0).getValueText().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)") and
      sanitizer = call.getAParameterNode()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from DataFlow::Node source, DataFlow::Node sink, Config conf
where conf.hasFlow(source, sink)
select sink, "Detected subprocess function call without a static string. Audit this call for potential command injection.", 
  source, "User controllable input"
