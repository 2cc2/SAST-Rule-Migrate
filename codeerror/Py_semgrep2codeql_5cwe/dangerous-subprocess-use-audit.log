Rule Content:
/**
 * @name Dangerous subprocess use audit
 * @description Detected subprocess function without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-subprocess-use-audit
 */

import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph
import semmle.python.security.CommandInjection

class ShellExecution extends DataFlow::Node {
  ShellExecution() {
    exists(API::CallNode call |
      call = this.asExpr() and
      call.getAPI().getPackage() = "subprocess" and
      regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/", call.getArgument(0).toString()) and
      call.getArgument(1).toString() = "-c"
    )
  }
}

class PythonExecution extends DataFlow::Node {
  PythonExecution() {
    exists(API::CallNode call |
      call = this.asExpr() and
      call.getAPI().getPackage() = "subprocess" and
      regexpMatch("/(python)/", call.getArgument(0).toString())
    )
  }
}

class SubprocessCall extends DataFlow::Node {
  SubprocessCall() {
    exists(API::CallNode call |
      call = this.asExpr() and
      call.getAPI().getPackage() = "subprocess"
    )
  }

  string getFunctionName() {
    result = this.asExpr().(API::CallNode).getAPI().getName()
  }
}

predicate isSource(DataFlow::Node source) {
  exists(ShellExecution shell | shell = source) or
  exists(PythonExecution py | py = source)
}

predicate isSink(DataFlow::Node sink) {
  exists(SubprocessCall call | call = sink)
}

predicate isSanitizer(DataFlow::Node sanitized) {
  exists(API::CallNode call |
    call = sanitized.asExpr() and
    call.getAPI().getPackage() = "subprocess" and
    (
      call.getArgument(0).toString() = "..." or
      not regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/", call.getArgument(0).toString())
    )
  )
}

class SubprocessConfig extends DataFlow::Configuration {
  SubprocessConfig() { this = "SubprocessConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(ShellExecution shell | shell = source) or
    exists(PythonExecution py | py = source)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SubprocessCall call | call = sink)
  }

  override predicate isSanitizer(DataFlow::Node sanitized) {
    exists(API::CallNode call |
      call = sanitized.asExpr() and
      call.getAPI().getPackage() = "subprocess" and
      (
        call.getArgument(0).toString() = "..." or
        not regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/", call.getArgument(0).toString())
      )
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
      param.asExpr() = pred and arg.asExpr() = succ and
      arg.getCall() = param.getCall()
    )
  }
}

from SubprocessConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Detected subprocess function '" + sink.getNode().(SubprocessCall).getFunctionName() + 
  "' without a static string. If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'.", source, sink
