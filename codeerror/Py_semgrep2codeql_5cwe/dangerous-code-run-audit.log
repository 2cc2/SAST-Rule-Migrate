Rule Content:
/**
 * @name Dangerous interactive code execution
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.
 * @kind path-problem
 * @problem.severity warning
 * @id python/dangerous-interactive-code-run-audit
 */

import python
import DataFlow
import DataFlow::TaintTracking
import Semmle.Python.DataFlow.new.Extension
import semmle.python.ApiGraphs

class DangerousInteractiveCodeConfig extends DataFlow::Configuration {
  DangerousInteractiveCodeConfig() { this = "DangerousInteractiveCodeConfig" }

  override predicate isSource(DataFlow::SourceNode source) {
    exists(Call call |
      call.getCalleeName() = "compile_command" and
      call.getQualifier().(Name).getId() = "code" and
      getStringConstant(call.getArg(0)) != "..."
    )
  }

  override predicate isSink(DataFlow::SinkNode sink) {
    exists(Call call |
      (
        call.getCalleeName() = "push" or
        call.getCalleeName() = "runsource" or
        call.getCalleeName() = "runcode"
      ) and
      call.getQualifier().(Name).getId() = "code" and
      getStringConstant(call.getArg(0)) != "..."
    )
  }

  override predicate isSanitizer(DataFlow::SanitizerNode sanitizer) {
    exists(Call call | 
      getStringConstant(call.getArg(0)) = "..."
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::AdditionalTaintStep step) {
    true
  }

  override predicate isExtension(DataFlow::Extension extension) {
    extension instanceof PayloadToExecExtension
  }
}

class PayloadToExecExtension extends DataFlow::Extension {
  PayloadToExecExtension() { this = "PayloadToExecExtension" }
}

string getStringConstant(Expr e) {
  result = e.(StringLiteral).getValue()
}

from DangerousInteractiveCodeConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it allows a malicious actor to " +
  "run arbitrary Python code. Ensure no external data reaches here."
