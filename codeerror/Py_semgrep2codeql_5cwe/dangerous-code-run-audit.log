import python
import semmle.python.dataflow.PathGraph
import DataFlow
import TaintTracking

private class DangerousInteractiveSource extends TaintTracking::TaintSource {
  DangerousInteractiveSource() {
    exists(Call call |
      call.getFunc().(Name).getId() = "compile_command" and
      call.getFunc().getParentScope() instanceof Module and
      call.getFunc().getParentScope().getName() = "code" and
      call.getArg(0).getValue() != "..."
    )
  }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      source.asExpr() = call.getArg(0) and
      call.getFunc().(Name).getId() = "compile_command" and
      call.getFunc().getParentScope() instanceof Module and
      call.getFunc().getParentScope().getName() = "code" and
      call.getArg(0).getValue() != "..."
    )
  }
}

private class DangerousInteractiveSink extends TaintTracking::TaintSink {
  DangerousInteractiveSink() {
    exists(Call call |
      (call.getFunc().(Name).getId() = "push" or
       call.getFunc().(Name).getId() = "runsource" or
       call.getFunc().(Name).getId() = "runcode") and
      call.getFunc().getParentScope() instanceof Module and
      call.getFunc().getParentScope().getName() = "code" and
      call.getArg(0).getValue() != "..."
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      sink.asExpr() = call.getArg(0) and
      (call.getFunc().(Name).getId() = "push" or
       call.getFunc().(Name).getId() = "runsource" or
       call.getFunc().(Name).getId() = "runcode") and
      call.getFunc().getParentScope() instanceof Module and
      call.getFunc().getParentScope().getName() = "code" and
      call.getArg(0).getValue() != "..."
    )
  }
}

private class StaticContentSanitizer extends TaintTracking::Sanitizer {
  StaticContentSanitizer() {
    exists(Call call |
      call.getArg(0).getValue() = "..."
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Call call |
      node.asExpr() = call.getArg(0) and
      call.getArg(0).getValue() = "..."
    )
  }
}

class DangerousInteractiveCodeRunAudit extends TaintTracking::Configuration {
  DangerousInteractiveCodeRunAudit() { this = "dangerous-interactive-code-run-audit" }

  override predicate isSource(DataFlow::Node source) { source instanceof DangerousInteractiveSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof DangerousInteractiveSink }

  override predicate isSanitizer(DataFlow::Node node) { node instanceof StaticContentSanitizer }
}

from DangerousInteractiveCodeRunAudit config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it allows a " +
  "malicious actor to run arbitrary Python code. Ensure no external data reaches here."
