Rule Content:
/**
 * @name Dangerous interactive code execution
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.
 *              This is dangerous if external data can reach this function call.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id python/dangerous-interactive-code-exec
 * @tags security
 *       external/cwe/cwe-094
 */

import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph
import DataFlow
import TaintTracking

class PythonCodeInteractive extends DataFlow::Configuration {
  PythonCodeInteractive() { this = "PythonCodeInteractive" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call | 
      call.getFunc().(Attribute).getName() = "compile_command" and
      call.getFunc().(Attribute).getObj().getType().getName() = "code" and
      source.asExpr() = call.getArg(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call | 
      (call.getFunc().(Attribute).getName() = "push" or
       call.getFunc().(Attribute).getName() = "runsource" or
       call.getFunc().(Attribute).getName() = "runcode") and
      call.getFunc().(Attribute).getObj().getType().getName() = "code" and
      sink.asExpr() = call.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Literal lit |
      lit.getStringValue() = "..." and
      node.asExpr() = lit
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where any(PythonCodeInteractive conf).hasFlowPath(source, sink)
select sink, source, sink,
  "Dynamic content inside InteractiveConsole/InteractiveInterpreter method. Ensure no external data reaches here."
