Rule Content:
/**
 * @name Dangerous interactive code execution
 * @description Detects dynamic content inside InteractiveConsole/InteractiveInterpreter methods
 * @kind problem
 * @id python/dangerous-interactive-code-run
 * @security-severity 7.5
 * @tags security
 *       external/cwe/cwe-074
 */

import python
import semmle.python.ApiGraphs
import TaintTracking
import DataFlow::PathGraph

class DangerousInteractiveCodeConfig extends TaintTracking::Configuration {
  DangerousInteractiveCodeConfig() { this = "DangerousInteractiveCodeConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof DynamicPayload
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof InteractiveExecSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof StaticContentSanitizer
  }
}

private class DynamicPayload extends TaintTracking::TaintSource {
  DynamicPayload() {
    exists(Call call |
      call.getTarget().hasPackageName("code") and
      call.getTarget().getName() = "compile_command" and
      call.getArg(0).getStringValue() != "..." and
      this = call.getArg(0)
    )
  }
}

private class InteractiveExecSink extends TaintTracking::TaintSink {
  InteractiveExecSink() {
    exists(Call call |
      call.getTarget().hasPackageName("code") and
      (call.getTarget().getName().matches("push") or
       call.getTarget().getName().matches("runsource") or
       call.getTarget().getName().matches("runcode")) and
      call.getArg(0).getStringValue() != "..." and
      this = call.getArg(0)
    )
  }
}

private class StaticContentSanitizer extends TaintTracking::Sanitizer {
  StaticContentSanitizer() {
    exists(Call call |
      call.getArg(0).getStringValue() = "..." and
      this = call.getArg(0)
    )
  }
}

from DangerousInteractiveCodeConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it " +
  "allows a malicious actor to run arbitrary Python code. Ensure no external data reaches here.",
  source.getNode(), sink.getNode(), 
  "Potential dangerous interactive code execution"
