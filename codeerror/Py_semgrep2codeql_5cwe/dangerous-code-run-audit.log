Rule Content:
/**
 * @name Dangerous Interactive Code Execution
 * @id dangerous-interactive-code-run-audit
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.PathGraph

class DangerousInteractiveExecution extends TaintTracking::Configuration {
  DangerousInteractiveExecution() { this = "DangerousInteractiveExecution" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      call.getFunc().(Function).getName() = "compile_command" and
      call.getFunc().(Function).getParentScope().(Module).getName() = "code" and
      not call.getArg(0).(StringLiteral).getValue() = "..."
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      (call.getFunc().(Function).getName() = "push" or
       call.getFunc().(Function).getName() = "runsource" or
       call.getFunc().(Function).getName() = "runcode") and
      call.getFunc().(Function).getParentScope().(Module).getName() = "code" and
      not call.getArg(0).(StringLiteral).getValue() = "..."
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getArg(0).(StringLiteral).getValue() = "..."
    )
  }
}

from DangerousInteractiveExecution config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it allows a malicious actor " +
  "to run arbitrary Python code. Ensure no external data reaches here."
