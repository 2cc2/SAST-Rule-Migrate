Rule Content:
/**
 * @name Dangerous interactive code execution
 * @kind problem
 * @id python/security/dangerous-interactive-code-run
 * @problem.severity warning
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. 
 *              This is dangerous if external data can reach this function because it allows 
 *              arbitrary Python code execution.
 */
import python
import semmle.python.ApiGraphs
import DataFlow
import TaintTracking
import DataFlow::PathGraph

class InteractiveCodeConfig extends TaintTracking::Configuration {
  InteractiveCodeConfig() { this = "InteractiveCodeConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call, string qual |
      call.getFunc().getName() = "compile_command" and
      call.getImmediateQualifier() = qual and
      qual = "code" and
      source.asExpr() = call.getArg(0) and
      not call.getArg(0).getStringValue() = "..."
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call, string qual |
      call.getFunc().getName().matches("push|runsource|runcode") and
      call.getImmediateQualifier() = qual and
      qual = "code" and
      sink.asExpr() = call.getArg(0) and
      not call.getArg(0).getStringValue() = "..."
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      sanitizer.asExpr() = call.getArg(0) and
      call.getArg(0).getStringValue() = "..."
    )
  }
}

from InteractiveCodeConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it allows " +
  "a malicious actor to run arbitrary Python code. Ensure no external data reaches here.",
  source.getNode(), "Potential user-controlled input"
