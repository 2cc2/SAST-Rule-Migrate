Rule Content:
/**
 * @name Dangerous Interactive Code Execution
 * @description Detects dynamic content inside InteractiveConsole/InteractiveInterpreter methods
 * @kind taint
 * @problem.severity warning
 * @id py/dangerous-interactive-code-run-audit
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class DynamicPayload extends DataFlow::Node {
  DynamicPayload() {
    exists(Call call, string methodName |
      call.getMethodName() = methodName and
      methodName = "compile_command" and
      call.getAPackageName() = "code" and
      this.asExpr() = call.getArgument(0).getExpr() and
      not call.getArgument(0).getStringValue() = "..."
    )
  }
}

class InteractiveExecSink extends DataFlow::Node {
  InteractiveExecSink() {
    exists(Call call, string methodName |
      (methodName = "push" or methodName = "runsource" or methodName = "runcode") and
      call.getMethodName() = methodName and
      call.getAPackageName() = "code" and
      this.asExpr() = call.getArgument(0).getExpr() and
      not call.getArgument(0).getStringValue() = "..."
    )
  }
}

class StaticContentSanitizer extends DataFlow::Node {
  StaticContentSanitizer() {
    exists(Call call |
      call.getArgument(0).getStringValue() = "..." and
      this.asExpr() = call.getArgument(0).getExpr()
    )
  }
}

class DangerousInteractiveCodeFlowConfig extends TaintTracking::Configuration {
  DangerousInteractiveCodeFlowConfig() { this = "DangerousInteractiveCodeFlow" }

  override predicate isSource(DataFlow::Node source) { source instanceof DynamicPayload }

  override predicate isSink(DataFlow::Node sink) { sink instanceof InteractiveExecSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticContentSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from DangerousInteractiveCodeFlowConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it allows " +
  "a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
