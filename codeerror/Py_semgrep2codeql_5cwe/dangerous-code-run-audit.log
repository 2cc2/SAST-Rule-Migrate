Rule Content:
/**  
 * @name Dangerous Interactive Code Execution  
 * @description Detects dangerous dynamic code execution through InteractiveConsole/InteractiveInterpreter  
 * @kind path-problem     
 * @problem.severity warning  
 * @precision high  
 * @id python/dangerous-interactive-code-run  
 */  
    
import python  
import semmle.python.dataflow.DataFlow  
import semmle.python.dataflow.TaintTracking  
import DataFlow::PathGraph  

class InteractiveCodeSource extends RemoteFlowSource::Range {
  InteractiveCodeSource() {
    exists(Call call | 
      call.getTarget().getName() = "compile_command" and
      call.getTarget().getQualifiedName() = "code.InteractiveInterpreter.compile_command" and
      call.getArgument(0).getStringValue() != ""
    )
  }
}

class InteractiveCodeSink extends RemoteFlowSink::Range {
  InteractiveCodeSink() {
    exists(Call call |
      (call.getTarget().getName() = "push" or 
       call.getTarget().getName() = "runsource" or 
       call.getTarget().getName() = "runcode") and
      call.getTarget().getQualifiedName().matches("code.Interactive%") and
      call.getArgument(0).getStringValue() != ""
    )
  }
}

class InteractiveCodeSanitizer extends Sanitizer::Range {
  InteractiveCodeSanitizer() {
    exists(Call call |
      (call.getTarget().getName() = "push" or 
       call.getTarget().getName() = "runsource" or 
       call.getTarget().getName() = "runcode" or
       call.getTarget().getName() = "compile_command") and
      call.getTarget().getQualifiedName().matches("code.Interactive%") and
      call.getArgument(0).getStringValue() = "..."
    )
  }
}

class InteractiveCodeConfig extends TaintTracking::Configuration {
  InteractiveCodeConfig() { this = "InteractiveCodeConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof InteractiveCodeSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof InteractiveCodeSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof InteractiveCodeSanitizer }
}

from InteractiveCodeConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because " +
  "it allows a malicious actor to run arbitrary Python code. " +
  "Ensure no external data reaches here.", source, sink, 
  "Potential unsafe interactive code execution"
