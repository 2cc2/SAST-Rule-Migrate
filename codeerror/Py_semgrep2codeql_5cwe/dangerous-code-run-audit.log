Rule Content:
/**
 * @name Dangerous Interactive Code Execution
 * @kind path-problem
 * @problem.severity warning
 * @description Detects dynamic content inside InteractiveConsole/InteractiveInterpreter methods
 *              which allows arbitrary Python code execution if external data reaches these calls.
 * @id py/dangerous-interactive-code-execution
 */
import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import DataFlow::TaintTracking
import DataFlow::PathGraph

class DangerousInteractiveExecution extends DataFlow::TaintTracking::Configuration {
  DangerousInteractiveExecution() { this = "DangerousInteractiveExecution" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      call.getFuncDecl().getName() = "compile_command" and
      call.getFuncDecl().getDecl().getParentScope() instanceof Module and
      call.getFuncDecl().getDecl().getParentScope().getName() = "code" and
      not call.getArg(0).getAStringValue() = "..." and
      source.asExpr() = call.getArg(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getFuncDecl().getName().matches("push|runsource|runcode") and
      call.getFuncDecl().getDecl().getParentScope() instanceof Module and
      call.getFuncDecl().getDecl().getParentScope().getName() = "code" and
      not call.getArg(0).getAStringValue() = "..." and
      sink.asExpr() = call.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getArg(0).getAStringValue() = "..." and
      sanitizer.asExpr() = call.getArg(0)
    )
  }
}

from DangerousInteractiveExecution config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. This is dangerous if " +
  "external data can reach this function call because it allows a malicious actor to run arbitrary Python code."
