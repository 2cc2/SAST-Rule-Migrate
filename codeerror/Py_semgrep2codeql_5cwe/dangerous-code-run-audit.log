/**
 * @name Dangerous Interactive Code Execution
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.
 * @kind path-problem
 * @problem.severity warning
 * @id py/dangerous-interactive-code-run
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import DataFlow

class InteractiveCodeConfig extends TaintTracking::Configuration {
  InteractiveCodeConfig() { this = "InteractiveCodeConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(API::CallNode call |
      call.getMethodName() = "compile_command" and
      call.getPackageName() = "code" and
      source.asExpr() = call.getArg(0).getExpr() and
      not exists(StringLiteral lit | lit = call.getArg(0).getExpr() and lit.getValue() = "...")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(API::CallNode call |
      (call.getMethodName() = "push" or call.getMethodName() = "runsource" or call.getMethodName() = "runcode") and
      call.getPackageName() = "code" and
      sink.asExpr() = call.getArg(0).getExpr() and
      not exists(StringLiteral lit | lit = call.getArg(0).getExpr() and lit.getValue() = "...")
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(API::CallNode call |
      call.getMethodName() = "compile_command" and
      call.getPackageName() = "code" and
      sanitizer.asExpr() = call.getArg(0).getExpr() and
      exists(StringLiteral lit | lit = call.getArg(0).getExpr() and lit.getValue() = "...")
    )
  }
}

from InteractiveCodeConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it " +
  "allows a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
