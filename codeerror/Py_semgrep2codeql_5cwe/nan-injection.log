Rule Content:
/**
 * @name NaN Injection
 * @description Found user input going directly into typecast for bool(), float(), or complex(). 
 *              This allows an attacker to inject Python's not-a-number (NaN) into the typecast.
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import DataFlow::PathGraph

class FlaskRequestSource extends RemoteFlowSource {
  FlaskRequestSource() {
    exists(Call c | 
      c.getTarget().hasQualifiedName("flask", "request", "get") and
      this.asSource() = c
    )
  }

  override string getSourceType() { result = "Flask request parameter" }
}

class RouteParamSource extends RemoteFlowSource {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getADecorator().getName() = "route" and
      p = f.getAParameter() and
      this.asSource() = p
    )
  }

  override string getSourceType() { result = "Route parameter" }
}

class TypeCastSink extends DataFlow::Node {
  TypeCastSink() {
    exists(Call c |
      (
        c.getTarget().getName() = "float" or
        c.getTarget().getName() = "bool" or
        c.getTarget().getName() = "complex"
      ) and
      this.asSink() = c
    )
  }

  override string getSinkType() { result = "Type cast function" }
}

class AnyFunctionSanitizer extends TaintTracking::Sanitizer {
  AnyFunctionSanitizer() { this.asSanitizer() = any(Call c) }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjectionConfiguration" }

  override predicate isSource(RemoteFlowSource source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TypeCastSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof AnyFunctionSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, NanInjectionConfig config
where config.hasFlowPath(source, sink)
select sink, "Potential NaN injection from $@ to type cast", 
  source, source.getSourceType()
