/**
 * @name NaN Injection in Type Cast
 * @description Found user input going directly into typecast for bool(), float(), or complex().
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.functions.Types

private class FlaskRequestSource extends TaintTracking::TaintSource {
  FlaskRequestSource() {
    exists(DataFlow::Module m |
      m.getName() = "flask" and
      m.getMember("request").getMember("get").getACall() = this.asExpr()
    )
  }

  override string getSourceType() { "Flask request parameter" }
}

private class RouteParamSource extends TaintTracking::TaintSource {
  RouteParamSource() {
    exists(Function f, Function::Parameter p |
      f.getADecorator().hasName("route") and
      p = this.asParameter() and
      p.getFunction() = f
    )
  }

  override string getSourceType() { "Route parameter" }
}

private class TypeCastSink extends TaintTracking::TaintSink {
  TypeCastSink() {
    exists(Call c |
      c = this.asExpr() and
      (
        c.getCalleeName() = "float" or
        c.getCalleeName() = "bool" or
        c.getCalleeName() = "complex"
      )
    )
  }

  override string getSinkType() { "Type cast operation" }
}

private class AnyFunctionSanitizer extends TaintTracking::Sanitizer {
  AnyFunctionSanitizer() { this.asExpr() instanceof Call }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NaN Injection Configuration" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof TypeCastSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof AnyFunctionSanitizer
  }
}

