/**
 * @name NaN Injection
 * @description Detects user input going directly into typecast for bool(), float(), or complex()
 * @kind taint
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.Web.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call call |
      call.getFunc().(Name).getId() = "request" and
      call.getFunc().getScope().getPackage().getName() = "flask" and
      call.getFunc().getScope().(Class).getName() = "Flask" 
    ) and
    this = API::moduleImport("flask").getMember("request").getReturn()
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Param param |
      param.getAnAccess() = API::getRouteParamAccess() and
      param.getFunction().getAnAnnotation().getType().getName() = "route"
    ) and
    this = API::getRouteParamAccess().getAnAccess()
  }
}

class TypeCastSink extends DataFlow::Node {
  TypeCastSink() {
    exists(Call call |
      call.getCalledName() = ["float", "bool", "complex"] and
      call.getScope().isBuiltin()
    ) and
    this = Call.getCalledName() = ["float", "bool", "complex"].getScope().isBuiltin()
  }
}

class NaNInjectionConfig extends TaintTracking::Configuration {
  NaNInjectionConfig() { this = "NaN Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TypeCastSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call | call = sanitizer.asExpr())
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from DataFlow::Node source, DataFlow::Node sink, NaNInjectionConfig config
where config.hasFlow(source, sink)
select sink, "Found user input going directly into typecast. This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
