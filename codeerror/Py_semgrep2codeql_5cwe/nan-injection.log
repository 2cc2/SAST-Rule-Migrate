Rule Content:
/**
 * @name NaN Injection in Python Type Casting
 * @description Detects user input going directly into typecast for bool(), float(), or complex()
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.WebFramework

class FlaskRequestSource extends RemoteFlowSource::Range {
  FlaskRequestSource() {
    exists(Method m | 
      m.getAPIName() = "get" and
      m.getDeclaringType().getAPIName() = "request" and
      m.getDeclaringType().getPackage().getAPIName() = "flask" and
      this.asExpr() = m.getACall()
    )
  }
}

class RouteParamSource extends RemoteFlowSource::Range {
  RouteParamSource() {
    exists(Method method |
      method.hasDecorator("route") and
      method.getAPIName() = "route" and
      method.getDeclaringType().getPackage().getAPIName() = "flask" and
      exists(Parameter p | 
        p.getMethod() = method and
        this.asExpr() = p.getAnAccess()
      )
    )
  }
}

class TypeCastSink extends DataFlow::Node {
  TypeCastSink() {
    exists(Method m |
      m.getDeclaringType().getAPIName() = "builtins" and
      (m.getAPIName() = "bool" or m.getAPIName() = "float" or m.getAPIName() = "complex") and
      this.asExpr() = m.getACall()
    )
  }
}

predicate isSanitizer(DataFlow::Node node) {
  exists(Call call | 
    node.asExpr() = call
  )
}

module TaintTrackingConfig implements TaintTracking::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  predicate isSink(DataFlow::Node sink) {
    sink instanceof TypeCastSink
  }

  predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call | 
      sanitizer.asExpr() = call
    )
  }

  predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Parameter p, Argument arg |
      pred.asExpr() = arg and
      succ.asExpr() = p.getAnAccess() and
      arg.(PositionalArgument).getCall().getTarget() = p.getMethod()
    )
  }
}

from TaintTrackingConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
