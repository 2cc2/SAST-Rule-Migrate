/**
 * @name NaN Injection
 * @description Detects when user input flows directly into typecast operations (bool/float/complex)
 * @id nan-injection
 * @kind path-problem
 * @problem.severity error
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends TaintTracking::TaintSource {
  FlaskRequestSource() {
    exists(API::CallNode call |
      call.getModuleMember("request").getACall("get") and
      this.asExpr() = call
    )
  }
}

class RouteParamSource extends TaintTracking::TaintSource {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.hasDecorator("route") and
      p.getFunction() = f and
      this.asExpr() = p
    )
  }
}

class TypeCastSink extends TaintTracking::TaintSink {
  TypeCastSink() {
    exists(CallNode call |
      (
        call.getCallee().hasName("float") or
        call.getCallee().hasName("bool") or
        call.getCallee().hasName("complex")
      ) and
      this.asExpr() = call
    )
  }
  
  override predicate asCfgNode() { this = _ }
  override Location getLocation() { result = this.asExpr().getLocation() }
  override BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override Variable getVariable() { result = this.asVariable() }
}

class AnyFunctionSanitizer extends TaintTracking::Sanitizer {
  AnyFunctionSanitizer() {
    exists(Call c | this.asExpr() = c)
  }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjectionConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof TypeCastSink
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof AnyFunctionSanitizer
  }
}

from NanInjectionConfig cfg, PathNode source, PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
