Rule Content:
/**
 * @name NaN Injection in Type Casting
 * @description Detects user input going directly into typecast for bool(), float(), or complex()
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

predicate isFlaskRequestSource(DataFlow::Node source) {
  exists(Call call |
    call.getTarget().hasQualifiedName("flask.request", "get") and
    source.asExpr() = call
  )
}

predicate isRouteParamSource(DataFlow::Node source) {
  exists(Function f, ExprNode node |
    f.getDecorator().hasQualifiedName("flask", "route") and
    source.asExpr() = node and
    node = f.getAParameter().getARead()
  )
}

class TypeCastSink extends DataFlow::Node {
  TypeCastSink() {
    exists(Call call |
      (
        call.getTarget().hasQualifiedName("builtins", "float") or
        call.getTarget().hasQualifiedName("builtins", "bool") or
        call.getTarget().hasQualifiedName("builtins", "complex")
      ) and
      this.asExpr() = call.getArg(0)
    )
  }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    isFlaskRequestSource(source) or isRouteParamSource(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TypeCastSink
  }
  
  override predicate isSanitizer(DataFlow::Node node) {
    exists(Call _ | node.asExpr() = _)
  }
}

from NanInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
