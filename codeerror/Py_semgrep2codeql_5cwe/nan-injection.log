/**
 * @name NaN Injection
 * @description Detects user input going directly into typecast for bool(), float(), or complex()
 * @id nan-injection
 * @kind path-problem
 * @severity error
 * @tags security
 *       external/cwe/cwe-20
 */

import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.dataflow.new.DataFlow

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call call |
      call.getFunc().(Name).getId() = "get" and
      call.getFunc().getScope().__package__().getName() = "flask" and
      call.getFunc().getScope().getName() = "request" and
      this.asExpr() = call
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function func, Parameter param |
      func.getADecorator().(Call).getFunc().getId() = "route" and
      param = func.getAParameter() and
      this.asExpr() = param
    )
  }
}

class TypeCastSink extends DataFlow::Node {
  TypeCastSink() {
    exists(Call call |
      (
        call.getFunc().(Name).getId() = "float" or
        call.getFunc().(Name).getId() = "bool" or
        call.getFunc().(Name).getId() = "complex"
      ) and
      call.getFunc().getScope().getName() = "builtins" and
      this.asExpr() = call
    )
  }
}

class AnyFunctionSanitizer extends DataFlow::BarrierGuard {
  AnyFunctionSanitizer() {
    exists(Call call | this.asExpr() = call)
  }
}

class NaNInjectionConfig extends TaintTracking::Config {
  NaNInjectionConfig() { this = "NaNInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TypeCastSink
  }

  override predicate isSanitizer(DataFlow::BarrierGuard sanitizer) {
    sanitizer instanceof AnyFunctionSanitizer
  }
}

from DataFlow::Node source, DataFlow::Node sink, NaNInjectionConfig config
where config.hasFlow(source, sink)
select sink, "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
