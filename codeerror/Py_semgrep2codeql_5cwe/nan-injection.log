Rule Content:
/**
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 * @name NaN Injection via Type Casting
 */

import python
import DataFlow::PathGraph
import TaintTracking::PathGraph
import Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(DataFlow::CallNode cn |
      cn.getTarget().hasName(["get", "args", "form", "json"]) and
      cn.getTarget().getScope().getFile().getExtension() = "py" and
      cn.getTarget().getScope().getPackage().hasQualifiedName("flask", "request") and
      this = cn
    )
  }

  override DataFlow::Node asCfgNode() { result = this }
  override string toString() { result = "Flask request parameter" }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Flask::RouteParam p |
      this = p.getAnAccess()
    )
  }

  override DataFlow::Node asCfgNode() { result = this }
  override string toString() { result = "Route parameter" }
}

class TypeCastSink extends DataFlow::Node {
  TypeCastSink() {
    exists(DataFlow::CallNode cn |
      cn.getTarget().hasName(["float", "bool", "complex"]) and
      cn.getTarget().getScope().isTopLevel() and
      cn.getTarget().getScope().getPackage().hasQualifiedName("builtins") and
      this = cn
    )
  }

  override DataFlow::Node asCfgNode() { result = this }
  override string toString() { result = "Type cast operation" }
}

class NaNInjectionConfig extends TaintTracking::Configuration {
  NaNInjectionConfig() { this = "NaN Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TypeCastSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call c | c = sanitizer.asExpr())
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, NaNInjectionConfig conf
where conf.hasFlowPath(source, sink)
select sink, source, sink,
  "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
