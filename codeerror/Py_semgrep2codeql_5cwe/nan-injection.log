/**
 * @name NaN Injection in Type Cast
 * @description Detects user input going directly into typecast for bool(), float(), or complex()
 * @kind problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import DataFlow::PathGraph
import DataFlow::TaintTracking
import semmle.python.web.QueryStringParsing

class Config extends TaintTracking::Configuration {
  Config() { this = "NaNInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(API::Call call |
      call.getTarget().hasQualifiedName("flask.request", "get") and
      source.asExpr() = call.getArg(0)
    )
    or
    exists(Method m |
      m.getDecorator().getName() = "route" and
      source.asParameter() = m.getAParameter()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(API::BuiltinCall call |
      (
        call.getFunctionName() = "float" or
        call.getFunctionName() = "bool" or
        call.getFunctionName() = "complex"
      ) and
      sink.asExpr() = call.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Call call | node.asExpr() = call)
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, "Found user input going directly into typecast for bool(), float(), or complex(). This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
