Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in `csv` module.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.8
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.security.injection.CsvInjection
import semmle.python.web.Flask
import semmle.python.Concepts
import semmle.python.ApiGraphs

class FlaskUserInputSource extends RemoteFlowSource::Range {
  FlaskUserInputSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask.request", "form.get") or
      ma.getMethod().hasQualifiedName("flask.request", "form.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "args.get") or
      ma.getMethod().hasQualifiedName("flask.request", "args.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "values.get") or
      ma.getMethod().hasQualifiedName("flask.request", "values.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "cookies.get") or
      ma.getMethod().hasQualifiedName("flask.request", "cookies.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "stream") or
      ma.getMethod().hasQualifiedName("flask.request", "headers.get") or
      ma.getMethod().hasQualifiedName("flask.request", "headers.__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "data") or
      ma.getMethod().hasQualifiedName("flask.request", "full_path") or
      ma.getMethod().hasQualifiedName("flask.request", "url") or
      ma.getMethod().hasQualifiedName("flask.request", "json") or
      ma.getMethod().hasQualifiedName("flask.request", "get_json") or
      ma.getMethod().hasQualifiedName("flask.request", "view_args.get") or
      ma.getMethod().hasQualifiedName("flask.request", "view_args.__getitem__") and
      this = ma.getArgument(0)
    )
  }
}

class RouteParameterSource extends Parameter::Range {
  RouteParameterSource() {
    exists(Function f, Decorator d |
      d = f.getADecorator() and
      d.getTarget().toString().matches("@.*\.route\(.*\)") and
      this = f.getAParameter()
    )
  }
}

class CsvWriterSink extends DataFlow::Node {
  CsvWriterSink() {
    exists(MethodAccess ma |
      (ma.getMethod().hasQualifiedName("csv.writer", "writerow") or
       ma.getMethod().hasQualifiedName("csv.writer", "writerows") or
       ma.getMethod().hasQualifiedName("csv.writer", "writeheader")) and
      this = ma.getArgument(0)
    )
  }
}

predicate isSource(Node n) {
  n instanceof FlaskUserInputSource or n instanceof RouteParameterSource
}

predicate isSink(Node n) {
  n instanceof CsvWriterSink
}

from ConfigurableTaintTracking::TrackingConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where
  Configuration(cfg, isSource, isSink) and
  // Enable standard taint steps
  cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user input into a generated CSV file using the built-in `csv` module. " +
  "If user data is used to generate the data in this file, it is possible that an attacker " +
  "could inject a formula when the CSV is imported into a spreadsheet application that runs " +
  "an attacker script, which could steal data from the importing user or, at worst, " +
  "install malware on the user's computer. Use `defusedcsv` as a drop-in replacement."
