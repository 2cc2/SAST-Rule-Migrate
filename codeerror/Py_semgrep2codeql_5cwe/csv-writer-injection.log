Rule Content:
/**
 * @id python/csv-writer-injection
 * @name CSV Writer Formula Injection
 * @description Detects user input being written to CSV files without proper sanitization,
 * which could lead to formula injection attacks when opened in spreadsheet applications.
 * @kind taint-priority-problem
 * @security-severity 8.5
 * @tags security
 *       external/cwe/cwe-1236
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.DataFlow
import semmle.python.Concepts

class FlaskUserInputSource extends DataFlow::SourceNode {
  FlaskUserInputSource() {
    exists(MethodAccess ma |
      exists(string methodName |
        methodName = ["form.get", "form.__getitem__", "args.get", "args.__getitem__",
                     "values.get", "values.__getitem__", "cookies.get", "cookies.__getitem__",
                     "stream", "headers.get", "headers.__getitem__", "data", "full_path",
                     "url", "json", "get_json"]
        and
        ma.getMethod().getName() = methodName
        and
        ma.getReceiver().getType().getName() = "flask.request"
      )
      and
      this = ma
    )
  }
}

class RouteParameterSource extends DataFlow::SourceNode {
  RouteParameterSource() {
    exists(MethodParam p |
      exists(Decorator d |
        d.getTarget().toString().matches("@.*\\\\.route\\\\(.*\\\\)")
        and
        p.getParentScope() = d.getScope()
      )
      and
      this = p
    )
  }
}

class CsvWriterSink extends DataFlow::SinkNode {
  CsvWriterSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = ["writerow", "writerows", "writeheader"]
      and
      ma.getReceiver().getType().getName() = "csv.writer"
      and
      this = ma.getArgument(0)
    )
  }
}

class CsvWriterInjectionConfiguration extends TaintTracking::Configuration {
  CsvWriterInjectionConfiguration() { this = "CSV writer injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskUserInputSource or source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CsvWriterSink }
}

from CsvWriterInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink,
  "Detected user input into a generated CSV file using the built-in `csv` module. " +
  "If user data is used to generate the data in this file, it is possible that an " +
  "attacker could inject a formula when the CSV is imported into a spreadsheet " +
  "application that runs an attacker script, which could steal data from the " +
  "importing user or, at worst, install malware on the user's computer. " +
  "Use `defusedcsv` as a drop-in replacement.", source, sink
================================================================================
