Rule Content:
/**
 * @name Eval Injection Detection
 * @description Detects the use of eval() with non-empty or non-literal arguments.
 * @kind problem
 * @problem.severity warning
 * @security-severity 7.5
 * @id py/eval-detected
 * @tags security
 *       external/cwe/cwe-095
 *       owasp-a03
 */

import python

from Call call
where
  call.getFunc().getName() = "eval" and
  not call.getArg(0).getStringValue() = "" and
  not call.getArg(0).getStringValue() = "..."
select call, "Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. " +
  "If this content can be input from outside the program, this may be a code injection vulnerability. " +
  "Ensure evaluated content is not definable by external sources."
