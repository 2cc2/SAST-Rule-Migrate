/**
 * @name Exec Injection
 * @id exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @severity ERROR
 * @kind path-problem
 */

import python
import DataFlow::PathGraph
import DataFlow

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    // Flask request parameter
    exists(DataFlow::MethodCall call |
      call.getCallee().getQualifiedName() = "flask.request" and
      this.asExpr() = call
    ) or
    // Route variable parameter
    exists(Function f, Parameter p |
      p = f.getParameter(_) and
      f.getFile().getRelativePath().regexpMatch(".*/route/.*") and
      this.asExpr() = p.getAnArg()
    )
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(DataFlow::MethodCall call |
      call.getCallee().getQualifiedName() = "builtins.exec" and
      this.asExpr() = call.getAnArgument()
    )
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecSink
  }

  override predicate propagatesTaint(DataFlow::Node node1, DataFlow::Node node2) {
    // Argument to parameter flow
    exists(MethodCall call, Parameter param |
      node1.asExpr() = call.getAnArgument() and
      node2.asExpr() = param.getAnArg() and
      param = call.getCallee().getAParameter(_)
    ) or
    // Assignment flow
    exists(Assignment assign |
      node1.asExpr() = assign.getRhs() and
      node2.asExpr() = assign.getLhs()
    )
  }
}

from ExecInjectionConfig conf, DataFlow::PathNode source, DataFlow::PathNode sink
where conf.hasFlowPath(source, sink)
select sink, "Detected user data flowing into exec. This is code injection and should be avoided.", source, sink,
  "Potential code injection vulnerability"
