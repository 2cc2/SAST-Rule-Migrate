/**
 * @name Exec Injection
 * @id exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 */

import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Function f, Parameter p |
      p = f.getAParameter() and
      this.asParameter() = p and
      p.getQualifiedName() = "_._._.$ROUTEVAR." + p.getName()
    )
    or
    exists(Call c |
      c.getTarget().hasQualifiedName("flask.request", _) and
      this.asExpr() = c
    )
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(Call c |
      c.getTarget().hasQualifiedName("builtins.exec") and
      this.asExpr() = c
    )
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }
  override predicate isSink(DataFlow::Node sink) { sink instanceof ExecSink }
}

from ExecInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User input flows to exec call, potential code injection"
