Rule Content:
/**
 * @name Exec injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/exec-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.functions.Function
import semmle.python.ApiGraphs

class UserInputSource extends TaintTracking::Source {
  UserInputSource() {
    exists(Function::Parameter p | 
      p = any(Function::Parameter pt | pt.getScopeName() = regexpMatch(".*ROUTEVAR\$"))
    ) and
    this = p.getAnAccess()
    or
    exists(MethodCall mc |
      mc.getCalleeName() = "request" and
      mc.getReceiver().getType().hasQualifiedName("flask", "request") and
      this = mc.getAnArgument()
    )
  }

  override predicate isSourceOf(TaintTracking::TaintKind kind) { kind = TaintTracking::remote() }

  // Required abstract method implementations
  override Node asCfgNode() { result = this }
  override string getLocation() { result = this.getLocation() }
  override BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class ExecSink extends TaintTracking::Sink {
  ExecSink() {
    exists(MethodCall mc |
      mc.getCalleeName() = "exec" and
      mc.getReceiver().getType().hasQualifiedName("builtins") and
      this = mc.getAnArgument()
    )
  }

  override predicate isSinkOf(TaintTracking::TaintKind kind) { kind = TaintTracking::remote() }

  // Required abstract method implementations
  override Node asCfgNode() { result = this }
  override string getLocation() { result = this.getLocation() }
  override BasicBlock getBasicBlock() { result = this.getBasicBlock() }
  override string toString() { result = this.toString() }
  override Scope getScope() { result = this.getScope() }
  override Variable asVariable() { result = this.asVariable() }
}

class ExecInjectionFlowConfiguration extends TaintTracking::Configuration {
  ExecInjectionFlowConfiguration() { this = "ExecInjectionFlowConfiguration" }

  override predicate isSource(TaintTracking::Source source) { source instanceof UserInputSource }
  override predicate isSink(TaintTracking::Sink sink) { sink instanceof ExecSink }

  override predicate isAdditionalTaintStep(TaintTracking::Taintable in, TaintTracking::Taintable out) {
    // Argument to parameter propagation
    TaintTracking::localTaintStep(in.asParameter(), out.asParameter())
    or
    // Assignment flow propagation
    TaintTracking::localTaintStep(in.asAssignment(), out.asAssignment())
  }
}

from ExecInjectionFlowConfiguration cfg, TaintTracking::PathNode source, TaintTracking::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), sink,
  "Detected user data flowing into exec. This is code injection and should be avoided.",
  source.getNode(), "User input comes from here"
