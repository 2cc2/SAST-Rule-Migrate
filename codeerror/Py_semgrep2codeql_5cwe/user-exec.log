/**
 * @name Exec Injection
 * @id exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class UserInputSource extends TaintTracking::TaintSource {
  UserInputSource() {
    exists(Parameter p |
      p.getName() = "ROUTEVAR" and
      result = p
    ) or
    exists(Call c |
      c.getFunc().(Name).getId() = "request" and
      c.getFunc().getScope().(Module).getName() = "flask" and
      result = c
    )
  }

  override predicate isSource(TaintTracking::TaintSource source) { source = this }

  override CfgNode asCfgNode() { result = this }

  override DataFlow::BasicBlock getBasicBlock() { result = this }

  override string toString() { result = this.toString() }
  
  override DataFlow::Scope getScope() { result = this.getScope() }
  
  override Variable asVariable() { result = this }
}

class ExecSink extends TaintTracking::TaintSink {
  ExecSink() {
    exists(Call c |
      c.getFunc().(Name).getId() = "exec" and
      result = c.getAnArg()
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) { sink = this }

  override CfgNode asCfgNode() { result = this }
  
  override Location getLocation() { result = Location::none() }
  
  override DataFlow::BasicBlock getBasicBlock() { result = this }
  
  override string toString() { result = this.toString() }
  
  override DataFlow::Scope getScope() { result = this.getScope() }
  
  override Variable asVariable() { result = this }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    source instanceof UserInputSource
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    sink instanceof ExecSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ExecInjectionConfig conf
where conf.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected user data flowing into exec. This is code injection and should be avoided."
