Rule Content:
/**
 * @name exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id py/exec-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(MethodAccess ma |
      // Flask request sources
      (ma.getMethod().getQualifiedName().matches("flask.request.%") or
       // Route parameters
       ma.getMethod().getQualifiedName().matches("%$ROUTEVAR%")) and
      this.asExpr() = ma
    )
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(Call call |
      call.getFunc().(Name).getId() = "exec" and
      call.getFunc().getQualifiedName().matches("builtins.exec") and
      this.asExpr() = call.getArg(_)
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "exec-injection-config" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof UserInputSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof ExecSink 
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Argument to parameter flow
    exists(MethodAccess ma, Parameter p |
      node1.asExpr() = ma.getAnArg() and
      node2.asExpr() = p.getAnAccess() and
      p = ma.getTarget().(Method).getAParameter()
    )
    or
    // Field assignment flow
    exists(Assignment assign |
      node1.asExpr() = assign.getRhs() and
      node2.asExpr() = assign.getLhs()
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user data flowing into exec. This is code injection and should be avoided."
