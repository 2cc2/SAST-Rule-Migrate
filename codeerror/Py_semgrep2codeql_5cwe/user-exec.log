Rule Content:
import python
import semmle.python.TaintTracking
import semmle.python.dataflow.PathGraph

private class UserInputSource extends TaintTracking::TaintSource {
  UserInputSource() {
    exists(Function f, Parameter p |
      f.getAParameter() = p and
      this = p.asParameter() and
      p.getName().matches("%ROUTEVAR%")
    ) or
    exists(Call c |
      c.getFunc().(Name).getId() = "request" and
      c.getFunc().getQualifiedName().toString() = "flask.request" and
      this = c.asExpr()
    )
  }

  override predicate isSourceOfTaint(TaintTracking::TaintSource source) { this = source }

  override string getLocationType() { "User input source" }

  override Expr asExpr() { result = this }
}

private class ExecSink extends TaintTracking::TaintSink {
  ExecSink() {
    exists(Call c |
      c.getFunc().(Name).getId() = "exec" and
      c.getFunc().getQualifiedName().toString() = "builtins.exec" and
      this = c.asExpr()
    )
  }

  override predicate isSinkOfTaint(TaintTracking::TaintSink sink) { this = sink }

  override string getLocationType() { "Exec call sink" }

  override Expr asExpr() { result = this }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "Exec Injection" }

  override predicate isSource(TaintTracking::TaintSource source) { source instanceof UserInputSource }

  override predicate isSink(TaintTracking::TaintSink sink) { sink instanceof ExecSink }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) { none() }

  override predicate propagatesTaint(TaintTracking::TaintSource source, TaintTracking::TaintSink sink) {
    exists(PathGraph::Node node1, PathGraph::Node node2 |
      node1 = source.asParameter() and
      node2 = sink.asExpr() and
      any(PathGraph::Edge edge).connects(node1, node2))
  }
}

from ExecInjectionConfig config, PathGraph::PathNode source, PathGraph::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected user data flowing into exec. This is code injection and should be avoided."
