/**
 * @name Exec Injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/exec-injection
 */

import python
import DataFlow
import DataFlow::PathGraph
import semmle.python.ApiGraphs.PythonCall

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(FunctionCall call |
      call.getTarget().getName() matches "request" and
      call.getTarget().getLocation().getFile().getBaseName() = "flask" and
      this.asExpr() = call
    )
  }
}

class RouteVarSource extends DataFlow::Node {
  RouteVarSource() {
    getFunction().getName() matches ".*ROUTEVAR\$" and
    this.asParameter()
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(FunctionCall call |
      call.getTarget().getName() = "exec" and
      this.asExpr() = call.getAnArgument()
    )
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteVarSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    TaintTracking::localTaintStep(pred, succ) or
    exists(Assignment assign | assign.getDest() = pred.asExpr() | assign.getSource() = succ.asExpr())
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ExecInjectionConfig conf
where conf.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user data flowing into exec. This is code injection and should be avoided."
