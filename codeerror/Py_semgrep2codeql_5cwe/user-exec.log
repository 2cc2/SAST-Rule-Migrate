/**
 * @kind problem
 * @id exec-injection
 * @security-severity error
 * @problem.severity error
 */
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p |
      p.getName() = "$ROUTEVAR" and
      this.asExpr() = p.getAnArgument()
    )
    or
    exists(MethodCall mc |
      mc.getMethod().getDeclaringType().hasQualifiedName("flask.request", _) and
      this.asExpr() = mc
    )
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(MethodCall mc |
      mc.getMethod().getDeclaringType().hasQualifiedName("builtins", "exec") and
      this.asExpr() = mc
    )
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecSink
  }

  override predicate propagatesTaint(DataFlow::Node pred, DataFlow::Node succ) {
    // Argument to parameter flow
    exists(DataFlow::MethodCall call, Function::Parameter param |
      pred.asExpr() = call.getArgument(_) and
      succ.asExpr() = param.getAnArgument() and
      param = call.getMethod().getAParameter()
    )
    or
    // Assignment flow
    exists(DataFlow::Assignment assign |
      pred.asExpr() = assign.getRhs() and
      succ.asExpr() = assign.getLhs()
    )
  }
}

