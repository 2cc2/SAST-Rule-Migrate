Rule Content:
/**
 * @name exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity ERROR
 * @id python/exec-injection
 */

import python
import python.TaintTracking
import python.dataflow.PathGraph

class UserInputSource extends TaintTracking::Source {
  UserInputSource() {
    // Route parameters
    exists(Function f, Parameter p |
      f.getAParameter() = p and
      p.getContent().toString() = "$ROUTEVAR"
    ) or
    // Flask request data
    exists(Call call |
      call.getTarget().getQualifiedName().matches("flask.request.%")
    )
  }

  override string getSourceType() { result = "User controlled data" }
}

class ExecSink extends TaintTracking::Sink {
  ExecSink() {
    exists(Call call |
      call.getTarget().getQualifiedName() = "builtins.exec"
    )
  }

  override string getSinkType() { result = "exec call" }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "Exec command injection" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof UserInputSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof ExecSink
  }

  override predicate propagatesTaint(TaintTracking::Taint a, TaintTracking::Taint b) {
    TaintTracking::localTaintStep(a, b) or
    TaintTracking::fieldWriteTaintStep(a, b)
  }
}

from ExecInjectionConfig cfg, PathGraph pg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlowPath(pg, source, sink)
select sink.getLocation(), "Detected user data flowing into exec. This is code injection and should be avoided.",
  source.getLocation(), "User controlled data"
