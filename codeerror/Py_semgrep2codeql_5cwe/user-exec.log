/**
 * @name exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/exec-injection
 */

import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Python::Parameter p |
      p.getName().regexpMatch(".*ROUTEVAR\\$") and
      this = p.getAnAccess()
    )
  }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(API::Call call |
      call.getAPIName() = "flask.request" and
      this = call
    )
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(API::Call call |
      call.getPythonValueName() = "exec" and
      this = call.getAnArgument()
    )
  }
}

predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
  exists(Field f |
    pred = f.getAnAssignedValue() and
    succ = f.getAnAccess()
  )
  or
  exists(Python::Argument arg, Python::Parameter param |
    pred = arg.getValue() and
    succ = param.getAnAccess()
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  (source.getNode() instanceof UserInputSource or source.getNode() instanceof FlaskRequestSource) and
  sink.getNode() instanceof ExecSink and
  DataFlow::flowPath(source, sink)
select sink, source, sink, "Detected user data flowing into exec. This is code injection and should be avoided."
================================================================================
