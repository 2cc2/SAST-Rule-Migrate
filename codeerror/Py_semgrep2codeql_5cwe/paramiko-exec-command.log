Rule Content:
/**
 * @name Unverified SSL Context in Paramiko SSH Client
 * @description Detects unverified SSL contexts that permit insecure connections without verifying SSL certificates.
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 */

import python
import semmle.python.security.TaintTracking
import DataFlow

predicate isSourceCall(DataFlow::Node node) {
  exists(Call call |
    call.getTarget().getMemberName() = "__init__" and
    call.getTarget().getQualifiedName() = "paramiko.client.SSHClient" and
    node.asExpr() = call
  )
}

predicate isSinkCall(DataFlow::Node node) {
  exists(Call call |
    call.getTarget().getMemberName() = "exec_command" and
    call.getTarget().getQualifiedName() = "paramiko.client.SSHClient" and
    not call.getArg(0).getStringValue().matches("\"\\\\.*\"") and
    node.asExpr() = call
  )
}

predicate isSanitizerCall(DataFlow::Node node) {
  exists(Call call |
    call.getTarget().getMemberName() = "exec_command" and
    call.getTarget().getQualifiedName() = "paramiko.client.SSHClient" and
    call.getArg(0).getStringValue().matches("\"\\\\.*\"") and
    node.asExpr() = call
  )
}

class ParamikoUnverifiedSSLConfig extends TaintTracking::Configuration {
  ParamikoUnverifiedSSLConfig() { this = "ParamikoUnverifiedSSLConfig" }

  override predicate isSource(DataFlow::Node source) { isSourceCall(source) }

  override predicate isSink(DataFlow::Node sink) { isSinkCall(sink) }

  override predicate isSanitizer(DataFlow::Node node) { isSanitizerCall(node) }
}

from ParamikoUnverifiedSSLConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Unverified SSL context detected. This will permit insecure connections "
    "without verifying SSL certificates. Use 'ssl.create_default_context()' instead."
