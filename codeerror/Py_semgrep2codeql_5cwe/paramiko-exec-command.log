import python
import semmle.python.dataflow.new.DataFlow

class SSHClientCreation extends DataFlow::Node {
  SSHClientCreation() {
    exists(Call call |
      call.getTarget().hasQualifiedName("paramiko.client", "SSHClient", "__init__") and
      this.asNode() = call
    )
  }
}

class ExecCommandCall extends DataFlow::Node {
  int argumentIndex;

  ExecCommandCall() {
    exists(Call call |
      call.getTarget().hasQualifiedName("paramiko.client", "SSHClient", "exec_command") and
      this.asNode() = call
    )
  }

  predicate isUntrusted(DataFlow::Node command) {
    call.getArgument(0) = command and
    not command.asExpr().(StringLiteral).getValue() = "\"\"\""
  }

  predicate isTrusted(DataFlow::Node command) {
    call.getArgument(0) = command and
    command.asExpr().(StringLiteral).getValue() = "\"\"\""
  }
}

class ParamikoTaintTracking extends TaintTracking::Configuration {
  ParamikoTaintTracking() { this = "ParamikoTaintTracking" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SSHClientCreation
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ExecCommandCall call |
      call.isUntrusted(sink) and
      sink.asNode() = call
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(ExecCommandCall call |
      call.isTrusted(sanitizer) and
      sanitizer.asNode() = call
    )
  }
}

from ParamikoTaintTracking cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Unverified command execution detected. This may permit arbitrary command execution. Use quoted commands."
