import python
import semmle.python.security.PyTaintTracking
import python.Expr

class SSHClientInitCall extends Expr::Call {
  SSHClientInitCall() {
    getFunc().(Expr::Name).getId() = "SSHClient" and
    getFunc().(Expr::Attribute).getObject().(Expr::Name).getId() = "paramiko" and
    getFunc().(Expr::Attribute).getAttr() = "__init__"
  }
}

class ExecCommandCall extends Expr::Call {
  ExecCommandCall() {
    getFunc().(Expr::Name).getId() = "exec_command" and
    getFunc().(Expr::Attribute).getObject().(Expr::Name).getId() = "SSHClient" and
    not getArgument(0).getStringValue().regexpMatch("\\.\\.\\.")
  }
}

class SafeExecCommandCall extends Expr::Call {
  SafeExecCommandCall() {
    getFunc().(Expr::Name).getId() = "exec_command" and
    getFunc().(Expr::Attribute).getObject().(Expr::Name).getId() = "SSHClient" and
    getArgument(0).getStringValue().regexpMatch("\\.\\.\\.")
  }
}

class ParamikoTaintConfig extends TaintTracking::Configuration {
  ParamikoTaintConfig() { this = "ParamikoTaintConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    exists(SSHClientInitCall call |
      source.asExpr() = call
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(ExecCommandCall call |
      sink.asExpr() = call
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(SafeExecCommandCall call |
      sanitizer.asExpr() = call
    )
  }

  override predicate isAdditionalTaintStep(TaintTracking::TaintFlow step) {
    exists(Expr store, Expr arg |
      step.getFromNode().asExpr() = store and
      step.getToNode().asExpr() = arg and
      store = arg
    )
  }
}

from ParamikoTaintConfig cfg, TaintTracking::TaintPathNode source, TaintTracking::TaintPathNode sink
where cfg.hasFlow(source, sink)
select sink, "Unverified SSH command execution detected. This may lead to command injection. " +
  "Use quoted arguments for exec_command()."
