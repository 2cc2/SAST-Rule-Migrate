import python
import semmle.python.dataflow.TaintTracking
import DataFlow

class ParamikoSSHClientInit extends DataFlow::Node {
  ParamikoSSHClientInit() {
    exists(Call call |
      call.getCallee().getPackage() = "paramiko.client" and
      call.getCallee().getType() = "SSHClient" and
      call.getCallee().getName() = "__init__" and
      this.asExpr() = call
    )
  }
}

class ParamikoExecCommand extends DataFlow::Node {
  ParamikoExecCommand() {
    exists(Call call |
      call.getCallee().getPackage() = "paramiko.client" and
      call.getCallee().getType() = "SSHClient" and
      call.getCallee().getName() = "exec_command" and
      call.getArg(0).toString() != "\"..."\" and
      this.asExpr() = call
    )
  }
}

class SafeParamikoExecCommand extends DataFlow::Node {
  SafeParamikoExecCommand() {
    exists(Call call |
      call.getCallee().getPackage() = "paramiko.client" and
      call.getCallee().getType() = "SSHClient" and
      call.getCallee().getName() = "exec_command" and
      call.getArg(0).toString() = "\"...\"" and
      this.asExpr() = call
    )
  }
}

class ParamikoExecCommandConfig extends TaintTracking::Configuration {
  ParamikoExecCommandConfig() { this = "ParamikoExecCommandConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ParamikoSSHClientInit
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ParamikoExecCommand
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeParamikoExecCommand
  }
}

from ParamikoExecCommandConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Unverified SSL context detected. This will permit insecure connections without validating SSL certificates. " +
  "Use 'ssl.create_default_context()' instead."
