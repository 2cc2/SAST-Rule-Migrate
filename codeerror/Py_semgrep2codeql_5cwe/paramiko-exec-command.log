Rule Content:
/**
 * @name Paramiko unsafe SSH command
 * @description Detects unverified SSL context usage in Paramiko SSH client
 * @kind problem
 * @problem.severity error
 * @id py/paramiko-exec-command
 * @tags security
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class SSHClientInitCall extends DataFlow::Node {
  SSHClientInitCall() {
    exists(Call call |
      call.getTarget() instanceof FuncDef and
      call.getTarget().getName() = "__init__" and
      call.getTarget().getModule().getName() = "paramiko.client" and
      call.getTarget().getDeclaringType().getName() = "SSHClient" and
      this.asParameter() = call.getArg(0)
    )
  }
}

class ExecCommandCall extends DataFlow::Node {
  ExecCommandCall() {
    exists(Call call |
      call.getTarget() instanceof FuncDef and
      call.getTarget().getName() = "exec_command" and
      call.getTarget().getModule().getName() = "paramiko.client" and
      call.getTarget().getDeclaringType().getName() = "SSHClient" and
      this.asParameter() = call.getArg(0)
    )
  }
}

class SafeExecCommandCall extends DataFlow::Node {
  SafeExecCommandCall() {
    exists(Call call |
      call.getTarget() instanceof FuncDef and
      call.getTarget().getName() = "exec_command" and
      call.getTarget().getModule().getName() = "paramiko.client" and
      call.getTarget().getDeclaringType().getName() = "SSHClient" and
      call.getArg(0).getStringValue() = "..." and
      this.asParameter() = call.getArg(0)
    )
  }
}

class ParamikoConfig extends TaintTracking::Configuration {
  ParamikoConfig() { this = "Paramiko SSH Command Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SSHClientInitCall
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecCommandCall and
    not sink.getStringValue() = "..."
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeExecCommandCall
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where any(ParamikoConfig cfg).hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Unverified SSH command detected. Use quoted commands for safety."
