/**
 * @name Paramiko unsafe command execution
 * @description Unverified SSL context detected. This will permit insecure connections
 *              without verifying SSL certificates. Use 'ssl.create_default_context()' instead.
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class SSHClientInitCall extends DataFlow::Node::Range {
  SSHClientInitCall() {
    exists(Method m, Call call |
      m.getDeclaringType().getName() = "SSHClient" and
      m.getName() = "__init__" and
      call.getCallee() = m and
      this.asExpr() = call
    )
  }
}

class ExecCommandCall extends DataFlow::Node::Range {
  ExecCommandCall() {
    exists(Method m, Call call |
      m.getDeclaringType().getName() = "SSHClient" and
      m.getName() = "exec_command" and
      call.getCallee() = m and
      this.asExpr() = call and
      not call.getArg(0).getStringValue() = "\"...\""
    )
  }
}

class SafeExecCommandCall extends DataFlow::Node::Range {
  SafeExecCommandCall() {
    exists(Method m, Call call |
      m.getDeclaringType().getName() = "SSHClient" and
      m.getName() = "exec_command" and
      call.getCallee() = m and
      this.asExpr() = call and
      call.getArg(0).getStringValue() = "\"...\""
    )
  }
}

class ParamikoCommandConfiguration extends TaintTracking::Configuration {
  ParamikoCommandConfiguration() { this = "ParamikoCommandConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SSHClientInitCall
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecCommandCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeExecCommandCall
  }
}

from ParamikoCommandConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Unsafe SSH command execution detected. The command string is not properly quoted.", 
  source, "This SSH client connection may lead to command injection."
