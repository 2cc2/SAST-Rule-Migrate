/**
 * @name Unverified SSH command execution in Paramiko
 * @kind problem
 * @id python/paramiko-exec-command
 * @severity error
 */
import python
import semmle.python.Concepts
import semmle.python.dataflow.new.DataFlow
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class ParamikoSSHClientInit extends DataFlow::Node {
  ParamikoSSHClientInit() {
    exists(CallExpr call |
      call.getTarget().getQualifiedName() = "paramiko.client.SSHClient.__init__" and
      this.asExpr() = call
    )
  }

  override predicate exists() { this = any(ParamikoSSHClientInit p | p = this) }
  override string toString() { result = "Paramiko SSHClient init call" }
  override predicate asVariable(Variable v) { exists(v) }
}

class ParamikoExecCommand extends DataFlow::Node {
  ParamikoExecCommand() {
    exists(CallExpr call |
      call.getTarget().getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
      this.asExpr() = call and
      call.getArg(0).getStringValue() != "..."
    )
  }

  override predicate exists() { this = any(ParamikoExecCommand p | p = this) }
  override string toString() { result = "Paramiko exec_command call" }
  override predicate asVariable(Variable v) { exists(v) }
}

class SafeParamikoExecCommand extends DataFlow::Node {
  SafeParamikoExecCommand() {
    exists(CallExpr call |
      call.getTarget().getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
      this.asExpr() = call and
      call.getArg(0).getStringValue() = "..."
    )
  }

  override predicate exists() { this = any(SafeParamikoExecCommand p | p = this) }
  override string toString() { result = "Safe Paramiko exec_command call" }
  override predicate asVariable(Variable v) { exists(v) }   
}

class ParamikoTaintConfig extends TaintTracking::Configuration {
  ParamikoTaintConfig() { this = "ParamikoTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof ParamikoSSHClientInit }

  override predicate isSink(DataFlow::Node sink) { sink instanceof ParamikoExecCommand }

  override predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof SafeParamikoExecCommand }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ParamikoTaintConfig config
where config.hasFlowPath(source, sink)
select sink, 
  "Unverified SSH command execution detected. This may permit command injection. " +
  "Ensure commands are properly quoted and validated."
