import python
import semmle.python.HttpSecurity
import semmle.python.Security
import semmle.python.dataflow.TaintTracking

class ParamikoUnverifiedSSLConfig extends TaintTracking::Configuration {
  ParamikoUnverifiedSSLConfig() { this = "ParamikoUnverifiedSSLConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    exists(Call call |
      call.getCallee().(Method).getDeclaringType().hasQualifiedName("paramiko.client", "SSHClient") and
      call.getCallee().(Method).getName() = "__init__" and
      source.asExpr() = call
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(Call call, string cmd |
      call.getCallee().(Method).getDeclaringType().hasQualifiedName("paramiko.client", "SSHClient") and
      call.getCallee().(Method).getName() = "exec_command" and
      cmd = call.getArgument(0).getStringValue() and
      cmd != "\"...\"" and
      sink.asExpr() = call
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(Call call, string cmd |
      call.getCallee().(Method).getDeclaringType().hasQualifiedName("paramiko.client", "SSHClient") and
      call.getCallee().(Method).getName() = "exec_command" and
      cmd = call.getArgument(0).getStringValue() and
      cmd = "\"...\"" and
      sanitizer.asExpr() = call
    )
  }
}

from ParamikoUnverifiedSSLConfig cfg, TaintTracking::TaintSource src, TaintTracking::TaintSink sink
where cfg.hasFlow(src, sink)
select sink, "Unverified SSL context detected. This will permit insecure connections without verifying SSL certificates. Use 'ssl.create_default_context()' instead."
