Rule Content:
/**
 * @name Paramiko unsafe exec_command with unquoted input
 * @description Detects unsafe usage of paramiko.SSHClient.exec_command() with unquoted input,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id py/paramiko-exec-command
 */

import python
import semmle.python.security.Paramiko
import DataFlow::PathGraph

class ParamikoExecCommandConfiguration extends TaintTracking::Configuration {
  ParamikoExecCommandConfiguration() { this = "ParamikoExecCommandConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      call.getTarget().getPackage() = "paramiko.client" and
      call.getTarget().getType() = "SSHClient" and
      call.getTarget().getName() = "__init__" and
      source.asExpr() = call
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getTarget().getPackage() = "paramiko.client" and
      call.getTarget().getType() = "SSHClient" and
      call.getTarget().getName() = "exec_command" and
      not call.getArg(0).getValue().toString() = "\"...\"" and
      sink.asExpr() = call.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getTarget().getPackage() = "paramiko.client" and
      call.getTarget().getType() = "SSHClient" and
      call.getTarget().getName() = "exec_command" and
      call.getArg(0).getValue().toString() = "\"..."\" and
      sanitizer.asExpr() = call.getArg(0)
    )
  }
}

from ParamikoExecCommandConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Unsafe exec_command detected. Command input should be properly quoted."
