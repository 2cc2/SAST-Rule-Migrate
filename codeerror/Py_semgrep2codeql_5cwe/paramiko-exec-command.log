Rule Content:
/**
 * @name Unverified paramiko exec_command usage
 * @description Detects insecure exec_command usage in paramiko without proper command quoting
 * @kind path-problem
 * @problem.severity error
 * @id py/paramiko-exec-command
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class SSHClientCreation extends Call {
  SSHClientCreation() {
    this.getCallee().getQualifiedName() = "paramiko.client.SSHClient.__init__"
  }
}

class ExecCommandCall extends Call {
  int argumentIndex;

  ExecCommandCall() {
    this.getCallee().getQualifiedName() = "paramiko.client.SSHClient.exec_command" and
    this.getArg(0).getParent*() = this and
    argumentIndex = 0
  }
}

predicate isUntrusted(DataFlow::Node node) {
  exists(ExecCommandCall call |
    node.asExpr() = call.getArg(0).asExpr() and
    // Check if command is not quoted
    not call.getArg(0).asExpr().(StringLiteral).getStringValue().matches("\"*\"")
  )
}

predicate isTrusted(DataFlow::Node node) {
  exists(ExecCommandCall call |
    node.asExpr() = call.getArg(0).asExpr() and
    // Check if command is properly quoted
    call.getArg(0).asExpr().(StringLiteral).getStringValue().matches("\"*\"")
  )
}

class Config extends TaintTracking::Configuration {
  Config() { this = "ParamikoExecCommandConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(SSHClientCreation creation | source.asExpr() = creation.asExpr())
  }

  override predicate isSink(DataFlow::Node sink) {
    isUntrusted(sink)
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    isTrusted(sanitizer)
  }
}

from DataFlow::Node source, DataFlow::Node sink, Config config
where config.hasFlow(source, sink)
select sink, "Unverified command execution detected. Command should be properly quoted to prevent injection."
