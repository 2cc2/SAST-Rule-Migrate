/**
 * @name Formatted SQL Query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind problem
 * @id python/formatted-sql-query
 * @severity warning
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.Web

class FormattedSQLConfig extends TaintTracking::Configuration {
  FormattedSQLConfig() { this = "FormattedSQLConfig" }

  override predicate isSource(TaintTracking::TaintSource source) {
    exists(CallExpr call |
      call.getMethodName().matches("%execute%") or
      call.getMethodName().matches("%executeQuery%") and
      source.asExpr() = call.getArg(0).getExpr() and
      (
        call.getArg(0).getExpr().toString().regexpMatch(".*%{1,}.*") or
        call.getArg(0).getExpr().toString().regexpMatch(".*\\.format\\(.*\\)") or
        call.getArg(0).getExpr().toString().regexpMatch(".*\\$\\{.*\\}.*")
      )
    )
  }

  override predicate isSink(TaintTracking::TaintSink sink) {
    exists(CallExpr call |
      call.getMethodName() = "execute" and
      sink.asExpr() = call.getArg(0).getExpr()
    )
  }

  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    exists(CallExpr call |
      call.getMethodName() = "prepareStatement" and
      sanitizer.asExpr() = call.getArg(0).getExpr()
    )
  }
}

