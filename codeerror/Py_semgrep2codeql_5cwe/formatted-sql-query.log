/**
 * @name Formatted SQL query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind problem
 * @id python/formatted-sql-query
 * @security-severity 7.5
 * @precision high
 */

import python
import DataFlow::PathGraph
import python.Strings::TemplateString

class FormattedSqlSource extends DataFlow::Node {
  FormattedSqlSource() {
    exists(MethodAccess ma, Call call |
      ma.getMethod().getName() matches "execute|executeQuery" and
      call = ma.getReceiver().getACall() and
      (ma.getArgument(0).(TemplateString).getContent().regexMatches("(.*%{1,}.*)|(.*\\.format\\(.*\\))|(.*\\$\\{.*\\}.*)") or
       ma.getArgument(0).toString().regexMatches("(.*%{1,}.*)|(.*\\.format\\(.*\\))|(.*\\$\\{.*\\}.*)"))
    )
  }

  override predicate asCfgNode() { none() }
  override predicate getLocation() { this = resultLocation }
  override predicate getBasicBlock() { none() }
  override predicate toString() { this = "Formatted SQL source" }
  override predicate getScope() { none() }
  override predicate asVariable() { none() }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class ParameterizedQuerySanitizer extends DataFlow::Node {
  ParameterizedQuerySanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      this.asExpr() = ma
    )
  }
}

module FormattedSqlConf implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { source instanceof FormattedSqlSource }
  predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecutionSink }
  predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof ParameterizedQuerySanitizer }
  predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) { node1 = node2 }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where DataFlow::flowPath(source, sink, any(FormattedSqlConf conf))
select sink, source,
  "Detected possible formatted SQL query. Use parameterized queries instead."
