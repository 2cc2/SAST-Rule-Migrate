/**
 * @name Formatted SQL query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind problem
 * @id python/formatted-sql-query
 * @severity warning
 */

import semmle.python.dataflow.new.DataFlow
import semmle.python.Strings

class FormattedSqlSource extends DataFlow::Node {
  FormattedSqlSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["execute", "executeQuery"]) and
      ma.getArgument(0) = this and
      (this.asExpr().toString().matches("%.*%") or
       this.asExpr().toString().matches(".*\\.format\\(.*\\)") or
       this.asExpr().toString().matches(".*\\$\\{.*\\}.*"))
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("execute") and
      ma.getArgument(0) = this
    )
  }
}

class ParameterizedSanitizer extends DataFlow::Node {
  ParameterizedSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("prepareStatement") and
      ma.getArgument(0) = this
    )
  }
}

module FormattedSqlConf implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { source instanceof FormattedSqlSource }
  predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecutionSink }
  predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof ParameterizedSanitizer }
}

