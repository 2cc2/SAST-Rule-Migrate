/**
 * @name Formatted SQL Query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind problem
 * @id python/formatted-sql-query
 * @severity warning
 */

import python
import semmle.python.dataflow.DataFlow
import python.Strings
import semmle.python.Concepts

class FormattedSql extends DataFlow::Configuration {
  FormattedSql() { this = "FormattedSql" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      call.getMethodName() = "execute" or call.getMethodName() = "executeQuery" and
      exists(source.getNode().(Call).getArgument(0).getStringValue() as query |
        query.matches("%(.*%)") or query.matches(".*\\.format\\(.*\\)") or query.matches(".*\\$\\{.*\\}.*")
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asExpr().(Call).getMethodName() = "execute"
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call | call.getMethodName() = "prepareStatement")
  }
}

from FormattedSql conf, DataFlow::PathNode source, DataFlow::PathNode sink
where conf.hasFlowPath(source, sink)
select sink, "Detected possible formatted SQL query. Use parameterized queries instead."
