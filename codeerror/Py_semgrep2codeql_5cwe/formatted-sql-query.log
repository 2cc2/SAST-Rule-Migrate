/**
 * @id formatted-sql-query
 * @severity Warning
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 */

import python
import python.dataflow.DataFlow
import python.dataflow.FieldTracking

predicate isSource(DataFlow::Node source) {
  exists(Call call |
    call.getMethodName() = ["execute", "executeQuery"] and
    exists(call.getArg(0).getStringValue() as query |
      query.regexpMatches("(.*%{1,}.*)|(.*\\.format\\(.*\\))|(.*\\$\\{.*\\}.*)")
    )
  ) and
  source.asExpr() = any(Call call | call.getMethodName() = ["execute", "executeQuery"]).getArg(0)
}

predicate isSink(DataFlow::Node sink) {
  exists(Call call |
    call.getMethodName() = "execute" and
    sink.asExpr() = call.getArg(0)
  )
}

predicate isSanitizer(DataFlow::Node sanitizer) {
  exists(Call call |
    call.getMethodName() = "prepareStatement" and
    sanitizer.asExpr() = call
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  DataFlow::flowPath(source, sink) and
  isSource(source.getNode()) and
  isSink(sink.getNode()) and
  not exists(DataFlow::PathNode sanitizer |
    DataFlow::flowPath(source, sanitizer) and
    isSanitizer(sanitizer.getNode())
  )
select sink.getNode(), "Detected possible formatted SQL query. Use parameterized queries instead."
