Rule Content:
/**
 * @name Formatted SQL Query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind path-problem
 * @id java/formatted-sql-query
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.frameworks.StatementAPI
import semmle.code.java.security.QueryInjection
import semmle.code.java.StringFormat

class FormattedSqlQuery extends TaintTracking::Configuration {
  FormattedSqlQuery() {
    this = "FormattedSqlQuery"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%execute%") and
      ma.getArgument(0).getStringValue().regexpMatch("(.*%{1,}.*)|(.*\\.format\\(.*\\))|(.*\\$\\{.*\\}.*)") and
      source.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      sanitizer.asExpr() = ma
    )
  }
}

from FormattedSqlQuery config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink, "Possible SQL injection from formatted query. Use parameterized queries instead."
