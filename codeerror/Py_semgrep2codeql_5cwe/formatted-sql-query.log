Rule Content:
/**
 * @name Formatted SQL query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind problem
 * @id py/formatted-sql-query
 * @severity warning
 */

import python
import semmle.python.StringFormat
import semmle.python.security.TaintTracking
import semmle.python.web.QueryInjection

class FormattedSqlSource extends DataFlow::Node {
  FormattedSqlSource() {
    exists(string.FormatExpr format |
      this = format.getCompileTimeValue() and
      regexMatches(format.getFormat(), "(.*%{1,}.*)|(.*\\.format\\(.*\\))|(.*\\$\\{.*\\}.*)")
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(FunctionCall call |
      call.getTarget().getName() in ["execute", "executeQuery"] and
      this = call.getArg(0)
    )
  }
}

class ParameterizedQuerySanitizer extends DataFlow::Node {
  ParameterizedQuerySanitizer() {
    exists(FunctionCall call |
      call.getTarget().getName() = "prepareStatement" and
      this = call.getResult()
    )
  }
}

class FormattedSqlConf extends TaintTracking::Configuration {
  FormattedSqlConf() { this = "Formatted SQL Query" }

  override predicate isSource(DataFlow::Node source) { source instanceof FormattedSqlSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecutionSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }
}

from FormattedSqlConf conf, DataFlow::Node source, DataFlow::Node sink
where conf.hasFlow(source, sink)
select sink, "Detected possible formatted SQL query. Use parameterized queries instead."
