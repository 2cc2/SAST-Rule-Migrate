Rule Content:
/**
 * @name Formatted SQL query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind problem
 * @id python/formatted-sql-query
 * @problem.severity warning
 */
import python
import semmle.python.Strings
import DataFlow::PathGraph
import semmle.python.dataflow.new.TaintTracking

class FormattedSqlConfig extends TaintTracking::Configuration {
  FormattedSqlConfig() { this = "FormattedSqlConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      call.getFuncName() = ["execute", "executeQuery"] and
      exists(call.getAnArgument().toString() as str |
        str.regexpMatch("(.*%{1,}.*)|(.*\\.format\\(.*\\))|(.*\\$\\{.*\\}.*)")
      ) and
      source.asExpr() = call.getAnArgument()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getFuncName() = "execute" and
      sink.asExpr() = call.getAnArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getFuncName() = "prepareStatement" and
      sanitizer.asExpr() = call
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, FormattedSqlConfig conf
where conf.hasFlowPath(source, sink)
select sink, source, 
  "Detected possible formatted SQL query. Use parameterized queries instead.",
  source, "Formatted SQL query source",
  sink, "SQL execution sink"
