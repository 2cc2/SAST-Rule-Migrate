Rule Content:
/**
 * @name Formatted SQL query
 * @description Detected possible formatted SQL query. Use parameterized queries instead
 * @kind problem
 * @id formatted-sql-query
 * @security-severity 8.0
 */

import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.FieldTracking

class FormattedSqlQuery extends DataFlow::Configuration {
  FormattedSqlQuery() { this = "FormattedSqlQuery" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      call.getMethodName().matches(["execute", "executeQuery"]) and
      source.asExpr() = call.getArg(0) and
      matches(call.getArg(0).toString(), "(.*%{1,}.*)|(.*\\.format\\(.*\\))|(.*\\$\\{.*\\}.*)")
    )
  }
  
  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getMethodName() = "execute" and
      sink.asExpr() = call.getArg(0)
    )
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getMethodName() = "prepareStatement" and
      sanitizer.asExpr() = call
    )
  }
}

from FormattedSqlQuery query, DataFlow::Node source, DataFlow::Node sink
where query.hasFlow(source, sink)
select source, "Detected possible formatted SQL query. Use parameterized queries instead."
