/**
 * @name Formatted SQL query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind problem
 * @id python/sql-injection-formatted
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.frameworks.django.Django

class FormattedSQLConfig extends TaintTracking::Configuration {
  FormattedSQLConfig() { this = "FormattedSQLConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess call |
      call.getMethodAccess().getName() = ["execute", "executeQuery"] and
      (
        call.getArg(0).toString().regexpMatch(".*%{1,}.*") or
        call.getArg(0).toString().regexpMatch(".*\\.format\\(.*\\)") or
        call.getArg(0).toString().regexpMatch(".*\\$\\{.*\\}.*")
      ) and
      source.asExpr() = call.getArg(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess call |
      call.getMethodAccess().getName() = "execute" and
      sink.asExpr() = call.getValue()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess call |
      call.getMethodAccess().getName() = "prepareStatement" and
      sanitizer.asExpr() = call
    )
  }
}

from FormattedSQLConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Detected possible formatted SQL query. Use parameterized queries instead."
