Rule Content:
/**
 * @name eval-injection
 * @kind problem
 * @problem.severity error
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @id python/eval-injection
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.functions.Function
import semmle.python.Concepts.Parameter

class FlaskRequestSource extends DataFlow::Source::Range {
  FlaskRequestSource() {
    exists(string moduleName, string memberName |
      this.asExpr() = apiCall("flask", "request", memberName).getExpr() or
      this.asExpr() = apiCall("flask.request", memberName, _).getExpr()
    )
  }
}

class RouteParameterSource extends DataFlow::Source::Range {
  RouteParameterSource() {
    exists(Parameter p | regexpMatches(p.getName(), "^ROUTEVAR$") |
      this.asExpr() = p.getAnAccess()
    )
  }
}

class EvalSink extends DataFlow::Sink::Range {
  EvalSink() {
    exists(Call call | call.getFunc().(Name).getId() = "eval" |
      this.asExpr() = call.getArg(0)
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::Source src) {
    src instanceof FlaskRequestSource or
    src instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof EvalSink
  }

  override predicate isSanitizer(DataFlow::Sanitizer sanitizer) {
    none()
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from EvalInjectionConfig cfg, DataFlow::Source src, DataFlow::Sink sink
where cfg.hasFlow(src, sink)
select sink, "Detected user data flowing into eval. This is code injection and should be avoided."
