/**
 * @name eval-injection
 * @kind path-problem
 * @id python/eval-injection
 * @problem.severity error
 * @message Detected user data flowing into eval. This is code injection and should be avoided.
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow

private class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call call |
      call.getTarget().(Attr).getObject().toString() = "flask.request" and
      call.getTarget().(Attr).getAttr() = "get" and
      this.asExpr() = call
    )
    or
    exists(Attribute attr |
      attr.getObject().toString() = "flask.request" and
      this.asExpr() = attr
    )
    or
    exists(Call call |
      call.getTarget().(Attr).getObject().toString() = "flask.request" and
      call.getTarget().(Attr).getAttr() = "__getitem__" and
      this.asExpr() = call
    )
  }
}

private class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function::Parameter p |
      p.getName().regexpMatch("^ROUTEVAR$") and
      this.asParameter() = p
    )
  }
}

private class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(Call call |
      call.getTarget().getName() = "eval" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }
}

from EvalInjectionConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected user data flowing into eval. This is code injection and should be avoided."
