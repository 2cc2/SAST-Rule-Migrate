/**
 * @name Eval Injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided
 * @kind path-problem
 * @id python/eval-injection
 * @severity ERROR
 */

import python
import semmle.python.ApiGraphs
import DataFlow::PathGraph
import DataFlow::TaintTracking

class FlaskRequestSource extends FunctionInput {
  FlaskRequestSource() {
    exists(API::CallNode call |
      (
        call = API::getCall("flask.request", "get") or
        call = API::getCall("flask.request", "__getitem__")
      ) and
      this = call.getResult()
    ) or exists(API::BacktrackNode request |
      request = API::getNode("flask.request") and
      this = request.getAnOrigin()
    )
  }
}

class RouteParameterSource extends FunctionInput {
  RouteParameterSource() {
    exists(FunctionParam p |
      p.getName().regexpMatch("^ROUTEVAR$") and
      this = p.getAnInput()
    )
  }
}

class EvalSink extends FunctionOutput {
  EvalSink() {
    exists(CallExpr ce |
      ce.getFunc().(Name).getId() = "eval" and
      this = ce.getArg(0).getOutput()
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from EvalInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user data flowing into eval. This is code injection and should be avoided."
