/**
 * @name eval-injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/security/eval-injection
 */

import python
import semmle.python.security.dataflow.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Module m | m.getName() = "flask" and this = API::getNodeForPackage(m) |
      exists(API::CallNode cn | cn = this.getACall() and cn.getMethodName() = "get") or
      exists(API::CallNode cn | cn = this.getACall() and cn.getMethodName() = "__getitem__") or
      this = API::getNode(this.getPackage(), _)
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    this instanceof Parameter and
    this.getFile().getBaseName().matches("%ROUTEVAR%")
  }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(Call call |
      call.getFunc().(Name).getId() = "eval" and
      this = call.getArg(0)
    )
  }
}

class EvalConfiguration extends TaintTracking::Configuration {
  EvalConfiguration() { this = "EvalConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }
}

from EvalConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Detected user data flowing into eval. This is code injection and should be avoided.",
  source, "User input source"
