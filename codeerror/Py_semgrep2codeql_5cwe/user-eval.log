/**
 * @name Eval Injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 */
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.functions.FunctionValue
import semmle.python.Concepts.Parameter
import semmle.python.ApiGraphs.Attribute

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call call | 
      call.getFunc().(FunctionValue).getUnderlyingFunctionName() = "get" and
      call.getFunc().(FunctionValue).getModule().name() = "flask.request" |
      this.asExpr() = call.getAnArg(0)
    )
    or
    exists(Call call | 
      call.getFunc().(FunctionValue).getUnderlyingFunctionName() = "__getitem__" and
      call.getFunc().(FunctionValue).getModule().name() = "flask.request" |
      this.asExpr() = call.getAnArg(0)
    )
    or
    exists(Attribute attr | 
      attr.getReceiver().(Name).getId() = "request" and
      attr.getReceiver().(Name).getModule().name() = "flask" |
      this.asExpr() = attr
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter param |
      param.getName() =~ /^ROUTEVAR$/ |
      this.asParameter() = param
    )
  }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(Call call | 
      call.getFunc().(FunctionValue).getUnderlyingFunctionName() = "eval" |
      this.asExpr() = call.getAnArg(0)
    )
  }
}

class EvalInjectionConfiguration extends TaintTracking::Configuration {
  EvalInjectionConfiguration() { this = "EvalInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }

  override predicate isAdditionalFlowStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2) or
    DataFlow::parameterNode(node1, node2)
  }
}

from EvalInjectionConfiguration cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential eval injection from untrusted source $@.", source, source.toString()
