Rule Content:
/**
 * @name Eval injection vulnerability
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind problem
 * @problem.severity error
 * @id py/eval-injection
 */

import python
import python.dataflow.DataFlow
import python.dataflow.TaintTracking
import python.functions.Function
import python.Concepts.Parameter
import python.ApiGraphs.Attribute

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(DataFlow::CallNode call |
      call = any(Function f |
        f.getModule().getDisplayName() = "flask" and
        f.getName() = "request" and
        f.getName() = "get"
      ).getACall() and
      this = call
    ) or
    exists(DataFlow::CallNode call |
      call = any(Function f |
        f.getModule().getDisplayName() = "flask" and
        f.getName() = "request" and
        f.getName() = "__getitem__"
      ).getACall() and
      this = call
    ) or
    exists(DataFlow::AttributeNode attr |
      attr.getBase().getDisplayName() = "flask" and
      attr.getName() = "request" and
      this = attr
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter param |
      param.getName().regexpMatch("^ROUTEVAR$") and
      this = param.asParameterNode()
    )
  }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(DataFlow::CallNode call |
      call = any(Function f | f.getName() = "eval").getACall() and
      this = call.getArgument(0)
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "Eval injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }
}

from DataFlow::Node source, DataFlow::Node sink, TaintConfig config
where config.hasFlow(source, sink)
select sink, "Detected user data flowing into eval. This is code injection and should be avoided."
