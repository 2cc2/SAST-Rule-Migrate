Rule Content:
import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.Web
import DataFlow::PathGraph
import TaintTracking::Configuration

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask.request", "get") and
      this.asExpr() = ma
    ) or
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask.request", "__getitem__") and
      this.asExpr() = ma
    ) or
    exists(Expr e |
      e.(Name).getId().hasQualifiedName("flask", "request") and
      this.asExpr() = e
    ) or
    exists(Parameter p |
      p.getName().matches("^ROUTEVAR$") and
      this.asExpr() = p.getDefault()
    )
  }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(Call c |
      c.getTarget().hasQualifiedName("builtins", "eval") and
      this.asExpr() = c.getArg(0)
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }
}

from EvalInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected user data flowing into eval. This is code injection and should be avoided."
