Rule Content:
/**
 * @name Eval Injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind problem
 * @id python/eval-injection
 * @security-severity ERROR
 * @tags security
 *       external/cwe/cwe-094
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "get" and ma.getQualifier().getType().getName() = "request" and 
       ma.getQualifier().getType().getUnderlyingType().(RefType).getQualifiedName() = "flask.request") or
      (ma.getMethod().getName() = "__getitem__" and ma.getQualifier().getType().getName() = "request" and
       ma.getQualifier().getType().getUnderlyingType().(RefType).getQualifiedName() = "flask.request") or
      exists(Identifier id | 
        id.getType().getName() = "request" and
        id.getType().getUnderlyingType().(RefType).getQualifiedName() = "flask.request" and
        this.asExpr() = id
      )
    ) or
    exists(Function f, Parameter p |
      f.getName().matches("%ROUTEVAR%") and
      p = f.getAParameter() and
      this.asParameter() = p
    )
  }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(CallNode call |
      call.getFunc().(Name).getId() = "eval" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class EvalInjectionConfiguration extends TaintTracking::Configuration {
  EvalInjectionConfiguration() { this = "EvalInjection" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    false
  }
}

from EvalInjectionConfiguration cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected user data flowing into eval. This is code injection and should be avoided."
