import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.TaintTracking

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    apiCall("flask.request", "get", _, result) 
    or
    apiCall("flask.request", "__getitem__", _, result)
    or
    exists(FunctionValue f, string name |
      name = "flask.request" and
      f.getReturn() = result and
      f.getModule().getName() = "flask" and
      f.getName() = "request"
    )
  }
}

class RouteParameterSource extends DataFlow::Source {
  RouteParameterSource() {
    exists(MethodParameter p |
      p.getMethodDeclaration().getAnnotation().toString().regexpMatches("^ROUTEVAR$") and
      p.getAnAccess() = result
    )
  }
}

class EvalSink extends DataFlow::Sink {
  EvalSink() {
    exists(Call call |
      call.getTarget().getName() = "eval" and
      call.getArgument(0) = result
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof EvalSink
  }
}

from DataFlow::Source source, DataFlow::Sink sink
where any(EvalInjectionConfig config).hasFlow(source, sink)
select sink, 
  "Detected user data flowing into eval. This is code injection and should be avoided.",
  source, "User input originates from here"
