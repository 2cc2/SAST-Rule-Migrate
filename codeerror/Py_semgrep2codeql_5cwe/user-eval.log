/**
 * @name Eval injection vulnerability
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id eval-injection
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::ExprNode {
  FlaskRequestSource() {
    // Match flask.request.get()
    exists(Call call |
      call.getFunc().(AttrRead).getObject().toString() = "flask.request" and
      call.getFunc().(AttrRead).getAttr() = "get"
    ) or
    // Match flask.request[...]
    exists(Call call |
      call.getFunc().(AttrRead).getObject().toString() = "flask.request" and
      call.getFunc().(AttrRead).getAttr() = "__getitem__"
    ) or
    // Match direct flask.request access
    exists(Name name | name.getId() = "request" and name.getScope().toString() = "flask")
  }
}

class RouteParamSource extends DataFlow::ParameterNode {
  RouteParamSource() {
    this.getParameter().getType().toString().regexpMatch("^ROUTEVAR$")
  }
}

class EvalSink extends DataFlow::ExprNode {
  EvalSink() {
    exists(Call call |
      call.getFunc().(Name).getId() = "eval" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }
}

from EvalInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected user data flowing into eval. This is code injection and should be avoided."
