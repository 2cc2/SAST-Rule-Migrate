Rule Content:
/**
 * @name Path traversal in file open operation
 * @description Using request data with `open()` without validation could lead to path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id path-traversal-open
 */

import semmle.python.dataflow.new.DataFlow
import semmle.python.web.flask.Flask
import semmle.python.Concepts

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethodName() = ["get", "__getitem__", "__call__"] and
      ma.getReceiver().(NameExpr).getName() = "request" and
      ma.getReceiver().getScope().getQualifiedName() = "flask.request" and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(FunctionDef route |
      route.getDecorator().getName() = "route" and
      route.getScope().getQualifiedName().matches("@APP") and
      this.asParameter() = route.getAParameter()
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(Call call | 
      call.getFunc().(NameExpr).getName() = "open" and
      (this.asExpr() = call.getArg(0) or this.asExpr() = call.getArg(1))
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversal" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
