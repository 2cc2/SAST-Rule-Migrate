import codeql.python.security.TaintTracking
import codeql.python.web.Flask
import codeql.python.dataflow.DataFlow

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(CallExpr call |
      call.getTarget() = API::moduleImport("flask.request").getMethod(["get", "__getitem__", "__call__"]) and
      this = call.getAnArg()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function fn, Expr decorator |
      fn.getDecorator().getExpr() = API::moduleImport("flask").getMember("route").getACall() and
      this = fn.getParameter()
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(CallExpr call |
      call.getTarget().getName() = "open" and
      (this = call.getArg(0) or this = call.getArg(1))
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
