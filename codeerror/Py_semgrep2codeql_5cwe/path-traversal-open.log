Rule Content:
/**
 * @name Path traversal in open call
 * @description Found request data in a call to 'open'. Ensure the request data is validated 
 *              or sanitized, otherwise it could result in path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Flask
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall mc |
      mc.getPackage() = "flask.request" and
      mc.getMethodName().matches("%") and
      mc.getMethodName().regexpMatch("(get|__getitem__|__call__)") and
      this = mc.asExpr()
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(FunctionNode fn |
      fn.getDecoratorName() = "route" and
      this = fn.getAParameter().getAnArgument()
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(MethodCall mc |
      mc.getMethodName() = "open" and
      (this = mc.getArgument(0) or this = mc.getArgument(1))
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink, 
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized."
