Rule Content:
/**
 * @name Path traversal via open()
 * @description Detects path traversal vulnerabilities caused by passing unsanitized request data or route parameters to open() calls.
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import python.web.flask.request.Request
import python.TaintTracking
import python.dataflow.DataFlow
import DataFlow::PathGraph

class RequestSource extends DataFlow::Node {
  RequestSource() {
    exists(Call call |
      call = any().getAttribute("request") |
      call.getMethodName() in ["get", "__getitem__", "__call__"] and
      result.asExpr() = call
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f |
      f.getADecorator().getName() = "route" and
      result.asParameter() = f.getAParameter()
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(CallNode call |
      call.getFunc().(Name).getId() = "open" and
      (result.asExpr() = call.getArg(0) or result.asExpr() = call.getArg(1))
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
