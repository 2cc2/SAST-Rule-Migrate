Rule Content:
import python.security.TaintTracking
import python.web.Flask
import python.dataflow.DataFlow
import DataFlow

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(DataFlow::CallNode call |
      call.getTarget().getQualifiedName() = "flask.request.get" or
      call.getTarget().getQualifiedName() = "flask.request.__getitem__" or
      call.getTarget().getQualifiedName() = "flask.request.__call__"
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(python.web.Flask::RouteParam param | this = param.getNode())
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().getName() = "open" and (
        this = call.getArgument(0) or
        this = call.getArgument(1)
      )
    )
  }
}

class PathTraversalConfiguration extends TaintTracking::Configuration {
  PathTraversalConfiguration() { this = "PathTraversalConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof OpenSink
  }
}

from PathTraversalConfiguration cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
