Rule Content:
/**
 * @name Path Traversal in open() call
 * @description Found request data in a call to 'open'. Ensure the request data is validated or sanitized,
 *              otherwise it could result in path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import semmle.python.web.flask.Request
import semmle.python.web.flask.Route
import DataFlow::PathGraph

class RequestSource extends DataFlow::Node {
  RequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["get", "__getitem__", "__call__"]) and
      ma.getReceiver().getType().hasQualifiedName("flask", "request") |
      this.asExpr() = ma
    )
    or
    exists(FunctionNode route |
      route.hasDecoratorName("route") |
      this.asParameter() = route.getAParameter()
    )
  }
}

class OpenSink extends DataFlow::Node {
  OpenSink() {
    exists(CallNode call |
      call.getMethodName() = "open" |
      this.asExpr() = call.getArgument(0).getExpr() or this.asExpr() = call.getArgument(1).getExpr()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  DataFlow::flowPath(source, sink) and
  exists(RequestSource req | source.getNode() = req) and
  exists(OpenSink op | sink.getNode() = op)
select sink.getNode(), source, sink, "Potential path traversal vulnerability from request data to file open"
