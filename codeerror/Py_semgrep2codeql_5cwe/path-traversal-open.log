Rule Content:
/**
 * @name Path Traversal via open()
 * @description Detects potential path traversal vulnerabilities when request data is used in file open operations
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getTarget().hasQualifiedName("flask.request", ("get", "__getitem__", "__call__")) and
      this.asExpr() = call.getAnArg()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f |
      exists(FunctionDefn decorator |
        decorator.getName() = "route" and
        decorator.getAPackage() = "flask" and
        f.getADecorator().getExpr() = decorator.getAReference()
      ) and
      this.asParameter() = f.getAParameter()
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(MethodCall call |
      call.getTarget().hasName("open") and
      (this.asExpr() = call.getArg(0) or this.asExpr() = call.getArg(1))
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
