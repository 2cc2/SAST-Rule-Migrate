/**
 * @name Path traversal in file open
 * @description Detects unsanitized request data used in file open operations
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */
import python
import semmle.python.dataflow.DataFlow
import semmle.python.security.TaintTracking
import python.web.flask.request

class RequestSource extends DataFlow::FunctionInput {
  RequestSource() {
    exists(DataFlow::CallNode call, string methodName |
      call.getFunc().(python.web.flask.request.MethodAccess).getName() = methodName and
      methodName in ["get", "__getitem__", "__call__"]
    )
    and
    this.isParameter(0) and
    result = this
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(python.web.flask.request.RouteDefinition route |
      this = route.getADecoratorArgument() and
      this.getLocation().getFile().getBaseName().matches("%APP%")
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(DataFlow::CallNode call |
      call.getFunc().getName() = "open" and
      (this = call.getArgument(0) or this = call.getArgument(1))
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() {
    this = "Path traversal in file open"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks.", 
  source, "Untrusted data flows from here"
