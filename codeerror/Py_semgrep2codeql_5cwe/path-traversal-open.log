      ma.getMethod().hasName(["get", "__getitem__", "__call__"]) and
      ma.getQualifier().getType() = flask.request.Type and
      this.asExpr() = ma
    )
  }

  override ControlFlow::CfgNode asCfgNode() { result = this.asExpr().getBasicBlock() }
  override Location getLocation() { result = expertLocation(this.asExpr()) }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override Variable getVariable() { result = this.asExpr().(Variable).getAnAccess() }
  override DataFlow::ScopeNode getScope() { result = this.asExpr().getScope() }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Function f, Parameter p |
      f.getADecorator().getExpr().getAReference().getType().getName() = "route" and
      p.getFunction() = f and
      this.asExpr() = p
    )
  }

  override ControlFlow::CfgNode asCfgNode() { result = this.asExpr().getBasicBlock() }
  override Location getLocation() { result = expertLocation(this.asExpr()) }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override Variable getVariable() { result = this.asExpr().(Variable).getAnAccess() }
  override DataFlow::ScopeNode getScope() { result = this.asExpr().getScope() }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(DataFlow::CallNode call |
      call.getTarget().hasName("open") and
      (
        this.asExpr() = call.getArgument(0) or
        this.asExpr() = call.getArgument(1)
      )
    )
  }

  override ControlFlow::CfgNode asCfgNode() { result = this.asExpr().getBasicBlock() }
  override Location getLocation() { result = expertLocation(this.asExpr()) }
  override ControlFlow::BasicBlock getBasicBlock() { result = this.asExpr().getBasicBlock() }
  override string toString() { result = this.asExpr().toString() }
  override Variable getVariable() { result = this.asExpr().(Variable).getAnAccess() }
  override DataFlow::ScopeNode getScope() { result = this.asExpr().getScope() }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof FileOpenSink
  }
}

