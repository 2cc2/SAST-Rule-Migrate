Rule Content:
/**
 * @name Path Traversal in File Open
 * @description Detects path traversal vulnerabilities when unsanitized request data
 *              flows into file open operations.
 * @kind path-problem
 * @problem.severity error
 * @id python/path-traversal-open
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph
import python.web.Flask
import DataFlow

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall mc |
      mc =
        any(MethodCall call |
          call.getMethodName().regexpMatch("get|__getitem__|__call__")
        ).getMethodObject() and
      mc.getMethodObject().getDefiningImport().isImport("flask.request")
    ) and
    this.asExpr() = mc
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(DataFlow::SourceNode src |
      src instanceof Flask::RequestParam and
      this = src
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(MethodCall mc |
      mc.getMethodName() = "open" and
      (
        this = mc.getArgument(0) or
        this = mc.getArgument(1)
      )
    )
  }
}

config = new TaintTracking::Configuration {
  source = new FlaskRequestSource() or new RouteParameterSource(),
  sink = new FileOpenSink(),
  flowPath = DataFlow::PathGraph::alwaysFlow()
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(),
  "Found request data in a call to 'open'. Ensure the request data is validated or $sanitized, otherwise it could result in path traversal attacks.",
  source.getNode(), "user request originates here"
