Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to
 *              SQL injection if variables in the SQL statement are not properly 
 *              sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/javax.jdo
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class JDOQueryConfig extends TaintTracking::Configuration {
  JDOQueryConfig() { this = "JDO SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    // String.format() calls
    exists(MethodAccess ma | ma.getMethod().getName() = "format" and 
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") |
      source.asExpr() = ma
    )
    or
    // String.concat() calls
    exists(MethodAccess ma | ma.getMethod().getName() = "concat" and 
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") |
      source.asExpr() = ma
    )
    or
    // String concatenation operations
    exists(AddExpr add | add.getOperand1().getType() instanceof StringType |
      source.asExpr() = add
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // javax.jdo.Query methods
    exists(MethodAccess ma | 
      (ma.getMethod().getName() = "setFilter" or ma.getMethod().getName() = "setGrouping") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "Query") |
      sink.asExpr() = ma.getArgument(0)
    )
    or
    // javax.jdo.PersistenceManager.newQuery
    exists(MethodAccess ma | 
      ma.getMethod().getName() = "newQuery" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager") |
      sink.asExpr() = ma.getArgument(1)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // No sanitizers in this case
    none()
  }
}

from JDOQueryConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches JDO SQL execution without sanitization", 
  source.getNode(), sink.getNode(), 
  "Potential SQL injection vulnerability"
