Rule Content:
/**
 * @name JDO SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to
 *              SQL injection if variables in the SQL statement are not properly 
 *              sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/javax.jdo
 */

import java
import DataFlow::PathGraph
import semmle.code.java.dataflow.TaintTracking

class JDOQueryConfig extends TaintTracking::Configuration {
  JDOQueryConfig() { this = "JDO SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    // String.format() calls
    exists(Method m |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") |
      source.asExpr() = m.getACall()
    )
    or
    // String.concat() calls
    exists(Method m |
      m.hasName("concat") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") |
      source.asExpr() = m.getACall()
    )
    or
    // String concatenation operations
    exists(BinaryExpr expr | 
      expr.getOp() instanceof Add and
      expr.getLeftOperand().getType() instanceof Type and
      expr.getLeftOperand().getType().hasName("String") |
      source.asExpr() = expr
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // javax.jdo.Query methods
    exists(Method m |
      (m.hasName("setFilter") or m.hasName("setGrouping")) and
      m.getDeclaringType().hasQualifiedName("javax.jdo", "Query") |
      sink.asExpr() = m.getACall().getArgument(0)
    )
    or
    // javax.jdo.PersistenceManager.newQuery
    exists(Method m |
      m.hasName("newQuery") and
      m.getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager") |
      sink.asExpr() = m.getACall().getArgument(1)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Block literal string concatenation
    exists(BinaryExpr expr |
      expr.getOp() instanceof Add and
      expr.getRightOperand().getType() instanceof Type and
      expr.getRightOperand().getType().hasName("String") and
      expr.getRightOperand().toString().matches("\"[^\"]*\"") |
      sanitizer.asExpr() = expr
    )
  }
}

from JDOQueryConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input reaches JDO SQL execution without sanitization",
  source.getNode(), sink.getNode(),
  "Potential SQL injection vulnerability"
