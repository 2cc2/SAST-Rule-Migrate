/**
 * @name JDO SQL Injection
 * @description Detects formatted strings in SQL statements that could lead to 
 *              SQL injection if variables are not properly sanitized. 
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdo-sqli
 * @tags security
 *       external/javax.jdo
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class JdoSqlInjectionConfig extends TaintTracking::Configuration {
  JdoSqlInjectionConfig() { this = "JDO SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    // String.format() calls
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") |
      source.asExpr() = ma
    )
    or
    // String.concat() calls
    exists(MethodAccess ma |
      ma.getMethod().hasName("concat") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") |
      source.asExpr() = ma
    )
    or
    // String concatenation operations
    exists(BinaryExpr expr |
      expr.getOp() = "+" and
      expr.getLeftOperand().getType().hasName("String") |
      source.asExpr() = expr
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    // javax.jdo.Query methods
    exists(MethodAccess ma |
      (ma.getMethod().hasName("setFilter") or ma.getMethod().hasName("setGrouping")) and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "Query") |
      sink.asExpr() = ma.getArgument(0)
    )
    or
    // javax.jdo.PersistenceManager.newQuery
    exists(MethodAccess ma |
      ma.getMethod().hasName("newQuery") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.jdo", "PersistenceManager") |
      sink.asExpr() = ma.getArgument(1)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // Block literal string concatenation
    exists(BinaryExpr expr |
      expr.getOp() = "+" and
      expr.getRightOperand() instanceof StringLiteral |
      sanitizer.asExpr() = expr
    )
  }
}

