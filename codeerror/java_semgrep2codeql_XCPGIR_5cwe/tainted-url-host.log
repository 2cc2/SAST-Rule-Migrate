            - { left: name, op: eq, right: concat }
            - { left: name, op: eq, right: append }
            - { left: name, op: eq, right: operator_+= }
            - { left: name, op: eq, right: format }
propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
  - id: STRING_CONCAT
    edge: arg->receiver
    kind: taint
flows:
  - source: USER_INPUT
    sink: URL_CONSTRUCTION
    through: [ARG_TO_PARAM*]
  - source: USER_INPUT
    sink: URL_STRING_CONCAT
    through: [ARG_TO_PARAM*, STRING_CONCAT*]
report:
  message: User data flows into the host portion of this manually-constructed URL.
  locations: ["source","sink","path"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "new URL(request.getParameter(\"host\"));"
    - "\"http://%v\".concat(userInput);"
  negative:
    - "new URL(\"https://example.com\");"
    - "String.format(\"https://%s\", \"example.com\");"
