/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 *              This could allow SSRF attacks. Do not allow arbitrary hosts.
 * @kind taint
 * @problem.severity error
 * @precision high
 * @id java/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController
import semmle.code.java.dataflow.FlowSources

class UserInputSource extends RemoteUserInput {
  UserInputSource() {
    this instanceof HttpServletRequestGetParameter
    and
    not this.getCall().getArgument(0).getType().isPrimitive()
    and
    exists(Annotation a |
      a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestBody") or
      a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable") or
      a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestParam") or
      a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestHeader") or
      a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "CookieValue") or
      a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "ModelAttribute")
    )
  }
}

class URLConstructionSink extends DataFlow::Node {
  URLConstructionSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.net", "URL") and
      this.asExpr() = cc.getArgument(0)
    )
  }
}

class URLStringConcatSink extends DataFlow::Node {
  URLStringConcatSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "concat" or
       ma.getMethod().getName() = "append" or
       ma.getMethod().hasName("format")) and
      ma.getArgument(0).getType().hasName(["String", "CharSequence"]) and
      exists(DataFlow::ExprNode en | en.asExpr().toString().matches("http(s?)://%(v|s|q).*"))|
      this.asExpr() = ma.getQualifier()
    )
    or
    exists(AssignmentOperation ao |
      ao.getOperator().toString() = "+=" and
      exists(DataFlow::ExprNode en | en.asExpr().toString().matches("http(s?)://%(v|s|q).*"))|
      this.asExpr() = ao.getLeftOperand()
    )
  }
}

class TaintedURLHostConfig extends TaintTracking::Configuration {
  TaintedURLHostConfig() { this = "TaintedURLHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof URLConstructionSink or sink instanceof URLStringConcatSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2) or
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "concat" or
       ma.getMethod().getName() = "append" or
       ma.getMethod().hasName("format") or
       isAssignmentAdd(ma)) and
      (node1.asExpr() = ma.getAnArgument() and node2.asExpr() = ma.getQualifier() or
       node1.asExpr() = ma.getQualifier() and node2.asExpr() = ma)
    )
  }
}

