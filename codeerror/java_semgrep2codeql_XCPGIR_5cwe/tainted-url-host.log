/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 *              This could allow SSRF attacks. Do not allow arbitrary hosts.
 * @kind problem
 * @problem.severity error
 * @precision high
 * @id java/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Method m | 
      m.hasQualifiedName("javax.servlet", "ServletRequest", "getParameter") |
      exists(DataFlow::MethodAccessNode ma |
        ma.getMethod() = m and
        this.asExpr() = ma and
        exists(Annotation a |
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestBody") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestParam") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestHeader") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "CookieValue") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "ModelAttribute")
        ) and
        not ma.getArgument(0).getType().isPrimitive()
      )
    )
  }
}

class URLConstructionSink extends DataFlow::Node {
  URLConstructionSink() {
    exists(Constructor c |
      c.hasQualifiedName("java.net", "URL", "<init>") |
      exists(DataFlow::ConstructorCallNode cc |
        cc.getConstructor() = c and
        this.asExpr() = cc.getArgument(0)
      )
    )
  }
}

class URLStringConcatSink extends DataFlow::Node {
  URLStringConcatSink() {
    exists(MethodCall mc |
      (mc.getMethod().getName() = "concat" or
       mc.getMethod().getName() = "append" or
       mc.getMethod().hasName("format")) and
      mc.getQualifier().toString().matches("http(s?)://.*")
    )
    or
    exists(BinaryExpr be |
      be.getOp().toString() = "+" and
      be.getLeftOperand().toString().matches("http(s?)://.*")
    )
  }
}

class TaintedURLConfig extends TaintTracking::Configuration {
  TaintedURLConfig() { this = "TaintedURLConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof URLConstructionSink or sink instanceof URLStringConcatSink
  }
}

from DataFlow::Node source, DataFlow::Node sink, TaintedURLConfig config
where config.hasFlow(source, sink)
select sink, "User data flows into the host portion of this manually-constructed URL: $@", 
  source, sink.toString()
