import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Method m | 
      m.hasQualifiedName("javax.servlet", "ServletRequest", "getParameter") |
      exists(MethodAccess ma |
        ma.getMethod() = m and
        this.asExpr() = ma and
        exists(Annotation a |
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestBody") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestParam") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestHeader") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "CookieValue") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "ModelAttribute")
        ) and
        not ma.getArgument(0).getType().isPrimitive()
      )
    )
  }
}

class URLConstructionSink extends DataFlow::Node {
  URLConstructionSink() {
    exists(Constructor c |
      c.hasQualifiedName("java.net", "URL", "<init>") |
      exists(ConstructorCall cc |
        cc.getConstructor() = c and
        this.asExpr() = cc.getArgument(0)
      )
    )
  }
}

class URLStringConcatSink extends DataFlow::Node {
  URLStringConcatSink() {
    exists(MethodCall mc |
      (mc.getMethod().getName() = "concat" or
       mc.getMethod().getName() = "append" or
       mc.getMethod().hasName("format")) and
      exists(DataFlow::Node n | n.asExpr().toString().matches("http(s?)://%(v|s|q).*"))
    )
    or
    exists(AssignExpr ae |
      ae.getOperator() = ADD_ASSIGN and
      exists(DataFlow::Node n | n.asExpr().toString().matches("http(s?)://%(v|s|q).*"))
    )
  }
}

