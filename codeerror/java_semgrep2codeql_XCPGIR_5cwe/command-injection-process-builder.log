Rule Content:
/**
 * @name Command Injection in ProcessBuilder
 * @description Detects when user-controlled input reaches ProcessBuilder constructor 
 *              or command method without proper sanitization, which could lead to 
 *              command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat

class ProcessBuilderTaintConfig extends TaintTracking::Configuration {
  ProcessBuilderTaintConfig() { this = "ProcessBuilderTaintConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | 
      source.asParameter() = p and
      not exists(p.getAnAccess().getStringValue().regexpMatch("\".*\"")) and
      not exists(MethodAccess ma | 
        ma.getMethod().hasName("asList") and 
        ma.getArgument(0).getStringValue().regexpMatch("Arrays\\.asList\\(\".*\"\\)") and
        source.asExpr() = ma.getArgument(0)
      ) and
      not exists(ArrayCreation ac | 
        ac.getInitializer().toString() = "new String[]{\"...\"}" and
        source.asExpr() = ac
      )
    ) or
    exists(LocalVariableDecl lvd |
      source.asLocalVar() = lvd.getAStorageLocation() and
      not exists(lvd.getInitializer().getStringValue().regexpMatch("\".*\""))
    ) or
    exists(Field f |
      source.asField() = f and
      not exists(f.getAnAccess().getStringValue().regexpMatch("\".*\""))
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof Expr and
    exists(Method m | 
      (m.hasName("<init>") or m.hasName("command")) and
      m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      sink.(Expr).getAnArgument() = m.getAnArgument(0) and
      ( // Shell command patterns
        m.getAnArgument(0).getStringValue().regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/.*-c|cmd.*/c") or
        true
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StringLiteral or
    exists(ArrayCreation ac |
      ac.getInitializer().toString() = "new String[]{\"...\"}" and
      sanitizer.(Expr) = ac
    ) or
    exists(MethodAccess ma |
      ma.getMethod().hasName("asList") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.util", "Arrays") and
      exists(ma.getAnArgument(0).getStringValue().regexpMatch("Arrays\\.asList\\(\".*\"\\)")) and
      sanitizer.(Expr) = ma.getArgument(0)
    )
  }
}

from ProcessBuilderTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "User input reaches ProcessBuilder without proper sanitization",
  source.getNode(), "User input", sink.getNode(), "ProcessBuilder call"
