/**
 * @name Command Injection in ProcessBuilder
 * @description Detects when user-controlled input reaches ProcessBuilder without sanitization
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */
import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class ProcessBuilderTaintConfig extends TaintTracking::Configuration {
  ProcessBuilderTaintConfig() { this = "ProcessBuilderTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | 
      source.asParameter() = p and
      not exists(p.getAnAccess().toString().regexpMatch("\".*\""))
    ) or
    exists(LocalVariableDecl lvd |
      source.asVariable() = lvd.getVariable() and
      exists(Expr init | init = lvd.getInitializer() | not init.toString().regexpMatch("\".*\""))
    ) or
    exists(Field f |
      source.asField() = f and
      not exists(f.getAnAccess().toString().regexpMatch("\".*\""))
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ((ma.getMethod().hasName("<init>") or ma.getMethod().hasName("command")) and
       ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")) and
      sink.asExpr() = ma.getArgument(0) and
      (
        ma.getArgument(0).toString().matches("%(sh|bash|ksh|csh|tcsh|zsh)%.*%-c|cmd%.*/c") or
        ma.getArgument(0) instanceof Expr and not ma.getArgument(0) instanceof StringLiteral
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sanitizer.asExpr() = sl) or
    exists(ArrayCreationExpr ac |
      ac.getInitializer().toString().matches("new String%\\[%\\]\\{%.*%\\}") and
      sanitizer.asExpr() = ac
    ) or
    exists(MethodAccess ma |
      ma.getMethod().hasName("asList") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.util", "Arrays") and
      sanitizer.asExpr() = ma.getArgument(0) and
      ma.getArgument(0).toString().matches("Arrays%.asList%\\(%.*%\\)")
    )
  }
}

from ProcessBuilderTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
