Rule Content:
/**
 * @name Command Injection in ProcessBuilder
 * @description Detects when user-controlled input reaches ProcessBuilder constructor or command method without proper sanitization,
 *              which could lead to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ProcessBuilderTaintConfig extends TaintTracking::Configuration {
  ProcessBuilderTaintConfig() { this = "ProcessBuilderTaintConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p, LocalVariable v, Field f |
      // User controlled inputs (excluding string literals and safe collections)
      (source.asParameter() = p and not p.getAnAccess().getStringValue() = "\"...\"") or
      (source.asLocalVar() = v and not v.getAnAccess().getStringValue() = "\"...\"") or
      (source.asField() = f and not f.getAnAccess().getStringValue() = "\"...\"")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      // ProcessBuilder constructor or command method calls
      (
        ma.getMethod().hasName("<init>") and
        ma.getMethod().getDeclaringType() instanceof TypeProcessBuilder
      ) or
      (
        ma.getMethod().hasName("command") and
        ma.getMethod().getDeclaringType() instanceof TypeProcessBuilder
      ) or
      // Shell command patterns
      (
        (ma.getMethod().hasName("<init>") or ma.getMethod().hasName("command")) and
        ma.getMethod().getDeclaringType() instanceof TypeProcessBuilder and
        ma.getArgument(0).getStringValue().regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/.*-c|cmd.*/c")
      ) and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // String literals
    exists(StringLiteral sl | sanitizer.asExpr() = sl) or
    // Safe arrays
    exists(ArrayInitializer ai | sanitizer.asExpr() = ai and ai.getExprs().getStringValue() = "\"...\"") or
    // Safe lists
    exists(MethodAccess ma |
      ma.getMethod().hasName("asList") and
      ma.getMethod().getDeclaringType() instanceof TypeArrays and
      sanitizer.asExpr() = ma.getArgument(0) and
      ma.getArgument(0).getStringValue() = "Arrays.asList(\"...\")"
    )
  }
}

from ProcessBuilderTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "User input reaches ProcessBuilder without proper sanitization".toString(),
  source.getNode(), "User input", sink.getNode(), "ProcessBuilder call"
