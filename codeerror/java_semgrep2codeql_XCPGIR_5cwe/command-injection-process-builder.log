/**
 * @name Command Injection in ProcessBuilder
 * @description Detects when user-controlled input reaches ProcessBuilder without sanitization
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import DataFlow::PathGraph

class ProcessBuilderTaintConfig extends TaintTracking::Configuration {
  ProcessBuilderTaintConfig() { this = "ProcessBuilderTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | 
      source.asParameter() = p and
      not exists(p.getAnAccess().toString().regexpMatch("\".*\""))
    ) or
    exists(LocalVariableDecl lvd |
      source.asVariable() = lvd.getAVariable() and
      exists(Expr init | init = lvd.getInitializer() | not init.toString().regexpMatch("\".*\""))
    ) or
    exists(Field f |
      source.asField() = f and
      not exists(f.getAnAccess().toString().regexpMatch("\".*\""))
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, MethodAccess ma |
      (m.hasName("<init>") or m.hasName("command")) and
      m.getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      ma.getMethod() = m and
      sink.asExpr() = ma.getArgument(0) and
      (
        ma.getArgument(0).toString().regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/.*-c|cmd.*/c") or
        true // Match all ProcessBuilder calls
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sanitizer.asExpr() = sl) or
    exists(ArrayCreation ac |
      ac.getInitializer().toString().regexpMatch("new String\\[\\]\\{\".*\"\\}") and
      sanitizer.asExpr() = ac
    ) or
    exists(Method m, MethodAccess ma |
      m.hasName("asList") and
      m.getDeclaringType().hasQualifiedName("java.util", "Arrays") and
      ma.getMethod() = m and
      sanitizer.asExpr() = ma.getArgument(0) and
      ma.getArgument(0).toString().regexpMatch("Arrays\\.asList\\(\".*\"\\)")
    )
  }
}

from ProcessBuilderTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "User input reaches ProcessBuilder without proper sanitization",
  source.getNode(), "User input", sink.getNode(), "ProcessBuilder call"
