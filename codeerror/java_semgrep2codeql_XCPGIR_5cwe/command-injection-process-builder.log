/**
 * @name Command Injection in ProcessBuilder
 * @description Detects when user-controlled input reaches ProcessBuilder without sanitization
 * @kind path-problem
 * @problem.severity error
 * @id java/command-injection-process-builder
 * @tags security
 *       external/cwe/cwe-078
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat

class ProcessBuilderTaintConfig extends TaintTracking::Configuration {
  ProcessBuilderTaintConfig() { this = "ProcessBuilderTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | 
      source.asParameter() = p and
      not p.getAnAccess().getStringValue() = "\"..."\""
    ) or
    exists(LocalVariableDecl lvd |
      source.asLocalVar() = lvd.getVariable() and
      not lvd.getInitializer().getStringValue() = "\"..."\""
    ) or
    exists(Field f |
      source.asField() = f and
      not f.getAnAccess().getStringValue() = "\"..."\""
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      (ma.getMethod().hasName("<init>") and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder"))
      or
      (ma.getMethod().hasName("command") and ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder"))
      and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sanitizer.asExpr() = sl) or
    exists(ArrayCreation ac |
      ac.getInitializer().toString() = "new String[]{\"...\"}" and
      sanitizer.asExpr() = ac
    ) or
    exists(MethodAccess ma |
      ma.getMethod().hasName("asList") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.util", "Arrays") and
      ma.getArgument(0).getStringValue() = "Arrays.asList(\"...\")" and
      sanitizer.asExpr() = ma.getArgument(0)
    )
  }
}

from ProcessBuilderTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "User input reaches ProcessBuilder without proper sanitization",
  source.getNode(), "User input", sink.getNode(), "ProcessBuilder call"
