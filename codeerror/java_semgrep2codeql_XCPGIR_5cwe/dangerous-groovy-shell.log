Rule Content:
/**
 * @name Dangerous Groovy Shell Usage
 * @description Detects potential code injection via GroovyShell dynamic evaluation
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id java/dangerous-groovy-shell
 * @tags security
 *       external/cwe/cwe-094
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import DataFlow::PathGraph

class GroovyShellConfig extends TaintTracking::Configuration {
  GroovyShellConfig() { 
    this = "GroovyShellTaintTracking" 
  }

  override predicate isSource(DataFlow::Node source) {
    exists(LocalVariableDecl lvd |
      (lvd.getType().hasQualifiedName("groovy.lang", "GroovyShell") or 
       lvd.getType().hasQualifiedName("groovy.lang", "GroovyClassLoader")) and
      source.asExpr() = lvd.getVariable()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall mc |
      (mc.getMethod().getName() = "parse" or
       mc.getMethod().getName() = "evaluate" or
       mc.getMethod().getName() = "parseClass") and
      (mc.getQualifier().getType().hasQualifiedName("groovy.lang", "GroovyShell") or
       mc.getQualifier().getType().hasQualifiedName("groovy.lang", "GroovyClassLoader")) and
      not mc.getArgument(0) instanceof StringLiteral and
      sink.asExpr() = mc.getArgument(0)
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, GroovyShellConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential code injection via GroovyShell dynamic evaluation. The source of the value should be verified.",
  source.getNode(), sink.getNode(),
  "Unfiltered data flows to GroovyShell evaluation"
