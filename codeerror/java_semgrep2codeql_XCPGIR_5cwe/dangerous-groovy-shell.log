sinks:
  - id: SHELL_PARSE
    match:
      node: CALL
      api:
        type: "groovy.lang.GroovyShell | groovy.lang.GroovyClassLoader"
        method: "parse | evaluate | parseClass"
    constraints:
      must_not:
        - pattern: 'LITERAL(string)'

propagations:
  - id: SHELL_TO_METHOD
    edge: local->receiver
    kind: taint

flows:
  - source: GROOVY_SHELL_INSTANCE
    sink: SHELL_PARSE
    through: [SHELL_TO_METHOD]

report:
  message: "Potential code injection via GroovyShell dynamic evaluation"
  locations: ["sink"]
  evidence:
    capture:
      - argument: 0

metadata:
  cwe: ["CWE-94: Improper Control of Generation of Code ('Code Injection')"]
  owasp: ["A03:2021 - Injection"]
  technology: [groovy]
