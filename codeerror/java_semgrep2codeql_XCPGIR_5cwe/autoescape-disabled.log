Rule Content:
/**
 * @name autoescape-disabled
 * @description Detected an element with disabled HTML escaping. If external data can reach this, this is a cross-site scripting (XSS) vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id jsf/autoescape-disabled
 */

import javascript
import DataFlow::PathGraph

predicate isDisabledEscape(Expr node) {
  exists(string literal |
    node instanceof Literal and
    literal = node.getText() and
    regexMatches(".*escape.*?=.*?false.*", literal)
  )
}

class DisabledEscape extends DataFlow::Node {
  DisabledEscape() {
    exists(Expr e | isDisabledEscape(e) and this.asExpr() = e)
  }
}

class XssSink extends DataFlow::Node {
  XssSink() {
    exists(CallExpr call | this.asExpr() = call)
  }
}

query predicate isFlow(DataFlow::PathNode source, DataFlow::PathNode sink) {
  exists(DisabledEscape disabledEscape, XssSink xssSink |
    source.getNode() = disabledEscape and
    sink.getNode() = xssSink and
    DataFlow::localFlow(disabledEscape, xssSink)
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where isFlow(source, sink)
select sink.getNode(), 
  "Detected an element with disabled HTML escaping. Potential XSS vulnerability.",
  source.getNode(), sink.getNode(),
  "message", source.getNode().toString(), sink.getNode().toString()
