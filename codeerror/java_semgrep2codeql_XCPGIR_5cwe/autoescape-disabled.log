import java
import DataFlow::PathGraph

predicate isDisabledEscape(Expression node) {
  exists(string literal |
    node = node.toString() and
    regex(".*escape.*?=.*?false.*", literal)
  )
}

class DisabledEscape extends DataFlow::Node {
