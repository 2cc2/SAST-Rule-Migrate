Rule Content:
/**
 * @name Vertx SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/vertx-sqli
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class VertxSqlClient extends RefType {
  VertxSqlClient() {
    this.hasQualifiedName("io.vertx.sqlclient", "SqlClient")
  }
}

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "format" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma
    )
  }
}

class UnsafeSqlConcatSource extends DataFlow::Node {
  UnsafeSqlConcatSource() {
    exists(LocalVariableDecl lvd |
      lvd.getType() instanceof TypeString and
      lvd.getName().matches("%SQL%") and
      exists(lvd.getInitializer() |
        this.asExpr() = lvd.getInitializer() and
        this.asExpr().(AddExpr).getAnOperand().toString().matches("%+%")
      )
    )
  }
}

class SqlExecSink extends DataFlow::Node {
  SqlExecSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType() instanceof VertxSqlClient and
      (ma.getMethod().getName() = "query" or
       ma.getMethod().getName() = "preparedQuery" or
       ma.getMethod().getName() = "prepare") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::BarrierGuard {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "prepareStatement" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      this.getNode().asExpr() = ma
    )
  }
}

predicate isFlow(DataFlow::Node source, DataFlow::Node sink) {
  exists(TaintFlowConfig conf |
    conf.hasFlow(source, sink) and
    not exists(DataFlow::Node barrier |
      barrier instanceof PreparedStatementSanitizer and
      conf.hasFlowThrough(barrier)
    )
  )
}

from StringFormatSource source, SqlExecSink sink
where isFlow(source, sink)
select sink, "Potential SQL injection via un-sanitized SQL string formatting", source, sink.toString()

from UnsafeSqlConcatSource source, SqlExecSink sink
where isFlow(source, sink)
select sink, "Potential SQL injection via unsafe SQL string concatenation", source, sink.toString()
