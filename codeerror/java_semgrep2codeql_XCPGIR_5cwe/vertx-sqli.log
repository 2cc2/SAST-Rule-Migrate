Rule Content:
/**
 * @name Vertx SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/vertx-sqli
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class VertxSqlClient extends RefType {
  VertxSqlClient() {
    this.hasQualifiedName("io.vertx.sqlclient", "SqlClient")
  }
}

class StringFormatSource extends TaintTracking::Source {
  StringFormatSource() {
    exists(Method m | 
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") |
      this.asExpr() = m.getACall()
    )
  }
}

class UnsafeSqlConcatSource extends TaintTracking::Source {
  UnsafeSqlConcatSource() {
    exists(LocalVariableDecl lvd |
      lvd.getType().hasName("String") and
      lvd.getName().matches("%SQL%") and
      exists(AddExpr addExpr | addExpr = lvd.getInitializer() | this.asExpr() = addExpr)
    )
  }
}

class SqlExecSink extends TaintTracking::Sink {
  SqlExecSink() {
    exists(Method m |
      m.getDeclaringType() instanceof VertxSqlClient and
      (m.hasName("query") or m.hasName("preparedQuery") or m.hasName("prepare")) |
      this.asExpr() = m.getACall().getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends TaintTracking::Sanitizer {
  PreparedStatementSanitizer() {
    exists(Method m |
      m.hasName("prepareStatement") and
      m.getDeclaringType().hasQualifiedName("java.sql", "Connection") |
      this.asExpr() = m.getACall()
    )
  }
}

class VertxSqlInjectionConfig extends TaintTracking::Configuration {
  VertxSqlInjectionConfig() {
    this = "VertxSqlInjectionConfig"
  }
  
  override predicate isSource(TaintTracking::Source source) {
    source instanceof StringFormatSource or source instanceof UnsafeSqlConcatSource
  }
  
  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof SqlExecSink
  }
  
  override predicate isSanitizer(TaintTracking::Sanitizer sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

from VertxSqlInjectionConfig cfg, TaintTracking::PathNode source, TaintTracking::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Potential SQL injection via un-sanitized SQL string formatting",
  source, sink,
  "SQL execution with potentially tainted input"
