  kind: taint
  severity: WARNING
  message: "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized."
scope:
  languages: [java]
  frameworks: ["vertx"]

sources:
  - id: UNSAFE_SQL_FORMAT
    match:
      node: CALL
      api: { type: java.lang.String, method: format }
  - id: UNSAFE_SQL_CONCAT
    match:
      node: ASSIGNMENT
      where:
        - op: regex
          left: code
          right: "String\\s+\\$SQL\\s*=\\s*\\$X\\s*\\+\\s*\\$Y"

sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: { type: io.vertx.sqlclient.SqlClient, method: query }
      arg_index: 0
    match:
      node: CALL
      api: { type: io.vertx.sqlclient.SqlClient, method: preparedQuery }
      arg_index: 0
    match:
      node: CALL
      api: { type: io.vertx.sqlclient.SqlClient, method: prepare }
      arg_index: 0

sanitizers:
  - id: PREPARED_STATEMENT
    match: { node: CALL, api: { type: java.sql.Connection, method: prepareStatement } }
    effect: neutralize

barriers:
  - id: RETURN_STOP
    match: { node: RETURN }
    effect: stop

propagations:
  - id: ARG_TO_SQL
    edge: arg->param
    kind: taint
  - id: STRING_CONCAT
    edge: dfg
    kind: taint

flows:
  - source: UNSAFE_SQL_FORMAT
    sink: SQL_EXEC
    through: [ARG_TO_SQL*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(java.sql.Connection.prepareStatement)" } ]
  - source: UNSAFE_SQL_CONCAT
    sink: SQL_EXEC
    through: [STRING_CONCAT*]

report:
  message: "Potential SQL injection via un-sanitized SQL string formatting"
  locations: ["sink"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "client.query(String.format(\"SELECT * FROM users WHERE name = %s\", userInput));"
    - "String sql = \"SELECT * FROM \" + tableName; client.query(sql);"
  negative:
    - "PreparedStatement stmt = conn.prepareStatement(\"SELECT * FROM users WHERE name = ?\");"
```
