Rule Content:
/**
 * @name Vertx SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/vertx-sqli
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.vertx.VertxCore

class VertxSqlClient extends RefType {
  VertxSqlClient() {
    this.hasQualifiedName("io.vertx.sqlclient", "SqlClient")
  }
}

predicate isStringFormatSource(DataFlow::Node source) {
  exists(MethodAccess ma |
    ma.getMethod().getName() = "format" and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
    source.asExpr() = ma
  )
}

predicate isUnsafeSqlConcatSource(DataFlow::Node source) {
  exists(LocalVariableDecl lvd |
    lvd.getType() instanceof TypeString and
    lvd.getName().matches("%SQL%") and
    exists(AddExpr add |
      add = lvd.getInitializer() and
      source.asExpr() = add
    )
  )
}

predicate isSqlExecSink(DataFlow::Node sink) {
  exists(MethodAccess ma |
    ma.getMethod().getDeclaringType() instanceof VertxSqlClient and
    (ma.getMethod().getName() = "query" or
     ma.getMethod().getName() = "preparedQuery" or
     ma.getMethod().getName() = "prepare") and
    sink.asExpr() = ma.getArgument(0)
  )
}

predicate isPreparedStatementSanitizer(DataFlow::Node sanitizer) {
  exists(MethodAccess ma |
    ma.getMethod().getName() = "prepareStatement" and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Connection") and
    sanitizer.asExpr() = ma
  )
}

class VertxSqlInjectionConfig extends TaintTracking::Configuration {
  VertxSqlInjectionConfig() {
    this = "VertxSqlInjectionConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    isStringFormatSource(source) or isUnsafeSqlConcatSource(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    isSqlExecSink(sink)
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    isPreparedStatementSanitizer(sanitizer)
  }
}

from VertxSqlInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Potential SQL injection via un-sanitized SQL string formatting",
  source, sink,
  "SQL execution with potentially tainted input"
