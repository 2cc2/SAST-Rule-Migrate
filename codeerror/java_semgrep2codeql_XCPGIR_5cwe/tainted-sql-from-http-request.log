/**
 * @id tainted-sql-from-http-request
 * @kind path-problem
 * @severity Warning
 * @problem.severity warning
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import semmle.code.java.frameworks.Spring
import DataFlow::PathGraph

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType() instanceof HttpServletRequest and
      ma.getMethod().getName().matches("getInputStream|getParameter|getParameterMap|getParameterValues|getReader|getCookies|getHeader|getHeaderNames|getHeaders|getPart|getParts|getQueryString") and
      this.asExpr() = ma
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType() instanceof Statement or
       ma.getMethod().getDeclaringType() instanceof PreparedStatement or
       ma.getMethod().getDeclaringType() instanceof CallableStatement or
       ma.getMethod().getDeclaringType() instanceof JdbcTemplate) and
      ma.getMethod().getName().matches("execute|query|executeUpdate|batchUpdate|prepareStatement|queryForObject|queryForMap") and
      this.asExpr() = ma
    )
  }
}

class TaintedSQLFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedSQLFromHttpRequestConfig() { this = "TaintedSQLFromHttpRequestConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }
}

from TaintedSQLFromHttpRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization. $@ flows here from $@.", 
  sink.getNode(), 
  source.getNode(),
  "Potential SQL injection vulnerability"
