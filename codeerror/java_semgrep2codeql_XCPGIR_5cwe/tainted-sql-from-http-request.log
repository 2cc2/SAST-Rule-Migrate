/**
 * @id tainted-sql-from-http-request
 * @kind path-problem
 * @severity Warning
 * @problem.severity warning
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import semmle.code.java.frameworks.spring.SpringHelpers
import java.sql.Statement
import java.sql.PreparedStatement
import java.sql.CallableStatement
import org.springframework.jdbc.core.JdbcTemplate
import DataFlow

class HttpRequestSource extends DataFlow::Node {
  HttpRequestSource() {
    exists(Method m |
      m.getDeclaringType() instanceof HttpServletRequest and
      m.getName().matches("getInputStream|getParameter|getParameterMap|getParameterValues|getReader|getCookies|getHeader|getHeaderNames|getHeaders|getPart|getParts|getQueryString") and
      this.asExpr() = m.getACall()
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(Method m |
      (m.getDeclaringType() instanceof Statement or
       m.getDeclaringType() instanceof PreparedStatement or
       m.getDeclaringType() instanceof CallableStatement or
       m.getDeclaringType() instanceof JdbcTemplate) and
      m.getName().matches("execute|query|executeUpdate|batchUpdate|prepareStatement|queryForObject|queryForMap") and
      this.asExpr() = m.getACall()
    )
  }
}

class TaintedSQLFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedSQLFromHttpRequestConfig() { this = "TaintedSQLFromHttpRequestConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof HttpRequestSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }
}

