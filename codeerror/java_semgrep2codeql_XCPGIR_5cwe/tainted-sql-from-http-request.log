Rule Content:
/**
 * @id tainted-sql-from-http-request
 * @kind path-problem
 * @severity Warning
 * @problem.severity warning
 * @description Detected input from a HTTPServletRequest going into a SQL sink or statement. 
 *              This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

predicate isHttpRequestSource(DataFlow::Node source) {
  exists(MethodAccess ma |
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
    ma.getMethod().getName().matches("getInputStream|getParameter|getParameterMap|getParameterValues|getReader|getCookies|getHeader|getHeaderNames|getHeaders|getPart|getParts|getQueryString") and
    source.asExpr() = ma
  )
}

predicate isSqlSink(DataFlow::Node sink) {
  exists(MethodAccess ma |
    (
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") or
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "CallableStatement") or
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
    ) and
    ma.getMethod().getName().matches("execute|query|executeUpdate|batchUpdate|prepareStatement|queryForObject|queryForMap") and
    sink.asExpr() = ma
  )
}

class TaintedSQLFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedSQLFromHttpRequestConfig() { this = "TaintedSQLFromHttpRequestConfig" }

  override predicate isSource(DataFlow::Node source) { isHttpRequestSource(source) }

  override predicate isSink(DataFlow::Node sink) { isSqlSink(sink) }
}

from TaintedSQLFromHttpRequestConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "User input reaches SQL execution without sanitization. $@ flows here from $@.", 
  sink.getNode(), 
  source.getNode(),
  "Potential SQL injection vulnerability"
