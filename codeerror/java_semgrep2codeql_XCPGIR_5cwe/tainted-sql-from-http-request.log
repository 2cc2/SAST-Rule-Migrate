/**
 * @id tainted-sql-from-http-request
 * @kind path-problem
 * @severity Warning
 * @problem.severity warning
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.Servlets
import semmle.code.java.frameworks.Spring
import DataFlow::PathGraph

predicate isHttpRequestSource(DataFlow::Node source) {
  exists(Method m | 
    m.getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
    m.getName().matches("getInputStream|getParameter%|getReader|getCookies|getHeader%|getPart%|getQueryString") and
    source.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getQualifier()
  )
}

predicate isSqlSink(DataFlow::Node sink) {
  exists(Method m |
    (
      m.getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Statement") or
      m.getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "PreparedStatement") or
      m.getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "CallableStatement") or
      m.getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
    ) and
    m.getName().matches("execute%|query%|batchUpdate|prepareStatement") and
    sink.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getAnArgument()
  )
}

class TaintedSQLFromHttpRequestConfig extends TaintTracking::Configuration {
  TaintedSQLFromHttpRequestConfig() { this = "TaintedSQLFromHttpRequestConfig" }

  override predicate isSource(DataFlow::Node source) { isHttpRequestSource(source) }

  override predicate isSink(DataFlow::Node sink) { isSqlSink(sink) }
}

