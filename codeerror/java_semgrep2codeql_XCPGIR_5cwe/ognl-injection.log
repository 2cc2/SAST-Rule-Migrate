/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should be verified
 *              to avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class OGNLInjectionConfig extends TaintTracking::Configuration {
  OGNLInjectionConfig() { this = "OGNLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      p.getType().hasName("String") and
      source.asParameter() = p
    )
    or
    exists(LocalVariable lv |
      lv.getType().hasName("String") and
      source.asExpr() = lv.getAnAccess()
    )
    or
    exists(MethodAccess ma |
      ma.getMethod().hasName(["getParameter", "getQueryString", "getHeader", "getAttribute"]) and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma, Method m |
      ma.getMethod() = m and
      (
        m.getName().matches("%evaluate%") or
        m.getName().matches("%getValu%") or
        m.getName().matches("%setValu%") or
        m.getName().matches("%translateVariabl%") or
        m.getName().matches("%findValu%") or
        m.getName().matches("%callMethod%") or
        m.getName().matches("%compile%") or
        m.getName().matches("%findString%") or
        m.getName().matches("%getText%") or
        m.getName().matches("%setProperty%") or
        m.getName().matches("%getField%") or
        m.getName().matches("%setProperties%") or
        m.getName().matches("%makeSelectList%")
      ) and
      (
        m.getDeclaringType().hasQualifiedName("ognl", "OgnlRuntime") or
        m.getDeclaringType().hasQualifiedName("ognl", "Ognl") or
        m.getDeclaringType().hasQualifiedName("ognl", "OgnlUtil") or
        m.getDeclaringType().hasQualifiedName("ognl", "TextParseUtil") or
        m.getDeclaringType().hasQualifiedName("ognl", "TextParser") or
        m.getDeclaringType().hasQualifiedName("ognl", "ValueStack") or
        m.getDeclaringType().hasQualifiedName("ognl", "OgnlReflectionProvider") or
        m.getDeclaringType().hasQualifiedName("ognl", "VelocityStrutsUtil") or
        m.getDeclaringType().hasQualifiedName("ognl", "StrutsUtil") or
        m.getDeclaringType().hasQualifiedName("ognl", "OgnlTool")
      ) and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sanitizer.asExpr() = sl)
  }
}

from OGNLInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink, "Potential OGNL injection vulnerability detected."
