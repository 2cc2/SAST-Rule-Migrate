Rule Content:
/**
 * @name OGNL Injection
 * @description A expression is built with a dynamic value. The source of the value(s) should be verified 
 *              to avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/ognl-injection
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class OGNLInjectionConfig extends TaintTracking::Configuration {
  OGNLInjectionConfig() { this = "OGNLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma, Method m |
      ma.getMethod() = m and
      m.hasName(["getParameter", "getQueryString", "getHeader", "getAttribute"]) and
      m.getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      source.asExpr() = ma
    )
    or
    exists(LocalVariable lv | source.asExpr() = lv.getAnAccess() and lv.getType().toString() = "String")
    or
    exists(Parameter p | source.asExpr() = p.getAnAccess() and p.getType().toString() = "String")
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma, Method m, RefType t |
      ma.getMethod() = m and
      m.getName().matches("%evaluate%") and
      (
        t.hasQualifiedName("ognl", "OgnlRuntime") or
        t.hasQualifiedName("ognl", "Ognl") or
        t.hasQualifiedName("ognl", "OgnlUtil") or
        t.hasQualifiedName("ognl", "TextParseUtil") or
        t.hasQualifiedName("ognl", "ValueStack") or
        t.hasQualifiedName("ognl", "OgnlReflectionProvider") or
        t.hasQualifiedName("ognl", "VelocityStrutsUtil") or
        t.hasQualifiedName("ognl", "StrutsUtil")
      ) and
      t = m.getDeclaringType() and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal l | sanitizer.asExpr() = l and l.isStringLiteral())
  }
}

from OGNLInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential OGNL injection vulnerability detected."
