Rule Content:
/**
 * @name Formatted SQL String
 * @id formatted-sql-string
 * @description Detected a formatted string in a SQL statement. This could lead to SQL
 *              injection if variables in the SQL statement are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity error
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.frameworks.SQL

class UserInputSource extends DataFlow::Source {
  UserInputSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getParameter") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")
    |
      this.asParameter() = ma.getArgument(0).(ParameterAccess).getParameter()
    )
  }
}

class SqlSink extends DataFlow::Sink {
  SqlSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Statement") or
       ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "PreparedStatement") or
       ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Connection") or
       ma.getMethod().getDeclaringType().hasQualifiedName("javax.persistence", "EntityManager")) and
      ma.getMethod().hasName(["execute", "executeQuery", "createQuery", "query", "addBatch", "nativeSQL", "create", "prepare"])
    |
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class StringConcatStep extends DataFlow::Step {
  StringConcatStep() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") or
       ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuffer") or
       ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder")) and
      ma.getMethod().hasName(["append", "concat", "format", "join"])
    |
      this.getInput() = ma.getArgument(0) and
      this.getOutput() = ma
    )
  }
}

class CriteriaBuilderSanitizer extends DataFlow::Sanitizer {
  CriteriaBuilderSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.persistence.criteria", "CriteriaBuilder")
    |
      this.asExpr() = ma
    )
  }
}

class FormattedSqlStringConfig extends TaintTracking::Configuration {
  FormattedSqlStringConfig() { this = "FormattedSqlStringConfig" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof SqlSink
  }

  override predicate isSanitizer(DataFlow::Sanitizer sanitizer) {
    sanitizer instanceof CriteriaBuilderSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Step step) {
    step instanceof StringConcatStep
  }
}

from FormattedSqlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "User input reaches SQL execution without proper sanitization. Source: $@, Sink: $@",
  source.getNode(), "Source",
  sink.getNode(), "Sink"
