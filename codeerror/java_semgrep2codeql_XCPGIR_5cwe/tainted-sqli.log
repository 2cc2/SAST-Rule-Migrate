Rule Content:
/**
 * @name Tainted SQL Query in AWS Lambda
 * @description Detects SQL statements that are tainted by user input from AWS Lambda events.
 * @kind problem
 * @problem.severity warning
 * @id java/tainted-sqli
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.QueryUtils

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(MethodParameter mp |
      mp.getDeclaringType().getASourceSupertype*().hasQualifiedName("com.amazonaws.services.lambda.runtime", "Context") and
      mp.getName() = "$EVENT" and
      this.asParameter() = mp
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      (
        ma.getMethod().getName() = "execute" or
        ma.getMethod().getName() = "query" or
        ma.getMethod().getName() = "executeUpdate"
      ) and
      ma.getArgument(0) = this.asExpr()
    ) or
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      (
        ma.getMethod().getName() = "queryForObject" or
        ma.getMethod().getName() = "queryForMap"
      ) and
      ma.getArgument(1) = this.asExpr()
    )
  }
}

class TaintedSqlQueryConfiguration extends TaintTracking::Configuration {
  TaintedSqlQueryConfiguration() { this = "TaintedSqlQueryConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaEventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecutionSink }

  override predicate isSanitizer(DataFlow::Node node) { none() }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(MethodCall mc |
      node1.asExpr() = mc.getArgument(_) and
      node2.asExpr() = mc.getQualifier()
    )
  }
}

from TaintedSqlQueryConfiguration config, DataFlow::Node source, DataFlow::Node sink
where
  config.hasFlow(source, sink)
select sink, "Potential SQL injection vulnerability from user input in AWS Lambda", source,
  "This SQL statement uses tainted data from $@", source, "a Lambda event parameter"
