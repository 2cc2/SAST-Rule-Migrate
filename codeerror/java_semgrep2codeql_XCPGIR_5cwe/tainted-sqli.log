rule:
  id: tainted-sqli
  kind: taint
  severity: WARNING
  message: "Detected SQL statement that is tainted by user input. This could lead to SQL injection if variables in the SQL statement are not properly sanitized."
scope:
  languages: [java]
  frameworks: ["aws-lambda"]
  env: { os: [linux, windows], shell: [bash, sh] }

sources:
  - id: LAMBDA_EVENT
    match:
      node: PARAM
      api:
        type: com.amazonaws.services.lambda.runtime.Context
      where:
        - op: eq
          left: name
          right: "$EVENT"

sinks:
  - id: SQL_EXECUTION
    match:
      node: CALL
      api:
        type: java.sql.Statement
        method: execute
      arg_index: 0
  - id: SQL_QUERY
    match:
      node: CALL
      api:
        type: java.sql.Statement
        method: query
      arg_index: 0
  - id: SQL_UPDATE
    match:
      node: CALL
      api:
        type: java.sql.Statement
        method: executeUpdate
      arg_index: 0
  - id: SPRING_QUERY
    match:
      node: CALL
      api:
        type: org.springframework.jdbc.core.JdbcTemplate
        method: queryForObject
      arg_index: 1
  - id: SPRING_QUERY_MAP
    match:
      node: CALL
      api:
        type: org.springframework.jdbc.core.JdbcTemplate
        method: queryForMap
      arg_index: 1

propagations:
  - id: METHOD_PARAM_TO_ARG
    edge: arg->param
    kind: taint

flows:
  - source: LAMBDA_EVENT
    sink: SQL_EXECUTION
    through: [METHOD_PARAM_TO_ARG*]
  - source: LAMBDA_EVENT
    sink: SQL_QUERY
    through: [METHOD_PARAM_TO_ARG*]
  - source: LAMBDA_EVENT
    sink: SQL_UPDATE
    through: [METHOD_PARAM_TO_ARG*]
  - source: LAMBDA_EVENT
    sink: SPRING_QUERY
    through: [METHOD_PARAM_TO_ARG*]
  - source: LAMBDA_EVENT
    sink: SPRING_QUERY_MAP
    through: [METHOD_PARAM_TO_ARG*]

report:
  locations: ["source", "sink"]
  evidence:
    capture: [{argument: 0}]

metadata:
  category: security
  technology:
    - sql
    - java
    - aws-lambda
  cwe: "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"
  owasp:
    - A01:2017 - Injection
    - A03:2021 - Injection
```
