/**
 * @name Tainted SQL Query in AWS Lambda
 * @description Detects SQL statements that are tainted by user input from AWS Lambda events.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sqli
 * @tags security
 *       external/cwe/cwe-089
 *       external/owasp/a01:2017
 *       external/owasp/a03:2021
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Parameter p |
      p.getType().hasQualifiedName("com.amazonaws.services.lambda.runtime", "Context") and
      p.getName() = "$EVENT" and
      this.asParameter() = p
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(Method m, MethodCall mc |
      m.getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      (
        m.getName() = "execute" or
        m.getName() = "query" or
        m.getName() = "executeUpdate"
      ) and
      mc.getMethod() = m and
      this.asExpr() = mc.getArgument(0)
    )
    or
    exists(Method m, MethodCall mc |
      m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      (
        m.getName() = "queryForObject" or
        m.getName() = "queryForMap"
      ) and
      mc.getMethod() = m and
      this.asExpr() = mc.getArgument(1)
    )
  }
}

class TaintedSqlConfig extends TaintTracking::Configuration {
  TaintedSqlConfig() { 
    this = "Tainted SQL Query in AWS Lambda" 
  }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof LambdaEventSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof SqlExecutionSink 
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSqlConfig config
where config.hasFlowPath(source, sink)
select sink, "Potential SQL injection vulnerability from user input in AWS Lambda ($@)", 
  source, "Lambda event parameter"
