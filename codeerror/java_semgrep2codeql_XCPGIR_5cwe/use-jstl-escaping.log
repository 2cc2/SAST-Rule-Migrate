Rule Content:
/**
 * @name Use JSTL escaping
 * @description Detects Expression Language segments in tags that don't escape output, which could lead to XSS vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id java/use-jstl-escaping
 * @tags security
 *       external/cwe/cwe-116
 *       external/cwe/cwe-79
 *       owasp-a3
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class UnsafeJstlExpr extends DataFlow::ExprNode {
  UnsafeJstlExpr() {
    exists(StringLiteral literal |
      literal.getValue().regexpMatch("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>") and
      this.asExpr() = literal
    )
  }
}

class XssSink extends DataFlow::ExprNode {
  XssSink() {
    exists(StringLiteral literal |
      literal.getValue().regexpMatch("\\$\\{.*?\\}") and
      this.asExpr() = literal
    )
  }
}

class JstlTaintConfiguration extends TaintTracking::Configuration {
  JstlTaintConfiguration() { this = "JSTL unsafe expr taint tracking" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeJstlExpr
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof XssSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::ValueFlowStep vfs |
      vfs.getNode1() = node1 and
      vfs.getNode2() = node2
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, JstlTaintConfiguration config
where config.hasFlowPath(source, sink)
select sink, "Unescaped JSTL expression detected, potential XSS vulnerability. Use the 'out' tag from JSTL to escape expressions.",
  source, "Unsanitized expression here"
