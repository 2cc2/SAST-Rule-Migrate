Rule Content:
/**
 * @name Use JSTL escaping
 * @description Detects Expression Language segments in tags that don't escape output, which could lead to XSS vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id java/use-jstl-escaping
 * @tags security
 *       external/cwe/cwe-116
 *       external/cwe/cwe-79
 *       owasp-a3
 */

import java
import semmle.code.java.jsp.JspProcessingTools
import semmle.code.java.frameworks.JSTL
import DataFlow::PathGraph

class UnsafeJstlExpr extends DataFlow::Node {
  UnsafeJstlExpr() {
    exists(JspTagLiteral literal |
      literal.isInTags() and
      regexMatches("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>", literal.getValue())
    )
  }
}

class XssSink extends DataFlow::Node {
  XssSink() {
    exists(JspReturn ret |
      regexMatches("\\$\\{.*?\\}", ret.getValue())
    )
  }
}

predicate isFlowPath(DataFlow::PathNode source, DataFlow::PathNode sink) {
  source.getNode() instanceof UnsafeJstlExpr and
  sink.getNode() instanceof XssSink and
  exists(DataFlow::TaintTracking::Configuration cfg |
    cfg.hasFlowPath(source, sink)
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where isFlowPath(source, sink)
select sink, "Unescaped JSTL expression detected, potential XSS vulnerability. Use the 'out' tag from JSTL to escape expressions.", 
  source, "Unsanitized expression here"
