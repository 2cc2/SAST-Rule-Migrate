/**
 * @name Use JSTL escaping
 * @description Detects Expression Language segments in tags that don't escape output, which could lead to XSS vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id java/use-jstl-escaping
 * @tags security
 *       external/cwe/cwe-116
 *       owasp-a3
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class UnsafeJstlExpr extends DataFlow::Node {
  UnsafeJstlExpr() {
    exists(StringLiteral literal |
      literal.getValue().matches("<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>") and
      this.asExpr() = literal
    )
  }
}

class XssSink extends DataFlow::Node {
  XssSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName().matches("write|print|println|printf|format") or
      ma.getMethod().hasName("append")) and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet", "ServletOutputStream") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class JstlConfig extends TaintTracking::Configuration {
  JstlConfig() { this = "JSTL unsafe expr" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeJstlExpr
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof XssSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, JstlConfig config
where config.hasFlowPath(source, sink)
select sink, "Unescaped JSTL expression detected, potential XSS vulnerability. Use the 'out' tag from JSTL to escape expressions.",
