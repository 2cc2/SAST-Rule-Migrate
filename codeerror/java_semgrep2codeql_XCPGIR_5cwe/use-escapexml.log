/**
 * @name Use of unescaped Expression Language output
 * @description Detects Expression Language segments that don't escape output,
 *              which could lead to cross-site scripting vulnerabilities.
 * @kind problem
 * @problem.severity warning
 * @id java/use-escapexml
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringLiterals

class UnescapedELSource extends StringLiteral {
  UnescapedELSource() {
    this.getText().regexpMatch("\\$\\{[^}]*escapeXml[^}]*\\}") = false
  }
}

class XssSink extends Expr {
  XssSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getOut") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp", "PageContext") and
      ma.getQualifier() = this
    )
  }
}

predicate isEscapeXmlCall(Expr e) {
  exists(MethodAccess ma |
    ma.getMethod().hasName("escapeXml") and
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.jsp.jstl.functions", "functions") and
    ma.getAnArgument() = e
  )
}

from DataFlow::Node source, DataFlow::Node sink
where
  TaintTracking::localTaint(DataFlow::exprNode(source), DataFlow::exprNode(sink)) and
  source.asExpr() instanceof UnescapedELSource and
  sink.asExpr() instanceof XssSink and
  not exists(Expr e | isEscapeXmlCall(e) and e = source.asExpr())
select sink,
  "Expression Language segment does not escape output. Use the 'escapeXml' function from the JSTL taglib.",
  source, "Potential XSS vulnerability"
================================================================================
