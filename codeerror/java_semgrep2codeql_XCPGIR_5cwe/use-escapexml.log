/**
 * @name Use of unescaped Expression Language output
 * @description Detects Expression Language segments that don't escape output,
 *              which could lead to cross-site scripting vulnerabilities.
 * @kind problem
 * @problem.severity warning
 * @id java/use-escapexml
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.StringFormat
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.jsp.expr.JspExpr

predicate isPageContextGetOut(MethodAccess ma) {
  exists(Method m |
    m.hasName("getOut") and
    m.getDeclaringType().hasQualifiedName("javax.servlet.jsp", "PageContext") and
    ma.getMethod() = m
  )
}

predicate isEscapeXmlCall(Call c) {
  exists(Method m |
    m.hasName("escapeXml") and
    m.getDeclaringType().hasQualifiedName("javax.servlet.jsp.jstl.functions", "functions") and
    c.getCallee() = m
  )
}

class UnescapedELSource extends JspExpr {
  UnescapedELSource() {
    this.getStringValue().regexpMatch("\\$\\{[^}]*escapeXml[^}]*\\}") = false
  }
}

class XssSink extends MethodAccess {
  XssSink() { isPageContextGetOut(this) }
}

from UnescapedELSource source, XssSink sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where DataFlow::flowPath(sourceNode, sinkNode) and
  not exists(Call c |
    isEscapeXmlCall(c) and
    c.getAnArgument() = sourceNode.getNode()
  )
select sourceNode.getNode(), 
  "Expression Language segment does not escape output. Use the 'escapeXml' function from the JSTL taglib.",
  sourceNode.getNode(), "Potential XSS vulnerability"
