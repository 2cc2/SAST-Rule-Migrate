Rule Content:
/**
 * @name JDBC SQL Formatted String
 * @description Detects possible JDBC injection when using string concatenation or formatting
 * instead of parameterized queries.
 * @kind path-problem
 * @id java/jdbc-sql-formatted-string
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 */
import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class StringFormatSource extends DataFlow::ExprNode {
  StringFormatSource() {
    exists(Call c |
      c.getCallee().hasName("format") and
      c.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = c.getArgument(0)
    )
  }
}

class StringConcatSource extends DataFlow::ExprNode {
  StringConcatSource() {
    exists(Call c |
      c.getCallee().getName().matches("%concat%") and
      this.asExpr() = c.getAnArgument()
    )
  }
}

class StringBuilderAppendSource extends DataFlow::ExprNode {
  StringBuilderAppendSource() {
    exists(Call c |
      c.getCallee().getName() = "append" and
      c.getCallee().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder") and
      this.asExpr() = c.getAnArgument()
    )
  }
}

class JdbcSink extends DataFlow::ExprNode {
  JdbcSink() {
    exists(Call c |
      exists(Method m |
        m = c.getCallee() and
        m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
        (m.hasName("queryForObject") or 
         m.hasName("queryForList") or 
         m.hasName("update") or 
         m.hasName("execute") or 
         m.hasName("insert"))
      ) and
      this.asExpr() = c.getArgument(0)
    )
  }
}

class ParameterizedQuerySanitizer extends DataFlow::BarrierNode {
  ParameterizedQuerySanitizer() {
    exists(Call c |
      exists(Method m |
        m = c.getCallee() and
        m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
        m.hasName("queryForObject")
      ) and
      c.getArgument(0).toString().matches("%\\?%") and
      this.asExpr() = c.getArgument(0)
    )
  }
}

class JdbcTaintTrackingConfig extends TaintTracking::Configuration {
  JdbcTaintTrackingConfig() { 
    this = "JdbcStringFormatConfig" 
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource or
    source instanceof StringBuilderAppendSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof JdbcSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, JdbcTaintTrackingConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Possible JDBC injection detected. Use parameterized queries instead of string concatenation."
