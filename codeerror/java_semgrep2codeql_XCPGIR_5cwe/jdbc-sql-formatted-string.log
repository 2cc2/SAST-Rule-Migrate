Rule Content:
/**
 * @name JDBC SQL Formatted String
 * @description Detects possible JDBC injection when using string concatenation or formatting
 * instead of parameterized queries.
 * @kind problem
 * @id java/jdbc-sql-formatted-string
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.JdbcTemplate

class StringFormatCall extends MethodAccess {
  StringFormatCall() {
    this.getMethod().hasName("format") and
    this.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")
  }
}

class StringConcatCall extends MethodAccess {
  StringConcatCall() {
    this.getMethod().getName().matches("%concat%")
  }
}

class StringBuilderAppendCall extends MethodAccess {
  StringBuilderAppendCall() {
    this.getMethod().getName() = "append" and
    this.getMethod().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder")
  }
}

class JdbcQueryForObjectSink extends MethodAccess {
  JdbcQueryForObjectSink() {
    this.getMethod().getName() = "queryForObject" and
    this.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
  }
}

class JdbcQueryForListSink extends MethodAccess {
  JdbcQueryForListSink() {
    this.getMethod().getName() = "queryForList" and
    this.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
  }
}

class JdbcUpdateSink extends MethodAccess {
  JdbcUpdateSink() {
    this.getMethod().getName() = "update" and
    this.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
  }
}

class JdbcExecuteSink extends MethodAccess {
  JdbcExecuteSink() {
    this.getMethod().getName() = "execute" and
    this.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
  }
}

class JdbcInsertSink extends MethodAccess {
  JdbcInsertSink() {
    this.getMethod().getName() = "insert" and
    this.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
  }
}

class JdbcSink extends MethodAccess {
  JdbcSink() {
    this instanceof JdbcQueryForObjectSink or
    this instanceof JdbcQueryForListSink or
    this instanceof JdbcUpdateSink or
    this instanceof JdbcExecuteSink or
    this instanceof JdbcInsertSink
  }
}

class StringParameterizedQuerySanitizer extends MethodAccess {
  StringParameterizedQuerySanitizer() {
    exists(MethodAccess ma |
      ma instanceof JdbcSink and
      ma.getArgument(0).toString().matches("%\\?%")
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "JDBCStringFormatTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(StringFormatCall sfc | source.asExpr() = sfc.getArgument(0)) or
    exists(StringConcatCall scc | source.asExpr() = scc.getAnArgument()) or
    exists(StringBuilderAppendCall sbac | source.asExpr() = sbac.getAnArgument())
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(JdbcSink js | sink.asExpr() = js.getArgument(0))
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringParameterizedQuerySanitizer spqs | sanitizer.asExpr() = spqs.getArgument(0))
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Possible JDBC injection detected. Use parameterized queries instead of string concatenation."
