/**
 * @name JDBC SQL Formatted String
 * @description Detects possible JDBC injection when using string concatenation or formatting
 * instead of parameterized queries.
 * @kind path-problem
 * @id java/jdbc-sql-formatted-string
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 */
import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class StringFormatSource extends Call {
  StringFormatSource() {
    this.getCallee().hasName("format") and
    this.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String")
  }
}

class StringConcatSource extends Call {
  StringConcatSource() {
    this.getCallee().getName().matches("%concat%")
  }
}

class StringBuilderAppendSource extends Call {
  StringBuilderAppendSource() {
    this.getCallee().getName() = "append" and
    this.getCallee().getDeclaringType().hasQualifiedName("java.lang", "StringBuilder")
  }
}

class JdbcSink extends Call {
  JdbcSink() {
    exists(Method m | 
      m = this.getCallee() and
      m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      (m.hasName("queryForObject") or 
       m.hasName("queryForList") or 
       m.hasName("update") or 
       m.hasName("execute") or 
       m.hasName("insert"))
    )
  }
}

class ParameterizedQuerySanitizer extends Call {
  ParameterizedQuerySanitizer() {
    exists(Method m |
      m = this.getCallee() and
      m.getDeclaringType().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate") and
      m.hasName("queryForObject") and
      this.getArgument(0).toString().matches("%\\?%")
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "JdbcStringFormatConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(StringFormatSource sfs | source.asExpr() = sfs.getArgument(0)) or
    exists(StringConcatSource scs | source.asExpr() = scs.getAnArgument()) or
    exists(StringBuilderAppendSource sbas | source.asExpr() = sbas.getAnArgument())
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(JdbcSink js | sink.asExpr() = js.getArgument(0))
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(ParameterizedQuerySanitizer pqs | sanitizer.asExpr() = pqs.getArgument(0))
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Possible JDBC injection detected. Use parameterized queries instead of string concatenation."
