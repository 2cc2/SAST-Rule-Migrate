/**
 * @name JSP Scriptlet Detection
 * @description Detects JSP scriptlets which are considered bad practice due to security risks.
 * @kind problem
 * @severity warning
 * @id no-scriptlets
 * @tags security
 *       owasp:a3
 *       cwe:116
 */
import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

predicate isJspFile(File f) {
  f.getBaseName().matches("%.jsp")
}

predicate isJspScriptlet(Expr e) {
  exists(File f |
    isJspFile(f) and
    e.getLocation().getFile() = f and
    e.getLocation().toString().regexpMatches("<%[^@].*")
  )
}

class JspScriptlet extends Expr {
  JspScriptlet() {
    isJspScriptlet(this)
  }
}

class JspWriterPrint extends Method {
  JspWriterPrint() {
    this.getDeclaringType().getQualifiedName() = "javax.servlet.jsp.JspWriter" and
    (this.getName() = "print" or this.getName() = "println")
  }
}

class Sink extends Expr {
  Sink() {
    exists(MethodAccess ma |
      ma.getMethod() instanceof JspWriterPrint and
      this = ma
    )
  }
}

from DataFlow::Node sourceNode, DataFlow::Node sinkNode
where
  exists(JspScriptlet js | sourceNode.asExpr() = js) and
  sinkNode.asExpr() instanceof Sink and
  TaintTracking::localTaint(sourceNode, sinkNode)
select sinkNode, "JSP scriptlet detected. Scriptlets should be avoided due to security risks."
