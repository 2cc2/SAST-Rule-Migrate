/**
 * @name JSP Scriptlet Detection
 * @description Detects JSP scriptlets which are considered bad practice due to security risks.
 * @kind problem
 * @problem.severity warning
 * @id java/no-scriptlets
 * @tags security
 *       owasp:a3
 *       cwe:116
 */
import java
import Regexp
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

predicate isJspFile(File f) {
  f.getExtension() = "jsp"
}

predicate isJspScriptlet(Expr e) {
  exists(File f |
    isJspFile(f) and
    e.getFile() = f and
    e.toString().regexpMatches("<%[^@].*")
  )
}

class JspScriptlet extends Expr {
  JspScriptlet() {
    isJspScriptlet(this)
  }
}

class JspWriterCall extends Expr {
  JspWriterCall() {
    exists(Method m, MethodAccess ma |
      m = ma.getMethod() and
      m.getDeclaringType().getQualifiedName() = "javax.servlet.jsp.JspWriter" and
      (m.getName() = "print" or m.getName() = "println") and
      ma = this
    )
  }
}

from DataFlow::Node sourceNode, DataFlow::Node sinkNode
where
  exists(JspScriptlet js | sourceNode.asExpr() = js) and
  sinkNode.asExpr() instanceof JspWriterCall and
  TaintTracking::localTaint(sourceNode, sinkNode)
select sinkNode, "JSP scriptlet detected. Scriptlets should be avoided due to security risks."
