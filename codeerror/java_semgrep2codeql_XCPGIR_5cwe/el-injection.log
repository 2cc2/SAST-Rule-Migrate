Rule Content:
/**
 * @name EL Injection
 * @description An expression is built with a dynamic value. The source of the value(s) should be verified 
 *              to avoid that unfiltered values fall into this risky code evaluation.
 * @kind problem
 * @problem.severity warning
 * @id java/el-injection
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.el.ExpressionFactory

private class DynamicInput extends DataFlow::Node {
  DynamicInput() {
    exists(MethodParameter p | this.asParameter() = p) or
    exists(LocalVariableDecl lvd | this.asLocalVar() = lvd.getAVariable())
  }
}

private class ExpressionFactorySink extends DataFlow::Node {
  ExpressionFactorySink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "createValueExpression" and
       ma.getMethod().getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
       this.asExpr() = ma.getArgument(1))
      or
      (ma.getMethod().getName() = "createMethodExpression" and
       ma.getMethod().getDeclaringType().hasQualifiedName("javax.el", "ExpressionFactory") and
       this.asExpr() = ma.getArgument(1))
      or
      (ma.getMethod().getName() = "buildConstraintViolationWithTemplate" and
       this.asExpr() = ma.getArgument(0))
    )
  }
}

private class Sanitizer extends DataFlow::Node {
  Sanitizer() {
    this.asExpr() instanceof StringLiteral
  }
}

private class ElInjectionFlowConfiguration extends TaintTracking::Configuration {
  ElInjectionFlowConfiguration() { this = "ElInjectionFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicInput and
    not exists(StringLiteral sl | sl = source.asExpr())
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExpressionFactorySink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof Sanitizer
  }
}

from DataFlow::Node source, DataFlow::Node sink, ElInjectionFlowConfiguration conf
where conf.hasFlow(source, sink)
select sink, "Potential EL injection detected from $@", source, source.toString()
