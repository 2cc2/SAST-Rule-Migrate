Rule Content:
/**
 * @name Tainted file path
 * @id tainted-file-path
 * @description Detected user input controlling a file path. An attacker could control the location of this file, 
 * to include going backwards in the directory with '../'. To address this, ensure that user-controlled variables 
 * in file paths are sanitized.
 * @kind path-problem
 * @problem.severity error
 * @tags security
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringAnnotations

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Method m, Parameter p |
      p = m.getAParameter() and
      p = this.asParameter() and
      not p.getType() instanceof PrimitiveType and
      (
        exists(SpringAnnotations::RequestBody ann | ann.getAParameter() = p) or
        exists(SpringAnnotations::PathVariable ann | ann.getAParameter() = p) or
        exists(SpringAnnotations::RequestParam ann | ann.getAParameter() = p) or
        exists(SpringAnnotations::RequestHeader ann | ann.getAParameter() = p) or
        exists(SpringAnnotations::CookieValue ann | ann.getAParameter() = p) or
        exists(SpringAnnotations::ModelAttribute ann | ann.getAParameter() = p)
      )
    )
  }
}

class FileOperationSink extends DataFlow::Node {
  FileOperationSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "File") and
       ma.getMethod().getName() = "<init>" and
       this.asExpr() = ma.getArgument(0)) or
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.io", "FileInputStream") and
       ma.getMethod().getName() = "<init>" and
       this.asExpr() = ma.getArgument(0)) or
      (ma.getMethod().getDeclaringType().hasQualifiedName("java.nio.file", "Paths") and
       ma.getMethod().getName() = "get" and
       this.asExpr() = ma.getArgument(0))
    )
  }
}

class FilenameUtilsSanitizer extends DataFlow::Node {
  FilenameUtilsSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
      ma.getMethod().getName() = "getName" and
      this.asExpr() = ma
    )
  }
}

class TaintedFilePathConfig extends TaintTracking::Configuration {
  TaintedFilePathConfig() { this = "TaintedFilePathConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof FileOperationSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FilenameUtilsSanitizer
  }
}

from TaintedFilePathConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
