Rule Content:
/**
 * @name ServletResponse writer XSS
 * @description Detects cross-site scripting vulnerabilities where user input from HttpServletRequest
 *              flows directly into HttpServletResponse writer without proper encoding.
 * @kind path-problem
 * @problem.severity error
 * @id java/servletresponse-writer-xss
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.security.XSS
import semmle.code.java.frameworks.Servlets
import DataFlow::PathGraph

class ServletResponseWriteSink extends DataFlow::Node {
  ServletResponseWriteSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "write" and
      ma.getQualifier().getType().hasQualifiedName("javax.servlet", "ServletPrintWriter") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class NoEncodingFlowConfiguration extends TaintTracking::Configuration {
  NoEncodingFlowConfiguration() { this = "NoEncodingFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RemoteFlowSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ServletResponseWriteSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.owasp.encoder", "Encode", "forHtml") and
      sanitizer.asExpr() = ma.getQualifier()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, NoEncodingFlowConfiguration conf
where conf.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Cross-site scripting vulnerability detected. User input flows directly " +
  "from HttpServletRequest into HttpServletResponse writer without encoding. " +
  "Ensure your data is properly encoded using org.owasp.encoder.Encode.forHtml."
