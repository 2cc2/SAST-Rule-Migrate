/**
 * @name ServletResponse writer XSS
 * @description Detects cross-site scripting vulnerabilities where user input from HttpServletRequest
 *              flows directly into HttpServletResponse writer without proper encoding.
 * @kind path-problem
 * @problem.severity error
 * @id java/servletresponse-writer-xss
 * @tags security
 *       external/cwe/cwe-079
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets
import semmle.code.java.Expr

class ServletRequestSource extends DataFlow::Node {
  ServletRequestSource() {
    exists(Expr::MethodAccess ma |
      ma.getMethod().getName() = "getParameter" and
      ma.getQualifier().getType().hasQualifiedName("javax.servlet", "ServletRequest") and
      this.asExpr() = ma
    )
  }
}

class ServletResponseSink extends DataFlow::Node {
  ServletResponseSink() {
    exists(Expr::MethodAccess getWriter, Expr::MethodAccess write |
      getWriter.getMethod().getName() = "getWriter" and
      getWriter.getQualifier().getType().hasQualifiedName("javax.servlet", "ServletResponse") and
      write.getMethod().getName() = "write" and
      write.getQualifier() = getWriter and
      this.asExpr() = write.getArgument(0)
    )
  }
}

class XSSConfiguration extends TaintTracking::Configuration {
  XSSConfiguration() { this = "XSSConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ServletResponseSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Expr::MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.owasp.encoder", "Encode", "forHtml") and
      sanitizer.asExpr() = ma.getArgument(0)
    )
  }
}

