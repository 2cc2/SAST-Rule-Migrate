Rule Content:
/**
 * @name Tainted System Command
 * @description Detected user input entering a method which executes a system command.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.8
 * @precision high
 * @id java/tainted-system-command
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.spring.SpringAnnotations

class UserInputSource extends DataFlow::Expr {
  UserInputSource() {
    exists(Method m, Parameter p |
      p = m.getAParameter() and
      p.getType().hasName("String") and
      (
        m.getAnAnnotation() instanceof SpringRequestBodyAnnotation or
        m.getAnAnnotation() instanceof SpringPathVariableAnnotation or
        m.getAnAnnotation() instanceof SpringRequestParamAnnotation or
        m.getAnAnnotation() instanceof SpringRequestHeaderAnnotation or
        m.getAnAnnotation() instanceof SpringCookieValueAnnotation or
        m.getAnAnnotation() instanceof SpringModelAttributeAnnotation
      ) and
      this = p.getAnAccess()
    )
  }
}

class StringConcatOperation extends DataFlow::Node {
  StringConcatOperation() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["append", "concat", "format", "join"] and
      this.asExpr() = ma
    )
  }
}

class CommandExecutionSink extends DataFlow::Node {
  CommandExecutionSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName() = "exec" and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Runtime")
      ) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class ProcessBuilderSink extends DataFlow::Node {
  ProcessBuilderSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName() = "command" and
        ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder")
      ) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class Configuration extends TaintTracking::Configuration {
  Configuration() { this = "TaintedSystemCommand" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CommandExecutionSink or sink instanceof ProcessBuilderSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    node1 instanceof StringConcatOperation and node2 = node1.getAMethodCallArgument()
  }
}

from Configuration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User input reaches system command execution point"
