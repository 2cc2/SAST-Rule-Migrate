Rule Content:
/**
 * @name Tainted System Command
 * @description Detected user input entering a method which executes a system command.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 9.8
 * @precision high
 * @id java/tainted-system-command
 * @tags security
 *       external/cwe/cwe-078
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

/** Sources - Spring controller annotated parameters */
class SpringInputSource extends DataFlow::Node {
  SpringInputSource() {
    exists(Method m, Parameter p |
      p = m.getAParameter() and
      p.getType().hasName("String") and
      exists(Annotation a |
        a = m.getAnAnnotation() and
        (
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestBody") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestParam") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "RequestHeader") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "CookieValue") or
          a.getType().hasQualifiedName("org.springframework.web.bind.annotation", "ModelAttribute")
        )
      ) and
      this.asParameter() = p
    )
  }
}

/** String concatenation operations */
class ConcatOperation extends DataFlow::Node {
  ConcatOperation() {
    exists(Call call |
      call.getCallee().getName() in ["append", "concat", "format", "join"] and
      this.asExpr() = call
    )
  }
}

/** Sink - Runtime.exec() */
class RuntimeExecSink extends DataFlow::Node {
  RuntimeExecSink() {
    exists(Call call |
      call.getCallee().getName() = "exec" and
      call.getCallee().getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

/** Sink - ProcessBuilder.command() */
class ProcessBuilderSink extends DataFlow::Node {
  ProcessBuilderSink() {
    exists(Call call |
      call.getCallee().getName() = "command" and
      call.getCallee().getDeclaringType().hasQualifiedName("java.lang", "ProcessBuilder") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

/** Taint tracking configuration */
class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "TaintedSystemCommand" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SpringInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof RuntimeExecSink or sink instanceof ProcessBuilderSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    node1 instanceof ConcatOperation and
    node2.asExpr() = node1.asExpr().(Call).getAnArgument()
  }
}

from TaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User input '$@' reaches system command execution point",
  source.getNode(), "user input", sink.getNode(), "command execution"
