import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Hibernate
import semmle.code.java.Callable

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(Call call |
      (call.getCallee().hasName("concat") and 
       call.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String")) or
      (call.getCallee().hasName("format") and 
       call.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String")) |
      this.asExpr() = call
    )
  }
}

class DynamicSqlSource extends DataFlow::Node {
  DynamicSqlSource() {
    exists(AddExpr add | this.asExpr() = add)
    or
    exists(LocalVariableDecl lvd, AddExpr add |
      lvd.getInitializer() = add |
      this.asExpr() = lvd.getVariable().getAnAccess()
    )
  }
}

class SqlRestrictionSink extends DataFlow::Node {
  SqlRestrictionSink() {
    exists(Method m, Call call |
      m.hasName("sqlRestriction") and
      m.getDeclaringType().hasQualifiedName("org.hibernate.criterion", "Restrictions") and
      call.getCallee() = m |
      this.asExpr() = call.getArgument(0)
    )
  }
}

class SessionQuerySink extends DataFlow::Node {
  SessionQuerySink() {
    exists(Method m, Call call |
      (m.hasName("createQuery") or m.hasName("createSQLQuery")) and
      call.getCallee() = m and
      (call.getQualifier().getType().hasQualifiedName("org.hibernate", "Session") or
       call.getQualifier().getType().hasQualifiedName("org.hibernate", "StatelessSession")) |
      this.asExpr() = call.getArgument(0)
    )
  }
}

class HibernateSqliConfig extends TaintTracking::Configuration {
  HibernateSqliConfig() {
    this = "Hibernate SQL Injection Configuration"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof DynamicSqlSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlRestrictionSink or
    sink instanceof SessionQuerySink
  }
}

