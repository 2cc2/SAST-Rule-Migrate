Rule Content:
/**
 * @name Hibernate SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @id java/hibernate-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Hibernate
import DataFlow::PathGraph

class StringConcatSource extends TaintTracking::Source {
  StringConcatSource() {
    exists(Method m | 
      (m.hasName("concat") or m.hasName("format")) and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = m.getACall().getArgument(0)
    )
  }
}

class DynamicSqlSource extends TaintTracking::Source {
  DynamicSqlSource() {
    exists(Expr add, Variable v |
      add instanceof AddExpr and
      v.getAnAssignedValue() = add and
      this.asExpr() = v.getAnAccess()
    )
  }
}

class SqlRestrictionSink extends TaintTracking::Sink {
  SqlRestrictionSink() {
    exists(Method m | 
      m.hasName("sqlRestriction") and
      m.getDeclaringType().hasQualifiedName("org.hibernate.criterion", "Restrictions") and
      this.asExpr() = m.getACall().getArgument(0)
    )
  }
}

class SessionQuerySink extends TaintTracking::Sink {
  SessionQuerySink() {
    exists(Method m, Call c |
      (m.hasName("createQuery") or m.hasName("createSQLQuery")) and
      (c.getQualifier().getType().hasQualifiedName("org.hibernate", "Session") or
       c.getQualifier().getType().hasQualifiedName("org.hibernate", "StatelessSession")) and
      this.asExpr() = c.getArgument(0)
    )
  }
}

class HibernateSqliConfig extends TaintTracking::Configuration {
  HibernateSqliConfig() { this = "Hibernate SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringConcatSource or
    source instanceof DynamicSqlSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlRestrictionSink or
    sink instanceof SessionQuerySink
  }
}

from HibernateSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Potential SQL injection vulnerability due to unsafe string concatenation in Hibernate query"
