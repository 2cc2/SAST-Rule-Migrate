/**
 * @name JPA SQL Injection
 * @kind problem
 * @id java/jpa-sqli
 * @severity Warning
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized. Use a prepared
 *              statements (java.sql.PreparedStatement) instead.
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.Methods
import semmle.code.java.expressions.Assignments

class UnsafeSqlConstruction extends DataFlow::Node {
  UnsafeSqlConstruction() {
    exists(Call call |
      call.getCallee().hasName("format") and
      call.getCallee().getDeclaringType().getQualifiedName() = "java.lang.String" and
      call.getArgument(0) = this.asExpr()
    )
  }
}

class StringConcat extends DataFlow::Node {
  StringConcat() {
    exists(AssignExpr ae |
      ae.getLeft().toString().matches(".*SQL.*") and
      ae.getRight().toString().matches(".*\\+.*") and
      ae.getRight() = this.asExpr()
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(Call call |
      (
        call.getCallee().getName() = "createQuery" or
        call.getCallee().getName() = "createNativeQuery"
      ) and
      call.getCallee().getDeclaringType().getQualifiedName() = "javax.persistence.EntityManager" and
      call.getArgument(0) = this.asExpr()
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(Call call |
      call.getCallee().hasName("prepareStatement") and
      call.getCallee().getDeclaringType().getQualifiedName() = "java.sql.Connection" and
      this.asExpr() = call
    )
  }
}

class SafeStringLiterals extends DataFlow::Node {
  SafeStringLiterals() {
    exists(StringLiteral sl |
      sl.toString().matches("^'\\w+'$") and
      this.asExpr() = sl
    )
  }
}

class JpaSqlTaintConfig extends TaintTracking::Configuration {
  JpaSqlTaintConfig() { this = "JpaSqlInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeSqlConstruction or
    source instanceof StringConcat
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof SafeStringLiterals
  }

  override predicate isAdditionalTaintStep(DataFlow::Node src, DataFlow::Node dest) {
    TaintTracking::localTaintStep(src, dest)
  }
}

from JpaSqlTaintConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential JPA SQL injection vulnerability detected. $@",
  source, source.toString()
