Rule Content:
/**
 * @name JPA SQL Injection
 * @kind problem
 * @id java/jpa-sqli
 * @severity Warning
 * @description Detected a formatted string in a SQL statement. Could lead to SQL injection
 *              if variables are not properly sanitized. Use prepared statements instead.
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.jpa.JPA

class UnsafeSqlConstruction extends DataFlow::Node {
  UnsafeSqlConstruction() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().getQualifiedName() = "java.lang.String" and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class StringConcat extends DataFlow::Node {
  StringConcat() {
    exists(AssignmentExpr ae |
      ae.getLeft().toString().matches("%SQL%") and
      ae.getRight().toString().matches("%\\+%") and
      ae.getRight() = this.asExpr()
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      (
        ma.getMethod().getName() = "createQuery" or
        ma.getMethod().getName() = "createNativeQuery"
      ) and
      ma.getMethod().getDeclaringType().getQualifiedName() = "javax.persistence.EntityManager" and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("prepareStatement") and
      ma.getMethod().getDeclaringType().getQualifiedName() = "java.sql.Connection" and
      this.asExpr() = ma
    )
  }
}

class JpaSqlInjectionConfiguration extends TaintTracking::Configuration {
  JpaSqlInjectionConfiguration() { this = "JpaSqlInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UnsafeSqlConstruction or
    source instanceof StringConcat
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node src, DataFlow::Node dest) {
    TaintTracking::localTaintStep(src, dest)
  }
}

from JpaSqlInjectionConfiguration cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential SQL injection vulnerability in JPA query", source,
  "SQL query constructed from $@ which may contain user input", source, "user input"
