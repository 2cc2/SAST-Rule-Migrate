    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ScriptEngineEvalCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal sl | sanitizer.asExpr() = sl and sl.getType().hasName("java.lang.String"))
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from DataFlow::Node source, DataFlow::Node sink, ScriptEngineTaintConfig config
where config.hasFlow(source, sink)
select sink, "User input reaches ScriptEngine.eval() without sanitization", source,
  "Potential code injection via $@.", source, "user input"
================================================================================
