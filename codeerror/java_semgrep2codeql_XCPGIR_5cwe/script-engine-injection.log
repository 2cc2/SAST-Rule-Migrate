Rule Content:
/**
 * @name Script Engine Code Injection
 * @kind problem
 * @problem.severity warning
 * @id java/script-engine-injection
 * @description Detected potential code injection using ScriptEngine. Ensure user-controlled
 *              data cannot enter '.eval()', otherwise, this is a code injection vulnerability.
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.ScriptEngine

class ScriptEngineEvalCall extends MethodAccess {
  ScriptEngineEvalCall() {
    exists(Method m |
      m.hasName("eval") and
      m.getDeclaringType().getASourceSupertype*().hasQualifiedName("javax.script", "ScriptEngine") and
      this.getMethod() = m
    )
  }
}

class UserInputTaintSource extends TaintTracking::Source {
  UserInputTaintSource() {
    exists(Parameter p | p = this.asParameter() and p.getName() != "")
  }
}

class ScriptEngineConfig extends TaintTracking::Configuration {
  ScriptEngineConfig() { this = "ScriptEngineEvalTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputTaintSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ScriptEngineEvalCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sanitizer.asExpr() = sl)
  }
}

from DataFlow::Node source, DataFlow::Node sink, ScriptEngineConfig config
where config.hasFlow(source, sink)
select sink, "User input reaches ScriptEngine.eval() without sanitization", source,
  "Potential code injection via $@.", source, "user input"
