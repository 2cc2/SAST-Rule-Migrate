/**
 * @name Script Engine Code Injection
 * @kind problem
 * @problem.severity warning
 * @id java/script-engine-injection
 * @description Detected potential code injection using ScriptEngine. Ensure user-controlled
 *              data cannot enter '.eval()', otherwise, this is a code injection vulnerability.
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ScriptEngineEvalCall extends Call {
  ScriptEngineEvalCall() {
    exists(Method m |
      m.hasName("eval") and
      m.getDeclaringType().getASourceSupertype*().hasQualifiedName("javax.script", "ScriptEngine") and
      this.getCallee() = m and
      this.getNumArgument() > 0
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() { 
    exists(Parameter p | this.asParameter() = p and p.getName() != "")
  }
}

class ScriptEngineTaintConfig extends TaintTracking::Configuration {
  ScriptEngineTaintConfig() { this = "ScriptEngineEvalTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ScriptEngineEvalCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal sl | sanitizer.asExpr() = sl and sl.getType().hasName("java.lang.String"))
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2) or
    TaintTracking::parameterToArgument(node1, node2)
  }
}

