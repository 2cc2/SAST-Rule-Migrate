/**
 * @name Script Engine Code Injection
 * @kind problem
 * @problem.severity warning
 * @id java/script-engine-injection
 * @description Detected potential code injection using ScriptEngine. Ensure user-controlled
 *              data cannot enter '.eval()', otherwise, this is a code injection vulnerability.
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class ScriptEngineEvalCall extends Call {
  ScriptEngineEvalCall() {
    exists(Method m |
      m.hasName("eval") and
      m.getDeclaringType().getASourceSupertype*().hasQualifiedName("javax.script", "ScriptEngine") and
      this.getCallee() = m
    )
  }
}

class UserInputSource extends RemoteFlowSource::Range {
  UserInputSource() { this instanceof Parameter }
}

class ScriptEngineTaintConfig extends TaintTracking::Configuration {
  ScriptEngineTaintConfig() { this = "ScriptEngineEvalTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ScriptEngineEvalCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteralExpr sl | sanitizer.asExpr() = sl)
  }
}

