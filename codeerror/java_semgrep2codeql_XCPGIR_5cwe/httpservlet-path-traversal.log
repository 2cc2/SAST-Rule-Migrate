Rule Content:
/**
 * @name Potential Path Traversal Vulnerability
 * @description Detects cases where user-controlled input flows into file operations without proper sanitization,
 *              which could lead to path traversal vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id java/path-traversal-servlet
 * @tags security
 *       external/cwe/cwe-22
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletRequestParameter extends RemoteFlowSource {
  ServletRequestParameter() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getParameter") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")
    )
  }
}

class CookieValueSource extends RemoteFlowSource {
  CookieValueSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getValue") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
    )
  }
}

class FileOperationSink extends DataFlow::Node {
  FileOperationSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.io", "File") and
      this.asExpr() = cc.getArgument(0)
    ) or
    exists(ConstructorCall cc |
      (cc.getConstructedType().hasQualifiedName("java.io", "FileInputStream") or
       cc.getConstructedType().hasQualifiedName("java.io", "FileOutputStream")) and
      this.asExpr() = cc.getArgument(0)
    )
  }
}

class FilenameUtilsSanitizer extends DataFlow::Node {
  FilenameUtilsSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getName") and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
      this.asExpr() = ma
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestParameter or
    source instanceof CookieValueSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOperationSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FilenameUtilsSanitizer
  }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Potential path traversal vulnerability detected. User-controlled data flows into file operation without proper sanitization."
