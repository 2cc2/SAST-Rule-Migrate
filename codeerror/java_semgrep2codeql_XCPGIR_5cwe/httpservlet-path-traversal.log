 * @description Detects cases where user-controlled input from servlet parameters or cookies
 *              flows into file operations without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @id java/servlet-path-traversal
 * @tags security
 *       external/cwe/cwe-22
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class ServletRequestSource extends DataFlow::Node {
  ServletRequestSource() {
    exists(Method m | 
      m.hasName("getParameter") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
  }
}

class CookieValueSource extends DataFlow::Node {
  CookieValueSource() {
    exists(Method m | 
      m.hasName("getValue") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
  }
}

class FileOperationSink extends DataFlow::Node {
  FileOperationSink() {
    exists(Constructor c |
      (c.getDeclaringType().hasQualifiedName("java.io", "File") or
       c.getDeclaringType().hasQualifiedName("java.io", "FileInputStream") or
       c.getDeclaringType().hasQualifiedName("java.io", "FileOutputStream")) and
      this.asExpr() = any(ConstructorCall cc | cc.getConstructor() = c).getArgument(0)
    )
  }
}

class FilenameUtilsSanitizer extends DataFlow::Node {
  FilenameUtilsSanitizer() {
    exists(Method m |
      m.hasName("getName") and
      m.getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestSource or
    source instanceof CookieValueSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOperationSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FilenameUtilsSanitizer
  }
}

