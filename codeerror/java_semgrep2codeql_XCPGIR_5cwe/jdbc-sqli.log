 * @kind path-problem
 * @id java/jdbc-sqli
 * @severity Warning
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringOps
import semmle.code.java.dataflow.FlowSources
import DataFlow::PathGraph

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(Method m, MethodAccess ma |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      ma.getMethod() = m and
      this.asExpr() = ma
    )
  }
}

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(BinaryExpr be |
      be.getOp() instanceof BinaryAdd and
      this.asExpr() = be and
      not isSafeStringConcat(be)
    )
  }
}

predicate isSafeStringConcat(BinaryExpr be) {
  exists(StringLiteral l1, StringLiteral l2 |
    be.getLeftOperand() = l1 and
    be.getRightOperand() = l2
  )
}

class SQLExecutionSink extends DataFlow::Node {
  SQLExecutionSink() {
    exists(Method m, MethodAccess ma |
      m.getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      m.getName().matches("execute%") and
      m.getName().matches("addBatch|nativeSQL") and
      ma.getMethod() = m and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class JDBCTaintConfig extends TaintTracking::Configuration {
  JDBCTaintConfig() { this = "JDBC SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLExecutionSink
  }
}

