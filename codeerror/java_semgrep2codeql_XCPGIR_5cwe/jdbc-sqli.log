Rule Content:
/**
 * @name JDBC SQL Injection
 * @kind problem
 * @id java/jdbc-sqli
 * @severity Warning
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class StringFormatSQLSource extends DataFlow::Node {
  StringFormatSQLSource() { 
    exists(MethodAccess ma | 
      ma.getMethod().getName() = "format" and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma
    )
  }
}

class StringConcatSQLSource extends DataFlow::Node {
  StringConcatSQLSource() { 
    exists(AssignExpr ae |
      exists(BinaryExpr be | 
        be.getOp() instanceof Add and
        this.asExpr() = ae.getRValue() and
        be = ae.getRValue()
      )
    )
  }
}

class SQLExecutionSink extends DataFlow::Node {
  SQLExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      ma.getMethod().getName().matches("%execute%") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

predicate isSafeStringConcat(Expr e) {
  exists(StringLiteral l1, StringLiteral l2 |
    e = l1 + l2
  )
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "JDBC_SQL_Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSQLSource or
    source instanceof StringConcatSQLSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLExecutionSink and
    not isSafeStringConcat(sink.asExpr())
  }
}

from TaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected a formatted string in a SQL statement. This could lead to SQL injection " +
  "if variables in the SQL statement are not properly sanitized. Use " +
  "prepared statements (java.sql.PreparedStatement) instead."
