Rule Content:
/**
 * @name JDBC SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection 
 *              if variables in the SQL statement are not properly sanitized. Use prepared 
 *              statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @id java/jdbc-sqli
 * @severity Warning
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.JDBC
import DataFlow::PathGraph

class StringFormatSource extends DataFlow::Node {
  StringFormatSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("format") and
      ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      this.asExpr() = ma
    )
  }
}

class StringConcatSource extends DataFlow::Node {
  StringConcatSource() {
    exists(Expr e |
      e instanceof BinaryExpr and
      e.getOp() instanceof Add and
      this.asExpr() = e and
      not isSafeStringConcat(e)
    )
  }
}

predicate isSafeStringConcat(Expr e) {
  exists(StringLiteral l1, StringLiteral l2 |
    e = l1.(BinaryAddExpr).getLeftOperand() and
    e = l2.(BinaryAddExpr).getRightOperand()
  )
}

class SQLExecutionSink extends DataFlow::Node {
  SQLExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      ma.getMethod().getName().matches("execute%") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class JDBCTaintConfig extends TaintTracking::Configuration {
  JDBCTaintConfig() { this = "JDBC SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatSource or
    source instanceof StringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLExecutionSink
  }
}

