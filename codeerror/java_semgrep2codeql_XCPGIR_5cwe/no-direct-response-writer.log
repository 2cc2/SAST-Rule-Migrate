/**
 * @name NoDirectResponseWriter
 * @description Detected a request with potential user-input going into a OutputStream or Writer object.
 * @kind path-problem
 * @problem.severity warning
 * @id java/no-direct-response-writer
 * @tags security
 *       xss
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

class ServletRequestSource extends RemoteFlowSource {
  ServletRequestSource() {
    this.asParameter() = any() and
    exists(Method m | 
      m.hasName(["getInputStream","getParameter","getParameterMap","getParameterValues",
                "getReader","getCookies","getHeader","getHeaderNames","getHeaders",
                "getPart","getParts","getQueryString"]) and
      m.getDeclaringType().hasQualifiedName("javax.servlet", "ServletRequest") and
      this.asParameter() = m.getACall().getArgument(0)
    )
  }

  override string getSourceType() { result = "Servlet request input" }
}

class ResponseWriterSink extends DataFlow::Node {
  ResponseWriterSink() {
    exists(Method m |
      m.getName().matches("write.*") and
      (
        m.getDeclaringType().hasQualifiedName("java.io", "PrintWriter") or
        m.getDeclaringType().hasQualifiedName("javax.servlet", "ServletOutputStream") or
        m.getDeclaringType().hasQualifiedName("java.io", "OutputStream"))
      and this.asExpr() = m.getACall().getArgument(0)
    )
  }
}

class HtmlSanitizer extends DataFlow::Node {
  HtmlSanitizer() {
    exists(Method m |
      m.hasName(["escapeHtml", "htmlEscape", "encodeForHTML"]) and
      (
        m.getDeclaringType().hasQualifiedName("org.apache.commons.lang", "StringEscapeUtils") or
        m.getDeclaringType().hasQualifiedName("org.springframework.web.util", "HtmlUtils") or
        m.getDeclaringType().hasQualifiedName("org.owasp.esapi", "ESAPI") and
        m.getName() = "encodeForHTML"
      )
      and this.asExpr() = m.getACall()
    )
  }
}

class NoDirectResponseWriterConfig extends TaintTracking::Configuration {
  NoDirectResponseWriterConfig() { this = "NoDirectResponseWriterConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ResponseWriterSink and
    not exists(HtmlSanitizer hs | hs.taints(sink))
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof HtmlSanitizer
  }
}

from NoDirectResponseWriterConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential XSS vulnerability detected: user input directly written to response",
  source, sink, "User input flows to response writer without sanitization"
