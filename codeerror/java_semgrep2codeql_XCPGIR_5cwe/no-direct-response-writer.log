xcpgir_version: "1.0"
rule:
  id: "no-direct-response-writer"
  kind: taint
  severity: WARNING
  message: "Detected a request with potential user-input going into a OutputStream or Writer object. This bypasses any view or template environments, including HTML escaping, which may expose this application to cross-site scripting (XSS) vulnerabilities."
scope:
  languages: [java]
  frameworks: ["servlets"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: SERVLET_REQUEST
    match:
      node: CALL
      api: 
        type: "javax.servlet.ServletRequest"
      where:
        - op: in
          left: method
          right: ["getInputStream","getParameter","getParameterMap","getParameterValues","getReader","getCookies","getHeader","getHeaderNames","getHeaders","getPart","getParts","getQueryString"]

sinks:
  - id: RESPONSE_WRITER
    match:
      node: CALL
      type:
        name: ["java.io.PrintWriter", "javax.servlet.ServletOutputStream", "java.io.OutputStream"]
      where:
        - op: regex
          left: method
          right: "write.*"

sanitizers:
  - id: HTML_ESCAPE
    match:
      node: CALL
      api:
        type: ["org.apache.commons.lang.StringEscapeUtils", "org.springframework.web.util.HtmlUtils", "org.owasp.esapi.ESAPI.encoder"]
        method: ["escapeHtml", "htmlEscape", "encodeForHTML"]
    effect: neutralize
    scope: { sinks: [RESPONSE_WRITER] }

barriers:
  - id: RETURN_STOP
    match: { node: RETURN }
    effect: stop

propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint

flows:
  - source: SERVLET_REQUEST
    sink: RESPONSE_WRITER
    through: [ARG_TO_PARAM*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(org.apache.commons.lang.StringEscapeUtils.escapeHtml)" } ]

report:
  message: "Potential XSS vulnerability detected: user input directly written to response"
  locations: ["source","sink","path"]
  evidence: { capture: [{ argument: 0 }] }
