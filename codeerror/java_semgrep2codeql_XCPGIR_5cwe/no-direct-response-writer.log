/**
 * @name NoDirectResponseWriter
 * @description Detected a request with potential user-input going into a OutputStream or Writer object.
 * @kind path-problem
 * @problem.severity warning
 * @id java/no-direct-response-writer
 * @tags security
 *       xss
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class ServletRequestSource extends RemoteFlowSource {
  ServletRequestSource() {
    exists(MethodAccess ma |
      exists(Method m | 
        m = ma.getMethod() and
        m.hasName([
          "getInputStream", "getParameter", "getParameterMap", "getParameterValues",
          "getReader", "getCookies", "getHeader", "getHeaderNames", "getHeaders",
          "getPart", "getParts", "getQueryString"
        ]) and
        m.getDeclaringType().hasQualifiedName("javax.servlet", "ServletRequest")
      ) and
      this.asExpr() = ma.getArgument(0)
    )
  }

  override string getSourceType() { result = "Servlet request input" }
}

class ResponseWriterSink extends DataFlow::Node {
  ResponseWriterSink() {
    exists(MethodAccess ma |
      exists(Method m |
        m = ma.getMethod() and
        m.getName().matches("write.*") and
        (
          m.getDeclaringType().hasQualifiedName("java.io", "PrintWriter") or
          m.getDeclaringType().hasQualifiedName("javax.servlet", "ServletOutputStream") or
          m.getDeclaringType().hasQualifiedName("java.io", "OutputStream")
        )
      ) and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class HtmlSanitizer extends DataFlow::Node {
  HtmlSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["escapeHtml", "htmlEscape", "encodeForHTML"]) and
      (
        ma.getQualifier().getType().hasQualifiedName("org.apache.commons.lang", "StringEscapeUtils") or
        ma.getQualifier().getType().hasQualifiedName("org.springframework.web.util", "HtmlUtils") or
        (ma.getQualifier().getType().hasQualifiedName("org.owasp.esapi", "ESAPI") and
         ma.getMethod().getName() = "encodeForHTML")
      )
    )
  }
}

class NoDirectResponseWriterConfig extends TaintTracking::Configuration {
  NoDirectResponseWriterConfig() { this = "NoDirectResponseWriterConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ServletRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ResponseWriterSink and
    not exists(DataFlow::Node sanitized | 
      sanitized instanceof HtmlSanitizer and
      sanitized.flowsTo(sink, _)
    )
  }
}

from NoDirectResponseWriterConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(),
  "Potential XSS vulnerability detected: user input directly written to response",
  source.getNode(), sink.getNode(), "User input flows to response writer without sanitization"
