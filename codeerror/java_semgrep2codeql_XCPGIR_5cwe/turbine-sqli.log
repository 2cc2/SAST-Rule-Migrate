    - "BasePeer.executeQuery(\"SELECT * FROM users WHERE id = \" + userId);"
    - "BasePeer.executeQuery(String.format(\"SELECT * FROM users WHERE id = %s\", userId));"
  negative:
    - "BasePeer.executeQuery(\"SELECT * FROM users\");"
