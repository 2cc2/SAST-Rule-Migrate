Rule Content:
/**
 * @name Turbine SQL Injection
 * @description Detects formatted strings in SQL statements that could lead to SQL injection.
 * @id turbine-sqli
 * @kind path-problem
 * @severity Warning
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class TurbineSqliConfig extends TaintTracking::Configuration {
  TurbineSqliConfig() { this = "TurbineSqliConfig" }

  override predicate isSource(DataFlow::Node source) {
    // String.format() calls with SQL pattern
    exists(Call formatCall |
      formatCall.getCallee().getName() = "format" and
      formatCall.getCallee().getDeclaringType().getName() = "String" and
      exists(formatCall.getArgument(0) |
        source.asExpr() = formatCall.getArgument(0) and
        not source.getStringValue().regexpMatch("^\"SELECT\\s.+")
      )
    )
    or
    // String concatenation assignments with SQL pattern
    exists(AssignExpr assign, Expr lhs, Expr rhs |
      assign.getTarget() = lhs and
      assign.getSource() = rhs and
      lhs.toString().matches("%String\\s\\$SQL%") and
      source.asExpr() = rhs and
      not source.getStringValue().regexpMatch("^\"SELECT\\s.+")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "executeQuery" and
      ma.getMethod().getDeclaringType().getName() = "BasePeer" and
      ma.getMethod().getDeclaringType().getPackage().getName() = "com.liferay.portal.kernel.dao.orm" and
      sink.asExpr() = ma.getArgument(0)
    )
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral and
    sanitizer.getStringValue().regexpMatch("^\"SELECT\\s.+")
  }
}

from TurbineSqliConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Untrusted SQL query detected in $@", sink.getNode(),
  sink.getNode().toString()
