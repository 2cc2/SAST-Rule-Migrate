/**
 * @name Turbine SQL Injection
 * @description Detects formatted strings in SQL statements that could lead to SQL injection.
 * @id turbine-sqli
 * @kind path-problem
 * @severity Warning
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringOps
import semmle.code.java.frameworks.JSQL

class TurbineSqliConfig extends DataFlow::Configuration {
  TurbineSqliConfig() { this = "Turbine SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    // String.format() calls with SQL pattern
    exists(MethodAccess formatCall |
      formatCall.getMethod().getName() = "format" and
      formatCall.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String") and
      source.asExpr() = formatCall.getArgument(0) and
      not DataFlow::exprNode(formatCall.getArgument(0)).getStringValue().regexpMatch("^\"SELECT\\\\s.+")
    )
    or
    // String concatenation assignments with SQL pattern
    exists(AssignExpr assign |
      assign.getTarget().toString().matches("%String\\s\\$SQL%") and
      source.asExpr() = assign.getSource() and
      not DataFlow::exprNode(assign.getSource()).getStringValue().regexpMatch("^\"SELECT\\\\s.+")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "executeQuery" and
      ma.getMethod().getDeclaringType().hasQualifiedName("com.liferay.portal.kernel.dao.orm", "BasePeer") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl |
      sanitizer.asExpr() = sl and
      sanitizer.getStringValue().regexpMatch("^\"SELECT\\\\s.+")
    )
  }
}

from TurbineSqliConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Untrusted SQL query detected in $@", sink.toString(),
  "Potential SQL injection vulnerability due to use of unescaped user input in SQL query"
