Rule Content:
/**
 * @name Turbine SQL Injection
 * @description Detects formatted strings in SQL statements that could lead to SQL injection.
 * @id turbine-sqli
 * @kind path-problem
 * @severity Warning
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringExtensions

class TurbineSqliConfig extends TaintTracking::Configuration {
  TurbineSqliConfig() { this = "Turbine SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    // String.format() calls
    exists(Call formatCall |
      formatCall.getCallee().hasName("format") and
      formatCall.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String") and
      source.asExpr() = formatCall.getArgument(0) and
      not exists(StringLiteral sl | sl = source.asExpr() | 
        sl.getValue().matches("^SELECT\\s.+")
      )
    )
    or
    // String concatenation assignments
    exists(AssignExpr assign |
      exists(Variable v | assign.getTarget() = v.getAnAccess() |
        v.getName().matches("SQL") and
        v.getType().hasName("String")
      ) and
      source.asExpr() = assign.getSource() and
      not exists(StringLiteral sl | sl = source.asExpr() |
        sl.getValue().matches("^SELECT\\s.+")
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCallee().hasName("executeQuery") and
      call.getCallee().getDeclaringType().hasQualifiedName("com.liferay.portal.kernel.dao.orm", "BasePeer") and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral sl | sl = sanitizer.asExpr() |
      sl.getValue().matches("^SELECT\\s.+")
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TurbineSqliConfig config
where config.hasFlowPath(source, sink)
select sink, source, 
  "Potential SQL injection: Untrusted data flows into SQL query at $" + sink.toString() + "$",
  source, sink,
  "Consider using prepared statements instead of string concatenation"
