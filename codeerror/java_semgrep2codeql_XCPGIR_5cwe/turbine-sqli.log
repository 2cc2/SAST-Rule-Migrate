/**
 * @name Turbine SQL Injection
 * @description Detects formatted strings in SQL statements that could lead to SQL injection.
 * @id turbine-sqli
 * @kind path-problem
 * @severity Warning
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.StringFormatExtensions

class TurbineSqliConfig extends TaintTracking::Configuration {
  TurbineSqliConfig() { this = "Turbine SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    // String.format() calls
    exists(Call formatCall |
      formatCall.getCallee().getName() = "format" and
      formatCall.getCallee().getDeclaringType().hasQualifiedName("java.lang", "String") and
      source.asExpr() = formatCall.getArgument(0) and
      not source.asExpr().(StringLiteral).getValue().matches("^SELECT\\s.+")
    )
    or
    // String concatenation assignments
    exists(Assignment assign |
      assign.getLhs().toString().matches("String\\s\\$SQL") and
      source.asExpr() = assign.getRhs() and
      not source.asExpr().(StringLiteral).getValue().matches("^SELECT\\s.+")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getCallee().getName() = "executeQuery" and
      call.getCallee().getDeclaringType().hasQualifiedName("com.liferay.portal.kernel.dao.orm", "BasePeer") and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer.asExpr() instanceof StringLiteral and
    sanitizer.asExpr().(StringLiteral).getValue().matches("^SELECT\\s.+")
  }
}

from TurbineSqliConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Untrusted SQL query detected in " + sink.getNode().toString(),
  source.getNode(), "SQL injection vulnerability"
