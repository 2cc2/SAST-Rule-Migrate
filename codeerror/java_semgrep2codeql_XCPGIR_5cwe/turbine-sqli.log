scope:
  languages: [java]
  frameworks: [turbine]
  
sources:
  - id: SQL_STRING_FORMAT
    match:
      node: CALL
      api: { type: java.lang.String, method: format }
  - id: SQL_STRING_CONCAT
    match:
      node: ASSIGNMENT
      where:
        - op: regex
          left: value
          right: "String\\s\\$SQL\\s=\\s\\$X\\s\\+\\s\\$Y"

sinks:
  - id: SQL_EXECUTION
    match:
      node: CALL
      api: { type: com.liferay.portal.kernel.dao.orm.BasePeer, method: executeQuery }
      arg_index: 0
      
sanitizers:
  - id: STATIC_SQL
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "^\"SELECT\\s.+"

propagations:
  - id: SQL_ARG_TO_EXEC
    edge: arg->param
    kind: taint

flows:
  - source: SQL_STRING_FORMAT
    sink: SQL_EXECUTION
    through: [SQL_ARG_TO_EXEC*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(\"SELECT * FROM table\")" } ]
  - source: SQL_STRING_CONCAT
    sink: SQL_EXECUTION
    through: [SQL_ARG_TO_EXEC*]
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(\"SELECT * FROM table\")" } ]

report:
  message: "Untrusted SQL query detected in ${sink.methodFullName}"
  locations: ["source", "sink", "path"]
  evidence:
    capture:
      - { argument: 0 }

tests:
