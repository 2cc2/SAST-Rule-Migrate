    - "Runtime.getRuntime().loadLibrary(String.format(\"%s.so\", lib));"
  negative:
    - "Runtime.getRuntime().exec(\"/bin/ls\");"
    - "Runtime.getRuntime().loadLibrary(\"safe_lib\");"
