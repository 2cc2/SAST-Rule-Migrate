Rule Content:
/**
 * @name Command Injection Formatted Runtime Call
 * @description A formatted or concatenated string was detected as input to a java.lang.Runtime call.
 *              This is dangerous if a variable is controlled by user input and could result in command injection.
 * @kind path-problem
 * @severity Error
 * @id java/command-injection-formatted-runtime-call
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow

class RuntimeCall extends MethodAccess {
  RuntimeCall() {
    exists(Method m |
      (m.getName() = "exec" or m.getName() = "loadLibrary") and
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      this.getMethod() = m
    )
  }
}

class UserControlledInput extends TaintTracking::Source {
  UserControlledInput() {
    exists(Parameter p | this = DataFlow::parameterNode(p)) or
    exists(LocalVariableDecl v | this = DataFlow::localVarNode(v)) or
    exists(Field f | this = DataFlow::fieldNode(f))
  }
}

class ConstantStringSanitizer extends TaintTracking::Sanitizer {
  ConstantStringSanitizer() {
    exists(StringLiteral sl | this = DataFlow::exprNode(sl))
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserControlledInput
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeCall call |
      sink.asExpr() = call.getArgument(0).getExpr()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ConstantStringSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(AddExpr concat |
      (DataFlow::exprNode(concat.getLeftOperand()) = pred and DataFlow::exprNode(concat) = succ) or
      (DataFlow::exprNode(concat.getRightOperand()) = pred and DataFlow::exprNode(concat) = succ)
    )
    or
    exists(MethodInvocation formatCall |
      formatCall.getMethod().getName() = "format" and
      DataFlow::exprNode(formatCall.getAnArgument()) = pred and
      DataFlow::exprNode(formatCall) = succ
    )
  }
}

from CommandInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential command injection from user input to Runtime.exec() or loadLibrary() call",
  source.getNode(), "User input source",
  sink.getNode(), "Runtime call with potentially tainted argument"
