Rule Content:
/**
 * @name Command Injection Formatted Runtime Call
 * @description A formatted or concatenated string was detected as input to a Runtime call.
 *              This is dangerous if a variable is controlled by user input and could result 
 *              in command injection.
 * @kind path-problem
 * @severity error
 * @id java/command-injection-formatted-runtime-call
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat
import DataFlow::PathGraph

class RuntimeExecCall extends MethodAccess {
  RuntimeExecCall() {
    exists(Method m | 
      (m.hasName("exec") or m.hasName("loadLibrary")) and
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      this.getMethod() = m
    )
  }
}

class UserControlledInput extends DataFlow::Source {
  UserControlledInput() {
    exists(Parameter p | this.asParameter() = p) or
    exists(Variable v | this.asVariable() = v) or
    exists(Field f | this.asField() = f)
  }
}

class ConstantStringSanitizer extends DataFlow::Sanitizer {
  ConstantStringSanitizer() {
    exists(StringLiteral lit | this.asExpr() = lit)
  }
}

class CommandInjectionFlow extends TaintTracking::Configuration {
  CommandInjectionFlow() { this = "CommandInjectionFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserControlledInput
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeExecCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ConstantStringSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::BinaryExpr concat | 
      (concat.getLeftOperand() = pred.asExpr() and concat = succ.asExpr()) or
      (concat.getRightOperand() = pred.asExpr() and concat = succ.asExpr())
    ) or
    exists(MethodAccess formatCall |
      formatCall.getMethod().hasName("format") and
      formatCall.getAnArgument() = pred.asExpr() and
      formatCall = succ.asExpr()
    )
  }
}

from CommandInjectionFlow config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential command injection from user input to Runtime.exec() or loadLibrary() call",
  source, "User input",
  sink, "Potentially dangerous Runtime call"
