Rule Content:
/**
 * @name Command Injection Formatted Runtime Call
 * @description A formatted or concatenated string was detected as input to a java.lang.Runtime call.
 *              This is dangerous if a variable is controlled by user input and could result in
 *              a command injection.
 * @severity Error
 * @kind path-problem
 * @id java/command-injection-formatted-runtime-call
 * @tags security
 *       external/cwe/cwe-078
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat
import semmle.code.java.StringConcatExpr

class RuntimeExecCall extends MethodAccess {
  RuntimeExecCall() {
    exists(Method m | 
      m.hasName(["exec", "loadLibrary"]) and
      m.getDeclaringType().hasQualifiedName("java.lang", "Runtime") and
      this.getMethod() = m
    )
  }

  int getArgumentIndex() { result = 0 }
}

class UserControlledInput extends TaintTracking::Source {
  UserControlledInput() {
    exists(Parameter p | this.asParameter() = p) or
    exists(LocalVariable l | this.asLocalVariable() = l) or
    exists(Field f | this.asField() = f)
  }
}

class SanitizedLiteral extends TaintTracking::Sanitizer {
  SanitizedLiteral() {
    exists(StringLiteral l | this.asExpr() = l)
  }
}

class ExplicitSafeExec extends TaintTracking::Sanitizer {
  ExplicitSafeExec() {
    exists(RuntimeExecCall call |
      this.asExpr() = call.getArgument(getArgumentIndex()) and
      call.getArgument(getArgumentIndex()).(StringLiteral).getValue().regexpMatch("^[^\"].*")
    )
  }
}

class CommandInjectionConfig extends TaintTracking::Configuration {
  CommandInjectionConfig() { this = "CommandInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserControlledInput
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RuntimeExecCall call |
      sink.asExpr() = call.getArgument(call.getArgumentIndex())
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SanitizedLiteral or
    sanitizer instanceof ExplicitSafeExec
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(StringConcatOperation concat | concat.getAnOperand() = pred.asExpr() and concat = succ.asExpr()) or
    exists(StringFormatOperation format | format.getAnArgument() = pred.asExpr() and format = succ.asExpr())
  }
}

from CommandInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential command injection from user input to Runtime.exec() or loadLibrary()",
  source, "User input flows here",
  sink, "To this potentially dangerous Runtime call"
