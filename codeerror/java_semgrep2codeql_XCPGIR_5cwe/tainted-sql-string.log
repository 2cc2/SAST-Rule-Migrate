Rule Content:
/**
 * @id tainted-sql-string
 * @kind path-problem
 * @severity error
 * @name User data flows into manually-constructed SQL string
 * @description User data flows into this manually-constructed SQL string. 
 *              User data can be safely inserted into SQL strings using 
 *              prepared statements or an object-relational mapper (ORM).
 *              Manually-constructed SQL strings is a possible indicator of SQL injection.
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.spring.SpringController

class UserInputSource extends DataFlow::Expr {
  UserInputSource() {
    exists(Parameter p |
      p.getAnAnnotation().getType().getName().matches("@(PathVariable|RequestParam|RequestHeader|CookieValue)") and
      not p.getType().getName().matches("^(Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean)") and
      this.asParameter() = p
    )
  }
}

class SqlStringConstructionSink extends DataFlow::Expr {
  SqlStringConstructionSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getName() = "concat" or
       ma.getMethod().getName() = "format" or
       ma.getArgument(0).toString().matches(".*\\+\\s*\".*") or
       ma.getCompileTimeType().getName().matches("StringBuilder") or
       ma.toString().matches("String\\w*\\s*\\+=.*")) and
      not ma.getCaller().toString().matches("(System.out.println|LOG.(info|warn|warning|debug|debugging|error)|new Exception|throw)") and
      ma.getReceiver().toString().matches("(?i)(select|delete|insert|create|update|alter|drop)") and
      this = ma.getArgument(0)
    )
  }
}

class SqlStringInjectionFlowConfiguration extends DataFlow::Configuration {
  SqlStringInjectionFlowConfiguration() { this = "SqlStringInjectionFlow" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlStringConstructionSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from SqlStringInjectionFlowConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "User data flows into manually-constructed SQL string. Use prepared statements instead.",
  source, sink,
  "Potential SQL injection vulnerability"
