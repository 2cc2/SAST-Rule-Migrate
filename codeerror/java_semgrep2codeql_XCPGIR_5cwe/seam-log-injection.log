 *       external/cwe/cwe-095
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class SeamLogInjectionConfig extends TaintTracking::Configuration {
  SeamLogInjectionConfig() { this = "SeamLogInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Expr e |
      e = source.asExpr() and
      (e instanceof Literal and not e.isCompileTimeConstant() or
       e instanceof VarAccess)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      m.getName().matches("debug|error|fatal|info|trace|warn") and
      sink.asExpr() = m.getAReference().getArgument(0)
