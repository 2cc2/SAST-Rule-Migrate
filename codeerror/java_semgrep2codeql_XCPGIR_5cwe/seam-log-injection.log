Rule Content:
/**
 * @name Seam Log Injection
 * @description Detects potential Expression Language injection in Seam logging APIs where
 *              user input flows into log messages without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.seam.Seam

class SeamLogInjectionConfig extends TaintTracking::Configuration {
  SeamLogInjectionConfig() { this = "SeamLogInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Literal l | source.asExpr() = l and not l.isConstant()) or
    exists(Identifier i | source.asExpr() = i)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("org.jboss.seam.log", "Log", "debug") or
      ma.getMethod().hasQualifiedName("org.jboss.seam.log", "Log", "error") or
      ma.getMethod().hasQualifiedName("org.jboss.seam.log", "Log", "fatal") or
      ma.getMethod().hasQualifiedName("org.jboss.seam.log", "Log", "info") or
      ma.getMethod().hasQualifiedName("org.jboss.seam.log", "Log", "trace") or
      ma.getMethod().hasQualifiedName("org.jboss.seam.log", "Log", "warn") |
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(BinaryExpr be |
      be.getOperator() = BinaryOperator.PLUS and
      (be.getLeftOperand() = node1.asExpr() and node2.asExpr() = be) or
      (be.getRightOperand() = node1.asExpr() and node2.asExpr() = be)
    )
  }
}

from SeamLogInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  source, sink, "Potential EL injection in Seam logging via unverified user input. [CWE-95, OWASP A03]"
