/**
 * @name Seam Log Injection
 * @description Detects potential Expression Language injection in Seam logging APIs where
 *              user input flows into log messages without proper sanitization.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-095
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class SeamLogInjectionConfig extends TaintTracking::Configuration {
  SeamLogInjectionConfig() { this = "SeamLogInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Expr e | 
      e = source.asExpr() and
      (e instanceof Literal and not e.isCompileTimeConstant() or
       e instanceof VariableAccess)
    ) or
    exists(RemoteFlowSource remote | source.asExpr() = remote.getSource())
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      m.getName().matches("debug|error|fatal|info|trace|warn") and
      sink.asExpr() = m.getACall().getArgument(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(BinaryExpr be |
      be.getOperator().toString() = "+" and
      (node1.asExpr() = be.getLeftOperand() and node2.asExpr() = be) or
      (node1.asExpr() = be.getRightOperand() and node2.asExpr() = be)
    )
  }
}

