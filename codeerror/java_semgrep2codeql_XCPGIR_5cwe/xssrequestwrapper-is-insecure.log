/**
 * @name Insecure XSSRequestWrapper Implementation
 * @description Detects use of dzone's XSSRequestWrapper which has insecure XSS filtering
 * @kind path-problem
 * @problem.severity warning
 * @id java/xssrequestwrapper-is-insecure
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

predicate isXSSType(Type t) {
  t.hasName("XSSRequestWrapper")
}

class XSSType extends RefType {
  XSSType() { isXSSType(this) }
}

predicate isInsecureScriptFilter(Call call) {
  call.getCallee().hasName("compile") and
  call.getReceiver().toString().matches(".*</script>.*")
}

class XSSRequestParameterAccess extends Call {
  XSSRequestParameterAccess() {
    this.getCallee().hasName("getParameter") and
    this.getCallee().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")
  }
}

class XSSFlowsConfig extends TaintTracking::Configuration {
  XSSFlowsConfig() { this = "XSSRequestWrapperInsecureFiltering" }

  override predicate isSource(DataFlow::Node source) {
    exists(XSSType t | source.asExpr().getType() = t)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(XSSRequestParameterAccess call | sink.asExpr() = call)
  }
}

from XSSFlowsConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Insecure XSS filtering implementation detected. XSSRequestWrapper from dzone has vulnerable filtering that can be bypassed. $@",
  source.getNode(), "Source declaration"
