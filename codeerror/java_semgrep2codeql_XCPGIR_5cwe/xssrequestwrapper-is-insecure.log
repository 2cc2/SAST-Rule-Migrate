/**
 * @name Insecure XSSRequestWrapper Implementation
 * @description Detects use of dzone's XSSRequestWrapper which has insecure XSS filtering
 * @kind path-problem
 * @problem.severity warning
 * @id java/xssrequestwrapper-is-insecure
 */

import java

predicate isXSSType(Type t) {
  t.hasName("XSSRequestWrapper")
}

class XSSType extends RefType {
  XSSType() { isXSSType(this) }
}

predicate isInsecureScriptFilter(MethodAccess ma) {
  ma.getMethod().hasName("compile") and
  ma.getQualifier().toString().matches("%</script>%")
}

predicate isRequestParameterAccess(MethodAccess ma) {
  ma.getMethod().hasName("getParameter") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")
}

from XSSType xss, MethodAccess paramAccess
where 
  exists(MethodAccess scriptFilter | isInsecureScriptFilter(scriptFilter)) and
  isRequestParameterAccess(paramAccess) and
  paramAccess.getReceiver().getType() = xss
select paramAccess, "Insecure XSS filtering implementation detected. The XSSRequestWrapper from dzone has vulnerable filtering that can be bypassed. Use template auto-escaping instead."
