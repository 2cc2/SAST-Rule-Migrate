/**
 * @name Insecure XSSRequestWrapper Implementation
 * @description Detects use of dzone's XSSRequestWrapper which has insecure XSS filtering
 * @kind path-problem
 * @problem.severity warning
 * @id java/xssrequestwrapper-is-insecure
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

predicate isXSSType(Type t) {
  t.hasName("XSSRequestWrapper")
}

class XSSType extends RefType {
  XSSType() { isXSSType(this) }
}

class HttpServletRequestParameterAccess extends MethodAccessExpr {
  HttpServletRequestParameterAccess() {
    exists(Method m | m = this.getMethod() |
      m.hasName("getParameter") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest")
    )
  }
}

class XSSRequestWrapperFlow extends TaintTracking::Configuration {
  XSSRequestWrapperFlow() { this = "XSSRequestWrapperFlow" }

  override predicate isSource(DataFlow::Node source) {
    exists(XSSType t | source.asExpr().getType() = t)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(HttpServletRequestParameterAccess call |
      sink.asExpr() = call
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, XSSRequestWrapperFlow config
where config.hasFlowPath(source, sink)
select sink, "Insecure XSS filtering implementation detected. XSSRequestWrapper from dzone has vulnerable filtering that can be bypassed. Use template auto-escaping instead.",
  source.getNode(), "XSSRequestWrapper usage"
