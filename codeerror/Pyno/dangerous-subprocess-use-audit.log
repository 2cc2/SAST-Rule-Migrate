Rule Content:
/**
 * @name Dangerous Subprocess Use
 * @description Detects subprocess functions without static strings that could be controlled by malicious actors,
 *              potentially leading to command injection vulnerabilities.
 * @kind path-problem
 * @problem.severity error
 * @id py/dangerous-subprocess-use
 * @tags security
 *       external/cwe/cwe-078
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class DangerousSubprocessCall extends DataFlow::CallNode {
  DangerousSubprocessCall() {
    exists(string funcName |
      (
        this.getTarget().(QualifiedNameValue).getName() = funcName and
        regexpMatch(funcName, "^(subprocess\\.(Popen|call|run|check_call|check_output))$")
      )
    )
  }

  string getCommand() { result = this.getArg(0).getValue().toString() }
}

class DynamicShellCommand extends TaintTracking::Configuration {
  DynamicShellCommand() { this = "DynamicShellCommand" }

  override predicate isSource(DataFlow::Node source) {
    exists(DangerousSubprocessCall call |
      call.getCommand() = source.asExpr().getStringValue() and
      regexpMatches(call.getCommand(), "(sh|bash|ksh|csh|tcsh|zsh|python)")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asExpr() = any(DangerousSubprocessCall call).getArg(0)
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(DangerousSubprocessCall call |
      call.getCommand() = sanitizer.asExpr().getStringValue() and
      call.getCommand().isConstant()
    )
  }
}

from DynamicShellCommand config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Detected subprocess function without a static string. $@",
  source.getNode(),
  "Could be vulnerable to command injection if this is user-controllable input. Audit the use of this call. Consider using 'shlex.escape()'."
