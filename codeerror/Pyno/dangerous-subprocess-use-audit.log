Rule Content:
/**
 * @name Dangerous subprocess use audit
 * @description Detected subprocess function without a static string. If this data can
 * be controlled by a malicious actor, it may be an instance of command injection.
 * Audit the use of this call to ensure it is not controllable by an external resource.
 * You may consider using 'shlex.escape()'.
 * @kind taint
 * @problem.severity error
 * @id python/dangerous-subprocess-use-audit
 */

import python
import semmle.python.DangerousFunctions
import semmle.python.ApiGraphs
import semmle.python.Web
import DataFlow::PathGraph

class SubprocessFunction extends DataFlow::CallNode {
  SubprocessFunction() {
    exists(RemoteFlowSource remote |
      this.getTarget().getQualifiedName().matches("subprocess.%") and
      this.getArgument(0).getValue().toString().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh|python)")
    )
  }
}

class StaticCommandSanitizer extends DataFlow::CallNode {
  StaticCommandSanitizer() {
    this.getArgument(0).getValue().toString() = "..."
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "dangerous_subprocess_use_audit" }

  override predicate isSource(DataFlow::Node source) {
    exists(SubprocessFunction call |
      source.asExpr() = call.getArgument(0) and
      not exists(StaticCommandSanitizer sanitizer |
        sanitizer = call
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DataFlow::CallNode call |
      call.getTarget().getQualifiedName().matches("subprocess.%") and
      sink.asExpr() = call
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StaticCommandSanitizer call |
      sanitizer.asExpr() = call
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected subprocess function without a static string. This may be vulnerable to command injection."
