/**
 * @name Dangerous Subprocess Use Audit
 * @description Detected subprocess function without a static string. If this data can
 *              be controlled by a malicious actor, it may be an instance of command injection.
 *              Audit the use of this call to ensure it is not controllable by an external resource.
 *              You may consider using 'shlex.escape()'.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-subprocess-use-audit
 */

import python
import semmle.python.security.CommandInjection
import semmle.python.ApiGraphs
import DataFlow

class DangerousSubprocessCall extends DataFlow::Node {
  DangerousSubprocessCall() {
    exists(FunctionValue fun |
      fun.getCall().getMethodBinding().getPackage() = "subprocess" and
      this.asExpr() = fun.getCall().getArgument(0)
    )
  }
}

class ShellPattern extends DataFlow::Node {
  ShellPattern() {
    this.asExpr().regexpMatch(".*(sh|bash|ksh|csh|tcsh|zsh|python).*")
  }
}

predicate filterSanitizer(DataFlow::Node node) {
  // Match literal strings as sanitizers
  exists(string val | node.asExpr() = val and val = "..." |
    not exists(DangerousSubprocessCall dc | dc = node)
  )
}

from DangerousSubprocessCall source, DataFlow::Node sink
where
  DataFlow::localFlow(source, sink) and
  exists(ShellPattern pattern | source = pattern) and
  not filterSanitizer(source)
select sink, "Detected subprocess function without a static string. Audit the use of this call to prevent command injection."
