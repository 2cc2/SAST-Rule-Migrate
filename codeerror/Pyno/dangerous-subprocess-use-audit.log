Rule Content:
/**
 * @name Dangerous Subprocess Use
 * @id dangerous-subprocess-use-audit
 * @description Detects subprocess functions without a static string argument.
 *              If this data can be controlled by a malicious actor, it may be
 *              an instance of command injection. Audit the use of this call to
 *              ensure it is not controllable by an external resource.
 *              Consider using 'shlex.escape()'.
 * @kind path-problem
 * @problem.severity error
 * @precision high
 */

import python
import semmle.python.Concepts
import semmle.python.security.CommandInjection
import DataFlow::PathGraph

class DangerousSubprocessConfig extends TaintTracking::Configuration {
  DangerousSubprocessConfig() {
    this = "DangerousSubprocessConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    exists(CallNode call |
      call.getTarget().getName().regexpMatch("(Popen|run|call|check_call|check_output)") and
      call.getTarget().getContainerScope().getName() = "subprocess" and
      not call.getArg(0).isStringLiteralValue() and
      source.asExpr() = call.getArg(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(CallNode call |
      call.getTarget().getName().regexpMatch("(Popen|run|call|check_call|check_output)") and
      call.getTarget().getContainerScope().getName() = "subprocess" and
      sink.asExpr() = call
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(CallNode call |
      call.getTarget().getName().regexpMatch("(Popen|run|call|check_call|check_output)") and
      call.getTarget().getContainerScope().getName() = "subprocess" and
      call.getArg(0).isStringLiteralValue() and
      node.asExpr() = call
    )
  }
}

from DangerousSubprocessConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Detected subprocess function without a static string. This may be vulnerable to command injection.", 
  source, "User-provided value flows here"
