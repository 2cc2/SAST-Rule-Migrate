Rule Content:
/**
 * @name Dangerous Subprocess Use Audit
 * @description Detects subprocess function calls without static strings.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-subprocess-use-audit
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class DangerousSubprocessConfig extends TaintTracking::Configuration {
  DangerousSubprocessConfig() { this = "DangerousSubprocessConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call, string funcName |
      call.getPackageName() = "subprocess" and
      funcName = call.getMethodName() and
      (
        exists(string arg0Value |
          call.getArg(0).getUncontrolledValue() = arg0Value and
          arg0Value.regexpMatches("(sh|bash|ksh|csh|tcsh|zsh|python)")
        )
      ) and
      source.asExpr() = call.getArg(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getPackageName() = "subprocess" and
      sink.asExpr() = call.getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getPackageName() = "subprocess" and
      call.getArg(0).getUncontrolledValue() instanceof FixedString
    )
  }
}

from DangerousSubprocessConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "Detected subprocess function '" + sink.getNode().getRoot().toString() + 
  "' without a static string. If this data can be controlled by a malicious actor, " +
  "it may be an instance of command injection. Audit the use of this call to " +
  "ensure it is not controllable by an external resource. You may consider using 'shlex.escape()'.",
  source.getNode(), "User-controlled command argument"
