Rule Content:
/**
 * @name Unsafe Flask make_response usage
 * @description Detects unsafe usage of flask.make_response() that could lead to XSS vulnerabilities.
 * @kind problem
 * @problem.severity warning
 * @id python/unsafe-flask-make-response
 */

import python

predicate isSafeMakeResponseArg(Expr arg) {
  exists(Call safeCall |
    safeCall.getTarget().getQualifiedName() in [
      "flask.make_response.string",
      "flask.make_response.dict",
      "flask.make_response.flask.redirect",
      "flask.make_response.flask.render_template",
      "flask.make_response.flask.jsonify",
      "flask.make_response.json.dumps"
    ] and
    arg = safeCall
  )
  or
  exists(Assignment assign |
    assign.getTarget().getQualifiedName().matches("%render_template%") and
    arg = assign.getAnAssignedValue()
  )
  or
  exists(Assignment assign |
    assign.getTarget().getQualifiedName().matches("%jsonify%") and
    arg = assign.getAnAssignedValue()
  )
  or
  exists(Assignment assign |
    assign.getTarget().getQualifiedName().matches("%json.dumps%") and
    arg = assign.getAnAssignedValue()
  )
}

from Call makeResponse, Expr argValue
where
  makeResponse.getTarget().getQualifiedName() = "flask.make_response" and
  argValue = makeResponse.getArg(0) and
  not isSafeMakeResponseArg(argValue)
select makeResponse, "Be careful with flask.make_response(). If this response is rendered onto a webpage, " +
  "this could create a cross-site scripting (XSS) vulnerability. flask.make_response() will not autoescape HTML. " +
  "If you are rendering HTML, write your HTML in a template file and use flask.render_template() which will " +
  "take care of escaping. If you are returning data from an API, consider using flask.jsonify()."
