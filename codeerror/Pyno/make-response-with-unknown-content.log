Rule Content:
/**
 * @name Make Response With Unknown Content
 * @description Using flask.make_response() without proper escaping can create cross-site scripting (XSS) vulnerabilities.
 * @kind problem
 * @problem.severity warning
 * @id py/make-response-with-unknown-content
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.Security.XSS

class FlaskMakeResponseCall extends API::Call {
  FlaskMakeResponseCall() {
    this.getTarget().getName() = "make_response" and
    this.getTarget().getModule().getName() = "flask"
  }
}

class SafeResponseGeneration extends API::Call {
  SafeResponseGeneration() {
    (
      this.getTarget().getName().matches("render_template") or
      this.getTarget().getName().matches("jsonify") or
      this.getTarget().getName().matches("redirect")
    ) and
    this.getTarget().getModule().getName() = "flask"
  }
}

predicate isSafeResponseGeneration(Expr e) {
  exists(SafeResponseGeneration call |
    e = call or exists(AssignStmt assign | assign.getRHS() = call.getAChildExpr()* | e = assign)
  )
}

from FlaskMakeResponseCall call
where
  // Check if argument isn't one of the known safe types
  not (
    exists(string arg | call.getArg(0) = arg) or
    exists(dict arg | call.getArg(0) = arg) or
    exists(ApiCallExpr redirectCall | call.getArg(0) = redirectCall |
      redirectCall.getTarget().getName() = "redirect" and
      redirectCall.getTarget().getModule().getName() = "flask"
    ) or
    exists(ApiCallExpr renderTemplateCall | call.getArg(0) = renderTemplateCall |
      renderTemplateCall.getTarget().getName() = "render_template" and
      renderTemplateCall.getTarget().getModule().getName() = "flask"
    ) or
    exists(ApiCallExpr jsonifyCall | call.getArg(0) = jsonifyCall |
      jsonifyCall.getTarget().getName() = "jsonify" and
      jsonifyCall.getTarget().getModule().getName() = "flask"
    ) or
    exists(ApiCallExpr jsonDumpsCall | call.getArg(0) = jsonDumpsCall |
      jsonDumpsCall.getTarget().getName() = "dumps" and
      jsonDumpsCall.getTarget().getModule().getName() = "json"
    ) or
    isSafeResponseGeneration(call.getArg(0))
  )
select call, "Be careful with flask.make_response(). If this response is rendered onto a webpage, " +
  "this could create a cross-site scripting (XSS) vulnerability. flask.make_response() " +
  "will not autoescape HTML. If you are rendering HTML, write your HTML in a template file " +
  "and use flask.render_template() which will take care of escaping. If you are returning data " +
  "from an API, consider using flask.jsonify()."
