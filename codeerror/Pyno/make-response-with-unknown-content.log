Rule Content:
/**
 * @name Make Response with Unknown Content
 * @description Detects unsafe usage of flask.make_response() that could lead to XSS vulnerabilities.
 * @kind problem
 * @problem.severity warning
 * @id python/make-response-with-unknown-content
 */

import python

// Define unsafe flask.make_response() calls
predicate isUnsafeMakeResponseCall(DataFlow::CallNode call) {
  call.getTarget().hasQualifiedName("flask", "make_response") and
  not (
    call.getArg(0).getAUse().getCallSite().getTarget().hasQualifiedName("flask", "render_template") or
    call.getArg(0).getAUse().getCallSite().getTarget().hasQualifiedName("flask", "jsonify") or
    call.getArg(0).getAUse().getCallSite().getTarget().hasQualifiedName("flask", "redirect") or
    call.getArg(0).getAUse().getCallSite().getTarget().hasQualifiedName("json", "dumps")
  )
}

// Define safe response generation calls
predicate isSafeResponseGeneration(DataFlow::CallNode call) {
  exists(Method m | 
    m.hasQualifiedName("flask", "render_template") or
    m.hasQualifiedName("flask", "jsonify") or
    m.hasQualifiedName("flask", "redirect") |
    call.getTarget() = m
  )
}

from DataFlow::CallNode call
where isUnsafeMakeResponseCall(call)
select call,
  "Be careful with `flask.make_response()`. If this response is rendered onto a webpage, " +
  "this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()` " +
  "will not autoescape HTML. If you are rendering HTML, write your HTML in a template " +
  "file and use `flask.render_template()` which will take care of escaping. If you are " +
  "returning data from an API, consider using `flask.jsonify()`."
