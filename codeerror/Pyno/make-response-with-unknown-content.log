Rule Content:
/**
 * @name Flask make_response with unknown content
 * @description Detects potentially unsafe usage of flask.make_response() which doesn't autoescape HTML.
 *              Using flask.render_template() or flask.jsonify() is preferred which handles escaping.
 * @kind path-problem
 * @problem.severity warning
 * @id py/flask-make-response-unknown-content
 */

import python
import semmle.python.security.XSS

class FlaskMakeResponseCall extends DataFlow::CallNode {
  FlaskMakeResponseCall() {
    exists(Method m | 
      m.getName() = "make_response" and
      m.getDeclaringType().hasGlobalName("flask") and
      this.getMethod() = m
    )
  }
}

class SafeFlaskResponseGeneration extends DataFlow::CallNode {
  SafeFlaskResponseGeneration() {
    exists(Method m |
      (m.getName() = "render_template" or
       m.getName() = "jsonify" or
       m.getName() = "redirect") and
      m.getDeclaringType().hasGlobalName("flask") and
      this.getMethod() = m
    )
  }
}

class FlaskMakeResponseXssSink extends XSS::Sink {
  FlaskMakeResponseXssSink() {
    exists(FlaskMakeResponseCall call |
      not exists(SafeFlaskResponseGeneration safeCall |
        DataFlow::localFlow(DataFlow::exprNode(safeCall), DataFlow::exprNode(call))
      ) and
      this.asExpr() = call
    )
  }
}

from FlaskMakeResponseXssSink sink
select sink, "Be careful with flask.make_response(). If this response is rendered onto a webpage, " +
  "this could create a cross-site scripting (XSS) vulnerability. flask.make_response() will not " +
  "autoescape HTML. If you are rendering HTML, use flask.render_template() which will handle " +
  "escaping. If returning API data, use flask.jsonify()."
