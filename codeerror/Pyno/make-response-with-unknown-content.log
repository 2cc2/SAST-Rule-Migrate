Rule Content:
/**
 * @name make-response-with-unknown-content
 * @description Be careful with `flask.make_response()`. If this response is rendered onto a webpage,
 *              this could create a cross-site scripting (XSS) vulnerability. `flask.make_response()`
 *              will not autoescape HTML. If you are rendering HTML, write your HTML in a template file
 *              and use `flask.render_template()` which will take care of escaping. If you are returning
 *              data from an API, consider using `flask.jsonify()`.
 * @kind problem
 * @problem.severity warning
 * @id py/make-response-xss
 */

import python

// Define the sink - flask.make_response() calls
class FlaskMakeResponseCall extends DataFlow::CallNode {
  FlaskMakeResponseCall() {
    exists(Method m |
      m.getQualifiedName() = "flask.make_response" and
      this.getTarget() = m and
      not (
        exists(DataFlow::CallNode safeCall | 
          (safeCall.getTarget().getQualifiedName() = "flask.render_template" or
           safeCall.getTarget().getQualifiedName() = "flask.jsonify" or
           safeCall.getTarget().getQualifiedName() = "json.dumps") and
          this.getAnArg() = safeCall.getAChildExpr()
        )
      )
    )
  }
}

// Define sanitizers - safe response generation methods
class SafeResponseCall extends DataFlow::CallNode {
  SafeResponseCall() {
    exists(Method m |
      (m.getQualifiedName() = "flask.render_template" or
       m.getQualifiedName() = "flask.jsonify" or
       m.getQualifiedName() = "flask.redirect") and
      this.getTarget() = m
    )
  }
}

// Flow configuration
class MakeResponseFlowConfiguration extends DataFlow::Configuration {
  MakeResponseFlowConfiguration() { this = "MakeResponseFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) { 
    any(SafeResponseCall s).getAChildExpr() = source 
  }

  override predicate isSink(DataFlow::Node sink) { sink instanceof FlaskMakeResponseCall }

  override predicate isSanitizer(DataFlow::Node node) { node instanceof SafeResponseCall }
}

from MakeResponseFlowConfiguration flow, DataFlow::Node sink
where flow.hasFlowTo(sink)
select sink, "Potential XSS vulnerability: flask.make_response() used with unsafe content. " +
       "Use flask.render_template/flask.jsonify for safe response generation."
