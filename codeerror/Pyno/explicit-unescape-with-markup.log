Rule Content:
/**
 * @name Explicit Unescape with Markup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits the unescaped data 
 * to include unescaped HTML which could result in cross-site scripting.
 * @kind path-problem
 * @problem.severity warning
 * @id python/explicit-unescape-with-markup
 */

import python
import semmle.python.security.Paths.TaintTracking
import semmle.python.Concepts
import semmle.python.web.HttpRequest

class UserControlledInput extends RemoteFlowSources::Range {
  UserControlledInput() {
    exists(string name | 
      name.regexpMatch(".*request|input|param.*") and
      this = RemoteFlowSources::parameter(name)
    )
  }
}

class MarkupUnescapeCall extends DataFlow::Node {
  MarkupUnescapeCall() {
    exists(Call call |
      call.getTarget().(FunctionValue).getQualifiedName() = "flask.Markup.unescape" and
      this.asExpr() = call
    )
  }
}

class MarkupConstructor extends DataFlow::Node {
  MarkupConstructor() {
    exists(Call call, int argIndex |
      call.getTarget().(FunctionValue).getQualifiedName() = "markupsafe.Markup.__init__" and
      argIndex = 0 and
      this.asExpr() = call.getArg(argIndex)
    )
  }
}

class SafeStringLiteral extends DataFlow::Node {
  SafeStringLiteral() {
    this.asExpr() instanceof StringLiteral and
    this.asExpr().(StringLiteral).getText() = "\"\"\""
  }
}

class ExplicitUnescapeWithMarkupConfig extends TaintTracking::Configuration {
  ExplicitUnescapeWithMarkupConfig() { this = "ExplicitUnescapeWithMarkupConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserControlledInput }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof MarkupUnescapeCall or
    sink instanceof MarkupConstructor
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeStringLiteral
  }
}

from ExplicitUnescapeWithMarkupConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "Detected explicitly unescaped content using 'Markup()'. This permits the unescaped data to include " +
  "unescaped HTML which could result in cross-site scripting. Ensure this data is not externally " +
  "controlled, or consider rewriting to not use 'Markup()'.", 
  source.getNode(),
  "User-controlled input flows here"
