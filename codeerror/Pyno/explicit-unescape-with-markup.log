Rule Content:
/**
 * @name Explicit Unescape with Markup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits the 
 *              unescaped data to include unescaped HTML which could result in XSS.
 *              Ensure this data is not externally controlled, or consider rewriting
 *              to not use 'Markup()'.
 * @kind taint
 * @problem.severity warning
 * @id python/explicit-unescape-with-markup
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.HttpRequest

class UserControlledInput extends DataFlow::Node {
  UserControlledInput() {
    exists(string paramName |
      this instanceof ParameterNode and
      paramName = this.getName().toLowerCase() and
      paramName.matches("%request|input|param%")
    )
  }
}

class MarkupUnescapeSink extends DataFlow::Node {
  MarkupUnescapeSink() {
    exists(CallNode call |
      call = this.asExpr() and
      (
        call.getCalleeName() = "unescape" and
        call.getReceiver().getType().getName() = "Markup" and
        call.getReceiver().getType().getSourceDeclaration().getNamespace().getName() = "flask"
        or
        call.getCalleeName() = "__init__" and
        call.getReceiver().getType().getName() = "Markup" and
        call.getReceiver().getType().getSourceDeclaration().getNamespace().getName() = "markupsafe"
      )
    )
  }
}

class SafeStringLiteral extends DataFlow::Node {
  SafeStringLiteral() {
    exists(string literal |
      this.asExpr() = literal and
      literal = "\"\"\""
    )
  }
}

class ExplicitUnescapeWithMarkupConfig extends TaintTracking::Configuration {
  ExplicitUnescapeWithMarkupConfig() {
    this = "ExplicitUnescapeWithMarkupConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserControlledInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MarkupUnescapeSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeStringLiteral
  }
}

from ExplicitUnescapeWithMarkupConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential XSS vulnerability due to explicit unescaped content with Markup()"
