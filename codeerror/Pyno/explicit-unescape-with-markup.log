Rule Content:
/**
 * @name Explicit unescape with Markup
 * @description Detected explicitly unescaped content using 'Markup()'. This permits the unescaped data
 *              to include unescaped HTML which could result in cross-site scripting. Ensure this data
 *              is not externally controlled, or consider rewriting to not use 'Markup()'.
 * @kind taint-problem
 * @problem.severity warning
 * @id python/explicit-unescape-with-markup
 */

import python
import semmle.python.ApiGraphs
import semmle.python.security.Xss

predicate isUserControlledInput(DataFlow::Node node) {
  exists(string paramName |
    node.asParameter().getName() = paramName and
    paramName.matches(".*request|input|param.*")
  )
    or
  exists(SourceNode src | src = node and isRemoteUserInput(src.getSource()))
}

predicate isMarkupUnescapeCall(DataFlow::Node node) {
  exists(MethodCall call |
    call = node.asExpr() and
    (
      call.getMethodName() = "unescape" and
      call.getReceiverType().getName() = "Markup" and
      call.getReceiverType().getAPackage().getName() = "flask"
      or
      call.getMethodName() = "__init__" and
      call.getReceiverType().getName() = "Markup" and
      call.getReceiverType().getAPackage().getName() = "markupsafe"
    )
  )
    or
  exists(ConstructorCall ctor |
    ctor = node.asExpr() and
    ctor.getConstructedType().getName() = "Markup" and
    ctor.getConstructedType().getAPackage().getName() = "markupsafe"
  )
}

from
  DataFlow::Node source, DataFlow::Node sink
where
  isUserControlledInput(source) and
  isMarkupUnescapeCall(sink) and
  not (
    exists(DataFlow::Node sanitized |
      sanitized = source and
      sanitized.asExpr().(StringLiteral).getText() = "\"\"\""
    )
  ) and
  TaintTracking::localTaint(source, sink)
select sink, "Potential XSS vulnerability from unescaped user input using Markup()"
