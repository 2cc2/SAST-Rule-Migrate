Rule Content:
/**
 * @name Tainted HTML string construction
 * @description Detected user input flowing into a manually constructed HTML string.
 *              This could create a cross-site scripting vulnerability. Ensure the HTML
 *              is rendered safely or use templates.
 * @kind taint-problem
 * @problem.severity warning
 * @id python/tainted-html-string
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.Concepts

class UserInputSource extends TaintSource::Range {
  UserInputSource() {
    exists(Parameter p | p.getLocation().getText() = "event" | result = p)
  }
}

class HtmlSink extends TaintSink::Range {
  HtmlSink() {
    exists(BinaryOperation binOp |
      binOp.getLeftOperand().getText().regexpMatch("\"\\$HTMLSTR\" %|\"\\$HTMLSTR\"\\.format|\"\\$HTMLSTR\" \\+|f\"\\$HTMLSTR{") and
      binOp.getRightOperand().getText().regexpMatch("<[a-zA-Z]+") |
      result = binOp
    ) or
    exists(Call call |
      call.getTarget().toString().matches("print%d") and
      call.getTarget().getName() = "print" |
      neutralizes(result = call)
    )
  }
}

class HtmlConstructionSanitizer extends TaintSanitizer::Range {
  HtmlConstructionSanitizer() {
    exists(Call c | c.getTarget().getName() = "print" | result = c)
  }
}

class TaintedHtmlStringConfig extends TaintTracking::Configuration {
  TaintedHtmlStringConfig() { this = "TaintedHtmlString" }
  
  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }
  
  override predicate isSink(DataFlow::Node sink) { sink instanceof HtmlSink }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof HtmlConstructionSanitizer
  }
}

from TaintedHtmlStringConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "User input flows into a manually constructed HTML string, creating XSS risk"
