/**
 * @name Tainted HTML String
 * @description Detected user input flowing into a manually constructed HTML string.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @id py/tainted-html-string
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import DataFlow::PathGraph


class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p |
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}


class HtmlSink extends DataFlow::Node {
  HtmlSink() {
    exists(Call call |
      call = this.asExpr() and
      call.getCalleeName().regexpMatch(".*HTMLSTR.*") // Simplified regex matching
    )
    or
    exists(BinaryExpr binary |
      binary = this.asExpr() and
      (
        binary.getOperator() = "+" or
        binary.getOperator() = "%"
      ) and
      binary.getRightOperand().toString().regexpMatch("<[a-zA-Z]+")
    )
  }
}


class SafePrintSanitizer extends DataFlow::Node {
  SafePrintSanitizer() {
    exists(Call call |
      call.getCalleeName() = "print" and
      this.asExpr() = call
    )
  }
}


class TaintedHtmlStringConfig extends TaintTracking::Configuration {
  TaintedHtmlStringConfig() { this = "TaintedHtmlStringConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof HtmlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof SafePrintSanitizer }
}


from TaintedHtmlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "Detected user input flowing into a manually constructed HTML string. This could create a cross-site scripting vulnerability."
