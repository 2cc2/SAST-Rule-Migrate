/**
 * @name Tainted HTML String
 * @description Detected user input flowing into a manually constructed HTML string.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-string
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.web.Html

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(FunctionValue func, Parameter p |
      func = p.getFunction() and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class HtmlConstructionSink extends DataFlow::Node {
  HtmlConstructionSink() {
    (
      exists(BinaryOperation binop |

        (binop.getOperator() = "+" or binop.getOperator() = "%") and
        this.asExpr() = binop and
        binop.getLeftOperand().toString().matches("<[a-zA-Z]+") or
        binop.getRightOperand().toString().matches("<[a-zA-Z]+")
      )
    ) or
    (
      exists(Call call |
        call.getCalleeName().matches("format") and
        this.asExpr() = call and
        call.getReceiver().toString().matches("<[a-zA-Z]+.*")
      )
    ) or
    (
      exists(FormatString fmt |
        this.asExpr() = fmt and
        fmt.getStringValue().matches("<[a-zA-Z]+.*")
      )
    )
  }
}

class HtmlSanitizer extends DataFlow::Node {
  HtmlSanitizer() {
    exists(Call call |
      call.getCalleeName() = "print" and
      this.asExpr() = call
    )
  }
}

class TaintedHtmlStringConfig extends TaintTracking::Configuration {
  TaintedHtmlStringConfig() { this = "TaintedHtmlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlConstructionSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof HtmlSanitizer
  }
}

from TaintedHtmlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected user input flowing into a manually constructed HTML string. " +
  "This could create a cross-site scripting vulnerability. " +
  "Ensure the HTML is rendered safely or use templates.", source, sink
