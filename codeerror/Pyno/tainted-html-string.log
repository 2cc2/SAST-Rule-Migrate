Rule Content:
/**
 * @name Tainted HTML String
 * @description Detected user input flowing into a manually constructed HTML string.
 * @kind problem
 * @problem.severity warning
 * @id py/tainted-html-string
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking
import semmle.python.WebSecurity

class HtmlStringConfig extends TaintTracking::Configuration {
  HtmlStringConfig() { this = "TaintedHtmlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p |
      p.getName() = "event" and
      source.asParameter() = p
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call, BinaryOperation binop |
      (
        (call = sink.asExpr() and 
         (call.getCode().regexpMatch("\"\\$HTMLSTR\" %|\"\\$HTMLSTR\"\\.format|\"\\$HTMLSTR\" \\+|f\"\\$HTMLSTR\\{"))
        ) or
        (binop = sink.asExpr() and 
         binop.getCode().regexpMatch("\"\\$HTMLSTR\" %|\"\\$HTMLSTR\"\\.format|\"\\$HTMLSTR\" \\+|f\"\\$HTMLSTR\\{")
        )
      ) and
      sink.asExpr().getCode().regexpMatch("<[a-zA-Z]+")
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call = sanitizer.asExpr() and
      call.getImportedName() = "print"
    )
  }
}

from HtmlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(),
  "Detected user input flowing into a manually constructed HTML string. This could create a " +
  "cross-site scripting vulnerability. Ensure the HTML is rendered safely or use templates."
