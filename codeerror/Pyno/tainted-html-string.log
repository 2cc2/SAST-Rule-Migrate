Rule Content:
/**
 * @name Tainted HTML String Construction
 * @description Detected user input flowing into a manually constructed HTML string.
 *              This could create a cross-site scripting vulnerability.
 *              Ensure the HTML is rendered safely or use templates.
 * @kind taint-problem
 * @problem.severity warning
 * @id python/tainted-html-string
 */

import python
import semmle.python.Concepts
import semmle.python.security.XSS
import semmle.python.dataflow.TaintTracking

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(Parameter p | 
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class HtmlConstruction extends DataFlow::Node {
  HtmlConstruction() {
    exists(BinaryOperation binOp |
      binOp.getLeftOperand().getText().regexpMatch("\"\\$HTMLSTR\" %|\"\\$HTMLSTR\"\\.format|\"\\$HTMLSTR\" \\+|f\"\\$HTMLSTR.{") and
      binOp.getRightOperand().getText().regexpMatch("<[a-zA-Z]+") and
      this = binOp
    )
    or
    exists(Call c |
      c.getTarget().getText().regexpMatch("\"\\$HTMLSTR\" %|\"\\$HTMLSTR\"\\.format|\"\\$HTMLSTR\" \\+|f\"\\$HTMLSTR.{") and
      c.getAnArgument().getText().regexpMatch("<[a-zA-Z]+") and
      this = c
    )
  }
}

class SafePrintSanitizer extends DataFlow::Node {
  SafePrintSanitizer() {
    exists(Call c |
      c.getTarget().getName() = "print" and
      this = c
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TaintedHtmlStringConstruction" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlConstruction
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafePrintSanitizer
  }
}

from Config cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potentially unsafe HTML construction from user input. Use safe rendering methods."
