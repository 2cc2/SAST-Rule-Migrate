Rule Content:
/**
 * @name Template Unescaped with Safe Filter
 * @description Detects Flask templates where autoescaping is explicitly disabled with '| safe' filter,
 *              which could lead to XSS vulnerabilities if user data is rendered.
 * @kind path-problem
 * @problem.severity warning
 * @id python/flask/template-unescaped-with-safe
 */

import python
import semmle.python.web.flask.Templating 
import semmle.python.Concepts
import DataFlow::PathGraph

class SafeFilterUse extends Expr {
  SafeFilterUse() {
    exists(string pattern |
      pattern.regexpMatch("{{.*?\\|\\s*safe(\\s*}})?") and
      this.(StringLiteral).getText() = pattern
    )
  }
}

class RenderTemplateCall extends API::Call {
  RenderTemplateCall() {
    getTarget().(QualifiedName).matches("flask.render_template") and
    this.getNumArg() > 0
  }

  Expr getTemplateName() { result = this.getArg(0) }
}

class AutoEscapeSanitizer extends Expr {
  AutoEscapeSanitizer() {
    exists(BlockStmt block |
      block.getText() = "{% autoescape true %}" and
      this.getParent+() = block
    )
  }
}

class Config extends DataFlow::Configuration {
  Config() { this = "TemplateUnsafeSafeConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(SafeFilterUse safeFilter |
      source.asExpr() = safeFilter
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RenderTemplateCall call |
      call.getTemplateName() = sink.asExpr()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AutoEscapeSanitizer autoEscape |
      sanitizer.asExpr() = autoEscape
    )
  }
}

from Config config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected a segment of a Flask template where autoescaping is " +
"explicitly disabled with '| safe' filter. This allows rendering of raw HTML in this segment. " +
"Ensure no user data is rendered here, otherwise this is a cross-site scripting (XSS) vulnerability."
