Rule Content:
/**
 * @name Flask template unescaped with safe filter
 * @description Detects Flask template segments where autoescaping is disabled via '|safe' filter,
 *              potentially leading to XSS vulnerabilities if user data is rendered.
 * @kind path-problem
 * @problem.severity warning
 * @id python/flask/xss-template-unescaped-with-safe
 * @tags security
 *       external/cwe/cwe-079
 */

import python
import semmle.python.web.Templating
import DataFlow::PathGraph

class SafeFilterUse extends Expr::Call {
  SafeFilterUse() {
    exists(MethodCall call |
      call.getMethod().getName() = "safe" and
      this = call.getQualifier()
    )
  }
}

class UnsafeTemplateSegment extends Expr::Literal {
  UnsafeTemplateSegment() {
    exists(SafeFilterUse filterUse |
      filterUse.getEnclosingExpr() = this and
      this.getStringValue().regexpMatch(".*\\|\\s*safe(\\s*}})?")
    )
  }
}

class RenderTemplateCall extends Expr::Call {
  RenderTemplateCall() {
    exists(MethodCall call |
      call.getMethod().getName() = "render_template" and
      call.getQualifier().(Name).getId() = "flask" and
      this = call
    )
  }

  int getTemplateArgumentIndex() { result = 1 }
}

class AutoEscapeBlock extends ControlFlow::ControlStructure {
  AutoEscapeBlock() {
    this.getKeyword() = "autoescape" and
    this.getCondition().getStringValue() = "true"
  }
}

predicate isSource(DataFlow::Node source) {
  exists(UnsafeTemplateSegment seg | source.asExpr() = seg)
}

predicate isSink(DataFlow::Node sink) {
  exists(RenderTemplateCall call |
    sink.asExpr() = call.getArgument(call.getTemplateArgumentIndex())
  )
}

predicate isSanitizer(DataFlow::Node sanitizer) {
  exists(AutoEscapeBlock block | sanitizer.asExpr() = block)
}

from DataFlow::PathNode source, DataFlow::PathNode sink, DataFlow::PathNode sanitizer
where
  isSource(source.getNode()) and
  isSink(sink.getNode()) and
  isSanitizer(sanitizer.getNode()) and
  DataFlow::flowPath(source, sanitizer, sink)
select sink.getNode(), "Potential XSS vulnerability: template segment with disabled auto-escaping ($@) " +
  "flows to render_template call without proper escaping", source.getNode(),
  "Unsafe template segment with 'safe' filter"
