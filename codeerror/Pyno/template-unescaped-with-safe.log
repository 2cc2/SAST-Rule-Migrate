Rule Content:
/**
 * @name Flask unsafe template filter with '| safe'
 * @kind problem
 * @problem.severity warning
 * @id python/flask/unsafe-template-filter
 * @description Detected a segment of a Flask template where autoescaping is explicitly
 *              disabled with '| safe' filter. This allows rendering of raw HTML in 
 *              this segment. Ensure no user data is rendered here, otherwise this is
 *              a cross-site scripting (XSS) vulnerability.
 */


import python
import python.StringLiterals
import semmle.python.web.flask.Templating

predicate isUnsafeTemplateFilter(string literal) {
  matches(literal, /{{.*?\\|\\s*safe(\\s*}})?/)
}

from Call renderCall, string templateLit, TemplateParam param
where
  renderCall = flaskRenderTemplate() and
  param = renderCall.getNamedArg("template_name_or_list") and
  templateLit = param.getStringValue() and
  isUnsafeTemplateFilter(templateLit)
select renderCall, 
  "Potentially unsafe template with '| safe' filter, may lead to XSS if user input is rendered.",
  renderCall,
  "Template location"
