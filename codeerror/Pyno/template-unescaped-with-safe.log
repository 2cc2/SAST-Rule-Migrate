Rule Content:
/**
 * @name Flask template with unescaped safe filter
 * @description Detected a segment of a Flask template where autoescaping is explicitly disabled with '| safe' filter.
 *              This allows rendering of raw HTML in this segment. Ensure no user data is rendered here,
 *              otherwise this is a cross-site scripting (XSS) vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @precision high
 * @id py/flask-template-unescaped-safe
 */

import python
import semmle.python.web.flask.Templating
import semmle.python.Concepts

class SafeFilter extends Expr {
  SafeFilter() {
    exists(Str s | s = this.toString() | s.regexpMatch("\\{\\{.*?\\|\\s*safe(\\s*\\}\\})?"))
  }
}

class AutoEscapeControl extends ControlStructure {
  AutoEscapeControl() {
    this.getCode().toString() = "{% autoescape true %}"
  }
}

from Call renderCall, TemplateString templateStr, SafeFilter unsafeFilter
where
  // Source: render_template call with template string
  isFlaskRenderCall(renderCall) and
  templateStr = renderCall.getArg(1) and
  // Sink: unsafe filter used in template
  unsafeFilter.getParent*() = templateStr and
  // Sanitizer: Check if autoescape is enabled
  not exists(AutoEscapeControl autoesc |
    autoesc.getParent*() = templateStr
  )
select unsafeFilter, "Potential XSS vulnerability: template uses '| safe' filter without autoescaping",
  unsafeFilter, "Untrusted input rendered here via '| safe' filter",
  renderCall, "Flask render_template call"
