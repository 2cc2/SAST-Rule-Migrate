Rule Content:
/**
 * @name template-unescaped-with-safe
 * @description Detected a segment of a Flask template where autoescaping is explicitly disabled with '| safe' filter. 
 *              This allows rendering of raw HTML in this segment. Ensure no user data is rendered here, otherwise 
 *              this is a cross-site scripting (XSS) vulnerability.
 * @kind path-problem
 * @problem.severity warning
 * @id py/template-unescaped-with-safe
 */

import python
import templates

class UnsafeTemplateFilter extends TemplateElement::Literal {
  UnsafeTemplateFilter() {
    this.getText().regexpMatch("\\{\\{.*?\\|\\s*safe(\\s*\\}\\})?")
  }
}

class FlaskRenderTemplateCall extends API::Call {
  FlaskRenderTemplateCall() {
    this.hasQualifiedName("flask.templating", "render_template") and
    this.getArg(1).flowsTo(TemplateSource::getAValueElement(_))
  }
}

from UnsafeTemplateFilter unsafe, FlaskRenderTemplateCall render
where unsafe.getTemplate() = render.getArg(1).getTemplate()
select unsafe, "Using '|safe' filter in template with Flask render_template may lead to XSS vulnerability."
