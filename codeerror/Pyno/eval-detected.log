Rule Content:
/**
 * @name eval-detected
 * @description Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. 
 *              If this content can be input from outside the program, this may be a code injection vulnerability. 
 *              Ensure evaluated content is not definable by external sources.
 * @kind path-problem
 * @problem.severity WARNING
 * @id py/eval-detected
 */

import python
import semmle.python.security.injection.CodeInjection

class EvalCall extends DataFlow::Node {
  EvalCall() {
    exists(Call call |
      call.getFunc().(Name).getId() = "eval" and
      call.getArg(0).getText() != "''" and
      result = call.getArg(0)
    )
  }
}

class EmptyStringEvalSanitizer extends DataFlow::Node {
  EmptyStringEvalSanitizer() {
    exists(Call call |
      call.getFunc().(Name).getId() = "eval" and
      call.getArg(0).getText() = "''" and
      result = call.getArg(0)
    )
  }
}

from EvalCall evalCall, DataFlow::Node source
where 
  DataFlow::localFlow(source, evalCall) and
  not exists(EmptyStringEvalSanitizer sanitizer | 
    DataFlow::localFlow(source, sanitizer)
  )
select evalCall, "Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. " +
       "If this content can be input from outside the program, this may be a code injection vulnerability. " +
       "Ensure evaluated content is not definable by external sources."
