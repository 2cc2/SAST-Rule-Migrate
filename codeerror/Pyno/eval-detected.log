Rule Content:
/**
 * @name eval-detected
 * @description Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content. If this content can be input from outside the program, this may be a code injection vulnerability. Ensure evaluated content is not definable by external sources.
 * @kind problem
 * @id python/eval-detected
 * @severity Warning
 */

import python

// 源代码中的 eval() 调用检测
from CallNode call
where call = API::moduleInvoke("builtins", "eval").getACall()
select call, "Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content."

// 检测非空字符串参数的 eval 调用（潜在危险场景）
from CallNode call, Expr arg
where call = API::moduleInvoke("builtins", "eval").getACall() and
      call.getArg(0) = arg and
      not arg.getStringValue() = ""
select call, "Dangerous eval() usage with dynamic content: " + arg.toString()

// 空字符串参数的评测调用（被认为是安全的）
from CallNode call, Expr arg
where call = API::moduleInvoke("builtins", "eval").getACall() and
      call.getArg(0) = arg and
      arg.getStringValue() = ""
select call, "Safe eval() usage with empty string" /* 非告警，仅示例跟踪 */
