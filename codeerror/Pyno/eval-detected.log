Rule Content:
/**
 * @name Detected the use of eval()
 * @description eval() can be dangerous if used to evaluate dynamic content. If this content can be
 *              input from outside the program, this may be a code injection vulnerability. Ensure
 *              evaluated content is not definable by external sources.
 * @kind path-problem
 * @problem.severity warning
 * @id eval-detected
 */

import python
import semmle.python.security.Eval

class EvalDetector extends DangerousCall::Range {
  EvalDetector() {
    this.getTarget() = "eval" and
    not exists(
      this.getArg(0).getStringValue(_) | _ = "\"\""
    )
  }

  override predicate isInteresting(DangerousCall astNode) {
    astNode = any(EvalDetector e)
  }
}

from EvalDetector e
select e, "Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content."
