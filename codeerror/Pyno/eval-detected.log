Rule Content:
/**
 * @name eval-detected
 * @description Detected the use of eval(). eval() can be dangerous if used to evaluate
 *              dynamic content. If this content can be input from outside the program,
 *              this may be a code injection vulnerability. Ensure evaluated content is
 *              not definable by external sources.
 * @kind problem
 * @problem.severity warning
 * @id javascript/eval-detected
 */

import javascript

predicate isDangerousEvalCall(CallExpr call) {
  exists(MethodCall evalCall |
    evalCall = call.getTarget(MethodCall.getMethodName() = "eval") and
    not evalCall.getAnArgument().toString() = "" and
    not evalCall.getAnArgument().toString() = '""'
  )
}

from CallExpr call
where isDangerousEvalCall(call)
select call, "Detected the use of eval(). eval() can be dangerous if used to evaluate dynamic content."
