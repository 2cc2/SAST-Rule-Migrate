Rule Content:
/**
 * @name SQLAlchemy SQL Injection via Event Object
 * @description Detected SQL statement that is tainted by `event` object. This could 
 *              lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class LambdaEventHandler extends DataFlow::Node {
  LambdaEventHandler() {
    exists(Function f |
      f.getName() = "$HANDLER" and
      this.asParameter() = f.getParameter(0) and
      f.getParameter(0).getName() = "event"
    )
  }
}

class SqlAlchemyExecute extends DataFlow::Node {
  SqlAlchemyExecute() {
    exists(Call call |
      call.getTarget().(Method).getDeclaringType().hasQualifiedName("sqlalchemy", "Cursor") and
      call.getTarget().(Method).getName() = "execute" and
      this = call.getArgument(0)
    )
  }
}

module TaintTracking::SQLInjection implements TaintTracking::Configuration {
  predicate isSource(DataFlow::Node source) { source instanceof LambdaEventHandler }
  predicate isSink(DataFlow::Node sink) { sink instanceof SqlAlchemyExecute }
}
