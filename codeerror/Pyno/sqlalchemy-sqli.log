Rule Content:
/**
 * @name sqlalchemy-sqli
 * @description Detected SQL statement that is tainted by `event` object.
 *   This could lead to SQL injection if the variable is user-controlled
 *   and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class LambdaEventSource extends RemoteFlowSource {
  LambdaEventSource() {
    exists(Method m, Parameter p |
      m.hasName("$HANDLER") and
      p = m.getParameter(0) and
      p.hasName("event") and
      this = p.getSource()
    )
  }
}

class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("execute") and
      ma.getReceiver().getType().hasName("Cursor") and
      ma.getReceiver().getType().getAPackage().hasName("sqlalchemy") and
      this = ma.getArgument(0)
    )
  }
}

class SqlalchemySqliConfig extends TaintTracking::Configuration {
  SqlalchemySqliConfig() { this = "SqlalchemySqliConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaEventSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    // No sanitizers defined
    false
  }
}

from SqlalchemySqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected SQL statement that is tainted by `event` object. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
