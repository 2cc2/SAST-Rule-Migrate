Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Detected SQL statement that is tainted by `event` object. 
 *              This could lead to SQL injection if the variable is user-controlled 
 *              and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sqli
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.dataflow.TaintTracking
import sqlalchemy

class LambdaEventSource extends DataFlow::Source {
  LambdaEventSource() {
    exists(Method m, Parameter p |
      m.getName() = "$HANDLER" and
      p.getCallable() = m and
      p.getName() = "event"
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    exists(Parameter p |
      p = source.asParameter() and
      p.getName() = "event" and
      exists(Method m |
        p.getCallable() = m and
        m.getName() = "$HANDLER"
      )
    )
  }
}

class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() { 
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getQualifier().getType().hasQualifiedName("sqlalchemy", "Cursor") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

query predicate sqlInjectionFlow(DataFlow::PathNode source, DataFlow::PathNode sink) {
  exists(LambdaEventSource eventSource, SqlExecuteSink sqlSink |
    TaintTracking::localTaint(source, sink) and
    source.getNode() = eventSource and
    sink.getNode() = sqlSink
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where sqlInjectionFlow(source, sink)
select sink, "Potential SQL injection from AWS Lambda event parameter", source,
  "This SQL query might be tainted by user input from the Lambda event parameter"
