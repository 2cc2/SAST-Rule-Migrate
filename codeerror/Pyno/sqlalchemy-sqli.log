Rule Content:
/**
 * @name SQLAlchemy SQL Injection via event parameter
 * @description Detected SQL statement that is tainted by `event` object.
 * @id sqlalchemy-sqli
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Method m, Parameter p |
      m.getName() = "$HANDLER" and
      p = m.getAParameter() and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getMethod().getDeclaringType().getName() = "Cursor" and
      ma.getMethod().getDeclaringType().getAPackageName() = "sqlalchemy" and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class TaintTrackingConfiguration extends TaintTracking::Configuration {
  TaintTrackingConfiguration() { this = "SQLAlchemyEventSQLi" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaEventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecutionSink }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagate taint through argument to parameter flows
    exists(Method m, Parameter p, Argument arg |
      m.getAParameter() = p and
      arg = m.getAnArgument() and
      node1.asExpr() = arg and
      node2.asParameter() = p
    )
  }
}

from TaintTrackingConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected SQL statement that is tainted by `event` object. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
