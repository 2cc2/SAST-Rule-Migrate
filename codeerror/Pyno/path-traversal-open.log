Rule Content:
/**
 * @name Path Traversal in File Open
 * @description Detects request data flowing into open() calls without validation,
 *              which could lead to path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getTarget().hasQualifiedName("flask", "request", _) and
      (call.getMethodName() = "get" or call.getMethodName() = "__getitem__" or call.getMethodName() = "__call__") and
      result = call.asValue()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      result = p.asVariable().getAValue()
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(MethodCall call |
      call.getTarget().hasQualifiedName("builtins", "open") and
      result = call.getArgument(0).asValue()
    )
  }
}

class PathTraversalFlowConfig extends TaintTracking::Configuration {
  PathTraversalFlowConfig() { this = "PathTraversalFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }
}

from PathTraversalFlowConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
