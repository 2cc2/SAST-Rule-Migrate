Rule Content:
/**
 * @name Path Traversal in open() call
 * @id path-traversal-open
 * @description Found request data in a call to 'open'. Ensure the request data is validated 
 *    or sanitized, otherwise it could result in path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 */

import python
import semmle.python.security.RequestTaint
import semmle.python.security.dataflow.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    (
      // Flask request method calls
      exists(MethodCall call |
        call.getMethod().(Method).getName().regexpMatch("(get|__getitem__|__call__)") and
        call.getReceiver().(Value).getType().getName() = "request" and
        call.getReceiver().(Value).getType().getFile().getAbsolutePath().matches("%flask/request.py")
      ) and
      this.asExpr() = any(MethodCall call).getResult()
    )
    or
    // Route parameters
    exists(FunctionDef::Parameter p |
      p.getName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this.asParameter() = p
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(Call call |
      call.getCallee().(Value).getType().getName() = "" and
      call.getCallee().(Value).getUnderlyingType().getName() = "builtins" and
      call.getCallee().(Value).getMember().getName() = "open" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from PathTraversalConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
