/**
 * @name Path Traversal in File Open
 * @description Detects potential path traversal vulnerability when Flask request data is used in file open operation without proper validation
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getMethod().(Method).getName() in ["get", "__getitem__", "__call__"] and
      call.getObject().getType().getName() = "Request" and
      call.getObject().getType().getSourceDeclaration().getFile().getAbsolutePath().matches("%flask/request.py")
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p |
      p.getName() =~ /\$ROUTEVAR|\$INTERM/
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(Call call |
      call.getFunc().(Name).getId() = "open" and
      call.getFunc().getLocation().getFile().getAbsolutePath().matches("%builtins%/")
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink = any(FileOpenSink fos).getArgument(0)
  }
}

from PathTraversalConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, source, 
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
