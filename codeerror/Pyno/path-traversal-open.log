Rule Content:
/**
 * @name Path Traversal via open()
 * @description Detects potential path traversal vulnerabilities when request data is used in file open operations
 * @kind path-problem
 * @problem.severity error
 * @id py/path-traversal-open
 * @tags security
 * [...]/
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask.request", ["get", "__getitem__", "__call__"])
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    exists(MethodAccess ma |
      source.asExpr() = ma.getAnArg() and
      ma.getMethod().hasQualifiedName("flask.request", ["get", "__getitem__", "__call__"])
    )
  }
}

class RouteParamSource extends DataFlow::Source {
  RouteParamSource() {
    exists(Parameter p |
      p.getName().matches("%ROUTEVAR%|%INTERM%")
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    exists(Parameter p |
      source.asParameter() = p and
      p.getName().matches("%ROUTEVAR%|%INTERM%")
    )
  }
}

class FileOpenSink extends DataFlow::Sink {
  FileOpenSink() {
    exists(FunctionCall fc |
      fc.getTarget().hasQualifiedName("builtins", "open") and
      this = fc.getArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(FunctionCall fc |
      fc.getTarget().hasQualifiedName("builtins", "open") and
      sink.asExpr() = fc.getArgument(0)
    )
  }
}

predicate isSanitizer(DataFlow::Node node) { none() }

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  (source.getNode() instanceof FlaskRequestSource or
   source.getNode() instanceof RouteParamSource) and
  sink.getNode() instanceof FileOpenSink and
  DataFlow::localFlow(source, sink)
select sink, source, sink,
  "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
