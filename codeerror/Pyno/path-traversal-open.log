Rule Content:
/**
 * @id path-traversal-open
 * @name Path traversal in open() call from request data
 * @description Found request data in a call to 'open'. Ensure the request data is validated or sanitized,
 *              otherwise it could result in path traversal attacks.
 * @kind path-problem
 * @problem.severity error
 */

import python
import semmle.python.security.ApiTaintTracking
import semmle.python.security.PathsAndFiles
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["get", "__getitem__", "__call__"] and
      ma.getReceiver().getType().hasQualifiedName("flask.request") and
      this.asExpr() = ma
    )
  }
}

class RouteVarSource extends DataFlow::Node {
  RouteVarSource() {
    exists(Parameter p |
      p.getAnnotatedName().regexpMatch("\\$ROUTEVAR|\\$INTERM") and
      this.asParameter() = p
    )
  }
}

class FileOpenSink extends DataFlow::Node {
  FileOpenSink() {
    exists(Call call |
      call.getFunc().(Name).getId() = "open" and
      this.asExpr() = call.getArg(0)
    )
  }
}

predicate isSanitizer(DataFlow::Node node) { none() }

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteVarSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileOpenSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    isSanitizer(node)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, PathTraversalConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found request data in a call to 'open'. Ensure the request data is validated or sanitized."
