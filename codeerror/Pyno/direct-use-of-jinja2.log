Rule Content:
/**
 * @name Direct use of jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping which opens up the application to cross-site scripting (XSS) vulnerabilities. Prefer using the Flask method 'render_template()' and templates with a '.html' extension in order to prevent XSS.
 * @kind path-problem
 * @problem.severity warning
 * @id py/direct-use-of-jinja2
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class Jinja2Environment extends DataFlow::Node {
  Jinja2Environment() {
    exists(Import imp |
      imp.getModule().getName() = "jinja2" and
      imp.getFuncName() = "Environment"
    )
    or
    exists(CallNode call |
      call.getFunc().getName() = "Environment" and
      call.getFunc().getQualifier().getName() = "jinja2"
    )
  }
}

class Jinja2TemplateRender extends DataFlow::Node {
  Jinja2TemplateRender() {
    exists(CallNode call |
      call.getFunc().getName() = "render" and
      call.getFunc().getQualifier().getType().getName() = "Template" and
      call.getFunc().getQualifier().getQualifier().getName() = "jinja2"
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "DirectJinja2Use" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof Jinja2Environment
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof Jinja2TemplateRender
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
      param = node1.asParameter() and
      arg = node2.asArgument() and
      arg.(ArgumentNode).isArgumentOf(param)
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Direct use of jinja2 detected which may bypass HTML escaping, making the application vulnerable to XSS."
