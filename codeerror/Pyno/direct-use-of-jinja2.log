Rule Content:
/**
 * @name Direct Use of Jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping
 *              which opens up the application to cross-site scripting (XSS) vulnerabilities.
 *              Prefer using the Flask method 'render_template()' and templates with a '.html'
 *              extension in order to prevent XSS.
 * @kind path-problem
 * @problem.severity warning
 * @id python/direct-use-of-jinja2
 */

import python
import semmle.python.security.xss.Jinja2
import DataFlow::PathGraph

class Jinja2EnvironmentCreation extends DataFlow::Node {
  Jinja2EnvironmentCreation() {
    exists(MethodCall mc |
      mc.getTarget().getName() = "Environment" and
      mc.getTarget().getAPackage().getName() = "jinja2" and
      this.asExpr() = mc.getQualifier()
    )
  }
}

class Jinja2TemplateRender extends DataFlow::Node {
  Jinja2TemplateRender() {
    exists(MethodCall mc |
      mc.getTarget().getName() = "render" and
      mc.getTarget().getAPackage().getName() = "jinja2" and
      exists(Type t | t.hasName("Template") and mc.getTarget().getDeclaringType() = t) and
      this.asExpr() = mc
    )
  }
}

class Jinja2TemplateFlow extends DataFlow::Node {
  Jinja2TemplateFlow() {
    exists(MethodCall getTemplate, MethodCall render |
      getTemplate.getTarget().getName() = "get_template" and
      getTemplate.getTarget().getAPackage().getName() = "jinja2" and
      render.getTarget().getName() = "render" and
      render.getTarget().getAPackage().getName() = "jinja2" and
      exists(DataFlow::LocalSourceNode tplVar |
        tplVar.asExpr() = getTemplate and
        tplVar.asExpr() = render.getQualifier()
      ) and
      this.asExpr() = render
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "DirectJinja2UsageConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof Jinja2EnvironmentCreation or
    source instanceof Jinja2TemplateRender or
    source instanceof Jinja2TemplateFlow
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof Jinja2TemplateRender
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Direct use of jinja2 may bypass HTML escaping, creating XSS vulnerabilities. Use Flask's render_template() instead.", source, "Potential XSS source"
