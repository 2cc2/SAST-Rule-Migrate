Rule Content:
/**
 * @name Direct use of jinja2 without proper HTML escaping
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML
 *              escaping which opens up the application to cross-site scripting (XSS) 
 *              vulnerabilities. Prefer using the Flask method 'render_template()' and 
 *              templates with a '.html' extension to prevent XSS.
 * @kind taint
 * @problem.severity warning
 * @id python/direct-use-of-jinja2
 */

import python
import semmle.python.security.TaintTracking

class Jinja2Environment extends DataFlow::Node {
  Jinja2Environment() {
    exists(Import imp |
      imp.getImportedName() = "jinja2" and
      this.asExpr() = imp.getEnclosingScope().getACall("Environment")
    )
  }
}

class Jinja2TemplateRender extends DataFlow::Node {
  Jinja2TemplateRender() {
    exists(Import imp |
      imp.getImportedName() = "jinja2" and
      this.asExpr() = imp.getEnclosingScope().getACall("render") and
      getType(this.asExpr()).getMethod().getDeclaringType().hasQualifiedName("jinja2", "Template")
    )
  }
}

class Jinja2TemplateFlow extends DataFlow::Node {
  Jinja2TemplateFlow() {
    exists(DataFlow::Node template, DataFlow::Node envCall |
      envCall.asExpr() = any(Jinja2Environment env).asExpr() and
      exists(Call getTemplateCall |
        getTemplateCall.getTarget().toString() = "get_template" and
        getTemplateCall.getReceiver() = envCall.asExpr() and
        template.asExpr() = getTemplateCall
      ) and
      this.asExpr() = template.asExpr().getACall("render")
    )
  }
}

class Jinja2Config extends TaintTracking::Configuration {
  Jinja2Config() { this = "Jinja2 unsafe rendering configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof Jinja2Environment or
    source instanceof Jinja2TemplateRender or
    source instanceof Jinja2TemplateFlow
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof Jinja2TemplateRender
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from Jinja2Config config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Direct use of jinja2 without proper HTML escaping may lead to XSS vulnerabilities. " +
  "Use Flask's render_template() with .html templates instead."
