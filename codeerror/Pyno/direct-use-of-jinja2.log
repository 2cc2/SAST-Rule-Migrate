/**
 * @name Direct use of jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping which opens up the application to cross-site scripting (XSS) vulnerabilities.
 * @kind path-problem
 * @problem.severity warning
 * @id python/direct-use-of-jinja2
 */

import python
import semmle.python.security.XSS
import DataFlow::PathGraph

class Jinja2Environment extends DataFlow::Node {
  Jinja2Environment() {
    exists(ImportImport imp | imp.getImportedName() = "jinja2" |
      this = API::moduleExpr("jinja2", "Environment").getAValue()
    )
  }
}

class Jinja2TemplateRender extends DataFlow::Node {
  Jinja2TemplateRender() {
    exists(MethodCallNode call |
      call.getMethodName() = "render" and
      exists(ImportImport imp | imp.getImportedName() = "jinja2" |
        call.getReceiver().getType().(ClassType).getSourceDeclaration().getName() = "Template" and
        call.getReceiver().getType().(ClassType).getSourceDeclaration().getFile().getBaseName() = "environment.py"
      ) |
      this = call
    )
  }
}

class TemplateFlowConfiguration extends DataFlow::Configuration {
  TemplateFlowConfiguration() { this = "TemplateFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof Jinja2Environment or
    source instanceof Jinja2TemplateRender
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof Jinja2TemplateRender
  }
}

from TemplateFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected direct use of jinja2. If not done properly, this may bypass HTML escaping which opens up the application to cross-site scripting (XSS) vulnerabilities. " +
  "Prefer using the Flask method 'render_template()' and templates with a '.html' extension in order to prevent XSS.",
  source, sink,
  "Direct jinja2 usage"
