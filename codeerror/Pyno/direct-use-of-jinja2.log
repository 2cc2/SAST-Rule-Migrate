Rule Content:
/**
 * @name Direct Use of Jinja2
 * @description Detected direct use of jinja2. If not done properly, this may bypass HTML escaping
 *              which opens up the application to cross-site scripting (XSS) vulnerabilities.
 *              Prefer using the Flask method 'render_template()' and templates with a '.html'
 *              extension in order to prevent XSS.
 * @kind taint
 * @problem.severity warning
 * @id python/direct-use-of-jinja2
 */

import python
import semmle.python.security.jinja2.TaintTracking
import DataFlow::PathGraph

class Jinja2Environment extends DataFlow::Node {
  Jinja2Environment() {
    exists(MethodCall mc |
      mc.getTarget().hasQualifiedName("jinja2", "Environment") and
      this.asExpr() = mc
    )
  }
}

class Jinja2Template extends DataFlow::Node {
  Jinja2Template() {
    exists(MethodCall mc |
      mc.getTarget().hasQualifiedName("jinja2", "Template") and
      this.asExpr() = mc
    )
  }
}

class Jinja2Render extends DataFlow::Node {
  Jinja2Render() {
    exists(MethodCall mc |
      mc.getTarget().hasQualifiedName("jinja2", "Template", "render") and
      this.asExpr() = mc.getACall()
    )
  }
}

class Jinja2Configuration extends TaintTracking::Configuration {
  Jinja2Configuration() { this = "Jinja2TaintTracking" }

  override predicate isSource(DataFlow::Node source) {
    exists(Jinja2Environment env | source.asExpr() = env.getCall()) or
    exists(Jinja2Template template | source.asExpr() = template.getCall())
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Jinja2Render render | sink.asExpr() = render.getACall())
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Argument arg, Parameter param |
      DataFlow::localFlowStep(arg, param) and
      node1.asExpr() = arg and
      node2.asExpr() = param
    )
  }
}

from Jinja2Configuration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Direct use of jinja2 may bypass HTML escaping leading to XSS vulnerabilities. " +
       "Prefer using Flask's 'render_template()' with '.html' templates instead."
