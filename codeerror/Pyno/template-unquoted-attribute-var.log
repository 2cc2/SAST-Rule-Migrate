Rule Content:
/**
 * @name Template unquoted attribute variable
 * @kind problem
 * @problem.severity warning
 * @description Detected a unquoted template variable as an attribute. If unquoted, 
 *              a malicious actor could inject custom JavaScript handlers.
 * @id python/template-unquoted-attribute-var
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.web.flask.Request

class UntrustedInputSource extends DataFlow::Node {
  UntrustedInputSource() {
    exists(MethodCall call |
      call.getMethod().(Method).getName() = "get" and
      call.getMethod().getDeclaringType().hasQualifiedName("flask", "request") and
      call.getArg(0) = this and
      call.getNumArg() > 0
    )
    or
    exists(MethodCall call |
      call.getMethod().(Method).getName() = "__getitem__" and
      call.getMethod().getDeclaringType().hasQualifiedName("flask", "request") and
      call.getArg(0) = this and
      call.getNumArg() > 0
    )
  }
}

class UnquotedAttributeSink extends DataFlow::Node {
  UnquotedAttributeSink() {
    exists(Literal l |
      l = this and
      regexpMatch("=\\$\\{\\{\\{.*\\}\\}\\}", l.getStringValue())
    )
  }
}

class SafeQuotedAttribute extends DataFlow::BarrierGuard {
  SafeQuotedAttribute() {
    exists(Literal l |
      l = this and
      regexpMatch("=\\\\\"\\{\\{\\{\\$.*\\}\\\\}\\\\\"", l.getStringValue())
    )
  }
}

class FlaskTemplateUnquotedAttrConfig extends TaintTracking::Configuration {
  FlaskTemplateUnquotedAttrConfig() { this = "Flask template unquoted attribute" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UntrustedInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnquotedAttributeSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeQuotedAttribute
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(FunctionCall fc, Argument arg, Parameter p |
      arg = pred and
      fc.getAPrimaryQlClass() = arg.getAPrimaryQlClass() and
      fc.getAnArgument() = arg and
      p = fc.getParameter(arg) and
      succ = p.getAnAccess()
    )
  }
}

