Rule Content:
/**
 * @id template-unquoted-attribute-var
 * @severity Warning
 * @kind path-problem
 * @name Unquoted template variable as an attribute
 * @description Detected a unquoted template variable as an attribute. If unquoted, a malicious actor could inject custom JavaScript handlers.
 * @tags security
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.ApiGraphs

class FlaskRequestGetSource extends RemoteFlowSource::Range {
  FlaskRequestGetSource() {
    exists(MethodCallNode call, Method method |
      call.getMethod() = method and
      method.getName() = "get" and
      method.getDeclaringType().hasQualifiedName("flask.request", "request") and
      call.getArgument(0) = this.asExpr()
    )
  }
}

class FlaskRequestArraySource extends RemoteFlowSource::Range {
  FlaskRequestArraySource() {
    exists(MethodCallNode call, Method method |
      call.getMethod() = method and
      method.getName() = "__getitem__" and
      method.getDeclaringType().hasQualifiedName("flask.request", "request") and
      call.getArgument(0) = this.asExpr()
    )
  }
}

class UnquotedTemplateSink extends DataFlow::Node {
  UnquotedTemplateSink() {
    exists(StringLiteral literal |
      this.asExpr() = literal and
      literal.getText().matches("={{.*}}")
    )
  }
}

class QuotedTemplateSanitizer extends DataFlow::Node {
  QuotedTemplateSanitizer() {
    exists(StringLiteral literal |
      this.asExpr() = literal and
      literal.getText().matches("=\\\".*{{.*}}\\\"")
    )
  }
}

configuration findTemplateUnquotedAttr : TaintTracking::Configuration {
  findTemplateUnquotedAttr =
    TaintTracking::Configuration {
      "Template unquoted attribute variable"
    } and
    TaintTracking::Configuration.hasFlowPath(
      any(FlaskRequestGetSource s |
        s instanceof FlaskRequestGetSource
      ).or(
        any(FlaskRequestArraySource s |
          s instanceof FlaskRequestArraySource
        )
      ),
      any(UnquotedTemplateSink sink |
        sink instanceof UnquotedTemplateSink and
        not exists(QuotedTemplateSanitizer sanitizer |
          sanitizer instanceof QuotedTemplateSanitizer and
          TaintTracking::Configuration.hasFlowBetween(source, sanitizer)
        )
      )
    )
}
