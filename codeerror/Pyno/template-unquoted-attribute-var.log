Rule Content:
/**
 * @name template-unquoted-attribute-var
 * @description Detected a unquoted template variable as an attribute. If unquoted, a malicious actor could inject custom JavaScript handlers.
 * @kind path-problem
 * @problem.severity warning
 * @id py/template-unquoted-attribute-var
 */

import python
import semmle.python.security.dataflow.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    // Source: flask.request.get() with arg_index=0
    exists(MethodCallNode call |
      call.getMethod().getQualifiedName() = "flask.request.get" and
      call.getArgument(0) = this
    )
    or
    // Source: flask.request.__getitem__() with arg_index=0
    exists(MethodCallNode call |
      call.getMethod().getQualifiedName() = "flask.request.__getitem__" and
      call.getArgument(0) = this
    )
  }
}

class UnquotedAttributeSink extends DataFlow::Node {
  UnquotedAttributeSink() {
    // Match unquoted template attributes like ={...}
    exists(StringLiteral str |
      str.getValue().regexpMatch("=\\{.+\\}") and
      this = str
    )
  }
}

class QuotedAttributeSanitizer extends DataFlow::Node {
  QuotedAttributeSanitizer() {
    // Match quoted template attributes like ="{...}"
    exists(StringLiteral str |
      str.getValue().regexpMatch("=\\\".*\\{\\{.+\\}\\}\\\"") and
      this = str
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TemplateUnquotedAttributeVar" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnquotedAttributeSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof QuotedAttributeSanitizer
  }
}

