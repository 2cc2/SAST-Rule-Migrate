/**
 * @name TemplateUnquotedAttributeVar
 * @description Detects unquoted template variables as HTML attributes that could allow JS injection
 * @kind path-problem
 * @id python/template-unquoted-attribute-var
 * @problem.severity warning
 * @tags security
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask

class UntrustedInput extends DataFlow::Node {
  UntrustedInput() {
    exists(MethodCall call |
      call.getMethod().getName() = "get" and
      call.getMethod().getDeclaringType().getName() = "request" and
      call.getQualifier().getType().getName() = "flask.request" and
      call.getArgument(0) = this
    )
    or
    exists(MethodCall call |
      call.getMethod().getName() = "__getitem__" and
      call.getMethod().getDeclaringType().getName() = "request" and
      call.getQualifier().getType().getName() = "flask.request" and
      call.getArgument(0) = this
    )
  }
}

class UnquotedAttribute extends DataFlow::Node {
  UnquotedAttribute() {
    exists(string literal |
      literal = this.asExpr().getStringValue() and
      regexpMatch("=\\{.+\\}", literal)
    )
  }
}

class QuotedAttribute extends DataFlow::Node {
  QuotedAttribute() {
    exists(string literal |
      literal = this.asExpr().getStringValue() and
      regexpMatch("=\\\\\".*\\{\\{.+\\}\\\\}\\\\\"", literal)
    )
  }
}

class TaintConfig extends TaintTracking::Configuration {
  TaintConfig() { this = "TemplateUnquotedAttributeVar" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UntrustedInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnquotedAttribute and
    not exists(QuotedAttribute quoted | quoted = sink)
  }
}

from TaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), "Detected a unquoted template variable as an attribute. " +
  "If unquoted, a malicious actor could inject custom JavaScript handlers.", 
  source.getNode(), "User input flows here"
================================================================================
