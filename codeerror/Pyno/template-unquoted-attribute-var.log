/**
 * @name Template unquoted attribute variable
 * @description Detected a unquoted template variable as an attribute. If unquoted, 
 *              a malicious actor could inject custom JavaScript handlers.
 * @kind taint-problem
 * @problem.severity warning
 * @id template-unquoted-attribute-var
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Request

class UntrustedInputSource extends DataFlow::Node {
  UntrustedInputSource() {
    exists(Call call |
      call = API::moduleImport("flask").getMember("request").getMember("get").getACall() and
      call.getArg(0) = this
    ) 
    or
    exists(Call call |
      call = API::moduleImport("flask").getMember("request").getMember("__getitem__").getACall() and
      call.getArg(0) = this
    )
  }
}

class UnquotedAttributeSink extends DataFlow::Node {
  UnquotedAttributeSink() {
    exists(StringLiteral literal |
      regexMatches("=\\{\\{\\{\\$.*\\}\\}\\}", literal.getStringValue()) and
      this.asExpr() = literal
    )
  }
}

class QuotedAttributeSanitizer extends DataFlow::BarrierGuard {
  QuotedAttributeSanitizer() {
    exists(StringLiteral literal |
      regexMatches("=\\\\\"\\{\\{\\{\\$.*\\}\\\\}\\\\\"", literal.getStringValue()) and
      this.asExpr() = literal
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TemplateAttributesConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UntrustedInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UnquotedAttributeSink
  }

  override predicate isSanitizerGuard(DataFlow::BarrierGuard guard) {
    guard instanceof QuotedAttributeSanitizer
  }
}

