/**
 * @name paramiko-exec-command
 * @description Unverified SSL context detected. This will permit insecure connections 
 *              without verifying SSL certificates. Use 'ssl.create_default_context()' instead.
 * @kind taint
 * @problem.severity ERROR
 * @id python/paramiko-exec-command
 */

import python
import semmle.python.security.TaintTracking

class ParamikoClientInit extends Call {
  ParamikoClientInit() {
    this.getTarget().(NamedExpr).getValue().(Name).getString() = "SSHClient" and
    this.getTarget().getAttr().getString() = "__init__" and
    this.getTarget().getAnnType().(ImportExpr).getName() = "paramiko.client"
  }
}

class SSHClienExecCommandCall extends Call {
  SSHClienExecCommandCall() {
    this.getTarget().getAttr().getString() = "exec_command" and
    this.getTarget().getAnnType().(ImportExpr).getName() = "paramiko.client" and
    this.getTarget().(NamedExpr).getValue().(Name).getString() = "SSHClient" and
    not this.getArg(0).getValue().(Str).getString() = "\"...\""
  }
}

class SSHCientToExecCommand extends TaintTracking::Configuration {
  SSHCientToExecCommand() { this = "SSHCientToExecCommand" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(ParamikoClientInit c |
      source.asExpr() = c.getReceiver()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SSHClienExecCommandCall c |
      sink.asExpr() = c.getReceiver()
    )
  }
}

from SSHCientToExecCommand cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Unverified SSL context detected. This will permit insecure connections without " +
             "verifying SSL certificates. Use 'ssl.create_default_context()' instead."
