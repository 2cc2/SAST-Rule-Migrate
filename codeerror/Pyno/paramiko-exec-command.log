Rule Content:
/**
 * @name Unverified SSL context in Paramiko SSHClient exec_command
 * @description Detects insecure SSL context usage in Paramiko's SSHClient exec_command calls
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class ParamikoSSHClientInit extends API::ReceiverCall {
  ParamikoSSHClientInit() {
    exists(API::Node pkg |
      pkg = API::package("paramiko.client") and
      this.getTarget().getType() = API::class_(pkg, "SSHClient")
    )
  }
}

class SSHExecCommandCall extends API::MethodCall {
  SSHExecCommandCall() {
    exists(API::Node pkg, API::Node cls |
      pkg = API::package("paramiko.client") and
      cls = API::class_(pkg, "SSHClient") and
      this.getTarget() = API::method(cls, "exec_command", _) and
      not this.getArg(0).getValueText() = "\"...\""
    )
  }
}

class ParamikoSSHClientConfiguration extends TaintTracking::Configuration {
  ParamikoSSHClientConfiguration() { this = "ParamikoSSHClientConfiguration" }

  override predicate isSource(TaintTracking::Source src) {
    src instanceof ParamikoSSHClientInit
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof SSHExecCommandCall
  }
}

from ParamikoSSHClientConfiguration cfg, TaintTracking::Source src, TaintTracking::Sink sink
where cfg.hasFlow(src, sink)
select sink, 
  "Unverified SSL context detected. This will permit insecure connections without verifying SSL certificates. Use 'ssl.create_default_context()' instead."
