/**
 * @name paramiko-exec-command
 * @description Unverified SSL context detected. This will permit insecure connections without verifying SSL certificates. Use 'ssl.create_default_context()' instead.
 * @kind taint
 * @problem.severity ERROR
 * @id py/paramiko-insecure-exec
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.ApiGraphs

class ParamikoSSHClientInit extends DataFlow::Node {
  ParamikoSSHClientInit() {
    exists(API::ModuleImport mi |
      mi.getName() = "paramiko.client" and
      exists(API::Class c | 
        c.getModuleImport() = mi and 
        c.getName() = "SSHClient" and
        this = API::getConstructorCall(c)
      )
    )
  }
}

class ExecCommandCall extends DataFlow::Node {
  ExecCommandCall() {
    exists(API::MethodCall mc |
      mc.getMethodName() = "exec_command" and
      not mc.getArgument(0).getStringValue() = '"..."' and
      exists(API::Class c |
        c.getName() = "SSHClient" and
        mc.getReceiver().getType() = c.getQualifiedName()
      )
    )
  }
}

class ParamikoTaintConfig extends TaintTracking::Configuration {
  ParamikoTaintConfig() { this = "ParamikoSSHClientTaintTracking" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ParamikoSSHClientInit
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecCommandCall
  }

  override predicate isExtension(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagate taint through receiver->call
    exists(MethodCall mc | 
      node1 = mc.getReceiver() and 
      node2 = mc and
      node2 instanceof ExecCommandCall
    )
  }
}

from ParamikoTaintConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Unverified SSL context detected. This will permit insecure connections without verifying SSL certificates. Use 'ssl.create_default_context()' instead."
