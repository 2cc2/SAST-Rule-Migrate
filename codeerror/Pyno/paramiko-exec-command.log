Rule Content:
/**
 * @name Unverified SSH context detected
 * @description Using paramiko SSHClient.exec_command with unsanitized input may lead to command injection
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 */

import python
import semmle.python.security.ParamTaint
import DataFlow::PathGraph

class ParamikoSSHClient extends Value::Definition {
  ParamikoSSHClient() {
    exists(Value::ModuleImport mi |
      mi.getName() = "paramiko.client" and
      this = mi.getAPackage().getClass("SSHClient").getConstructor().getReturn()
    )
  }
}

class ExecCommandCall extends Value::Call {
  ExecCommandCall() {
    exists(Value::Method execCommand |
      execCommand.hasName("exec_command") and
      execMethod.getDeclaringType().hasName("SSHClient") and
      execMethod.getDeclaringType().getAPackage().getName() = "paramiko.client" and
      this = execCommand.getACall()
    ) and
    // Skip calls with literal strings "..."
    not this.getArg(0).getConstantValue().toString() = "\"...\""
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "SSHCommandInjection" }

  override predicate isSource(DataFlow::Node source) {
    exists(ParamikoSSHClient sshClient |
      source.asExpr() = sshClient
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(ExecCommandCall call |
      sink.asExpr() = call.getArg(0)
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Value::Call call |
      call.getQualifier() = node1.asExpr() and
      node2.asExpr() = call
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Unverified SSH context detected. This will permit insecure connections without " +
  "verifying SSL certificates. Use 'ssl.create_default_context()' instead.", source, sink
