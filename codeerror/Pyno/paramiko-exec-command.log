Rule Content:
/**
 * @name paramiko-exec-command
 * @description Unverified SSL context detected. This will permit insecure connections without verifying SSL certificates. Use 'ssl.create_default_context()' instead.
 * @kind path-problem
 * @problem.severity error
 * @id python/paramiko-exec-command
 */

import python
import semmle.python.security.TaintTracking

class SSHClientInit extends DataFlow::Node {
  SSHClientInit() {
    exists(FunctionValue f |
      f.getPackage().getName() = "paramiko.client" and
      f.getType().getName() = "SSHClient" and
      this.asExpr() = f.getCall()
    )
  }
}

class ExecCommandCall extends DataFlow::Node {
  ExecCommandCall() {
    exists(MethodValue m |
      m.getPackage().getName() = "paramiko.client" and
      m.getType().getName() = "SSHClient" and
      m.getName() = "exec_command" and
      this.asExpr() = m.getCall() and
      exists(Argument arg |
        arg.getCall() = this.asExpr() and
        arg.getPosition() = 0 and
        not arg.getValue().(StringLiteral).getValue() = "..."
      )
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "paramiko_exec_command_taint_tracking" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SSHClientInit
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecCommandCall
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Unverified SSL context detected. This will permit insecure connections without verifying SSL certificates. Use 'ssl.create_default_context()' instead."
