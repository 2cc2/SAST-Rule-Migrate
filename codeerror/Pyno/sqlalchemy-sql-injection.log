Rule Content:
/**
 * @id sqlalchemy-sql-injection
 * @severity Warning
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause SQL injections 
 *              if raw SQL with user input is used without bindparams
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.ApiGraphs

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(string name |
      this instanceof Parameter and
      name = this.getName() and
      regexpMatch("\$VAR", name)
    )
  }
}

class DangerousFunction extends DataFlow::Node {
  DangerousFunction() {
    exists(MethodCall call |
      call = this.(MethodCall).getMethodCall() and
      call.getMethodName() = ["group_by", "order_by", "distinct", "having", "filter"] and
      exists(call.getReceiver() |
        regexpMatch(".*\$FORMATFUNC\(.*\$VAR.*\)", this.getCode())
      )
    )
  }
}

class BindParamsSanitizer extends DataFlow::BarrierGuard {
  BindParamsSanitizer() { this = "bindparams" }
}

private class SqlAlchemyTaintConfig extends TaintTracking::Configuration {
  SqlAlchemyTaintConfig() { this = "SqlAlchemyTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof DangerousFunction }

  override predicate isBarrier(DataFlow::Node barrierCandidate) {
    barrierCandidate instanceof BindParamsSanitizer
  }
}

from SqlAlchemyTaintConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Potential SQL injection vulnerability in SQLAlchemy query method", source,
  "User input reaches potentially unsafe SQLAlchemy query method without bindparams sanitization"
