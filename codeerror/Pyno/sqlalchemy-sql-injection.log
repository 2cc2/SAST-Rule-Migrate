Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause SQL injections 
 *              if raw SQL with user input is used without bindparams
 * @kind taint
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(MethodArgument ma |
      ma = self.asExpr() and
      ma.getTarget().regexpMatch("\$VAR")
    )
  }
}

class SqlFunctionSink extends DataFlow::Node {
  SqlFunctionSink() {
    exists(MethodCall mc |
      mc = self.asExpr() and
      mc.getCalleeName().regexpMatch("(group_by|order_by|distinct|having|filter)") and
      mc.getReceiver().getType().getName() = "sqlalchemy.orm.query.Query" and
      mc.getReceiver().toString().regexpMatch(".*\$FORMATFUNC\(.*\$VAR.*\)")
    )
  }
}

class BindParamsSanitizer extends TaintTracking::Sanitizer {
  BindParamsSanitizer() {
    exists(MethodCall mc |
      mc = self.asExpr() and
      mc.getCalleeName() = "bindparams"
    )
  }
}

class SqlAlchemySqlInjectionConfig extends TaintTracking::Configuration {
  SqlAlchemySqlInjectionConfig() { this = "SqlAlchemySqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlFunctionSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof BindParamsSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Implements PARAM_TO_SQL propagation: arg->param
    exists(DataFlow::ParameterNode param, DataFlow::ArgumentNode arg |
      node1.asExpr() = arg and
      node2.asExpr() = param and
      arg.(DataFlow::ArgumentNode).getCall() = param.(DataFlow::ParameterNode).getCall()
    )
  }
}

from SqlAlchemySqlInjectionConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential SQL injection in SQLAlchemy query method with untrusted input", source,
  "Untrusted user input flows into SQLAlchemy query method $@ without proper parameter binding.",
  source, "user input"
