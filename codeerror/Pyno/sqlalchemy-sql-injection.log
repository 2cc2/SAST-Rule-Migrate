Rule Content:
/**
 * @name SQLAlchemy SQL Injection 
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause SQL injections if raw SQL with user input is used without bindparams
 * @kind path-problem
 * @problem.severity warning
 * @id py/sqlalchemy-sql-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Var v |
      this.asParameter().getAnArg() = v and
      v.getName().regexpMatch(".*\\$VAR.*")
    )
  }
}

class SQLFunctionSink extends DataFlow::Node {
  SQLFunctionSink() {
    exists(Call c, string expr |
      this = c.getArg(0) and
      c.getReceiver().getType().getASuperType*().hasQualifiedName("sqlalchemy.orm.query", "Query") and
      c.getMethodName().regexpMatch("(group_by|order_by|distinct|having|filter)") and
      expr = c.getParent().(Call).getReceiver().toString() and
      expr.regexpMatch(".*\\$FORMATFUNC\\(.*\\$VAR.*\\)")
    )
  }
}

class BindParamsSanitizer extends DataFlow::BarrierGuard {
  BindParamsSanitizer() {
    exists(Call binder |
      binder.getMethodName() = "bindparams" and
      this.asExpr() = binder
    )
  }
}

class SQLAlchemyConfig extends TaintTracking::Configuration {
  SQLAlchemyConfig() { this = "SQLAlchemy SQL Injection" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SQLFunctionSink }

  override predicate isSanitizerGuard(DataFlow::BarrierGuard guard) {
    guard instanceof BindParamsSanitizer
  }
}

from SQLAlchemyConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "$@ flows through SQLAlchemy query method and may lead to SQL injection.",
  source.getNode(), "User input", sink.getNode(), "Potential SQL injection sink"
