Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause SQL injections
 *              if raw SQL with user input is used without bindparams
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.strings.StringFormat

class SqlalchemyQueryMethod extends DataFlow::Callable {
  SqlalchemyQueryMethod() {
    this.getReceiver().getType().(RefType).getName() = "sqlalchemy.orm.query.Query" and
    this.getName().matches("(group_by|order_by|distinct|having|filter)")
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Parameter p | this.asParameter() = p and p.getName().matches("\\$VAR"))
  }
}

class BindParamsSanitizer extends DataFlow::Node {
  BindParamsSanitizer() {
    exists(Call c |
      this.asExpr() = c and
      c.getCallee().getName() = "bindparams"
    )
  }
}

class SqlalchemySqlInjectionConfig extends TaintTracking::Configuration {
  SqlalchemySqlInjectionConfig() { this = "SqlalchemySqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SqlalchemyQueryMethod call |
      call.getACall() = sink.asExpr() and
      exists(MethodCallFormatFunction mc |
        mc.getFormatString().matches(".*\\$FORMATFUNC\\(.*\\$VAR.*\\)") and
        sink.asExpr() = mc
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof BindParamsSanitizer
  }

  override predicate isSanitizerBetween(DataFlow::Node node1, DataFlow::Node node2) {
    node1.getASuccessor+() = node2 and
    node1 instanceof BindParamsSanitizer and
    node2.getEnclosingCallable() instanceof SqlalchemyQueryMethod
  }
}

from SqlalchemySqlInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential SQL injection in SQLAlchemy query method when using raw SQL with user input without bindparams"
