Rule Content:
/**
 * @name SQLAlchemy SQL Injection
 * @description Distinct, Having, Group_by, Order_by, and Filter in SQLAlchemy can cause
 *              SQL injections if raw SQL with user input is used without bindparams
 * @kind path-problem
 * @problem.severity warning
 * @id python/sqlalchemy-sql-injection
 */

import python
import semmle.python.dataflow.FlowSources
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(string regex, string name |
      exists(FunctionNode fn | fn.getAParameterName() = name |
        regex.matches("\$VAR", name)
      ) and  
      this = DataFlow::parameterNode(fn)
    )
  }
}

class SqlFunctionSink extends DataFlow::Node {
  SqlFunctionSink() {
    exists(MethodCallNode call, string methodName |
      call.getMethodName() = methodName and
      methodName.regexpMatch("(group_by|order_by|distinct|having|filter)") and
      call.getReceiver().toString().regexpMatch(".*\$FORMATFUNC\(.*\$VAR.*\)") and
      call.getReceiver().getType().hasName("sqlalchemy.orm.query.Query") and
      this = call
    )
  }
}

class BindParamsSanitizer extends DataFlow::Node {
  BindParamsSanitizer() {
    exists(MethodCallNode call |
      call.getMethodName() = "bindparams" and
      this = call
    )
  }
}

class SqlAlchemyConfig extends TaintTracking::Configuration {
  SqlAlchemyConfig() { this = "SqlAlchemy SQL Injection" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlFunctionSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof BindParamsSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(ArgumentNode arg, ParameterNode param |
      arg.getParameter() = param and
      node1 = arg.getNode() and
      node2 = param.getNode()
    )
  }
}

from SqlAlchemyConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential SQL injection vulnerability in SQLAlchemy due to unsafe usage of user input in query method $@.", 
  source, "User input from here"
