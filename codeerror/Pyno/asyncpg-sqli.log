Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. 
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/asyncpg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class AsyncpgConnection extends DataFlow::Node {
  AsyncpgConnection() {
    exists(MethodAccess ma |
      ma.getMethod().getName().regexpMatch("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      ma.getQualifier().getType().hasName("asyncpg.Connection") and
      this.asExpr() = ma
    )
  }
}

class UserInput extends DataFlow::Node {
  UserInput() {
    exists(Identifier id |
      id.getName().regexpMatch("$USERINPUT") and
      this.asExpr() = id
    )
  }
}

class StringConcatOperation extends DataFlow::Node {
  StringConcatOperation() {
    exists(Expr e |
      (
        e instanceof BinaryOperation and
        e.(BinaryOperation).getOperator() = "+"
      ) or
      e instanceof FormatString or
      e instanceof FormatOperation and
      this.asExpr() = e
    )
  }
}

predicate isTaintedSource(DataFlow::Node source) {
  source instanceof UserInput
}

predicate isTaintedSink(DataFlow::Node sink) {
  sink instanceof AsyncpgConnection and
  exists(MethodAccess ma |
    ma.getMethod().getName().regexpMatch("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
    ma.getQualifier().getType().hasName("asyncpg.Connection") and
    sink.asExpr() = ma.getAnArgument() and
    ma.getAnArgumentPosition() = 0
  )
}

predicate isTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
  exists(StringConcatOperation sc |
    sc.getAMember(self) and
    node1.getAConvertibleOperand(sc) and
    node2.getAConvertibleOperand(sc)
  )
}

class ParamQuerySanitizer extends DataFlow::BarrierGuard {
  override predicate checks(DataFlow::Node node, BarrierKind kind) {
    exists(MethodAccess ma |
      ma.getMethod().getName().regexpMatch("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      ma.getQualifier().getType().hasName("asyncpg.Connection") and
      node.asExpr() = ma.getAnArgument()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ParamQuerySanitizer sanitizer
where
  TaintTracking::localPath(source, sink) and
  isTaintedSource(source.getNode()) and
  isTaintedSink(sink.getNode()) and
  not sanitizer.checks(sink.getNode()) and
  exists(TaintTracking::TaintConfig config |
    config.hasPartialFlowStep(isTaintStep) and
    config.hasSource(source.getNode()) and
    config.hasSink(sink.getNode())
  )
select sink.getNode(), "Potential SQL injection in asyncpg query from user input $@.", source.getNode(),
  "User input flows into SQL query here."
