Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/asyncpg-sqli
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.web.Sinks
import semmle.python.web.Sources

private class AsyncpgSqlSink extends DataFlow::Node {
  AsyncpgSqlSink() {
    exists(MethodCall mc |
      mc.getMethod().getName() matches "fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery" and
      mc.getReceiver().getType().hasQualifiedName("asyncpg", "Connection") and
      mc.getArgument(0) = this.asExpr()
    )
  }
}

private class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Identifier id |
      id.getName().regexpMatch("$USERINPUT") and
      this.asExpr() = id
    )
  }
}

private class ParameterizedQuerySanitizer extends DataFlow::Node {
  ParameterizedQuerySanitizer() {
    exists(MethodCall mc |
      mc.getMethod().getName() matches "fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery" and
      mc.getReceiver().getType().hasQualifiedName("asyncpg", "Connection") and
      this.asExpr() = mc
    )
  }
}

private class StringConcatenationPropagator extends DataFlow::Node {
  StringConcatenationPropagator() {
    exists(Expr e |
      e instanceof BinaryExpr and
      e.(BinaryExpr).getOperator() = "+" and
      (this.asExpr() = e.getLeftOperand() or this.asExpr() = e.getRightOperand())
    ) or
    exists(FormattedString fs |
      this.asExpr() = fs
    ) or
    exists(Call c |
      c.getCalleeName() = "format" and
      this.asExpr() = c
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(TaintTracking::Configuration config |
    config.hasFlowPath(source, sink) and
    config.hasSource(new UserInputSource()) and
    config.addSink(new AsyncpgSqlSink()) and
    config.addSanitizer(new ParameterizedQuerySanitizer()) and
    config.addAdditionalTaintStep(new StringConcatenationPropagator())
  )
select sink.getNode(), source.getNode(),
  "Detected string concatenation with a non-literal variable in a asyncpg SQL statement."
