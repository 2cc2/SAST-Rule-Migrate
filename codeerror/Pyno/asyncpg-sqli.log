Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/asyncpg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(string name |
      this.asExpr() = name.asName().getId() |
      regexpMatches(name, "^.*USERINPUT.*$")
    )
  }
}

class AsyncPgSqlSink extends DataFlow::Node {
  AsyncPgSqlSink() {
    exists(MethodCall call |
      this.asExpr() = call.getArg(0) and
      call.getMethodName().matches("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copytfromquery") and
      call.getReceiver().getType().getName() = "asyncpg.Connection"
    )
  }
}

class TaintTrackingConfiguration extends TaintTracking::Configuration {
  TaintTrackingConfiguration() { this = "AsyncPgSqliTaintTracking" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof AsyncPgSqlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodCall call |
      sanitizer.asExpr() = call and
      call.getMethodName().matches("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copytfromquery") and
      call.getReceiver().getType().getName() = "asyncpg.Connection"
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(Expr op |
      ((op = pred.asExpr().(BinaryOperation).getOperator() and op = "+") or
      pred.asExpr() instanceof FormatOperation or
      pred.asExpr() instanceof PercentOperation or
      pred.asExpr() instanceof FString) and
      succ.asExpr() = pred.asExpr().getAChild*()
    )
  }
}

from TaintTrackingConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection via string concatenation with user input in asyncpg query"
