Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement. This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/asyncpg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class AsyncpgSQLSource extends DataFlow::Node {
  AsyncpgSQLSource() {
    exists(string name |
      this.asVariable().getName() = name and
      name.regexpMatch("(?i)(userinput|input|param)")
    )
  }
}

class AsyncpgSQLSink extends DataFlow::Node {
  AsyncpgSQLSink() {
    exists(MethodCall mc |
      mc.getMethodName().regexpMatch("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      mc.getReceiver().getType().getName() = "asyncpg.Connection" and
      this.asExpr() = mc.getArg(0)
    )
  }
}

class AsyncpgSQLSanitizer extends DataFlow::Node {
  AsyncpgSQLSanitizer() {
    exists(MethodCall mc |
      mc.getMethodName().regexpMatch("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      mc.getReceiver().getType().getName() = "asyncpg.Connection" and
      this.asExpr() = mc
    )
  }
}

class AsyncpgSQLConcat extends DataFlow::Node {
  AsyncpgSQLConcat() {
    exists(BinaryOperation bo |
      bo.getOperator() = "+" and
      this.asExpr() = bo.getRightOperand()
    ) or
    exists(MethodCall mc |
      mc.getMethodName() = "format" and
      this.asExpr() = mc
    ) or
    exists(FormattedValue fv |
      this.asExpr() = fv
    )
  }
}

class AsyncpgSQLTaintConfig extends TaintTracking::Configuration {
  AsyncpgSQLTaintConfig() { this = "AsyncpgSQLTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof AsyncpgSQLSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof AsyncpgSQLSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof AsyncpgSQLSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    node1 instanceof AsyncpgSQLConcat and
    node2 = node1.(AsyncpgSQLConcat).getAOperand()
  }
}

from AsyncpgSQLTaintConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), sink, "Potential SQL Injection in asyncpg query: $@ flows from $@", sink.getNode(), "user input", 
  source.getNode(), source.getNode().toString()
