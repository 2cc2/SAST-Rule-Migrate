Rule Content:
/**
 * @name asyncpg-sqli
 * @description Detected string concatenation with a non-literal variable in a asyncpg Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id python/asyncpg-sqli
 */
import python
import semmle.python.security.strings.UntrustedStringFormat
import semmle.python.security.strings.SQL
import semmle.python.security.dataflow.TaintTracking
import semmle.python.Concepts

class AsyncpgSqlSource extends TaintSource::Range {
  AsyncpgSqlSource() {
    exists(DataFlow::Node node |
      node = DataFlow::moduleImport("flask").getMember("request").getAPropertyRead("args") or
      node = DataFlow::moduleImport("flask").getMember("request").getAPropertyRead("form") or
      node = DataFlow::moduleImport("flask").getMember("request").getAPropertyRead("values") or
      node.getType() = HTTPRequestType() or
      node.toString().regexpMatch(".*USERINPUT.*")
    )
  }
}

class AsyncpgSqlSink extends TaintSink::Range {
  AsyncpgSqlSink() {
    exists(MethodCallNode call |
      call.getMethod().getName().regexpMatch("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      call.getACallee().getType().getName() = "asyncpg.Connection" and
      this.asNode() = call.getArgument(0)
    )
  }
}

class AsyncpgSqlSanitizer extends TaintSanitizer::Range {
  AsyncpgSqlSanitizer() {
    exists(MethodCallNode call |
      call.getMethod().getName().regexpMatch("fetch|fetchrow|fetchval|execute|executemany|prepare|cursor|copyfromquery") and
      call.getACallee().getType().getName() = "asyncpg.Connection"
    )
  }
}

class AsyncpgStringConcat extends TaintStep {
  override predicate step(DataFlow::Node src, DataFlow::Node sink) {
    exists(BinaryOperation binop |
      (binop.getOperator() = "+" or binop instanceof FormatString) and
      (binop.getLeftOperand().getAChild*() = src.asExpr() or binop.getRightOperand().getAChild*() = src.asExpr()) and
      binop = sink.asExpr()
    )
  }
}

from AsyncpgSqlSource source, AsyncpgSqlSink sink
where TaintTracking::localTaint(
  DataFlow::parameterNode(source),
  DataFlow::exprNode(sink),
  [AsyncpgStringConcat, AnyFlowStep]
) and not TaintTracking::canSanitizeBetween(source, sink, AsyncpgSqlSanitizer)
select sink, "String concatenation with a non-literal variable in asyncpg SQL statement. Potential SQL injection.",
  source, "User input flows into this SQL query."
