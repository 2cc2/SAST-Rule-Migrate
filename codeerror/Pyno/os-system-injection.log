Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection 
 *              and should be avoided. If this must be done, use the 'subprocess' module instead
 *              and pass the arguments as a list.
 * @kind path-problem
 * @problem.severity ERROR
 * @id py/os-system-injection
 */


import python
import semmle.python.security.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.WebFlask


class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(API::CallNode call |
      call.getTarget().hasQualifiedName("flask", "request", "get") and
      this.asExpr() = call
    )
  }
}


class RouteVarSource extends DataFlow::Source {
  RouteVarSource() {
    exists(Method method, Parameter p |
      method.hasAnnotation("route") and
      p = method.getAParameter() and
      this.asExpr() = p.getAnAccess()
    )
  }
}


class OsSystemSink extends DataFlow::Sink {
  OsSystemSink() {
    exists(API::CallNode call |
      call.getTarget().hasQualifiedName("os", "system") and
      this.asExpr() = call.getArg(0)
    )
  }
}


class OsSystemInjectionConfig extends TaintTracking::Configuration {
  OsSystemInjectionConfig() { this = "OsSystemInjectionConfig" }
  
  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or source instanceof RouteVarSource
  }
  
  override predicate isSink(DataFlow::Sink sink) { sink instanceof OsSystemSink }
  
  // No sanitizers needed
  // No additional propagations needed as default data flow is sufficient
}

from OsSystemInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User data detected in os.system. This could be vulnerable " +
  "to a command injection. Consider using the 'subprocess' module instead with argument lists."
