Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection 
 *    and should be avoided. If this must be done, use the 'subprocess' module instead and pass 
 *    the arguments as a list.
 * @kind taint-problem
 * @problem.severity error
 * @id python/command-injection
 */

import python
import semmle.python.Concepts
import semmle.python.security.CommandInjection
import semmle.python.web.flask.Flask
import semmle.python.ApiGraphs

class FlaskRequestSource extends RemoteUserInput::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma, Method m |
      ma.getMethod().hasName(["get"]) and
      ma.getQualifier().getType().hasName("request") and
      m = ma.getMethod() and
      m.getDeclaringType().hasQualifiedName("flask", "request")
    )
    or
    exists(Method m | 
      m.hasName("get") and
      m.getDeclaringType().hasQualifiedName("flask", "request")
    )
  }
}

class RouteParameterSource extends RemoteUserInput::Range {
  RouteParameterSource() {
    exists(Parameter p |
      p.getAnnotatedDeclaration().getAnAnnotation().getType().hasName("route")
    )
  }
}

class OsSystemSink extends CommandExecution::Range {
  OsSystemSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "system" and
      ma.getMethod().getDeclaringType().hasQualifiedName("os") and
      this = ma.getArgument(0)
    )
  }
}

query predicate edges(DataFlow::Node source, DataFlow::Node sink) {
  TaintTracking::localTaint(source, sink) or
  DataFlow::localFlow(source, sink)
}

from FlaskRequestSource source, OsSystemSink sink
where edges(source, sink)
select sink, "User data flows into os.system command execution.", source, 
  "This could be vulnerable to command injection."

from RouteParameterSource source, OsSystemSink sink
where edges(source, sink)
select sink, "Route parameter flows into os.system command execution.", source,
  "This could be vulnerable to command injection."
