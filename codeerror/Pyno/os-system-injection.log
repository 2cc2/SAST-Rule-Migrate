Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection and should be avoided.
 * @kind problem
 * @problem.severity error
 * @id py/os-system-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.web.flask.Flask

class UnsafeUserInputSource extends DataFlow::SourceNode::Range {
  UnsafeUserInputSource() {
    // Source 1: Flask request parameters
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["get"] and
      ma.getQualifier().getType().getName() = "request" and
      ma.getQualifier().getType().getASourceFile().getRelativePath().matches("%flask%") and
      this.asExpr() = ma
    )
    or
    // Source 2: Route parameters
    exists(Parameter p |
      p.getFunction().getAReference().getAnAnnotation().matches("%route%") and
      this.asParameter() = p
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    source.asExpr() = this.asExpr() or source.asParameter() = this.asParameter()
  }
}

class OsSystemSink extends DataFlow::SinkNode::Range {
  OsSystemSink() {
    exists(Call call |
      call.getTarget().getDeclaringType().getName() = "os" and
      call.getTarget().getName() = "system" and
      this.asExpr() = call.getArg(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DataFlow::ValueFlow::Node arg |
      arg = sink.asExpr() and
      exists(Call call | 
        call.getTarget().getDeclaringType().getName() = "os" and
        call.getTarget().getName() = "system" and
        arg = call.getArg(0)
      )
    )
  }
}

from UnsafeUserInputSource source, OsSystemSink sink, DataFlow::PathNode path
where config.hasFlowPath(source, sink, path)
select sink, "User data detected in os.system. This could be vulnerable to a command injection and should be avoided. " +
  "If this must be done, use the 'subprocess' module instead and pass the arguments as a list."
