      os_system.getDeclaringModule().hasQualifiedName("os") and
      os_system.hasName("system") and
      this.asSink().asExpr() = os_system.getACall().getArgument(0)
    )
  }
  
  override string getSinkType() { result = "os.system call" }
}

class OsSystemInjectionConfig extends TaintTracking::Configuration {
  OsSystemInjectionConfig() { this = "OsSystemInjectionConfig" }
  
  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }
  
  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof OsSystemSink
  }
  
  override predicate isSanitizer(DataFlow::Sanitizer sanitizer) {
    none()
  }
}

