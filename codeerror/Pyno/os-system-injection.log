Rule Content:
/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection and should be avoided. If this must be done, use the 'subprocess' module instead and pass the arguments as a list.
 * @kind path-problem
 * @problem.severity ERROR
 * @id py/os-system-injection
 */

import python
import semmle.python.security.Routes
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.Request

class FlaskRequestSource extends TaintSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("get") and
      ma.getQualifier().getType().hasName("Request") and
      ma.getQualifier().getType().getASourceSupertype*().hasName("flask.request")
    )
    or
    exists(Parameter p |
      p.getAParentScope() instanceof FlaskRouteMethod
    )
  }

  override string getSourceType() { "user-provided value" }
}

class OsSystemSink extends TaintSink::Range {
  OsSystemSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("system") and
      ma.getQualifier().getType().hasName("os")
    )
  }

  override string getSinkType() { "os.system call" }
}

class OsSystemInjectionConfiguration extends TaintTracking::Configuration {
  OsSystemInjectionConfiguration() { this = "OsSystemInjection" }

  override predicate isSource(TaintSource::Range source) { source instanceof FlaskRequestSource }

  override predicate isSink(TaintSink::Range sink) { sink instanceof OsSystemSink }
}

from OsSystemInjectionConfiguration config, TaintSource::Range source, TaintSink::Range sink
where config.hasFlow(source, sink)
select sink, "User data in os.system call may lead to command injection vulnerability. Use subprocess module instead."
