/**
 * @name os-system-injection
 * @description User data detected in os.system. This could be vulnerable to a command injection 
 * and should be avoided. If this must be done, use the 'subprocess' module instead 
 * and pass the arguments as a list.
 * @kind path-problem
 * @problem.severity error
 * @id python/os-system-injection
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.Flask
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("flask", "request") and
      (ma.getMethod().hasName("get") or ma.getMethod().hasName("[...]") or ma.getMethod().hasName("(...)")) and
      this.asSource().asExpr() = ma
    )
  }
  
