Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pymssql-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class EventInput extends DataFlow::Node {
  EventInput() {
    exists(Function f |
      f.getName() = "$HANDLER" and
      this.asParameter().getName() = "event" and
      this.asParameter().getFunction() = f
    )
  }
}

class PyMssqlExecuteCall extends DataFlow::Node {
  PyMssqlExecuteCall() {
    exists(CallNode call, Import imp |
      call.getTarget().(Member).getMemberName() = "execute" and
      call.getTarget().(Member).getQualifier().getType().(NamedType).getName() = "Cursor" and
      imp.getImportedName() = "pymssql" and
      call.getArgument(0) = this
    )
  }
}

class ParameterizedQuerySanitizer extends DataFlow::BarrierGuard {
  ParameterizedQuerySanitizer() {
    exists(CallNode call |
      call.getTarget().(Member).getMemberName() = "execute" and
      call.getArgument(0) = this.getNode() and
      call.getNumberOfArguments() > 1
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "pymssql_sqli_config" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof PyMssqlExecuteCall }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof ParameterizedQuerySanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    // Propagation: arg to param
    exists(DataFlow::ParameterNode param, DataFlow::ArgNode arg |
      pred = arg and succ = param and
      arg.bindsTo(param)
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized."
