sinks:
  - id: SQL_EXEC
    match:
      node: CALL
      api: { package: pymssql, type: Cursor, method: execute }
      arg_index: 0
      pattern-inside: |
        import pymssql
        ...

sanitizers:
  - id: PARAMETERIZED_QUERY
    match:
      node: CALL
      api: { package: pymssql, type: Cursor, method: execute }
      where:
        - op: gt
          left: args.size
          right: 1
    effect: neutralize

propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
```
