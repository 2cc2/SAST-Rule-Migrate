Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection 
 *              if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pymssql-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class EventInput extends DataFlow::Node {
  EventInput() {
    exists(Python::Parameter p | 
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class PyMssqlExecuteCall extends DataFlow::Node {
  PyMssqlExecuteCall() {
    exists(MethodCallNode call |
      call.getTarget().(MethodValue).getDeclaringType().getQualifiedName() = "pymssql.Cursor" and
      call.getTarget().(MethodValue).getName() = "execute" and
      this = call
    )
  }

  predicate hasAdditionalParameters() {
    getArguments().size() > 1
  }
}

class PyMssqlSqliConfig extends TaintTracking::Configuration {
  PyMssqlSqliConfig() { this = "PyMssqlSqliConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventInput }

  override predicate isSink(DataFlow::Node sink) {
    exists(PyMssqlExecuteCall call |
      sink = call and
      not call.hasAdditionalParameters()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(PyMssqlExecuteCall call |
      call.hasAdditionalParameters() and
      sanitizer = call
    )
  }
}

from PyMssqlSqliConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection " +
  "if the variable is user-controlled and not properly sanitized."
