Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. This could lead to 
 *              SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/pymssql-sqli
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.Concepts

class EventInput extends DataFlow::Node {
  EventInput() {
    exists(Function f, Parameter p |
      p = f.getAParameter().getParameter(0) and
      p.getName() = "event" and
      f.getName().matches("%HANDLER%") and
      this.asParameter() = p
    )
  }
}

class PymssqlCursorExecute extends DataFlow::Node {
  PymssqlCursorExecute() {
    exists(Method m |
      m.getName() = "execute" and
      m.getDeclaringType().getName() = "Cursor" and
      m.getDeclaringType().getAPackage().getName() = "pymssql" and
      this.asExpr() = m.getACall().getArgument(0)
    )
  }
}

class ParameterizedQuerySanitizer extends TaintTracking::SanitizerConfig {
  override predicate isSanitizer(DataFlow::Node node) {
    exists(MethodCall m |
      m.getMethod().getName() = "execute" and
      m.getMethod().getDeclaringType().getName() = "Cursor" and
      m.getMethod().getDeclaringType().getAPackage().getName() = "pymssql" and
      m.getNumArgument() > 1 and
      node.asExpr() = m.getArgument(0)
    )
  }
}

class PyMssqlTaintConfig extends TaintTracking::Configuration {
  PyMssqlTaintConfig() { this = "PyMssqlTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof PymssqlCursorExecute
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof ParameterizedQuerySanitizer
  }
}

from PyMssqlTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "SQL statement is tainted by $@. This could lead to SQL injection.",
  source.getNode(), "user-provided value"
