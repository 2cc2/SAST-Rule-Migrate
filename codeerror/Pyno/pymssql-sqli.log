Rule Content:
/**
 * @name pymssql-sqli
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id python/pymssql-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class EventInput extends DataFlow::Node {
  EventInput() {
    exists(Function f, Parameter p |
      f.getName() = "$HANDLER" and
      p.getFunction() = f and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class SqlExecSink extends DataFlow::Node {
  SqlExecSink() {
    exists(CallNode call |
      call.getTarget().getName() = "execute" and
      call.getTarget().getQualifiedName() = "pymssql.Cursor.execute" and
      call.getArg(0) = this.asExpr()
    )
  }
}

class SafeSqlQuery extends DataFlow::BarrierNode {
  SafeSqlQuery() {
    exists(CallNode call |
      call.getTarget().getName() = "execute" and
      call.getTarget().getQualifiedName() = "pymssql.Cursor.execute" and
      call.getNumberOfArguments() > 1 and
      this.asExpr() = call
    )
  }
}

class PymssqlSqliConfig extends TaintTracking::Configuration {
  PymssqlSqliConfig() { this = "PymssqlSqliConfig" }
  
  override predicate isSource(DataFlow::Node source) { source instanceof EventInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecSink }

  override predicate isSanitizer(DataFlow::Node node) { node instanceof SafeSqlQuery }

  override predicate isAdditionalTaintStep(DataFlow::Node from, DataFlow::Node to) {
    exists(Parameter p, Argument arg |
      from.asExpr() = arg.getExpr() and
      to.asParameter() = p and
      arg.bindsTo(p)
    )
  }
}

from PymssqlSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection."
