Rule Content:
/**
 * @name pymssql-sqli
 * @kind path-problem
 * @problem.severity warning
 * @description Detected SQL statement that is tainted by `event` object. 
 * This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.security.dataflow.RemoteFlowSources
import DataFlow::PathGraph

class EventInput extends DataFlow::Node {
  EventInput() {
    exists(Function f, Parameter p |
      f.getName() = "$HANDLER" and
      p.getName() = "event" and
      p = f.getAParameter() and
      this.asParameter() = p
    )
  }
}

class PyMssqlExecuteCall extends DataFlow::Node {
  PyMssqlExecuteCall() {
    exists(CallNode call |
      call.getTarget().(Member).getName() = "execute" and
      call.getTarget().(Member).getQualifier().getType().(RefType).getUnqualifiedName() = "Cursor" and
      call.getTarget().(Member).getQualifier().getType().(RefType).getPackage().getName() = "pymssql" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PyMssqlParameterizedQuery extends DataFlow::BarrierNode {
  PyMssqlParameterizedQuery() {
    exists(CallNode call |
      call.getTarget().(Member).getName() = "execute" and
      call.getTarget().(Member).getQualifier().getType().(RefType).getUnqualifiedName() = "Cursor" and
      call.getTarget().(Member).getQualifier().getType().(RefType).getPackage().getName() = "pymssql" and
      call.getNumArg() > 1
    )
  }
}

class EventToPymssqlConfig extends TaintTracking::Configuration {
  EventToPymssqlConfig() { this = "Event to pymssql execute taint tracking" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventInput }

  override predicate isSink(DataFlow::Node sink) { sink instanceof PyMssqlExecuteCall }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PyMssqlParameterizedQuery
  }
}

from EventToPymssqlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected SQL statement that is tainted by `event` object. This could lead to SQL injection."
