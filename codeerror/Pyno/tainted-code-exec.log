Rule Content:
/**
 * @name TaintedCodeExecution
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic content. 
 * If this content can be input from outside the program, this may be a code injection vulnerability.
 * Ensure evaluated content is not definable by external sources.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-code-exec
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class EventParam extends DataFlow::Source::Range {
  EventParam() {
    exists(string paramName |
      paramName = "event" and
      this.asParameter().getName() = paramName and
      exists(Method m | m.hasName("$HANDLER") and this.getFunction() = m)
    )
  }
}

class CodeExecSink extends DataFlow::Sink::Range {
  CodeExecSink() {
    exists(Call call |
      call.getTarget().(Method).getName().matches("eval|exec") and
      this.asExpr() = call.getArg(0)
    )
  }
}

class TaintedCodeExecConfig extends TaintTracking::Configuration {
  TaintedCodeExecConfig() { this = "TaintedCodeExecConfig" }

  override predicate isSource(DataFlow::Source src) { src instanceof EventParam }

  override predicate isSink(DataFlow::Sink sink) { sink instanceof CodeExecSink }
}

from TaintedCodeExecConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential code injection vulnerability from event parameter to exec/eval"
