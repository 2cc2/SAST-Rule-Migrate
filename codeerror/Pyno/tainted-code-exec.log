Rule Content:
/**
 * @name Tainted Code Execution
 * @kind path-problem
 * @problem.severity warning
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic content.
 *              If this content can be input from outside the program, this may be a code injection vulnerability.
 *              Ensure evaluated content is not definable by external sources.
 * @tags security
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class EventParamSource extends DataFlow::Node {
  EventParamSource() {
    exists(Function f |
      f.getName() matches /$HANDLER/ and
      this.asParameter() = f.getAParameter() and
      this.asParameter().getName() = "event"
    )
  }
}

class CodeExecSink extends DataFlow::Node {
  CodeExecSink() {
    exists(Call c |
      (
        c.getFunc().(Name).getId() = "eval" or
        c.getFunc().(Name).getId() = "exec"
      ) and
      this.asExpr() = c.getArg(0)
    )
  }
}

class TaintedCodeExecConfig extends TaintTracking::Configuration {
  TaintedCodeExecConfig() { this = "TaintedCodeExecConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventParamSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CodeExecSink }
}

from TaintedCodeExecConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential code injection vulnerability due to evaluation of user-controlled input."
