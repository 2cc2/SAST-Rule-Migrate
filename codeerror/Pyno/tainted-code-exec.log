/**
 * @name TaintedCodeExecution
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic
 *              content. If this content can be input from outside the program, this may be a code
 *              injection vulnerability. Ensure evaluated content is not definable by external sources.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-code-exec
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(Method method |
      method.getName() = "$HANDLER" and
      this.asParameter() = method.getAParameter() and
      this.asParameter().getName() = "event"
    )
  }
}

class EvalCall extends DataFlow::Node {
  EvalCall() {
    exists(Call call |
      call.getFunc().(Name).getId() = ["eval", "exec"] and
      this = call.getArg(0)
    )
  }
}

class TaintedCodeExecutionConfig extends TaintTracking::Configuration {
  TaintedCodeExecutionConfig() { this = "TaintedCodeExecutionConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventParam }

  override predicate isSink(DataFlow::Node sink) { sink instanceof EvalCall }
}

