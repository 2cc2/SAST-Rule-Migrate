Rule Content:
/**
 * @name Tainted code execution via eval/exec
 * @description Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic content.
 * @kind taint
 * @problem.severity warning
 * @id python/tainted-code-exec
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class EvalExecFunction extends FunctionValue::Range {
  EvalExecFunction() {
    this.getName() = ["eval", "exec"]
  }
}

class EvalExecCall extends API::CallRange {
  EvalExecCall() {
    exists(FunctionValue f | 
      f = this.getFunction() and
      f instanceof EvalExecFunction
    )
  }
}

class EventParameter extends DataFlow::Node {
  EventParameter() {
    exists(FunctionDefinition def, Parameter p |
      def.getName() matches "%HANDLER" and
      p = def.getAParameter() and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "TaintedCodeExecutionViaEval" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(EvalExecCall call |
      call.getAnArg() = sink.asExpr()
    )
  }
}

from Config cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected the use of `exec/eval`. This can be dangerous if used to evaluate dynamic " +
  "content. If this content can be input from outside the program, this may be a code injection " +
  "vulnerability. Ensure evaluated content is not definable by external sources."
