import python
import semmle.python.Concepts
import semmle.python.dataflow.new.TaintTracking

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(Method m | m.getName() = "$HANDLER" and this.asParameter() = m.getAParameter() |
      this.asParameter().getName() = "event"
    )
  }
}

class CodeExecutionCall extends DataFlow::Node {
  CodeExecutionCall() {
    exists(Call call | call.getTarget().getName().matches("eval|exec") and this.asExpr() = call.getArg(0))
  }
}

class TaintedCodeExecutionConfig extends TaintTracking::Configuration {
  TaintedCodeExecutionConfig() { this = "TaintedCodeExecution" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventParam }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CodeExecutionCall }
}

