Rule Content:
/**
 * @name SQLAlchemy Execute Raw Query
 * @description Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. Use prepared statements instead.
 * @kind taint
 * @id py/sql-injection/sqlalchemy-execute-raw-query
 * @severity ERROR
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class SQLStringConcatSource extends DataFlow::Node {
  SQLStringConcatSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["__add__", "__mod__", "format"] and
      ma.getMethod().getDeclaringType().hasQualifiedName("builtins", "str") and
      this.asExpr() = ma
    )
  }
}

class SQLExecutionSink extends DataFlow::Node {
  SQLExecutionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "execute" and
      ma.getMethod().getDeclaringType().hasQualifiedName("sqlalchemy.engine.base", "Connection") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "bindparams" and
      ma.getMethod().getDeclaringType().hasQualifiedName("sqlalchemy.sql.expression", "text") and
      this.asExpr() = ma.getReceiver()
    )
  }
}

class SQLStringTaintConfig extends TaintTracking::Configuration {
  SQLStringTaintConfig() { this = "SQLStringTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SQLStringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

from SQLStringTaintConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. Use prepared statements instead."
