Rule Content:
/**
 * @name Avoiding SQL string concatenation
 * @description Untrusted input concatenated with raw SQL query can result in SQL Injection. Use prepared statements instead.
 * @kind path-problem
 * @problem.severity error
 * @id py/sqlalchemy-execute-raw-query
 */

import python
import semmle.python.security.injection.SqlInjection
import DataFlow::PathGraph

class SQLStringConcatSource extends DataFlow::Node {
  SQLStringConcatSource() {
    exists(MethodCall call |
      call.getMethodName() in ["__add__", "__mod__", "format"] and
      call.getQualifier().getType().getName() = "str" and
      (
        call.getMethod().getQualifiedName() = "str.__add__" or
        call.getMethod().getQualifiedName() = "str.__mod__" or
        call.getMethod().getQualifiedName() = "str.format"
      ) and
      this.asExpr() = call
    )
  }
}

class SQLExecutionSink extends DataFlow::Node {
  SQLExecutionSink() {
    exists(MethodCall call |
      call.getMethodName() = "execute" and
      call.getQualifier().getType().getName() = "Connection" and
      call.getQualifier().getType().getASourceSuperType*().hasQualifiedName("sqlalchemy.engine.base", "Connection") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodCall call |
      call.getMethodName() = "bindparams" and
      call.getQualifier().getType().hasQualifiedName("sqlalchemy.sql.expression", "text") and
      this.asExpr() = call
    )
  }
}

query predicate edges(DataFlow::Node source, DataFlow::Node sink) {
  source = any(SQLStringConcatSource s).asDefiningArgument() and
  sink = any(SQLExecutionSink s).getNode()
}

from SQLStringConcatSource source, SQLExecutionSink sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where DataFlow::flowPath(sourceNode, sinkNode) and
  not exists(PreparedStatementSanitizer sanitizer |
    DataFlow::flowPath(sourceNode, sanitizer.getNode()) and
    DataFlow::flowPath(sanitizer.getNode(), sinkNode)
  )
select sinkNode, sourceNode, sink,
  "Potential SQL injection: untrusted input concatenated with raw SQL query. Use prepared statements instead."
