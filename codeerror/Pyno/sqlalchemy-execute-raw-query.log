Rule Content:
/**
 * @name SQLAlchemy Execute Raw Query
 * @description Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. Use prepared statements instead.
 * @kind path-problem
 * @problem.severity error
 * @id python/sqlalchemy-execute-raw-query
 */

import python
import semmle.python.security.dataflow.TaintTracking
import DataFlow::PathGraph

class SQLStringConcatSource extends DataFlow::Node {
  SQLStringConcatSource() {
    exists(MethodCall call |
      call.getMethod().getName() in ["__add__", "__mod__", "format"] and
      call.getMethod().getDeclaringType().hasQualifiedName("builtins", "str") and
      call = this.asDefiningNode()
    )
  }
}

class SQLExecutionSink extends DataFlow::Node {
  SQLExecutionSink() {
    exists(MethodCall call |
      call.getMethod().getName() = "execute" and
      call.getMethod().getDeclaringType().hasQualifiedName("sqlalchemy.engine.base", "Connection") and
      this.asExpr() = call.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodCall call |
      call.getMethod().getName() = "bindparams" and
      call.getMethod().getDeclaringType().hasQualifiedName("sqlalchemy.sql.expression", "text") and
      this.asExpr() = call.getReceiver()
    )
  }
}

class SQLInjectionConfig extends TaintTracking::Configuration {
  SQLInjectionConfig() { this = "SQLInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SQLStringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

from SQLInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. Use prepared statements instead."
