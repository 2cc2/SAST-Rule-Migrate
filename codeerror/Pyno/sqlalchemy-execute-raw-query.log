Rule Content:
/**
 * @name Avoiding SQL string concatenation
 * @description Untrusted input concatenated with raw SQL query can result in SQL Injection. Use prepared statements instead.
 * @kind taint
 * @problem.severity error
 * @id python/sqlalchemy-execute-raw-query
 */

import python
import semmle.python.security.injection.SqlInjection
import semmle.python.Concepts

class SqlStringConcatSource extends TaintSource::Range {
  SqlStringConcatSource() {
    exists(MethodCall call |
      call.getMethod().hasQualifiedName("str", "__add__") or
      call.getMethod().hasQualifiedName("str", "__mod__") or
      call.getMethod().hasQualifiedName("str", "format") 
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    exists(MethodCall call |
      (call.getMethod().hasQualifiedName("str", "__add__") or
       call.getMethod().hasQualifiedName("str", "__mod__") or
       call.getMethod().hasQualifiedName("str", "format")) and
      source.asExpr() = call
    )
  }
}

class SqlExecutionSink extends TaintSink::Range {
  SqlExecutionSink() {
    exists(MethodCall call |
      call.getMethod().hasQualifiedName("sqlalchemy.engine.base.Connection", "execute")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall call |
      call.getMethod().hasQualifiedName("sqlalchemy.engine.base.Connection", "execute") and
      sink.asExpr() = call.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends TaintSanitizer::Range {
  PreparedStatementSanitizer() {
    exists(MethodCall call |
      call.getMethod().hasQualifiedName("sqlalchemy.sql.expression.text", "bindparams")
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodCall call |
      call.getMethod().hasQualifiedName("sqlalchemy.sql.expression.text", "bindparams") and
      sanitizer.asExpr() = call
    )
  }
}

class SqlInjectionConfiguration extends TaintConfiguration {
  SqlInjectionConfiguration() { this = "SqlInjectionConfiguration" }

  override predicate isSource(DataFlow::Node source) { any(SqlStringConcatSource s).isSourceOf(source) }

  override predicate isSink(DataFlow::Node sink) { any(SqlExecutionSink s).isSink(sink) }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    any(PreparedStatementSanitizer s).isSanitizer(sanitizer)
  }
}

from SqlInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. Use prepared statements instead."
