Rule Content:
/**
 * @name SQLAlchemy Raw Query Execution with String Concatenation
 * @description Detects SQL injection vulnerabilities caused by string concatenation
 *              in SQLAlchemy execute() calls.
 * @kind path-problem
 * @problem.severity error
 * @id py/sqlalchemy-execute-raw-query
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class StrConcatSource extends DataFlow::Node {
  StrConcatSource() {
    exists(MethodCall call |
      call.getMethod().getName() in ["__add__", "__mod__", "format"] and
      call.getMethod().getDeclaringType().hasQualifiedName("builtins", "str") and
      this.asExpr() = call
    )
  }
}

class SqlExecuteSink extends DataFlow::Node {
  SqlExecuteSink() {
    exists(MethodCall call |
      call.getMethod().getName() = "execute" and
      call.getMethod().getDeclaringType().hasQualifiedName("sqlalchemy.engine.base", "Connection") and
      this.asExpr() = call.getArg(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(MethodCall call |
      call.getMethod().getName() = "bindparams" and
      call.getMethod().getDeclaringType().hasQualifiedName("sqlalchemy.sql.expression", "text") and
      this.asExpr() = call
    )
  }
}

module TaintConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { source instanceof StrConcatSource }
  predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecuteSink }
  predicate isSanitizer(DataFlow::Node node) { node instanceof PreparedStatementSanitizer }
}

module DangerousSQLExecution = TaintTracking::Global<TaintConfig>;

from DangerousSQLExecution::PathNode source, DangerousSQLExecution::PathNode sink
where DangerousSQLExecution::flowPath(source, sink)
select sink.getNode(), source, sink,
  "Avoiding SQL string concatenation: untrusted input concatenated with raw SQL query can result in SQL Injection. Use prepared statements instead."
