Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in `csv` module.
 * @id csv-writer-injection
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-1236
 */

import python
import semmle.python.security.injection.CsvInjectionCustomizations
import semmle.python.dataflow.new.TaintTracking
import semmle.python.web.flask.Flask

class CsvWriteSink extends DataFlow::Node {
  CsvWriteSink() {
    exists(Call call |
      call.getTarget().(FunctionValue).getSourceDeclaration() =
        any(Function f |
          f.getName() in ["writerow", "writerows", "writeheader"] and
          f.getFile().getRelativePath().regexpMatch(".*/csv.py$")
        ) and
      this.asExpr() = call.getArg(0)
    )
  }
}

class Configuration extends TaintTracking::Configuration {
  Configuration() { this = "CSV writer injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskSource or
    exists(MethodParameter param |
      param.getAnnotatedType().getAnnotation().toString().matches("@%APP.route%") and
      source.asParameter() = param
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CsvWriteSink
  }
}

from Configuration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Detected user input into a generated CSV file", source,
  "Using user input in CSV writing may lead to formula injection attacks."
