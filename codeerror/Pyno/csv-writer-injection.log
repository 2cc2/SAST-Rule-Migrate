Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in `csv` module.
 *              If user data is used to generate the data in this file, it is possible that an attacker
 *              could inject a formula when the CSV is imported into a spreadsheet application.
 * @kind path-problem
 * @problem.severity error
 * @id python/csv-writer-injection
 * @tags security
 *       external/cwe/cwe-1236
 */

import python
import semmle.python.ApiGraphs
import semmle.python.security.TaintTracking

class FlaskUserInputSource extends TaintSource::Range {
  FlaskUserInputSource() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in [
        "form.get", "form[]", "args.get", "args[]",
        "values.get", "values[]", "cookies.get", "cookies[]",
        "stream", "headers.get", "headers[]", "data",
        "full_path", "url", "json", "get_json",
        "view_args.get", "view_args[]"
      ] and
      ma.getQualifier().getType().hasName("flask.request")
    ) and
    this.asExpr() = any(MethodAccess ma).getAnArgument()
  }
}

class RouteParameterSource extends TaintSource::Range {
  RouteParameterSource() {
    exists(Function f, FunctionDef fd, Decorator d |
      fd = f.getEnclosingFunction() and
      d.getTarget() = f and
      d.getExpr().(Call).getTarget().toString().matches("@route") and
      this.asExpr() = fd.getAParameter().getAnArg()
    )
  }
}

class CsvWriterSink extends TaintSink::Range {
  CsvWriterSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["writerow", "writerows", "writeheader"] and
      ma.getQualifier().getType().hasName("csv.writer") and
      this.asExpr() = ma.getAnArgument(0)
    )
  }
}

class CsvWriterInjectionConfig extends TaintTracking::Configuration {
  CsvWriterInjectionConfig() { this = "CSV Writer Injection" }

  override predicate isSource(TaintSource::Range source) {
    source instanceof FlaskUserInputSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(TaintSink::Range sink) {
    sink instanceof CsvWriterSink
  }

  override predicate isSanitizer(TaintSanitizer::Range sanitizer) { none() }
}

from CsvWriterInjectionConfig cfg, TaintSource::Range source, TaintSink::Range sink
where cfg.hasFlow(source, sink)
select sink, "Detected user input into a generated CSV file. This may allow formula " +
  "injection when opened in spreadsheet applications, leading to potential code execution."
