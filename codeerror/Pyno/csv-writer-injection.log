/**
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in `csv` module.
 * @kind path-problem
 * @problem.severity error
 * @id python/csv-writer-injection
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.flask.Flask
import semmle.python.Concepts

class FlaskUserInput extends DataFlow::Source::Range {
  FlaskUserInput() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in [
        "form.get", "form.__getitem__", "args.get", "args.__getitem__",
        "values.get", "values.__getitem__", "cookies.get", "cookies.__getitem__",
        "stream", "headers.get", "headers.__getitem__", "data",
        "full_path", "url", "json", "get_json",
        "view_args.get", "view_args.__getitem__"
      ] and
      ma.getReceiver().getType().getName() = "flask.request"
    )
  }
}

class RouteParameterInput extends DataFlow::Source::Range {
  RouteParameterInput() {
    exists(Method m, DataFlow::MethodNode param |
      m.getDecoratorName() = "route" and
      param = m.getAParameter() and
      this.asSource() = param
    )
  }
}

class CsvWriterApi extends DataFlow::Sink::Range {
  CsvWriterApi() {
    exists(MethodAccess ma |
      ma.getMethod().getName() in ["writerow", "writerows", "writeheader"] and
      ma.getReceiver().getType().getName() = "csv.writer" and
      this.asSink() = ma.getArgument(0)
    )
  }
}

class CsvWriterInjectionConfig extends TaintTracking::Configuration {
  CsvWriterInjectionConfig() { this = "CSV Writer Injection" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskUserInput or
    source instanceof RouteParameterInput
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof CsvWriterApi
  }
}

from CsvWriterInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected user input into a generated CSV file using the built-in csv module. " +
  "If user data is used to generate the data in this file, it is possible that an attacker could inject a formula " +
  "when the CSV is imported into a spreadsheet application that runs an attacker script, which could steal data " +
  "from the importing user or, at worst, install malware on the user's computer. " +
  "`defusedcsv` is a drop-in replacement with the same API that will attempt to mitigate formula injection attempts.", 
  source, "User input flows to CSV writing operation here."
