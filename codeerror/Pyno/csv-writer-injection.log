Rule Content:
/**
 * @name CSV Writer Injection
 * @description Detected user input into a generated CSV file using the built-in csv module.
 * @id csv-writer-injection
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-1236
 */

import python
import semmle.python.security.dataflow.TaintTracking
import python.frameworks.flask

class UserInputSource extends DataFlow::Source {
  UserInputSource() {
    exists(DataFlow::CallNode call |
      // Flask user input sources
      (
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.form.get" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.form.__getitem__" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.args.get" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.args.__getitem__" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.values.get" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.values.__getitem__" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.cookies.get" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.cookies.__getitem__" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.stream" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.headers.get" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.headers.__getitem__" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.data" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.full_path" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.url" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.json" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.get_json" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.view_args.get" or
        call.getTarget().(FunctionValue).getQualifiedName() = "flask.request.view_args.__getitem__"
      ) and
      this = call.getResult()
    ) or
    // Route parameter sources
    exists(Flask::AppFunctionRoute regexRoute |
      regexRoute.getADecorator().getLocation().getFile().getRelativePath().regexpMatch(".*")
      and
      this = DataFlow::parameterNode(regexRoute.getFunction())
    )
  }
}

class CsvWriterSink extends DataFlow::Sink {
  CsvWriterSink() {
    exists(DataFlow::CallNode call |
      (
        call.getTarget().(FunctionValue).getQualifiedName() = "csv.writer.writerow" or
        call.getTarget().(FunctionValue).getQualifiedName() = "csv.writer.writerows" or
        call.getTarget().(FunctionValue).getQualifiedName() = "csv.writer.writeheader"
      ) and
      this = call.getArgument(0)
    )
  }
}

class CsvWriterInjectionConfig extends TaintTracking::Configuration {
  CsvWriterInjectionConfig() { this = "CSV Writer Injection" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof CsvWriterSink }
}

from CsvWriterInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential CSV formula injection via user input. " +
  "User data used to generate CSV data may allow formula injection when imported into spreadsheet applications. " +
  "Consider using defusedcsv module to mitigate formula injection.", source, sink,
  "User input flows to CSV writer here"
