Rule Content:
/**
 * @name CSV Writer Formula Injection
 * @description Detects user input written to CSV using the built-in `csv` module.
 * Formula injection in CSV files can lead to script execution when opened in spreadsheet applications.
 * @kind path-problem
 * @problem.severity error
 * @tags security
 *       external/cwe/cwe-1236
 */

import python
import semmle.python.security.data.CsvWriterInjection
import semmle.python.web.flask.Flask
import DataFlow::PathGraph

class FlaskUserInput extends DataFlow::Node {
  FlaskUserInput() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask.request.form", "get") or
      ma.getMethod().hasQualifiedName("flask.request.form", "__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request.args", "get") or
      ma.getMethod().hasQualifiedName("flask.request.args", "__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request.values", "get") or
      ma.getMethod().hasQualifiedName("flask.request.values", "__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request.cookies", "get") or
      ma.getMethod().hasQualifiedName("flask.request.cookies", "__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "stream") or
      ma.getMethod().hasQualifiedName("flask.request.headers", "get") or
      ma.getMethod().hasQualifiedName("flask.request.headers", "__getitem__") or
      ma.getMethod().hasQualifiedName("flask.request", "data") or
      ma.getMethod().hasQualifiedName("flask.request", "full_path") or
      ma.getMethod().hasQualifiedName("flask.request", "url") or
      ma.getMethod().hasQualifiedName("flask.request", "json") or
      ma.getMethod().hasQualifiedName("flask.request", "get_json") or
      ma.getMethod().hasQualifiedName("flask.request.view_args.getClass()", "get") or
      ma.getMethod().hasQualifiedName("flask.request.view_args", "__getitem__") |
      ma = self.asExpr()
    )
  }
}

class RouteParameterInput extends DataFlow::Node {
  RouteParameterInput() {
    exists(Function f, Call c |
      c.isDecoratorCall("flask.Flask.route") and
      f.(FunctionValue).getADeclaration() = c.getEnclosingCallable() and
      self.asParameter() = f.getAParameter()
    )
  }
}

class CsvSink extends DataFlow::Node {
  CsvSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("csv.writer", "writerow") or
      ma.getMethod().hasQualifiedName("csv.writer", "writerows") or
      ma.getMethod().hasQualifiedName("csv.writer", "writeheader") |
      ma.getAnArgument() = self.asExpr()
    )
  }
}

predicate isSource(DataFlow::Node source) {
  source instanceof FlaskUserInput or
  source instanceof RouteParameterInput
}

predicate isSink(DataFlow::Node sink) {
  sink instanceof CsvSink
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  isSource(source.getNode()) and
  isSink(sink.getNode()) and
  DataFlow::localFlow(source, sink)
select sink, "Potential CSV formula injection from user input to csv.writer() method", 
