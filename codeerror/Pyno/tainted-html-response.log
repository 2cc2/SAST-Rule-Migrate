Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability, which could let attackers steal sensitive user data.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-html-response
 */

import python
import semmle.python.security.dataflow.TaintTracking
import DataFlow::PathGraph

class EventParameter extends DataFlow::Node {
  EventParameter() {
    exists(Parameter p |
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class HtmlResponseBody extends DataFlow::Node {
  HtmlResponseBody() {
    exists(Parameter p |
      p.getType().getName().matches(".*text/html.*") and
      p.getScope().getName() = "body" and
      this.asParameter() = p
    )
  }
}

class TaintedHtmlResponseFlowConfig extends TaintTracking::Configuration {
  TaintedHtmlResponseFlowConfig() { this = "TaintedHtmlResponseFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlResponseBody
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::Argument arg |
      arg.getParameter() = node2.asParameter() and
      arg.getCall() = node1.getFunctionAccess()
    )
  }
}

from TaintedHtmlResponseFlowConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "User input flows into HTML response, potentially creating XSS vulnerability"
