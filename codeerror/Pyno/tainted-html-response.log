Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally
 *              bypassing secure methods of rendering HTML by manually constructing HTML
 *              and this could create a cross-site scripting vulnerability, which could
 *              let attackers steal sensitive user data.
 * @kind taint-problem
 * @problem.severity warning
 * @id java/tainted-html-response
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringControllerRequestParam

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(MethodParameter p |
      p.getAnUnqualifiedName() = "event" and
      this.asParameter() = p
    )
  }
}

class HtmlResponseBody extends DataFlow::Node {
  HtmlResponseBody() {
    exists(MethodParameter p |
      p.getType().toString().matches("%text/html%") and
      p.getParentScope() instanceof BodyScope and
      this.asParameter() = p
    )
  }
}

class TaintedHtmlResponseConfig extends TaintTracking::Configuration {
  TaintedHtmlResponseConfig() {
    this = "TaintedHtmlResponseConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlResponseBody
  }
}

from TaintedHtmlResponseConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential XSS vulnerability: user input flows into HTML response body"
