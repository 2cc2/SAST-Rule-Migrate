Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing
 *  secure methods of rendering HTML by manually constructing HTML and this could create a 
 *  cross-site scripting vulnerability, which could let attackers steal sensitive user data.
 * @kind path-problem
 * @problem.severity warning
 * @id cs/tainted-html-response
 */

import semmle.python.dataflow.TaintTracking
import semmle.python.web.HtmlResponse

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(Parameter p |
      p.hasName("event") and
      this.asParameter() = p
    )
  }
}

class HtmlResponseBody extends DataFlow::Node {
  HtmlResponseBody() {
    exists(Parameter p |
      p.getType().hasName(/.*text\/html.*/) and
      p.getScope().getName() = "body" and
      this.asParameter() = p
    )
  }
}

class EventToBodyTaintConfig extends TaintTracking::Configuration {
  EventToBodyTaintConfig() { this = "EventToBodyTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof HtmlResponseBody
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    succ = pred.(Argument).getParameter()
  }
}

from EventToBodyTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, "User input flows into HTML response body, creating XSS risk"
