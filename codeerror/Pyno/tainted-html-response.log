Rule Content:
/**
 * @name Tainted HTML Response
 * @description Detected user input flowing into an HTML response. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability, which could let attackers steal sensitive user data.
 * @kind taint-problem
 * @problem.severity warning
 * @id security/tainted-html-response
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Web
import semmle.python.XSS

class EventParamSource extends TaintSource::Range {
  EventParamSource() {
    exists(PyParameter param |
      param.getName() = "event" and
      this = param.asSource()
    )
  }
}

class HtmlResponseSink extends TaintSink::Range {
  HtmlResponseSink() {
    exists(PyParameter param |
      param.getType().getName().regexpMatch(".*text/html.*") and
      exists(param.getCall() |
        param.getArgumentPosition() = 1 and // assuming body is second positional argument
        this = param.asSink()
      )
    )
  }
}

query config(TaintTracking::Configuration cfg) {
  cfg.hasFlowPath(new EventParamSource(), new HtmlResponseSink())
}
