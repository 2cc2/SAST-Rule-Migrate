Rule Content:
/**
 * @id tainted-html-response
 * @severity WARNING
 * @message Detected user input flowing into an HTML response. You may be accidentally bypassing secure methods of rendering HTML by manually constructing HTML and this could create a cross-site scripting vulnerability, which could let attackers steal sensitive user data.
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.HttpRequest

class EventSource extends DataFlow::Source {
  EventSource() {
    exists(FunctionParam p |
      p.getName() = "event"
    )
  }
}

class HtmlSink extends DataFlow::Sink {
  HtmlSink() {
    exists(FunctionParam p |
      p.getType().getName().matches(".*text/html.*") and
      p.getContext().getName() = "body"
    )
  }
}

class HtmlConfiguration extends TaintTracking::Configuration {
  HtmlConfiguration() { this = "Tainted HTML response" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof HtmlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    pred.asExpr() = succ.(FunctionParam).getArgument()
  }
}

from HtmlConfiguration config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Potential XSS vulnerability: user input flows into HTML response body"
