Rule Content:
/**
 * @name MySQL SQL Injection via Event Parameter
 * @description Detected SQL statement that is tainted by `event` object. This could lead 
 * to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind taint-problem
 * @problem.severity warning
 * @id py/mysql-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.objects.AttributeAccess
import semmle.python.Concepts

class EventSource extends RemoteFlowSource::Range {
  EventSource() {
    exists(FunctionValue f, Parameter p |
      p = f.getAParameter() and
      p.getName() = "event" and
      exists(FunctionValue::named(f) or LambdaNode::getLambda(f))
    )
  }

  override string getSourceType() { result = "event parameter" }
}

class MySqlExecuteSink extends DataFlow::Node {
  MySqlExecuteSink() {
    exists(MethodCallNode call |
      call.getMethodName() in ["execute", "executemany"] and
      call.getACallee().getQualifiedName().matches("mysql.cursors.Cursor.%")
    )
  }
}

module MysqlSqliConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { source instanceof EventSource }
  predicate isSink(DataFlow::Node sink) { sink instanceof MySqlExecuteSink.asCalleeArgument(0) }
}

from MysqlSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "SQL statement is tainted by $@ and may be vulnerable to SQL injection. " +
  "Use parameterized queries or prepared statements instead.",
  source, source.getNode().toString()
