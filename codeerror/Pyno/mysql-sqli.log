Rule Content:
/**
 * @name MySQL SQL Injection via Event Parameter
 * @description Detected SQL statement that is tainted by `event` object. This could lead to SQL injection
 *              if the variable is user-controlled and not properly sanitized. In order to prevent SQL
 *              injection, use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id py/mysql-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.HttpRequest
import DataFlow::PathGraph

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(Parameter p |
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class MySqlExecute extends DataFlow::Node {
  MySqlExecute() {
    exists(CallNode call, MethodAccess ma |
      ma.getMethodName().regexpMatch("execute|executemany") and
      call.getTarget() = ma and
      ma.getQualifier().getType().getName() = "Cursor" and
      (ma.getQualifier().getType().getSourceDeclaration().getFile().getAbsolutePath().regexpMatch(".*mysql.*|.*cursors.*") or
       ma.getQualifier().getType().getSourceDeclaration().getFile().getAbsolutePath().regexpMatch(".*MySQLdb.*|.*cursors.*")) and
      this.asExpr() = call.getArg(0)
    )
  }
}

class EventToSqlFlowConfiguration extends TaintTracking::Configuration {
  EventToSqlFlowConfiguration() { this = "EventToSqlFlowConfiguration" }

  override predicate isSource(DataFlow::Node source) { source instanceof EventParam }

  override predicate isSink(DataFlow::Node sink) { sink instanceof MySqlExecute }
}

from EventToSqlFlowConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential SQL injection from event parameter to MySQL cursor execute method. Unsafe string concatenation detected."
