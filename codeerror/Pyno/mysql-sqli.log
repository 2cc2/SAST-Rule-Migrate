Rule Content:
/**
 * @name MySQL SQL Injection via event parameter
 * @description Detected SQL statement that is tainted by `event` object. This could lead 
 * to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/mysql-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.HttpRequest

class EventParameter extends DataFlow::Node {
  EventParameter() {
    exists(FunctionValue f, Parameter p |
      f = any(FunctionValue f | f.getAParameter() = p) and
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class MySqlExecuteCall extends DataFlow::Node {
  MySqlExecuteCall() {
    exists(CallNode call, MethodAccess ma |
      call = ma.getCall() and
      (ma.getMethodName() = "execute" or ma.getMethodName() = "executemany") and
      (ma.getQualifier().getType().toString() = "Cursor" or 
       ma.getQualifier().getBaseType().toString() = "Cursor") and
      (
        exists(ImportModule imp |
          imp.getName() = "mysql" or imp.getName() = "cursors"
        ) or
        exists(FromImport fi |
          fi.getSource().getValue() = "mysql" or fi.getSource().getValue() = "cursors"
        )
      ) and
      this = call.getArgument(0)
    )
  }
}

class MySqlSqliConfiguration extends TaintTracking::Configuration {
  MySqlSqliConfiguration() { this = "MySQL SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MySqlExecuteCall
  }
}

from MySqlSqliConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection from event parameter to MySQL execute call"
