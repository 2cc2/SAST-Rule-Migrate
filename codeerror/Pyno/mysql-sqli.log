Rule Content:
/**
 * @name mysql-sqli
 * @description Detected SQL statement that is tainted by `event` object. 
 * This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * In order to prevent SQL injection, use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id py/mysql-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class EventParam extends DataFlow::Node {
  EventParam() {
    exists(Parameter p |
      p.getName() = "event" and
      this.asParameter() = p
    )
  }
}

class MySqlCursorExecute extends DataFlow::Node {
  MySqlCursorExecute() {
    exists(MethodCall call |
      call.getMethod().getPackage() = "mysql" or
      call.getMethod().getPackage() = "cursors" and
      call.getMethod().getDeclaringType().hasName("Cursor") and
      (call.getMethod().hasName("execute") or call.getMethod().hasName("executemany")) and
      this = call.getArgument(0)
    )
  }
}

class MySQLTaintConfig extends TaintTracking::Configuration {
  MySQLTaintConfig() { this = "MySQLCursorSqlInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MySqlCursorExecute
  }
}

from MySQLTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection from event parameter to mysql cursor execute"
