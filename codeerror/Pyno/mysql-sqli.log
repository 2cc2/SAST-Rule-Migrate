Rule Content:
/**
 * @name MySQL SQL Injection via Event Parameter
 * @kind problem
 * @id python/mysql-sqli
 * @problem.severity warning
 * @precision high
 * @tags security
 *       external/cwe/cwe-089
 */
import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.web.HttpRequest
import semmle.python.dataflow.FunctionCalls

class EventParamSource extends DataFlow::Node {
  EventParamSource() {
    exists(FunctionInput fi |
      fi.asParameter().getName() = "event" and
      this = fi.getNode()
    )
  }
}

class MySqlSink extends DataFlow::Node {
  MySqlSink() {
    exists(Call call, MethodAccess ma |
      ma.getMethodName().matches("%execute%") and
      call.getTarget() = ma.getMethod() and
      (ma.getReceiver().getType().getName() = "Cursor" or
       ma.getReceiver().getType().getName().matches("%mysql%")) and
      this = call.getArgument(0)
    )
  }
}

class MysqlSqliFlowConfig extends TaintTracking::Configuration {
  MysqlSqliFlowConfig() { this = "MysqlSqliFlowConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof EventParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof MySqlSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from MysqlSqliFlowConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected SQL statement that is tainted by `event` object. " +
  "This could lead to SQL injection if the variable is user-controlled and " +
  "not properly sanitized. In order to prevent SQL injection, " +
  "use parameterized queries or prepared statements instead."
