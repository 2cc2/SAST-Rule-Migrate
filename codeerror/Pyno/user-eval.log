/**
 * @name eval-injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind taint
 * @problem.severity error
 * @id py/eval-injection
 */

import python
import semmle.python.security.TaintTracking

predicate isFlaskParam(DataFlow::Node node) {
    exists(Method method, string name |
        method.hasName("route") and
        method.getDeclaringType().getQualifiedName() = "flask.Flask" and
        node.asParameter() = method.getAParameter(name)
    )
}

class FlaskRequestSource extends RemoteFlowSource::Range {
    FlaskRequestSource() {
        exists(CallExpr call |
            call.getFunc().(Name).getId() = "request" and
            call.getFunc().getQualifier().getQualifiedName() = "flask" and
            call = this.asExpr()
        )
    }
}

class FlaskRouteParamSource extends RemoteFlowSource::Range {
    FlaskRouteParamSource() {
        isFlaskParam(this.asParameter())
    }
}

class EvalSink extends DataFlow::Node {
    EvalSink() {
        exists(Call call |
            call.getFunc().(Name).getId() = "eval" and
            this.asExpr() = call.getArg(0)
        )
    }
}

class EvalInjectionConfig extends TaintTracking::Configuration {
    EvalInjectionConfig() { this = "EvalInjectionConfig" }

    override predicate isSource(DataFlow::Node source) {
        source instanceof FlaskRequestSource or
        source instanceof FlaskRouteParamSource
    }

    override predicate isSink(DataFlow::Node sink) {
        sink instanceof EvalSink
    }
}

from EvalInjectionConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected user data flowing into eval. This is code injection and should be avoided."
