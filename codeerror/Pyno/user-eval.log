Rule Content:
/**
 * @name Eval Injection Vulnerability
 * @description Detects user-controlled data flowing into eval calls (Python code injection)
 * @kind path-problem
 * @problem.severity error
 * @id python/eval-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class FlaskRouteParameterSource extends DataFlow::Node {
  FlaskRouteParameterSource() {
    exists(MethodCallExpr routeCall |
      routeCall.getMethodName() = "route" and
      routeCall.getReceiver().getType().toString() = "Flask" and
      this.asParameter() = routeCall.getAParameter()
    )
  }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(AttributeAccess attr |
      attr.getObject().toString().matches("flask%.request%") and
      this = attr
    )
  }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(Call evalCall |
      evalCall.getFunc().(Name).getId() = "eval" and
      this = evalCall.getArg(0)
    )
  }
}

predicate isTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
  // Route parameter to function parameter flow
  any(FunctionDef f | pred.asParameter() = f.getAParameter() and succ = f.getBody().getAChildNode()) or
  // Flask request attribute access chain
  (pred instanceof FlaskRequestSource and succ.getAPredecessor*() = pred) or
  // Variable assignment propagation
  exists(AssignStmt assign | assign.getDest() = succ and assign.getSource() = pred)
}

from FlaskRouteParameterSource routeParam, FlaskRequestSource request, EvalSink sink, DataFlow::PathNode source, DataFlow::PathNode sinkNode
where
  (routeParam = source.getNode() or request = source.getNode()) and
  TaintTracking::localTaint(source, sinkNode, isTaintStep) and
  sinkNode.getNode() = sink
select sinkNode, "User-controlled data flows into eval call, leading to code injection vulnerability", source,
  "Unsafe data comes from $@", source.getNode(), "this user input"
