/**
 * @name eval-injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind taint
 * @problem.severity ERROR
 * @id py/eval-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask

class FlaskRouteParamSource extends DataFlow::Node {
  FlaskRouteParamSource() {
    exists(Method route, Parameter p |
      route.hasName("route") and
      route.getDeclaringType().getASourceSupertype() instanceof FlaskClass and
      p = route.getAParameter() and
      this.asParameter() = p
    )
  }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call call |
      call.getTarget().(Member).getQualifier().toString() = "flask.request" and
      this.asExpr() = call
    )
  }
}

class EvalSink extends DataFlow::Node {
  EvalSink() {
    exists(Call call |
      call.getTarget().hasName("eval") and
      this.asExpr() = call.getArg(0)
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "eval_injection_config" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRouteParamSource or
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof EvalSink
  }
}

from Config cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potentially unsafe user data flows into eval() call. This is code injection and should be avoided."
