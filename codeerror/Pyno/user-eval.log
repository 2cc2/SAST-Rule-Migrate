Rule Content:
/**
 * @name Dangerous eval injection
 * @description Detected user data flowing into eval. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/eval-injection
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Flask

class EvalInjectionConfig extends TaintTracking::Configuration {
  EvalInjectionConfig() { this = "EvalInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    // Flask route parameters as source
    exists(API::MethodCall routeCall |
      routeCall.getMethodName() = "route" and
      routeCall.getReceiverType().hasQualifiedName("flask", "Flask") and
      source.asParameter().getCall() = routeCall
    )
    or
    // Flask request objects as source
    exists(API::MethodCall requestCall |
      requestCall.getReceiver().getType().hasQualifiedName("flask", "request") and
      source.asExpr() = requestCall
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Function evalCall |
      evalCall.getName() = "eval" and
      sink.asExpr() = evalCall.getACall().getArg(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    none()
  }
}

from EvalInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected user data flowing into eval. This is code injection and should be avoided."
