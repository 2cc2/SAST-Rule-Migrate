Rule Content:
/**
 * @name Dangerous Interactive Code Run
 * @id python/dangerous-interactive-code-run
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.
 *              This is dangerous if external data can reach this function call because it allows
 *              a malicious actor to run arbitrary Python code. Ensure no external data reaches here.
 * @kind path-problem
 * @problem.severity warning
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.Concepts

/** The source of tainted data - interactive console methods with potentially dangerous inputs */
class DangerousInteractiveSource extends TaintTracker::Source {
  DangerousInteractiveSource() {
    exists(Call call |
      call.getTarget().getAPackage() = "code" and
      (call.getTarget().getType().getName() = "InteractiveConsole" or
       call.getTarget().getType().getName() = "InteractiveInterpreter") and
      (call.getTarget().getName() = "push" or
       call.getTarget().getName() = "runsource" or
       call.getTarget().getName() = "runcode") and
      call.getArgument(0).toString() != "\"\"\""
    |
      result = call.getArgument(0)
    )
  }
}

/** The sink where code execution occurs */
class DangerousCodeExecution extends TaintTracker::Sink {
  DangerousCodeExecution() {
    exists(Call call |
      call.getTarget().getAPackage() = "code" and
      (call.getTarget().getType().getName() = "InteractiveConsole" or
       call.getTarget().getType().getName() = "InteractiveInterpreter") and
      (call.getTarget().getName() = "compile_command" or
       call.getTarget().getName() = "runcode")
    |
      result = call
    )
  }
}

/** The sanitizer - literal triple quotes */
class TripleQuoteSanitizer extends TaintTracker::Sanitizer {
  TripleQuoteSanitizer() {
    exists(string literal | literal = "\"\"\"" | result = literal)
  }
}

/** The configuration for taint tracking */
class DangerousInteractiveCodeRunConfig extends TaintTracking::Configuration {
  DangerousInteractiveCodeRunConfig() { this = "DangerousInteractiveCodeRunConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DangerousInteractiveSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof DangerousCodeExecution
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof TripleQuoteSanitizer
  }
}

from DangerousInteractiveCodeRunConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it allows " +
  "a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
