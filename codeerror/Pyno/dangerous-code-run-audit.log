Rule Content:
/**
 * @id python.dangerous-interactive-code-run
 * @kind problem
 * @severity warning
 * @problem.severity warning
 * @name Dangerous interactive code execution
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.
 *              This is dangerous if external data can reach this function call because it allows 
 *              a malicious actor to run arbitrary Python code. Ensure no external data reaches here.
 */

import python
import semmle.python.security.TaintTracking

class InteractiveConsoleCall extends Call {
  InteractiveConsoleCall() {
    // Match InteractiveConsole or InteractiveInterpreter method calls
    (this.getTarget().getName().matches("push|runsource|runcode") or
     this.getTarget().getName().matches("compile_command|runcode")) and
    this.getTarget().getLocation().getFile().getRelativePath().matches("%code%") and
    this.getTarget().getType().matches("InteractiveConsole|InteractiveInterpreter")
  }
}

class DangerousInput extends DataFlow::Node {
  DangerousInput() {
    exists(string pattern | 
      not pattern.toString() = "\"\"\"" | 
      this.asExpr() = pattern
    )
  }
}

class TaintedConsoleInputConfiguration extends TaintTracking::Configuration {
  TaintedConsoleInputConfiguration() { this = "Dangerous interactive code execution" }

  override predicate isSource(DataFlow::Node source) {
    exists(InteractiveConsoleCall call |
      source.asExpr() = call.getArgument(0) and
      not source.asExpr().toString() = "\"\"\""
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(InteractiveConsoleCall call |
      sink.asExpr() = call and
      call.getTarget().getName().matches("compile_command|runcode")
    )
  }
}

from TaintedConsoleInputConfiguration config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
             "This is dangerous if external data can reach this function call because it allows " +
             "a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
