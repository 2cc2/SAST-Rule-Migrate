Rule Content:
/**
 * @name Dangerous Interactive Code Run
 * @id python/dangerous-interactive-code-run
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method.
 *              This is dangerous if external data can reach this function call because 
 *              it allows a malicious actor to run arbitrary Python code. 
 *              Ensure no external data reaches here.
 * @kind path-problem
 * @problem.severity warning
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.new.RemoteFlowSource
import DataFlow::PathGraph

class InteractiveCodeExecution extends DataFlow::Configuration {
  InteractiveCodeExecution() { this = "InteractiveCodeExecution" }

  override predicate isSource(DataFlow::Node source) {
    exists(
      CallNode call, string methodName |
      call.getTarget().hasQualifiedName("code", "InteractiveConsole", methodName) or
      call.getTarget().hasQualifiedName("code", "InteractiveInterpreter", methodName) |
      methodName.matches("%push%") or methodName.matches("%runsource%") or methodName.matches("%runcode%") |
      source.asExpr() = call.getArgument(0) and
      not source.asExpr().(StringLiteral).getText() = "\"\"\""
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(
      CallNode call, string methodName |
      call.getTarget().hasQualifiedName("code", "InteractiveConsole", methodName) or
      call.getTarget().hasQualifiedName("code", "InteractiveInterpreter", methodName) |
      methodName.matches("%compile_command%") or methodName.matches("%runcode%") |
      sink.asExpr() = call
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral lit |
      lit.getText() = "\"\"\"" and
      sanitizer.asExpr() = lit
    )
  }
}

from InteractiveCodeExecution config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
       "This allows arbitrary code execution if external data reaches this call.", source, sink
