Rule Content:
/**
 * @name Dangerous Interactive Code Execution
 * @description Detects dynamic content inside InteractiveConsole/InteractiveInterpreter methods
 *              which could lead to arbitrary code execution if tainted data reaches these calls.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 8.8
 * @tags security
 *       external/cwe/cwe-094
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class InteractiveConsoleInput extends DataFlow::Node {
  InteractiveConsoleInput() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["push", "runsource"]) and
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("code", "InteractiveConsole") or
        ma.getMethod().getDeclaringType().hasQualifiedName("code", "InteractiveInterpreter")
      ) and
      this.asExpr() = ma.getArgument(0) and
      not ma.getArgument(0).(StringLiteral).getValue() = "\"\"\""
    )
  }
}

class InteractiveCodeExecution extends DataFlow::Node {
  InteractiveCodeExecution() {
    exists(MethodAccess ma |
      ma.getMethod().hasName(["compile_command", "runcode"]) and
      (
        ma.getMethod().getDeclaringType().hasQualifiedName("code", "InteractiveConsole") or
        ma.getMethod().getDeclaringType().hasQualifiedName("code", "InteractiveInterpreter")
      ) and
      this.asExpr() = ma
    )
  }
}

class InteractiveConsoleConfig extends TaintTracking::Configuration {
  InteractiveConsoleConfig() { this = "InteractiveConsoleConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof InteractiveConsoleInput
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof InteractiveCodeExecution
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(StringLiteral lit |
      lit.getValue() = "\"\"\"" and
      sanitizer.asExpr() = lit
    )
  }
}

from InteractiveConsoleConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. " +
  "This is dangerous if external data can reach this function call because it allows " +
  "a malicious actor to run arbitrary Python code. Ensure no external data reaches here."
