Rule Content:
/**
 * @name Dangerous Interactive Code Run
 * @description Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. This is dangerous
 *              if external data can reach this function call because it allows a malicious actor to run 
 *              arbitrary Python code. Ensure no external data reaches here.
 * @kind path-problem
 * @problem.severity warning
 * @id python/dangerous-interactive-code-run
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class DangerousInteractiveCodeRunConfig extends TaintTracking::Configuration {
  DangerousInteractiveCodeRunConfig() { this = "DangerousInteractiveCodeRunConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodCall call, string methodName |
      call.getMethodName() = methodName and
      methodName.matches("%push%|%runsource%|%runcode%") and
      (
        call.getReceiverType().getName().matches("%InteractiveConsole%") or
        call.getReceiverType().getName().matches("%InteractiveInterpreter%")
      ) and
      source.asExpr() = call.getArgument(0) and
      not call.getArgument(0).getStringValue() = "\"\"\""
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall call, string methodName |
      call.getMethodName() = methodName and
      methodName.matches("%compile_command%|%runcode%") and
      (
        call.getReceiverType().getName().matches("%InteractiveConsole%") or
        call.getReceiverType().getName().matches("%InteractiveInterpreter%")
      ) and
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(Literal lit | 
      node.asExpr() = lit and
      lit.getStringValue() = "\"\"\""
    )
  }
}

from DangerousInteractiveCodeRunConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, 
  "Found dynamic content inside InteractiveConsole/InteractiveInterpreter method. This is dangerous if external data can reach here."
