Rule Content:
/**
 * @name Tainted SQL String Construction
 * @description Detected user input used to manually construct a SQL string. This is usually bad practice because 
 *              manual construction could accidentally result in a SQL injection. An attacker could use a SQL 
 *              injection to steal or modify contents of the database. Instead, use a parameterized query which 
 *              is available by default in most database engines. Alternatively, consider using an object-relational
 *              mapper (ORM) such as SQLAlchemy which will protect your queries.
 * @kind path-problem
 * @problem.severity error
 * @id python/tainted-sql-string
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Requests
import semmle.python.Concepts
import semmle.python.Strings

class UserInputSource extends TaintSource::Range {
  UserInputSource() {
    exists(DataFlow::CallNode call |
      call.getTarget().(FunctionValue).getAPIType() = "flask.request.$ANYTHING"
      and
      this.asDefiningNode() = call
    )
    or
    exists(MethodParameter param |
      param.getName().regexpMatch("$ROUTEVAR")
      and
      this.asDefiningNode() = param
    )
  }

  override predicate isSourceOf(DataFlow::Node source) {
    source = this.asDefiningNode()
  }
}

class SqlSink extends TaintSink::Range {
  SqlSink() {
    exists(LiteralString lit |
      lit.getValue().regexpMatch("\\s*(?i)(select|delete|insert|create|update|alter|drop)\\b.*")
      and
      this.asDefiningNode() = lit
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    sink = this.asDefiningNode()
  }
}

class TaintedSQLStringConfig extends TaintTracking::Configuration {
  TaintedSQLStringConfig() { this = "TaintedSQLStringConfig" }

  override predicate isSource(DataFlow::Node source) { any(UserInputSource s).isSource(source) }

  override predicate isSink(DataFlow::Node sink) { any(SqlSink s).isSink(sink) }

  override predicate isExtension(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from TaintedSQLStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potentially tainted SQL string constructed from user input", source,
  "User input flows into manually constructed SQL string"
