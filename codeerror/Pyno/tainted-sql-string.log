Rule Content:
/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string. 
 * This is usually bad practice because manual construction could accidentally 
 * result in a SQL injection. Instead, use parameterized queries or ORMs.
 * @kind path-problem
 * @problem.severity error
 * @id python/tainted-sql-string
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask.request", _) and
      ma = this.asExpr()
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Function f, Parameter p |
      p = f.getAParameter() and
      p.getName().regexpMatch(".*ROUTEVAR.*") and
      this.asParameter() = p
    )
  }
}

class SqlStringSink extends DataFlow::Node {
  SqlStringSink() {
    exists(StringLiteral s |
      s.getValue().regexpMatch("\\s*(?i)(select|delete|insert|create|update|alter|drop)\\b.*") and
      this.asExpr() = s
    )
  }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlStringSink
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagate taint through method arguments
    exists(MethodCall mc, Argument arg, Parameter p |
      arg = mc.getAnArgument() and
      p = mc.getACallee().getAParameter() and
      arg.asExpr() = node1.asExpr() and
      p = node2.asParameter()
    )
  }
}

from TaintedSqlStringConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink, 
  "Detected user input used to manually construct a SQL string. This may lead to SQL injection."
