Rule Content:
/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string. This is usually bad practice because manual construction could accidentally result in a SQL injection. An attacker could use a SQL injection to steal or modify contents of the database. Instead, use a parameterized query which is available by default in most database engines. Alternatively, consider using an object-relational mapper (ORM) such as SQLAlchemy which will protect your queries.
 * @kind path-problem
 * @problem.severity error
 * @id python/tainted-sql-string
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Requests
import semmle.python.Concepts

class UserInputSource extends TaintSource::Range {
  UserInputSource() {
    exists(string prov, string name |
      // Flask request parameters
      prov = "flask" and
      name.matches("%") and
      this = API::moduleImport("flask").getMember("request").getAMemberCall(name).getReturn()
    )
    or
    exists(string name, MethodParameter mp |
      // Route parameters
      name.matches("%ROUTE%") and
      mp.getName().matches(name) and
      this = mp.getValueSource()
    )
  }
}

class SqlStringSink extends TaintSink::Range {
  SqlStringSink() {
    exists(string sql |
      // SQL string literals
      this = Value::stringLiteral(sql) and
      sql.matches("(?i)\\s*(select|delete|insert|create|update|alter|drop)\\b.*")
    )
  }
}

class TaintedSqlStringConfig extends TaintTracking::Configuration {
  TaintedSqlStringConfig() { this = "TaintedSqlStringConfig" }

  override predicate isSource(TaintSource::Range source) {
    source instanceof UserInputSource
  }

  override predicate isSink(TaintSink::Range sink) {
    sink instanceof SqlStringSink
  }
}

from TaintedSqlStringConfig cfg, TaintSource::Range source, TaintSink::Range sink
where cfg.hasFlow(source, sink)
select sink, "Detected user input used to manually construct a SQL string, which may lead to SQL injection."
