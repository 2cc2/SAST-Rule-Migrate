Rule Content:
/**
 * @name Tainted SQL String
 * @description Detected user input used to manually construct a SQL string. This is usually bad practice because manual construction could accidentally result in a SQL injection. An attacker could use a SQL injection to steal or modify contents of the database. Instead, use a parameterized query which is available by default in most database engines. Alternatively, consider using an object-relational mapper (ORM) such as SQLAlchemy which will protect your queries.
 * @kind path-problem
 * @problem.severity error
 * @id python/tainted-sql-string
 */

import python
import semmle.python.security.strings.TaintTracking
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName().regexpMatch("flask\\.request\\..*") and
      ma = this.asExpr()
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Parameter p |
      p.getName().regexpMatch(".*ROUTEVAR.*") and
      p = this.asParameter()
    )
  }
}

class SqlStringSink extends DataFlow::Node {
  SqlStringSink() {
    exists(string s |
      s.regexpMatch("\\s*(?i)(select|delete|insert|create|update|alter|drop)\\b.*") and
      this.asExpr() = s
    )
  }
}

predicate isSource(DataFlow::Node source) {
  source instanceof FlaskRequestSource or
  source instanceof RouteParameterSource
}

predicate isSink(DataFlow::Node sink) {
  sink instanceof SqlStringSink
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  hasFlowPath(source, sink) and
  isSource(source.getNode()) and
  isSink(sink.getNode())
select sink, source, sink, "Detected user input used to manually construct a SQL string."
