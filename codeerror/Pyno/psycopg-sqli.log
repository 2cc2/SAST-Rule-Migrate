Rule Content:
/**
 * @name psycopg-sqli
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 * @kind path-problem
 * @problem.severity warning
 * @id py/psycopg-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.strings.Concatenation

class Psycopg2Cursor extends API::Method::Range {
  Psycopg2Cursor() {
    this.getPackageName() = "psycopg2.cursor" and
    (this.getName() = "execute" or this.getName() = "executemany" or this.getName() = "mogrify")
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(DataFlow::LocalSourceNode node | node = this.asDefiningNode() |
      not node.isLiteral()
    )
  }
}

class DangerousStringOperation extends DataFlow::Node {
  DangerousStringOperation() {
    exists(StringFormatOperation sfo | sfo.getAnOperand() = this) or
    exists(StringConcatenation sc | sc.getAnOperand() = this) or
    exists(StringModulusOperation smo | smo.getRightOperand() = this)
  }
}

class SafeConversionSanitizer extends DataFlow::BarrierGuard {
  SafeConversionSanitizer() {
    exists(DataFlow::Node node |
      node.(StringLiteral).getText().regexpMatch(".*\+.*") and
      this.asDefiningNode() = node
    )
  }
}

class PsycopgSqliConfig extends TaintTracking::Configuration {
  PsycopgSqliConfig() { this = "PsycopgSqliConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) {
    exists(Psycopg2Cursor call |
      call.getACall().getArgument(0) = sink.asExpr() and
      sink instanceof DangerousStringOperation
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SafeConversionSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::ParameterNode pn, DataFlow::ArgumentNode an |
      an = node1.asDefiningNode() and
      pn = node2.asDefiningNode() and
      an.(ArgumentNode).getCall() = pn.(ParameterNode).getCallable()
    ) or
    exists(StringFormatOperation sfo |
      sfo.getResultNode() = node2 and
      sfo.getFormatString() = node1
    )
  }
}

from PsycopgSqliConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected string concatenation with a non-literal variable in " +
"a psycopg2 Python SQL statement. This could lead to SQL injection if the variable is " +
"user-controlled and not properly sanitized. Use parameterized queries or prepared statements instead."
