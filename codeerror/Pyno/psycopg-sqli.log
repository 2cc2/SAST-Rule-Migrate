Rule Content:
/**
 * @name psycopg-sqli
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 *              Use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/psycopg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class PsycopgSqlInjectionConfig extends TaintTracking::Configuration {
  PsycopgSqlInjectionConfig() { this = "psycopg-sqli config" }

  override predicate isSource(DataFlow::Node source) {
    exists(Expr e |
      e = source.asExpr() and
      not e.isLiteral() and
      e instanceof Name
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall mc |
      mc = sink.asExpr() and
      mc.getMethodName().regexpMatch("execute|executemany|mogrify") and
      mc.getReceiverType().getName() = "cursor" and
      mc.getAPackageName() = "psycopg2" and
      sink = mc.getArgument(0) and
      (
        exists(Add add | add = mc.getArgument(0).asExpr() and add.getOperator() = "+") or
        exists(Call formatCall | formatCall = mc.getArgument(0).asExpr() and 
               formatCall.getMethodName() = "format") or
        exists(BinaryOperation modOp | modOp = mc.getArgument(0).asExpr() and 
               modOp.getOperator() = "%") or
        exists(FormattedValue fv | fv.getParent() = mc.getArgument(0).asExpr())
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Assign assign |
      assign.getRValue().asExpr() instanceof Add and
      assign.getRValue().asExpr().getLeftOperand().isStringLiteral() and
      assign.getRValue().asExpr().getRightOperand().isStringLiteral()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Argument to parameter propagation
    exists(Call call, Parameter param |
      node1.asExpr() = call.getAnArgument() and
      node2.asParameter() = param and
      param = call.getCallee().getAParameter()
    )
    or
    // String format return value propagation
    exists(Call call |
      call.getMethodName() = "format" and
      node1.asExpr() = call.getReceiver() and
      node2.asExpr() = call
    )
  }
}

from PsycopgSqlInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection vulnerability due to string concatenation"
