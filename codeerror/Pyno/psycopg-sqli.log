Rule Content:
/**
 * @name Psycopg2 SQL Injection
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 *              Use parameterized queries or prepared statements instead.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @tags security
 *       external/cwe/cwe-089
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.TaintTrackingKind
import semmle.python.WebSecurity

class Psycopg2Cursor extends ApiClass {
  Psycopg2Cursor() {
    this.getQualifiedName() = ["psycopg2.cursor"]
  }

  Method execute() { this.getName() = ["execute", "executemany", "mogrify"] }
}

class UserInput extends Range {
  UserInput() {
    exists(VariableAccess va |
      not va.getValue().isLiteral() and
      result = va.getLocation()
    )
  }
}

class SqlExecuteSink extends Range::Range, DataFlow::Node {
  SqlExecuteSink() {
    exists(MethodCall mc, Psycopg2Cursor cursor |
      mc.getMethod() = cursor.execute() and
      mc.getArgument(0) = this.asExpr() and
      (
        exists(BinaryExpr be | be.getOp() = "+" and be = this.asExpr()) or
        exists(Call call | call.getCalleeName() = "format" and call = this.asExpr()) or
        exists(BinaryExpr be | be.getOp() = "%" and be = this.asExpr()) or
        exists(FormattedValue fv | fv.getAncestor() = this.asExpr())
      )
    )
  }
}

class SafeConcatSanitizer extends DataFlow::Node {
  SafeConcatSanitizer() {
    exists(AssignStmt assign |
      assign.getRValue().(Str).getValue() = "... + ..." and
      this.asExpr() = assign.getRValue()
    )
  }
}

module TaintConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { source instanceof UserInput }
  predicate isSink(DataFlow::Node sink) { sink instanceof SqlExecuteSink }
  predicate isSanitizer(DataFlow::Node sanitizer) { sanitizer instanceof SafeConcatSanitizer }
  predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::CallEdge edge | edge.getSource() = node1 and edge.getDest() = node2)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig config
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Potential SQL injection vulnerability due to string concatenation with non-literal variable in psycopg2 SQL statement."
