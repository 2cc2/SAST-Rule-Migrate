Rule Content:
/**
 * @name Psycopg2 SQL Injection Vulnerability
 * @description Detects string concatenation with non-literal variables in psycopg2 SQL statements
 * @kind path-problem
 * @problem.severity warning
 * @id python/psycopg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.new.RemoteFlowSource

class Psycopg2SqlInjectionConfig extends TaintTracking::Configuration {
  Psycopg2SqlInjectionConfig() { this = "Psycopg2 SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    exists(DataFlow::NamedNode input |
      input instanceof Name
      and not exists(input.getValue().getLiteralValue())
      and source.asExpr() = input
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall call |
      call.getMethodName() in ["execute", "executemany", "mogrify"]
      and call.getReceiver().getType().(RefType).getQualifiedName() = "psycopg2.cursor.Cursor"
      and (
        exists(DataFlow::AddExpr add |
          sink.asExpr() = add.getAnOperand()
        )
        or
        exists(DataFlow::FormatString format |
          sink.asExpr() = format.getAnArg()
        )
        or
        exists(DataFlow::BinaryExpr bin |
          bin.getOperator() = "%" and sink.asExpr() = bin.getRightOperand()
        )
        or
        exists(FString fstring |
          sink.asExpr().getParent*() = fstring
        )
      )
      and sink.asExpr() = call.getArgument(1)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Assign assign |
      assign.getRhs().getValue().getLiteralValue() instanceof StringLiteral
      and sanitizer.asExpr() = assign.getRhs()
      and assign.getRhs().getValue().getLiteralValue() = "... + ..."
    )
  }
}

from Psycopg2SqlInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "String concatenation with non-literal variable in SQL query. This could lead to SQL injection."
