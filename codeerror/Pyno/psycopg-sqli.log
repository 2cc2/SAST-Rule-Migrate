Rule Content:
/**
 * @name Psycopg2 SQL Injection
 * @description Detected string concatenation with a non-literal variable in a psycopg2 Python SQL statement.
 * @kind problem
 * @problem.severity warning
 * @id py/psycopg-sqli
 * @tags security
 *       external/cwe/cwe-089
 *       external/cwe/cwe-564
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.security.strings.Concatenation

predicate isPsycopgCursorCall(DataFlow::CallNode call) {
  exists(Method method, string name |
    method.getAPIName() = name and
    name.matches("execute%") and
    method.getACallable().getQualifiedName().matches("%cursor%")
  )
}

class UnsafeStringConcatenation extends TaintTracking::Configuration {
  UnsafeStringConcatenation() { this = "Psycopg SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    exists(string id |
      source.asVar().getId() = id and
      not source.asExpr().isLiteral()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DataFlow::CallNode call |
      isPsycopgCursorCall(call) and
      call.getArgument(1) = sink.asExpr()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Assignment assign |
      assign.getRValue().getText().regexpMatch("'.*'\\s*\\+\\s*'.*'") and
      sanitizer.asExpr() = assign.getRValue()
    )
  }

  override predicate isAdditionTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // Handle string concatenation
    exists(StringConcat concat |
      (concat.getAnOperand() = node1.asExpr() and concat = node2.asExpr()) or
      (concat.getAnOperand() = node2.asExpr() and concat = node1.asExpr())
    )
    or
    // Handle string formatting
    exists(FormatString format |
      format.getAValue() = node1.asExpr() and
      format = node2.asExpr()
    )
  }
}

from UnsafeStringConcatenation cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected string concatenation with a non-literal variable in psycopg2 SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled. " +
  "Use parameterized queries or prepared statements instead."
