Rule Content:
/**
 * @name Template autoescape off
 * @description Detects Flask templates where autoescaping is explicitly disabled,
 *   which could lead to XSS vulnerabilities if user-controlled data is rendered.
 * @kind problem
 * @problem.severity warning
 * @id python/flask/template-autoescape-off
 */

import python
import flask

class AutoescapeOff extends Expr {
  AutoescapeOff() {
    this instanceof StringLit and
    this.getValue().matches("{%\\s*autoescape\\s+false\\s*%}")
  }
}

class HtmlRendering extends Expr {
  HtmlRendering() {
    exists(Field f | f = this | f.getType().getName() = "html")
  }
}

from AutoescapeOff unsafe, HtmlRendering rendering
where unsafe.getLocation().getFile() = rendering.getLocation().getFile()
select rendering,
  "Detected a segment of a Flask template where autoescaping is explicitly disabled. " +
  "This allows rendering of raw HTML in this segment. Ensure no user data is rendered here, " +
  "otherwise this is a cross-site scripting (XSS) vulnerability, or turn autoescape on."
