Rule Content:
/**
 * @name Dangerous asyncio exec audit
 * @description Detected subprocess function 'LOOP.subprocess_exec' without a static string.
 *              If this data can be controlled by a malicious actor, it may be an instance of command injection.
 *              Audit the use of this call to ensure it is not controllable by an external resource.
 *              You may consider using 'shlex.escape()'.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 */

import python
import semmle.python.Concepts
import semmle.python.security.ShellCommandInjection
import DataFlow::PathGraph

class DangerousAsyncioExecConfiguration extends TaintTracking::Configuration {
  DangerousAsyncioExecConfiguration() { this = "DangerousAsyncioExecAudit" }

  override predicate isSource(DataFlow::Node source) { 
    exists(API::MethodCall call |
      call.getMethod().hasName("subprocess_exec") and
      call.getReceiverType().hasQualifiedName("asyncio", "loop") and
      (
        // UNSAFE_EXEC pattern
        (call.getArgument(1).(StringLiteral).getValue().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)") and
         call.getArgument(2).(StringLiteral).getValue() = "-c")
        or
        // DYNAMIC_EXEC pattern
        (not call.getArgument(1).toString() = "..." and
         not call.getArgument(1).getAChild().toString() = "...")
      ) and
      source.asExpr() = call
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(API::MethodCall call |
      call.getMethod().hasName("subprocess_exec") and
      call.getReceiverType().hasQualifiedName("asyncio", "loop") and
      (
        // SAFE_EXEC pattern
        call.getArgument(1).toString() = "..."
        or
        // SAFE_EXEC_ARRAY pattern
        call.getArgument(1).getAChild().toString() = "..."
      ) and
      sanitizer.asExpr() = call
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(API::MethodCall call |
      call.getMethod().hasName("subprocess_exec") and
      call.getReceiverType().hasQualifiedName("asyncio", "loop") and
      sink.asExpr() = call
    )
  }
}

from DangerousAsyncioExecConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, "Potential command injection through asyncio loop.subprocess_exec", source,
  "This call uses potentially unsafe input that could lead to command injection."
