/**
 * @name Dangerous Asyncio Exec Audit
 * @description Detects subprocess function 'subprocess_exec' without a static string.
 *              If this data can be controlled by a malicious actor, it may be
 *              an instance of command injection.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 */

import python
import semmle.python.security.CommandInjection
import DataFlow::PathGraph

class UnsafeExecConfig extends TaintTracking::Configuration {
  UnsafeExecConfig() { this = "UnsafeAsyncioExecConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Call call |
      call.getTarget().hasQualifiedName("asyncio.loop", "subprocess_exec") and
      (
        // Match shell cases
        (
          call.getArg(1).getValue().regexpMatches("/(sh|bash|ksh|csh|tcsh|zsh)/") and
          call.getArg(2).getValue() = "-c"
        )
        or
        // Match dynamic command cases
        (
          not call.getArg(1).getValue() instanceof StringLiteral and
          not call.getArg(1).getChild(0).getValue() instanceof StringLiteral
        )
      ) and
      source.asExpr() = call
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getTarget().hasQualifiedName("asyncio.loop", "subprocess_exec") and
      (
        call.getArg(1).getValue() instanceof StringLiteral or
        call.getArg(1).getChild(0).getValue() instanceof StringLiteral
      ) and
      sanitizer.asExpr() = call
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getTarget().hasQualifiedName("asyncio.loop", "subprocess_exec") and
      sink.asExpr() = call
    )
  }
}

from UnsafeExecConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected subprocess function 'subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance " +
  "of command injection. Audit the use of this call to ensure it is not " +
  "controllable by an external resource. You may consider using 'shlex.escape()'."
