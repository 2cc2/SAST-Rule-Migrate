Rule Content:
/**
 * @name Dangerous asyncio.exec Audit
 * @description Detects subprocess function 'LOOP.subprocess_exec' without a static string,
 *              which may lead to command injection if controllable by malicious actor.
 * @kind path-problem
 * @problem.severity error
 * @id py/dangerous-asyncio-exec-audit
 */

import python
import semmle.python.security.injection.CommandInjectionLib

class UnsafeSubprocessExec extends CommandInjection::Sink {
  UnsafeSubprocessExec() {
    exists(Call call |
      call.getTarget().hasQualifiedName("asyncio.loop", "subprocess_exec") and
      (
        call.getArg(1).getValue().regexpMatch("sh|bash|ksh|csh|tcsh|zsh") and
        call.getArg(2).getValue() = "-c"
        or
        not call.getArg(1).getValue() = "..." and
        not call.getArg(1).getChild(0).getValue() = "..."
      )
    )
  }

  override string getAlertMessage() {
    return "Detected subprocess function 'LOOP.subprocess_exec' without a static string. " +
           "If this data can be controlled by a malicious actor, command injection may occur. " +
           "Consider using 'shlex.escape()' or static commands."
  }
}

class SafeSubprocessExecSanitizer extends CommandInjection::Sanitizer {
  SafeSubprocessExecSanitizer() {
    exists(Call call |
      call.getTarget().hasQualifiedName("asyncio.loop", "subprocess_exec") and
      (
        call.getArg(1).getValue() = "..." or
        call.getArg(1).getChild(0).getValue() = "..."
      )
    )
  }
}

from UnsafeSubprocessExec sink, CommandInjection::Configuration config
where config.hasFlowPath(sink, _)
select sink, sink.getAlertMessage()
