Rule Content:
/**
 * @name Dangerous AsyncIO Exec Audit
 * @description Detects subprocess function calls without static commands
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec-audit
 */

import python
import semmle.python.Concepts

class DangerousAsyncIOExec extends DataFlow::Configuration {
  DangerousAsyncIOExec() { this = "DangerousAsyncIOExec" }

  override predicate isSource(DataFlow::Node source) { 
    exists(Call call |
      call.getTarget().getMethodName() = "subprocess_exec" and
      call.getTarget().getBaseType().getQualifiedName() = "asyncio.loop" and
      // Match unsafe shell invocations
      (
        exists(string arg1 |
          arg1 = call.getArgument(1).getStringValue() and
          regexpMatch("/(sh|bash|ksh|csh|tcsh|zsh)/", arg1) and
          call.getArgument(2).getStringValue() = "-c"
        )
        or
        // Match dynamic command executions
        not (
          call.getArgument(1).getStringValue() = "..." or
          call.getArgument(1).getArrayElement(0).getStringValue() = "..."
        )
      )
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Call call |
      call.getTarget().getMethodName() = "subprocess_exec" and
      call.getTarget().getBaseType().getQualifiedName() = "asyncio.loop" and
      (
        call.getArgument(1).getStringValue() = "..." or
        call.getArgument(1).getArrayElement(0).getStringValue() = "..."
      )
    )
  }

  override predicate isSink(DataFlow::Node sink) { 
    exists(Call call |
      call.getTarget().getMethodName() = "subprocess_exec" and
      call.getTarget().getBaseType().getQualifiedName() = "asyncio.loop" and
      sink = call.getArgument(1)
    )
  }
}

from DangerousAsyncIOExec cfg, DataFlow::Node sink, DataFlow::PathNode source
where cfg.hasFlowPath(source, sink)
select sink, 
  "Detected subprocess function call without static command. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "Consider using 'shlex.escape()'."
