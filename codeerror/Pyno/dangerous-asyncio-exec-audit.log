Rule Content:
/**
 * @name Dangerous asyncio.subprocess_exec Usage
 * @description Detects subprocess function '$LOOP.subprocess_exec' without a static string.
 *              If this data can be controlled by a malicious actor, it may be an instance
 *              of command injection.
 * @kind path-problem
 * @problem.severity error
 * @id python/dangerous-asyncio-exec
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class AsyncioSubprocessExecConfig extends TaintTracking::Configuration {
  AsyncioSubprocessExecConfig() { this = "AsyncioSubprocessExecConfig" }

  override predicate isSource(Node node) {
    exists(SourceNode src | src.asExpr() = node)
  }

  override predicate isSink(Node node) {
    exists(Call call, ApiNode api |
      call = node.asExpr() and
      api = call.getCalleeNode() and
      api.getPackage() = "asyncio" and
      api.getType() = "loop" and
      api.getName() = "subprocess_exec" and
      (
        // UNSAFE_EXEC pattern
        (
          call.getArg(1).getStringValue().regexpMatch("(sh|bash|ksh|csh|tcsh|zsh)") and
          call.getArg(2).getStringValue() = "-c"
        )
        or
        // DYNAMIC_EXEC pattern
        (
          not call.getArg(1).getStringValue() = "..." and
          (exists(ArrayExpr arr | 
            arr = call.getArg(1) and
            not arr.getIndex(0).getStringValue() = "..."
          ))
        )
      )
    )
  }

  override predicate isSanitizer(Node node) {
    exists(Call call, ApiNode api |
      call = node.asExpr() and
      api = call.getCalleeNode() and
      api.getPackage() = "asyncio" and
      api.getType() = "loop" and
      api.getName() = "subprocess_exec" and
      (
        // SAFE_EXEC pattern
        call.getArg(1).getStringValue() = "..."
        or
        // SAFE_EXEC_ARRAY pattern
        (exists(ArrayExpr arr |
          arr = call.getArg(1) and
          arr.getIndex(0).getStringValue() = "..."
        ))
      )
    )
  }
}

from DangerousCall dangerous, DataFlow::PathNode source, DataFlow::PathNode sink
where
  exists(AsyncioSubprocessExecConfig cfg |
    cfg.hasFlowPath(source, sink) and
    dangerous = sink.getNode().(Call)
  )
select sink, "Detected subprocess function '$LOOP.subprocess_exec' without a static string. " +
  "If this data can be controlled by a malicious actor, it may be an instance of command injection. " +
  "Audit the use of this call to ensure it is not controllable by an external resource. " +
  "You may consider using 'shlex.escape()'.", source, dangerous.toString()
