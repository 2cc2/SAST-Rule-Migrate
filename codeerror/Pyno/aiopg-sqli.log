Rule Content:
/**
 * @name aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg
 * Python SQL statement. This could lead to SQL injection if the variable is user-controlled
 * and not properly sanitized. In order to prevent SQL injection,
 * use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/aiopg-sqli
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.new.TaintTracking
import semmle.python.ApiGraphs

class AiopgCursorExecute extends DataFlow::CallNode {
  AiopgCursorExecute() {
    exists(Method method, Value receiverType |
      this.getTarget().(MethodValue).getMethod() = method and
      method.hasName("execute") and
      receiverType = method.getAParentScope() and
      receiverType.getQualifiedName() = "aiopg.Cursor"
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(Identifier id |
      id = this.asDefiningNode() and
      not id.getValue().toString() = "None"
    )
  }
}

class StringConcatProp extends TaintTracking::AdditionalTaintStep {
  override predicate step(DataFlow::Node src, DataFlow::Node sink) {
    exists(DataFlow::CallNode call |
      call = sink.asExpr().getParent*() and
      call.getInstance().toString() = "+" and
      src.asExpr() = call.getAnArgument()
    )
  }
}

class AiopgSqliConfig extends TaintTracking::Configuration {
  AiopgSqliConfig() { this = "AiopgSqliConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof UserInputSource }

  override predicate isSink(DataFlow::Node sink) {
    exists(AiopgCursorExecute call |
      call.getArgument(0) = sink.asExpr() and
      not call.getArgument(0).getValue().toString().regexpMatch("%s")
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(AiopgCursorExecute call |
      call.getArgument(0) = sanitizer.asExpr() and
      call.getArgument(0).getValue().toString().regexpMatch("%s")
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node src, DataFlow::Node sink) {
    sink instanceof StringConcatProp
  }
}

