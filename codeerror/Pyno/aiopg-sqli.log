Rule Content:
/**
 * @name aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg
 * Python SQL statement. This could lead to SQL injection if the variable is user-controlled
 * and not properly sanitized. In order to prevent SQL injection,
 * use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id py/aiopg-sqli
 */

import python
import semmle.python.security.SQLInjectionCustom
import semmle.python.DangerousFunctions
import semmle.python.dataflow.TaintTracking

class AiogpCursorExecute extends DataFlow::CallNode {
  AiogpCursorExecute() {
    exists(string methodName | 
      this.getTarget().getClass().(RefType).getName() = "Cursor" and
      this.getTarget().getClass().getPackage().getName() = "aiopg" and
      methodName = "execute" and
      this.getTarget().getMethod().getName() = methodName
    )
  }

  string getQuery() { result = this.getArgument(1).asExpr() }
}

class UserInput extends DataFlow::Source::Range {
  UserInput() {
    exists(DataFlow::IdentifierNode id |
      id = this.asExpr().getAnASTNode() and
      not id.getValue().toString() = "None"
    )
  }
}

class StringConcatTaint extends DataFlow::Configuration {
  StringConcatTaint() { this = "StringConcatTaint" }

  override predicate isSource(DataFlow::Source source) { source instanceof UserInput }

  override predicate isSink(DataFlow::Sink sink) {
    sink.asDefiningArgument() = any(AiogpCursorExecute execute).getQuery()
  }

  override predicate isSanitizer(DataFlow::Sanitizer sanitizer) {
    exists(AiogpCursorExecute execute |
      execute.getQuery().toString().regexpMatch(".*%s.*") and
      sanitizer.asExpr() = execute.getQuery()
    )
  }
}

from StringConcatTaint config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected string concatenation with a non-literal variable in an aiopg SQL statement."
