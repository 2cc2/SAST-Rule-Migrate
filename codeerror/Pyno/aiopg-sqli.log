Rule Content:
/**
 * @name Aiopg SQL Injection
 * @description Detecting unsafe SQL string concatenation in aiopg Python SQL statements.
 * @kind path-problem
 * @problem.severity warning
 * @id py/aiopg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class AiopgConfig extends TaintTracking::Configuration {
  AiopgConfig() { this = "AiopgSqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(DataFlow::FlowNode id |
      id.asExpr().(Identifier).getName() != "None" and
      source.asExpr() = id.asExpr()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Call call |
      call.getTarget().(Member).getObject().getType().getASourceSuperType*().hasQualifiedName("aiopg", "Cursor") and
      call.getTarget().(Member).getName() = "execute" and
      (
        exists(DataFlow::FlowNode arg |
          arg.asExpr() = call.getArg(1) and
          sink.asExpr() = arg.asExpr() and
          not call.getArg(1).getStringValue().matches("%s")
        )
      )
    )
  }
}

from AiopgConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source.getNode(),
  "Detected string concatenation with a non-literal variable in an aiopg SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled. " +
  "Use parameterized queries instead."
