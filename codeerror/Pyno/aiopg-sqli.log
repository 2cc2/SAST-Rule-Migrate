Rule Content:
/**
 * @name aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg
 * Python SQL statement. This could lead to SQL injection if the variable is user-controlled
 * and not properly sanitized. In order to prevent SQL injection,
 * use parameterized queries instead.
 * @kind problem
 * @severity Warning
 * @id py/aiopg-sqli
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(DataFlow::Node node |
      node = DataFlow::identifierNode(_) and
      not node.getValue().toString() = "None"
    )
  }
}

class AiopgExecuteSink extends DataFlow::Node {
  AiopgExecuteSink() {
    exists(MethodCallNode call |
      call.getMethod().getName() = "execute" and
      call.getMethodDeclaration().getDeclaringType().getName() = "Cursor" and
      call.getMethodDeclaration().getDeclaringType().getModule().getName() = "aiopg"
    )
  }
}

class ParameterizedQuerySanitizer extends DataFlow::BarrierGuard {
  override predicate checks(DataFlow::Node node, DataFlow::Predecessor predecessor) {
    exists(string query |
      query = node.asExpr().(StringLiteral).getText() and
      query.matches("%s")
    )
  }
}

from 
  DataFlow::PathNode source, DataFlow::PathNode sink
where
  TaintTracking::localTaint(source.getNode(), sink.getNode()) and
  source.getNode() instanceof UserInputSource and
  sink.getNode() instanceof AiopgExecuteSink and
  not exists(DataFlow::PathNode barrier |
    barrier.getNode().(ParameterizedQuerySanitizer).checks(_, _) and
    sink.hasFlowTo(barrier)
  )
select sink, 
  "Potential SQL injection from string concatenation with user input in aiopg.execute()",
  source, "User input flows into SQL query here"
