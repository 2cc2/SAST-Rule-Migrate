Rule Content:
/**
 * @name aiopg-sqli
 * @description Detected string concatenation with a non-literal variable in an aiopg
 *              Python SQL statement. This could lead to SQL injection if the variable is user-controlled
 *              and not properly sanitized. In order to prevent SQL injection,
 *              use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/aiopg-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class AiopgCursorExecuteCall extends DataFlow::CallNode {
  AiopgCursorExecuteCall() {
    exists(Method method, Value api |
      api.(Class).getQualifiedName() = "aiopg.Cursor" and
      method.getName() = "execute" and
      this = api.getAMethodCall(method)
    )
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    // Source is any identifier that represents user input (not None)
    exists(Identifier id |
      this.asExpr() = id and
      not id.getName() = "None"
    )
  }
}

class ParameterizedQuerySanitizer extends DataFlow::Node {
  ParameterizedQuerySanitizer() {
    // Check if the query contains parameter placeholders (%s)
    exists(string literal |
      this.asExpr().getStringValue() = literal and
      literal.regexpMatch("%s")
    )
  }
}

class StringConcatPropagator extends DataFlow::Step {
  StringConcatPropagator() {
    // Propagate taint through string concatenation operations
    exists(DataFlow::Node from, DataFlow::Node to |
      from.asExpr().(Add).getAnOperand() = to.asExpr()
      or
      to.asExpr().(Add).getAnOperand() = from.asExpr()
    )
  }
}

class AiopgSqliConfiguration extends TaintTracking::Configuration {
  AiopgSqliConfiguration() {
    this = "Aiopg SQL Injection Configuration"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(AiopgCursorExecuteCall call |
      call.getArgument(1) = sink.asExpr()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }

  override predicate isAdditionalStep(DataFlow::Node pred, DataFlow::Node succ) {
    new StringConcatPropagator().propagates(pred, succ)
  }
}

