Rule Content:
/**
 * @name Formatted SQL Query Detection
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/formatted-sql-query
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs

class StrFormatCall extends DataFlow::Node {
  StrFormatCall() {
    exists(CallNode call |
      call = globalCode("str.format") or
      call = memberCode(["str", "format"])
    |
      this = call.getReceiver() |
      exists(stringLiteral |
        stringLiteral.getValue().regexpMatch(".*%.*")
      )
    )
  }
}

class SQLExecutionCall extends DataFlow::Node {
  SQLExecutionCall() {
    exists(CallNode call |
      call = globalCode("$DB.execute") or
      call = memberCode(["$DB", "execute"])
    |
      this = call.getArgument(0)
    )
  }
}

class ParameterizedQuerySanitizer extends DataFlow::Node {
  ParameterizedQuerySanitizer() {
    exists(CallNode call |
      call = globalCode("$DB.execute") or
      call = memberCode(["$DB", "execute"])
    |
      this = call.getArgument(0) |
      not (
        exists(stringLiteral |
          stringLiteral.getValue().regexpMatch(".*%.*") or
          stringLiteral.getValue().regexpMatch(".*\{.*\}.*")
        ) or
        exists(StrFormatCall strFormat |
          strFormat = this.asExpr()
        )
      )
    )
  }
}

class FormattedSQLQueryConfig extends TaintTracking::Configuration {
  FormattedSQLQueryConfig() { this = "FormattedSQLQueryConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StrFormatCall
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SQLExecutionCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }
}

from FormattedSQLQueryConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected possible formatted SQL query. Use parameterized queries instead.",
  source, sink, "Formatted SQL query flows here"
