Rule Content:
/**
 * @name Formatted SQL Query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/formatted-sql-query
 */

import python
import semmle.python.dataflow.TaintTracking
import DataFlow::PathGraph

class FormatCall extends DataFlow::Node {
  FormatCall() {
    exists(MethodCallNode call |
      call.getMethod().getName() = "format" and
      call.getMethod().getDeclaringType().hasQualifiedName("builtins", "str") and
      call.getReceiver(_).getValue() instanceof StringLiteral and
      this.asExpr() = call
    )
  }
}

class SqlExecuteCall extends DataFlow::Node {
  SqlExecuteCall() {
    exists(MethodCallNode call |
      call.getMethod().getName() = "execute" and
      call.getMethod().getDeclaringType().getASupertype*().hasQualifiedName("", "DB") and
      this.asExpr() = call
    )
  }
}

class FormattedStringLiteral extends DataFlow::Node {
  FormattedStringLiteral() {
    exists(StringLiteral s |
      s.getValue().matches("%") or
      s.getValue().matches(".format(") or
      s.getValue().matches("f\"") or
      this.asExpr() = s
    )
  }
}

class ParameterizedQuerySanitizer extends DataFlow::Node {
  ParameterizedQuerySanitizer() {
    exists(MethodCallNode call |
      call.getMethod().getName() = "execute" and
      not call.getArgument(0).getValue() instanceof FormattedStringLiteral and
      this.asExpr() = call
    )
  }
}

class FormattedSqlTaintConfig extends TaintTracking::Configuration {
  FormattedSqlTaintConfig() { this = "FormattedSqlTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FormatCall or source instanceof FormattedStringLiteral
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteCall
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof ParameterizedQuerySanitizer
  }
}

from FormattedSqlTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, source, sink,
  "Detected possible formatted SQL query. Use parameterized queries instead."
