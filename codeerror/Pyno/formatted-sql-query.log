Rule Content:
/**
 * @name Formatted SQL Query Detection
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/formatted-sql-query
 */

import python
import semmle.python.dataflow.new.TaintTracking
import DataFlow::PathGraph

class StringFormatCall extends DataFlow::Node {
  StringFormatCall() {
    exists(CallNode call |
      call.getTarget().getName() = "format" and
      call.getTarget().getType().getUnderlyingType() instanceof StrType and
      call.getArg(0).asExpr() = _ and
      this.asExpr() = call
    )
  }
}

class SqlExecuteCall extends DataFlow::Node {
  SqlExecuteCall() {
    exists(CallNode call |
      call.getTarget().getName() = "execute" and
      call.getTarget().getType().toString().matches("%DB%") and
      this.asExpr() = call
    )
  }

  DataFlow::Node getQueryArg() { result = this.getArg(0) }
}

class SanitizedSqlQuery extends DataFlow::Node {
  SanitizedSqlQuery() {
    // Parameterized queries are considered sanitized
    exists(SqlExecuteCall sqlCall |
      not sqlCall.getQueryArg().asExpr().toString().matches("%... \\% ...%") and
      not sqlCall.getQueryArg().asExpr().toString().matches("%...%.format(...)") and
      not sqlCall.getQueryArg().asExpr().toString().matches("%f\"...%") and
      this.asExpr() = sqlCall.getQueryArg()
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "FormattedSqlQuery" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatCall
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(SqlExecuteCall sqlCall |
      sink.asExpr() = sqlCall.getQueryArg()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof SanitizedSqlQuery
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::ParameterNode param |
      pred.asExpr() = param.getAnArg() and
      succ.asExpr() = param.getAPredecessor()
    )
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected possible formatted SQL query. Use parameterized queries instead."
