/**
 * @name Formatted SQL Query
 * @description Detected possible formatted SQL query. Use parameterized queries instead.
 * @kind path-problem
 * @problem.severity warning
 * @id py/formatted-sql-query
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class StringFormatCall extends DataFlow::Node {
  StringFormatCall() {
    exists(MethodCallNode call |
      call.getMethod().getName() = "format" and
      call.getReceiver().getType().getName() = "str" and
      call.getArgument(0).asExpr().getStringValue() = "..."
    )
  }
}

class SqlExecuteCall extends DataFlow::Node {
  SqlExecuteCall() {
    exists(MethodCallNode call |
      call.getMethod().getName() = "execute" and
      call.getReceiver().getType().getName().matches("%DB%")
    )
  }
}

class SafeSqlQuery extends DataFlow::Node {
  SafeSqlQuery() {
    exists(MethodCallNode call |
      call.getMethod().getName() = "execute" and
      call.getReceiver().getType().getName().matches("%DB%") and
      not call.getArgument(0).asExpr().toString().matches("%%.+%%") and
      not call.getArgument(0).asExpr().toString().matches(".+\\..+format\\(") and
      not call.getArgument(0).asExpr().toString().matches("f\".+\\{.+\\}.+\"")
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "FormattedSqlQueryConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormatCall
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecuteCall and
    not sink instanceof SafeSqlQuery
  }
}

from Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected possible formatted SQL query. Use parameterized queries instead.",
  source, sink, "Unsafe SQL query construction"
