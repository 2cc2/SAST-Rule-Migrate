Rule Content:
/**
 * @name Formatted SQL Query Detection
 * @description Detects formatted SQL queries that should be parameterized
 * @kind taint
 * @problem.severity warning
 * @id python/formatted-sql-query
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts

class StringFormat extends DataFlow::Node {
  StringFormat() {
    exists(MethodCall call |
      call.getMethod().getName() = "format" and
      call.getQualifier().getType() = PYTHON::str_type() and
      call.getArgument(0).getStringValue().regexpMatch(".*%s.*|.*%d.*|.*\{.*\}.*") and
      this.asExpr() = call
    ) or
    exists(Literal l |
      l.getStringValue().regexpMatch(".*%s.*|.*%d.*|.*\{.*\}.*") and
      this.asExpr() = l
    )
  }
}

class SqlExecute extends DataFlow::Node {
  SqlExecute() {
    exists(MethodCall call |
      call.getMethod().getName() = "execute" and
      call.getQualifier().getType().getName() matches "db|conn|cursor" and
      (
        not exists(string pattern |
          pattern = "%s" or pattern = "%d" or pattern = "\{.*\}" |
          call.getArgument(0).getStringValue().regexpMatch(".*" + pattern + ".*")
        )
      ) and
      this.asExpr() = call
    )
  }
}

class FormattedSqlQueryConfig extends TaintTracking::Configuration {
  FormattedSqlQueryConfig() { this = "FormattedSqlQueryConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof StringFormat
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecute
  }
}

from FormattedSqlQueryConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Detected possible formatted SQL query. Use parameterized queries instead."
