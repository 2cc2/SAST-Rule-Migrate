Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 *              This could allow SSRF attacks where an attacker could expose sensitive data
 *              or probe internal servers. Use an allowlist of approved hosts.
 * @kind path-problem
 * @problem.severity warning
 * @id python/tainted-url-host
 */

import python
import semmle.python.security.strings.TaintTracking
import semmle.python.web.flask.Flask
import DataFlow::PathGraph

class FlaskRequestSource extends TaintSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName().matches("flask\.request\..*") and
      this = ma.getResult().asExpr()
    )
    or
    exists(Parameter p |
      p.getAnnot().getName() = "route" and
      this = p.getVariable().getAnAccess()
    )
  }

  override string getSourceType() { result = "User input from Flask request" }
}

class UrlConstructionSink extends TaintSink::Range {
  UrlConstructionSink() {
    exists(Call c |
      c.getTarget().toString().matches(".*://.*%[rs].*") or
      c.getTarget().toString().matches(".*://.*%s.*") or
      c.getTarget().toString().matches(".*://.*format\\(.*\\).*") or
      c.getTarget().toString().matches(".*://.*\\+.*") or
      c.getTarget().toString().matches("f\\\".*://\\{.*\\}.*\\\"") and
      this = c
    )
  }

  override string getSinkType() { result = "URL construction" }
}

query predicate edges(DataFlow::Edge e) { TaintTracking::localTaintStep(e.getSource(), e.getDest()) }

from FlaskRequestSource source, UrlConstructionSink sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where TaintTracking::localTaint(sourceNode, sinkNode) and
      sourceNode.asExpr() = source and sinkNode.asExpr() = sink
select sinkNode, "Potentially unsafe URL construction with tainted host from $@", sourceNode,
  sourceNode.getLocation(), "user input"
