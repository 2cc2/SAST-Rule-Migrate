Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL. This could allow an attacker to send data to their own server,
 * potentially exposing sensitive data such as cookies or authorization information sent with this request. They could also probe internal servers
 * or other resources that the server running this code can access. (This is called server-side request forgery, or SSRF.)
 * @kind path-problem
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-918
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.web.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCallNode m |
      m.getMethod().getQualifiedName().matches("flask\\.request\\..*") and
      DataFlow::methodCallNode(m, this)
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(FunctionNode f, ParameterNode p |
      f.hasAnnotation("route") and
      DataFlow::parameterNode(p, _, f.getFunction()) and
      DataFlow::parameterNode(p, this)
    )
  }
}

class UrlConstructionSink extends DataFlow::Node {
  UrlConstructionSink() {
    exists(MethodCallNode m |
      m.getCallableString().matches(".*://.*%[rs].*|.*://.*%s.*|.*://.*format\\(.*\\).*|.*://.*\\x2b.*|f\".*://\\{.*\\}.*\"") and
      DataFlow::methodCallNode(m, this)
    )
  }
}

class TaintedUrlHostConfiguration extends TaintTracking::Configuration {
  TaintedUrlHostConfiguration() { this = "TaintedUrlHost" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrlConstructionSink
  }
}

from TaintedUrlHostConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User data flows into the host portion of this manually-constructed URL ($@)",
  source.getNode(), "user input"
