Rule Content:
/**
 * @name Tainted URL Host
 * @kind path-problem
 * @problem.severity warning
 * @description Detects when user data flows into the host portion of a manually-constructed URL,
 *              which could lead to SSRF vulnerabilities.
 *              User data should not be allowed in URL hosts. Use an allowlist of approved hosts
 *              or hardcode the correct host instead.
 */

import python
import semmle.python.security.TaintTracking
import semmle.python.web.flask.Requests

class FlaskRequestSource extends TaintSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getQualifiedName().matches("flask\\.request\\..*") and
      ma = this
    )
  }
}

class RouteParamSource extends TaintSource::Range {
  RouteParamSource() {
    exists(FunctionDef fd, Parameter p |
      fd.getDecorator().getName() = "route" and
      p = fd.getAParameter() and
      p = this
    )
  }
}

class UrlConstructionSink extends TaintSink::Range {
  UrlConstructionSink() {
    exists(MethodAccess ma |
      (
        ma.getCode().matches(".*://.*%[rs].*") or
        ma.getCode().matches(".*://.*%s.*") or
        ma.getCode().matches(".*://.*format\\(.*\\).*") or
        ma.getCode().matches(".*://.*\\x2b.*") or
        ma.getCode().matches("f\\".*://\\{.*\\}.*\\"")
      ) and
      ma = this
    )
  }
}

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(TaintSource::Range source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(TaintSink::Range sink) {
    sink instanceof UrlConstructionSink
  }
}

from TaintedUrlHostConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User data flows into the host portion of this manually-constructed URL"
