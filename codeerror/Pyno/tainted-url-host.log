/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 * This could allow an attacker to send data to their own server, potentially exposing
 * sensitive data such as cookies or authorization information sent with this request.
 * They could also probe internal servers or other resources that the server running this
 * code can access. (This is called server-side request forgery, or SSRF.) Do not allow
 * arbitrary hosts. Instead, create an allowlist for approved hosts, or hardcode the correct host.
 * @kind taint
 * @problem.severity warning
 * @precision high
 * @id py/tainted-url-host
 */

import python
import semmle.python.dataflow.new.TaintTracking
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.WebFlask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getAPIName().matches("flask\\.request\\..*") and
      ma.getACall() = this.asExpr()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Parameter p | 
      exists(getAnAnnotation(p, "route", _)) and
      this.asParameter() = p
    )
  }
}

class UrlConstructionSink extends DataFlow::Node {
  UrlConstructionSink() {
    exists(MethodAccess ma |
      (ma.getCode().regexpMatch(".*://.*%[rs].*") or
       ma.getCode().regexpMatch(".*://.*%s.*") or
       ma.getCode().regexpMatch(".*://.*format\\(.*\\).*") or
       ma.getCode().regexpMatch(".*://.*\\x2b.*") or
       ma.getCode().regexpMatch("f\".*://\\{.*\\}.*\"")) and
      ma.getACall() = this.asExpr()
    )
  }
}

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrlConstructionSink
  }
}

