Rule Content:
/**
 * @name Tainted URL Host
 * @description User data flows into the host portion of this manually-constructed URL.
 *              This could allow an attacker to send data to their own server, potentially
 *              exposing sensitive data such as cookies or authorization information sent
 *              with this request. They could also probe internal servers or other resources
 *              that the server running this code can access. (This is called server-side
 *              request forgery, or SSRF.) Do not allow arbitrary hosts. Instead, create
 *              an allowlist for approved hosts, or hardcode the correct host.
 * @kind path-problem
 * @problem.severity warning
 * @id py/tainted-url-host
 */

import python
import semmle.python.dataflow.DataFlow
import semmle.python.dataflow.TaintTracking
import semmle.python.Web.Url
import semmle.python.frameworks.Flask

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(DataFlow::CallNode call |
      call.getTarget().hasQualifiedName("flask.request", _) and
      result = call
    )
  }
}

class RouteParamSource extends DataFlow::Source {
  RouteParamSource() {
    exists(DataFlow::ParameterNode param |
      param.getAnAnnotation().getName() = "route" and
      result = param
    )
  }
}

class UrlConstructionSink extends DataFlow::Sink {
  UrlConstructionSink() {
    exists(string pattern |
      (
        pattern =
          ".*://.*%[rs].*" or
          pattern = ".*://.*%s.*" or
          pattern = ".*://.*format\\(.*\\).*" or
          pattern = ".*://.*\\x2b.*" or
          pattern = "f\".*://\\{.*\\}.*\""
      ) and
      exists(DataFlow::CallNode call |
        call.getCode().regexpMatch(pattern) and
        result = call
      )
    )
  }
}

class TaintedUrlHostConfiguration extends TaintTracking::Configuration {
  TaintedUrlHostConfiguration() { this = "TaintedUrlHostConfiguration" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof UrlConstructionSink
  }
}

from TaintedUrlHostConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "User data flows into the host portion of this manually-constructed URL."
