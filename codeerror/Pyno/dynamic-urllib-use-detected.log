Rule Content:
/**
 * @id dynamic-urllib-use-detected
 * @name Dynamic urllib usage detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes,
 *              so a dynamic value controlled by a malicious actor may allow them to read arbitrary files.
 *              Audit uses of urllib calls to ensure user data cannot control the URLs, or consider using
 *              the 'requests' library instead.
 * @kind taint-problem
 * @security-severity 7.5
 */

import python
import semmle.python.dataflow.TaintTracking

class DynamicUrlSource extends DataFlow::Node {
  DynamicUrlSource() {
    exists(string strValue |
      this.asExpr().(StringLiteral).getText() != "" or
      this.asExpr() = any(Call call).
    )
  }
}

class UrlLibSink extends DataFlow::Node {
  UrlLibSink() {
    exists(MethodAccess ma |
      (
        ma.getTarget().hasQualifiedName("urllib", "urlopen") or
        ma.getTarget().hasQualifiedName("urllib", "urlretrieve") or
        (
          ma.getTarget().hasQualifiedName("urllib.URLopener", "open") or
          ma.getTarget().hasQualifiedName("urllib.URLopener", "retrieve")
        )
      ) and
      ma.getArgument(0) = this.asExpr()
    )
  }
}

class StaticUrlSanitizer extends DataFlow::Node {
  StaticUrlSanitizer() {
    this.asExpr() instanceof StringLiteral
  }
}

class UrlLibTaintConfig extends TaintTracking::Configuration {
  UrlLibTaintConfig() { this = "UrlLibTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof DynamicUrlSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof UrlLibSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticUrlSanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    TaintTracking::localTaintStep(node1, node2)
  }
}

from UrlLibTaintConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential remote code execution through dynamic URL in urllib call"
