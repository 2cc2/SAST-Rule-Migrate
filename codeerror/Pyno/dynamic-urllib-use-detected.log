Rule Content:
/**
 * @name Dynamic urllib use detected
 * @id dynamic-urllib-use-detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes,
 * so a dynamic value controlled by a malicious actor may allow them to read arbitrary files. 
 * Audit uses of urllib calls to ensure user data cannot control the URLs, or consider using the 
 * 'requests' library instead.
 * @kind path-problem
 * @problem.severity warning
 */

import python
import semmle.python.dataflow.TaintTracking

class DynamicUrlSource extends DataFlow::Node {
  DynamicUrlSource() {
    exists(string str | str = getText() | str != "")
  }
}

class UrllibSink extends DataFlow::Node {
  UrllibSink() {
    // urllib.urlopen(url)
    exists(CallNode call | 
      call.getFunc().(NameNode).getId() = "urlopen" and
      call.getFunc().getScope().getQualifiedName() = "urllib" and
      this.asExpr() = call.getArg(0)
    )
    or
    // urllib.urlretrieve(url)
    exists(CallNode call | 
      call.getFunc().(NameNode).getId() = "urlretrieve" and
      call.getFunc().getScope().getQualifiedName() = "urllib" and
      this.asExpr() = call.getArg(0)
    )
    or
    // urllib.URLopener.open(url)
    exists(CallNode call |
      call.getFunc().(MemberAccess).getMember() = "open" and
      call.getFunc().getQualifier().(NameNode).getId() = "URLopener" and
      call.getFunc().getQualifier().getScope().getQualifiedName() = "urllib" and
      this.asExpr() = call.getArg(0)
    )
    or
    // urllib.URLopener.retrieve(url)
    exists(CallNode call |
      call.getFunc().(MemberAccess).getMember() = "retrieve" and
      call.getFunc().getQualifier().(NameNode).getId() = "URLopener" and
      call.getFunc().getQualifier().getScope().getQualifiedName() = "urllib" and
      this.asExpr() = call.getArg(0)
    )
  }
}

class StaticUrlLiteral extends DataFlow::Node {
  StaticUrlLiteral() {
    this instanceof LiteralNode
  }
}

class DynamicUrllibConfig extends TaintTracking::Configuration {
  DynamicUrllibConfig() { this = "DynamicUrllibConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicUrlSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrllibSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticUrlLiteral
  }
}

