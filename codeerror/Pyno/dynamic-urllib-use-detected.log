Rule Content:
/**
 * @name Dynamic urllib use detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes,
 *              so a dynamic value controlled by a malicious actor may allow them to read arbitrary files.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 6.5
 * @id python/dynamic-urllib-use-detected
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class DynamicUrlSource extends DataFlow::Node {
  DynamicUrlSource() {
    exists(string value |
      this.asExpr().(StringLiteral).getText() = value
    )
    or
    exists(Call call | this.asExpr() = call)
  }
}

class UrllibSink extends DataFlow::Node {
  UrllibSink() {
    exists(Call call |
      this.asExpr() = call.getArg(0) and
      (
        call.getAttr("urlopen").getMemberScope() = "urllib" or
        call.getAttr("urlretrieve").getMemberScope() = "urllib" or
        exists(Attr attr |
          call.getAttr() = attr and
          attr.getMethodName() in ["open", "retrieve"] and
          attr.getObject().getType().hasName("URLopener")
        )
      )
    )
  }
}

predicate isStaticUrl(DataFlow::Node node) {
  node.asExpr().(StringLiteral).getText() != ""
}

override predicate isSanitizerNode(DataFlow::Node node) {
  isStaticUrl(node)
}

override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
  exists(Parameter param |
    node1.asParameter() = param and
    node2.asExpr() = param.getFunction().getAParameter()
  )
}

from DynamicUrlSource source, UrllibSink sink
where TaintTracking::localTaint(source, sink)
select sink, "Dynamic URL passed to urllib, which may allow arbitrary file reads.", 
  source, "Source of user-controlled URL"
