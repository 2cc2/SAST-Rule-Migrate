Rule Content:
/**
 * @name Dynamic urllib use detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes, 
 *              so a dynamic value controlled by a malicious actor may allow them to read arbitrary files.  
 *              Audit uses of urllib calls to ensure user data cannot control the URLs, 
 *              or consider using the 'requests' library instead.
 * @kind path-problem
 * @problem.severity warning
 * @id python/dynamic-urllib-use-detected
 */

import python
import semmle.python.security.TaintTracking
import DataFlow::PathGraph

class DynamicUrlSource extends DataFlow::Node {
  DynamicUrlSource() {
    exists(string value |
      this.asExpr() = value and
      value != ""
    )
  }
}

class UrllibSink extends DataFlow::Node {
  UrllibSink() {
    exists(Call call |
      (
        call.getFunc().(Name).getId() = "urlopen" and
        call.getScope().getFile().getPackageName() = "urllib" and
        this.asExpr() = call.getArg(0)
      ) or
      (
        call.getFunc().(Name).getId() = "urlretrieve" and
        call.getScope().getFile().getPackageName() = "urllib" and
        this.asExpr() = call.getArg(0)
      ) or
      exists(Class c |
        c.getFile().getPackageName() = "urllib" and
        c.getName() = "URLopener" and
        call.getFunc().(Member).getQualifier().getType().(RefType).getSourceDeclaration() = c and
        (
          call.getFunc().(Member).getName() = "open" or
          call.getFunc().(Member).getName() = "retrieve"
        ) and
        this.asExpr() = call.getArg(0)
      )
    )
  }
}

class StaticUrlSanitizer extends DataFlow::Node {
  StaticUrlSanitizer() { this.asExpr().isConstant() }
}

class DynamicUrlConfig extends TaintTracking::Configuration {
  DynamicUrlConfig() { this = "DynamicUrlConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof DynamicUrlSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof UrllibSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticUrlSanitizer
  }
}

from DynamicUrlConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential dangerous dynamic URL usage in urllib"
