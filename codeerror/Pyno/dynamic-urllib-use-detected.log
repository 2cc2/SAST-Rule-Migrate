Rule Content:
/**
 * @name Dynamic urllib use detected
 * @description Detected a dynamic value being used with urllib. urllib supports 'file://' schemes, 
 *              so a dynamic value controlled by a malicious actor may allow them to read arbitrary files. 
 *              Audit uses of urllib calls to ensure user data cannot control the URLs, 
 *              or consider using the 'requests' library instead.
 * @kind taint-problem
 * @problem.severity warning
 * @id python/dynamic-urllib-use-detected
 */

import python
import semmle.python.security.TaintTracking
import DataFlow

class DynamicUrl extends DataFlow::Node {
  DynamicUrl() {
    exists(string s | s = this.getStringLiteral() | s != "")
  }
}

class UrllibOpenSink extends DataFlow::Node {
  UrllibOpenSink() {
    exists(CallNode call | 
      (call.getTarget().hasQualifiedName("urllib", "urlopen") or
       call.getTarget().hasQualifiedName("urllib", "urlretrieve")) and
      call.getArgument(0) = this
    )
  }
}

class UrllibOpenerSink extends DataFlow::Node {
  UrllibOpenerSink() {
    exists(CallNode call |
      (call.getTarget().hasQualifiedName("urllib.URLopener", "open") or
       call.getTarget().hasQualifiedName("urllib.URLopener", "retrieve")) and
      call.getArgument(0) = this
    )
  }
}

class StaticUrlSanitizer extends DataFlow::Node {
  StaticUrlSanitizer() {
    this instanceof StringLiteral
  }
}

module TaintConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) { source instanceof DynamicUrl }
  
  predicate isSink(DataFlow::Node sink) {
    sink instanceof UrllibOpenSink or
    sink instanceof UrllibOpenerSink
  }
  
  predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof StaticUrlSanitizer
  }
  
  predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    true
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Dynamic value used with urllib call which may allow file read operations"
