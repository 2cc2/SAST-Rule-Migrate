Rule Content:
/**
 * @name NaN injection in type conversion
 * @description Found user input going directly into typecast for bool(), float(), or complex(). 
 *              This allows an attacker to inject Python's not-a-number (NaN) into the typecast.
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 * @precision high
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.TaintTracking

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodCallNode call |
      call.getTarget().toString() = "flask.request.get" and
      this.asExpr() = call
    )
  }
}

class RouteVarSource extends DataFlow::Node {
  RouteVarSource() {
    exists(FunctionDef f |
      f.getDecorator().toString().matches("%@app.route%") and
      this.asParameter() = f.getAParameter()
    )
  }
}

class TypeCastSink extends DataFlow::Node {
  TypeCastSink() {
    exists(FunctionCall fc |
      (
        fc.getTarget().toString() = "float" or
        fc.getTarget().toString() = "bool" or
        fc.getTarget().toString() = "complex"
      ) and
      this.asExpr() = fc
    )
  }
}

class NanoInjectionConfiguration extends TaintTracking::Configuration {
  NanoInjectionConfiguration() {
    this = "NaN injection in type conversion"
  }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteVarSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TypeCastSink
  }
}

from NanoInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast."
