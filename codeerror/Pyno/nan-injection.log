Rule Content:
/**
 * @name NaN Injection Vulnerability
 * @description Detects when user input flows directly into typecasts for bool(), float(), or complex(),
 *              which could allow injection of NaN values leading to undefined behavior.
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import semmle.python.web.Flask

class FlaskSource extends DataFlow::Node {
  FlaskSource() {
    exists(Method m | m.hasName("get") |
      this = API::getAMethodCall(m).getArgument(0) and
      m.getPackage().hasName("flask.request")
    ) or
    exists(Parameter p |
      this = p.getAnAccess() and
      exists(FunctionValue route |
        route.getADecorator().getABinding().hasName("route") and
        p.getFunction() = route.getADefinedFunction()
      )
    )
  }
}

class DangerousCastSink extends DataFlow::Node {
  DangerousCastSink() {
    exists(FunctionValue f |
      (f.hasName("float") or f.hasName("bool") or f.hasName("complex")) and
      this = API::getACall(f).getArgument(0)
    )
  }
}

class NanInjectionConfiguration extends TaintTracking::Configuration {
  NanInjectionConfiguration() { this = "NanInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof DangerousCastSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Sanitizer s | s.hasNeutralizingEffect() and sanitizer = s.getNode())
  }
}

from NanInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Found user input going directly into typecast for bool(), float(), or complex(). " +
             "This allows an attacker to inject Python's not-a-number (NaN) into the typecast. " +
             "Either cast to a different type, or add a guard checking for all capitalizations " +
             "of the string 'nan'.", source, sink
