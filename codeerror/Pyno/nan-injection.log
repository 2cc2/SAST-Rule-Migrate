Rule Content:
/**
 * @name NaN Injection Vulnerability
 * @description Detects user input going directly into typecast for bool(), float(), or complex() which allows NaN injection
 * @kind path-problem
 * @problem.severity error
 * @id py/nan-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.web.flask.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasQualifiedName("flask.request", "get") and
      ma = this.asExpr()
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, Parameter p |
      f.getDecorator("route").exists() and
      p = this.asParameter() and
      p.getFunction() = f
    )
  }
}

class DangerousTypecastSink extends DataFlow::Node {
  DangerousTypecastSink() {
    exists(Call c |
      (c.getFunc().(Name).getId() = "float" or   
       c.getFunc().(Name).getId() = "bool" or
       c.getFunc().(Name).getId() = "complex") and
      c = this.asExpr()
    )
  }
}

class NanInjectionConfiguration extends TaintTracking::Configuration {
  NanInjectionConfiguration() { this = "NanInjectionConfiguration" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof DangerousTypecastSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // General sanitizer - any function call neutralizes taint
    exists(Call c | c = sanitizer.asExpr())
  }
}

from NanInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  source, 
  "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast. " +
  "This results in undefined behavior, particularly when doing comparisons. " +
  "Either cast to a different type, or add a guard checking for all capitalizations " +
  "of the string 'nan'."
