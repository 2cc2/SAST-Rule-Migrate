import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.ApiGraphs
import DataFlow::PathGraph

class FlaskRequestMethod extends DataFlow::Node {
  FlaskRequestMethod() {
    exists(MemberCall m |
      m.getDispatchType().(NamedType).getName() = "request" and
      m.getMemberName() = "get" and
      m.getQualifier().getType() instanceof FlaskRequestType
    )
  }
}

class RouteParam extends DataFlow::Node {
  RouteParam() {
    exists(FunctionDef route |
      route.getDecorator().getName() = "route" and
      this.isParameterOf(route)
    )
  }
}

class TypeCast extends DataFlow::Node {
  TypeCast() {
    exists(Call c |
      c.getDispatchType().(NamedType).getName() = ["bool", "float", "complex"] and
      this.asExpr() = c
    )
  }
}

class NaNInjectionConfig extends TaintTracking::Configuration {
  NaNInjectionConfig() { this = "NaNInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestMethod or
    source instanceof RouteParam
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TypeCast
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    // General sanitizer for all sinks
    // Not directly translatable from Semgrep's GENERAL_SANITIZER
    // Would need more specific information to implement properly
    false
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    // ARG_TO_PARAM propagation
    exists(DataFlow::ParameterNode param, DataFlow::Node arg |
      node1 = arg and node2 = param and
      param = arg.getCall().getParameter(_)
    )
  }
}

from NaNInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "Found user input going directly into typecast for bool(), float(), or complex(). " +
  "This allows an attacker to inject Python's not-a-number (NaN) into the typecast, " +
  "resulting in undefined behavior.", source, sink,
  "Either cast to a different type, or add a guard checking for all capitalizations of the string 'nan'."
