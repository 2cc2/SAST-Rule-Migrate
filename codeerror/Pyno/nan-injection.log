Rule Content:
/** 
 * @name NaN Injection Vulnerability
 * @description Detects user input going directly into typecast for bool(), float(),
 * or complex() allowing injection of Python's not-a-number (NaN). This can lead
 * to undefined behavior, particularly during comparisons.
 * @kind path-problem
 * @problem.severity error
 * @id python/nan-injection
 */

import python
import semmle.python.ApiGraphs
import semmle.python.security.Strings
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking

class FlaskSource extends DataFlow::Node {
  FlaskSource() {
    exists(Call call |
      call.getTarget().(FunctionValue).getLocation().toString().matches("flask.request.get%") and
      this.asExpr() = call
    )
    or
    exists(Parameter p |
      p.getFunction().getAStmt().toString().matches("@%,route(%") and
      this.asParameter() = p
    )
  }
}

class TypecastSink extends DataFlow::Node {
  TypecastSink() {
    exists(Call call |
      (call.getTarget().(FunctionValue).getName() = "float" or
       call.getTarget().(FunctionValue).getName() = "bool" or
       call.getTarget().(FunctionValue).getName() = "complex") and
      this.asExpr() = call
    )
  }
}

class Sanitizer extends DataFlow::Node {
  Sanitizer() {
    exists(Call call | this.asExpr() = call)
  }
}

class NanInjectionConfig extends TaintTracking::Configuration {
  NanInjectionConfig() { this = "NanInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TypecastSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof Sanitizer
  }

  override predicate isSanitizerOverride(DataFlow::Node node) { none() }
}

from NanInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Found user input going directly into typecast for bool(), " +
"float(), or complex(). This allows NaN injection leading to undefined behavior."
