Rule Content:
/**
 * @name exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/exec-injection
 */

import python
import semmle.python.security.TaintTracking as TaintTracking

/** Sources of user input */
private class UserInputSource extends TaintTracking::Source {
  UserInputSource() {
    exists(string routeVar |
      // Route parameter
      this.asParameter().getName() = routeVar and
      routeVar.regexpMatch(".*ROUTEVAR.*")
    )
    or
  
    // Flask request calls
    exists(string flaskReqMethod |
      this.asExpr() = any(Call call |
        call.getFunc().(Name).getId() = "request" and
        call.getFunc().getQualifier().(Name).getId() = "flask"
      ).getAnArg() or
      this.asExpr() = any(Call call |
        call.getFunc().(Name).getId() = "get" and
        call.getFunc().getQualifier().(Name).getId().matches("flask.request.%")
      ).getAnArg()
    )
    or
  
    // Flask request indexing
    this.asExpr() = any(Subscription sub |
      sub.getBase().(Name).getId().matches("flask.request.%")
    )
  }
}

/** Sink - exec call */
private class ExecCallSink extends TaintTracking::Sink {
  ExecCallSink() {
    exists(Call call |
      call.getFunc().(Name).getId() = "exec" and
      call.getFunc().getQualifier() = any(Name name | name.getId() = "builtins")
      and this.asExpr() = call.getAnArg()
    )
  }
}

/** Taint tracking configuration */
class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "exec-injection" }

  override predicate isSource(TaintTracking::Source source) {
    source instanceof UserInputSource
  }

  override predicate isSink(TaintTracking::Sink sink) {
    sink instanceof ExecCallSink
  }

  override predicate isAdditionalTaintStep(TaintTracking::TaintStep step) {
    // Argument propagation through calls
    exists(DataFlow::CallNode from, DataFlow::CallNode to |
      step.getFromNode() = from.getAnArgument() and
      step.getToNode() = to.getParameter()
    )
    or
    // Assignment propagation
    exists(DataFlow::AssignNode assign |
      step.(TaintTracking::LocalTaintStep).getFromNode() = assign.getRhs() and
      step.(TaintTracking::LocalTaintStep).getToNode() = assign.getLhs()
    )
  }
}

from ExecInjectionConfig cfg, TaintTracking::PathNode source, TaintTracking::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected user data flowing into exec. This is code injection and should be avoided."
