/**
 * @name exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id py/exec-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(string routeVarName |
      this.asParameter().getName() = routeVarName and
      routeVarName.matches("%ROUTEVAR%")
    )
  }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(CallNode call |
      call = this.asExpr() and
      call.getTarget().(Value).getAPINode().getPackage() = "flask.request" and
      call.getTarget().(Value).getAPINode().getMethod().matches("%W%")
    )
  }
}

class FlaskRequestGetSource extends DataFlow::Node {
  FlaskRequestGetSource() {
    exists(CallNode call |
      call = this.asExpr() and
      call.getTarget().(Value).getAPINode().getPackage().matches("flask.request.%W%") and
      call.getTarget().(Value).getAPINode().getMethod() = "get"
    )
  }
}

class FlaskRequestIndexSource extends DataFlow::Node {
  FlaskRequestIndexSource() {
    exists(CallNode call |
      call = this.asExpr() and
      call.getTarget().(Value).getAPINode().getPackage().matches("flask.request.%W%") and
      call.getSignature() = "..."
    )
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(CallNode call |
      call = this.asExpr() and
      call.getTarget().(Value).getAPINode().getPackage() = "builtins" and
      call.getTarget().(Value).getAPINode().getMethod() = "exec"
    )
  }
}

class ExecInjectionConfiguration extends TaintTracking::Configuration {
  ExecInjectionConfiguration() { this = "ExecInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteParamSource or
    source instanceof FlaskRequestSource or
    source instanceof FlaskRequestGetSource or
    source instanceof FlaskRequestIndexSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    false
  }
}

from ExecInjectionConfiguration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected user data flowing into exec. This is code injection and should be avoided.",
  source, sink, "Potential exec injection vulnerability"
