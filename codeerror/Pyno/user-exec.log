Rule Content:
/**
 * @name Exec Injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/exec-injection
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.Concepts
import DataFlow::PathGraph

class RouteVarSource extends DataFlow::Node {
  RouteVarSource() {
    exists(Parameter p | p.getName() = "ROUTEVAR" and this.asParameter() = p)
  }
}

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call call |
      call.getTarget().(Member).getQualifier().(Member).getTarget().toString() = "flask.request" and
      this.asExpr() = call
    )
  }
}

class FlaskRequestGetSource extends DataFlow::Node {
  FlaskRequestGetSource() {
    exists(Call call |
      call.getTarget().(Member).getName() = "get" and
      call.getTarget().(Member).getQualifier().(Member).getQualifier().toString() = "flask.request" and
      this.asExpr() = call
    )
  }
}

class FlaskRequestIndexSource extends DataFlow::Node {
  FlaskRequestIndexSource() {
    exists(Call call |
      call.getTarget() instanceof Subscript and
      call.getTarget().getChild(0).(Member).getQualifier().toString() = "flask.request" and
      this.asExpr() = call
    )
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(Call call |
      call.getTarget().(Member).getName() = "exec" and
      call.getTarget().(Member).getQualifier().toString() = "builtins" and
      this.asExpr() = call
    )
  }
}

class ExecInjectionConfig extends TaintTracking::Configuration {
  ExecInjectionConfig() { this = "ExecInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof RouteVarSource or
    source instanceof FlaskRequestSource or
    source instanceof FlaskRequestGetSource or
    source instanceof FlaskRequestIndexSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecSink
  }

  override predicate isExtension(DataFlow::Node node1, DataFlow::Node node2) {
    // Propagation through arguments and variable aliases
    TaintTracking::localTaintStep(node1, node2) or
    exists(DataFlow::ParameterNode p, DataFlow::ArgumentNode a |
      a = node1.asParameter() and p = node2.asArgument() and
      a.getCall() = p.getCall()
    )
  }
}

from ExecInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink, "Detected user data flowing into exec. This is code injection and should be avoided."
