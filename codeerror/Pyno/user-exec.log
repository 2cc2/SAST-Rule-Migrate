/**
 * @name exec-injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id py/exec-injection
 */

import python
import semmle.python.security.TaintTracking 
import semmle.python.ApiGraphs.DataFlow
import DataFlow::PathGraph

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    // Match flask.request calls
    exists(MethodCall mc | 
      mc.getMethod().getDeclaringType().hasQualifiedName("flask", "request") and
      this.asExpr() = mc
    ) or
    // Match flask.request.*.get calls
    exists(MethodCall mc |
      mc.getMethod().getName() = "get" and
      mc.getMethod().getDeclaringType().getQualifiedName().matches("flask.request.%") and
      this.asExpr() = mc
    ) or
    // Match flask.request.* indexing
    exists(IndexingExpr ie |
      ie.getObject().getType().getQualifiedName().matches("flask.request.%") and
      this.asExpr() = ie
    ) or
    // Match route parameters
    exists(Parameter p | p.getName() = "$ROUTEVAR" and this.asParameter() = p)
  }
}

class ExecSink extends DataFlow::Node {
  ExecSink() {
    exists(MethodCall mc |
      mc.getMethod().getName() = "exec" and
      mc.getMethod().getDeclaringType().hasQualifiedName("builtins") and
      this.asExpr() = mc
    )
  }
}

class ExecInjectionConfiguration extends TaintTracking::Configuration {
  ExecInjectionConfiguration() { this = "ExecInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExecSink
  }
}

from ExecInjectionConfiguration config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, source, sink, "Detected user data flowing into exec. This is code injection and should be avoided."
