Rule Content:
/**
 * @name Exec Injection
 * @description Detected user data flowing into exec. This is code injection and should be avoided.
 * @kind path-problem
 * @problem.severity error
 * @id python/exec-injection
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.Security.TaintTracking
import semmle.python.web.Flask

class ExecInjection extends TaintTracking::Configuration {
  ExecInjection() { this = "Exec Injection" }

  override predicate isSource(DataFlow::Node source) {
    // Route variables source
    exists(ParameterNode pn |
      pn.getName() = "_ROUTEVAR_" and
      source.asParameter() = pn
    )
    or
    // Flask request source
    Flask::requestCall(source.getNode()) or Flask::requestGetter(source.getNode()) 
    or Flask::requestIndexer(source.getNode())
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(CallNode cn |
      cn.getTarget().getName() = "exec" and
      cn.getTarget().getDeclaringScope().getName() = "builtins" and
      sink.asExpr() = cn.getAnArgument()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    none()
  }
}

from ExecInjection cfg, DataFlow::Node expr
where cfg.hasFlowTo(expr)
select expr, "Detected user data flowing into exec. This is code injection and should be avoided."
