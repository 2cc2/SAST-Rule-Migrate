Rule Content:
/**
 * @name pg8000-sqli
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement. 
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id py/pg8000-sqli
 */

import python
import semmle.python.dataflow.TaintTracking
import semmle.python.ApiGraphs

class Pg8000Config extends TaintTracking::Configuration {
  Pg8000Config() { this = "Pg800 SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    exists(DataFlow::CallNode call |
      // User input source
      source.asExpr() = call.getAnInput() and
      call.getTarget().hasQualifiedName(["pg8000", "Connection"], "*") or
      call.getTarget().hasQualifiedName(["pg8000", "Cursor"], "*")
    )
    or
    source.asExpr().isLiteral() or source.asExpr().isIdentifier()
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCallNode call |
      call.getTarget().hasQualifiedName(["pg8000", "Connection", "run"]) or
      call.getTarget().hasQualifiedName(["pg8000", "Cursor", "execute"]) or
      call.getTarget().hasQualifiedName(["pg8000", "Cursor", "executemany"]) or
      call.getTarget().hasQualifiedName(["pg8000", "Cursor", "prepare"]) and
      sink = call.getArgument(0) and
      not call.getArgument(0).isConstant()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodCallNode call |
      call.getTarget().hasQualifiedName(["pg8000", "Connection", "run"]) or
      call.getTarget().hasQualifiedName(["pg8000", "Cursor", "execute"]) or
      call.getTarget().hasQualifiedName(["pg8000", "Cursor", "executemany"]) or
      call.getTarget().hasQualifiedName(["pg8000", "Cursor", "prepare"]) and
      sanitizer = call.getArgument(0) and
      call.getArgument(0).isParameterized()
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(DataFlow::CallEdge edge |
      edge.getSource() = node1 and edge.getDest() = node2 and
      edge.getKind() = "arg->param"
    )
  }
}

from Pg8000Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection due to unparameterized query in pg8000 with user input", source,
  "User input $@ flows here without proper sanitization.", source.getNode(), "source"
