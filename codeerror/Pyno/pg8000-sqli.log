Rule Content:
/**
 * @name pg8000 SQL Injection
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 * @id pg8000-sqli
 * @kind path-problem
 * @problem.severity warning
 */

import python
import semmle.python.security.security_injection.SqlInjection
import semmle.python.security.dataflow.TaintTracking
import semmle.python.ApiGraphs

class Pg8000Connection extends ExternalApi::Callable {
  Pg8000Connection() { this.getQualifiedName().matches("%pg8000%.Connection") }
}

class Pg8000Cursor extends ExternalApi::Callable {
  Pg8000Cursor() { this.getQualifiedName().matches("%pg8000%.Cursor") }
}

class Pg8000SqlExecution extends TaintSink::Range {
  Pg8000SqlExecution() {
    exists(string cmdName | cmdName = ["run", "execute", "executemany", "prepare"] |
      this.asCallNode().getTarget().getName() = cmdName and
      (this.asCallNode().getTarget().getEnclosingCallable() instanceof Pg8000Connection or
       this.asCallNode().getTarget().getEnclosingCallable() instanceof Pg8000Cursor) and
      not this.asCallNode().getArg(0).isConstant())
  }

  override string getAlertType() { return "SQL injection" }
}

class Pg8000Sanitizer extends TaintSanitizer {
  Pg8000Sanitizer() {
    exists(string cmdName | cmdName = ["run", "execute", "executemany", "prepare"] |
      this.asCallNode().getTarget().getName() = cmdName and
      (this.asCallNode().getTarget().getEnclosingCallable() instanceof Pg8000Connection or
       this.asCallNode().getTarget().getEnclosingCallable() instanceof Pg8000Cursor) and
      this.asCallNode().getArg(0).isParameterized())
  }
}

class Pg8000Config extends TaintTracking::Configuration {
  Pg8000Config() { this = "Pg8000 SQL Injection Configuration" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() = ANY or source.asExpr().(Literal).getStringValue() != ""
  }

  override predicate isSink(DataFlow::Node sink) { sink instanceof Pg8000SqlExecution }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof Pg8000Sanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    succ instanceof StringOperationCall and pred = succ.(StringOperationCall).getAnOperand()
  }
}

from Pg8000Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement. " +
  "This could lead to SQL injection if the variable is user-controlled and not properly sanitized.",
  source, sink, "Potential SQL injection vulnerability"
