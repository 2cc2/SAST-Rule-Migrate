Rule Content:
/**
 * @name pg8000 SQL Injection
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 *              This could lead to SQL injection if the variable is user-controlled and not properly sanitized.
 * @kind taint
 * @problem.severity warning
 * @id py/pg8000-sqli
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.SqlInjection
import DataFlow::PathGraph

class Pg8000Sink extends SqlInjection::Sink {
  Pg8000Sink() {
    exists(MethodCall call |
      call.getMethod().getAPackage() = "pg8000" and
      call.getMethod().getDeclaringType().getName() in ["Connection", "Cursor"] and
      call.getMethod().getName() in ["run", "execute", "executemany", "prepare"] and
      call.getArgument(0).isConstant() = false and
      this = call.getArgument(0)
    )
  }
}

class Pg8000Sanitizer extends Sanitizer {
  Pg8000Sanitizer() {
    exists(MethodCall call |
      call.getMethod().getAPackage() = "pg8000" and
      call.getMethod().getDeclaringType().getName() in ["Connection", "Cursor"] and
      call.getMethod().getName() in ["run", "execute", "executemany", "prepare"] and
      call.getArgument(0).isParameterized() and
      this = call.getArgument(0)
    )
  }
}

class Pg8000Config extends TaintTracking::Configuration {
  Pg8000Config() { this = "Pg8000 SQL Injection" }

  override predicate isSource(DataFlow::Node source) { source.isUserControlled() }

  override predicate isSink(DataFlow::Node sink) { sink instanceof Pg8000Sink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof Pg8000Sanitizer
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(DataFlow::OperatorNode concat |
      concat.getOp() = "+" and
      pred.asExpr() = concat.getLeftOperand() and
      succ.asExpr() = concat.getRightOperand()
    ) 
  }
}

from Pg8000Config cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection from string concatenation with non-literal in pg8000 query", source,
  "User input reaches this SQL query construction without proper sanitization"
