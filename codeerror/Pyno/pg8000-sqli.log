Rule Content:
/**
 * @name pg8000 SQL Injection
 * @description Detected string concatenation with a non-literal variable in a pg8000 Python SQL statement.
 * @id python/pg8000-sqli
 * @kind path-problem
 * @security-severity 7.5
 * @problem.severity warning
 */

import python
import semmle.python.security.dataflow.SQLInjection
import DataFlow::PathGraph

class PG8000Config extends TaintTracking::Configuration {
  PG8000Config() { this = "PG8000 SQL Injection" }

  override predicate isSource(DataFlow::Node source) {
    exists(DataFlow::CallNode call |
      call = source.asExpr().getAnAccess() and
      call.getEnclosingCallable().getFile().getBaseName() = "pg8000" and
      TaintedInput::isUserControlled(source.asExpr())
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodCall mc |
      mc.getReceiver().getType().hasQualifiedName("pg8000", ["Connection", "Cursor"]) and
      mc.getMethod().getName() in ["run", "execute", "executemany", "prepare"] and
      mc.getArgument(0) = sink.asExpr() and
      not sink.asExpr().(StringLiteral).getText().isConstant()
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodCall mc |
      mc.getReceiver().getType().hasQualifiedName("pg8000", ["Connection", "Cursor"]) and
      mc.getMethod().getName() in ["run", "execute", "executemany", "prepare"] and
      mc.getArgument(0) = sanitizer.asExpr() and
      exists(ParameterizedQuery::isParameterized(sanitizer.asExpr()))
    )
  }

  override predicate isAdditionalTaintStep(DataFlow::Node node1, DataFlow::Node node2) {
    exists(Expr concat |
      concat = node1.asExpr() and
      node2.asExpr().isOperandOf(concat)
    )
  }
}

from PG8000Config config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "String concatenation with non-literal variable in pg8000 SQL statement. This could lead to SQL injection."
