Rule Content:
/**
 * @name SSRF via Flask requests
 * @description Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF).
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 */

import python
import semmle.python.security.SSRF
import semmle.python.web.flask.Flask
import semmle.python.web.requests

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(FunctionCall fc |
      fc.getTarget().(FunctionValue).getAPackage() = "flask" and
      fc.getTarget().(FunctionValue).getAClass() = "Request" and
      fc.getTarget().getName() in ["get", "values", "args", "form"]
    )
  }
}

class RouteParamSource extends DataFlow::Node {
  RouteParamSource() {
    exists(Function f, string annotationValue |
      annotationValue.regexpMatch("@.*\\.(get|post|put|delete|patch|route)\\(.*\\)") and
      f.getAnAnnotation().getValue() = annotationValue and
      this = f.getAParameter()
    )
  }
}

class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(FunctionCall fc |
      fc.getTarget().(FunctionValue).getAPackage() = "requests" and
      this = fc.getAnArgument()
    )
  }
}

query config edges(
  DataFlow::Node source, DataFlow::Node sink
) {
  source = any(FlaskRequestSource frs | frs) or
  source = any(RouteParamSource rps | rps)
  and
  sink = any(RequestsSink rs | rs)
  and
  DataFlow::localFlow(source, sink)
}

from DataFlow::Node source, DataFlow::Node sink
where config edges(source, sink)
select sink, source,
  "Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF)."
