Rule Content:
/**
 * @name SSRF via Flask request to requests call
 * @description Data from request object is passed to a new server-side request. This could lead 
 *              to a server-side request forgery (SSRF).
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 */

import python
import semmle.python.security.ExternalAPIs
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.new.RemoteFlowSources
import semmle.python.dataflow.new.TaintTracking
import semmle.python.dataflow.new.DataFlow
import semmle.python.Str

/** Flask request source. */
class FlaskRequestSource extends RemoteFlowSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma, Name name |
      ma.getMethod().getName() = name and
      name.getId() in ["get", "attribute"] and
      ma.getQualifier().getType().getName() = "Request" and
      ma.getQualifier().getType().getASourceFile().getRelativePath().matches("%flask%")
    ) and
    this.asExpr() = any(MethodAccess ma |
      ma.getMethod().getName() in ["get", "attribute"] and
      ma.getQualifier().getType().getName() = "Request" and
      ma.getQualifier().getType().getASourceFile().getRelativePath().matches("%flask%")
    )
  }
}

/** Route parameter source. */
class RouteParamSource extends RemoteFlowSource::Range {
  RouteParamSource() {
    exists(Function fn, Decorator dec |
      dec.getTarget() = fn and
      exists(Name name | name.getAPropertyRead() = dec.getValue()) and
      fn.getAParameter() = this.asParameter()
    )
  }
}

/** Requests library sink. */
class RequestsSink extends DataFlow::Node {
  RequestsSink() {
    exists(MethodAccess ma |
      ma.getQualifier().getType().getASourceFile().getRelativePath().matches("%requests%") and
      this.asExpr() = ma
    )
  }
}

/** Data flow configuration for SSRF detection. */
module SSRFConfig implements DataFlow::ConfigSig {
  predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParamSource
  }

  predicate isSink(DataFlow::Node sink) {
    sink instanceof RequestsSink
  }
}

/** SSRF query. */
from SSRFConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where DataFlow::flowPath(cfg, source, sink)
select sink, source, sink, 
  "Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF)."
================================================================================
