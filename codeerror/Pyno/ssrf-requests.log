Rule Content:
/**
 * @name SSRF in requests calls
 * @description Data from request object is passed to a new server-side request.
 *              This could lead to a server-side request forgery (SSRF).
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 */

import python
import semmle.python.security.SSRF
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.web.Flask

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getMethodName() = ["get", "args", "form", "values", "json", "data"] and
      call.getReceiver().getType().getASupertype*().hasQualifiedName("flask", "Request")
    )
    or
    exists(MethodParameter p |
      p.getAParentScope() instanceof Function and
      p.getAParentScope().getAStmt() = any(FunctionDef fd |
        fd.getADecorator().getAExpr().(Call).getCallee().getName() = ["route", "get", "post", "put", "delete", "patch"]
      )
    )
  }
}

class RequestsSink extends DataFlow::Sink {
  RequestsSink() {
    exists(Call call |
      call.getCallee().(Value).getType().hasQualifiedName("requests", "get", "post", "put", "delete", "head", "options", "patch") or
      call.getCallee().(Value).getType().hasQualifiedName("requests.api", "request")
    )
  }
}

query predicate isSSRF(DataFlow::PathNode source, DataFlow::PathNode sink) {
  exists(SSRF::Configuration config |
    config.hasFlowPath(source, sink)
  )
}

from DataFlow::PathNode source, DataFlow::PathNode sink
where
  isSSRF(source, sink) and
  source instanceof FlaskRequestSource and
  sink instanceof RequestsSink
select sink.getNode(), source, sink, "Data from request object is passed to a new server-side request. " +
  "This could lead to a server-side request forgery (SSRF)."
