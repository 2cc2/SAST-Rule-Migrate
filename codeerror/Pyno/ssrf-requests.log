Rule Content:
/**
 * @name SSRF via Flask request to requests package
 * @description Detects when data from Flask request objects is passed to the requests package,
 *              potentially leading to Server-Side Request Forgery (SSRF).
 * @kind path-problem
 * @problem.severity error
 * @id py/ssrf-requests
 */

import python
import semmle.python.dataflow.new.DataFlow
import semmle.python.dataflow.new.RemoteFlowSources
import semmle.python.Concepts
import semmle.python.web.Flask
import semmle.python.web.Http

class FlaskRequestSource extends DataFlow::Source {
  FlaskRequestSource() {
    exists(API::MethodAccess ma |
      ma.getMethod().getAPackage().getName() = "flask" and
      ma.getMethod().getAComponentType().getName() = "Request" and
      ma.getMethodName().matches("%get%") and
      (
        ma.getName() = "get" or
        ma.getName().toLowerCase().matches("%get%") or
        ma.getName().matches("%[]%") or
        ma.getName().matches("%()%") or
        ma.getName().matches("%attribute%")
      ) and
      this.asExpr() = ma
    )
  }
}

class RouteParamSource extends DataFlow::Source {
  RouteParamSource() {
    exists(Parameter p |
      p.getAnAnnotation().getType().getName() = "route" and
      this.asParameter() = p
    )
  }
}

class RequestsSink extends DataFlow::Sink {
  RequestsSink() {
    exists(API::ModuleImport mi |
      mi.getName() = "requests" and
      this.asExpr() = mi.getACall()
    )
  }
}

class FlaskToRequestsConfiguration extends DataFlow::Configuration {
  FlaskToRequestsConfiguration() { this = "Flask to requests dataflow" }

  override predicate isSource(DataFlow::Source source) {
    source instanceof FlaskRequestSource or source instanceof RouteParamSource
  }

  override predicate isSink(DataFlow::Sink sink) {
    sink instanceof RequestsSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, FlaskToRequestsConfiguration conf
where conf.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Data from request object is passed to a new server-side request. $@.",
  source.getNode(),
  "This could lead to a server-side request forgery (SSRF)."
