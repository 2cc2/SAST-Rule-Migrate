Rule Content:
/**
 * @name SSRF via Flask requests
 * @description Data from request object is passed to a new server-side request.
 * @kind path-problem
 * @problem.severity error
 * @id python/ssrf-requests
 */

import python
import semmle.python.security.Ssrf
import semmle.python.web.FlaskRouting
import semmle.python.web.HttpRequest
import DataFlow::PathGraph

class FlaskRequestSource extends RemoteFlowSource::Range {
  FlaskRequestSource() {
    exists(MethodCall call |
      call.getMethod().(NamedMethod).getName() = ["get", "args", "form", "values", "json"].getAValue() and
      call.getQualifier().getType().getASupertype*() instanceof FlaskRequest
    )
    or
    exists(MethodParameter p |
      exists(Decorator d |
        d.hasName("route") and
        d.getCall().getExpr().toString() matches "%_method(%_" and
        d.getCall().getArgument(0).getStringValue() != "" and
        p = d.getParent() and
        p.getFunction().getAParameter() = this
      )
    )
  }
}

class RequestsSink extends RemoteFlowSink::Range {
  RequestsSink() {
    exists(MethodCall call |
      call.getMethod().(NamedMethod).getDeclaringType().getASupertype*() =
        Type::named("requests.api") and
      this = call.getAnArgument()
    )
  }
}

from FlaskRequestSource source, RequestsSink sink, DataFlow::PathNode sourceNode, DataFlow::PathNode sinkNode
where DataFlow::localFlowPath(sourceNode, sinkNode)
select sinkNode, "Data from request object is passed to a new server-side request. This could lead to a server-side request forgery (SSRF).",
  sourceNode, sinkNode, "Potentially tainted data flows here"
