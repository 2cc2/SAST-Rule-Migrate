/**
 * @name subprocess-injection
 * @description Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability.
 * @kind path-problem
 * @problem.severity error
 * @id python/subprocess-injection
 */

import python
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.dataflow.TaintTracking
import semmle.python.dataflow.new.DataFlow
import semmle.python.web.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(Call call |
      call.getTarget().hasQualifiedName("flask.request", "get") or
      call.getTarget().hasQualifiedName("flask.request", "__getitem__") or
      call.getTarget().hasQualifiedName("flask.request", "values") or
      call.getTarget().hasQualifiedName("flask.request", "stream") or
      call.getTarget().hasQualifiedName("flask.request", "headers") or
      call.getTarget().hasQualifiedName("flask.request", "data") or
      call.getTarget().hasQualifiedName("flask.request", "full_path") or
      call.getTarget().hasQualifiedName("flask.request", "url") or
      call.getTarget().hasQualifiedName("flask.request", "json") or
      call.getTarget().hasQualifiedName("flask.request", "get_json") or
      call.getTarget().hasQualifiedName("flask.request", "view_args") and
      this.asExpr() = call
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Method method, string routeDecorator |
      method.getADecorator().getValue().(Call).getTarget().toString().matches("%@.*\.route\(.*\)") and
      this.asParameter() = method.getAParameter()
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(Call call |
      call.getTarget().getPackage().getName() = "subprocess" and
      not call.getArgument(0).getStringValue().regexpMatch("^\"[^\"]+\"$") and
      not exists(ArrayCreation creation |
        creation = call.getArgument(0) and
        this.asExpr() = call
      ) and
      this.asExpr() = call
    ) or
    exists(Call call |
      call.getTarget().getPackage().getName() = "subprocess" and
      call.getArgument(0).getAnAccess().getArrayElement().getStringValue().regexpMatch("^(sh|bash|ksh|csh|tcsh|zsh)$") and
      call.getArgument(0).getAnAccess().getArrayElement(1).getStringValue() = "-c" and
      this.asExpr() = call
    ) or
    exists(Call call |
      call.getTarget().getPackage().getName() = "subprocess" and
      call.getArgument(0).getAnAccess().getArrayElement().getStringValue().regexpMatch("^(python|python\\d)$") and
      this.asExpr() = call
    )
  }
}

class DictKeySanitizer extends BarrieredNode {
  DictKeySanitizer() {
    exists(ArrayIndex index |
      index.getParent() instanceof DictAccess and
      this.asExpr() = index
    )
  }
}

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }

  override predicate isBarrier(DataFlow::Node barrier) {
    barrier instanceof DictKeySanitizer
  }
}

from SubprocessInjectionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability.", 
  source, source.getNode().getFunction().getName() + " to " + sink.getNode().getFunction().getName()
