Rule Content:
/**
 * @name subprocess-injection
 * @description Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability.
 * @kind path-problem
 * @problem.severity error
 * @id py/subprocess-injection
 */

import python
import semmle.python.security.CommandInjection
import semmle.python.dataflow.new.RemoteFlowSources
import semmle.python.web.Flask  
import DataFlow::PathGraph

class FlaskRequestSource extends RemoteFlowSource::Range {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("flask", "Request") and
      ma.getMethod().getName().matches("get|__getitem__|values|stream|headers|data|full_path|url|json|get_json|view_args") and
      ma.getMethod().getQualifiedName().matches("^flask\.request\.(form|args|values|cookies|stream|headers|data|full_path|url|json|get_json|view_args)")
    )
  }
}

class FlaskRouteParameterSource extends RemoteFlowSource::Range {
  FlaskRouteParameterSource() {
    exists(Function f, string route |
      f.getADecorator().getValue().toString().matches("@.*\\.route\\(.*\\)") and
      this = f.getAParameter()
    )
  }
}

class SubprocessSink extends Range {
  SubprocessSink() {
    exists(Call call |
      call.getTarget().getDeclaringType().hasQualifiedName("subprocess", "") and
      (
        // Direct calls with string arguments
        not call.getArgument(0).getValue().matches("^\"[^\"]+\"$") or
        // Shell execution variants
        (
          exists(ListExpr list |
            call.getArgument(0) = list and
            list.getItem(0).getValue().matches("^(sh|bash|ksh|csh|tcsh|zsh)$") and
            list.getItem(1).getValue() = "-c"
          )
        ) or
        // Python interpreter calls
        (
          exists(ListExpr list |
            call.getArgument(0) = list and
            list.getItem(0).getValue().matches("^(python|python\\d)$")
          )
        )
      )
    )
  }
}

class SafeCommandConstruction extends DataFlow::BarrierNode {
  SafeCommandConstruction() {
    exists(DictIndexAccess dia |
      dia.getIndex() instanceof Expr
    )
  }
}

from
  RemoteFlowSource source, DataFlow::PathNode sink, DataFlow::PathNode sanitizer
where
  // Define source types
  (source instanceof FlaskRequestSource or source instanceof FlaskRouteParameterSource) and
  // Define sink types
  sink.getNode() instanceof SubprocessSink and
  // Define sanitizers
  sanitizer.getNode() instanceof SafeCommandConstruction and
  // Check data flow
  DataFlow::flowPath(source, sink, sanitizer)
select sink.getNode(), source, sink,
  "Detected user input ($@) entering a `subprocess` call ($@) unsafely. This could result in a command injection vulnerability.",
  source.getNode(), "User input", sink.getNode(), "subprocess call"
