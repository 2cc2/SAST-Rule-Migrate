/**
 * @name subprocess-injection
 * @description Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability.
 * @kind taint
 * @id py/command-injection
 * @problem.severity error
 * @security-severity 8.5
 */

import python
import semmle.python.security.dataflow.TaintTracking
import semmle.python.ApiGraphs
import semmle.python.Concepts
import semmle.python.WebFrameworks

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().getAPackage().getName() = "flask.request" and
      ma.getMethod().getName().matches("get|__getitem__|values|stream|headers|data|full_path|url|json|get_json|view_args") and
      ma.getMethod().getQualifiedName().matches("^flask\\.request\\.(form|args|values|cookies|stream|headers|data|full_path|url|json|get_json|view_args)") and
      this.asExpr() = ma
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Function f, string decoratorName |
      f.getADecorator().getAPattern().toString() = decoratorName and
      decoratorName.matches("@.*\\.route\\(.*\\)") and
      this.asParameter() = f.getAParameter()
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(Call call |
      call.getCalleeName().matches(".*") and
      call.getAPackage().getName() = "subprocess" and
      exists(DataFlow::Node arg |
        arg.asExpr() = call.getArg(0) and
        (
          not arg.getStringValue().matches("^\"[^\"]+\"$") or
          exists(ArrayExpr array |
            arg.asExpr() = array and
            (
              array.getAnElement().getStringValue().matches("^(sh|bash|ksh|csh|tcsh|zsh)$") or
              array.getAnElement().getStringValue() = "-c" or
              array.getAnElement().getStringValue().matches("^(python|python\\d)$")
            )
          )
        )
      ) and
      this.asExpr() = call
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "subprocess-injection" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node.getNodeType() = "ARRAY_INDEX" and
    exists(node.getAChild())
  }
}
