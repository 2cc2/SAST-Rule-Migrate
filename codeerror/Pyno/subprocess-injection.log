Rule Content:
/**
 * @name Subprocess Injection
 * @description Detected user input entering a `subprocess` call unsafely.
 * @kind problem
 * @id python/subprocess-injection
 * @severity error
 */

import python
import semmle.python.Concepts
import semmle.python.ApiGraphs
import semmle.python.dataflow.TaintTracking
import semmle.python.web.Flask

class FlaskRequestSource extends DataFlow::Node {
  FlaskRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().(FunctionValue).getLocation().toString().matches("flask.request.%") and
      ma.getMethod().toString().matches("get|__getitem__|values|stream|headers|data|full_path|url|json|get_json|view_args") and
      ma.getQualifier().toString().matches("flask\.request\.(form|args|values|cookies|stream|headers|data|full_path|url|json|get_json|view_args)") and
      this.asExpr() = ma
    )
  }
}

class RouteParameterSource extends DataFlow::Node {
  RouteParameterSource() {
    exists(Function f, string routeDecorator |
      f.getADecorator().toString().matches("@.*\\.route\\(.*\\)") and
      this.asParameter() = f.getAParameter()
    )
  }
}

class SubprocessSink extends DataFlow::Node {
  SubprocessSink() {
    exists(Call call |
      call.getCalleeName().matches("subprocess.*") and
      (
        not call.getArg(0).getValue().toString().matches("^\"[^\"]+\"$") and
        not exists(ArrayExpr cmd |
          cmd = call.getArg(0) and
          cmd.getElements().get(0).getValue().toString().matches("\\.\\.\\.")
        )
      ) or
      (
        exists(ArrayExpr args |
          args = call.getArg(0) and
          args.getElements().get(0).getValue().toString().matches("^(sh|bash|ksh|csh|tcsh|zsh)$") and
          args.getElements().get(1).getValue().toString().matches("-c")
        )
      ) or
      (
        exists(ArrayExpr args |
          args = call.getArg(0) and
          args.getElements().get(0).getValue().toString().matches("^(python|python\\d)$")
        )
      ) and
      this.asExpr() = call
    )
  }
}

predicate isSanitizer(DataFlow::Node node) {
  exists(ArrayIndex ai |
    ai = node.asExpr() and
    ai.getIndex() != none
  )
}

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof FlaskRequestSource or
    source instanceof RouteParameterSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SubprocessSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    isSanitizer(node)
  }
}

from SubprocessInjectionConfig config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability."
