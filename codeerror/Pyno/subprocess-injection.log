Rule Content:
/**
 * @id subprocess-injection
 * @name subprocess-injection
 * @description Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability.
 * @kind path-problem
 * @problem.severity error
 */

import python
import semmle.python.security.CommandInjection
import semmle.python.web.flask.Request

predicate isFlaskSource(DataFlow::Node source) {
  exists(MethodAccess ma |
    ma.getMethod().getName().matches("get|__getitem__|values|stream|headers|data|full_path|url|json|get_json|view_args") and
    ma.getMethod().getDeclaringType().hasQualifiedName("flask.request", "") and
    source.asExpr() = ma
  ) or
  exists(Parameter p | source.asParameter() = p and
    exists(Function f | p.getFunction() = f and
      exists(Docstring d | f.getDocstring() = d and d.getText().regexpMatch("@.*\.route\(.*\)\s+def.*"))
    )
  )
}

predicate isSubprocessSink(DataFlow::Node sink) {
  exists(Call call |
    call.getFunc().(Name).getId().matches("subprocess.*") and
    (
      // Unsafe subprocess call with string argument
      not call.getArg(0).getValue().toString().regexpMatch("^\"[^\"]+\"$") or
      // Shell exec pattern
      exists(Array arr | call.getArg(0) = arr |
        arr.getAnElement().getValue().toString().matches("sh|bash|ksh|csh|tcsh|zsh") and
        arr.getAnElement().getValue().toString() = "-c"
      ) or
      // Python interpreter exec
      exists(Array arr | call.getArg(0) = arr |
        arr.getAnElement().getValue().toString().regexpMatch("python|python\\d")
      )
    ) and
    sink.asExpr() = call
  )
}

class SubprocessInjectionConfig extends TaintTracking::Configuration {
  SubprocessInjectionConfig() { this = "SubprocessInjection" }

  override predicate isSource(DataFlow::Node source) {
    isFlaskSource(source)
  }

  override predicate isSink(DataFlow::Node sink) {
    isSubprocessSink(sink)
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(ArrayIndex ai | sanitizer.asExpr() = ai | ai.getIndex() != none())
  }
}

from SubprocessInjectionConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability."
