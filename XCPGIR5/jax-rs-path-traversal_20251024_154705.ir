```yaml
xcpgir_version: "1.0"
rule:
  id: jax-rs-path-traversal
  kind: taint
  severity: WARNING
  message: "Detected a potential path traversal. A malicious actor could control the location of this file, to include going backwards in the directory with '../'. To address this, ensure that user-controlled variables in file paths are sanitized."
scope:
  languages: [java]
  frameworks: ["jax-rs"]
  
sources:
  - id: PATH_PARAM
    match:
      node: METHOD_PARAMETER_IN
      api:
        type: javax.ws.rs.PathParam
      where:
        - op: regex
          left: name
          right: ".*"

sinks:
  - id: FILE_CREATION
    match:
      node: CALL
      api: { type: java.io.File, method: <init> }
      arg_index: "any"
      where:
        - op: eq
          left: argIndex
          right: "$PATH_PARAM"

sanitizers:
  - id: FILENAME_UTILS
    match: { node: CALL, api: { type: org.apache.commons.io.FilenameUtils, method: getName } }
    effect: neutralize

propagations:
  - id: PARAM_TO_ARG
    edge: arg->param
    kind: taint

flows:
  - source: PATH_PARAM
    sink: FILE_CREATION
    through: [PARAM_TO_ARG*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(org.apache.commons.io.FilenameUtils.getName)" } ]

report:
  message: "Path traversal vulnerability detected via user-controlled path parameter in File constructor"
  locations: ["source", "sink"]
  evidence: { capture: [{ argument: "source" }, { argument: "sink" }] }
```