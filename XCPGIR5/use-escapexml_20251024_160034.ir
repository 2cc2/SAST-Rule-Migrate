```yaml
xcpgir_version: "1.0"
rule:
  id: "use-escapexml"
  kind: pattern
  severity: WARNING
  message: "Detected an Expression Language segment that does not escape output. This is dangerous because if any data in this expression can be controlled externally, it is a cross-site scripting vulnerability. Instead, use the 'escapeXml' function from the JSTL taglib."
scope:
  languages: [java]
  frameworks: ["jsp"]
  env: { os: ["*"], shell: ["*"] }
sources:
  - id: EL_EXPRESSION
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: \$\{(?!.*escapeXml).*\}
sinks:
  - id: XSS_SINK
    match:
      node: CALL
      api: { type: javax.servlet.jsp.JspWriter, method: print }
      arg_index: 0
sanitizers:
  - id: ESCAPE_XML
    match:
      node: CALL
      api: { type: "javax.servlet.jsp.jstl.core.fn", method: escapeXml }
    effect: neutralize
    scope: { sinks: [XSS_SINK] }
flows:
  - source: EL_EXPRESSION
    sink: XSS_SINK
    constraints:
      path:
        must_not: [ { pattern: "CALL(javax.servlet.jsp.jstl.core.fn.escapeXml)" } ]
report:
  message: "Unescaped Expression Language segment detected. Potential XSS vulnerability."
  locations: ["source"]
  evidence: { capture: [{ node: EL_EXPRESSION }] }
tests:
  positive:
    - "${param.userInput}"
  negative:
    - "${fn:escapeXml(param.userInput)}"
```