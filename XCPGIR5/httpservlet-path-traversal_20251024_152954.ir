```yaml
xcpgir_version: "1.0"
rule:
  id: httpservlet-path-traversal
  kind: taint
  severity: ERROR
  message: "Detected a potential path traversal. A malicious actor could control the location of this file via user-controllable input. Ensure user-controlled variables in file paths are sanitized."
scope:
  languages: [java]
  frameworks: ["javax.servlet"]
sources:
  - id: HTTP_REQUEST_PARAM
    match:
      node: CALL
      api: { type: "javax.servlet.http.HttpServletRequest", method: "getParameter" }
  - id: HTTP_COOKIE_VALUE
    match:
      node: CALL
      api: { type: "javax.servlet.http.Cookie", method: "getValue" }
sinks:
  - id: FILE_OPERATION
    match:
      node: CALL
      api: { type: "java.io.File", method: "<init>" }
  - id: FILE_OUTPUT_STREAM
    match:
      node: CALL
      api: { type: "java.io.FileOutputStream", method: "<init>" }
  - id: FILE_INPUT_STREAM
    match:
      node: CALL
      api: { type: "java.io.FileInputStream", method: "<init>" }
sanitizers:
  - id: FILENAME_UTILS
    match: { node: CALL, api: { type: "org.apache.commons.io.FilenameUtils", method: "getName" } }
    effect: neutralize
propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
flows:
  - source: HTTP_REQUEST_PARAM
    sink: FILE_OPERATION
    through: [ARG_TO_PARAM*]
  - source: HTTP_COOKIE_VALUE
    sink: FILE_OUTPUT_STREAM
    through: [ARG_TO_PARAM*]
  - source: HTTP_REQUEST_PARAM
    sink: FILE_INPUT_STREAM
    through: [ARG_TO_PARAM*]
report:
  message: "Path traversal vulnerability detected in file operation"
  locations: ["source", "sink", "path"]
  evidence:
    capture:
      - argument: 0
```