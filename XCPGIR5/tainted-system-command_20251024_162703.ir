```yaml
xcpgir_version: "1.0"
rule:
  id: tainted-system-command
  kind: taint
  severity: ERROR
  message: "Detected user input entering a method which executes a system command. This could result in a command injection vulnerability."
scope:
  languages: [java]
  frameworks: [spring]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: INPUT
    match:
      node: METHOD_PARAMETER_IN
      where:
        - op: regex
          left: type
          right: "^(?!(Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean))"
        - op: regex
          left: annotation
          right: "(RequestBody|PathVariable|RequestParam|RequestHeader|CookieValue|ModelAttribute)"

sinks:
  - id: PROCESS_EXEC
    match:
      node: CALL
      api: { type: java.lang.Runtime, method: exec }
    match:
      node: CALL
      api: { type: java.lang.ProcessBuilder, method: command }
    match:
      node: CALL
      api: { type: java.lang.ProcessBuilder, method: start }

propagations:
  - id: CONCAT
    edge: arg->param
    kind: taint
    where:
      - op: eq
        left: methodFullName
        right: "java.lang.StringBuilder.append"

flows:
  - source: INPUT
    sink: PROCESS_EXEC
    through: [CONCAT*]
    constraints:
      path:
        must_not: []

report:
  message: "Detected user input entering a method which executes a system command."
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }

metadata:
  cwe: ["CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"]
  owasp: ["A01:2017 - Injection", "A03:2021 - Injection"]
  category: security
  technology: [java, spring]
  confidence: HIGH
  references:
    - https://www.stackhawk.com/blog/command-injection-java/
    - https://cheatsheetseries.owasp.org/cheatsheets/OS_Command_Injection_Defense_Cheat_Sheet.html
```