```yaml
xcpgir_version: "1.0"
rule:
  id: jdbc-sqli
  kind: taint
  severity: WARNING
  message: "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead."
scope:
  languages: [java]
  frameworks: ["jdbc"]
  
sources:
  - id: SQL_STRING_FORMAT
    match:
      node: CALL
      api: { type: java.lang.String, method: format }
  - id: SQL_STRING_CONCAT
    match:
      node: ASSIGNMENT
      where:
        - op: regex
          left: value
          right: "String.*\\+.*"

sinks:
  - id: SQL_EXECUTION
    match:
      node: CALL
      api: 
        type: java.sql.Statement
        methods: [executeQuery, execute, executeUpdate, executeLargeUpdate, addBatch, nativeSQL]
      arg_index: 0

sanitizers:
  - id: PREPARED_STATEMENT
    match: 
      node: CALL
      api: { type: java.sql.Connection, method: prepareStatement }
    effect: neutralize

barriers:
  - id: LITERAL_SQL
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "^\"[^\\\"]+\"$"
    effect: stop

propagations:
  - id: STRING_TO_SQL
    edge: arg->param
    kind: taint

flows:
  - source: SQL_STRING_FORMAT
    sink: SQL_EXECUTION
    through: [STRING_TO_SQL*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(java.sql.Connection.prepareStatement)" } ]
  - source: SQL_STRING_CONCAT
    sink: SQL_EXECUTION
    through: [STRING_TO_SQL*]
    constraints:
      path:
        must_not: [ { pattern: "CALL(java.sql.Connection.prepareStatement)" } ]

report:
  message: "Possible SQL injection from formatted string to SQL execution"
  locations: ["source", "sink"]
  evidence: 
    capture: 
      - { argument: 0 }

tests:
  positive:
    - "String query = String.format(\"SELECT * FROM users WHERE id='%s'\", input); stmt.executeQuery(query);"
    - "String query = \"SELECT * FROM \" + table; stmt.execute(query);"
  negative:
    - "PreparedStatement stmt = conn.prepareStatement(\"SELECT * FROM users WHERE id=?\"); stmt.setString(1, input);"
    - "stmt.executeQuery(\"SELECT * FROM static_table\");"
```