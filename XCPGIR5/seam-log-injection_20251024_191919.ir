```yaml
xcpgir_version: "1.0"
rule:
  id: seam-log-injection
  kind: taint
  severity: ERROR
  message: >-
    Seam Logging API support an expression language to introduce bean property to log messages.
    The expression language can also be the source to unwanted code execution.
    In this context, an expression is built with a dynamic value.
    The source of the value(s) should be verified to avoid that unfiltered values fall into this risky
    code evaluation.
scope:
  languages: [java]
  frameworks: ["jboss"]

sources:
  - id: DYNAMIC_LOG_VALUE
    match:
      node: ARGUMENT
      api:
        package: org.jboss.seam.log
        type: Log
        method: debug|error|fatal|info|trace|warn
        signature: ["(...)"]
      where:
        - op: regex
          left: value
          right: ".+"

sinks:
  - id: SEAM_LOG_EVAL
    match:
      node: CALL
      api: { package: org.jboss.seam.log, type: Log, method: debug|error|fatal|info|trace|warn }
      arg_index: 0

propagations:
  - id: CONCAT_TO_ARG
    edge: arg->param
    kind: taint

flows:
  - source: DYNAMIC_LOG_VALUE
    sink: SEAM_LOG_EVAL
    through: [CONCAT_TO_ARG*]

report:
  locations: ["source","sink"]
  evidence: { capture: [{ argument: 0 }] }
metadata:
  cwe: ["CWE-95: Improper Neutralization of Directives in Dynamically Evaluated Code ('Eval Injection')"]
  owasp: ["A03:2021 - Injection"]
  references: ["https://owasp.org/Top10/A03_2021-Injection"]
```