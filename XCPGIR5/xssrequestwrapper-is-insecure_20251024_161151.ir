```yaml
xcpgir_version: "1.0"
rule:
  id: xssrequestwrapper-is-insecure
  kind: hybrid
  severity: WARNING
  message: "It looks like you're using an implementation of XSSRequestWrapper from dzone. The XSS filtering in this code is not secure and can be bypassed by malicious actors."
scope:
  languages: [java]
  frameworks: ["*"]
  env: { os: ["*"], shell: ["*"] }

sources:
  - id: XSS_REQUEST_WRAPPER
    match:
      node: TYPE_DECL
      where:
        - op: regex
          left: code
          right: "class XSSRequestWrapper extends HttpServletRequestWrapper"
  - id: INSECURE_SCRIPT_REMOVAL
    match:
      node: CALL
      where:
        - op: regex
          left: code
          right: "\\.compile\\(\"</script>\",.*CASE_INSENSITIVE.*\\)\\..*\\.replaceAll\\(\"\"\\)"

sinks:
  - id: XSS_SINK
    match:
      node: CALL
      api: { package: javax.servlet.http, type: HttpServletRequest, method: getParameter }

sanitizers: []

barriers: []

propagations:
  - id: WRAPPER_TO_PARAM
    edge: field->param
    kind: taint

flows:
  - source: XSS_REQUEST_WRAPPER
    sink: XSS_SINK
    through: [WRAPPER_TO_PARAM*]
  - source: INSECURE_SCRIPT_REMOVAL
    sink: XSS_SINK
    through: [WRAPPER_TO_PARAM*]

report:
  message: "Insecure XSS filtering detected in XSSRequestWrapper implementation"
  locations: ["source", "sink"]
  evidence: { capture: [{ node: "source" }] }

tests:
  positive:
    - "new XSSRequestWrapper(request).getParameter(\"input\");"
    - "Pattern.compile(\"</script>\", Pattern.CASE_INSENSITIVE).matcher(input).replaceAll(\"\");"
  negative: []
```