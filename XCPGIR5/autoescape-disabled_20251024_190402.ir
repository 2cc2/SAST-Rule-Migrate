```yaml
xcpgir_version: "1.0"
rule:
  id: "autoescape-disabled"
  kind: "pattern"
  severity: "WARNING"
  message: "Detected an element with disabled HTML escaping. If external data can reach this, this is a cross-site scripting (XSS) vulnerability."
scope:
  languages: ["regex"]
  frameworks: ["jsf"]
sources: []
sinks:
  - id: "DISABLED_ESCAPE"
    match:
      node: "LITERAL"
      where:
        - op: "regex"
          left: "value"
          right: ".*escape.*?=.*?false.*"
sanitizers: []
barriers: []
propagations: []
flows:
  - source: ""
    sink: "DISABLED_ESCAPE"
    constraints: {}
report:
  message: "Ensure no external data can reach here, or remove 'escape=false' from this element."
  locations: ["sink"]
tests: {}
```