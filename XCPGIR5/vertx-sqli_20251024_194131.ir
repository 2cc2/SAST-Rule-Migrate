```yaml
xcpgir_version: "1.0"
rule:
  id: vertx-sqli
  kind: taint
  severity: WARNING
  message: "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead."
scope:
  languages: [java]
  frameworks: ["vertx"]
  env: { os: [linux, windows], shell: [bash, sh, powershell] }

sources:
  - id: SQL_FORMATTING
    match:
      node: CALL
      where:
        - op: or
          conditions:
            - op: regex
              left: methodFullName
              right: "String.format"
            - op: neq
              left: arg[0].value
              right: "...\" + \"..."

sinks:
  - id: SQL_EXECUTION
    match:
      node: CALL
      api:
        method: query|preparedQuery|prepare
      arg_index: 0

sanitizers:
  - id: PREPARED_STATEMENT
    match:
      node: CALL
      api: { type: java.sql.Connection, method: prepareStatement }
    effect: neutralize 

propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint
  - id: METHOD_ARGUMENT
    edge: caller->callee
    kind: taint 

flows:
  - source: SQL_FORMATTING
    sink: SQL_EXECUTION 
    through: [STRING_CONCAT*, METHOD_ARGUMENT*]
    constraints:
      path:
        must_not:
          - pattern: "CALL(java.sql.Connection.prepareStatement)"

report:
  message: "User input reaches SQL execution without sanitization"
  locations: ["source", "sink"]
  evidence:
    capture: 
      - argument: 0 
      - method: query|preparedQuery|prepare

metadata:
  cwe: "CWE-89"
  category: security
  technology: ["vertx"]
  owasp: ["A01:2017 - Injection", "A03:2021 - Injection"]
  references: ["https://owasp.org/Top10/A03_2021-Injection"]
```