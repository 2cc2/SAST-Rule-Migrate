```yaml
xcpgir_version: "1.0"
rule:
  id: "no-scriptlets"
  kind: pattern
  severity: WARNING
  message: "JSP scriptlet detected. Scriptlets are difficult to use securely and are considered bad practice. Consider migrating to JSF or using Expression Language '${...}' with escapeXml function."
scope:
  languages: [java]
  frameworks: ["jsp"]
  env: { os: ["*"], shell: ["*"] }
sources:
  - id: JSP_SCRIPTLET
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "\<\%[^\@].*"
sinks:
  - id: JSP_SINK
    match:
      node: FILE
      where:
        - op: regex
          left: path
          right: ".*\.jsp$"
flows:
  - source: JSP_SCRIPTLET
    sink: JSP_SINK
report:
  message: "JSP scriptlet detected. Consider migrating to JSF or using Expression Language instead."
  locations: ["source", "sink"]
tests: {}
```