```yaml
xcpgir_version: "1.0"
rule:
  id: "dangerous-groovy-shell"
  kind: taint
  severity: WARNING
  message: "A expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."
scope:
  languages: [java]
  frameworks: ["groovy"]
sources:
  - id: USER_INPUT
    match:
      node: LITERAL | PARAM
      where:
        - op: neq
          left: "value"
          right: '""'
sinks:
  - id: GROOVY_EXEC
    match:
      node: CALL
      api: 
        type: "groovy.lang.GroovyShell"
        method: "parse|evaluate|parseClass"
      arg_index: 0
  - id: GROOVY_CLASSLOADER_EXEC
    match:
      node: CALL
      api:
        type: "groovy.lang.GroovyClassLoader"
        method: "parse|evaluate|parseClass"
      arg_index: 0
sanitizers: []
barriers: []
propagations:
  - id: ARG_TO_PARAM
    edge: arg->param
    kind: taint
flows:
  - source: USER_INPUT
    sink: GROOVY_EXEC
    through: [ARG_TO_PARAM*]
  - source: USER_INPUT
    sink: GROOVY_CLASSLOADER_EXEC
    through: [ARG_TO_PARAM*]
report:
  message: "Dynamic Groovy shell execution detected. Verify source of input values to prevent code injection."
  locations: ["sink"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "shell.evaluate(userControlledInput);"
    - "shell.parseClass(untrustedData);"
  negative:
    - 'shell.evaluate("static string");'
    - 'shell.parseClass("static.class");'
```