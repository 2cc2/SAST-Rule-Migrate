```yaml
xcpgir_version: "1.0"
rule:
  id: "spring-sqli"
  kind: taint
  severity: WARNING
  message: "Detected a string argument from a public method contract in a raw SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead."
  
scope:
  languages: [java]
  frameworks: ["spring"]
  
sources:
  - id: PUBLIC_STRING_PARAM
    match:
      node: METHOD_PARAMETER_IN
      type:
        name: "java.lang.String"
        match: exact
      where:
        - op: eq
          left: "method.isPublic"
          right: true

sinks:
  - id: SQL_EXECUTION
    match:
      node: CALL
      api: { type: "org.springframework.jdbc.core.PreparedStatementCreatorFactory", method: "<init>" }
      arg_index: 0
  - id: JDBC_TEMPLATE_EXEC
    match:
      node: CALL
      api: { type: "org.springframework.jdbc.core.JdbcTemplate", method: "*" }
      arg_index: 0
  - id: BATCH_UPDATE
    match:
      node: CALL
      api: { type: "org.springframework.jdbc.core.NamedParameterBatchUpdateUtils", method: "*" }
      arg_index: 0

sanitizers:
  - id: STRING_CONSTRUCTOR
    match: { node: CALL, api: { type: "java.lang.String", method: "<init>" } }
    effect: neutralize

propagations:
  - id: METHOD_ARG_PROPAGATION
    edge: arg->param
    kind: taint

flows:
  - source: PUBLIC_STRING_PARAM
    sink: SQL_EXECUTION
    through: [METHOD_ARG_PROPAGATION*]
  - source: PUBLIC_STRING_PARAM
    sink: JDBC_TEMPLATE_EXEC
    through: [METHOD_ARG_PROPAGATION*]
  - source: PUBLIC_STRING_PARAM
    sink: BATCH_UPDATE
    through: [METHOD_ARG_PROPAGATION*]

report:
  message: "Detected potential SQL injection from un-sanitized string parameter reaching SQL execution point"
  locations: ["source","sink","path"]
  evidence: { capture: [{ argument: 0 }] }

tests:
  positive:
    - "new JdbcTemplate(dataSource).execute(request.getParameter(\"query\"));"
  negative:
    - "new JdbcTemplate(dataSource).execute(new String(request.getParameter(\"query\")));"
```