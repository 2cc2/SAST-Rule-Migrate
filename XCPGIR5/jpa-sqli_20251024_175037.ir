```yaml
xcpgir_version: "1.0"
rule:
  id: "jpa-sqli"
  kind: taint
  severity: WARNING
  message: "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead."
scope:
  languages: [java]
  frameworks: ["jpa"]
sources:
  - id: SQL_STRING_FORMAT
    match:
      node: CALL
      api: { type: java.lang.String, method: format }
  - id: SQL_STRING_CONCAT
    match:
      node: ASSIGNMENT
      where:
        - op: regex
          left: code
          right: "String \\$SQL = .*\\+.*"

sinks:
  - id: JPA_SQL_EXEC
    match:
      node: CALL
      api: 
        type: javax.persistence.EntityManager
        method: "(createQuery|createNativeQuery)"
      arg_index: 0

sanitizers:
  - id: STATIC_SQL
    match:
      node: LITERAL
      where:
        - op: eq
          left: nodeType
          right: "StringLiteral"

propagations:
  - id: ARG_TO_SQL
    edge: arg->param
    kind: taint

flows:
  - source: SQL_STRING_FORMAT
    sink: JPA_SQL_EXEC
  - source: SQL_STRING_CONCAT
    sink: JPA_SQL_EXEC
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(StringLiteral)" } ]

report:
  message: "User input reaches JPA SQL execution without sanitization"
  locations: ["source", "sink", "path"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "em.createNativeQuery(String.format(\"SELECT * FROM users WHERE id = %s\", input));"
    - "String sql = \"SELECT * FROM \" + tableName; em.createQuery(sql);"
  negative:
    - "em.createNativeQuery(\"SELECT * FROM users WHERE id = ?\");"
    - "String sql = \"SELECT * FROM users\"; em.createQuery(sql);"
```