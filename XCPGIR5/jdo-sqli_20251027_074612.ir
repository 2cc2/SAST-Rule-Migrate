```yaml
xcpgir_version: "1.0"
rule:
  id: jdo-sqli
  kind: taint
  severity: WARNING
  message: "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead."
scope:
  languages: [java]
  frameworks: ["javax.jdo"]

sources:
  - id: SQL_FORMATTED_STRING
    match:
      node: CALL | ASSIGNMENT | LITERAL
      where:
        - op: regex
          left: code
          right: "String\\s+\\$SQL\\s*=\\s*\\$X\\s*\\+\\s*\\$Y"
        - op: regex
          left: code
          right: "String\\.format\\(.*\\)"
      type:
        name: java.lang.String

sinks:
  - id: JDO_QUERY_EXEC
    match:
      node: CALL
      api:
        package: javax.jdo
        type: Query
        method: setFilter | setGrouping
      arg_index: 0
  - id: JDO_PM_NEW_QUERY
    match:
      node: CALL
      api:
        package: javax.jdo
        type: PersistenceManager
        method: newQuery
      arg_index: 1

sanitizers:
  - id: SQL_CONSTANT_STRING
    match:
      node: LITERAL
      where:
        - op: regex
          left: code
          right: "^\"[^\"]+\"\\s*\\+\\s*\"[^\"]+\"$"
    effect: neutralize

propagations:
  - id: STRING_CONCAT
    edge: arg->param
    kind: taint

flows:
  - source: SQL_FORMATTED_STRING
    sink: JDO_QUERY_EXEC
    through: [STRING_CONCAT*]
    constraints:
      path:
        must_not: [ {pattern: "LITERAL(SQL_CONSTANT_STRING)"} ]
  
  - source: SQL_FORMATTED_STRING
    sink: JDO_PM_NEW_QUERY
    through: [STRING_CONCAT*]
    constraints:
      path:
        must_not: [ {pattern: "LITERAL(SQL_CONSTANT_STRING)"} ]

report:
  message: "User-provided SQL string reaches JDO query execution without proper sanitization"
  locations: ["source","sink","path"]
  evidence:
    capture:
      - argument: 0
tests:
  positive:
    - "Query q = pm.newQuery(\"SELECT * FROM \" + tableName);"
  negative:
    - "Query q = pm.newQuery(\"SELECT * FROM customers\");"
```