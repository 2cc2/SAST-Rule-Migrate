```yaml
xcpgir_version: "1.0"
rule:
  id: spel-injection
  kind: pattern
  severity: WARNING
  message: "A Spring expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."
scope:
  languages: [java]
  frameworks: [spring]
sources:
  - id: DYNAMIC_EXPRESSION
    match:
      node: CALL
      api:
        package: org.springframework.expression
        type: ExpressionParser
        method: parseExpression
      where:
        - op: neq
          left: arg[0].value
          right: "..."
sinks:
  - id: EXPRESSION_EVAL
    match:
      node: CALL
      api:
        package: org.springframework.expression
        type: ExpressionParser
        method: parseExpression
barriers:
  - id: STATIC_EXPRESSION
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: '^".*"$'
    effect: stop
flows:
  - source: DYNAMIC_EXPRESSION
    sink: EXPRESSION_EVAL
    constraints:
      path:
        must_not: [STATIC_EXPRESSION]
report:
  message: "Unsafe Spring Expression evaluation detected"
  locations: ["sink"]
  evidence: { capture: [{ argument: 0 }] }
tests:
  positive:
    - "parser.parseExpression(userInput)"
  negative:
    - "parser.parseExpression(\"safeExpression\")"
```