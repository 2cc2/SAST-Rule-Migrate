```yaml
xcpgir_version: "1.0"
rule:
  id: "use-jstl-escaping"
  kind: pattern
  severity: WARNING
  message: "Detected an Expression Language segment in a tag that does not escape output. This is dangerous because if any data in this expression can be controlled externally, it is a cross-site scripting vulnerability. Instead, use the 'out' tag from the JSTL taglib to escape this expression."
scope:
  languages: [java]
  frameworks: ["jsp"]
sources:
  - id: UNSAFE_JSP_EXPRESSION
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "<(?![A-Za-z0-9]+:out).*?\$\{.*?\}.*>"
sinks:
  - id: XSS_SINK
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "\$\{.*?\}"
sanitizers:
  - id: JSTL_OUT_TAG
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: "<[A-Za-z0-9]+:out.*>"
    effect: neutralize
flows:
  - source: UNSAFE_JSP_EXPRESSION
    sink: XSS_SINK
    constraints:
      path:
        must_not: [ { pattern: "LITERAL(value~='<[A-Za-z0-9]+:out.*>')" } ]
report:
  message: "Unsafe JSP expression detected. Use JSTL out tag for proper escaping."
  locations: ["source"]
  evidence: { capture: [{ literal: "value" }] }
tests:
  positive:
    - "<fmt:message>${param.userInput}</fmt:message>"
  negative:
    - "<c:out value=\"${param.userInput}\"/>"
```