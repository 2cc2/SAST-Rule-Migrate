where 
  // Source: Unsafe Expression
  matches(unsafeExpr.getValue(), "<(?![A-Za-z0-9]+:out).*?\\$\\{.*?\\}.*>") and
  // Sink: XSS Sink
  matches(xssSink.getValue(), "\\$\\{.*?\\}")
