  regexpMatch(scriptlet.getValue(), "\\<\\%[^\\@].*") and
  regexpMatch(f.getFile().getBaseName(), ".*\\.jsp$")
select scriptlet, "JSP scriptlet detected. Consider replacing with Expression Language or migrating to JSF."
