import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.JaxRs

class IsPathParameter extends Parameter {
  IsPathParameter() {
    exists(Annotation a |
      a = getAnAnnotation() and
      (
        a.getType().hasQualifiedName("javax.ws.rs", "PathParam") or
        a.toString().matches("@PathParam")
      )
    )
  }
}

class FileConstructorCall extends Call {
  FileConstructorCall() {
    getTarget().hasName("<init>") and
    getTarget().getDeclaringType().hasQualifiedName("java.io", "File")
  }
}

class FilenameUtilsSanitizer extends Call {
  FilenameUtilsSanitizer() {
    getTarget().hasName("getName") and
    getTarget().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils")
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "JaxRsPathTraversal" }

  override predicate isSource(DataFlow::Node source) {
    exists(IsPathParameter param |
      source.asParameter() = param
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(FileConstructorCall call |
      sink.asExpr() = call.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(FilenameUtilsSanitizer sanitizer |
      node.asExpr() = sanitizer.getArgument(0)
    )
  }
}

