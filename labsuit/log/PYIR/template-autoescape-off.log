IR Content:
```yaml
xcpgir_version: "1.0"
rule:
  id: template-autoescape-off
  kind: pattern
  severity: WARNING
  message: "Detected a segment of a Flask template where autoescaping is explicitly disabled with '{% autoescape off %}'. This allows rendering of raw HTML in this segment. Ensure no user data is rendered here, otherwise this is a cross-site scripting (XSS) vulnerability, or turn autoescape on."
  metadata:
    language: regex
    category: security

sources:
  - id: AUTOESCAPE_OFF
    match:
      node: LITERAL
      where:
        - op: regex
          left: value
          right: '{%\s*autoescape\s+false\s*%}'

sinks:
  - id: HTML_RENDERING
    match:
      node: CALL
      api:
        package: flask
        type: Template
        method: render
```
