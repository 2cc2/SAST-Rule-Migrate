rule:
  id: "jdbc-sqli"
  kind: taint
  severity: WARNING
  message: "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use a prepared statements (java.sql.PreparedStatement) instead. You can obtain a PreparedStatement using 'connection.prepareStatement'."
  metadata:
    language: "java"
    category: "security"
    cwe: ["CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"]
    owasp: ["A01:2017 - Injection", "A03:2021 - Injection"]
    technology: ["jdbc"]
    likelihood: "LOW"
    impact: "HIGH"
    confidence: "LOW"

sources:
  - id: STRING_FORMAT_SOURCE
    match:
      node: CALL
      api: { type: "java.lang.String", method: "format" }
  - id: STRING_CONCAT_SOURCE
    match:
      node: ASSIGNMENT
      where:
        - op: regex
          left: "code"
          right: "String \\$SQL = \\$X \\+ \\$Y;"

sinks:
  - id: SQL_EXECUTION_SINK
    match:
      node: CALL
      api: { type: "java.sql.Statement", method: "executeQuery" }
      arg_index: 0
    where:
      - op: regex
        left: "methodFullName"
        right: "^(executeQuery|execute|executeUpdate|executeLargeUpdate|addBatch|nativeSQL)$"
  - id: DIRECT_FORMAT_SINK
    match:
      node: CALL
      api: { type: "java.lang.String", method: "format" }
      where:
        - op: regex
          left: "parent.code"
          right: "\\$S\\.\\$METHOD\\(String.format\\(.*\\),.*\\)"
  - id: DIRECT_CONCAT_SINK
    match:
      node: BINARY_OP
      where:
        - op: regex
          left: "code"
          right: "\\$X \\+ \\$Y"
        - op: regex
          left: "parent.code"
          right: "\\$S\\.\\$METHOD\\(.*\\+.*,.*\\)"

sanitizers:
  - id: STRING_LITERAL_SANITIZER
    match:
      node: LITERAL
    where:
      - op: regex
        left: "code"
        right: "^\"\" \\+ \"\"$"
  - id: SAFE_CONCAT_SANITIZER
    match:
      node: ASSIGNMENT
      where:
        - op: regex
          left: "code"
          right: "String \\$SQL = \".*\" \\+ \".*\";"

propagations:
  - id: STRING_PROPAGATION
    edge: arg->param
    kind: taint
  - id: METHOD_PARAM_PROPAGATION
    edge: arg->param
    kind: taint
    where:
      - op: regex
        left: "parent.code"
        right: "\\$VAL \\$FUNC\\(.*String \\$SQL.*\\)"
  - id: VARIABLE_ASSIGN_PROPAGATION
    edge: assign
    kind: taint
```
