/**
 * @name RSA without OAEP mode weakens encryption
 * @description Using RSA without OAEP mode weakens the encryption.
 * @kind problem
 * @id java/rsa-no-padding
 * @tags security
 *       vulnerability
 *       crypto
 *       cwe/326
 *       owasp/a03:2017
 *       owasp/a02:2021
 * @security-severity 6.8
 */

import java

from MethodAccess ma, StringLiteral sl
where
  ma.getMethod().getName() = "getInstance" and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
  sl = ma.getArgument(0) and
  sl.getLiteral().matches("%RSA/[Nn][Oo][Nn][Ee]/NoPadding%")
select ma, "Using RSA without OAEP mode weakens the encryption."