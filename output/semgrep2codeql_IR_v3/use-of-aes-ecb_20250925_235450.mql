/**
 * @name Use of AES with ECB mode
 * @description Detects usage of AES with ECB mode which doesn't provide message confidentiality and is not semantically secure.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-aes-ecb
 * @tags security
 *   external/cwe/cwe-327
 *   external/owasp/a03:2017
 *   external/owasp/a02:2021
 *   external/crypto
 */
import java

from MethodAccess ma, string mode
where
  ma.getMethod().hasName("getInstance") and
  ma.getQualifier().getType().hasName("Cipher") and
  mode = ma.getArgument(0).(StringLiteral).getValue() and
  mode.regexpMatch("AES/ECB.*")
select ma, "Use of AES with ECB mode detected. ECB doesn't provide message confidentiality and is not semantically secure so should not be used. Instead, use a strong, secure cipher: Cipher.getInstance(\"AES/CBC/PKCS7PADDING\"). See https://owasp.org/www-community/Using_the_Java_Cryptographic_Extensions for more information."