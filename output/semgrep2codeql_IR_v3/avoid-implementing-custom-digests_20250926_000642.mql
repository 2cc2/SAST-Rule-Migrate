/**
 * @name Avoid implementing custom digests
 * @description Cryptographic algorithms are notoriously difficult to get right. By implementing a custom message digest,
 *              you risk introducing security issues into your program. Use one of the many sound message digests already
 *              available to you: MessageDigest sha256Digest = MessageDigest.getInstance("SHA256");
 * @kind problem
 * @problem.severity warning
 * @id java/avoid-implementing-custom-digests
 * @tags security
 *       cwe: "CWE-327: Use of a Broken or Risky Cryptographic Algorithm"
 *       owasp: "A03:2017 - Sensitive Data Exposure"
 *       owasp: "A02:2021 - Cryptographic Failures"
 *       asvs: "V6 Stored Cryptography Verification Requirements:6.2.2 Insecure Custom Algorithm"
 * @security-severity 4.3
 */

import java

from Class cls
where cls.getASupertype().hasQualifiedName("java.security", "MessageDigest")
select cls, "Avoid implementing custom message digests. Use standard cryptographic algorithms instead."