/**
 * @name Use of AES with default settings
 * @description Detects usage of AES with no settings specified. By default, java.crypto.Cipher uses ECB mode which is not semantically secure.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-default-aes
 * @tags security
 *   external/cwe/cwe-327
 *   external/owasp/a03:2017
 *   external/owasp/a02:2021
 *   external/crypto
 */
import java

from MethodAccess ma
where
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
  (
    ma.getArgument(0).(StringLiteral).getValue().toLowerCase() = "aes" or
    ma.getArgument(0).(StringLiteral).getValue().toLowerCase() = "aes/ecb/nopadding" or
    ma.getArgument(0).(StringLiteral).getValue().toLowerCase() = "aes/ecb/pkcs5padding"
  )
select ma, "Use of AES with no settings detected. By default, java.crypto.Cipher uses ECB mode. " +
  "ECB doesn't provide message confidentiality and is not semantically secure so should not be used. " +
  "Instead, use a strong, secure cipher: java.crypto.Cipher.getInstance(\"AES/CBC/PKCS7PADDING\"). " +
  "See https://owasp.org/www-community/Using_the_Java_Cryptographic_Extensions for more information."