/**
 * @name Overly Permissive File Permission
 * @description Detected file permissions that are overly permissive (read, write, and execute). 
 *              It is generally a bad practice to set overly permissive file permission such as 
 *              read+write+exec for all users. If the file affected is a configuration, a binary, 
 *              a script or sensitive data, it can lead to privilege escalation or information leakage. 
 *              Instead, follow the principle of least privilege and give users only the permissions they need.
 * @kind problem
 * @problem.severity warning
 * @id java/overly-permissive-file-permission
 * @tags security
 *       external/cwe/cwe-276
 *       external/owasp/a01:2021
 *       cwe2021-top25
 *       cwe2022-top25
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isOverlyPermissive(Expr permExpr) {
  exists(MethodAccess ma |
    ma.getMethod().getName() = "fromString" and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.nio.file.attribute", "PosixFilePermissions") and
    permExpr = ma.getArgument(0) and
    ma.getArgument(0).(StringLiteral).getValue().regexpMatch("(^......r..$)|(^.......w.$)|(^........x$)")
  )
  or
  exists(MethodAccess ma |
    ma.getMethod().getName() = "add" and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.util", "Set") and
    (
      ma.getArgument(0).toString() = "OTHERS_READ" or
      ma.getArgument(0).toString() = "OTHERS_WRITE" or
      ma.getArgument(0).toString() = "OTHERS_EXECUTE"
    ) and
    exists(MethodAccess setPerm |
      setPerm.getMethod().getName() = "setPosixFilePermissions" and
      setPerm.getMethod().getDeclaringType().hasQualifiedName("java.nio.file", "Files") and
      setPerm.getArgument(1) = ma.getQualifier()
    )
  )
}

from MethodAccess setPerm, Expr permExpr
where
  setPerm.getMethod().getName() = "setPosixFilePermissions" and
  setPerm.getMethod().getDeclaringType().hasQualifiedName("java.nio.file", "Files") and
  (
    permExpr = setPerm.getArgument(1) or
    exists(MethodAccess ma |
      ma.getMethod().getName() = "add" and
      ma.getQualifier() = setPerm.getArgument(1) and
      permExpr = ma.getArgument(0)
    )
  ) and
  isOverlyPermissive(permExpr)
select setPerm, "Detected file permissions that are overly permissive (read, write, and execute)."