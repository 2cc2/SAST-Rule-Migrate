/**
 * @name Turbine SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection if variables in the SQL statement are not properly sanitized. Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind problem
 * @problem.severity warning
 * @id java/turbine-sqli
 * @tags security
 *   external/cwe/cwe-89
 *   external/owasp/a01:2017
 *   external/owasp/a03:2021
 *   cwe2021-top25
 *   cwe2022-top25
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isTurbinePeer(Expr peer) {
  exists(RefType peerType |
    peer.getType() = peerType and
    (peerType.hasQualifiedName("", "BasePeer") or peerType.hasQualifiedName("", "GroupPeer"))
  )
}

predicate isStringConcatenation(Expr expr) {
  exists(AddExpr add |
    add = expr and
    (add.getLeftOperand().getType() instanceof TypeString or 
     add.getRightOperand().getType() instanceof TypeString)
  )
}

predicate isStringFormatCall(Expr expr) {
  exists(MethodAccess ma |
    ma = expr and
    ma.getMethod().getName() = "format" and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "String")
  )
}

predicate isDangerousSqlConstruction(Expr sqlExpr) {
  isStringConcatenation(sqlExpr) or
  isStringFormatCall(sqlExpr)
}

predicate isExecuteQueryCall(MethodAccess ma) {
  ma.getMethod().getName() = "executeQuery" and
  isTurbinePeer(ma.getQualifier())
}

from MethodAccess executeQuery, Expr sqlArg, Expr peer
where
  isExecuteQueryCall(executeQuery) and
  (
    (sqlArg = executeQuery.getArgument(0) and isDangerousSqlConstruction(sqlArg)) or
    (peer = executeQuery.getQualifier() and isTurbinePeer(peer))
  )
select executeQuery, "Detected a formatted string in a SQL statement. This could lead to SQL injection. Use prepared statements instead."