/**
 * @name Use of SHA-224
 * @description This code uses a 224-bit hash function, which is deprecated or disallowed in some security policies.
 *              Consider updating to a stronger hash function such as SHA-384 or higher to ensure compliance and security.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-sha224
 * @tags security
 *       owasp-a03:2017
 *       owasp-a02:2021
 *       cwe-328
 *       crypto
 *       java
 * @precision high
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isWeakHashAlgorithm(Expr algo) {
  exists(StringLiteral sl | sl = algo |
    sl.getValue().matches(".*224") or
    sl.getValue() = "SHA-224" or
    sl.getValue() = "SHA3-224" or
    sl.getValue() = "SHA512/224"
  )
}

from Call call, Expr algo
where
  (
    // DigestUtils method calls
    (
      call.getCallee().hasName(["getSha3_224Digest", "getSha512_224Digest", "sha3_224", "sha3_224Hex", "sha512_224", "sha512_224Hex"]) and
      call.getCallee().getDeclaringType().hasQualifiedName("org.apache.commons.codec.digest", "DigestUtils")
    )
    or
    // DigestUtils constructor with weak algorithms
    (
      call.getCallee().hasName("<init>") and
      call.getCallee().getDeclaringType().hasQualifiedName("org.apache.commons.codec.digest", "DigestUtils") and
      exists(FieldAccess fa | fa = call.getArgument(0) |
        fa.getField().hasName(["SHA_224", "SHA_512_224", "SHA3_224"]) and
        fa.getField().getDeclaringType().hasQualifiedName("org.apache.commons.codec.digest", "MessageDigestAlgorithms")
      )
    )
    or
    // MessageDigest.getInstance with weak algorithms
    (
      call.getCallee().hasName("getInstance") and
      call.getCallee().getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
      isWeakHashAlgorithm(algo) and
      call.getArgument(0) = algo
    )
  )
select call, "Use of 224-bit hash function $@ is deprecated or disallowed in some security policies. Consider updating to a stronger hash function such as SHA-384 or higher.",
  call.getCallee(), "weak hash function"