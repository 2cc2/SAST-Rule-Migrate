/**
 * @name Do Privileged Use
 * @description Marking code as privileged enables a piece of trusted code to temporarily enable access to more resources than are available directly to the code that called it. Be very careful in your use of the privileged construct, and always remember to make the privileged code section as small as possible.
 * @kind problem
 * @problem.severity warning
 * @id java/do-privileged-use
 * @tags security
 *   - cwe/CWE-269
 *   - owasp/A04:2021
 *   - technology/java
 */

import java

from MethodAccess ma, Class c
where
  (
    ma.getMethod().hasName("doPrivileged") and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "AccessController")
  )
  or
  c.getASupertype*().hasQualifiedName("java.security", "PrivilegedAction")
select ma, "Use of AccessController.doPrivileged() detected. Ensure privileged code section is minimized."