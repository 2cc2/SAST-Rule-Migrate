/**
 * @name XMLDecoder usage with untrusted data
 * @description Detects unsafe usage of XMLDecoder which can lead to arbitrary code execution.
 * @kind problem
 * @problem.severity warning
 * @id java/xml-decoder
 * @tags security
 *       external/cwe/cwe-611
 *       owasp-a04:2017
 *       owasp-a05:2021
 *       audit
 */
import java

from ConstructorCall call, Method method
where
  call.getConstructedType().hasQualifiedName("java.beans", "XMLDecoder") and
  not call.getArgument(0).(StringLiteral).getValue().regexpMatch("\\.*") and
  method.getDeclaringType().fromSource()
select call, "XMLDecoder should not be used to parse untrusted data. " +
  "Deserializing user input can lead to arbitrary code execution. " +
  "Use an alternative and explicitly disable external entities."