/**
 * @name JWT None Algorithm Vulnerability
 * @description Detects use of the 'none' algorithm in JWT tokens which can allow token forgery.
 * @kind problem
 * @problem.severity error
 * @id java/jwt-none-alg
 * @tags security
 *       external/cwe/cwe-327
 *       external/owasp/a03:2017
 *       external/owasp/a02:2021
 *       external/asvs/V3:3.5.3
 */
import java

from MethodAccess ma, Method m
where
  m.getDeclaringType().hasQualifiedName("io.jsonwebtoken", "Jwts") and
  m.getName() = "builder" and
  ma.getMethod() = m and
  not exists(
    MethodAccess signWithCall |
    signWithCall.getMethod().getName() = "signWith" and
    signWithCall.getEnclosingCallable().getDeclaringType() = ma.getEnclosingCallable().getDeclaringType()
  )
select ma, "Use of JWT without signature verification. The 'none' algorithm is insecure and can allow token forgery."