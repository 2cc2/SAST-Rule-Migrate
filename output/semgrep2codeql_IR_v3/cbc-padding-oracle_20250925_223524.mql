/**
 * @name CBC with PKCS5Padding is susceptible to padding oracle attacks
 * @description Using CBC with PKCS5Padding is vulnerable to padding oracle attacks and lacks integrity checks.
 * @kind problem
 * @problem.severity warning
 * @id java/cbc-padding-oracle
 * @tags security
 *       external/cwe/cwe-327
 *       external/owasp/a03:2017
 *       external/owasp/a02:2021
 *       cwe/327
 * @precision high
 */
import java

from MethodAccess ma, StringLiteral sl
where
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
  sl = ma.getArgument(0) and
  sl.getValue().matches("%/CBC/PKCS5Padding%")
select ma, "Using CBC with PKCS5Padding is susceptible to padding oracle attacks. " +
  "A malicious actor could discern the difference between plaintext with valid or invalid padding. " +
  "Further, CBC mode does not include any integrity checks. Use 'AES/GCM/NoPadding' instead."