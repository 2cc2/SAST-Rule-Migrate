/**
 * @name Use of weak RSA key
 * @description RSA keys should be at least 2048 bits based on NIST recommendation.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-weak-rsa-key
 * @tags security
 *   vulnerability
 *   cwe/326
 *   owasp/a03:2017
 *   owasp/a02:2021
 *   asvs/V6.2.5
 */
import java

from Method method, MethodAccess getInstanceCall, MethodAccess initializeCall, Literal bitsLiteral
where
  // Match KeyPairGenerator.getInstance("RSA")
  method.hasName("getInstance") and
  method.getDeclaringType().hasQualifiedName("java.security", "KeyPairGenerator") and
  getInstanceCall.getMethod() = method and
  getInstanceCall.getArgument(0).(StringLiteral).getValue() = "RSA" and
  
  // Match initialize() call on the same KeyPairGenerator instance
  initializeCall.getMethod().hasName("initialize") and
  initializeCall.getQualifier() = getInstanceCall.getQualifier() and
  
  // Get the bits argument and check if it's less than 2048
  bitsLiteral = initializeCall.getArgument(0) and
  bitsLiteral.getValue().toInt() < 2048
select initializeCall, "RSA keys should be at least 2048 bits based on NIST recommendation."