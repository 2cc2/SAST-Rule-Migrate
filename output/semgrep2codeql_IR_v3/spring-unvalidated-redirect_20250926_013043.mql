/**
 * @name Spring Unvalidated Redirect
 * @description Application redirects a user to a destination URL specified by a user supplied parameter that is not validated.
 * @kind problem
 * @problem.severity warning
 * @id java/spring-unvalidated-redirect
 * @tags security
 *       external/cwe/cwe-601
 *       external/owasp/a01
 *       external/cwe/cwe-601
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.frameworks.spring.SpringController

predicate isUnvalidatedRedirect(Expr urlArg, MethodAccess redirectCall) {
  exists(Method method, Parameter urlParam |
    method.getAParameter() = urlParam and
    urlParam.getType().hasName("String") and
    urlArg = urlParam.getAnAccess() and
    (
      redirectCall.getMethod().getName() = "ModelAndView" and
      redirectCall.getMethod().getDeclaringType().hasQualifiedName("org.springframework.web.servlet", "ModelAndView") and
      redirectCall.getArgument(0) = urlArg
      or
      redirectCall.getMethod().getName() = "redirect" and
      redirectCall.getMethod().getDeclaringType().hasQualifiedName("org.springframework.web.servlet.mvc.method.annotation", "RedirectAttributes") and
      redirectCall.getArgument(0) = urlArg
    )
  ) and
  not exists(Annotation valid |
    valid.getType().hasQualifiedName(["javax.validation", "org.springframework.validation.annotation"], ["Valid", "Validated"]) and
    valid.getAnnotatedElement() = urlArg
  )
}

from Expr urlArg, MethodAccess redirectCall
where isUnvalidatedRedirect(urlArg, redirectCall)
select redirectCall, "Potential unvalidated redirect from user input. $@",
  urlArg, "This URL parameter is not validated"