/**
 * @name Use of SHA1
 * @description Detected SHA1 hash algorithm which is considered insecure. SHA1 is not collision resistant and is therefore not suitable as a cryptographic signature. Instead, use PBKDF2 for password hashing or SHA256 or SHA512 for other hash function applications.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-sha1
 * @tags security
 *   owasp: a03:2017
 *   owasp: a02:2021
 *   cwe: 328
 *   asvs: V6.2.5
 *   external/crypto/cwe-328
 */

import java

predicate isSha1Algorithm(Expr algo) {
  exists(StringLiteral sl | 
    sl = algo and 
    (sl.getValue().matches("SHA1") or sl.getValue().matches("SHA-1"))
  )
}

from MethodAccess ma
where
  (
    // Case 1: MessageDigest.getInstance() with SHA1/SHA-1
    ma.getMethod().hasName("getInstance") and
    ma.getMethod().getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
    isSha1Algorithm(ma.getArgument(0))
  )
  or
  (
    // Case 2: Direct usage of getSha1Digest()
    ma.getMethod().hasName("getSha1Digest") and
    exists(MethodAccess digestCall | 
      digestCall.getMethod().hasName("digest") and
      digestCall.getQualifier() = ma
    )
  )
select ma, "Use of insecure SHA1 hash algorithm. Consider using stronger alternatives like SHA256 or SHA512."