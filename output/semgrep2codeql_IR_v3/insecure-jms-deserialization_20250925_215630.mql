/**
 * @name Insecure JMS Deserialization
 * @description JMS Object messages depend on Java Serialization for marshalling/unmarshalling of the message payload when ObjectMessage.getObject() is called.
 * @kind problem
 * @problem.severity warning
 * @id java/insecure-jms-deserialization
 * @tags security
 *       cwe/502
 *       owasp-a08
 *       asvs/V5.5.3
 * @security-severity 7.5
 */

import java
import semmle.code.java.dataflow.FlowSources

class JMSListener extends Class {
  JMSListener() {
    this.getASupertype*().hasQualifiedName("javax.jms", "MessageListener")
  }
}

class GetObjectCall extends MethodAccess {
  GetObjectCall() {
    exists(Method m | 
      m.hasName("getObject") and
      this.getMethod() = m and
      m.getDeclaringType().getASupertype*().hasQualifiedName("javax.jms", "ObjectMessage")
    )
  }
}

from 
  Method onMessageMethod, MethodAccess getObjectCall, Class listenerClass
where 
  listenerClass instanceof JMSListener and
  onMessageMethod.getName() = "onMessage" and
  onMessageMethod.getDeclaringType() = listenerClass and
  getObjectCall instanceof GetObjectCall and
  getObjectCall.getEnclosingCallable() = onMessageMethod
select getObjectCall, 
  "JMS ObjectMessage.getObject() call in MessageListener.onMessage() may lead to insecure deserialization. " +
  "Deserialization of untrusted data can lead to arbitrary code execution."