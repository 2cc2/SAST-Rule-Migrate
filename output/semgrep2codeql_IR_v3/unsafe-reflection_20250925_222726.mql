/**
 * @name Unsafe Reflection
 * @description Detects unsafe use of reflection where attacker-controlled input
 *              may determine which class to instantiate or method to invoke.
 * @kind problem
 * @problem.severity warning
 * @id java/unsafe-reflection
 * @tags security
 *       external/cwe/cwe-470
 *       owasp-a03
 */
import java

predicate isStringLiteral(Expr e) {
  exists(StringLiteral s | e = s)
}

from MethodAccess ma, Expr className
where
  ma.getMethod().hasName("forName") and
  ma.getMethod().getDeclaringType().hasQualifiedName("java.lang", "Class") and
  className = ma.getArgument(0) and
  not isStringLiteral(className)
select ma, "Unsafe reflection using non-literal class name. Attackers may control which class is loaded, potentially bypassing security checks."