/**
 * @name JWT Decode Without Verify
 * @description Detected the decoding of a JWT token without a verify step. JWT tokens must be verified before use, otherwise the token's integrity is unknown.
 * @kind problem
 * @problem.severity warning
 * @id java/jwt-decode-without-verify
 * @tags security
 *       external/cwe/cwe-345
 *       external/owasp/a08
 *       external/jwt
 */
import java

from MethodAccess decodeCall
where
  decodeCall.getMethod().hasName("decode") and
  decodeCall.getMethod().getDeclaringType().hasQualifiedName("com.auth0.jwt", "JWT") and
  not exists(
    MethodAccess verifyCall |
    verifyCall.getMethod().hasName("verify") and
    verifyCall.getEnclosingCallable() = decodeCall.getEnclosingCallable()
  )
select decodeCall, "JWT tokens must be verified before use. Call '.verify()' after decoding to ensure token integrity."