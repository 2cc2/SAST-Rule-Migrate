/**
 * @name No Null Cipher
 * @description Detects usage of NullCipher which provides no encryption.
 * @kind problem
 * @problem.severity warning
 * @id java/no-null-cipher
 * @tags security
 *       cwe/327
 *       owasp/a03
 *       owasp/a02
 * @precision high
 */

import java

// Detects direct instantiation of NullCipher
from ConstructorCall c
where 
  c.getConstructedType().hasQualifiedName("javax.crypto", "NullCipher")
select c, "NullCipher was detected. This will not encrypt anything; the cipher text will be the same as the plain text. Use a valid, secure cipher: Cipher.getInstance(\"AES/CBC/PKCS7PADDING\"). See https://owasp.org/www-community/Using_the_Java_Cryptographic_Extensions for more information."