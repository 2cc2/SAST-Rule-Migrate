/**
 * @name ECB Cipher Detection
 * @description Detects usage of Cipher in ECB mode which is insecure as it produces the same output
 *              for the same input each time, allowing replay attacks and lacks integrity checking.
 * @kind problem
 * @problem.severity warning
 * @id java/ecb-cipher
 * @tags security
 *       vulnerability
 *       owasp-a03
 *       owasp-a02
 *       cwe-327
 */
import java

from MethodAccess ma, Expr modeArg, string modeValue
where
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
  modeArg = ma.getArgument(0) and
  modeValue = modeArg.(StringLiteral).getValue() and
  modeValue.regexpMatch(".*ECB.*")
select ma, "Cipher in ECB mode is detected. ECB mode produces the same output for the same input each time which allows an attacker to intercept and replay the data. Further, ECB mode does not provide any integrity checking."