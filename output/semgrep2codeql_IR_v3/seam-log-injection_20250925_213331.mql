/**
 * @name Seam Log Injection
 * @description Seam Logging API supports expression language to introduce bean property to log messages.
 *              The expression language can also be source of unwanted code execution when dynamic values
 *              are used without proper validation.
 * @kind path-problem
 * @problem.severity error
 * @precision low
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 *       external/jboss
 *       audit
 */
import java
import semmle.code.java.dataflow.TaintTracking

class SeamLogMethod extends Method {
  SeamLogMethod() {
    this.getName() in ["debug", "error", "fatal", "info", "trace", "warn"] and
    this.getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log")
  }
}

class SeamLogSink extends DataFlow::Node {
  SeamLogSink() {
    exists(MethodAccess ma |
      ma.getMethod() instanceof SeamLogMethod and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

class SeamLogSource extends DataFlow::Node {
  SeamLogSource() {
    exists(MethodAccess ma |
      ma.getMethod() instanceof SeamLogMethod and
      this.asExpr() = ma.getQualifier()
    )
  }
}

from DataFlow::Node source, DataFlow::Node sink
where TaintTracking::localTaint(source, sink)
select sink, "Potential Seam Log Injection vulnerability. User input in log messages may lead to code execution."