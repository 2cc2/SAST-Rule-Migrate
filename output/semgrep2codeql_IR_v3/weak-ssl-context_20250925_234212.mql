/**
 * @name Weak SSL Context
 * @description Detects insecure SSL context usage. TLS versions 1.0, 1.1, and all SSL versions are considered weak encryption and are deprecated.
 * @kind problem
 * @problem.severity warning
 * @id java/weak-ssl-context
 * @tags security
 *       external/cwe/cwe-326
 *       owasp-a03:2017
 *       owasp-a02:2021
 */
import java

from MethodAccess ma
where
  ma.getMethod().getName() = "getInstance" and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.net.ssl", "SSLContext") and
  not ma.getArgument(0).toString().matches("\"TLSv1.2\"") and
  not ma.getArgument(0).toString().matches("\"TLSv1.3\"")
select ma, "An insecure SSL context was detected. TLS versions 1.0, 1.1, and all SSL versions are considered weak encryption and are deprecated. Use SSLContext.getInstance(\"TLSv1.2\") for the best security."