/**
 * @name Use SnakeYAML Safe Constructor
 * @description Detects usage of SnakeYAML org.yaml.snakeyaml.Yaml() constructor with no arguments,
 *              which is vulnerable to deserialization attacks. Use the one-argument Yaml(...) 
 *              constructor instead, with SafeConstructor or a custom Constructor as the argument.
 * @kind problem
 * @problem.severity warning
 * @id java/use-snakeyaml-constructor
 * @tags security
 *       external/cwe/cwe-502
 *       external/owasp/a08:2017
 *       external/owasp/a08:2021
 *       external/cwe2021-top25
 *       external/cwe2022-top25
 */
import java

from Constructor c, MethodAccess ma
where
  // Match Yaml() constructor with no arguments
  c.getDeclaringType().hasQualifiedName("org.yaml.snakeyaml", "Yaml") and
  c.getNumberOfParameters() = 0 and
  // Find load() method calls on the constructed object
  ma.getMethod().hasName("load") and
  ma.getQualifier().getType() = c.getDeclaringType() and
  ma.getMethod().getDeclaringType().hasQualifiedName("org.yaml.snakeyaml", "Yaml")
select c, "Used SnakeYAML org.yaml.snakeyaml.Yaml() constructor with no arguments, " +
  "which is vulnerable to deserialization attacks. Use the one-argument Yaml(...) " +
  "constructor instead, with SafeConstructor or a custom Constructor as the argument."