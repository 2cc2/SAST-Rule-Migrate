/**
 * @name Spring Boot Actuator Fully Enabled
 * @description Spring Boot Actuator is fully enabled. This exposes sensitive endpoints such as /actuator/env,
 *              /actuator/logfile, /actuator/heapdump and others. Unless you have Spring Security enabled or
 *              another means to protect these endpoints, this functionality is available without authentication,
 *              causing a severe security risk.
 * @kind problem
 * @problem.severity warning
 * @id spring-actuator-fully-enabled-yaml
 * @tags security
 *       external/cwe/cwe-200
 *       external/owasp/a01
 *       cwe2021-top25
 * @precision medium
 * @security-severity 8.0
 */
import java

from SpringBootActuatorConfig config
where config.hasWildcardExposure()
select config, "Spring Boot Actuator is fully enabled with wildcard endpoint exposure. This exposes sensitive " +
  "endpoints without authentication, causing a severe security risk."

class SpringBootActuatorConfig extends RefType {
  SpringBootActuatorConfig() {
    this.hasQualifiedName("org.springframework.boot.actuate.autoconfigure", "EndpointAutoConfiguration") or
    this.hasQualifiedName("org.springframework.boot.actuate.autoconfigure.endpoint.web", "WebEndpointAutoConfiguration")
  }

  predicate hasWildcardExposure() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("expose") and
      ma.getMethod().getDeclaringType() = this and
      ma.getArgument(0).toString() = "\"*\""
    )
  }
}