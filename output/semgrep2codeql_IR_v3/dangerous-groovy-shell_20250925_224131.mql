/**
 * @name Dangerous Groovy Shell Usage
 * @description Detects unsafe usage of GroovyShell or GroovyClassLoader methods that could lead to code injection.
 * @kind problem
 * @problem.severity warning
 * @id java/dangerous-groovy-shell
 * @tags security
 *       external/cwe/cwe-94
 *       external/owasp/a03
 *       cwe2022-top25
 * @security-severity 4.3
 */

import java

// Define the dangerous method calls
predicate isDangerousMethodCall(MethodAccess ma) {
  exists(Method m | 
    ma.getMethod() = m and
    (
      m.getName() = "parse" or
      m.getName() = "evaluate" or
      m.getName() = "parseClass"
    ) and
    m.getDeclaringType().hasQualifiedName("groovy.lang", "GroovyShell") or
    m.getDeclaringType().hasQualifiedName("groovy.lang", "GroovyClassLoader")
  )
}

// Check if the argument is not a string literal
predicate isNotStringLiteral(Expr arg) {
  not arg instanceof StringLiteral
}

// Main query
from MethodAccess ma, Expr arg
where
  isDangerousMethodCall(ma) and
  arg = ma.getArgument(0) and
  isNotStringLiteral(arg)
select ma, "A expression is built with a dynamic value. The source of the value(s) should be verified to avoid that unfiltered values fall into this risky code evaluation."