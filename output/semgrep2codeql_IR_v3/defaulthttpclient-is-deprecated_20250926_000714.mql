/**
 * @name DefaultHttpClient is deprecated
 * @description Using DefaultHttpClient is deprecated and poses a security risk as it doesn't support TLS 1.2 connections.
 * @kind problem
 * @problem.severity warning
 * @id java/defaulthttpclient-is-deprecated
 * @tags security
 *   external/cwe/cwe-326
 *   external/owasp/a03:2017
 *   external/owasp/a02:2021
 *   external/asvs/v9.1.3
 */
import java

from ConstructorCall call
where call.getConstructedType().hasQualifiedName("org.apache.http.impl.client", "DefaultHttpClient")
select call, 
  "DefaultHttpClient is deprecated. Further, it does not support connections using TLS1.2, which makes using DefaultHttpClient a security hazard. Use HttpClientBuilder instead."