/**
 * @name No JSP Scriptlets
 * @description Detects JSP scriptlets which are considered bad practice.
 *              Recommend migrating to JSF or using Expression Language '${...}' with escapeXml function.
 * @kind problem
 * @problem.severity warning
 * @id java/no-scriptlets
 * @tags security
 *       correctness
 */

import java

from Literal literal, File jspFile
where 
  // Source: JSP scriptlet detection
  literal.getValue().toString().matches("%<%[^@].*") and
  // Sink: JSP file extension check
  jspFile.getBaseName().matches(".*\\.jsp$") and
  // Flow: the literal is contained in the JSP file
  jspFile = literal.getFile()
select literal, "JSP scriptlet detected. Consider migrating to JSF or using Expression Language instead."