/**
 * @name JDBC SQL Injection
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 *              Use prepared statements (java.sql.PreparedStatement) instead.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jdbc-sqli
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow

class SqlStringFormatSource extends DataFlow::ExprNode {
  SqlStringFormatSource() {
    exists(Method m |
      m.hasName("format") and
      m.getDeclaringType().hasQualifiedName("java.lang", "String") and
      exists(MethodAccess ma | ma.getMethod() = m and this.asExpr() = ma)
    )
  }
}

class SqlStringConcatSource extends DataFlow::ExprNode {
  SqlStringConcatSource() {
    exists(AddExpr add |
      add.getLeftOperand().getType() instanceof TypeString and
      this.asExpr() = add
    )
  }
}

class SqlExecutionSink extends DataFlow::ExprNode {
  SqlExecutionSink() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("java.sql", "Statement") and
      m.getName() in ["executeQuery", "execute", "executeUpdate", 
                     "executeLargeUpdate", "addBatch", "nativeSQL"] and
      exists(MethodAccess ma | ma.getMethod() = m and this.asExpr() = ma.getArgument(0))
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::ExprNode {
  PreparedStatementSanitizer() {
    exists(Method m |
      m.hasName("prepareStatement") and
      m.getDeclaringType().hasQualifiedName("java.sql", "Connection") and
      exists(MethodAccess ma | ma.getMethod() = m and this.asExpr() = ma)
    )
  }
}

class SqlInjectionConfig extends TaintTracking::Configuration {
  SqlInjectionConfig() { this = "SqlInjectionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SqlStringFormatSource or
    source instanceof SqlStringConcatSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }

  override predicate isSanitizer(DataFlow::Node node) {
    node instanceof PreparedStatementSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, SqlInjectionConfig config
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Possible SQL injection from string formatting/concat to SQL execution"