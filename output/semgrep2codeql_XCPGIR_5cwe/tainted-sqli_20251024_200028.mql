/**
 * @name Tainted SQL Injection in AWS Lambda
 * @description Detected SQL statement that is tainted by user input. This could lead to SQL injection if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sqli
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking

predicate isLambdaInput(Parameter p) {
  exists(Method m |
    (
      m.hasName("handleRequest") and
      (m.getParameter(0) = p or m.getParameter(1) = p) and
      p.getType().toString().matches("%InputStream%|%Event%")
    )
    or
    (
      p.getCallable().getDeclaringType().getASupertype*().hasQualifiedName(
        "com.amazonaws.services.lambda.runtime",
        "RequestHandler"
      ) and
      m.getParameter(0) = p
    )
  )
}

class LambdaInput extends DataFlow::Node {
  LambdaInput() {
    exists(Parameter p | isLambdaInput(p) | this.asParameter() = p)
  }
}

class SqlExecutionSink extends DataFlow::Node {
  SqlExecutionSink() {
    exists(Method m, Call c |
      (
        (
          m.hasName("execute") and
          m.getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Statement")
        )
        or
        (
          m.hasName("executeQuery") and
          m.getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "Statement")
        )
        or
        (
          m.hasName("queryFor%") and
          m.getDeclaringType().getASupertype*().hasQualifiedName("org.springframework.jdbc.core", "JdbcTemplate")
        )
      ) and
      c.getCallee() = m and
      this.asExpr() = c.getArgument(0)
    )
  }
}

class PreparedStatementSanitizer extends DataFlow::Node {
  PreparedStatementSanitizer() {
    exists(Method m, Call c |
      m.getDeclaringType().getASupertype*().hasQualifiedName("java.sql", "PreparedStatement") and
      m.hasName("set%") and
      c.getCallee() = m and
      this.asExpr() = c
    )
  }
}

class TaintedSqlQueryConfiguration extends TaintTracking::Configuration {
  TaintedSqlQueryConfiguration() { this = "TaintedSqlQueryConfiguration" }
  
  override predicate isSource(DataFlow::Node source) {
    source instanceof LambdaInput
  }
  
  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SqlExecutionSink
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof PreparedStatementSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedSqlQueryConfiguration cfg
where cfg.hasFlowPath(source, sink)
select sink, "Potential SQL injection vulnerability from Lambda input to SQL execution", source, sink,
  "User input flows into SQL statement without proper sanitization"