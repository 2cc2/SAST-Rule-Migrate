/**
 * @name autoescape-disabled
 * @description Detected an element with disabled HTML escaping. If external data can reach this, this is a cross-site scripting (XSS) vulnerability.
 * @kind problem
 * @problem.severity warning
 * @id js/autoescape-disabled
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

from Expr expr, string pattern
where 
  pattern = ".*escape.*?=.*?false.*" and
  expr.toString().matches(pattern)
select expr, "Ensure no external data can reach here, or remove 'escape=false' from this element."