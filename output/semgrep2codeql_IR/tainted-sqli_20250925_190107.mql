/**
 * @name Tainted SQL from AWS Lambda Event
 * @description Detected SQL statement that is tainted by AWS Lambda event object.
 *              This could lead to SQL injection if variables are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-sql-from-lambda-event
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 *       external/aws-lambda
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class LambdaEventSource extends DataFlow::Node {
  LambdaEventSource() {
    exists(Method m | 
      (m.getName().matches("handleRequest%") and
       (m.getParameter(0).getType().hasName("InputStream") or
        m.getParameter(0).getType().hasName("APIGatewayProxyRequestEvent") or
        m.getParameter(0).getType().hasName("SQSEvent") or
        m.getParameter(0).getType().hasName("DynamodbEvent"))) and
      this.asParameter() = m.getParameter(0)
    )
  }
}

class SqlSink extends DataFlow::Node {
  SqlSink() {
    exists(MethodAccess ma |
      (ma.getCallee().getDeclaringType().hasQualifiedName("java.sql", "Statement") or
       ma.getCallee().getDeclaringType().hasQualifiedName("java.sql", "PreparedStatement") or
       ma.getCallee().getDeclaringType().hasQualifiedName("java.sql", "CallableStatement") or
       ma.getCallee().getDeclaringType().hasQualifiedName("java.util", "Map") or
       ma.getCallee().getDeclaringType().hasQualifiedName("org.springframework.jdbc.support.rowset", "SqlRowSet")) and
      this.asExpr() = ma.getAnArgument()
    )
    or
    exists(MethodAccess ma |
      (ma.getCallee().getName().matches("execute%") or
       ma.getCallee().getName() = "query" or
       ma.getCallee().getName() = "executeUpdate" or
       ma.getCallee().getName() = "batchUpdate") and
      exists(StringLiteral sql | 
        sql.getValue().matches("(?i)(SELECT.*|INSERT.*|UPDATE.*)") and
        ma.getAnArgument() = sql and
        this.asExpr() = sql
      )
    )
  }
}

class LambdaSqlTaintConfig extends TaintTracking::Configuration {
  LambdaSqlTaintConfig() { this = "LambdaSqlTaintConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof LambdaEventSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SqlSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from LambdaSqlTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential SQL injection from untrusted AWS Lambda event input"