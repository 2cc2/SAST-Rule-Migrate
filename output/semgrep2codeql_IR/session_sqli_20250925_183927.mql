/**
 * @name SQL query constructed via string concatenation
 * @description Detected string parameter used to construct SQL query via concatenation.
 *              This could lead to SQL injection if variables are not properly sanitized.
 * @kind path-problem
 * @problem.severity error
 * @id java/find-sql-string-concatenation
 * @tags security
 *       external/cwe/cwe-89
 *       external/owasp/a01
 *       external/owasp/a03
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class StringParameterSource extends DataFlow::Node {
  StringParameterSource() {
    exists(Parameter p |
      p.getType().hasName("String") and
      this.asParameter() = p
    )
  }
}

class PreparedStatementSink extends DataFlow::Node {
  PreparedStatementSink() {
    exists(MethodAccess ma |
      ma.getCallee().getDeclaringType().hasQualifiedName("javax.sql", "Session") and
      ma.getCallee().getName() = "prepareStatement" and
      this.asExpr() = ma.getArgument(0) and
      exists(StringParameterSource source |
        this.asExpr().toString().matches(source.asParameter().getName())
      )
    )
  }
}

class SqlConcatenationConfig extends TaintTracking::Configuration {
  SqlConcatenationConfig() { this = "SqlConcatenationConfig" }

  override predicate isSource(DataFlow::Node source) { 
    source instanceof StringParameterSource 
  }

  override predicate isSink(DataFlow::Node sink) { 
    sink instanceof PreparedStatementSink 
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from SqlConcatenationConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "In " + source.getNode().asParameter().getCallable().getName() + 
  ", " + source.getNode().asParameter().getName() + 
  " is used to construct a SQL query via string concatenation"