/**
 * @name JWT None Algorithm Usage
 * @description Detected use of the 'none' algorithm in a JWT token. The 'none' algorithm assumes the integrity of the token has already been verified. This would allow a malicious actor to forge a JWT token that will automatically be verified.
 * @kind problem
 * @problem.severity error
 * @id java/jjwt-none-alg
 * @tags security
 *       external/cwe/cwe-327
 *       external/owasp/a03
 *       external/owasp/a02
 *       external/asvs/v3/3.5.3
 */

import java
import semmle.code.java.dataflow.DataFlow

class JwtBuilder extends DataFlow::Node {
  JwtBuilder() {
    exists(MethodAccess ma |
      ma.getCallee().getName() = "builder" and
      ma.getCallee().getDeclaringType().hasQualifiedName("io.jsonwebtoken", "Jwts") and
      this.asExpr() = ma
    )
  }
}

class JwtSignWith extends DataFlow::Node {
  JwtSignWith() {
    exists(MethodAccess ma |
      ma.getCallee().getName() = "signWith" and
      ma.getCallee().getDeclaringType().hasQualifiedName("io.jsonwebtoken", "JwtBuilder") and
      this.asExpr() = ma
    )
  }
}

class JwtNoneAlgorithm extends DataFlow::Node {
  JwtNoneAlgorithm() {
    exists(MethodAccess ma |
      ma.getCallee().getName() = "setSigningKey" and
      ma.getCallee().getDeclaringType().hasQualifiedName("io.jsonwebtoken", "JwtBuilder") and
      ma.getAnArgument().toString().matches("%none%") and
      this.asExpr() = ma
    )
  }
}

predicate isJwtBuilderWithoutSignWith(DataFlow::Node node) {
  exists(Method m |
    m.getDeclaringType().hasQualifiedName("io.jsonwebtoken", "JwtBuilder") and
    not exists(MethodAccess ma | ma.getCallee() = m and ma.getCallee().getName() = "signWith") and
    node.asExpr().getEnclosingCallable() = m
  )
}

from JwtBuilder builder, JwtNoneAlgorithm noneAlg
where DataFlow::localFlow(builder, noneAlg)
  and not exists(JwtSignWith signWith | DataFlow::localFlow(builder, signWith))
select noneAlg, "Detected use of the 'none' algorithm in a JWT token. The 'none' algorithm assumes the integrity of the token has already been verified. This would allow a malicious actor to forge a JWT token that will automatically be verified. Do not explicitly use the 'none' algorithm. Instead, use an algorithm such as 'HS256'."