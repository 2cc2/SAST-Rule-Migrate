/**
 * @name Insecure Cookie Configuration
 * @description Default session middleware settings: `setSecure` not set to true. 
 *              This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks.
 * @kind problem
 * @id java/cookie-issecure-false
 * @security-severity 7.5
 * @tags security
 *       external/cwe/cwe-614
 */

import java

// Find Cookie constructor calls
class CookieConstructor extends MethodAccess {
  CookieConstructor() {
    this.getMethod().hasName("<init>") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
  }
}

// Find insecure setSecure(false) calls
class InsecureSetSecureCall extends MethodAccess {
  InsecureSetSecureCall() {
    this.getMethod().hasName("setSecure") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    exists(Literal arg | arg = this.getAnArgument() | arg.getValue().toString() = "false")
  }
}

// Find secure setSecure(true) calls
class SecureSetSecureCall extends MethodAccess {
  SecureSetSecureCall() {
    this.getMethod().hasName("setSecure") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
    exists(Literal arg | arg = this.getAnArgument() | arg.getValue().toString() = "true")
  }
}

from CookieConstructor cc, InsecureSetSecureCall issc
where
  issc.getQualifier() = cc and
  not exists(SecureSetSecureCall sssc |
    sssc.getQualifier() = cc and
    sssc.getEnclosingCallable() = issc.getEnclosingCallable()
  )
select issc, 
  "Default session middleware settings: `setSecure` not set to true. " +
  "This ensures that the cookie is sent only over HTTPS to prevent cross-site scripting attacks."