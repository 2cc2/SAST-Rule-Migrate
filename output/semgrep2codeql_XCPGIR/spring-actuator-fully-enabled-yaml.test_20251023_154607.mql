/**
 * @name Spring Actuator endpoints are fully exposed via wildcard inclusion
 * @description Detects when Spring Actuator endpoints are exposed via wildcard inclusion pattern
 * @kind problem
 * @id java/spring-actuator-fully-enabled
 * @security-severity 8.0
 * @tags security
 *       spring
 */

import java

predicate isActuatorConfig(MethodAccess ma) {
  ma.getMethod().getName() = "setProperty" and
  ma.getArgument(0).(CompileTimeConstantExpr).getStringValue() = "management.endpoints.web.exposure.include"
}

predicate hasWildcardValue(MethodAccess ma) {
  exists(Expr arg |
    arg = ma.getArgument(1) and
    arg.(CompileTimeConstantExpr).getStringValue() = "*"
  )
}

from MethodAccess configCall, FieldAccess exposureField
where 
  isActuatorConfig(configCall) and
  hasWildcardValue(configCall) and
  exposureField.getField().getName() = "include" and
  configCall.getEnclosingCallable() = exposureField.getEnclosingCallable()
select exposureField, "Actuator endpoints exposed with wildcard inclusion pattern"