/**
 * @name HTTP Response Splitting Vulnerability
 * @description Older Java application servers are vulnerable to HTTP response splitting, which may occur if an HTTP request 
 *              can be injected with CRLF characters.
 * @kind path-problem 
 * @problem.severity warning
 * @security-severity 8.8
 * @id java/http-response-splitting
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.DataFlow

class HttpServletRequestGetParameter extends Method {
  HttpServletRequestGetParameter() {
    this.getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet", "ServletRequest") and
    this.hasName("getParameter")
  }
}

class CookieConstructor extends Constructor {
  CookieConstructor() { 
    this.getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie")
  }
}

class HttpServletResponseAddCookie extends Method {
  HttpServletResponseAddCookie() {
    this.getDeclaringType().getASupertype*().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
    this.hasName("addCookie")
  }
}

class UserInputSource extends DataFlow::Node {
  UserInputSource() {
    exists(MethodAccess ma |
      ma.getMethod() instanceof HttpServletRequestGetParameter and
      this.asExpr() = ma.getArgument(0)
    )
    or
    exists(Parameter p |
      p.getAnAnnotation().getType().hasQualifiedName("org.springframework.web.bind.annotation", "PathVariable") and
      this.asParameter() = p
    )
  }
} 

class CookieSink extends DataFlow::Node {
  CookieSink() {
    exists(ConstructorCall cc | 
      cc.getConstructor() instanceof CookieConstructor and
      this.asExpr() = cc.getArgument(1)
    )
    or
    exists(MethodAccess ma |
      ma.getMethod() instanceof HttpServletResponseAddCookie and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class CookieTaintConfig extends TaintTracking::Configuration {
  CookieTaintConfig() {
    this = "CookieTaintConfig"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof UserInputSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof CookieSink
  }
}

from CookieTaintConfig cfg, DataFlow::Node source, DataFlow::Node sink
where cfg.hasFlow(source, sink)
select sink, "Potential HTTP Response Splitting vulnerability via unvalidated user input in cookie",
  source, "User input from $@ flows to cookie creation here",
  source, "this user input"