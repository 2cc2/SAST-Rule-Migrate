/**
 * @name Bad Hexadecimal Conversion
 * @description "'Integer.toHexString()' strips leading zeroes from each byte if read byte-by-byte. This mistake weakens the hash value computed since..."
 * @kind problem
 * @id java/bad-hexa-conversion
 * @severity Warning
 * @tags security
 */

import java
import semmle.code.java.dataflow.FlowSources
import DataFlow::PathGraph

class HexConversionCall extends MethodAccess {
  HexConversionCall() {
    exists(Method m | 
      m.getDeclaringType().hasQualifiedName("java.lang", "Integer") and
      m.hasName("toHexString") and 
      this.getMethod() = m
    )
  }
}

class DigestCall extends MethodAccess {
  DigestCall() {
    exists(Method m |
      m.getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
      m.hasName("digest") and
      this.getMethod() = m
    )
  }
}

class Config extends TaintTracking::Configuration {
  Config() { this = "BadHexConversionConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(HexConversionCall hcc | source.asExpr() = hcc)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DigestCall dc | sink.asExpr() = dc)
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, Config config
where config.hasFlowPath(source, sink)
select sink.getNode(), 
  "Potential weak hash computation due to improper hex conversion. Use String.format(\"%02X\", ...) instead.",
  source.getNode(), "Improper hex conversion here"