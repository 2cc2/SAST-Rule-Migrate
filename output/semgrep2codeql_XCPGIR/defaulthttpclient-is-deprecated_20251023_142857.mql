/**
 * @name DefaultHttpClient is deprecated
 * @description DefaultHttpClient is deprecated and does not support TLS1.2, which poses security risks
 * @kind problem
 * @id java/defaulthttpclient-is-deprecated
 * @tags security
 *       deprecated
 */

import java

class DefaultHttpClient extends RefType {
  DefaultHttpClient() {
    this.hasQualifiedName("org.apache.http.impl.client", "DefaultHttpClient")
  }
}

from ConstructorCall cc, MethodAccess ma
where
  cc.getConstructedType() instanceof DefaultHttpClient and
  ma.getQualifier().getType() instanceof DefaultHttpClient
select ma, 
  "DefaultHttpClient is deprecated and poses security risks due to lack of TLS1.2 support. Use HttpClientBuilder instead."