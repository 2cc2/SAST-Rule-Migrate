/**
 * @name Unencrypted Socket Detection
 * @description Detected use of a Java socket that is not encrypted. Use SSLSocket instead.
 * @kind problem
 * @problem.severity warning
 * @id java/unencrypted-socket
 * @tags security
 */

import java

from ConstructorCall cc
where
  (cc.getConstructedType().hasQualifiedName("java.net", "Socket") or
   cc.getConstructedType().hasQualifiedName("java.net", "ServerSocket")) and
  not cc.getConstructedType().hasQualifiedName("javax.net.ssl", "SSLSocket") and
  not cc.getConstructedType().hasQualifiedName("javax.net.ssl", "SSLServerSocket")
select cc, "Use of unencrypted socket detected. Use SSLSocket created by SSLSocketFactory or SSLServerSocketFactory instead."