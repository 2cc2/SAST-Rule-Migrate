/**
 * @name Weak Random Number Generator Detection
 * @description Detects usage of non-cryptographically strong random number generators
 * @kind problem
 * @problem.severity warning
 * @id java/weak-random
 * @tags security
 */

import java

predicate isWeakRandomCall(Method m) {
  m.getDeclaringType().hasQualifiedName("java.util", "Random") or
  (m.getDeclaringType().hasQualifiedName("java.lang", "Math") and
   m.hasName("random"))
}

from MethodAccess ma
where isWeakRandomCall(ma.getMethod())
select ma, "Non-cryptographic RNG usage detected: " + 
  ma.getMethod().getDeclaringType().getName() + "." + ma.getMethod().getName() +
  ". Use java.security.SecureRandom instead for passwords or secret tokens."