/**
 * @name Tainted session from HTTP request
 * @description Detected input from a HTTPServletRequest going into a session command,
 *              like `setAttribute`. User input into such a command could lead to 
 *              an attacker inputting malicious code into session parameters,
 *              blurring the trust boundary.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id java/tainted-session-from-http-request
 * @tags security
 *       external/cwe/cwe-807
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class HttpRequestInput extends DataFlow::Node {
  HttpRequestInput() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
       (ma.getMethod().getName() = "getParameter" or ma.getMethod().getName() = "getHeaders")) or
      (ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
       ma.getMethod().getName() = "getValue") and
      this.asExpr() = ma
    )
  }
}

class SessionSink extends DataFlow::Node {
  SessionSink() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpSession") and
      (ma.getMethod().getName() = "setAttribute" or ma.getMethod().getName() = "putValue") and
      this.asExpr() = ma.getArgument(1)
    )
  }
}

class TaintedSessionConfig extends TaintTracking::Configuration {
  TaintedSessionConfig() { this = "TaintedSessionConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpRequestInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof SessionSink
  }
}

from TaintedSessionConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "User input from HTTP request reaches session attribute without sanitization",
  source.getNode(), sink.getNode(),
  "Potentially tainted data flows from $@ to session attribute $@ without sanitization",
  source.getNode(), "HTTP request parameter",
  sink.getNode(), "session attribute"