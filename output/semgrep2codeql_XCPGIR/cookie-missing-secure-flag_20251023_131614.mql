/**
 * @name Cookie missing secure flag
 * @description A cookie was detected without setting the 'secure' flag. The 'secure' flag for cookies prevents the client 
 *              from transmitting the cookie over insecure channels such as HTTP.
 * @kind path-problem
 * @problem.severity warning
 * @id java/cookie-missing-secure-flag
 * @tags security
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class InsecureCookieConfig extends TaintTracking::Configuration {
  InsecureCookieConfig() { this = "InsecureCookieConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("setSecure") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      ma.getArgument(0).(Literal).getValue().toString() = "false" and
      source.asExpr() = ma.getQualifier()
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("addCookie") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getMethod().hasName("setSecure") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "Cookie") and
      ma.getArgument(0).(Literal).getValue().toString() = "true" and
      sanitizer.asExpr() = ma.getQualifier()
    )
  }
}

from InsecureCookieConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "A cookie was detected without setting the 'secure' flag.", source, sink,
  "Unsecured cookie is transmitted via $@.", source, "this insecure cookie"