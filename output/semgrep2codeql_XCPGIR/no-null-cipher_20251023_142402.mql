/**
 * @name No Null Cipher
 * @description NullCipher was detected. This will not encrypt anything;
 *              the cipher text will be the same as the plain text.
 * @kind problem
 * @problem.severity warning
 * @id java/no-null-cipher
 * @tags security
 *       cryptography
 */

import java

// Detects construction of NullCipher instances
predicate isNullCipherConstructor(MethodAccess ma) {
  exists(Method m | ma.getMethod() = m |
    m.getDeclaringType().hasQualifiedName("javax.crypto", "NullCipher") and
    m.hasName("<init>")
  )
}

from MethodAccess ma
where isNullCipherConstructor(ma)
select ma, "NullCipher detected. This will not encrypt anything; the cipher text will be the same as the plain text. " +
  "Use a valid, secure cipher: Cipher.getInstance(\"AES/CBC/PKCS7PADDING\"). " +
  "See https://owasp.org/www-community/Using_the_Java_Cryptographic_Extensions for more information."