/**
 * @name JWT None Algorithm
 * @description Detects use of the 'none' algorithm in a JWT token.
 * @kind problem
 * @problem.severity error
 * @id java/jjwt-none-alg
 */

import java

predicate isJwtBuilderCall(MethodAccess ma) {
  exists(Method m | 
    m.getDeclaringType().hasQualifiedName("io.jsonwebtoken", "Jwts") and
    m.getName() = "builder" and
    ma.getMethod() = m
  )
}

predicate hasSignWithCall(MethodAccess builderCall) {
  exists(MethodAccess signWithCall |
    signWithCall.getMethod().getName() = "signWith" and
    signWithCall.getMethod().getDeclaringType().hasQualifiedName("io.jsonwebtoken", "Jwts") and
    exists(Expr parent |
      parent = builderCall.getParent*() and
      parent = signWithCall.getParent*()
    )
  )
}

from MethodAccess jwtBuilder
where 
  isJwtBuilderCall(jwtBuilder) and
  not hasSignWithCall(jwtBuilder)
select jwtBuilder, 
  "Detected use of the 'none' algorithm in a JWT token. The 'none' algorithm assumes the integrity of the token has already been verified. This would allow a malicious actor to forge a JWT token that will automatically be verified. Do not explicitly use the 'none' algorithm. Instead, use an algorithm such as 'HS256'."