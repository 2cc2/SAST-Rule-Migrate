/**
 * @name Use of default AES
 * @description Use of AES with no settings detected. By default, java.crypto.Cipher uses ECB mode.
 *              ECB doesn't provide message confidentiality and is not semantically secure so should not be used.
 *              Instead, use a strong, secure cipher: java.crypto.Cipher.getInstance("AES/CBC/PKCS7PADDING").
 * @kind problem
 * @id java/use-of-default-aes
 * @security-severity 7.5
 * @precision high
 */
import java

from MethodAccess ma
where 
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
  exists(Expr arg | arg = ma.getArgument(0) | 
    arg.(StringLiteral).getValue() = "AES"
  )
select ma, "Use of AES with no settings detected. Prefer secure cipher modes like AES/CBC/PKCS7PADDING instead."