/**
 * @name Spring JSP Evaluation
 * @description Spring expression is built with a dynamic value. The source of the value(s) should be
 *              verified to avoid that unfiltered values fall into this risky code evaluation.
 * @kind path-problem
 * @problem.severity warning
 * @id java/spring-jsp-eval
 * @tags security
 *       external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.spring.SpringController

class DynamicExprSource extends DataFlow::Node {
  DynamicExprSource() {
    exists(Literal l |
      l.getValue().regexpMatch("expression=.*") and
      this.asExpr() = l
    )
  }
}

class SpringEvalSink extends DataFlow::Node {
  SpringEvalSink() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("doStartTag") and
      ma.getMethod().getDeclaringType().hasQualifiedName("org.springframework.web.servlet.tags", "EvalTag") and
      this.asExpr() = ma
    )
  }
}

from DynamicExprSource source, SpringEvalSink sink
where DataFlow::localFlow(source, sink)
select sink, "Spring expression evaluation with dynamic input detected", source, sink