/**
 * @name CBC with PKCS5Padding Vulnerability
 * @description Using CBC with PKCS5Padding is susceptible to padding oracle attacks.
 *              A malicious actor could discern the difference between plaintext with valid or invalid padding.
 *              Further, CBC mode does not include any integrity checks.
 * @kind problem
 * @problem.severity warning
 * @id java/cbc-padding-oracle
 * @tags security
 *       external/cwe/cwe-327
 */

import java

class CBCPKCS5Padding extends MethodAccess {
  CBCPKCS5Padding() {
    exists(Method m | 
      m = this.getMethod() and
      m.hasName("getInstance") and
      m.getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
      this.getArgument(0).toString().matches("%CBC/PKCS5Padding%")
    )
  }
}

from CBCPKCS5Padding cipherInstance
select cipherInstance, 
  "Using CBC with PKCS5Padding is susceptible to padding oracle attacks. Use 'AES/GCM/NoPadding' instead."