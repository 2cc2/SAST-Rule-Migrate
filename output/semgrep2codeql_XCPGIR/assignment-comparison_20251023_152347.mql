/**
 * @name Assignment in conditional test
 * @description Detects assignment operations used in conditional tests where the value is ignored
 * @kind problem
 * @id java/assignment-comparison
 * @tags correctness
 */

import java

predicate isAssignmentInConditional(Expr assignment) {
  exists(IfStmt ifstmt |
    ifstmt.getCondition().(AssignExpr) = assignment
  )
}

from AssignExpr assign
where isAssignmentInConditional(assign)
select assign, "Assignment operation used in conditional test"