/**
 * @name String comparison with ==
 * @description Strings should not be compared with '=='. This is a reference comparison operator. Use '.equals()' instead.
 * @kind problem
 * @id no-string-eqeq
 * @severity warning
 * @tags correctness
 * @help-url https://stackoverflow.com/questions/513832/how-do-i-compare-strings-in-java
 */

import java

from BinaryExpr be
where be.getOp() = "==" and
      be.getLeftOperand().getType().hasName("String") and
      be.getRightOperand().getType().hasName("String")
select be, 
  "Strings should not be compared with '=='. This is a reference comparison operator. Use '.equals()' instead."