/**
 * @name SpEL Injection
 * @description Detects potential Spring Expression Language (SpEL) injection vulnerabilities
 * @id spel-injection
 * @kind path-problem
 * @severity Warning
 * @tags security
 *     external/cwe/cwe-094
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.Spring

class SpELConfig extends TaintTracking::Configuration {
  SpELConfig() { this = "SpEL Injection" }

  override predicate isSource(DataFlow::Node source) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("parseExpression") and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName(
        "org.springframework.expression", "ExpressionParser") and
      source.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("parseExpression") and
      ma.getMethod().getDeclaringType().getASupertype*().hasQualifiedName(
        "org.springframework.expression", "ExpressionParser") and
      sink.asExpr() = ma.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Literal l | sanitizer.asExpr() = l)
  }

  override predicate isAdditionalTaintStep(DataFlow::Node pred, DataFlow::Node succ) {
    exists(MethodAccess ma, Expr arg |
      ma.getMethod().getName().matches("parseExpression") and
      arg = ma.getArgument(0) and
      pred.asExpr() = arg and
      succ.asExpr() = arg
    )
  }
}

from SpELConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink, 
  "Potential SpEL injection vulnerability detected. The source of the value should be verified."