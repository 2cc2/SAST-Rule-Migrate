/**
 * @name RSA without OAEP mode
 * @description Using RSA without OAEP mode weakens the encryption.
 * @kind problem
 * @id java/rsa-no-padding
 * @severity Warning
 */

import java

predicate isRsaNoPaddingCipher(MethodAccess ma) {
  exists(Method m | 
    m = ma.getMethod() and
    m.hasName("getInstance") and
    m.getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
    ma.getArgument(0).(Literal).getValue().regexpMatch("RSA/[Nn][Oo][Nn][Ee]/NoPadding/")
  )
}

from MethodAccess ma
where isRsaNoPaddingCipher(ma)
select ma, "Using RSA without OAEP mode weakens the encryption."