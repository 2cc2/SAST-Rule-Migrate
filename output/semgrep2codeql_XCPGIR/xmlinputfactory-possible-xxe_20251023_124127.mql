/**
 * @name XMLInputFactory possible XXE
 * @description XML external entities are not explicitly disabled for this XMLInputFactory.
 *              This could be vulnerable to XML external entity vulnerabilities.
 * @kind path-problem
 * @id java/xmlinputfactory-possible-xxe
 * @security-severity 8.0
 * @problem.severity warning
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

predicate isXMLInputFactoryCreation(DataFlow::Node node) {
  exists(MethodAccess ma |
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
    ma.getMethod().getName() = "newFactory" and
    node.asExpr() = ma
  )
  or
  exists(ConstructorCall cc |
    cc.getConstructedType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
    node.asExpr() = cc
  )
}

predicate isXXESink(DataFlow::Node node) {
  exists(MethodAccess ma |
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
    ma.getMethod().getName() = "setProperty" and
    node.asExpr() = ma and
    not ma.getArgument(1).toString() = "false"
  )
}

predicate isDisableXXE(DataFlow::Node node) {
  exists(MethodAccess ma |
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
    ma.getMethod().getName() = "setProperty" and
    node.asExpr() = ma and
    ma.getArgument(1).toString() = "false"
  )
}

class XMLInputFactoryXXEConfig extends TaintTracking::Configuration {
  XMLInputFactoryXXEConfig() { this = "XMLInputFactoryXXE" }
  
  override predicate isSource(DataFlow::Node source) {
    isXMLInputFactoryCreation(source)
  }
  
  override predicate isSink(DataFlow::Node sink) {
    isXXESink(sink)
  }
  
  override predicate isSanitizer(DataFlow::Node sanitizer) {
    isDisableXXE(sanitizer)
  }
}

from XMLInputFactoryXXEConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Missing XML external entity protection"