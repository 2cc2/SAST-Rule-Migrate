/**
 * @name Use of MD5 DigestUtils
 * @description Detected MD5 hash algorithm which is considered insecure. MD5 is not collision resistant
 * and is therefore not suitable as a cryptographic signature. Use HMAC instead.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-md5-digest-utils
 * @tags security
 *       correctness
 */

import java

from Call call, Method method
where
  method.getDeclaringType().hasQualifiedName("org.apache.commons.codec.digest", "DigestUtils") and
  method.getName() = "digest" and
  call.getCallee() = method and
  exists(Method md5Method |
    md5Method.getDeclaringType() = method.getDeclaringType() and
    md5Method.getName() = "getMd5Digest" and
    call.getArgument(0).(Call).getCallee() = md5Method
  )
select call, "Detected MD5 hash algorithm which is considered insecure. MD5 is not collision resistant and is therefore not suitable as a cryptographic signature. Use HMAC instead."