/**
 * @name Server dangerous object deserialization
 * @description Using an arbitrary object with Java RMI is an insecure deserialization vulnerability.
 * @kind path-problem
 * @problem.severity error
 * @id java/server-dangerous-object-deserialization
 * @tags security
 */

import java
import semmle.code.java.dataflow.FlowSources

class RmiRemoteInterface extends Interface {
  RmiRemoteInterface() {
    this.getASupertype*() instanceof TypeRemote
  }
}

class RmiRemoteMethod extends Method {
  RmiRemoteMethod() {
    this.getDeclaringType() instanceof RmiRemoteInterface
  }
}

class UnsafeParameter extends Parameter {
  UnsafeParameter() {
    not (
      exists(PrimitiveType p | this.getType() = p) or
      this.getType().hasName(["String", "Boolean", "Byte", "Character", "Double", 
                             "Float", "Integer", "Long", "Short"])
    )
  }
}

class RmiDeserializationConfig extends TaintTracking::Configuration {
  RmiDeserializationConfig() { this = "RmiDeserializationConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(UnsafeParameter p | source.asParameter() = p)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(RmiRemoteMethod method |
      sink.asExpr() = method.getAParameter().getAnAccess()
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, RmiDeserializationConfig config
where config.hasFlowPath(source, sink)
select sink, 
  "Using an arbitrary object with Java RMI is an insecure deserialization vulnerability. " +
  "This object can be manipulated by a malicious actor allowing them to execute code on your system. " +
  "Instead, use an integer ID to look up your object, or consider alternative serialization schemes such as JSON.",
  source, sink