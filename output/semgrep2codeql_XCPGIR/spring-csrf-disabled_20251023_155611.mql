/**
 * @id spring-csrf-disabled
 * @name CSRF Protection Disabled
 * @description CSRF protection is disabled for this configuration. This is a security risk.
 * @kind problem
 * @severity warning
 * @tags security
 * @precision high
 */

import java
import semmle.code.java.frameworks.spring.Spring

predicate isCSRFDisableCall(MethodAccess ma) {
  ma.getMethod().getName() = "disable" and
  exists(Method m | m = ma.getMethod() | 
    m.getDeclaringType().getQualifiedName().matches("%.csrf.%")
  )
}

from MethodAccess ma
where isCSRFDisableCall(ma)
select ma, "CSRF protection is disabled for this configuration. This is a security risk."