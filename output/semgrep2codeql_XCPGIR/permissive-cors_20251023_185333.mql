/**
 * @name Permissive CORS Policy
 * @description Detects permissive CORS policy that allows wildcard or null origin
 * @kind problem
 * @id java/permissive-cors
 * @security-severity 7.5
 * @tags security
 *       external/cwe/cwe-942
 */

import java

predicate isCorsHeaderSetterCall(MethodAccess ma) {
  ma.getMethod().hasName(["access$0"]) or // Handle any generated access methods if needed
  exists(Method m |
    m = ma.getMethod() and
    (m.getName() = "addHeader" or
     m.getName() = "setHeader" or
     m.getName() = "header" or
     (m.getName() = "add" and m.getDeclaringType().getName().matches("%Headers")))
    and
    (m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") or
     m.getDeclaringType().hasQualifiedName("org.springframework.http", "ServerHttpResponse") or
     m.getDeclaringType().hasQualifiedName("org.springframework.http", "HttpHeaders") or
     m.getDeclaringType().hasQualifiedName("org.springframework.web.server", "ServerWebExchange") or
     m.getDeclaringType().hasQualifiedName("org.springframework.http", "ResponseEntity") or
     m.getDeclaringType().hasQualifiedName("org.springframework.web.reactive.function.server", "ServerResponse"))
  )
}

predicate isCorsHeaderName(Expr arg) {
  arg instanceof StringLiteral and
  arg.toString().toLowerCase().regexpMatch("access-control-allow-origin")
}

predicate isWildcardOrNull(Expr arg) {
  arg instanceof StringLiteral and
  (arg.toString().matches("*%") or arg.toString().matches("null"))
}

from MethodAccess ma, Expr headerArg, Expr valueArg
where
  isCorsHeaderSetterCall(ma) and
  headerArg = ma.getArgument(0) and
  valueArg = ma.getArgument(1) and
  isCorsHeaderName(headerArg) and
  isWildcardOrNull(valueArg)
select ma, "Permissive CORS policy detected with wildcard or null origin. This may allow malicious applications to communicate with the victim application, leading to spoofing, data theft, and other attacks."