/**
 * @name MD5 used as password hash
 * @description Detects when MD5 is used in password storage context
 * @kind problem
 * @problem.severity warning
 * @id java/md5-as-password
 */

import java
import semmle.code.java.dataflow.TaintTracking

class MD5HashConfig extends TaintTracking::Configuration {
  MD5HashConfig() { this = "MD5HashConfig" }
  
  override predicate isSource(DataFlow::Node source) {
    exists(Method m, Call call |
      m.hasName("getInstance") and
      m.getDeclaringType().hasQualifiedName("java.security", "MessageDigest") and
      call.getCallee() = m and
      call.getArgument(0).(StringLiteral).getValue().toUpperCase() = "MD5" and
      source.asExpr() = call
    )
  }
  
  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getName().matches("%password%") and
      sink.asExpr() = ma
    )
  }
}

from MD5HashConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), 
  "MD5 hash detected in password storage context. MD5 is not secure for passwords, use PBKDF2 or bcrypt instead.",
  source.getNode(), "Insecure MD5 hash created here",
  sink.getNode(), "Password storage method call here"