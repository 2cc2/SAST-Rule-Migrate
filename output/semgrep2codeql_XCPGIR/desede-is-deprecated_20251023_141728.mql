/**
 * @name DESede is deprecated
 * @description Triple DES (3DES or DESede) is considered deprecated. AES is the recommended cipher.
 * @kind problem
 * @problem.severity warning
 * @id java/desede-deprecated
 * @tags security
 */

import java

from MethodAccess ma, Method m
where 
  (m.getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and 
   m.getName() = "getInstance" and 
   ma.getMethod() = m and
   (
     ma.getArgument(0).(Literal).getValue().regexpMatch("DESede.*") or
     ma.getArgument(0).(Literal).getValue() = "DES"
   )
  )
select ma, "Triple DES (3DES or DESede) is considered deprecated. AES is the recommended cipher."