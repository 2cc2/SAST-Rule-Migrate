/**
 * @name Insecure XSSRequestWrapper Implementation
 * @description Detects usage of XSSRequestWrapper from dzone which has insecure XSS filtering that can be bypassed
 * @kind problem
 * @severity warning
 * @id java/xssrequestwrapper-is-insecure
 */

import java

from RefType wrapper, Method m, MethodAccess ma
where
  wrapper.getQualifiedName().matches("XSSRequestWrapper") and
  m.hasName("replaceAll") and
  ma.getMethod() = m and
  ma.getQualifier() instanceof StringLiteral and
  ma.getQualifier().(StringLiteral).getValue() = "</script>" and
  ma.getQualifier().getType() = wrapper
select ma, 
  "Insecure XSSRequestWrapper implementation detected. The XSS filtering in this code is not secure and can be bypassed by malicious actors. " +
  "It is recommended to use a stack that automatically escapes in your view or templates instead of filtering yourself."