/**
 * @name GCM IV/nonce reuse
 * @description Detects cases where GCM IV/nonce is reused, making encryption ineffective
 * @kind problem
 * @problem.severity error
 * @id java/gcm-nonce-reuse
 * @tags security
 *       correctness
 */

import java
import semmle.code.java.dataflow.DataFlow

class GCMNonceReuse extends DataFlow::Configuration {
  GCMNonceReuse() { this = "GCMNonceReuse" }

  override predicate isSource(DataFlow::Node source) {
    exists(Literal literal | 
      source.asExpr() = literal and
      literal.getValue().regexpMatch("\".*\"")
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto.spec", "GCMParameterSpec") and
      ma.getMethod().getName() = "<init>" and
      sink.asExpr() = ma.getArgument(1)
    )
  }
}

from GCMNonceReuse config, DataFlow::Node source, DataFlow::Node sink
where config.hasFlow(source, sink)
select sink, "GCM IV/nonce is reused: encryption can be totally useless"