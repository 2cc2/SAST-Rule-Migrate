/**
 * @name XMLDecoder deserialization of untrusted data
 * @description Using XMLDecoder to parse untrusted data may lead to arbitrary code execution.
 * @kind problem
 * @problem.severity warning
 * @id java/security/xmldecoder-untrusted-input
 * @tags security
 */

import java

class XMLDecoderConstructor extends Method {
  XMLDecoderConstructor() {
    this.getDeclaringType().hasQualifiedName("java.beans", "XMLDecoder") and
    this.hasName("<init>")
  }
}

class UntrustedInput extends Expr {
  UntrustedInput() {
    exists(MethodAccess ma |
      ma.getMethod() instanceof XMLDecoderConstructor and
      ma.getArgument(0) = this and
      not this instanceof StringLiteral
    )
  }
}

from MethodAccess ma, UntrustedInput source
where
  ma.getMethod() instanceof XMLDecoderConstructor and
  ma.getArgument(0) = source
select ma, "XMLDecoder should not be used to parse untrusted data. Deserializing user input can lead to arbitrary code execution."