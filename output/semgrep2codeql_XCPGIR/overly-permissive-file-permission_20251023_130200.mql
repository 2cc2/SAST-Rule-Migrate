/**
 * @name Overly Permissive File Permission
 * @description Detects file permissions that are overly permissive (read, write, and execute).
 * @kind problem
 * @problem.severity warning
 * @id java/overly-permissive-file-permission
 */

import java
import semmle.code.java.dataflow.TaintTracking

class OverlyPermissivePermission extends TaintTracking::Configuration {
  OverlyPermissivePermission() { this = "OverlyPermissivePermission" }

  override predicate isSource(DataFlow::Node source) { none() }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method m, MethodAccess ma, Expr permExpr |
      (
        // Sink 1: Files.setPosixFilePermissions with permissive permissions
        (
          m.hasName("setPosixFilePermissions") and
          m.getDeclaringType().hasQualifiedName("java.nio.file", "Files") and
          ma.getArgument(1) = permExpr and
          permExpr.toString().matches("%rwx%")  // Simplified pattern match
        )
        or
        // Sink 2: PosixFilePermissions.fromString with permissive permissions
        (
          m.hasName("fromString") and
          m.getDeclaringType().hasQualifiedName("java.nio.file.attribute", "PosixFilePermissions") and
          ma.getArgument(0) = permExpr and
          permExpr.toString().matches("%rwx%")  // Simplified pattern match
        )
        or
        // Sink 3: Set.add with OTHERS permissions
        (
          m.hasName("add") and
          m.getDeclaringType().hasQualifiedName("java.util", "Set") and
          ma.getArgument(0).getType().hasName("PosixFilePermission") and
          permExpr = ma.getArgument(0) and
          (
            permExpr.toString().matches("%OTHERS_READ%") or
            permExpr.toString().matches("%OTHERS_WRITE%") or
            permExpr.toString().matches("%OTHERS_EXECUTE%")
          )
        )
      ) and
      sink.asExpr() = ma
    )
  }
}

from DataFlow::Node sink, OverlyPermissivePermission config
where config.hasFlowTo(sink)
select sink, "Overly permissive file permission detected"