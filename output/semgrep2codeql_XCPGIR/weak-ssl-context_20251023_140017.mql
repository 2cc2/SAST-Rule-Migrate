/**
 * @name Weak SSL Context
 * @description Detects insecure SSL context usage. TLS versions 1.0, 1.1, and all SSL versions 
 *              are considered weak encryption and are deprecated.
 * @kind problem
 * @problem.severity warning
 * @id java/weak-ssl-context
 * @tags security
 *       deprecated
 */

import java

predicate isInsecureSSLProtocol(string protocol) {
  protocol = "TLS" or
  protocol = "SSLv3" or
  protocol = "SSLv2" or
  protocol = "SSLv3" or
  protocol = "TLSv1" or
  protocol = "TLSv1.1"
}

from MethodCall ma, StringLiteral arg0
where
  ma.getMethod().hasName("getInstance") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.net.ssl", "SSLContext") and
  arg0 = ma.getArgument(0) and
  isInsecureSSLProtocol(arg0.getValue())
select ma, 
  "An insecure SSL context was detected. TLS versions 1.0, 1.1, and all SSL versions are deprecated. Use SSLContext.getInstance(\"TLSv1.2\") or \"TLSv1.3\" for better security."