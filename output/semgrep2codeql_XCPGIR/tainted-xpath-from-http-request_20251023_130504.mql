/**
 * @name Tainted XPath from HTTP Request
 * @description Detected input from a HTTPServletRequest going into a XPath evaluate or compile
 *              command. This could lead to XPath injection if variables are not properly sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @security-severity 7.5
 * @precision high
 * @id java/tainted-xpath-from-http-request
 * @tags security
 *       external/cwe/cwe-643
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.Servlets

class HttpServletRequestInput extends DataFlow::Node {
  HttpServletRequestInput() {
    exists(MethodAccess ma |
      ma.getMethod().getDeclaringType() instanceof HttpServletRequest and
      this.asExpr() = ma
    )
  }
}

class XPathEvaluateSink extends DataFlow::Node {
  XPathEvaluateSink() {
    exists(MethodAccess ma |
      ma.getMethod().getName() = "evaluate" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.xpath", "XPath") and
      this.asExpr() = ma.getArgument(0)
    )
  }
}

class XPathCompileEvaluateSink extends DataFlow::Node {
  XPathCompileEvaluateSink() {
    exists(MethodAccess ma, MethodAccess eval |
      ma.getMethod().getName() = "compile" and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.xpath", "XPath") and
      eval.getMethod().getName() = "evaluate" and
      ma.getQualifier() = eval.getQualifier() and
      this.asExpr() = eval.getArgument(0)
    )
  }
}

class XPathTaintTrackingConfig extends TaintTracking::Configuration {
  XPathTaintTrackingConfig() { this = "XPathTaintTrackingConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpServletRequestInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof XPathEvaluateSink or
    sink instanceof XPathCompileEvaluateSink
  }
}

from XPathTaintTrackingConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, 
  "XPath injection from HTTP request input. $@",
  source, "User input flows here",
  sink, "to XPath evaluation here"