/**
 * @name DES is deprecated
 * @description Detects usage of deprecated DES cipher algorithm
 * @kind problem
 * @problem.severity warning
 * @id java/des-is-deprecated
 * @tags security
 *       deprecated
 */

import java

// Define source - DES cipher instantiation
predicate isDesCipherInstantiation(MethodAccess ma) {
  exists( |
    ma.getMethod().hasName("getInstance") and
    ma.getMethod().getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
    ma.getArgument(0).(StringLiteral).getValue().matches("^DES(/.*)?$")
  )
}

from MethodAccess ma
where isDesCipherInstantiation(ma)
select ma, "DES is considered deprecated. AES is the recommended cipher. Upgrade to use AES."