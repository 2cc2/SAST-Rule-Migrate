/**
 * @name DocumentBuilderFactory Disallow DocType Declaration Missing
 * @description DOCTYPE declarations are enabled for this DocumentBuilderFactory. This is vulnerable to XML 
 * external entity attacks. Disable this by setting the feature 'http://apache.org/xml/features/disallow-doctype-decl' to true.
 * @kind path-problem
 * @problem.severity error
 * @id java/documentbuilderfactory-disallow-doctype-decl-missing
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.dataflow.FlowSources

class DocumentBuilderFactoryNewInstance extends MethodAccess {
  DocumentBuilderFactoryNewInstance() {
    this.getMethod().hasName("newInstance") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory")
  }
}

class DocumentBuilderNewDocumentBuilder extends MethodAccess {
  DocumentBuilderNewDocumentBuilder() {
    this.getMethod().hasName("newDocumentBuilder") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory")
  }
}

class SetFeatureDisallowDoctype extends MethodAccess {
  SetFeatureDisallowDoctype() {
    this.getMethod().hasName("setFeature") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
    this.getArgument(0).(Literal).getLiteral() = "http://apache.org/xml/features/disallow-doctype-decl" and
    this.getArgument(1).(Literal).getLiteral() = "true"
  }
}

class SetFeatureDisableEntities extends MethodAccess {
  SetFeatureDisableEntities() {
    this.getMethod().hasName("setFeature") and
    this.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
    (
      this.getArgument(0).(Literal).getLiteral() = "http://xml.org/sax/features/external-general-entities" or
      this.getArgument(0).(Literal).getLiteral() = "http://xml.org/sax/features/external-parameter-entities"
    ) and
    this.getArgument(1).(Literal).getLiteral() = "false"
  }
}

class Configuration extends TaintTracking::Configuration {
  Configuration() { this = "DocumentBuilderFactoryXXE" }

  override predicate isSource(DataFlow::Node source) {
    exists(DocumentBuilderFactoryNewInstance dbfni | source.asExpr() = dbfni)
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(DocumentBuilderNewDocumentBuilder dbndb | sink.asExpr() = dbndb)
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(SetFeatureDisallowDoctype sfdd | sanitizer.asExpr() = sfdd) or
    exists(SetFeatureDisableEntities sfde | sanitizer.asExpr() = sfde)
  }
}

from Configuration cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink, "DOCTYPE declarations are enabled for this DocumentBuilderFactory. This is vulnerable to XML " +
  "external entity attacks.", source, sink,
  "Enable 'http://apache.org/xml/features/disallow-doctype-decl' feature."