/**
 * @name DocumentBuilderFactory External Parameter Entities Enabled
 * @description External entities are allowed for DocumentBuilderFactory. This is vulnerable to XML 
 *              external entity attacks. Disable this by setting the feature 
 *              'http://xml.org/sax/features/external-parameter-entities' to false.
 * @kind problem
 * @problem.severity error
 * @id java/documentbuilderfactory-external-parameter-entities-true
 */
import java

from MethodAccess setFeatureCall
where 
  setFeatureCall.getMethod().getName() = "setFeature" and
  setFeatureCall.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
  setFeatureCall.getArgument(1).(Literal).getValue().toInt() = 1 and
  not exists(
    MethodAccess safeCall |
    safeCall.getMethod().getName() = "setFeature" and
    safeCall.getMethod().getDeclaringType().hasQualifiedName("javax.xml.parsers", "DocumentBuilderFactory") and
    safeCall.getArgument(1).(Literal).getValue().toInt() = 0
  )
select setFeatureCall, "External entities are allowed for DocumentBuilderFactory. This is vulnerable to XML external entity attacks."