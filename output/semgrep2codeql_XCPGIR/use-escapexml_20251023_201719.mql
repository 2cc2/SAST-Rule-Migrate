/**
 * @name Expression Language XSS
 * @description Detects Expression Language segments that don't escape output, which could lead to XSS vulnerabilities
 * @id use-escapexml
 * @kind path-problem
 * @problem.severity WARNING
 * @tags security
 *       external/jsp
 *       external/cwe-xss
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.StringFormat

class ExprLangInput extends DataFlow::Node {
  ExprLangInput() {
    exists(CompileTimeConstantExpr ccExpr |
      ccExpr.getStringValue().regexpMatch("\\$\\{(?!.*escapeXml).*\\}") and
      this.asExpr() = ccExpr
    )
  }
}

class ExprLangOutput extends DataFlow::Node {
  ExprLangOutput() {
    exists(Expr expr |
      expr.toString().regexpMatch("\\$\\{.*\\}") and
      this.asExpr() = expr
    )
  }
}

class EscapeXmlSanitizer extends DataFlow::Node {
  EscapeXmlSanitizer() {
    exists(Call call |
      call.getCallee().getName() = "escapeXml" and
      this.asExpr() = call
    )
  }
}

class XSSConfig extends TaintTracking::Configuration {
  XSSConfig() { this = "ExpressionLanguageXSS" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof ExprLangInput
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof ExprLangOutput
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof EscapeXmlSanitizer
  }
}

from XSSConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink, 
  "Expression Language segment without output escaping detected. Use 'escapeXml' function to prevent XSS.",
  source,
  "Potential XSS source here"