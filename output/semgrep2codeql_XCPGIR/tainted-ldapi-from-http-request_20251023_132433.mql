/**
 * @name Tainted LDAP query from HTTP request
 * @description Detects input from HTTPServletRequest going into LDAP query without proper sanitization
 * @kind path-problem
 * @problem.severity warning
 * @id java/tainted-ldapi-from-http-request
 * @tags security
 *       external/cwe/cwe-90
 */

import java
import semmle.code.java.dataflow.TaintTracking
import DataFlow::PathGraph

class HttpRequestSource extends DataFlow::ExprNode {
  HttpRequestSource() {
    exists(MethodAccess ma |
      ma.getMethod().hasName("getParameter") and
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      ma.getArgument(0).toString() != "" and
      this.asExpr() = ma
    )
  }
}

class LdapSink extends DataFlow::ExprNode {
  LdapSink() {
    exists(MethodAccess ma |
      (ma.getMethod().getDeclaringType().hasQualifiedName("javax.naming.directory", "InitialDirContext") or
      ma.getMethod().getDeclaringType().hasQualifiedName("javax.naming.directory", "DirContext")) and
      ma.getMethod().hasName("search") and
      this.asExpr() = ma.getArgument(1) and
      not ma.getArgument(1).toString() = "\"...\""
    )
  }
}

class TaintedLdapConfig extends TaintTracking::Configuration {
  TaintedLdapConfig() { this = "Tainted LDAP query from HTTP request" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof HttpRequestSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof LdapSink
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TaintedLdapConfig config
where config.hasFlowPath(source, sink)
select sink, 
  "User input from HTTP request reaches LDAP query without sanitization",
  source, sink,
  "User input flows to LDAP query here"