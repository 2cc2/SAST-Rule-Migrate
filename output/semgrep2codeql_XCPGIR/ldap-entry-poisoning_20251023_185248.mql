/**
 * @name LDAP Entry Poisoning
 * @description An object-returning LDAP search will allow attackers to control the LDAP response. This could lead to Remote Code Execution.
 * @kind problem
 * @problem.severity warning
 * @id java/ldap-entry-poisoning
 */

import java
import semmle.code.java.dataflow.DataFlow

class LdapSearchControlsConstructor extends MethodAccess {
  LdapSearchControlsConstructor() {
    this.getMethod().getDeclaringType().hasQualifiedName("javax.naming.directory", "SearchControls") and
    this.getMethod().getName() = "<init>" and
    this.getMethod().getNumberOfParameters() >= 4 and
    this.getMethod().getParameter(3).getType() instanceof BooleanType and
    this.getArgument(3).(Literal).getValue().toInt() = 1
  }
}

class LdapSetReturningObjFlag extends MethodAccess {
  LdapSetReturningObjFlag() {
    this.getMethod().getDeclaringType().hasQualifiedName("javax.naming.directory", "SearchControls") and
    this.getMethod().getName() = "setReturningObjFlag" and
    this.getMethod().getNumberOfParameters() = 1 and
    this.getArgument(0).(Literal).getValue().toInt() = 1
  }
}

query predicate isSink(MethodAccess ma) {
  ma instanceof LdapSearchControlsConstructor or
  ma instanceof LdapSetReturningObjFlag
}

from MethodAccess ma
where isSink(ma)
select ma, "An object-returning LDAP search will allow attackers to control the LDAP response. This could lead to Remote Code Execution."