/**
 * @id use-of-rc2
 * @kind problem
 * @severity Warning
 * @name Use of insecure RC2 cipher
 * @description "Use of RC2 was detected. RC2 is vulnerable to related-key attacks, and is therefore considered non-compliant. Instead, use a strong, secure cipher: Cipher.getInstance(\"AES/CBC/PKCS7PADDING\")."
 */

import java

from Call ma, StringLiteral sl
where
  ma.getCallee().(Method).hasName("getInstance") and
  ma.getCallee().(Method).getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
  sl.getValue() = "RC2" and
  ma.getArgument(0) = sl
select ma, "Use of RC2 was detected. RC2 is vulnerable to related-key attacks."