/**
 * @name Use of AES with ECB mode
 * @id java/use-of-aes-ecb
 * @description Use of AES with ECB mode detected. ECB doesn't provide message confidentiality and is not semantically secure so should not be used.
 * @kind problem
 * @security-severity 7.5
 * @tags security
 *       external/cwe/cwe-327
 */

import java
import semmle.code.java.dataflow.FlowSources

predicate isECBCipherGetInstanceCall(Call call) {
  call.getCallee().(Method).hasName("getInstance") and
  call.getCallee().(Method).getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
  exists(string arg | arg = call.getArgument(0).toString() | arg.matches("AES/ECB.*"))
}

from Call call
where isECBCipherGetInstanceCall(call)
select call, "Use of AES with ECB mode detected. Consider using AES/CBC/PKCS7PADDING instead."