/**
 * @name Use of RC4
 * @description Detects use of RC4 cipher which is vulnerable to several attacks.
 * @kind problem
 * @problem.severity warning
 * @id java/use-of-rc4
 * @tags security
 *       cryptography
 */

import java
import semmle.code.java.dataflow.DataFlow

class RC4Cipher extends MethodAccess {
  RC4Cipher() {
    exists(Method m |
      this.getMethod() = m and
      m.getName() = "getInstance" and
      m.getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
      this.getAnArgument().(Literal).getValue() = "RC4"
    )
  }
}

class RC4Usage extends MethodAccess {
  RC4Usage() {
    exists(Method m |
      this.getMethod() = m and
      m.getDeclaringType().hasQualifiedName("javax.crypto", "Cipher")
    )
  }
}

class RC4FlowConfiguration extends DataFlow::Configuration {
  RC4FlowConfiguration() { this = "RC4FlowConfiguration" }

  override predicate isSource(DataFlow::Node source) {
    source.asExpr() instanceof RC4Cipher
  }

  override predicate isSink(DataFlow::Node sink) {
    sink.asExpr() instanceof RC4Usage
  }
}

from DataFlow::Node source, DataFlow::Node sink, RC4FlowConfiguration config
where config.hasFlow(source, sink)
select sink, "Use of RC4 was detected. RC4 is vulnerable to several attacks, " +
  "including stream cipher attacks and bit flipping attacks. Instead, use a " +
  "strong, secure cipher: Cipher.getInstance(\"AES/CBC/PKCS7PADDING\"). " +
  "See https://owasp.org/www-community/Using_the_Java_Cryptographic_Extensions " +
  "for more information."