/**
 * @id spring-actuator-dangerous-endpoints-enabled
 * @severity WARNING
 * @kind problem
 * @name Potentially dangerous actuator endpoints are exposed
 * @description Detects when potentially dangerous Spring Actuator endpoints are enabled
 */

import java

predicate isDangerousEndpoint(Literal l) {
  l.getValue().matches("prometheus") or
  l.getValue().matches("logfile")
}

from Literal l
where isDangerousEndpoint(l)
select l, "Potentially dangerous actuator endpoints are exposed"