/**
 * @name Turbine SQL Injection Vulnerability
 * @description Detected a formatted string in a SQL statement. This could lead to SQL injection
 *              if variables in the SQL statement are not properly sanitized.
 * @kind path-problem
 * @id java/turbine-sqli
 * @problem.severity warning
 * @tags security
 *       external/cwe/cwe-089
 */

import java
import semmle.code.java.dataflow.FlowSources
import semmle.code.java.StringFormat

class TurbineSqlFormatter extends DataFlow::ExprNode {
  TurbineSqlFormatter() {
    exists(Method m | 
      m.hasName("format") and 
      m.getDeclaringType().hasQualifiedName("java.lang", "String") |
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
  }
}

class TurbineSqlExecution extends DataFlow::ExprNode {
  TurbineSqlExecution() {
    exists(Method m |
      (
        m.hasName("executeQuery") and
        (
          m.getDeclaringType().hasQualifiedName("", "BasePeer") or
          m.getDeclaringType().hasQualifiedName("", "GroupPeer")
        )
      ) |
      this.asExpr() = any(MethodAccess ma | ma.getMethod() = m).getArgument(0)
    )
  }
}

class TurbineSqlTaintConfig extends TaintTracking::Configuration {
  TurbineSqlTaintConfig() { this = "TurbineSqlTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof TurbineSqlFormatter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof TurbineSqlExecution
  }

  override predicate isSanitizer(DataFlow::Node node) {
    exists(StringLiteral lit |
      lit.getValue().matches("%.*\" *\\+ *\".*%") and
      node.asExpr() = lit
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, TurbineSqlTaintConfig config
where config.hasFlowPath(source, sink)
select sink,
  "Detected a formatted string in a SQL statement. This could lead to SQL injection if variables " +
  "in the SQL statement are not properly sanitized. Use prepared statements instead.",
  source, sink,
  "Potential SQL injection vulnerability"