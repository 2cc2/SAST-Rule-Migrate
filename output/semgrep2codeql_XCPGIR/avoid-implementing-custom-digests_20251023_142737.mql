/**
 * @name Avoid implementing custom digests
 * @description Cryptographic algorithms are notoriously difficult to get right.
 *              By implementing a custom message digest, you risk introducing security issues into your program.
 *              Use one of the many sound message digests already available to you.
 * @kind problem
 * @id java/avoid-implementing-custom-digests
 * @severity Warning
 * @tags security
 *       cwe/327
 *       owasp-a3
 *       owasp-a2
 */
import java

from Class cls
where cls.getASupertype().getQualifiedName() = "java.security.MessageDigest"
select cls, "Custom MessageDigest implementation detected. $@",
  cls, "Cryptographic algorithms are notoriously difficult to get right. By implementing a custom message digest, you risk introducing security issues into your program."