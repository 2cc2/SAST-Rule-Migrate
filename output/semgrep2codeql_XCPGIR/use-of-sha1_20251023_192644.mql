/**
 * @name Use of SHA1
 * @description Detected SHA1 hash algorithm which is considered insecure. SHA1 is not collision resistant 
 * and is therefore not suitable as a cryptographic signature. Instead, use PBKDF2 for password hashing 
 * or SHA256 or SHA512 for other hash function applications.
 * @kind problem
 * @severity Warning
 */

import java

// Rule for MessageDigest.getInstance() with SHA1 argument
predicate isSHA1MessageDigestCall(MethodAccess ma) {
  exists(Method m | 
    m.hasQualifiedName("java.security", "MessageDigest", "getInstance") and
    ma.getMethod() = m and
    ma.getArgument(0).(StringLiteral).getValue().matches("%SHA1%") or
    ma.getArgument(0).(StringLiteral).getValue().matches("%SHA-1%")
  )
}

// Rule for direct SHA1 digest calls
predicate isSHA1DigestCall(MethodAccess ma) {
  exists(Method m |
    m.getName() = "digest" and
    ma.getMethod() = m and
    ma.getQualifier().(MethodAccess).getMethod().getName() = "getSha1Digest"
  )
}

from MethodAccess ma
where isSHA1MessageDigestCall(ma) or isSHA1DigestCall(ma)
select ma, "Detected SHA1 hash algorithm usage"