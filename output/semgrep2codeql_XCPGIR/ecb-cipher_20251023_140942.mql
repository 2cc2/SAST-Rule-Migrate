/**
 * @name ECB Cipher Vulnerability
 * @description Detects usage of cipher in ECB mode which is insecure.
 * @kind problem
 * @id java/ecb-cipher
 * @severity Warning
 * @tags security
 *       crypto
 */

import java

from Call cipherCall
where
  cipherCall.getCallee().(Constructor).getDeclaringType().hasQualifiedName("javax.crypto", "Cipher") and
  cipherCall.getCallee().getName() = "getInstance" and
  cipherCall.getArgument(0).toString().regexpMatch(".*ECB.*")
select cipherCall, "Cipher in ECB mode is detected. ECB mode produces the same output for the same input each time which allows an attacker to intercept and replay the data. Further, ECB mode does not provide any integrity checking."