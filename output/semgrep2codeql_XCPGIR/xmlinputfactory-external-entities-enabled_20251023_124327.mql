/**
 * @name XMLInputFactory External Entities Enabled
 * @description XML external entities are enabled for this XMLInputFactory. This is vulnerable to 
 *              XML external entity attacks. Disable external entities by setting
 *              'javax.xml.stream.isSupportingExternalEntities' to false.
 * @kind problem
 * @id java/xmlinputfactory-external-entities-enabled
 * @severity Error
 */

import java

predicate isXXEEnabled(MethodAccess ma) {
  ma.getMethod().hasName("setProperty") and
  ma.getMethod().getDeclaringType().hasQualifiedName("javax.xml.stream", "XMLInputFactory") and
  ma.getArgument(1).(StringLiteral).getValue() = "true" and
  ma.getArgument(0).(StringLiteral).getValue() = "javax.xml.stream.isSupportingExternalEntities"
}

from MethodAccess ma
where isXXEEnabled(ma)
select ma, "XML external entities are enabled for this XMLInputFactory."