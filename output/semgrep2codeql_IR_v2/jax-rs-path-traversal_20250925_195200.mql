/**
 * @name JAX-RS Path Traversal
 * @description Detected a potential path traversal where a PathParam is used in File constructor without sanitization.
 *              A malicious actor could control the location of this file using '../' sequences.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jax-rs-path-traversal
 * @tags security
 *       external/cwe/cwe-22
 *       external/owasp/a05
 *       external/owasp/a01
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class PathParamSource extends DataFlow::Node {
  PathParamSource() {
    exists(Method m, Parameter p |
      m.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "PathParam") or
      m.getAnAnnotation().getType().hasQualifiedName("jakarta.ws.rs", "PathParam") and
      p = m.getAParameter() and
      this.asParameter() = p
    )
  }
}

class FileSink extends DataFlow::Node {
  FileSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.io", "File") and
      this.asExpr() = cc.getAnArgument()
    )
  }
}

class PathTraversalConfig extends TaintTracking::Configuration {
  PathTraversalConfig() { this = "PathTraversalConfig" }

  override predicate isSource(DataFlow::Node source) { source instanceof PathParamSource }

  override predicate isSink(DataFlow::Node sink) { sink instanceof FileSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(MethodAccess ma |
      ma.getCallee().getName() = "getName" and
      ma.getCallee().getDeclaringType().hasQualifiedName("org.apache.commons.io", "FilenameUtils") and
      sanitizer.asExpr() = ma
    )
  }
}

from PathTraversalConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential path traversal vulnerability from JAX-RS PathParam to File constructor"