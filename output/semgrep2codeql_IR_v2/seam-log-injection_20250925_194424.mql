/**
 * @name Seam Log Injection
 * @description Detected dynamic values being used in Seam Logging API with expression language support.
 *              This could lead to code injection if variables are not properly filtered.
 * @kind path-problem
 * @problem.severity error
 * @id java/seam-log-injection
 * @tags security
 *       external/cwe/cwe-95
 *       external/owasp/a03
 *       external/jboss
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class SeamLogSink extends DataFlow::Node {
  SeamLogSink() {
    exists(MethodAccess ma |
      ma.getCallee().getName().matches("debug|error|fatal|info|trace|warn") and
      ma.getCallee().getDeclaringType().hasQualifiedName("org.jboss.seam.log", "Log") and
      this.asExpr() = ma.getAnArgument()
    )
  }
}

class SeamLogTaintConfig extends TaintTracking::Configuration {
  SeamLogTaintConfig() { this = "SeamLogTaintConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Parameter p | source.asParameter() = p) or
    exists(Field f | source.asExpr() = f.getAnAccess())
  }

  override predicate isSink(DataFlow::Node sink) { sink instanceof SeamLogSink }

  override predicate isSanitizer(DataFlow::Node sanitizer) { none() }
}

from SeamLogTaintConfig cfg, DataFlow::PathNode source, DataFlow::PathNode sink
where cfg.hasFlowPath(source, sink)
select sink.getNode(), source, sink, "Potential log injection in Seam Logging API with dynamic value"