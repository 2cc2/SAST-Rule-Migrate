/**
 * @name JAX-RS Path Traversal Vulnerability
 * @description Detected a potential path traversal. A malicious actor could control the location
 *              of this file, to include going backwards in the directory with '../'. To address this,
 *              ensure that user-controlled variables in file paths are sanitized.
 * @kind path-problem
 * @problem.severity warning
 * @id java/jax-rs-path-traversal
 * @tags security
 *       external/cwe/cwe-22
 */

import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.dataflow.TaintTracking

class JaxRsPathParamSource extends DataFlow::Node {
  JaxRsPathParamSource() {
    exists(Parameter p |
      p.getAnAnnotation().getType().hasQualifiedName("javax.ws.rs", "PathParam") and
      this.asParameter() = p
    )
  }
}

class FileCreationSink extends DataFlow::Node {
  FileCreationSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.io", "File") and
      this.asExpr() = cc.getAnArgument()
    )
  }
}

class FilenameUtilsSanitizer extends DataFlow::Node {
  FilenameUtilsSanitizer() {
    exists(Call c |
      c.getCallee().hasQualifiedName("org.apache.commons.io", "FilenameUtils", "getName") and
      this.asExpr() = c
    )
  }
}

class JaxRsPathTraversalConfig extends TaintTracking::Configuration {
  JaxRsPathTraversalConfig() {
    this = "JAX-RS Path Traversal Configuration"
  }

  override predicate isSource(DataFlow::Node source) {
    source instanceof JaxRsPathParamSource
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof FileCreationSink
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    sanitizer instanceof FilenameUtilsSanitizer
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, JaxRsPathTraversalConfig config
where config.hasFlowPath(source, sink)
select sink, source, sink,
  "Path traversal vulnerability detected via user-controlled path parameter in File constructor"