/**
 * @name Tainted URL host (SSRF risk)
 * @description User data flows into the host portion of a manually-constructed URL.
 * @kind path-problem
 * @problem.severity error
 * @security-severity 8.8
 * @precision high
 * @id java/tainted-url-host
 * @tags security
 *       external/cwe/cwe-918
 */

import java
import semmle.code.java.dataflow.TaintTracking
import semmle.code.java.frameworks.spring.SpringController

class SpringRequestParameter extends DataFlow::Node {
  SpringRequestParameter() {
    exists(Parameter p |
      p.getAnAnnotation().getType().hasQualifiedName(
        ["org", "springframework", "web", "bind", "annotation"],
        ["RequestBody", "PathVariable", "RequestParam", "RequestHeader", "CookieValue", "ModelAttribute"]
      )
      and not p.getType().toString().matches("^(Integer|Long|Float|Double|Char|Boolean|int|long|float|double|char|boolean)")
      and this.asParameter() = p
    )
  }
}

class URLConstructorSink extends DataFlow::Node {
  URLConstructorSink() {
    exists(ConstructorCall cc |
      cc.getConstructedType().hasQualifiedName("java.net", "URL") and
      this.asExpr() = cc.getArgument(0)
    )
  }
}

class StringConcatSink extends DataFlow::Node {
  StringConcatSink() {
    exists(AddExpr ae, StringLiteral sl |
      sl.getValue().matches("http(s?)://.*") and
      (ae.getRightOperand() = this.asExpr() or ae.getLeftOperand() = this.asExpr())
    )
  }
}

class TaintedUrlHostConfig extends TaintTracking::Configuration {
  TaintedUrlHostConfig() { this = "TaintedUrlHostConfig" }

  override predicate isSource(DataFlow::Node source) {
    source instanceof SpringRequestParameter
  }

  override predicate isSink(DataFlow::Node sink) {
    sink instanceof URLConstructorSink or sink instanceof StringConcatSink
  }
}

from TaintedUrlHostConfig config, DataFlow::PathNode source, DataFlow::PathNode sink
where config.hasFlowPath(source, sink)
select sink.getNode(), source, sink,
  "User data flows into the host portion of a manually-constructed URL (SSRF risk)"