/**
 * @name ServletResponse writer XSS
 * @description Cross-site scripting detected in HttpServletResponse writer.
 *              User input was detected going directly from the HttpServletRequest into output.
 *              Ensure your data is properly encoded using org.owasp.encoder.Encode.forHtml.
 * @kind path-problem
 * @problem.severity error
 * @id java/servletresponse-writer-xss
 * @tags security
 *       external/cwe/cwe-079
 */
import java
import semmle.code.java.dataflow.DataFlow
import semmle.code.java.frameworks.Servlets
import semmle.code.java.security.XSS

class ServletResponseWriterXssConfig extends TaintTracking::Configuration {
  ServletResponseWriterXssConfig() { this = "ServletResponseWriterXssConfig" }

  override predicate isSource(DataFlow::Node source) {
    exists(Method m, MethodAccess ma |
      m.hasName("getParameter") and
      m.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletRequest") and
      ma.getMethod() = m and
      source.asExpr() = ma
    )
  }

  override predicate isSink(DataFlow::Node sink) {
    exists(Method getWriter, Method writeMethod, MethodAccess writerAccess, MethodAccess writeAccess |
      getWriter.hasName("getWriter") and
      getWriter.getDeclaringType().hasQualifiedName("javax.servlet.http", "HttpServletResponse") and
      writeMethod.hasName("write") and
      writerAccess.getMethod() = getWriter and
      writeAccess.getMethod() = writeMethod and
      DataFlow::localExprFlow(writerAccess, writeAccess.getQualifier()) and
      sink.asExpr() = writeAccess.getArgument(0)
    )
  }

  override predicate isSanitizer(DataFlow::Node sanitizer) {
    exists(Method m, MethodAccess ma |
      m.hasQualifiedName("org.owasp.encoder", "Encode", "forHtml") and
      ma.getMethod() = m and
      sanitizer.asExpr() = ma
    )
  }
}

from DataFlow::PathNode source, DataFlow::PathNode sink, ServletResponseWriterXssConfig config
where config.hasFlowPath(source, sink)
select sink,
  "Cross-site scripting detected in HttpServletResponse writer with user input from $@.",
  source, source.toString()