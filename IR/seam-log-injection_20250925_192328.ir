```json
# 总结的中间表示
id: java/seam-log-injection
kind: taint
interprocedural: false
path_output: full
severity: ERROR
message: Seam Logging API supports expression language which can lead to unwanted code execution if dynamic values are not properly filtered.

sources:
  - kind: VARIABLE
    type: any
    guard: none

sinks:
  - select:
      node: CALL
      callee:
        qname: org.jboss.seam.log.Log
      method: 
        regex: (debug|error|fatal|info|trace|warn)
      arg_index: 0

sanitizers: []

propagation:
  - step:
      from: VARIABLE
      to: CALL_ARG
      guard: none
  preset: none

constraints:
  - metavariable-regex:
      metavariable: $INFO
      regex: (debug|error|fatal|info|trace|warn)
```